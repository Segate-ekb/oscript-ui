// Что написать в каждом поле формы — желудь UI-кита. Одно правило старшинства на весь
// хаб: набранное человеком старше действующего, иначе отказ формы стирает ввод.

// Собирает значения для показа по объявленным элементам.
//
// Параметры:
//  Элементы    - Массив из Структура - описания (ОбъявлениеФормы.Состав).
//  Набранное   - Соответствие - ключ поля -> что человек набрал (результат разбора).
//  Действующие - Структура, Соответствие, Неопределено - действующие значения по ключам;
//                ключ с точкой читается только из Соответствия.
//
// Возвращаемое значение:
//  Соответствие - ключ поля -> строка для печати в поле.
//
Функция ДляПоказа(Знач Элементы, Знач Набранное, Знач Действующие) Экспорт

	Результат = Новый Соответствие();

	Для Каждого Описание Из Элементы Цикл

		Если Описание.Род <> "поле" Тогда
			Продолжить;
		КонецЕсли;

		// секрет не показывается ни в каком виде: ни действующий, ни набранный
		Если Описание.Вид = "секрет" Тогда
			Результат.Вставить(Описание.Ключ, "");
			Продолжить;
		КонецЕсли;

		// в «набранном» лежит только то, что разбор принял от человека, а поле только
		// на чтение он не читает вовсе — подделанному значению сюда не попасть
		Взятое = Набранное.Получить(Описание.Ключ);
		Если Взятое <> Неопределено Тогда
			Результат.Вставить(Описание.Ключ, Строка(Взятое));
			Продолжить;
		КонецЕсли;

		// умолчание — значение ПУСТОГО поля, и на экране оно то же, что при разборе:
		// иначе форма показывала бы одно, а сохраняла другое
		Действующее = Строкой(ИзИсточника(Действующие, Описание.Ключ));
		Результат.Вставить(Описание.Ключ,
			?(ЗначениеЗаполнено(Действующее), Действующее, Описание.Умолчание));

	КонецЦикла;

	Возврат Результат;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция Строкой(Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "1", "");
	КонецЕсли;
	Возврат Строка(Значение);

КонецФункции

Функция ИзИсточника(Знач Источник, Знач Ключ)

	Если ТипЗнч(Источник) = Тип("Соответствие") Тогда
		Возврат Источник.Получить(Ключ);
	КонецЕсли;

	// у Структуры имя свойства — идентификатор, и ключ с точкой ей просто не задать
	Если ТипЗнч(Источник) = Тип("Структура") И СтрНайти(Ключ, ".") = 0 Тогда
		Найденное = Неопределено;
		Если Источник.Свойство(Ключ, Найденное) Тогда
			Возврат Найденное;
		КонецЕсли;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
