// Описание поля объявленной формы — объект UI-кита: ОбъявлениеФормы.Поле отдаёт его,
// и поле настраивается цепочкой слов, как узел холста. Слова пишут ту же структуру, что
// лежит в составе объявления, поэтому печать и разбор видят их сразу.
//
// Цепочка объявления не рвётся: Поле, Блок, БезТокена и печать с разбором описание
// передаёт своему объявлению — прежний код «Форма.Поле(…).Поле(…)» работает как раньше.

Перем Владелец; // ОбъявлениеФормы
Перем Описание; // Структура — описание поля в составе объявления
Перем Типы;     // ТипыПоля

#Область Слова

// Тип значения поля — системой типов OneScript: Тип("Число") — число, Тип("Булево") —
// флажок, Тип("Дата") — дата; ОписаниеТипов с квалификаторами даёт пределы ввода (step,
// max, maxlength) и вид даты (дата, дата и время, время). Строка — прежний вид поля
// («строка», «число», «флажок», «секрет», «многострочное», «выбор», «дата»). Разбор
// приводит пришедшее к этому типу: число — Число, флажок — Булево, дата — Дата.
//
// Параметры:
//  Значение - Тип, ОписаниеТипов, Строка - тип значения.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция ТипЗначения(Знач Значение) Экспорт

	Разбор = Типы.Разобрать(Значение);
	Описание.Вставить("Вид", Разбор.Вид);
	Описание.Вставить("Шаг", Разбор.Шаг);
	// проверка до отправки (выпуск 0.12): явные Пределы старше максимума типа
	Если Описание.Макс = Неопределено Тогда
		Описание.Вставить("Максимум", Разбор.Максимум);
	КонецЕсли;
	Описание.Вставить("ДлинаМакс", Разбор.ДлинаМакс);
	Описание.Вставить("ТипЗадан", Истина);
	Возврат ЭтотОбъект;

КонецФункции

// Пределы числа: разбор отбивает значение вне них, а поле печатает их атрибутами min и max.
//
// Параметры:
//  Мин - Число, Неопределено - нижний предел.
//  Макс - Число, Неопределено - верхний предел.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Пределы(Знач Мин, Знач Макс = Неопределено) Экспорт

	Описание.Вставить("Мин", Мин);
	Описание.Вставить("Макс", Макс);
	Описание.Вставить("Минимум", ?(Мин = Неопределено, "", Формат(Мин, "ЧН=0; ЧГ=0; ЧРД=.")));
	Описание.Вставить("Максимум", ?(Макс = Неопределено, "", Формат(Макс, "ЧН=0; ЧГ=0; ЧРД=.")));
	Возврат ЭтотОбъект;

КонецФункции

// Поле обязательно: пустое отбивается разбором.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Обязательное(Знач Флаг = Истина) Экспорт
	Описание.Вставить("Обязательное", Флаг = Истина);
	Возврат ЭтотОбъект;
КонецФункции

// Поле только на чтение: из формы не берётся вовсе.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция ТолькоЧтение(Знач Флаг = Истина) Экспорт
	Описание.Вставить("ТолькоЧтение", Флаг = Истина);
	Возврат ЭтотОбъект;
КонецФункции

// Подсказка под полем.
//
// Параметры:
//  Текст - Строка - подсказка.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Подсказка(Знач Текст) Экспорт
	Описание.Вставить("Подсказка", Строка(Текст));
	Возврат ЭтотОбъект;
КонецФункции

// Пример значения — серый текст в пустом поле (плейсхолдер).
//
// Параметры:
//  Текст - Строка - пример.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Пример(Знач Текст) Экспорт
	Описание.Вставить("Плейсхолдер", Строка(Текст));
	Возврат ЭтотОбъект;
КонецФункции

// Подсказка автозаполнению браузера (autocomplete).
//
// Параметры:
//  Значение - Строка - значение атрибута.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Автозаполнение(Знач Значение) Экспорт
	Описание.Вставить("Автозаполнение", Строка(Значение));
	Возврат ЭтотОбъект;
КонецФункции

// Значение пустого поля — одно и на экране, и в разборе.
//
// Параметры:
//  Значение - Строка - умолчание.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Умолчание(Знач Значение) Экспорт
	Описание.Вставить("Умолчание", Строка(Значение));
	Возврат ЭтотОбъект;
КонецФункции

// Вариант выбора; первый вариант делает поле выбором.
//
// Параметры:
//  Значение - Строка - что вариант отправляет.
//  Подпись  - Строка - (необязательный) что вариант показывает.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Вариант(Знач Значение, Знач Подпись = Неопределено) Экспорт

	Вариант_ = Новый Структура("Значение", Строка(Значение));
	Если Подпись <> Неопределено Тогда
		Вариант_.Вставить("Подпись", Строка(Подпись));
	КонецЕсли;

	Варианты = Новый Массив();
	Для Каждого Был Из Описание.Варианты Цикл
		Варианты.Добавить(Был);
	КонецЦикла;
	Варианты.Добавить(Вариант_);

	Описание.Вставить("Варианты", Варианты);
	Описание.Вставить("Вид", "выбор");
	Возврат ЭтотОбъект;

КонецФункции

// Подпись раскрывашки: подряд идущие элементы с одной подписью уходят под неё.
//
// Параметры:
//  Подпись - Строка - подпись раскрывашки.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Кат(Знач Подпись) Экспорт
	Описание.Вставить("Кат", Строка(Подпись));
	Возврат ЭтотОбъект;
КонецФункции

// Вид области кита: подряд идущие элементы с одним видом уходят в общий блок.
//
// Параметры:
//  Вид - Строка - вид области.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Рамка(Знач Вид) Экспорт
	Описание.Вставить("Рамка", Строка(Вид));
	Возврат ЭтотОбъект;
КонецФункции

// Многострочное поле.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Многострочное() Экспорт
	Описание.Вставить("Вид", "многострочное");
	Возврат ЭтотОбъект;
КонецФункции

// Поле секрета: набранное не видно и не возвращается на экран, края не обрезаются.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Секрет() Экспорт
	Описание.Вставить("Вид", "секрет");
	Возврат ЭтотОбъект;
КонецФункции

// --- поля список и цвет (выпуск 0.12) ---

// Поле-список: значения плашками, серверу приходит строка через запятую. Разбор отдаёт
// массив строк без пустых и повторов; действующее значение — строкой или массивом.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Список() Экспорт
	Описание.Вставить("Вид", "список");
	Описание.Вставить("ТипЗадан", Истина);
	Возврат ЭтотОбъект;
КонецФункции

// Поле цвета: образцы кружками (слово Образец) и свой цвет, значение — код #rrggbb.
// Разбор отбивает код не того вида (form.error.color) и отдаёт код строчными; пустое
// значит «по умолчанию» и разбирается как Неопределено.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Цвет() Экспорт
	Описание.Вставить("Вид", "цвет");
	Описание.Вставить("ТипЗадан", Истина);
	Возврат ЭтотОбъект;
КонецФункции

// Образец поля цвета; первый образец делает поле цветом.
//
// Параметры:
//  Цвет_ - Строка - код цвета вида #rrggbb.
//  Имя   - Строка - (необязательный) имя цвета для человека; по умолчанию код.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Образец(Знач Цвет_, Знач Имя = Неопределено) Экспорт

	Образец_ = Новый Структура("Цвет", Строка(Цвет_));
	Если Имя <> Неопределено Тогда
		Образец_.Вставить("Имя", Строка(Имя));
	КонецЕсли;

	Образцы = Новый Массив();
	Для Каждого Был Из Описание.Образцы Цикл
		Образцы.Добавить(Был);
	КонецЦикла;
	Образцы.Добавить(Образец_);

	Описание.Вставить("Образцы", Образцы);
	Описание.Вставить("Вид", "цвет");
	Описание.Вставить("ТипЗадан", Истина);
	Возврат ЭтотОбъект;

КонецФункции

// --- проверка до отправки и тост (выпуск 0.12) ---

// Пределы длины строки: поле печатает атрибуты minlength и maxlength, разбор отбивает
// строку короче или длиннее, скрипт кита пишет отказ под полем до отправки. Включает
// проверку до отправки (см. ПроверкаДоОтправки).
//
// Параметры:
//  Мин  - Число, Неопределено - наименьшая длина; Неопределено или 0 — без нижнего предела.
//  Макс - Число, Неопределено - (необязательный) наибольшая длина; Неопределено или 0 — без верхнего.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Длина(Знач Мин, Знач Макс = Неопределено) Экспорт

	Описание.Вставить("ДлинаМин", ТекстДлины(Мин));
	Если ЗначениеЗаполнено(ТекстДлины(Макс)) Тогда
		Описание.Вставить("ДлинаМакс", ТекстДлины(Макс));
	КонецЕсли;
	Описание.Вставить("Проверка", Истина);
	Возврат ЭтотОбъект;

КонецФункции

// Шаблон значения — регулярное выражение, которому значение обязано совпасть ЦЕЛИКОМ
// (атрибут pattern). Разбор сверяет с ним то, что пришло, — без скрипта браузер не
// отправит несовпавшее, а сервер не примет подделанное. Включает проверку до отправки.
//
// Параметры:
//  Образец - Строка - регулярное выражение без якорей ^ и $ по правилам атрибута pattern
//            (браузер читает его с флагом v: дефис внутри класса экранируется), например
//            "[a-z0-9\-]+".
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция Шаблон(Знач Образец) Экспорт

	Текст = Строка(?(Образец = Неопределено, "", Образец));
	// негодный шаблон браузер молча не применяет, а разбор упал бы на первом же запросе:
	// пусть сборка остановится здесь, где его объявили
	Попытка
		Проба = Новый РегулярноеВыражение(Текст);
	Исключение
		ВызватьИсключение СтрШаблон("Описание поля «%1»: шаблон «%2» — не регулярное выражение"
			+ " (%3). Задайте выражение без якорей ^ и $, например ""[a-z0-9\-]+"".",
			Описание.Ключ, Текст, ОписаниеОшибки());
	КонецПопытки;

	Описание.Вставить("Шаблон", Текст);
	Описание.Вставить("Проверка", Истина);
	Возврат ЭтотОбъект;

КонецФункции

// Проверка значения сервером до отправки: скрипт кита, когда человек перестал набирать
// или ушёл из поля, спрашивает адрес GET-запросом «адрес?имя_поля=значение». Ответ 200 —
// свободно, 409 — занято, и текст ответа печатается под полем отказом. Без скрипта вопроса
// нет: занятость проверяет обработчик формы и отбивает поле методом Отбить. Включает
// проверку до отправки.
//
// Параметры:
//  Адрес - Строка - адрес проверки (признак data-check).
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция ПроверкаНаСервере(Знач Адрес) Экспорт
	Описание.Вставить("АдресПроверки", Строка(?(Адрес = Неопределено, "", Адрес)));
	Описание.Вставить("Проверка", Истина);
	Возврат ЭтотОбъект;
КонецФункции

// Проверка до отправки: поле несёт тексты отказов словаря (form.error.*) для каждого
// своего ограничения — обязательности, типа почты или адреса, числа, пределов, длины,
// шаблона, — и скрипт кита пишет отказ под полем, когда браузер не пускает форму или
// человек уходит из поля. Слова Длина, Шаблон и ПроверкаНаСервере включают её сами;
// прежним ограничениям (Обязательное, Пределы, ТипЗначения("email" | "url")) она нужна
// словом, чтобы их поле печаталось как раньше, пока его об этом не попросили.
//
// Возвращаемое значение:
//  ОписаниеПоля - это же описание.
//
Функция ПроверкаДоОтправки() Экспорт
	Описание.Вставить("Проверка", Истина);
	Возврат ЭтотОбъект;
КонецФункции

// Длина печатается целым числом; 0 и Неопределено значат «предела нет».
Функция ТекстДлины(Знач Значение)
	Если ТипЗнч(Значение) <> Тип("Число") ИЛИ Значение <= 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Формат(Значение, "ЧН=0; ЧГ=0; ЧДЦ=0");
КонецФункции

#КонецОбласти

#Область Объявление

// Следующее поле того же объявления — см. ОбъявлениеФормы.Поле.
//
// Параметры:
//  Ключ     - Строка - ключ поля.
//  Метка    - Строка - подпись поля.
//  Вид      - Строка - (необязательный) прежний вид поля.
//  Свойства - Структура, Неопределено - (необязательный) прежние свойства поля.
//
// Возвращаемое значение:
//  ОписаниеПоля - описание нового поля.
//
Функция Поле(Знач Ключ, Знач Метка, Знач Вид = "строка", Знач Свойства = Неопределено) Экспорт
	Возврат Владелец.Поле(Ключ, Метка, Вид, Свойства);
КонецФункции

// Готовый блок того же объявления — см. ОбъявлениеФормы.Блок.
//
// Параметры:
//  Разметка - Строка - ДОВЕРЕННЫЙ HTML блока.
//  Свойства - Структура, Неопределено - (необязательный) Кат и Рамка.
//
// Возвращаемое значение:
//  ОбъявлениеФормы
//
Функция Блок(Знач Разметка, Знач Свойства = Неопределено) Экспорт
	Возврат Владелец.Блок(Разметка, Свойства);
КонецФункции

// См. ОбъявлениеФормы.БезТокена.
//
// Параметры:
//  Причина - Строка - почему у формы не может быть токена.
//
// Возвращаемое значение:
//  ОбъявлениеФормы
//
Функция БезТокена(Знач Причина) Экспорт
	Возврат Владелец.БезТокена(Причина);
КонецФункции

// Объявление, которому принадлежит поле.
//
// Возвращаемое значение:
//  ОбъявлениеФормы
//
Функция Объявление() Экспорт
	Возврат Владелец;
КонецФункции

// См. ОбъявлениеФормы.Состав.
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция Состав() Экспорт
	Возврат Владелец.Состав();
КонецФункции

// См. ОбъявлениеФормы.ИмяПоля.
//
// Параметры:
//  Ключ - Строка - ключ поля.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоля(Знач Ключ) Экспорт
	Возврат Владелец.ИмяПоля(Ключ);
КонецФункции

// См. ОбъявлениеФормы.Разобрать.
//
// Параметры:
//  Присланное - Соответствие - разобранное тело запроса.
//
// Возвращаемое значение:
//  Структура
//
Функция Разобрать(Знач Присланное) Экспорт
	Возврат Владелец.Разобрать(Присланное);
КонецФункции

// См. ОбъявлениеФормы.Отбить.
//
// Параметры:
//  Ключ  - Строка - ключ поля.
//  Текст - Строка - текст отказа.
//
Процедура Отбить(Знач Ключ, Знач Текст) Экспорт
	Владелец.Отбить(Ключ, Текст);
КонецПроцедуры

// См. ОбъявлениеФормы.Тело.
//
// Параметры:
//  Действующие - Структура, Соответствие, Неопределено - (необязательный) значения.
//
// Возвращаемое значение:
//  Строка
//
Функция Тело(Знач Действующие = Неопределено) Экспорт
	Возврат Владелец.Тело(Действующие);
КонецФункции

// См. ОбъявлениеФормы.Отрисовать.
//
// Параметры:
//  Действующие - Структура, Соответствие, Неопределено - значения.
//  Действие    - Строка - URL, куда уходит POST.
//  Токен       - Строка - (необязательный) CSRF-токен.
//  Класс       - Строка - (необязательный) CSS-класс формы.
//
// Возвращаемое значение:
//  Строка
//
Функция Отрисовать(Знач Действующие, Знач Действие, Знач Токен = "", Знач Класс = "") Экспорт
	Возврат Владелец.Отрисовать(Действующие, Действие, Токен, Класс);
КонецФункции

// См. ОбъявлениеФормы.ОтрисоватьВОкне.
//
// Параметры:
//  Действующие - Структура, Соответствие, Неопределено - значения.
//  Действие    - Строка - URL, куда уходит POST.
//  Токен       - Строка - CSRF-токен.
//  Окно        - Структура - свойства окна.
//
// Возвращаемое значение:
//  Строка
//
Функция ОтрисоватьВОкне(Знач Действующие, Знач Действие, Знач Токен, Знач Окно) Экспорт
	Возврат Владелец.ОтрисоватьВОкне(Действующие, Действие, Токен, Окно);
КонецФункции

// См. ОбъявлениеФормы.ИдентификаторОкна.
//
// Возвращаемое значение:
//  Строка
//
Функция ИдентификаторОкна() Экспорт
	Возврат Владелец.ИдентификаторОкна();
КонецФункции

#КонецОбласти

// НЕ желудь: описание выдаёт объявление формы, по одному на поле.
//
// Параметры:
//  _Владелец - ОбъявлениеФормы - объявление поля.
//  _Описание - Структура       - описание поля в его составе.
//  _Типы     - ТипыПоля        - тип значения в вид поля.
//
Процедура ПриСозданииОбъекта(Знач _Владелец, Знач _Описание, Знач _Типы) Экспорт

	Владелец = _Владелец;
	Описание = _Описание;
	Типы = _Типы;

КонецПроцедуры
