// Проверка значения поля формы — желудь UI-кита: сырое значение из запроса приводится
// к виду поля и судится по объявленным ограничениям. Текст отказа берётся из словаря.

Перем Тексты;  // ТекстыИнтерфейса
Перем Типы;    // ТипыПоля — ввод даты в Дату

// Читает сырое значение поля по его объявлению.
//
// Параметры:
//  Описание - Структура - объявление поля (ОбъявлениеФормы.Состав): Вид, Обязательное,
//             Мин, Макс, Варианты, Умолчание. Вид «дата», «датавремя», «время» читается
//             Датой; нечитаемая дата отбивается текстом form.error.date. Строку судят
//             ещё и ограничения проверки до отправки — те же, что поле печатает браузеру:
//             вид «email» и «url» (form.error.email, form.error.url), ДлинаМин и ДлинаМакс
//             (form.error.minlength, form.error.maxlength), Шаблон (form.error.pattern).
//  Сырое    - Строка, Неопределено - значение из формы; Неопределено — поля в форме нет.
//
// Возвращаемое значение:
//  Структура - Принято (Булево), Значение (Произвольный: Булево для флажка, Число для
//              числа, Дата для даты, Строка для остальных; Неопределено — не задано), Отказ (Строка:
//              текст для экрана, "" при успехе), Показ (Строка: что вернуть в поле).
//
Функция Прочитать(Знач Описание, Знач Сырое) Экспорт

	Если Описание.Вид = "флажок" Тогда
		Возврат Принято(Флажком(Сырое), ?(Флажком(Сырое), "1", ""));
	КонецЕсли;

	// секрет не обрезается: пробел на краю пароля значим, и «почистив» его,
	// хаб сохранил бы не то, что человек набрал
	Значение = ?(Описание.Вид = "секрет", Строка(?(Сырое = Неопределено, "", Сырое)),
		СокрЛП(Строка(?(Сырое = Неопределено, "", Сырое))));

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Значение = Описание.Умолчание;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат ?(Описание.Обязательное,
			Отбито(Тексты.Текст("form.error.required"), ""), Принято(Неопределено, ""));
	КонецЕсли;

	Если Описание.Вид = "число" Тогда
		Возврат Числом(Описание, Значение);
	КонецЕсли;

	Если Описание.Вид = "дата" ИЛИ Описание.Вид = "датавремя" ИЛИ Описание.Вид = "время" Тогда
		Прочитанная = Типы.ДатаИзВвода(Значение, Описание.Вид);
		Возврат ?(Прочитанная = Неопределено, Отбито(Тексты.Текст("form.error.date"), Значение),
			Принято(Прочитанная, Значение));
	КонецЕсли;

	Если Описание.Вид = "выбор" И НЕ СредиВариантов(Описание, Значение) Тогда
		Возврат Отбито(Тексты.Текст("form.error.choice"), Значение);
	КонецЕсли;

	Показ = ?(Описание.Вид = "секрет", "", Значение);
	Отказ = ОтказСтроки(Описание, Значение);
	Если ЗначениеЗаполнено(Отказ) Тогда
		Возврат Отбито(Отказ, Показ);
	КонецЕсли;

	Возврат Принято(Значение, Показ);

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Флажок приезжает только отмеченным: браузер не шлёт снятый вовсе, поэтому
// отсутствие поля — это «выключено», а не «не задано».
Функция Флажком(Знач Сырое)

	Значение = НРег(СокрЛП(Строка(?(Сырое = Неопределено, "", Сырое))));
	Возврат Значение = "1" ИЛИ Значение = "on" ИЛИ Значение = "true" ИЛИ Значение = "истина";

КонецФункции

Функция Числом(Знач Описание, Знач Значение)

	Отрицательное = СтрНачинаетсяС(Значение, "-");
	Цифры = ?(Отрицательное, Сред(Значение, 2), Значение);

	Если НЕ ЗначениеЗаполнено(Цифры) Тогда
		Возврат Отбито(Тексты.Текст("form.error.number"), Значение);
	КонецЕсли;

	Для Поз = 1 По СтрДлина(Цифры) Цикл
		Если СтрНайти("0123456789", Сред(Цифры, Поз, 1)) = 0 Тогда
			Возврат Отбито(Тексты.Текст("form.error.number"), Значение);
		КонецЕсли;
	КонецЦикла;

	Число_ = ?(Отрицательное, -Число(Цифры), Число(Цифры));

	Если Описание.Мин <> Неопределено И Число_ < Описание.Мин Тогда
		Возврат Отбито(Тексты.Шаблон("form.error.min", Формат(Описание.Мин, "ЧГ=0; ЧН=0")), Значение);
	КонецЕсли;
	Если Описание.Макс <> Неопределено И Число_ > Описание.Макс Тогда
		Возврат Отбито(Тексты.Шаблон("form.error.max", Формат(Описание.Макс, "ЧГ=0; ЧН=0")), Значение);
	КонецЕсли;

	Возврат Принято(Число_, Значение);

КонецФункции

// Пустой список вариантов ничего не запрещает: варианты бывают заполнены доменом
// на отрисовке и не заданы там, где форма разбирается.
Функция СредиВариантов(Знач Описание, Знач Значение)

	Если Описание.Варианты.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Вариант Из Описание.Варианты Цикл
		Найденное = Неопределено;
		Если ТипЗнч(Вариант) = Тип("Структура") И Вариант.Свойство("Значение", Найденное) Тогда
			Если Строка(?(Найденное = Неопределено, "", Найденное)) = Значение Тогда
				Возврат Истина;
			КонецЕсли;
		ИначеЕсли Строка(Вариант) = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// --- проверка до отправки и тост (выпуск 0.12) ---

// Те же ограничения, что поле печатает браузеру: без скрипта браузер не отправит
// негодное, а сервер не примет подделанное — и скажет теми же словами словаря.
Функция ОтказСтроки(Знач Описание, Знач Значение)

	Вид = Описание.Вид;
	Если Вид = "email" И НЕ Совпадает(Значение, ОбразецПочты()) Тогда
		Возврат Тексты.Текст("form.error.email");
	КонецЕсли;
	Если Вид = "url" И НЕ Совпадает(Значение, ОбразецАдреса()) Тогда
		Возврат Тексты.Текст("form.error.url");
	КонецЕсли;

	Мин = Свойство(Описание, "ДлинаМин");
	Если ЗначениеЗаполнено(Мин) И СтрДлина(Значение) < Число(Мин) Тогда
		Возврат Тексты.Шаблон("form.error.minlength", Мин);
	КонецЕсли;
	Макс = Свойство(Описание, "ДлинаМакс");
	Если ЗначениеЗаполнено(Макс) И СтрДлина(Значение) > Число(Макс) Тогда
		Возврат Тексты.Шаблон("form.error.maxlength", Макс);
	КонецЕсли;

	Шаблон = Свойство(Описание, "Шаблон");
	Если ЗначениеЗаполнено(Шаблон) И НЕ Совпадает(Значение, Шаблон) Тогда
		Возврат Тексты.Текст("form.error.pattern");
	КонецЕсли;

	Возврат "";

КонецФункции

// Совпадение ЦЕЛИКОМ и с учётом регистра, как у атрибута pattern: браузер ставит якоря
// сам. У РегулярноеВыражение OneScript регистр по умолчанию не значим, а «$» пускает
// перевод строки в конце — поэтому якоря \A и \z и регистр включён явно.
Функция Совпадает(Знач Значение, Знач Образец)
	Выражение = Новый РегулярноеВыражение("\A(?:" + Образец + ")\z");
	Выражение.ИгнорироватьРегистр = Ложь;
	Выражение.Многострочный = Ложь;
	Возврат Выражение.Совпадает(Значение);
КонецФункции

// Годная почта — по правилу HTML для type=email: то же, что пропускает браузер.
Функция ОбразецПочты()
	Возврат "[a-zA-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?"
		+ "(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*";
КонецФункции

// Годный адрес — абсолютный, со схемой, как требует type=url: «пример.рф» без схемы
// браузер не пропускает, и сервер тоже.
Функция ОбразецАдреса()
	Возврат "[a-zA-Z][a-zA-Z0-9+.-]*:[^\s]+";
КонецФункции

// Описание может прийти и не из объявления (Прочитать открыт наружу): нового свойства
// у такой структуры нет, и это значит «ограничения нет».
Функция Свойство(Знач Описание, Знач Имя)
	Значение = Неопределено;
	Если Описание.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция Принято(Знач Значение, Знач Показ)
	Возврат Новый Структура("Принято, Значение, Отказ, Показ", Истина, Значение, "", Показ);
КонецФункции

Функция Отбито(Знач Отказ, Знач Показ)
	Возврат Новый Структура("Принято, Значение, Отказ, Показ", Ложь, Неопределено, Отказ, Показ);
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Тексты = _Тексты;
	Типы = Новый ТипыПоля();

КонецПроцедуры
