// Рендерер настроек — желудь UI-кита: единый каркас всех домов настроек
// (объект → дерево разделов → секции → панель сохранения). Дом решает, ЧТО показать,
// каркас — КАК; поэтому здесь нет ни слова про пулы, пакеты и права.
//
// Секция — единица переноса со своей валидацией и своим POST, поэтому каждая секция
// с «Действием» оборачивается в отдельную <form>, а не в общую форму страницы.

Перем Экран;      // ЭкранированиеHTML
Перем Модели;     // ЧтениеМодели
Перем НаборUI;    // НаборКомпонентов
Перем Тексты;     // ТекстыИнтерфейса

// Отрисовывает дом настроек.
//
// Параметры:
//  Модель - Структура - Ключ дома ЛАТИНИЦЕЙ ("account", "project", "team"):
//           он идёт в data-house, а ЭкранированиеHTML отбрасывает имена атрибутов вне
//           [a-z0-9-]; Заголовок, Объект (имя настраиваемого объекта), Пояснение,
//           Разделы (модель ДеревоРазделов, см. Раздел), Уведомления (структуры Текст,
//           Вид для компонента «Тост»), Секции (см. Секция), Хлебные (структуры
//           Подпись, Адрес).
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент для <main>. Под заголовком дома, у которого есть текущий
//           раздел, стоит его имя и значок (settings__current): на телефоне колонку
//           разделов заменяет единое меню, и страница сама говорит, где стоит человек.
//
Функция Отрисовать(Знач Модель) Экспорт

	Возврат СтрШаблон("<div class=""settings""%1>%2%3<div class=""settings__layout"">%4%5</div></div>",
		Экран.Атрибут("data-house", Модели.Текст(Модель, "Ключ")),
		Хлебные(Модели.Список(Модель, "Хлебные")),
		Шапка(Модель),
		Навигация(Модель),
		СтрШаблон("<div class=""settings__panes"">%1%2</div>",
			Уведомления(Модели.Список(Модель, "Уведомления")),
			Секции(Модели.Список(Модель, "Секции"))));

КонецФункции

// Отрисовывает одну секцию — та же разметка, что секция внутри дома: карточка-<section>,
// своя форма с CSRF-полем и панелью сохранения, когда у секции есть Действие. Так секция
// печатается и вне дома настроек.
//
// Параметры:
//  ОписаниеСекции - Структура - секция (см. Секция).
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент <section>.
//
Функция ОтрисоватьСекцию(Знач ОписаниеСекции) Экспорт
	Возврат СекцияHTML(ОписаниеСекции);
КонецФункции

// Заготовка раздела дерева для модели дома. Поля Рубрика и Опасный стоят в структуре
// всегда, поэтому их можно дописать и у готового результата.
//
// Параметры:
//  Подпись - Строка - название раздела.
//  Адрес   - Строка - URL раздела.
//  Иконка  - Строка - (необязательный, по умолчанию "") имя иконки.
//  Активен - Булево - (необязательный, по умолчанию Ложь) текущий раздел.
//  Рубрика - Строка - (необязательный, по умолчанию "") подпись над первым разделом
//            с этим именем рубрики.
//  Опасный - Булево - (необязательный, по умолчанию Ложь) раздел необратимого: цветом
//            ошибки, последним и без рубрики.
//
// Возвращаемое значение:
//  Структура - раздел для ДеревоРазделов: Подпись, Адрес, Иконка, Активен, Рубрика, Опасный.
//
Функция Раздел(Знач Подпись, Знач Адрес, Знач Иконка = "", Знач Активен = Ложь,
	Знач Рубрика = "", Знач Опасный = Ложь) Экспорт

	Возврат Новый Структура("Подпись, Адрес, Иконка, Активен, Рубрика, Опасный",
		Подпись, Адрес, Иконка, Активен, Рубрика, Опасный = Истина);

КонецФункции

// Заготовка секции. Поля дозаполняются у результата — структура открытая.
//
// Параметры:
//  Заголовок - Строка - заголовок секции.
//  Пояснение - Строка - (необязательный, по умолчанию "") что настраивает секция.
//  Тело      - Строка - (необязательный, по умолчанию "") ДОВЕРЕННЫЙ HTML содержимого.
//
// Возвращаемое значение:
//  Структура - секция со всеми известными каркасу полями: Действие (URL POST; задан —
//              секция становится <form>), Токен (CSRF-токен, обязателен при Действии),
//              Кнопка, ИконкаКнопки (пусто — «сохранить»), ИмяКнопки и ЗначениеКнопки
//              (name/value кнопки панели: форма с двумя кнопками отличает нажатую),
//              АдресОтмены, ПояснениеПанели, Опасная, Заблокирована, БезПанели
//              (кнопки внутри тела), Иконка, Класс, Якорь, СФайлами (форма секции
//              получает enctype составной формы — без него браузер шлёт одни имена
//              файлов вместо содержимого), Свёрнута (секция уходит под кат целиком),
//              ПодписьРаскрытия (обязательна у свёрнутой) и Раскрыта (кат печатается
//              открытым — так возвращается отбитая форма).
//
Функция Секция(Знач Заголовок, Знач Пояснение = "", Знач Тело = "") Экспорт

	Результат = Новый Структура();
	Результат.Вставить("Заголовок", Заголовок);
	Результат.Вставить("Пояснение", Пояснение);
	Результат.Вставить("Тело", Тело);
	Результат.Вставить("Действие", "");
	Результат.Вставить("Токен", "");
	Результат.Вставить("Кнопка", Тексты.Текст("settings.frame.save"));
	Результат.Вставить("ИконкаКнопки", "");
	Результат.Вставить("ИмяКнопки", "");
	Результат.Вставить("ЗначениеКнопки", "");
	Результат.Вставить("АдресОтмены", "");
	Результат.Вставить("ПояснениеПанели", "");
	Результат.Вставить("Опасная", Ложь);
	Результат.Вставить("Заблокирована", Ложь);
	Результат.Вставить("БезПанели", Ложь);
	Результат.Вставить("Иконка", "");
	Результат.Вставить("Класс", "");
	Результат.Вставить("Якорь", "");
	Результат.Вставить("СФайлами", Ложь);
	Результат.Вставить("Свёрнута", Ложь);
	Результат.Вставить("ПодписьРаскрытия", "");
	Результат.Вставить("Раскрыта", Ложь);

	Возврат Результат;

КонецФункции

// Имя скрытого поля CSRF. Держим здесь, чтобы каркас не зависел от модуля office:
// значение токена даёт контроллер, а имя поля — общесистемная константа.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоляCSRF() Экспорт
	Возврат "_csrf";
КонецФункции

#Область Разметка

Функция Шапка(Знач Модель)

	Объект = Модели.Текст(Модель, "Объект");
	Пояснение = Модели.Текст(Модель, "Пояснение");

	Метка = ?(ЗначениеЗаполнено(Объект),
		СтрШаблон("<span class=""settings__object"">%1</span>", Экран.Экранировать(Объект)), "");

	Подзаголовок = ?(ЗначениеЗаполнено(Пояснение),
		СтрШаблон("<p class=""settings__lead"">%1</p>", Экран.Экранировать(Пояснение)), "");

	Возврат СтрШаблон("<header class=""settings__head""><h1 class=""settings__title"">%1%2</h1>%3%4</header>",
		Экран.Экранировать(Модели.Текст(Модель, "Заголовок")), Метка, Подзаголовок,
		ТекущийРаздел(Модели.Список(Модель, "Разделы"), 0));

КонецФункции

// Имя и значок текущего раздела — строкой, а не ссылкой: это ответ на «где я», а не ход.
// Видна строка только на узком экране с единым меню, где колонки нет (решает лист);
// печатается всегда, когда текущий раздел есть, — разметка от ширины не зависит.
Функция ТекущийРаздел(Знач Разделы, Знач Глубина)

	Если Глубина >= НаборUI.ДеревоРазделов().ПредельнаяГлубина() Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого Раздел Из Разделы Цикл

		Если Модели.Флаг(Раздел, "Активен") Тогда
			Возврат СтрШаблон("<p class=""settings__current"">%1<span>%2</span></p>",
				НаборUI.Иконка().Отрисовать(Модели.Текст(Раздел, "Иконка")),
				Экран.Экранировать(Модели.Текст(Раздел, "Подпись")));
		КонецЕсли;

		Вложенный = ТекущийРаздел(Модели.Список(Раздел, "Дети"), Глубина + 1);
		Если ЗначениеЗаполнено(Вложенный) Тогда
			Возврат Вложенный;
		КонецЕсли;

	КонецЦикла;

	Возврат "";

КонецФункции

Функция Хлебные(Знач Пункты)

	Если Пункты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Элементы = "";
	Для Каждого Пункт Из Пункты Цикл
		Адрес = Модели.Текст(Пункт, "Адрес");
		Подпись = Модели.Текст(Пункт, "Подпись");
		Содержимое = ?(ЗначениеЗаполнено(Адрес),
			Экран.Ссылка(Адрес, Подпись, "crumbs__link"), Экран.Экранировать(Подпись));
		Элементы = Элементы + СтрШаблон("<li class=""crumbs__item"">%1</li>", Содержимое);
	КонецЦикла;

	Возврат СтрШаблон("<nav class=""crumbs""%1><ul class=""crumbs__list"">%2</ul></nav>",
		Экран.Атрибут("aria-label", Тексты.Текст("settings.frame.crumbs.label")), Элементы);

КонецФункции

// Разделы дома — колонка слева. Единого меню инсталляции каркас настроек не знает:
// туда те же разделы уезжают отдельной дорогой (КаркасСтраницы.Страница, РазделыЭкрана)
// и встают там первой группой под заголовком дома.
Функция Навигация(Знач Модель)

	Разделы = Модели.Список(Модель, "Разделы");
	Если Разделы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Дерево = НаборUI.ДеревоРазделов().Отрисовать(
		Новый Структура("Заголовок, Разделы, Ориентация, Класс",
			Тексты.Текст("settings.frame.nav.title"), Разделы, "вертикаль", "tree--settings"));

	Возврат СтрШаблон("<aside class=""settings__nav"">%1</aside>", Дерево);

КонецФункции

Функция Уведомления(Знач Список)

	Результат = "";
	Для Каждого Уведомление Из Список Цикл
		Результат = Результат + НаборUI.Тост().Отрисовать(Уведомление);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Секции(Знач Список)

	Результат = "";
	Для Каждого ОписаниеСекции Из Список Цикл
		Результат = Результат + СекцияHTML(ОписаниеСекции);
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат СтрШаблон("<p class=""note-empty"">%1</p>",
			Экран.Экранировать(Тексты.Текст("settings.frame.empty")));
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция СекцияHTML(Знач ОписаниеСекции)

	Действие = Модели.Текст(ОписаниеСекции, "Действие");
	Тело = Модели.Текст(ОписаниеСекции, "Тело");

	Внутри = ?(ЗначениеЗаполнено(Тело), СтрШаблон("<div class=""section__body"">%1</div>", Тело), "");

	Если ЗначениеЗаполнено(Действие) Тогда
		Внутри = ФормаСекции(ОписаниеСекции, Действие, Внутри);
	КонецЕсли;

	Если Модели.Флаг(ОписаниеСекции, "Свёрнута") Тогда
		Внутри = ПодКатом(ОписаниеСекции, Внутри);
	КонецЕсли;

	Классы = СокрЛП(?(Модели.Флаг(ОписаниеСекции, "Опасная"), "section--danger ", "")
		+ Модели.Текст(ОписаниеСекции, "Класс"));

	Возврат НаборUI.Карточка().Контейнер(Новый Структура(
		"Префикс, Заголовок, Описание, Иконка, Классы, Якорь, ВнутриHTML",
		"section",
		Модели.Текст(ОписаниеСекции, "Заголовок"),
		Модели.Текст(ОписаниеСекции, "Пояснение"),
		Модели.Текст(ОписаниеСекции, "Иконка"),
		Классы,
		Модели.Текст(ОписаниеСекции, "Якорь"),
		Внутри));

КонецФункции

// Секция с собственным POST: своя форма, своё CSRF-поле, своя панель сохранения.
// Гейт на токен стоит здесь, а не в доме: иначе гарантия сводится к «каждый дом обязан
// помнить», и потерянный токен даёт вечный 403 на форме, которая выглядит рабочей.
Функция ФормаСекции(Знач ОписаниеСекции, Знач Действие, Знач Внутри)

	Если НЕ ЗначениеЗаполнено(Модели.Текст(ОписаниеСекции, "Токен")) Тогда
		ВызватьИсключение СтрШаблон(
			"Каркас настроек: секция «%1» задаёт POST на «%2», но не несёт CSRF-токен."
			+ " Заполните поле Токен структуры секции (РендерерНастроек.Секция) токеном"
			+ " текущей сессии — иначе форма гарантированно получит 403.",
			Модели.Текст(ОписаниеСекции, "Заголовок", "без заголовка"), Действие);
	КонецЕсли;

	Панель = "";
	Если НЕ Модели.Флаг(ОписаниеСекции, "БезПанели") Тогда
		Панель = НаборUI.ПанельСохранения().Отрисовать(
			Новый Структура("Подпись, Пояснение, АдресОтмены, Заблокирована, Опасное,"
					+ " Иконка, Имя, Значение",
				Модели.Текст(ОписаниеСекции, "Кнопка", Тексты.Текст("settings.frame.save")),
				Модели.Текст(ОписаниеСекции, "ПояснениеПанели"),
				Модели.Текст(ОписаниеСекции, "АдресОтмены"),
				Модели.Флаг(ОписаниеСекции, "Заблокирована"),
				Модели.Флаг(ОписаниеСекции, "Опасная"),
				Модели.Текст(ОписаниеСекции, "ИконкаКнопки"),
				Модели.Текст(ОписаниеСекции, "ИмяКнопки"),
				Модели.Текст(ОписаниеСекции, "ЗначениеКнопки")));
	КонецЕсли;

	// enctype печатается только там, где секция объявила файлы: у остальных форма
	// остаётся urlencoded, и разбор их тела не меняется ни на символ
	Кодировка = ?(Модели.Флаг(ОписаниеСекции, "СФайлами"),
		" enctype=""multipart/form-data""", "");

	Возврат СтрШаблон("<form class=""section__form"" method=""post""%1 action=""%2"">%3%4%5</form>",
		Кодировка,
		Экран.Экранировать(Действие),
		ПолеCSRF(Модели.Текст(ОписаниеСекции, "Токен")),
		Внутри,
		Панель);

КонецФункции

// Кат ложится на ГОТОВОЕ содержимое: <form> оказывается внутри <details>, а не наоборот.
Функция ПодКатом(Знач ОписаниеСекции, Знач Внутри)

	Если НЕ ЗначениеЗаполнено(Модели.Текст(ОписаниеСекции, "Действие")) Тогда
		ВызватьИсключение СтрШаблон(
			"Каркас настроек: секция «%1» свёрнута, но не несёт Действия. Под кат уходит"
			+ " секция ДЕЙСТВИЯ со своим POST и своим токеном; список, таблица и витрина"
			+ " значений остаются открытыми — прятать нечего.",
			Модели.Текст(ОписаниеСекции, "Заголовок", "без заголовка"));
	КонецЕсли;

	Подпись = Модели.Текст(ОписаниеСекции, "ПодписьРаскрытия");
	Если НЕ ЗначениеЗаполнено(Подпись) Тогда
		ВызватьИсключение СтрШаблон(
			"Каркас настроек: секция «%1» свёрнута, но не несёт ПодписьРаскрытия."
			+ " Заполните поле структуры секции (РендерерНастроек.Секция) — иначе под катом"
			+ " прячется блок, о котором пользователь не узнает.",
			Модели.Текст(ОписаниеСекции, "Заголовок", "без заголовка"));
	КонецЕсли;

	Возврат СтрШаблон(
		"<details class=""section__fold""%1><summary class=""fold__head"">%2</summary>%3</details>",
		?(Модели.Флаг(ОписаниеСекции, "Раскрыта"), " open", ""),
		Экран.Экранировать(Подпись),
		Внутри);

КонецФункции

Функция ПолеCSRF(Знач Токен)
	Возврат НаборUI.СкрытоеПоле().Отрисовать(
		Новый Структура("Имя, Значение", ИмяПоляCSRF(), Токен));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "НаборКомпонентов") _Компоненты,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	НаборUI = _Компоненты;
	Тексты = _Тексты;

КонецПроцедуры
