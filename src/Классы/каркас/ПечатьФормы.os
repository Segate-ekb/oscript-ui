// Печать объявленной формы — желудь UI-кита: разметка полей, раскрывашек, обёртки <form>
// и модального окна. Состава формы и разбора здесь нет — только то, как это выглядит.

Перем Экран;    // ЭкранированиеHTML
Перем Набор;    // НаборКомпонентов
Перем Модели;   // ЧтениеМодели
Перем Разметка; // РазметкаЭлементов — вид рамки в её CSS-класс

// Печатает поля и блоки в порядке объявления. Подряд идущие элементы с одинаковой
// подписью «Кат» уходят под общую раскрывашку, с одинаковым видом «Рамка» — в общую
// область; и то и другое объявляется у элементов, а не собирается вокруг них руками.
//
// Параметры:
//  Элементы - Массив из Структура - описания (ОбъявлениеФормы.Состав).
//  Значения - Соответствие - ключ поля -> строка, которую печатать в поле.
//  Отказы   - Соответствие - ключ поля -> текст отказа.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент.
//
Функция Тело(Знач Элементы, Знач Значения, Знач Отказы) Экспорт

	Результат = "";
	Индекс = 0;

	Пока Индекс < Элементы.Количество() Цикл

		Группа = Группа(Элементы[Индекс]);
		Если НЕ ЗначениеЗаполнено(Группа) Тогда
			Результат = Результат + Элемент(Элементы[Индекс], Значения, Отказы);
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;

		Внутри = "";
		Первый = Элементы[Индекс];
		Пока Индекс < Элементы.Количество() И Группа(Элементы[Индекс]) = Группа Цикл
			Внутри = Внутри + Элемент(Элементы[Индекс], Значения, Отказы);
			Индекс = Индекс + 1;
		КонецЦикла;

		Результат = Результат + Обёртка(Первый, Внутри);

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Обёртка <form> со скрытым полем CSRF.
//
// Параметры:
//  Внутри     - Строка - ДОВЕРЕННЫЙ HTML тела формы.
//  Действие   - Строка - URL, куда уходит POST.
//  Класс      - Строка - CSS-класс формы.
//  ИмяТокена  - Строка - имя скрытого поля CSRF.
//  Токен      - Строка - значение токена; пусто — поле не печатается.
//
// Возвращаемое значение:
//  Строка - HTML-форма.
//
Функция Форма(Знач Внутри, Знач Действие, Знач Класс, Знач ИмяТокена, Знач Токен) Экспорт

	ПолеТокена = ?(ЗначениеЗаполнено(Токен),
		Набор.СкрытоеПоле().Отрисовать(Новый Структура("Имя, Значение", ИмяТокена, Токен)), "");

	Возврат СтрШаблон("<form method=""post""%1 action=""%2"">%3%4</form>",
		Экран.Атрибут("class", Класс), Экран.Экранировать(Действие), ПолеТокена, Внутри);

КонецФункции

// Кнопка открытия и модальное окно с готовой формой внутри. Скрипта нет: открытие,
// закрытие по Esc и щелчку мимо, удержание фокуса и гашение фона — работа движка.
// Связь кнопки с окном — по идентификатору, который выдаёт кит, а не данные.
//
// Параметры:
//  Ид     - Строка - идентификатор окна.
//  Внутри - Строка - ДОВЕРЕННЫЙ HTML формы окна.
//  Модель - Структура - Заголовок (обязателен: он же имя окна для скринридера),
//           Лид (что настраивает форма), Открывашка (подпись кнопки открытия; пусто —
//           кнопка не печатается), ИконкаОткрывашки, ВариантОткрывашки, Открыта
//           (окно печатается открытым — так отбитая форма возвращается человеку
//           вместе с набранным).
//
// Возвращаемое значение:
//  Строка - кнопка и <dialog>; окно места на экране не занимает, пока не открыто.
//
Функция Окно(Знач Ид, Знач Внутри, Знач Модель) Экспорт

	// заголовок обязателен, и своего гейта здесь нет: пустой отвергает сам компонент
	// «Заголовок страницы», а им же окно называет себя скринридеру
	Заголовок = Модели.Текст(Модель, "Заголовок");

	Открывашка = Модели.Текст(Модель, "Открывашка");
	Кнопка = ?(НЕ ЗначениеЗаполнено(Открывашка), "", Набор.Кнопка().Отрисовать(
		Новый Структура("Подпись, Вариант, Иконка, Команда, Цель",
			Открывашка, Модели.Текст(Модель, "ВариантОткрывашки", "вторичная"),
			Модели.Текст(Модель, "ИконкаОткрывашки"), "показать-окно", Ид)));

	Возврат Кнопка + СтрШаблон("<dialog class=""modal""%1%2%3><div class=""modal__box"">%4%5</div></dialog>",
		Экран.Атрибут("id", Ид),
		Экран.Атрибут("aria-label", Заголовок),
		Экран.БулевАтрибут("open", Модели.Флаг(Модель, "Открыта")),
		Набор.ЗаголовокСтраницы().Отрисовать(
			Новый Структура("Заголовок, Уровень, Пояснение", Заголовок, 2,
				Модели.Текст(Модель, "Лид"))),
		Внутри);

КонецФункции

// Ряд кнопок подвала окна: закрытие и отправка. Закрытие — команда движка, отправка —
// обычный submit, поэтому форма работает и там, где команда не поддержана.
//
// Параметры:
//  Ид     - Строка - идентификатор окна.
//  Модель - Структура - Отмена (подпись кнопки закрытия; пусто — кнопки нет),
//           Отправка (подпись кнопки отправки), ИконкаОтправки, ИмяКнопки и
//           ЗначениеКнопки (name/value кнопки отправки: форма с двумя кнопками
//           отличает нажатую), Опасная.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент подвала.
//
Функция Подвал(Знач Ид, Знач Модель) Экспорт

	Отмена = Модели.Текст(Модель, "Отмена");
	Закрыть = ?(НЕ ЗначениеЗаполнено(Отмена), "", Набор.Кнопка().Отрисовать(
		Новый Структура("Подпись, Вариант, Команда, Цель", Отмена, "вторичная", "закрыть", Ид)));

	Отправка = Модели.Текст(Модель, "Отправка");
	Отправить = ?(НЕ ЗначениеЗаполнено(Отправка), "", Набор.Кнопка().Отрисовать(
		Новый Структура("Подпись, Вариант, Иконка, Имя, Значение",
			Отправка, ?(Модели.Флаг(Модель, "Опасная"), "опасная", "основная"),
			Модели.Текст(Модель, "ИконкаОтправки"),
			Модели.Текст(Модель, "ИмяКнопки"), Модели.Текст(Модель, "ЗначениеКнопки"))));

	Возврат СтрШаблон("<div class=""modal__actions"">%1%2</div>", Закрыть, Отправить);

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Ключ группы: раскрывашка старше рамки, потому что она видна и без CSS.
Функция Группа(Знач Описание)
	Возврат ?(ЗначениеЗаполнено(Описание.Кат), "кат:" + Описание.Кат,
		?(ЗначениеЗаполнено(Описание.Рамка), "рамка:" + Описание.Рамка, ""));
КонецФункции

Функция Обёртка(Знач Описание, Знач Внутри)

	Если ЗначениеЗаполнено(Описание.Кат) Тогда
		Возврат СтрШаблон("<details class=""panel""><summary class=""panel__head"">%1</summary>"
				+ "<div class=""panel__body"">%2</div></details>",
			Экран.Экранировать(Описание.Кат), Внутри);
	КонецЕсли;

	// рамка называется ВИДОМ области, а не именем класса: имя класса за границу кита
	// не выходит, и неизвестный вид останавливает сборку, а не даёт голый <div>
	Возврат СтрШаблон("<div%1>%2</div>",
		Экран.Атрибут("class", Разметка.КлассВида("область", Описание.Рамка)), Внутри);

КонецФункции

Функция Элемент(Знач Описание, Знач Значения, Знач Отказы)

	Если Описание.Род = "блок" Тогда
		Возврат Описание.Разметка;
	КонецЕсли;

	Значение = Текстом(Значения.Получить(Описание.Ключ));

	Модель = Новый Структура();
	Модель.Вставить("Имя", Описание.Имя);
	Модель.Вставить("Ид", Описание.Имя);
	Модель.Вставить("Метка", Описание.Метка);
	Модель.Вставить("Тип", ТипКита(Описание.Вид));
	Модель.Вставить("Значение", Значение);
	Модель.Вставить("Отмечено", Значение = "1");
	Модель.Вставить("Подсказка", Описание.Подсказка);
	Модель.Вставить("Плейсхолдер", Описание.Плейсхолдер);
	Модель.Вставить("Автозаполнение", Описание.Автозаполнение);
	Модель.Вставить("Обязательное", Описание.Обязательное);
	Модель.Вставить("ТолькоЧтение", Описание.ТолькоЧтение);
	Модель.Вставить("Варианты", Варианты(Описание, Значение));
	Модель.Вставить("Ошибка", Текстом(Отказы.Получить(Описание.Ключ)));

	Возврат Набор.Поле().Отрисовать(Модель);

КонецФункции

// Пометка выбранного варианта — работа слоя: вариант, совпавший со значением поля,
// получает Выбрано, и объявивший варианты не обязан помнить про предвыбор. Пустое
// значение поля значит «человек ещё не выбирал» — тогда решает флаг варианта.
Функция Варианты(Знач Описание, Знач Значение)

	Если Описание.Вид <> "выбор" Тогда
		Возврат Описание.Варианты;
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого Вариант Из Описание.Варианты Цикл
		Результат.Добавить(Новый Структура("Значение, Подпись, Выбрано, Данные",
			Модели.Текст(Вариант, "Значение"),
			Модели.Текст(Вариант, "Подпись", Модели.Текст(Вариант, "Значение")),
			?(ЗначениеЗаполнено(Значение), Модели.Текст(Вариант, "Значение") = Значение,
				Модели.Флаг(Вариант, "Выбрано")),
			Модели.Значение(Вариант, "Данные")));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ТипКита(Знач Вид)

	Если Вид = "секрет" Тогда
		Возврат "пароль";
	ИначеЕсли Вид = "строка" ИЛИ НЕ ЗначениеЗаполнено(Вид) Тогда
		Возврат "текст";
	КонецЕсли;

	Возврат Вид;

КонецФункции

Функция Текстом(Знач Значение)
	Возврат ?(Значение = Неопределено, "", Строка(Значение));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "НаборКомпонентов") _Набор,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "РазметкаЭлементов") _Разметка) Экспорт

	Экран = _Экран;
	Набор = _Набор;
	Модели = _Модели;
	Разметка = _Разметка;

КонецПроцедуры
