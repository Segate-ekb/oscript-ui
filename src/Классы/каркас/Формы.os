// Фабрика объявлений форм — желудь UI-кита. Само объявление желудём быть не может:
// у него есть состав, поэтому каждому экрану выдаётся новое.

Перем Модели;    // ЧтениеМодели
Перем Проверка;  // ПроверкаПоля
Перем Значения;  // ЗначенияФормы
Перем Печать;    // ПечатьФормы
Перем Каркас;    // РендерерНастроек — имя скрытого поля CSRF общее у формы и у секции
Перем Выдано;    // Число — сколько объявлений выдано; из него растёт идентификатор окна

// Новое пустое объявление формы.
//
// Возвращаемое значение:
//  ОбъявлениеФормы - объявление, которому перечисляют поля и блоки.
//
Функция Новая() Экспорт

	// идентификатор окна выдаёт КИТ порядковым номером: возьми его кит из данных —
	// два похожих имени дали бы один идентификатор, и кнопка открыла бы чужое окно
	Выдано = Выдано + 1;

	Возврат Новый ОбъявлениеФормы(Модели, Проверка, Значения, Печать, Каркас.ИмяПоляCSRF(),
		"okno-" + Формат(Выдано, "ЧГ=0; ЧН=0"));

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "ПроверкаПоля") _Проверка,
	&Пластилин(Значение = "ЗначенияФормы") _Значения,
	&Пластилин(Значение = "ПечатьФормы") _Печать,
	&Пластилин(Значение = "РендерерНастроек") _Каркас) Экспорт

	Модели = _Модели;
	Проверка = _Проверка;
	Значения = _Значения;
	Печать = _Печать;
	Каркас = _Каркас;
	Выдано = 0;

КонецПроцедуры
