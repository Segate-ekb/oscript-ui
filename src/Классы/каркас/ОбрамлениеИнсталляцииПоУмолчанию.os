// Обрамление инсталляции по умолчанию — реализация контракта «ОбрамлениеИнсталляции».
// Кто такая инсталляция, как её зовут, куда ведут её ходы и чем она подписана, кит
// не знает и знать не может: обрамление ПУСТОЕ, а своё инсталляция подставляет тем же
// прозвищем с пометкой &Верховный.
//
// Контракт живёт ПРОЗВИЩЕМ, а не именем класса: ОСень ищет желудь сперва по имени и лишь
// потом по прозвищу, поэтому класс, НАЗВАННЫЙ «ОбрамлениеИнсталляции», перебить было бы
// нельзя ничем.

// Чем инсталляция обрамляет содержимое страницы. Спрашивается НА КАЖДЫЙ запрос:
// и знак, и разделы, и имя вошедшего меняются от запроса к запросу.
//
// Параметры:
//  Контекст - Структура - контекст запроса: Пользователь, КукиЗапроса, ПоказатьАдмин,
//             Приватная.
//
// Возвращаемое значение:
//  Структура:
//   Язык             - Строка - код языка страницы; "" — язык не объявляется;
//   Знак             - Строка - как инсталляция называет себя в шапке и во вкладке;
//   Подпись          - Строка - строка подвала;
//   ПолитикаПерехода - Строка - что уходит наружу в заголовке перехода;
//   АдресСтилей      - Строка - адрес СВОЕГО листа стилей; он встаёт вторым после
//                      базового листа библиотеки и потому перебивает его правила.
//                      Пусто — инсталляции хватает базового листа;
//   АдресСкрипта     - Строка - адрес скрипта страницы;
//   Иконки           - Массив из Структура(Отношение, Тип, Размеры, Адрес);
//   Знамя            - Структура(Адрес, Ширина, Название): картинка знака, её известная
//                      ширина в пикселях (0 — пропорции произвольны, считает браузер)
//                      и печатать ли название рядом с картинкой;
//   Разделы          - Массив из Структура(Подпись, Адрес, Иконка) — верхняя навигация;
//   Приватные        - Массив той же формы — навигация приватной части; пустой массив
//                      означает, что страница публичная;
//   Аккаунт          - Строка - имя вошедшего; "" — на странице посетитель;
//   Адреса           - Структура(Корень, Вход, Кабинет, Выход, Оформление).
//
Функция Обрамление(Знач Контекст) Экспорт

	Результат = Новый Структура();
	Результат.Вставить("Язык", "");
	Результат.Вставить("Знак", "");
	Результат.Вставить("Подпись", "");
	Результат.Вставить("ПолитикаПерехода", "");
	Результат.Вставить("АдресСтилей", "");
	Результат.Вставить("АдресСкрипта", "");
	Результат.Вставить("Иконки", Новый Массив());
	Результат.Вставить("Знамя", Новый Структура("Адрес, Ширина, Название", "", 0, Ложь));
	Результат.Вставить("Разделы", Новый Массив());
	Результат.Вставить("Приватные", Новый Массив());
	Результат.Вставить("Аккаунт", "");
	Результат.Вставить("Адреса", Новый Структура("Корень, Вход, Кабинет, Выход, Оформление",
		"", "", "", "", ""));
	Возврат Результат;

КонецФункции

&Прозвище("ОбрамлениеИнсталляции")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
