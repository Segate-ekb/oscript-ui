// Обрамление инсталляции по умолчанию — реализация контракта «ОбрамлениеИнсталляции».
// Кто такая инсталляция, как её зовут, куда ведут её ходы и чем она подписана, кит
// не знает и знать не может: обрамление ПУСТОЕ, а своё инсталляция подставляет тем же
// прозвищем с пометкой &Верховный.
//
// Контракт живёт ПРОЗВИЩЕМ, а не именем класса: ОСень ищет желудь сперва по имени и лишь
// потом по прозвищу, поэтому класс, НАЗВАННЫЙ «ОбрамлениеИнсталляции», перебить было бы
// нельзя ничем.

// Чем инсталляция обрамляет содержимое страницы. Спрашивается НА КАЖДЫЙ запрос:
// и знак, и разделы, и имя вошедшего меняются от запроса к запросу.
//
// Параметры:
//  Контекст - Структура - контекст запроса: Пользователь, КукиЗапроса, ПоказатьАдмин,
//             Приватная, Путь (путь текущего запроса; кит его не разбирает, а довозит
//             сюда — по нему инсталляция и решает, какая её дорога активна).
//
// Возвращаемое значение:
//  Структура:
//   Язык             - Строка - код языка страницы; "" — язык не объявляется;
//   Знак             - Строка - как инсталляция называет себя в шапке и во вкладке;
//   Подпись          - Строка - строка подвала;
//   ПолитикаПерехода - Строка - что уходит наружу в заголовке перехода;
//   АдресСтилей      - Строка - адрес СВОЕГО листа стилей; он встаёт вторым после
//                      базового листа библиотеки и потому перебивает его правила.
//                      Пусто — инсталляции хватает базового листа;
//   АдресСкрипта     - Строка - адрес скрипта страницы;
//   Иконки           - Массив из Структура(Отношение, Тип, Размеры, Адрес);
//   Знамя            - Структура(Адрес, Ширина, Название): картинка знака, её известная
//                      ширина в пикселях (0 — пропорции произвольны, считает браузер)
//                      и печатать ли название рядом с картинкой;
//   Разделы          - Массив из Структура(Подпись, Адрес, Иконка) — верхняя навигация;
//   Приватные        - Массив той же формы — навигация приватной части; пустой массив
//                      означает, что страница публичная;
//   Действия         - Массив - что стоит в шапке справа от дорог, по порядку: вход,
//                      кабинет, выход, меню учётки, ссылка на репозиторий — что угодно.
//                      Кит своих действий не сочиняет. Элемент — модель кнопки кита
//                      (Структура: Подпись, Адрес, Иконка, Вариант, ТолькоИконка…), узел
//                      холста (Кит.Меню с полем Аккаунт — меню учётки; Кит.ФормаБезТокена —
//                      форма выхода) либо ДОВЕРЕННЫЙ фрагмент HTML (Строка). На телефоне
//                      с единым меню действия уезжают в его панель кнопками во всю ширину;
//   МенюХаба         - Структура, Неопределено - слот ЕДИНОГО меню инсталляции. Заполнен —
//                      дороги, тема, действия и учётка собираются в одну панель.
//                      На широком экране шапка прежняя (знак, дороги, тема, действия),
//                      а кнопка учётки открывает панель выпадающим меню; на телефоне
//                      полоса ходов прячется, слева встаёт бургер, панель выезжает
//                      шторкой. Поля:
//                      Счётчик и ПодписьСчётчика — сумма дел на бургере и как она
//                      зовётся в речи. ПРАВИЛО ПАРЫ: задано непустое ненулевое число —
//                      обязана быть и подпись, иначе меню не соберётся; ноль и пусто
//                      не печатаются вовсе. Правило одно и то же для суммы на бургере
//                      и для числа у пункта;
//                      Учётка — Структура(Логин, Роль, Адрес): вошедший, его роль словами
//                      и ход в кабинет. Логин пуст — блока учётки нет;
//                      Дела — Массив(Подпись, Адрес, Иконка, Счётчик, ПодписьСчётчика,
//                      Активен): личные дела с РАЗДЕЛЬНЫМИ числами;
//                      Навигация — Массив(Подпись, Адрес, Иконка, Активен): дороги хаба;
//                      они же становятся значками рейки. Активен подсвечивает дорогу
//                      В ОБОИХ местах разом — и пункт панели, и значок рейки. Активен
//                      вычисляет ИНСТАЛЛЯЦИЯ, сравнивая свои адреса с Путём контекста:
//                      кит адресов не знает и сравнивать их не берётся;
//                      разделы ТЕКУЩЕГО экрана в слот НЕ входят: их знает не инсталляция,
//                      а сама страница, и они приходят четвёртым параметром
//                      КаркасСтраницы.Страница(..., РазделыЭкрана);
//                      Выход — ДОВЕРЕННЫЙ фрагмент (форма выхода) в подвале панели.
//                      Ни дел, ни навигации, ни логина — слот пуст, и шапка остаётся
//                      прежней целиком;
//   Адреса           - Структура(Корень, Оформление): ход знака и адрес POST
//                      переключателя темы. Пустое Оформление — переключателя нет.
//
Функция Обрамление(Знач Контекст) Экспорт

	Результат = Новый Структура();
	Результат.Вставить("Язык", "");
	Результат.Вставить("Знак", "");
	Результат.Вставить("Подпись", "");
	Результат.Вставить("ПолитикаПерехода", "");
	Результат.Вставить("АдресСтилей", "");
	Результат.Вставить("АдресСкрипта", "");
	Результат.Вставить("Иконки", Новый Массив());
	Результат.Вставить("Знамя", Новый Структура("Адрес, Ширина, Название", "", 0, Ложь));
	Результат.Вставить("Разделы", Новый Массив());
	Результат.Вставить("Приватные", Новый Массив());
	Результат.Вставить("Действия", Новый Массив());
	Результат.Вставить("МенюХаба", Неопределено);
	Результат.Вставить("Адреса", Новый Структура("Корень, Оформление", "", ""));
	Возврат Результат;

КонецФункции

&Прозвище("ОбрамлениеИнсталляции")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
