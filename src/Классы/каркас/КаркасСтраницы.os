// Каркас страницы — желудь UI-кита: корень документа. Собирает страницу целиком деревом
// элементов — от объявления типа до отложенного скрипта — вокруг готового содержимого.
// Кто такая инсталляция и куда ведут её ходы, приходит контрактом «ОбрамлениеИнсталляции»:
// ни одного адреса и ни одного имени этого хаба здесь нет.

Перем Кит;           // Кит — фабрика элементов
Перем Токены;        // ТокеныТемы — палитра и атрибут темы
Перем ВыборВида;     // ВыборОформления — оформление читателя
Перем Тексты;        // ТекстыИнтерфейса — строки самого обрамления
Перем Модели;        // ЧтениеМодели — мягкое чтение обрамления
Перем Активы;        // АктивыСтатики — адрес базового листа библиотеки
Перем Инсталляция;   // ОбрамлениеИнсталляции — знак, ходы, подпись, разделы

#Область ПубличныйИнтерфейс

// Собирает контекст запроса. КукиЗапроса обязательны: страница без них молча потеряла бы
// оформление читателя, поэтому тот, кому нечего передать, пишет Неопределено явно.
//
// Параметры:
//  Пользователь  - Произвольный, Неопределено - принципал запроса; посетитель —
//                  Неопределено.
//  КукиЗапроса   - Куки, Неопределено - куки запроса winow.
//  ПоказатьАдмин - Булево - (необязательный, по умолчанию Ложь) показывать ли разделы
//                  администратора в навигации приватной части.
//  Приватная     - Булево - (необязательный, по умолчанию Ложь) страница приватной
//                  части: над содержимым встаёт её навигация.
//
// Возвращаемое значение:
//  Структура - Пользователь, КукиЗапроса, ПоказатьАдмин, Приватная.
//
Функция КонтекстСтраницы(Знач Пользователь, Знач КукиЗапроса, Знач ПоказатьАдмин = Ложь,
	Знач Приватная = Ложь) Экспорт

	Возврат Новый Структура("Пользователь, КукиЗапроса, ПоказатьАдмин, Приватная",
		Пользователь, КукиЗапроса, ПоказатьАдмин = Истина, Приватная = Истина);

КонецФункции

// Полный HTML-документ вокруг содержимого.
//
// Параметры:
//  Заголовок  - Строка - заголовок вкладки; пустой оставляет во вкладке один знак.
//  Содержимое - ЭлементЭкрана, Строка - то, ради чего страницу открыли. Строка —
//               ДОВЕРЕННЫЙ HTML непереведённого экрана, она заворачивается в готовый
//               фрагмент.
//  Контекст   - Структура - контекст запроса, см. КонтекстСтраницы().
//
// Возвращаемое значение:
//  Строка - HTML-документ.
//
Функция Страница(Знач Заголовок, Знач Содержимое, Знач Контекст) Экспорт
	Возврат Документ(Заголовок, Содержимое, Контекст).Рендер();
КонецФункции

// Дерево документа — тот же каркас, но элементом: из чего собрана страница, отвечается
// объектом.
//
// Параметры:
//  Заголовок  - Строка - заголовок вкладки.
//  Содержимое - ЭлементЭкрана, Строка - содержимое страницы.
//  Контекст   - Структура - контекст запроса, см. КонтекстСтраницы().
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел рода «документ».
//
Функция Документ(Знач Заголовок, Знач Содержимое, Знач Контекст) Экспорт

	ПроверитьКонтекст(Контекст);

	Рамка = Инсталляция.Обрамление(Контекст);
	Оформление = ВыборВида.ПоКукам(Контекст.КукиЗапроса);

	Корень = Кит.Документ(Модели.Текст(Рамка, "Язык"), Токены.АтрибутТемы(Оформление));
	Корень.Добавить(ГоловаДокумента(Рамка, Заголовок, Оформление));
	Корень.Добавить(ТелоДокумента(Рамка, Содержимое, Оформление));
	Возврат Корень;

КонецФункции

#КонецОбласти

#Область Голова

Функция ГоловаДокумента(Знач Рамка, Знач Заголовок, Знач Оформление)

	Голова = Кит.Голова();

	Голова.Добавить(Кит.Кодировка("utf-8"));
	Голова.Добавить(Кит.Мета("viewport", "width=device-width, initial-scale=1"));
	Голова.Добавить(Кит.Мета("color-scheme", "dark light"));
	// адрес страницы наружу не уходит: в нём живут одноразовые ссылки и коды входа
	Голова.Добавить(Кит.Мета("referrer", Модели.Текст(Рамка, "ПолитикаПерехода")));
	Голова.Добавить(Кит.Титул(ЗаголовокВкладки(Заголовок, Модели.Текст(Рамка, "Знак"))));

	Для Каждого Иконка Из Модели.Список(Рамка, "Иконки") Цикл
		Голова.Добавить(Кит.Ресурс(Модели.Текст(Иконка, "Отношение"),
			Модели.Текст(Иконка, "Адрес"), Модели.Текст(Иконка, "Тип"),
			Модели.Текст(Иконка, "Размеры")));
	КонецЦикла;

	// палитра едет инлайном: она обязана приехать вместе с разметкой, иначе страница
	// мигнёт нецветной, пока лист стилей ещё в пути
	Голова.Добавить(Кит.Стиль("токены-темы", Токены.Переменные(Оформление)));

	// порядок листов = порядок каскада: базовый лист библиотеки первым, лист инсталляции
	// вторым. Обратный порядок отнял бы у инсталляции возможность перебить правило,
	// не повышая специфичность и не ставя !important
	Голова.Добавить(Кит.Ресурс("stylesheet", Активы.АдресБазовогоЛиста()));
	Голова.Добавить(Кит.Ресурс("stylesheet", Модели.Текст(Рамка, "АдресСтилей")));

	Возврат Голова;

КонецФункции

Функция ЗаголовокВкладки(Знач Заголовок, Знач Знак)
	Возврат ?(ЗначениеЗаполнено(Заголовок), Строка(Заголовок) + " — " + Знак, Знак);
КонецФункции

#КонецОбласти

#Область Тело

Функция ТелоДокумента(Знач Рамка, Знач Содержимое, Знач Оформление)

	Тело = Кит.Тело();

	Тело.Добавить(ШапкаСтраницы(Рамка, Оформление));
	Тело.Добавить(ОсновноеСтраницы(Рамка, Содержимое));
	Тело.Добавить(ПодвалСтраницы(Рамка));
	Тело.Добавить(Кит.Скрипт(Модели.Текст(Рамка, "АдресСкрипта")));

	Возврат Тело;

КонецФункции

Функция ОсновноеСтраницы(Знач Рамка, Знач Содержимое)

	Основное = Кит.Основное("полоса");

	Приватные = Модели.Список(Рамка, "Приватные");
	Если Приватные.Количество() > 0 Тогда
		Основное.Добавить(Кит.ДеревоРазделов(Новый Структура("Заголовок, Разделы, Ориентация, Класс",
			Тексты.Текст("chrome.office.nav.title"), Приватные, "горизонталь", "office-nav")));
	КонецЕсли;

	Основное.Добавить(СодержимоеУзлом(Содержимое));
	Возврат Основное;

КонецФункции

// Экран, ещё не собранный деревом, отдаёт строку — она заворачивается в готовый фрагмент.
// Экран, собранный деревом, кладётся в основное как есть.
Функция СодержимоеУзлом(Знач Содержимое)

	Если ТипЗнч(Содержимое) = Тип("Строка") ИЛИ Содержимое = Неопределено Тогда
		Возврат Кит.Готовое(Содержимое);
	КонецЕсли;
	Возврат Содержимое;

КонецФункции

Функция ПодвалСтраницы(Знач Рамка)

	Подвал = Кит.Подвал("страницы");
	Подвал.Добавить(Кит.Область("полоса")).Добавить(Кит.Текст(Модели.Текст(Рамка, "Подпись")));
	Возврат Подвал;

КонецФункции

#КонецОбласти

#Область Шапка

Функция ШапкаСтраницы(Знач Рамка, Знач Оформление)

	Адреса = Модели.Значение(Рамка, "Адреса");

	Шапка = Кит.Шапка("страницы");
	Полоса = Шапка.Добавить(Кит.Область("полоса"));

	Полоса.Добавить(ХодНаГлавную(Рамка, Адреса));

	Навигация = Полоса.Добавить(Кит.Навигация("верхняя"));
	Навигация.Добавить(Кит.ДеревоРазделов(Новый Структура("Заголовок, Разделы, Ориентация, Класс",
		Тексты.Текст("chrome.top.nav.title"), Модели.Список(Рамка, "Разделы"),
		"горизонталь", "tree--top")));
	Навигация.Добавить(ПереключательОформления(Адреса, Оформление));
	СобратьУчётку(Навигация, Рамка, Адреса);

	Возврат Шапка;

КонецФункции

// Знак инсталляции — картинка, а название рядом остаётся ТЕКСТОМ: так оно выделяется
// поиском и читается скринридером, поэтому подписи у картинки нет. Спрятали название —
// картинка становится единственным именем хода, и подпись обязана его назвать.
Функция ХодНаГлавную(Знач Рамка, Знач Адреса)

	Знак = Модели.Текст(Рамка, "Знак");
	Знамя = Модели.Значение(Рамка, "Знамя");
	Название = Модели.Флаг(Знамя, "Название");

	Ход = Кит.Ссылка(Модели.Текст(Адреса, "Корень"), "знак");

	Картинка = Ход.Добавить(Кит.Картинка(Модели.Текст(Знамя, "Адрес"), "знак")
		.Подпись(?(Название, "", Знак))
		.Высота(ВысотаЗнака()));
	// ширину печатает только тот знак, чьи пропорции известны заранее: у произвольного
	// логотипа width впрессовал бы картинку в чужую рамку
	Картинка.Ширина(Модели.Значение(Знамя, "Ширина"));

	Если Название Тогда
		Ход.Добавить(Кит.Надпись()).Добавить(Кит.Текст(Знак));
	КонецЕсли;

	Возврат Ход;

КонецФункции

// Высота знака в разметке: место под него занято до того, как приедет лист стилей,
// и шапка не прыгает. Величину знает кит — он же печатает класс знака.
Функция ВысотаЗнака()
	Возврат 28;
КонецФункции

// Переключатель оформления — форма, работающая без скрипта. Дорога одна и она серверная:
// значок выбирает сервер по текущему оформлению, второго источника правды о теме нет.
// Токена не несёт: подделка этого запроса меняет читателю цвет фона, и только.
Функция ПереключательОформления(Знач Адреса, Знач Оформление)

	Светлая = (Токены.АтрибутТемы(Оформление) = "light");

	Форма = Кит.ФормаБезТокена(Модели.Текст(Адреса, "Оформление"), "переключатель");
	Форма.Добавить(Кит.Кнопка(Новый Структура(
		"Подпись, Вариант, Размер, Иконка, ТолькоИконка, Подсказка",
		Тексты.Текст("chrome.top.theme.toggle"), "ссылка", "малый",
		?(Светлая, "луна", "солнце"), Истина,
		?(Светлая, Тексты.Текст("chrome.top.theme.to-dark"),
			Тексты.Текст("chrome.top.theme.to-light")))));
	Возврат Форма;

КонецФункции

// Посетителю — ход ко входу, вошедшему — его имя, ход в кабинет и выход. Выход идёт
// формой: ход по ссылке уводил бы человека из учётки предзагрузкой соседней вкладки.
Процедура СобратьУчётку(Навигация, Знач Рамка, Знач Адреса)

	Аккаунт = Модели.Текст(Рамка, "Аккаунт");

	Если НЕ ЗначениеЗаполнено(Аккаунт) Тогда
		Навигация.Добавить(Кит.Ссылка(Модели.Текст(Адреса, "Вход"), "шапка"))
			.Добавить(Кит.Текст(Тексты.Текст("chrome.top.login")));
		Возврат;
	КонецЕсли;

	Кто = Навигация.Добавить(Кит.Надпись("учётка"));
	Кто.Добавить(Кит.Иконка("аккаунт"));
	Кто.Добавить(Кит.Текст(Аккаунт));

	Навигация.Добавить(Кит.Ссылка(Модели.Текст(Адреса, "Кабинет"), "шапка"))
		.Добавить(Кит.Текст(Тексты.Текст("chrome.top.office")));

	Выход = Навигация.Добавить(Кит.ФормаБезТокена(Модели.Текст(Адреса, "Выход"), "строкой"));
	Выход.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер, Иконка",
		Тексты.Текст("chrome.top.logout"), "ссылка", "малый", "выход")));

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьКонтекст(Знач Контекст)

	Если ТипЗнч(Контекст) = Тип("Структура") И Контекст.Свойство("КукиЗапроса") Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение "КаркасСтраницы.Страница: третьим аргументом обязан прийти контекст"
		+ " запроса — соберите его КонтекстСтраницы(Пользователь, КукиЗапроса). Без кук"
		+ " страница молча потеряла бы оформление читателя.";

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТокеныТемы") _Токены,
	&Пластилин(Значение = "ВыборОформления") _ВыборВида,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "АктивыСтатики") _Активы,
	&Пластилин(Значение = "ОбрамлениеИнсталляции") _Инсталляция) Экспорт

	Кит = _Кит;
	Токены = _Токены;
	ВыборВида = _ВыборВида;
	Тексты = _Тексты;
	Модели = _Модели;
	Активы = _Активы;
	Инсталляция = _Инсталляция;

КонецПроцедуры
