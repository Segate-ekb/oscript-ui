// Каркас страницы — желудь UI-кита: корень документа. Собирает страницу целиком деревом
// элементов — от объявления типа до отложенного скрипта — вокруг готового содержимого.
// Кто такая инсталляция и куда ведут её ходы, приходит контрактом «ОбрамлениеИнсталляции»:
// ни одного адреса и ни одного имени этого хаба здесь нет.

Перем Кит;           // Кит — фабрика элементов
Перем Токены;        // ТокеныТемы — палитра и атрибут темы
Перем ВыборВида;     // ВыборОформления — оформление читателя
Перем Тексты;        // ТекстыИнтерфейса — строки самого обрамления
Перем Модели;        // ЧтениеМодели — мягкое чтение обрамления
Перем Активы;        // АктивыСтатики — адрес базового листа библиотеки
Перем Инсталляция;   // ОбрамлениеИнсталляции — знак, ходы, подпись, разделы
Перем МенюХаба;      // МенюХаба — единая навигация инсталляции: бургер, учётка, панель

#Область ПубличныйИнтерфейс

// Собирает контекст запроса. КукиЗапроса обязательны: страница без них молча потеряла бы
// оформление читателя, поэтому тот, кому нечего передать, пишет Неопределено явно.
//
// Параметры:
//  Пользователь  - Произвольный, Неопределено - принципал запроса; посетитель —
//                  Неопределено.
//  КукиЗапроса   - Куки, Неопределено - куки запроса winow.
//  ПоказатьАдмин - Булево - (необязательный, по умолчанию Ложь) показывать ли разделы
//                  администратора в навигации приватной части.
//  Приватная     - Булево - (необязательный, по умолчанию Ложь) страница приватной
//                  части: над содержимым встаёт её навигация.
//  Путь          - Строка - (необязательный, по умолчанию "") путь текущего запроса.
//                  Кит его НЕ разбирает и ни с чем не сравнивает — только довозит
//                  до обрамления: какая дорога сейчас активна, знает инсталляция,
//                  потому что адреса дорог придумала она. Пусто — как было раньше.
//
// Возвращаемое значение:
//  Структура - Пользователь, КукиЗапроса, ПоказатьАдмин, Приватная, Путь.
//
Функция КонтекстСтраницы(Знач Пользователь, Знач КукиЗапроса, Знач ПоказатьАдмин = Ложь,
	Знач Приватная = Ложь, Знач Путь = "") Экспорт

	Возврат Новый Структура("Пользователь, КукиЗапроса, ПоказатьАдмин, Приватная, Путь",
		Пользователь, КукиЗапроса, ПоказатьАдмин = Истина, Приватная = Истина,
		?(Путь = Неопределено, "", Строка(Путь)));

КонецФункции

// Полный HTML-документ вокруг содержимого.
//
// Параметры:
//  Заголовок      - Строка - заголовок вкладки; пустой оставляет во вкладке один знак.
//  Содержимое     - ЭлементЭкрана, Строка - то, ради чего страницу открыли. Строка —
//                   ДОВЕРЕННЫЙ HTML непереведённого экрана, она заворачивается в готовый
//                   фрагмент.
//  Контекст       - Структура - контекст запроса, см. КонтекстСтраницы().
//  РазделыЭкрана  - Массив, Структура, Неопределено - (необязательный, по умолчанию
//                   Неопределено) разделы ТЕКУЩЕГО экрана (Подпись, Адрес, Иконка, Активен,
//                   Рубрика, Опасный, Счётчик, ПодписьСчётчика) — их знает не инсталляция,
//                   а сама страница, поэтому они приходят сюда, а не обрамлением. Уезжают
//                   в единое меню первой группой под учёткой; пусто — группы нет. Структура
//                   Заголовок, Разделы называет группу именем экрана; у массива группа
//                   подписана словарём (chrome.menu.section.screen). Не передан, а содержимое —
//                   дом настроек (Кит.ДомНастроек): разделы берутся у дома, а группа
//                   называется его заголовком.
//  КарточкаСсылки - Массив из Структура, Неопределено - (необязательный, по умолчанию
//                   Неопределено) свойства карточки, которую чужой сервис строит по ссылке
//                   на страницу: Свойство (og:title, og:image…) и Содержание. Печатаются
//                   в голове объявлениями <meta property> в порядке массива; пара с пустым
//                   свойством или содержанием не печатается. Пусто — голова прежняя.
//
// Возвращаемое значение:
//  Строка - HTML-документ.
//
Функция Страница(Знач Заголовок, Знач Содержимое, Знач Контекст,
	Знач РазделыЭкрана = Неопределено, Знач КарточкаСсылки = Неопределено) Экспорт

	Возврат Документ(Заголовок, Содержимое, Контекст, РазделыЭкрана, КарточкаСсылки).Рендер();

КонецФункции

// Дерево документа — тот же каркас, но элементом: из чего собрана страница, отвечается
// объектом.
//
// Параметры:
//  Заголовок     - Строка - заголовок вкладки.
//  Содержимое    - ЭлементЭкрана, Строка - содержимое страницы.
//  Контекст      - Структура - контекст запроса, см. КонтекстСтраницы().
//  РазделыЭкрана - Массив, Неопределено - (необязательный) разделы текущего экрана,
//                  см. Страница().
//  КарточкаСсылки - Массив из Структура, Неопределено - (необязательный) свойства
//                   карточки ссылки на страницу, см. Страница().
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел рода «документ».
//
Функция Документ(Знач Заголовок, Знач Содержимое, Знач Контекст,
	Знач РазделыЭкрана = Неопределено, Знач КарточкаСсылки = Неопределено) Экспорт

	ПроверитьКонтекст(Контекст);

	Группа = ГруппаРазделовЭкрана(РазделыЭкрана, Содержимое);

	Рамка = Инсталляция.Обрамление(Контекст);
	Оформление = ВыборВида.ПоКукам(Контекст.КукиЗапроса);
	Меню = ЕдиноеМеню(Рамка, Оформление, Группа);

	Корень = Кит.Документ(Модели.Текст(Рамка, "Язык"), Токены.АтрибутТемы(Оформление));
	Корень.Добавить(ГоловаДокумента(Рамка, Заголовок, Оформление, КарточкаСсылки));
	Корень.Добавить(ТелоДокумента(Рамка, Содержимое, Оформление, Меню));
	Возврат Корень;

КонецФункции

#КонецОбласти

#Область РазделыЭкрана

// Разделы экрана и имя их группы. Дом настроек сам знает свои разделы и своё имя:
// передавать их второй раз незачем, а имя дома над его разделами говорит, чьи это разделы,
// точнее общей подписи.
Функция ГруппаРазделовЭкрана(Знач РазделыЭкрана, Знач Содержимое)

	Дом = Неопределено;
	Если ТипЗнч(Содержимое) = Тип("ЭлементЭкрана") И Содержимое.Род() = "дом" Тогда
		Дом = Содержимое;
	КонецЕсли;

	Заголовок = "";
	Разделы = РазделыЭкрана;
	Если ТипЗнч(РазделыЭкрана) = Тип("Структура") Тогда
		Заголовок = Модели.Текст(РазделыЭкрана, "Заголовок");
		Разделы = Модели.Значение(РазделыЭкрана, "Разделы");
	КонецЕсли;

	Если Дом <> Неопределено Тогда
		Если Разделы = Неопределено Тогда
			Разделы = Кит.РазделыДома(Дом);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Заголовок) Тогда
			Заголовок = Кит.ЗаголовокДома(Дом);
		КонецЕсли;
	КонецЕсли;

	Возврат Новый Структура("Заголовок, Разделы", Заголовок,
		Модели.Список(Новый Структура("Разделы", Разделы), "Разделы"));

КонецФункции

#КонецОбласти

#Область Голова

Функция ГоловаДокумента(Знач Рамка, Знач Заголовок, Знач Оформление, Знач КарточкаСсылки)

	Голова = Кит.Голова();

	Голова.Добавить(Кит.Кодировка("utf-8"));
	Голова.Добавить(Кит.Мета("viewport", "width=device-width, initial-scale=1"));
	Голова.Добавить(Кит.Мета("color-scheme", "dark light"));
	// адрес страницы наружу не уходит: в нём живут одноразовые ссылки и коды входа
	Голова.Добавить(Кит.Мета("referrer", Модели.Текст(Рамка, "ПолитикаПерехода")));
	Голова.Добавить(Кит.Титул(ЗаголовокВкладки(Заголовок, Модели.Текст(Рамка, "Знак"))));

	Для Каждого Пара Из СвойстваКарточки(КарточкаСсылки) Цикл
		Голова.Добавить(Кит.МетаСвойство(Пара.Свойство, Пара.Содержание));
	КонецЦикла;

	Для Каждого Иконка Из Модели.Список(Рамка, "Иконки") Цикл
		Голова.Добавить(Кит.Ресурс(Модели.Текст(Иконка, "Отношение"),
			Модели.Текст(Иконка, "Адрес"), Модели.Текст(Иконка, "Тип"),
			Модели.Текст(Иконка, "Размеры")));
	КонецЦикла;

	// палитра едет инлайном: она обязана приехать вместе с разметкой, иначе страница
	// мигнёт нецветной, пока лист стилей ещё в пути
	Голова.Добавить(Кит.Стиль("токены-темы", Токены.Переменные(Оформление)));

	// порядок листов = порядок каскада: базовый лист библиотеки первым, лист инсталляции
	// вторым. Обратный порядок отнял бы у инсталляции возможность перебить правило,
	// не повышая специфичность и не ставя !important
	Голова.Добавить(Кит.Ресурс("stylesheet", Активы.АдресБазовогоЛиста()));
	Голова.Добавить(Кит.Ресурс("stylesheet", Модели.Текст(Рамка, "АдресСтилей")));

	Возврат Голова;

КонецФункции

Функция ЗаголовокВкладки(Знач Заголовок, Знач Знак)
	Возврат ?(ЗначениеЗаполнено(Заголовок), Строка(Заголовок) + " — " + Знак, Знак);
КонецФункции

// Пара без свойства или без содержания карточке ничего не говорит, а пустой
// og:image краулер честно попробовал бы скачать.
Функция СвойстваКарточки(Знач КарточкаСсылки)

	Результат = Новый Массив();
	Для Каждого Пара Из Модели.Список(Новый Структура("Карточка", КарточкаСсылки), "Карточка") Цикл
		Свойство = Модели.Текст(Пара, "Свойство");
		Содержание = Модели.Текст(Пара, "Содержание");
		Если ЗначениеЗаполнено(Свойство) И ЗначениеЗаполнено(Содержание) Тогда
			Результат.Добавить(Новый Структура("Свойство, Содержание", Свойство, Содержание));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Тело

Функция ТелоДокумента(Знач Рамка, Знач Содержимое, Знач Оформление, Знач Меню)

	Тело = Кит.Тело();

	Тело.Добавить(ШапкаСтраницы(Рамка, Оформление, Меню));

	// Панель стоит ДО содержимого: движок без верхнего слоя оставит её в потоке,
	// и человек встретит навигацию раньше страницы, а не после неё.
	Если Меню <> Неопределено Тогда
		Тело.Добавить(Кит.ПанельМеню(Меню.Панель));
	КонецЕсли;

	Тело.Добавить(ОсновноеСтраницы(Рамка, Содержимое));
	Тело.Добавить(ПодвалСтраницы(Рамка));

	// скрипт кита первым, как и его лист: движение Material (рябь, плавающая подпись,
	// тень шапки, индикатор вкладок) — забота библиотеки; скрипт инсталляции идёт следом
	Тело.Добавить(Кит.Скрипт(Активы.АдресСкриптаКита()));
	Тело.Добавить(Кит.Скрипт(Модели.Текст(Рамка, "АдресСкрипта")));

	Возврат Тело;

КонецФункции

Функция ОсновноеСтраницы(Знач Рамка, Знач Содержимое)

	Основное = Кит.Основное().Вид("полоса");

	Приватные = Модели.Список(Рамка, "Приватные");
	Если Приватные.Количество() > 0 Тогда
		Основное.Добавить(Кит.ДеревоРазделов(Новый Структура("Заголовок, Разделы, Ориентация, Класс",
			Тексты.Текст("chrome.office.nav.title"), Приватные, "горизонталь", "office-nav")));
	КонецЕсли;

	Основное.Добавить(СодержимоеУзлом(Содержимое));
	Возврат Основное;

КонецФункции

// Экран, ещё не собранный деревом, отдаёт строку — она заворачивается в готовый фрагмент.
// Экран, собранный деревом, кладётся в основное как есть.
Функция СодержимоеУзлом(Знач Содержимое)

	Если ТипЗнч(Содержимое) = Тип("Строка") ИЛИ Содержимое = Неопределено Тогда
		Возврат Кит.Готовое(Содержимое);
	КонецЕсли;
	Возврат Содержимое;

КонецФункции

Функция ПодвалСтраницы(Знач Рамка)

	Подвал = Кит.Подвал().Вид("страницы");
	Подвал.Добавить(Кит.Область().Вид("полоса")).Добавить(Кит.Текст(Модели.Текст(Рамка, "Подпись")));
	Возврат Подвал;

КонецФункции

#КонецОбласти

#Область Шапка

// Шапка бывает двух видов. Инсталляция, заполнившая слот единого меню, получает шапку
// МЕНЮ: тот же состав, что и прежде, но дороги приходят из слота, а место учётки занимает
// открывашка единой панели. Не заполнившая — прежнюю шапку целиком, до последнего байта.
Функция ШапкаСтраницы(Знач Рамка, Знач Оформление, Знач Меню)

	Адреса = Модели.Значение(Рамка, "Адреса");

	Если Меню <> Неопределено Тогда
		Возврат ШапкаМеню(Рамка, Адреса, Оформление, Меню);
	КонецЕсли;

	Шапка = Кит.Шапка().Вид("страницы");
	Полоса = Шапка.Добавить(Кит.Область().Вид("полоса"));

	Полоса.Добавить(ХодНаГлавную(Рамка, Адреса));

	Навигация = Полоса.Добавить(Кит.Навигация().Вид("верхняя"));
	Навигация.Добавить(Кит.ДеревоРазделов(Новый Структура("Заголовок, Разделы, Ориентация, Класс",
		Тексты.Текст("chrome.top.nav.title"), Модели.Список(Рамка, "Разделы"),
		"горизонталь", "tree--top")));
	Навигация.Добавить(ПереключательОформления(Адреса, Оформление));
	ДобавитьДействия(Навигация, Рамка);

	Возврат Шапка;

КонецФункции

// Шапка страницы с единым меню. На широком экране она устроена как прежняя: знак,
// горизонтальные дороги, переключатель оформления, действия инсталляции и учётка справа —
// только дороги теперь приходят из слота, а учётка стала открывашкой панели. На узком
// лист прячет всю полосу ходов, и остаются бургер со знаком: дороги, тема и действия
// живут тогда в панели.
Функция ШапкаМеню(Знач Рамка, Знач Адреса, Знач Оформление, Знач Меню)

	Шапка = Кит.Шапка().Вид("меню");
	Полоса = Шапка.Добавить(Кит.Область().Вид("полоса"));

	Полоса.Добавить(Кит.БургерМеню(Меню.Бургер));
	Полоса.Добавить(ХодНаГлавную(Рамка, Адреса));

	Ходы = Полоса.Добавить(Кит.Навигация().Вид("верхняя"));
	Ходы.Добавить(Кит.ДеревоРазделов(Новый Структура("Заголовок, Разделы, Ориентация, Класс",
		Тексты.Текст("chrome.top.nav.title"), ДорогиСлота(Рамка), "горизонталь", "tree--top")));
	Ходы.Добавить(ПереключательОформления(Адреса, Оформление));
	ДобавитьДействия(Ходы, Рамка);
	Если ЗначениеЗаполнено(Меню.Учётка) Тогда
		Ходы.Добавить(Кит.УчёткаМеню(Меню.Учётка));
	КонецЕсли;

	Возврат Шапка;

КонецФункции

// Действия шапки — то, что инсталляция ставит справа от дорог: вход, кабинет, выход,
// меню учётки, ссылка на репозиторий, «Скачать». Кит своих действий не сочиняет и ничего
// к присланным не добавляет — печатает их по порядку.
Процедура ДобавитьДействия(Куда, Знач Рамка)

	Для Каждого Действие Из Модели.Список(Рамка, "Действия") Цикл
		Куда.Добавить(ДействиеУзлом(Действие, Ложь));
	КонецЦикла;

КонецПроцедуры

// Те же действия для панели единого меню: на телефоне полоса ходов спрятана, и панель —
// единственное место, где их видно. Кнопка там во всю ширину, как пункт меню.
Функция ДействияПанели(Знач Рамка)

	Части = Новый Массив();
	Для Каждого Действие Из Модели.Список(Рамка, "Действия") Цикл
		Части.Добавить(ДействиеУзлом(Действие, Истина).Рендер());
	КонецЦикла;
	Возврат СтрСоединить(Части);

КонецФункции

// Действие — модель кнопки кита (Структура), узел холста (меню учётки, форма выхода)
// либо ДОВЕРЕННЫЙ фрагмент HTML (Строка).
Функция ДействиеУзлом(Знач Действие, Знач ВоВсюШирину)

	Если ТипЗнч(Действие) = Тип("Строка") Тогда
		Возврат Кит.Готовое(Действие);
	ИначеЕсли ТипЗнч(Действие) <> Тип("Структура") Тогда
		Возврат Действие;
	КонецЕсли;

	Модель = Новый Структура();
	Для Каждого Поле Из Действие Цикл
		Модель.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	Если ВоВсюШирину Тогда
		Модель.Вставить("ВоВсюШирину", Истина);
	КонецЕсли;
	Возврат Кит.Кнопка(Модель);

КонецФункции

// Дороги для шапки — те же, что и в панели: список ОДИН, поэтому разъехаться им негде.
Функция ДорогиСлота(Знач Рамка)
	Возврат Модели.Список(Модели.Значение(Рамка, "МенюХаба"), "Навигация");
КонецФункции

// Единое меню инсталляции: слот обрамления плюс то, что знает сам каркас, — знак,
// переключатель оформления и разделы текущего экрана с именем их группы. Пустой слот
// даёт Неопределено: страница собирается прежней шапкой.
Функция ЕдиноеМеню(Знач Рамка, Знач Оформление, Знач Группа)

	Слот = Модели.Значение(Рамка, "МенюХаба");
	Если МенюХаба.Пустое(Слот) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Адреса = Модели.Значение(Рамка, "Адреса");

	Возврат МенюХаба.Отрисовать(Новый Структура(
		"Счётчик, ПодписьСчётчика, Учётка, Дела, Навигация, Разделы, ЗаголовокРазделов,"
			+ " Знак, Действия, Тема, Выход",
		Модели.Значение(Слот, "Счётчик"),
		Модели.Текст(Слот, "ПодписьСчётчика"),
		Модели.Значение(Слот, "Учётка"),
		Модели.Список(Слот, "Дела"),
		Модели.Список(Слот, "Навигация"),
		Группа.Разделы,
		Группа.Заголовок,
		ХодНаГлавную(Рамка, Адреса).Рендер(),
		ДействияПанели(Рамка),
		ПереключательОформленияСтрокой(Адреса, Оформление).Рендер(),
		Модели.Текст(Слот, "Выход")));

КонецФункции

// Знак инсталляции — картинка, а название рядом остаётся ТЕКСТОМ: так оно выделяется
// поиском и читается скринридером, поэтому подписи у картинки нет. Спрятали название —
// картинка становится единственным именем хода, и подпись обязана его назвать.
Функция ХодНаГлавную(Знач Рамка, Знач Адреса)

	Знак = Модели.Текст(Рамка, "Знак");
	Знамя = Модели.Значение(Рамка, "Знамя");
	Название = Модели.Флаг(Знамя, "Название");

	Ход = Кит.Ссылка(Модели.Текст(Адреса, "Корень")).Вид("знак");

	Картинка = Ход.Добавить(Кит.Картинка(Модели.Текст(Знамя, "Адрес")).Вид("знак")
		.Подпись(?(Название, "", Знак))
		.Высота(ВысотаЗнака()));
	// ширину печатает только тот знак, чьи пропорции известны заранее: у произвольного
	// логотипа width впрессовал бы картинку в чужую рамку
	Картинка.Ширина(Модели.Значение(Знамя, "Ширина"));

	Если Название Тогда
		Ход.Добавить(Кит.Надпись()).Добавить(Кит.Текст(Знак));
	КонецЕсли;

	Возврат Ход;

КонецФункции

// Высота знака в разметке: место под него занято до того, как приедет лист стилей,
// и шапка не прыгает. Величину знает кит — он же печатает класс знака.
Функция ВысотаЗнака()
	Возврат 28;
КонецФункции

// Переключатель оформления — форма, работающая без скрипта. Дорога одна и она серверная:
// значок выбирает сервер по текущему оформлению, второго источника правды о теме нет.
// Скрипт кита лишь не ждёт ответа: перекрашивает страницу сразу (обе палитры уже в голове)
// и отправляет ту же форму в фоне — страница не перезагружается.
// Токена не несёт: подделка этого запроса меняет читателю цвет фона, и только.
// Это возможность кита, и включает её инсталляция адресом: нет Адреса.Оформление — нет
// и переключателя.
Функция ПереключательОформления(Знач Адреса, Знач Оформление)

	Если НЕ ЗначениеЗаполнено(Модели.Текст(Адреса, "Оформление")) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Светлая = (Токены.АтрибутТемы(Оформление) = "light");

	Форма = Кит.ФормаБезТокена(Модели.Текст(Адреса, "Оформление")).Вид("переключатель")
		.БезПерезагрузки().Признак("theme-toggle", "");
	Форма.Добавить(Кит.Кнопка(Новый Структура(
		"Подпись, Вариант, Размер, Иконка, ТолькоИконка, Подсказка",
		Тексты.Текст("chrome.top.theme.toggle"), "ссылка", "малый",
		?(Светлая, "луна", "солнце"), Истина,
		?(Светлая, Тексты.Текст("chrome.top.theme.to-dark"),
			Тексты.Текст("chrome.top.theme.to-light")))));
	Возврат Форма;

КонецФункции

// Тот же переключатель, но СТРОКОЙ: в меню он стоит рядом с «Выйти» и такими же пунктами,
// и голая иконка среди подписанных строк читается как обрубок. Слова те же, что шапка
// прячет в подсказку, — своих кит не сочиняет.
Функция ПереключательОформленияСтрокой(Знач Адреса, Знач Оформление)

	Если НЕ ЗначениеЗаполнено(Модели.Текст(Адреса, "Оформление")) Тогда
		Возврат Кит.Ничего();
	КонецЕсли;

	Светлая = (Токены.АтрибутТемы(Оформление) = "light");

	Форма = Кит.ФормаБезТокена(Модели.Текст(Адреса, "Оформление")).Вид("переключатель")
		.БезПерезагрузки().Признак("theme-toggle", "");
	Форма.Добавить(Кит.Кнопка(Новый Структура(
		"Подпись, Вариант, Иконка, ВоВсюШирину",
		?(Светлая, Тексты.Текст("chrome.top.theme.to-dark"),
			Тексты.Текст("chrome.top.theme.to-light")),
		"вторичная", ?(Светлая, "луна", "солнце"), Истина)));
	Возврат Форма;

КонецФункции


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьКонтекст(Знач Контекст)

	Если ТипЗнч(Контекст) = Тип("Структура") И Контекст.Свойство("КукиЗапроса") Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение "КаркасСтраницы.Страница: третьим аргументом обязан прийти контекст"
		+ " запроса — соберите его КонтекстСтраницы(Пользователь, КукиЗапроса). Без кук"
		+ " страница молча потеряла бы оформление читателя.";

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТокеныТемы") _Токены,
	&Пластилин(Значение = "ВыборОформления") _ВыборВида,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "АктивыСтатики") _Активы,
	&Пластилин(Значение = "ОбрамлениеИнсталляции") _Инсталляция,
	&Пластилин(Значение = "МенюХаба") _МенюХаба) Экспорт

	Кит = _Кит;
	Токены = _Токены;
	ВыборВида = _ВыборВида;
	Тексты = _Тексты;
	Модели = _Модели;
	Активы = _Активы;
	Инсталляция = _Инсталляция;
	МенюХаба = _МенюХаба;

КонецПроцедуры
