// Объявление формы — объект UI-кита: экран перечисляет свои поля и готовые блоки, а
// объявление печатает разметку, разбирает пришедшее и возвращает набранное. Желудём быть
// не может — у него есть состав, поэтому новое объявление выдаёт фабрика «Формы».
//
// Имя поля (атрибут name) выводится из ключа ЗДЕСЬ, и отрисовка с разбором зовут одну
// и ту же функцию: разойтись им нечем.

Перем Модели;     // ЧтениеМодели
Перем Проверка;   // ПроверкаПоля
Перем ЗначенияПолей; // ЗначенияФормы — что написать в каждом поле
Перем Печать;     // ПечатьФормы
Перем ИмяТокена;  // Строка — имя скрытого поля CSRF
Перем ИдОкна;     // Строка — идентификатор модального окна, выданный фабрикой

Перем Элементы;         // Массив описаний в порядке объявления
Перем Показ;            // Соответствие: ключ -> что вернуть в поле после разбора
Перем Отбитые;          // Соответствие: ключ -> текст отказа
Перем ПричинаБезТокена; // Строка — объявленная причина формы без CSRF

#Область Объявление

// Объявляет поле формы.
//
// Параметры:
//  Ключ     - Строка - ключ поля; из него выводится атрибут name.
//  Метка    - Строка - подпись поля для человека.
//  Вид      - Строка - "строка" (по умолчанию) | "число" | "флажок" | "секрет" |
//             "многострочное" | "выбор".
//  Свойства - Структура, Неопределено - (необязательный, по умолчанию Неопределено)
//             Обязательное, ТолькоЧтение, Подсказка, Плейсхолдер, Автозаполнение,
//             Мин и Макс (для числа), Варианты (для выбора: массив структур Значение,
//             Подпись, Выбрано), Умолчание (значение пустого поля), Кат (подпись
//             раскрывашки: подряд идущие элементы с одной подписью уходят под неё),
//             Рамка (вид области кита: подряд идущие элементы с одним видом
//             уходят в общий <div>).
//
// Возвращаемое значение:
//  ОбъявлениеФормы - это же объявление, чтобы поля перечислялись цепочкой.
//
Функция Поле(Знач Ключ, Знач Метка, Знач Вид = "строка", Знач Свойства = Неопределено) Экспорт

	ПроверитьКлюч(Ключ);

	Описание = Заготовка("поле", Свойства);
	Описание.Вставить("Ключ", СокрЛП(Строка(Ключ)));
	Описание.Вставить("Имя", ИмяПоля(Ключ));
	Описание.Вставить("Метка", Строка(Метка));
	Описание.Вставить("Вид", НРег(СокрЛП(Строка(Вид))));
	Описание.Вставить("Обязательное", Модели.Флаг(Свойства, "Обязательное"));
	Описание.Вставить("ТолькоЧтение", Модели.Флаг(Свойства, "ТолькоЧтение"));
	Описание.Вставить("Подсказка", Модели.Текст(Свойства, "Подсказка"));
	Описание.Вставить("Плейсхолдер", Модели.Текст(Свойства, "Плейсхолдер"));
	Описание.Вставить("Автозаполнение", Модели.Текст(Свойства, "Автозаполнение"));
	Описание.Вставить("Мин", Модели.Значение(Свойства, "Мин"));
	Описание.Вставить("Макс", Модели.Значение(Свойства, "Макс"));
	Описание.Вставить("Варианты", Модели.Список(Свойства, "Варианты"));
	Описание.Вставить("Умолчание", Модели.Текст(Свойства, "Умолчание"));

	Элементы.Добавить(Описание);
	Возврат ЭтотОбъект;

КонецФункции

// Подключает в объявление ГОТОВЫЙ блок, собранный где-то ещё: меню, заголовок, крошки,
// таблицу, любую разметку кита. Как блок устроен, объявление не знает и не спрашивает —
// оно печатает его на своём месте в порядке объявления и в разбор не берёт.
//
// Параметры:
//  Разметка - Строка - ДОВЕРЕННЫЙ HTML готового блока: экранированием занят тот, кто его
//             собрал, потому что кому попало эта дверь и не открыта.
//  Свойства - Структура, Неопределено - (необязательный, по умолчанию Неопределено)
//             Кат и Рамка — те же, что у поля.
//
// Возвращаемое значение:
//  ОбъявлениеФормы - это же объявление.
//
Функция Блок(Знач Разметка, Знач Свойства = Неопределено) Экспорт

	Описание = Заготовка("блок", Свойства);
	Описание.Вставить("Разметка", Строка(?(Разметка = Неопределено, "", Разметка)));
	Элементы.Добавить(Описание);
	Возврат ЭтотОбъект;

КонецФункции

// Объявляет форму анонимной: у неё нет сессии, к которой привязывался бы CSRF-токен.
// Причина обязательна и видна в объявлении — забыть токен молча нельзя, отказаться
// от него можно только назвав причину.
//
// Параметры:
//  Причина - Строка - почему у формы не может быть токена.
//
// Возвращаемое значение:
//  ОбъявлениеФормы - это же объявление.
//
Функция БезТокена(Знач Причина) Экспорт

	Если НЕ ЗначениеЗаполнено(СокрЛП(Строка(Причина))) Тогда
		ВызватьИсключение "Объявление формы: БезТокена() без причины. Форма без CSRF-токена"
			+ " — сознательное решение (у анонимной формы нет сессии), и оно обязано быть"
			+ " названо словами: причина остаётся на глазах у ревью.";
	КонецЕсли;

	ПричинаБезТокена = СокрЛП(Строка(Причина));
	Возврат ЭтотОбъект;

КонецФункции

// Состав формы: из чего она собрана и в каком порядке. Существует как объект, поэтому
// список полей экрана можно напечатать, а не вычислять по префиксам ключей.
//
// Возвращаемое значение:
//  Массив из Структура - копии описаний (Род, Ключ, Имя, Метка, Вид, Обязательное,
//                        ТолькоЧтение, Кат, Рамка, Разметка).
//
Функция Состав() Экспорт

	Результат = Новый Массив();
	Для Каждого Описание Из Элементы Цикл
		Копия = Новый Структура();
		Для Каждого КиЗ Из Описание Цикл
			Копия.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
		Результат.Добавить(Копия);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имя поля (атрибут name) по ключу. Один и тот же расчёт для отрисовки и для разбора.
//
// Параметры:
//  Ключ - Строка - ключ поля.
//
// Возвращаемое значение:
//  Строка - имя, пригодное для атрибута name: буквы, цифры, дефис и подчёркивание.
//
Функция ИмяПоля(Знач Ключ) Экспорт

	Исходный = СокрЛП(Строка(Ключ));
	Допустимые = "abcdefghijklmnopqrstuvwxyz0123456789_-абвгдеёжзийклмнопрстуфхцчшщъыьэюя";

	Результат = "";
	Для Поз = 1 По СтрДлина(Исходный) Цикл
		Символ = Сред(Исходный, Поз, 1);
		Результат = Результат + ?(СтрНайти(Допустимые, НРег(Символ)) > 0, Символ, "_");
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Разбор

// Разбирает пришедшую форму по объявлению: приводит значения к видам полей, проверяет
// ограничения и запоминает набранное, чтобы отрисовка вернула его человеку.
//
// Параметры:
//  Присланное - Соответствие - разобранное тело запроса (имя поля -> значение).
//
// Возвращаемое значение:
//  Структура - Принято (Булево: ни одного отказа), Значения (Соответствие: ключ ->
//              значение своего типа), Отказы (Соответствие: ключ -> текст),
//              Отказ (Строка: текст первого отказа, "" — отказов нет), Показ
//              (Соответствие: ключ -> набранное человеком; им форму заполняют заново,
//              когда отказ возвращает страницу; секрет сюда не попадает).
//
Функция Разобрать(Знач Присланное) Экспорт

	Показ = Новый Соответствие();
	Отбитые = Новый Соответствие();

	Значения = Новый Соответствие();
	Первый = "";

	Для Каждого Описание Из Элементы Цикл

		// поле только на чтение не берётся из формы вовсе: подделанное значение
		// не должно ни сохраниться, ни оказаться на экране
		Если Описание.Род <> "поле" ИЛИ Описание.ТолькоЧтение Тогда
			Продолжить;
		КонецЕсли;

		Прочитанное = Проверка.Прочитать(Описание, Присланное.Получить(Описание.Имя));
		Показ.Вставить(Описание.Ключ, Прочитанное.Показ);

		Если Прочитанное.Принято Тогда
			Значения.Вставить(Описание.Ключ, Прочитанное.Значение);
			Продолжить;
		КонецЕсли;

		Отбитые.Вставить(Описание.Ключ, Прочитанное.Отказ);
		Первый = ?(ЗначениеЗаполнено(Первый), Первый, Прочитанное.Отказ);

	КонецЦикла;

	Возврат Новый Структура("Принято, Значения, Отказы, Отказ, Показ",
		Отбитые.Количество() = 0, Значения, Отбитые, Первый, Показ);

КонецФункции

// Отбивает поле отказом домена: то, что видно только сервису (имя занято, пул закрыт),
// приходит в форму тем же путём, что и отказ проверки.
//
// Параметры:
//  Ключ  - Строка - ключ поля.
//  Текст - Строка - текст отказа для человека.
//
Процедура Отбить(Знач Ключ, Знач Текст) Экспорт
	Отбитые.Вставить(СокрЛП(Строка(Ключ)), Строка(Текст));
КонецПроцедуры

#КонецОбласти

#Область Отрисовка

// Печатает поля и блоки БЕЗ обёртки <form>: так объявление кладётся телом в секцию
// настроек, которая печатает форму, токен и панель сама.
//
// Параметры:
//  Действующие - Структура, Соответствие, Неопределено - (необязательный, по умолчанию
//                Неопределено) действующие значения по ключам полей. Ключ с точкой
//                читается только из Соответствия.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент.
//
Функция Тело(Знач Действующие = Неопределено) Экспорт
	Возврат Печать.Тело(Элементы, ЗначенияПолей.ДляПоказа(Элементы, Показ, Действующие), Отбитые);
КонецФункции

// Печатает форму целиком: <form>, скрытое поле CSRF и тело. Токен забыть нельзя —
// без него и без объявленной причины печать отказывается работать.
//
// Параметры:
//  Действующие - Структура, Соответствие, Неопределено - действующие значения.
//  Действие    - Строка - URL, куда уходит POST.
//  Токен       - Строка - (необязательный, по умолчанию "") CSRF-токен сессии.
//  Класс       - Строка - (необязательный, по умолчанию "") CSS-класс формы.
//
// Возвращаемое значение:
//  Строка - HTML-форма.
//
Функция Отрисовать(Знач Действующие, Знач Действие, Знач Токен = "", Знач Класс = "") Экспорт

	ПроверитьОтправку(Действие, Токен);
	Возврат Печать.Форма(Тело(Действующие), Действие, Класс, ИмяТокена, Токен);

КонецФункции

// Печатает ту же форму модальным окном: кнопка рядом с заголовком списка и <dialog>,
// который места на экране не занимает, пока не открыт. Скрипта нет — открытие, закрытие
// по Esc и щелчку мимо, удержание фокуса даёт движок браузера. Кнопку старый движок
// не сработает, поэтому у экрана обязана оставаться серверная дорога: адрес, по которому
// страница приходит с уже открытым окном.
//
// Параметры:
//  Действующие - Структура, Соответствие, Неопределено - действующие значения.
//  Действие    - Строка - URL, куда уходит POST.
//  Токен       - Строка - CSRF-токен сессии.
//  Окно        - Структура - Заголовок (обязателен: им окно называет себя скринридеру),
//                Открывашка, ИконкаОткрывашки, ВариантОткрывашки, Открыта, Отмена,
//                Отправка, ИконкаОтправки, ИмяКнопки, ЗначениеКнопки, Опасная, Класс.
//
// Возвращаемое значение:
//  Строка - кнопка открытия и <dialog> с формой.
//
Функция ОтрисоватьВОкне(Знач Действующие, Знач Действие, Знач Токен, Знач Окно) Экспорт

	ПроверитьОтправку(Действие, Токен);

	Внутри = Печать.Форма(Тело(Действующие) + Печать.Подвал(ИдОкна, Окно),
		Действие, Модели.Текст(Окно, "Класс", "form-stack"), ИмяТокена, Токен);

	Возврат Печать.Окно(ИдОкна, Внутри, Окно);

КонецФункции

// Идентификатор модального окна этой формы: его выдаёт кит порядковым номером, и значение
// из данных в него не попадает — иначе два похожих имени дали бы один идентификатор,
// и кнопка открыла бы чужое окно.
//
// Возвращаемое значение:
//  Строка
//
Функция ИдентификаторОкна() Экспорт
	Возврат ИдОкна;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОтправку(Знач Действие, Знач Токен)

	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		ВызватьИсключение "Объявление формы: печать без Действия — форме некуда отправлять"
			+ " POST. Задайте адрес действия либо печатайте тело методом Тело(), если форму"
			+ " вокруг него рисует каркас секции.";
	КонецЕсли;

	Если ЗначениеЗаполнено(Токен) ИЛИ ЗначениеЗаполнено(ПричинаБезТокена) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Объявление формы: POST на «%1» без CSRF-токена. Передайте"
		+ " токен текущей сессии — иначе форма гарантированно получит 403. Если сессии"
		+ " нет вовсе, объявите БезТокена(«причина»).", Действие);

КонецПроцедуры

// Состав описаний ОДИН на поле и на блок: список элементов печатается таблицей,
// и «у блока нет такого свойства» не должно всплывать при печати.
Функция Заготовка(Знач Род, Знач Свойства)

	Описание = Новый Структура();
	Описание.Вставить("Род", Род);
	Описание.Вставить("Кат", Модели.Текст(Свойства, "Кат"));
	Описание.Вставить("Рамка", Модели.Текст(Свойства, "Рамка"));
	Описание.Вставить("Разметка", "");
	Описание.Вставить("Ключ", "");
	Описание.Вставить("Имя", "");
	Описание.Вставить("Метка", "");
	Описание.Вставить("Вид", "");
	Описание.Вставить("Обязательное", Ложь);
	Описание.Вставить("ТолькоЧтение", Ложь);
	Описание.Вставить("Подсказка", "");
	Описание.Вставить("Плейсхолдер", "");
	Описание.Вставить("Автозаполнение", "");
	Описание.Вставить("Мин", Неопределено);
	Описание.Вставить("Макс", Неопределено);
	Описание.Вставить("Варианты", Новый Массив());
	Описание.Вставить("Умолчание", "");
	Возврат Описание;

КонецФункции

// Дубль ключа развалил бы контракт: два поля печатались бы одним name, а разбор отдал
// бы одно значение обоим — и молча.
Процедура ПроверитьКлюч(Знач Ключ)

	Значение = СокрЛП(Строка(?(Ключ = Неопределено, "", Ключ)));
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение "Объявление формы: поле без ключа. Ключ — контракт между"
			+ " отрисовкой и разбором, из него выводится атрибут name.";
	КонецЕсли;

	Для Каждого Описание Из Элементы Цикл
		Если Описание.Род = "поле" И Описание.Ключ = Значение Тогда
			ВызватьИсключение СтрШаблон("Объявление формы: ключ «%1» объявлен дважды."
				+ " Два поля с одним именем печатаются одинаково, а разбор отдаёт им одно"
				+ " значение — расхождение будет молчаливым.", Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

// НЕ желудь сознательно: у объявления есть состав, поэтому новое выдаёт фабрика «Формы».
//
// Параметры:
//  _Модели    - ЧтениеМодели  - мягкое чтение структур.
//  _Проверка  - ПроверкаПоля  - приведение и проверка значений.
//  _Значения  - ЗначенияФормы - что написать в каждом поле.
//  _Печать    - ПечатьФормы   - разметка формы.
//  _ИмяТокена - Строка        - имя скрытого поля CSRF.
//  _ИдОкна    - Строка        - идентификатор модального окна, выданный фабрикой.
//
Процедура ПриСозданииОбъекта(Знач _Модели, Знач _Проверка, Знач _Значения, Знач _Печать,
	Знач _ИмяТокена, Знач _ИдОкна) Экспорт

	Модели = _Модели;
	Проверка = _Проверка;
	ЗначенияПолей = _Значения;
	Печать = _Печать;
	ИмяТокена = _ИмяТокена;
	ИдОкна = _ИдОкна;

