// Экранирование HTML — желудь UI-кита, тонкий адаптер над html-sanitizer.
// Инвариант слоя: ни один компонент не вставляет значение в HTML мимо этого класса.

#Использовать html-sanitizer

// Экранирует произвольное значение для безопасной вставки в HTML.
//
// Параметры:
//  Текст - Произвольный - значение для вывода; не-строки приводятся к строке.
//
// Возвращаемое значение:
//  Строка - экранированный текст.
//
Функция Экранировать(Знач Текст) Экспорт
	Возврат СанитизацияHTML.ЭкранироватьЗначение(Текст);
КонецФункции

// Собирает фрагмент атрибута ` имя="значение"`. Имя валидируется, а не экранируется.
//
// Параметры:
//  Имя      - Строка       - имя атрибута.
//  Значение - Произвольный - значение атрибута.
//
// Возвращаемое значение:
//  Строка - фрагмент с ведущим пробелом либо "" для пустого значения
//           или недопустимого имени.
//
Функция Атрибут(Знач Имя, Знач Значение) Экспорт
	Возврат СанитизацияHTML.Атрибут(Имя, Значение);
КонецФункции

// Собирает фрагмент атрибута ` имя="значение"` ДАЖЕ ДЛЯ ПУСТОГО значения. Нужен там, где
// пустой атрибут значим: `<option>` без `value` по спецификации HTML отправляет СВОЙ ТЕКСТ,
// поэтому вариант с пустым значением обязан печатать `value=""` явно.
//
// Параметры:
//  Имя      - Строка       - имя атрибута.
//  Значение - Произвольный - значение атрибута; пустое печатается как `=""`.
//
// Возвращаемое значение:
//  Строка - фрагмент с ведущим пробелом либо "" при недопустимом имени.
//
Функция АтрибутВсегда(Знач Имя, Знач Значение) Экспорт

	Если НЕ ИмяАтрибутаДопустимо(Имя) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон(" %1=""%2""", Имя, Экранировать(Значение));

КонецФункции

// Собирает булев атрибут (disabled, required, checked).
//
// Параметры:
//  Имя     - Строка - имя атрибута.
//  Условие - Булево - печатать ли атрибут.
//
// Возвращаемое значение:
//  Строка - " имя" либо "".
//
Функция БулевАтрибут(Знач Имя, Знач Условие) Экспорт
	Возврат СанитизацияHTML.БулевАтрибут(Имя, Условие);
КонецФункции

// Проверяет имя атрибута: `[A-Za-z][A-Za-z0-9-]*` не длиннее 64 символов. Экранирование
// спасает значение, но не имя — «class onmouseover=alert(1)» прошло бы насквозь.
//
// Параметры:
//  Имя - Произвольный - проверяемое имя.
//
// Возвращаемое значение:
//  Булево - Истина, если имя безопасно печатать без экранирования.
//
Функция ИмяАтрибутаДопустимо(Знач Имя) Экспорт
	Возврат СанитизацияHTML.ИмяАтрибутаДопустимо(Имя);
КонецФункции

// Собирает <a href> с экранированием адреса и текста и фильтрацией схемы URL.
//
// Параметры:
//  Адрес        - Строка - URL.
//  Текст        - Строка - видимый текст ссылки.
//  Класс        - Строка - (необязательный, по умолчанию "") CSS-класс.
//  Внутренности - Строка - (необязательный, по умолчанию Неопределено) ДОВЕРЕННЫЙ HTML
//                 вместо текста.
//
// Возвращаемое значение:
//  Строка - фрагмент ссылки либо экранированный текст при недопустимой схеме.
//
Функция Ссылка(Знач Адрес, Знач Текст, Знач Класс = "", Знач Внутренности = Неопределено) Экспорт
	Возврат СанитизацияHTML.Ссылка(Адрес, Текст, Класс, Внутренности);
КонецФункции

// Проверяет URL по allowlist схем (http/https/mailto) либо как относительный/якорный.
//
// Параметры:
//  Адрес - Произвольный - проверяемый URL.
//
// Возвращаемое значение:
//  Булево - Истина, если адрес безопасен для вывода как href.
//
Функция URLБезопасенДляHref(Знач Адрес) Экспорт
	Возврат СанитизацияHTML.URLБезопасенДляHref(Адрес);
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
