// Набор иконок — желудь UI-кита: каталог глифов src/статика/иконки, по .svg на иконку.
// Замена иконки — замена файла: и рисунок, и область, в которой он нарисован, берутся
// из него самого.

Перем Глифы;   // Соответствие: имя в нижнем регистре -> разбор ЧтениеГлифа
Перем Бренды;  // Соответствие: ключ бренда -> Структура (разбор и Название, Цвет, Чернила) —
               // значки провайдеров src/статика/провайдеры (дев-сборка 8)
Перем Служебные; // Массив: ключи каталога провайдеров, которые не бренды (key — глиф Material);
                 // печататься «бренд:key» продолжает, но в перечень брендов не входит

#Область ПубличныйИнтерфейс

// Контур иконки.
//
// Параметры:
//  Имя - Строка - имя иконки, оно же имя файла без расширения.
//
// Возвращаемое значение:
//  Строка, Неопределено - значение атрибута d первого <path> либо Неопределено, если
//                         иконки нет или нарисована она не контуром.
//
Функция Контур(Знач Имя) Экспорт
	Найденный = НайтиГлиф(Имя);
	Возврат ?(Найденный = Неопределено, Неопределено, Найденный.Контур);
КонецФункции

// Область рисунка — прямоугольник, в котором иконка нарисована в своём файле: четыре
// числа viewBox, по ним рисунок и вписывается в страницу.
//
// Параметры:
//  Имя - Строка - имя иконки.
//
// Возвращаемое значение:
//  Строка - значение атрибута viewBox; "" для неизвестного имени.
//
Функция ОбластьРисунка(Знач Имя) Экспорт
	Найденный = НайтиГлиф(Имя);
	Возврат ?(Найденный = Неопределено, "", Найденный.ОбластьРисунка);
КонецФункции

// Разметка рисунка — то, что вставляется внутрь <svg> страницы.
//
// Параметры:
//  Имя - Строка - имя иконки.
//
// Возвращаемое значение:
//  Строка - разметка без комментариев; "" для неизвестного имени.
//
Функция Содержимое(Знач Имя) Экспорт
	Найденный = НайтиГлиф(Имя);
	Возврат ?(Найденный = Неопределено, "", Найденный.Содержимое);
КонецФункции

// Есть ли иконка с таким именем.
//
// Параметры:
//  Имя - Строка - имя иконки.
//
// Возвращаемое значение:
//  Булево
//
Функция Содержит(Знач Имя) Экспорт
	Возврат НайтиГлиф(Имя) <> Неопределено;
КонецФункции

// Имена всех иконок каталога.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Имена() Экспорт

	Результат = Новый Массив();
	Для Каждого КиЗ Из Глифы Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// --- значки брендов (дев-сборка 8) ---

// Приставка имени иконки-бренда: Кит.Иконка("бренд:telegram").
//
// Возвращаемое значение:
//  Строка
//
Функция ПриставкаБренда() Экспорт
	Возврат "бренд:";
КонецФункции

// Значок бренда: логотип из каталога значков провайдеров.
//
// Параметры:
//  Ключ - Строка - ключ бренда (telegram, github…), без приставки.
//
// Возвращаемое значение:
//  Структура, Неопределено - ОбластьРисунка, Содержимое (разметка рисунка без стиля файла),
//    Название (имя бренда), Цвет (#rrggbb — цвет бренда), Чернила (Булево — тёмный логотип:
//    в тёмной теме он рисуется цветом текста); Неопределено — такого бренда нет.
//
Функция Бренд(Знач Ключ) Экспорт
	Возврат Бренды.Получить(НРег(СокрЛП(Строка(Ключ))));
КонецФункции

// Ключи брендов каталога — только настоящие бренды: служебный значок каталога (key — глиф
// Material для общего входа) печататься по «бренд:key» продолжает, но в перечне его нет
// (дев-сборка 10).
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция КлючиБрендов() Экспорт

	Результат = Новый Массив();
	Для Каждого КиЗ Из Бренды Цикл
		Если Служебные.Найти(КиЗ.Ключ) = Неопределено Тогда
			Результат.Добавить(КиЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значки провайдеров — файлы для <img>: цвет у них в собственном <style>. В страницу этот
// стиль не едет — он красил бы все <path> страницы; цвет печатает иконка атрибутом fill,
// а тёмный («чернильный») логотип лист в тёмной теме перекрашивает цветом текста.
Функция ПрочитатьБренды(Знач Место, Знач Чтение)

	Результат = Новый Соответствие();
	Служебные = Новый Массив();
	// раскладка, собранная руками только под глифы (своя статика без значков провайдеров),
	// брендов не знает — у набора их тогда нет, а глифы на месте
	Попытка
		Каталог = ОбъединитьПути(Место.КаталогКита(), Место.ПодкаталогЗначков());
		Ключи = Место.КлючиЗначков();
	Исключение
		Возврат Результат;
	КонецПопытки;
	// раскладка до дев-сборки 10 служебных значков не называет — тогда все ключи бренды
	Попытка
		Служебные = Место.СлужебныеЗначки();
	Исключение
		Служебные = Новый Массив();
	КонецПопытки;
	Для Каждого Ключ Из Ключи Цикл
		Имя = Место.ФайлЗначка(Ключ);
		Текст = ПрочитатьТекст(ОбъединитьПути(Каталог, Имя));
		Разбор = Чтение.Прочитать(Текст, Имя);
		Стиль = СтрНайти(Разбор.Содержимое, "</style>");
		Содержимое = СокрЛП(?(Стиль = 0, Разбор.Содержимое, Сред(Разбор.Содержимое, Стиль + СтрДлина("</style>"))));
		Результат.Вставить(Ключ, Новый Структура("ОбластьРисунка, Содержимое, Контур, Название, Цвет, Чернила",
			Разбор.ОбластьРисунка, Содержимое, Разбор.Контур, Атрибут(Текст, "aria-label", Ключ),
			ЦветИзСтиля(Текст), СтрНайти(Текст, "prefers-color-scheme:dark") > 0));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Атрибут(Знач Текст, Знач Имя, Знач ПоУмолчанию)

	Начало = СтрНайти(Текст, Имя + "=""");
	Если Начало = 0 Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Хвост = Сред(Текст, Начало + СтрДлина(Имя) + 2);
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

// Цвет бренда — первый fill стиля файла; без него — цвет текста.
Функция ЦветИзСтиля(Знач Текст)

	Начало = СтрНайти(Текст, "fill:#");
	Если Начало = 0 Тогда
		Возврат "currentColor";
	КонецЕсли;
	Цвет = Сред(Текст, Начало + 5, 7);
	Цифры = "0123456789abcdefABCDEF";
	Для Позиция = 2 По 7 Цикл
		Если СтрНайти(Цифры, Сред(Цвет, Позиция, 1)) = 0 Тогда
			Возврат "currentColor";
		КонецЕсли;
	КонецЦикла;
	Возврат Цвет;

КонецФункции

Функция НайтиГлиф(Знач Имя)

	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Глифы.Получить(НРег(СокрЛП(Строка(Имя))));

КонецФункции

// Каталог читается ЦЕЛИКОМ на старте: файл, который не разобрался, роняет запуск громко,
// а не пропадает с экрана молча — молчаливая пропажа значка и есть то, ради чего вынос
// в файлы сделан.
Функция ПрочитатьКаталог(Знач Каталог, Знач Чтение)

	Если НЕ Новый Файл(Каталог).Существует() Тогда
		ВызватьИсключение СтрШаблон("Каталог глифов ""%1"" не найден: рисовать нечем.", Каталог);
	КонецЕсли;

	Результат = Новый Соответствие();
	Для Каждого Файл Из НайтиФайлы(Каталог, "*.svg") Цикл
		Если Файл.ЭтоФайл() Тогда
			Результат.Вставить(НРег(Файл.ИмяБезРасширения),
				Чтение.Прочитать(ПрочитатьТекст(Файл.ПолноеИмя), Файл.Имя));
		КонецЕсли;
	КонецЦикла;

	Если Результат.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("В каталоге глифов ""%1"" нет ни одного .svg.", Каталог);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПрочитатьТекст(Знач Путь)

	Поток = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Результат = Поток.Прочитать();
	Поток.Закрыть();
	Возврат ?(Результат = Неопределено, "", Результат);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РаскладкаСтатики") _Место,
	&Пластилин(Значение = "ЧтениеГлифа") _Чтение) Экспорт

	Глифы = ПрочитатьКаталог(_Место.КаталогГлифов(), _Чтение);
	Бренды = ПрочитатьБренды(_Место, _Чтение);

КонецПроцедуры
