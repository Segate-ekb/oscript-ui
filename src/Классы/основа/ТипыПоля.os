// Типы поля — объект UI-кита: тип значения поля задаётся системой типов OneScript
// (Тип("Число"), ОписаниеТипов с квалификаторами) и здесь переводится в тип ввода HTML
// и его пределы. Одна таблица на поле холста и на поле объявленной формы: иначе одно
// и то же ОписаниеТипов печаталось бы в двух местах по-разному.
//
// Желудём не сделан сознательно: состояния у него нет, а печать поля и объявление формы
// берут его себе сами — в граф желудей ему незачем.

#Область ПрограммныйИнтерфейс

// Разбирает тип поля: значение системы типов, описание типов либо строку прежнего Типа.
//
// Параметры:
//  Значение - Тип, ОписаниеТипов, Строка - тип значения поля. Строка («email», «url»,
//             «пароль», «файл», «многострочное», «выбор», «флажок», «число», «текст»,
//             «дата») — прежний Тип модели поля.
//
// Возвращаемое значение:
//  Структура - Тип (Строка: тип модели компонента «Поле» — «текст», «число», «флажок»,
//              «date», «datetime-local», «time» или строка как есть), Вид (Строка: вид поля
//              объявленной формы — «строка», «число», «флажок», «дата», «датавремя»,
//              «время»), Шаг, Максимум, ДлинаМакс (Строка: атрибуты step, max, maxlength;
//              "" — атрибута нет). Кидается исключением, если тип киту неизвестен.
//
Функция Разобрать(Знач Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ПоСтроке(Значение);
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Тип") Тогда
		Возврат ПоТипу(Значение, Неопределено);
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("ОписаниеТипов") Тогда
		Типы = Значение.Типы();
		Если Типы.Количество() = 0 Тогда
			ВызватьИсключение "Типы поля: описание типов без единого типа ничего не говорит"
				+ " о поле. Передайте ОписаниеТипов(""Число"", …) или Тип(""Строка"").";
		КонецЕсли;
		Возврат ПоТипу(Типы[0], Значение);
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Типы поля: тип поля задаётся значением Тип(…), ОписаниеТипов"
		+ " или строкой прежнего Типа, а пришло «%1».", ТипЗнч(Значение));

КонецФункции

// Тип поля по значению, которым его заполняют: тип ввода выводится из того, что в поле
// лежит, — число печатается числовым полем, Булево флажком, дата полем даты.
//
// Параметры:
//  Значение - Произвольный - значение поля.
//
// Возвращаемое значение:
//  Строка - тип модели компонента «Поле» («число», «флажок», «date», «текст»);
//           "" — по значению тип не выводится (Неопределено).
//
Функция ИзЗначения(Знач Значение) Экспорт

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат "число";
	ИначеЕсли ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат "флажок";
	ИначеЕсли ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат "date";
	ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат "текст";
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		// поля список и цвет (выпуск 0.12): массив значений — поле-список
		Возврат "список";
	КонецЕсли;

	Возврат "";

КонецФункции

// Значение поля так, как его ждёт ввод браузера: число с точкой и без разделителя групп,
// дата в формате ввода (ГГГГ-ММ-ДД, с временем — ГГГГ-ММ-ДДTЧЧ:ММ, время — ЧЧ:ММ).
// Строка(Число) дала бы «1 234,5», и поле type=number показало бы пустоту.
//
// Параметры:
//  Значение - Произвольный - значение поля.
//  Тип      - Строка - тип модели компонента «Поле».
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстВвода(Знач Значение, Знач Тип) Экспорт

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧН=0; ЧГ=0; ЧРД=.");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Возврат "";
		ИначеЕсли Тип = "datetime-local" Тогда
			Возврат Формат(Значение, "ДФ='yyyy-MM-dd""T""HH:mm'");
		ИначеЕсли Тип = "time" Тогда
			Возврат Формат(Значение, "ДФ=HH:mm");
		КонецЕсли;
		Возврат Формат(Значение, "ДФ=yyyy-MM-dd");
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат ?(Значение, "1", "");
	КонецЕсли;

	// поля список и цвет (выпуск 0.12): массив значений печатается строкой через запятую
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат СтрокаСписка(Значение);
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

// Приводит набранное в поле даты к Дате: ввод браузера приходит строкой ГГГГ-ММ-ДД,
// с временем — ГГГГ-ММ-ДДTЧЧ:ММ[:СС], время — ЧЧ:ММ[:СС].
//
// Параметры:
//  Текст - Строка - набранное.
//  Вид   - Строка - «дата» | «датавремя» | «время».
//
// Возвращаемое значение:
//  Дата, Неопределено - Неопределено, если текст датой не читается.
//
Функция ДатаИзВвода(Знач Текст, Знач Вид) Экспорт

	Цифры = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СокрЛП(Текст), "-", ""), ":", ""),
		"T", ""), " ", "");
	Если Вид = "время" Тогда
		Цифры = "00010101" + Цифры;
	КонецЕсли;

	Если СтрДлина(Цифры) = 8 ИЛИ СтрДлина(Цифры) = 12 Тогда
		Цифры = Цифры + ?(СтрДлина(Цифры) = 8, "000000", "00");
	КонецЕсли;
	Если СтрДлина(Цифры) <> 14 ИЛИ НЕ ТолькоЦифры(Цифры) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Возврат Дата(Цифры);
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

// --- поля список и цвет (выпуск 0.12) ---

// Значения поля-списка: строка делится по запятым, у частей срезаются края, пустые и
// повторы отбрасываются. Одно правило на печать плашек и на разбор присланного: иначе
// сервер сохранил бы не те значения, что человек видел плашками.
//
// Параметры:
//  Значение - Строка, Массив, Неопределено - строка через запятую или массив значений.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ЭлементыСписка(Знач Значение) Экспорт

	Части = Новый Массив();
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			// элемент массива сам может прийти строкой через запятую — делится так же
			Для Каждого Часть Из СтрРазделить(ТекстВвода(Элемент, ""), ",", Ложь) Цикл
				Части.Добавить(Часть);
			КонецЦикла;
		КонецЦикла;
	ИначеЕсли Значение <> Неопределено Тогда
		Части = СтрРазделить(Строка(Значение), ",", Ложь);
	КонецЕсли;

	Результат = Новый Массив();
	Для Каждого Часть Из Части Цикл
		Чистая = СокрЛП(Часть);
		Если ЗначениеЗаполнено(Чистая) И Результат.Найти(Чистая) = Неопределено Тогда
			Результат.Добавить(Чистая);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Значения поля-списка одной строкой — так их несёт скрытое поле формы и так их видит
// человек без скрипта в обычном текстовом поле.
//
// Параметры:
//  Значение - Строка, Массив, Неопределено - значения списка.
//
// Возвращаемое значение:
//  Строка - значения через «, ».
//
Функция СтрокаСписка(Знач Значение) Экспорт
	Возврат СтрСоединить(ЭлементыСписка(Значение), ", ");
КонецФункции

// Код цвета в виде, который понимает <input type="color">: «#» и шесть шестнадцатеричных
// цифр строчными. Этот же формат проверяет pattern поля цвета.
//
// Параметры:
//  Текст - Строка - набранный код.
//
// Возвращаемое значение:
//  Строка - код вида «#rrggbb»; "" — текст кодом цвета не читается.
//
Функция КодЦвета(Знач Текст) Экспорт

	Код = НРег(СокрЛП(Строка(?(Текст = Неопределено, "", Текст))));
	Если СтрДлина(Код) <> 7 ИЛИ Лев(Код, 1) <> "#" Тогда
		Возврат "";
	КонецЕсли;
	Для Позиция = 2 По 7 Цикл
		Если СтрНайти("0123456789abcdef", Сред(Код, Позиция, 1)) = 0 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	Возврат Код;

КонецФункции

// Шаблон кода цвета для атрибута pattern: браузер сверяет с ним значение целиком.
//
// Возвращаемое значение:
//  Строка
//
Функция ШаблонКодаЦвета() Экспорт
	Возврат "#[0-9A-Fa-f]{6}";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПоСтроке(Знач Значение)

	Тип_ = НРег(СокрЛП(Значение));
	Если Тип_ = "дата" Тогда
		Возврат Разбор("date", "дата");
	ИначеЕсли Тип_ = "число" Тогда
		Возврат Разбор("число", "число");
	ИначеЕсли Тип_ = "флажок" Тогда
		Возврат Разбор("флажок", "флажок");
	ИначеЕсли Тип_ = "пароль" ИЛИ Тип_ = "секрет" Тогда
		Возврат Разбор("пароль", "секрет");
	ИначеЕсли Тип_ = "многострочное" ИЛИ Тип_ = "выбор" Тогда
		Возврат Разбор(Тип_, Тип_);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Тип_) ИЛИ Тип_ = "текст" ИЛИ Тип_ = "строка" Тогда
		Возврат Разбор("текст", "строка");
	КонецЕсли;

	// email, url, файл и любой тип HTML: у объявленной формы вид тот же, что и тип
	Возврат Разбор(Тип_, Тип_);

КонецФункции

Функция ПоТипу(Знач ТипЗначения, Знач Описание)

	Если ТипЗначения = Тип("Число") Тогда
		Результат = Разбор("число", "число");
		Если Описание <> Неопределено Тогда
			ДобавитьПределыЧисла(Результат, Описание.КвалификаторыЧисла);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Если ТипЗначения = Тип("Булево") Тогда
		Возврат Разбор("флажок", "флажок");
	КонецЕсли;

	Если ТипЗначения = Тип("Дата") Тогда
		Части = ?(Описание = Неопределено, Неопределено, Описание.КвалификаторыДаты.ЧастиДаты);
		Если Части = ЧастиДаты.ДатаВремя И Описание <> Неопределено Тогда
			Возврат Разбор("datetime-local", "датавремя");
		ИначеЕсли Части = ЧастиДаты.Время Тогда
			Возврат Разбор("time", "время");
		КонецЕсли;
		Возврат Разбор("date", "дата");
	КонецЕсли;

	Если ТипЗначения = Тип("Строка") Тогда
		Результат = Разбор("текст", "строка");
		Длина = ?(Описание = Неопределено, 0, Описание.КвалификаторыСтроки.Длина);
		Если Длина > 0 Тогда
			Результат.ДлинаМакс = Формат(Длина, "ЧН=0; ЧГ=0");
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Типы поля: поле типа «%1» кит печатать не умеет. Поле"
		+ " бывает строкой, числом, Булево (флажок) и датой; ссылку или объект показывают"
		+ " выбором — словом Вариант(Значение, Подпись).", ТипЗначения);

КонецФункции

// Шаг — единица последнего разряда: 0 знаков дробной части дают шаг 1, два — 0.01.
// Максимум — самое большое число, которое уложится в разрядность: (5, 2) — 999.99.
Процедура ДобавитьПределыЧисла(Знач Результат, Знач Квалификаторы)

	Дробная = Квалификаторы.РазрядностьДробнойЧасти;
	Результат.Шаг = ?(Дробная = 0, "1", "0." + Повтор("0", Дробная - 1) + "1");

	Целых = Квалификаторы.Разрядность - Дробная;
	Если Квалификаторы.Разрядность > 0 И Целых > 0 Тогда
		Результат.Максимум = Повтор("9", Целых) + ?(Дробная = 0, "", "." + Повтор("9", Дробная));
	КонецЕсли;

КонецПроцедуры

Функция Разбор(Знач ТипПоля, Знач Вид)
	Возврат Новый Структура("Тип, Вид, Шаг, Максимум, ДлинаМакс", ТипПоля, Вид, "", "", "");
КонецФункции

Функция Повтор(Знач Символ, Знач Раз)

	Результат = "";
	Для Номер = 1 По Раз Цикл
		Результат = Результат + Символ;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТолькоЦифры(Знач Текст)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти
