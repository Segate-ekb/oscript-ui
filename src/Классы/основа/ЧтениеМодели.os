// Чтение модели компонента — желудь UI-кита.
// «Мягкое» чтение структур: нет поля / Неопределено / не тот тип → значение по умолчанию.

// Читает строковое поле модели.
//
// Параметры:
//  Модель      - Структура, Произвольный - модель компонента.
//  Ключ        - Строка - имя поля.
//  ПоУмолчанию - Строка - (необязательный, по умолчанию "") значение при отсутствии поля.
//
// Возвращаемое значение:
//  Строка
//
Функция Текст(Знач Модель, Знач Ключ, Знач ПоУмолчанию = "") Экспорт

	Значение = Значение(Модель, Ключ);
	Если Значение = Неопределено Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;

	Возврат Строка(Значение);

КонецФункции

// Читает булево поле модели: Истина только при явном Истина.
//
// Параметры:
//  Модель - Структура, Произвольный - модель компонента.
//  Ключ   - Строка - имя поля.
//
// Возвращаемое значение:
//  Булево
//
Функция Флаг(Знач Модель, Знач Ключ) Экспорт
	Возврат Значение(Модель, Ключ) = Истина;
КонецФункции

// Читает поле-список модели.
//
// Параметры:
//  Модель - Структура, Произвольный - модель компонента.
//  Ключ   - Строка - имя поля.
//
// Возвращаемое значение:
//  Массив - элементы поля либо пустой массив.
//
Функция Список(Знач Модель, Знач Ключ) Экспорт

	Значение = Значение(Модель, Ключ);
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Возврат Значение;
	КонецЕсли;

	Возврат Новый Массив();

КонецФункции

// Читает сырое значение поля модели.
//
// Параметры:
//  Модель - Структура, Произвольный - модель компонента.
//  Ключ   - Строка - имя поля.
//
// Возвращаемое значение:
//  Произвольный, Неопределено - значение поля либо Неопределено, если поля нет.
//
Функция Значение(Знач Модель, Знач Ключ) Экспорт

	Если ТипЗнч(Модель) <> Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Найденное = Неопределено;
	Если НЕ Модель.Свойство(Ключ, Найденное) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Найденное;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
