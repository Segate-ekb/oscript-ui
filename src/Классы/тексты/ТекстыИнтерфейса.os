// Тексты интерфейса — желудь UI-кита: резолвер ключей. Контроллер называет ключ,
// текст отдаёт словарь инсталляции. Здесь только политика разрешения ключа и
// локализуемые форматы; сами строки живут за контрактом СловарьИнтерфейса.
//
// Отсутствующий ключ даёт ВИДИМЫЙ МАРКЕР, а не пустую строку (кит прячет незаполненное,
// и потеря ключа выглядела бы как «так и задумано») и не исключение (опечатка в ключе
// подсказки превратила бы рабочий раздел в 500).

Перем Словарь; // СловарьИнтерфейса

// Текст по ключу либо видимый маркер отсутствия.
//
// Параметры:
//  Ключ - Строка - ключ вида "settings.pool.visibility.title".
//
// Возвращаемое значение:
//  Строка - никогда не пустая: у пустой строки нет способа стать заметной.
//
Функция Текст(Знач Ключ) Экспорт

	Значение = Словарь.НайтиТекст(Ключ);
	Если Значение = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Маркер(Ключ);
	КонецЕсли;

	Возврат Значение;

КонецФункции

// Текст по ключу с подстановками. Отдельный метод, а не СтрШаблон снаружи: маркер
// отсутствующего ключа иначе потерял бы значения, которые и объясняют, что случилось.
//
// Параметры:
//  Ключ   - Строка - ключ текста.
//  П1..П5 - Произвольный - (необязательные, по умолчанию Неопределено) подстановки %1..%5.
//
// Возвращаемое значение:
//  Строка
//
Функция Шаблон(Знач Ключ, Знач П1 = Неопределено, Знач П2 = Неопределено, Знач П3 = Неопределено,
	Знач П4 = Неопределено, Знач П5 = Неопределено) Экспорт

	Значение = Словарь.НайтиТекст(Ключ);
	Если Значение = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Маркер(Ключ) + Аргументы(П1, П2, П3, П4, П5);
	КонецЕсли;

	Возврат СтрШаблон(Значение, П1, П2, П3, П4, П5);

КонецФункции

// Видимый маркер отсутствующего ключа. Скобки и «?» не экранируются, поэтому маркер
// доезжает до экрана как есть. Дефис в «ключ-не-задан» выводит литерал из-под
// определения «пользовательская строка», которым пользуется скан.
//
// Параметры:
//  Ключ - Строка - ключ, который не нашёлся.
//
// Возвращаемое значение:
//  Строка - маркер вида "[?ключ]".
//
Функция Маркер(Знач Ключ) Экспорт
	Возврат "[?" + ?(ЗначениеЗаполнено(Ключ), Строка(Ключ), "ключ-не-задан") + "]";
КонецФункции

// Число в пользовательском виде. Формат — часть локали, поэтому живёт рядом с текстами,
// а не маской в каждом контроллере.
//
// «ЧН=0» обязателен: без него Формат(0, "ЧГ=0") даёт ПУСТУЮ строку, а кит прячет пустое —
// нулевая квота пула выглядела бы как «не заполнено».
//
// Параметры:
//  Значение - Число - число для вывода.
//
// Возвращаемое значение:
//  Строка
//
Функция ЧислоТекстом(Знач Значение) Экспорт
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

Функция Аргументы(Знач П1, Знач П2, Знач П3, Знач П4, Знач П5)

	Части = Новый Массив();
	Значения = Новый Массив();
	Значения.Добавить(П1);
	Значения.Добавить(П2);
	Значения.Добавить(П3);
	Значения.Добавить(П4);
	Значения.Добавить(П5);

	Для Каждого Значение Из Значения Цикл
		Если Значение <> Неопределено И ЗначениеЗаполнено(Строка(Значение)) Тогда
			Части.Добавить(Строка(Значение));
		КонецЕсли;
	КонецЦикла;

	Возврат ?(Части.Количество() = 0, "", " " + СтрСоединить(Части, " "));

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СловарьИнтерфейса") _Словарь) Экспорт

	Словарь = _Словарь;

КонецПроцедуры
