// Витрина UI-кита — справочник по всей библиотеке в одном месте: у каждого образца видно
// и как он выглядит, и каким кодом написан. Показанный код НЕ подпись к картинке: витрина
// исполняет его и рисует образец ровно им, поэтому разойтись им негде.

Перем Набор;      // НаборКомпонентов — этим именем он назван и в исходниках образцов
Перем Кит;        // Кит — то же
Перем Формы;      // Формы — то же
Перем Настройки;  // РендерерНастроек — то же
Перем Печать;     // РазметкаЭлементов — из неё берётся словарь родов
Перем Каталоги;  // Массив из каталогов образцов

// Разделы витрины: у каждого образца рядом с исходником лежит нарисованная им разметка.
//
// Возвращаемое значение:
//  Массив из Структура - Ключ, Заголовок, Словарь, Образцы; образец —
//  Подпись, Исходник, Показ, Разметка.
//
Функция Разделы() Экспорт

	Результат = Новый Массив();

	Для Каждого Каталог Из Каталоги Цикл
		Для Каждого Часть Из Каталог.Разделы() Цикл
			Результат.Добавить(Нарисованный(Часть));
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Отрисовывает тело страницы витрины; каркас страницы добавляет вызывающий.
//
// Возвращаемое значение:
//  Строка - HTML.
//
Функция Отрисовать() Экспорт

	Результат = Набор.ЗаголовокСтраницы().Отрисовать(Новый Структура("Заголовок, Пояснение",
		"UI-кит", "каждый образец — с кодом, которым он и нарисован")) + КакПользоваться();

	Для Каждого Часть Из Разделы() Цикл
		Результат = Результат + КарточкаРаздела(Часть);
	КонецЦикла;

	Возврат Результат + СловарьРодов();

КонецФункции

// Скрипт страницы витрины: оживляет кнопки копирования кита по атрибуту data-copy —
// ровно то, что делает у себя любая инсталляция. Без него код образца остаётся видимым
// и выделяемым, потому что он лежит в разметке, а не приносится скриптом.
//
// Возвращаемое значение:
//  Строка - тело тега <script>.
//
Функция Скрипт() Экспорт

	Возврат "document.addEventListener('click', function (событие) {
		|	var кнопка = событие.target.closest('[data-copy]');
		|	if (!кнопка || !navigator.clipboard) { return; }
		|
		|	navigator.clipboard.writeText(кнопка.getAttribute('data-copy'));
		|
		|	var подпись = кнопка.querySelector('span');
		|	if (!подпись || подпись.textContent === 'Скопировано') { return; }
		|
		|	var было = подпись.textContent;
		|	подпись.textContent = 'Скопировано';
		|	setTimeout(function () { подпись.textContent = было; }, 1500);
		|});";

КонецФункции

#Область Печать

Функция КакПользоваться()

	Тело = Кит.Холст();
	Тело.Добавить(Кит.Примечание("Витрина — для того, кто пишет экран на этой библиотеке."
		+ " Под каждым образцом лежит его исходник: скопируйте кнопкой справа от кода,"
		+ " вставьте к себе — получите ровно то, что нарисовано выше."));

	Тело.Добавить(Кит.Примечание("В исходниках доступны четыре желудя, которые экран"
		+ " приложения достаёт из ОСени:"));

	Перечень = Тело.Добавить(Кит.Список("сноска"));
	ДобавитьПункт(Перечень, "Набор", "фасад компонентов: Набор.Кнопка().Отрисовать(Модель)");
	ДобавитьПункт(Перечень, "Кит", "холст: экран собирается деревом узлов");
	ДобавитьПункт(Перечень, "Формы", "фабрика объявлений формы");
	ДобавитьПункт(Перечень, "Настройки", "каркас дома настроек: разделы, секции, панель");

	Возврат Набор.Карточка().Отрисовать(Новый Структура("Заголовок, Тело",
		"Как пользоваться витриной", Тело.Рендер()));

КонецФункции

Процедура ДобавитьПункт(Знач Перечень, Знач Имя, Знач Пояснение)

	Пункт = Перечень.Добавить(Кит.Пункт());
	Пункт.Добавить(Кит.Код(Имя));
	Пункт.Добавить(Кит.Текст(" — " + Пояснение));

КонецПроцедуры

Функция КарточкаРаздела(Знач Часть)

	Тело = "";
	Для Каждого Образец Из Часть.Образцы Цикл
		Тело = Тело + БлокОбразца(Образец);
	КонецЦикла;

	Возврат Набор.Карточка().Отрисовать(Новый Структура("Заголовок, Описание, Тело",
		Часть.Заголовок,
		СтрШаблон("образцов: %1", Формат(Часть.Образцы.Количество(), "ЧН=0; ЧГ=0")),
		Тело));

КонецФункции

Функция БлокОбразца(Знач Образец)

	Заглавие = Кит.Заголовок(3);
	Заглавие.Добавить(Кит.Текст(Образец.Подпись));

	Возврат Заглавие.Рендер() + Показ(Образец)
		+ Набор.БлокКоманды().Отрисовать(Новый Структура("Команда", Образец.Исходник));

КонецФункции

// Живая картинка — не всегда: узлы головы документа и лендмарки в чужую страницу
// не вставляются, их показывают собственной разметкой.
Функция Показ(Знач Образец)

	Если НЕ ЗначениеЗаполнено(Образец.Разметка) Тогда
		Возврат Кит.Примечание("этот вызов не печатает ничего", "пусто").Рендер();
	КонецЕсли;

	Если Образец.Показ = "разметка" Тогда
		Возврат Кит.Код(Образец.Разметка, "блочный").Рендер();
	КонецЕсли;

	Возврат Образец.Разметка;

КонецФункции

// Виды рода — закрытый набор кита, и увидеть его целиком больше негде.
Функция СловарьРодов()

	Строки = Новый Массив();
	Для Каждого Род Из Печать.Роды() Цикл
		Строки.Добавить(СтрокаРода(Род));
	КонецЦикла;

	Колонки = Новый Массив();
	Колонки.Добавить("Род");
	Колонки.Добавить("Тег");
	Колонки.Добавить("Пускает детей");
	Колонки.Добавить("Второй холст");
	Колонки.Добавить("Виды");

	Возврат Набор.Карточка().Отрисовать(Новый Структура("Заголовок, Описание, Тело",
		"Словарь родов", "чем печатается род, пускает ли внутрь детей и какие виды знает",
		Набор.Таблица().Отрисовать(Новый Структура("Колонки, Строки", Колонки, Строки))));

КонецФункции

Функция СтрокаРода(Знач Род)

	Виды = Новый Массив();
	Для Каждого Вид Из Печать.ВидыРода(Род) Цикл
		Виды.Добавить(?(ЗначениеЗаполнено(Вид), Вид, "—"));
	КонецЦикла;

	Ячейки = Новый Массив();
	Ячейки.Добавить(Род);
	Ячейки.Добавить(?(ЗначениеЗаполнено(Печать.ТегРода(Род)),
		"<" + Печать.ТегРода(Род) + ">", "—"));
	Ячейки.Добавить(?(Печать.Контейнер(Род), "да", "нет"));
	Ячейки.Добавить(?(ЗначениеЗаполнено(Печать.ВторойХолстРода(Род)),
		Печать.ВторойХолстРода(Род), "—"));
	Ячейки.Добавить(СтрСоединить(Виды, ", "));

	Возврат Ячейки;

КонецФункции

#КонецОбласти

#Область Исполнение

Функция Нарисованный(Знач Часть)

	Образцы = Новый Массив();
	Для Каждого Образец Из Часть.Образцы Цикл
		Образцы.Добавить(Новый Структура("Подпись, Исходник, Показ, Разметка",
			Образец.Подпись, Образец.Исходник, Образец.Показ, Исполнить(Образец.Исходник)));
	КонецЦикла;

	Возврат Новый Структура("Ключ, Заголовок, Словарь, Образцы",
		Часть.Ключ, Часть.Заголовок, Часть.Словарь, Образцы);

КонецФункции

// Здесь и живёт вся правда витрины: картинку рисует ТОТ ЖЕ текст, который показан рядом
// с ней. Второй копии нет, поэтому расходиться нечему; сломанный исходник роняет сборку
// витрины, а не показывает подпись к чужой картинке.
Функция Исполнить(Знач Исходник)

	HTML = "";
	Выполнить(Исходник);
	Возврат HTML;

КонецФункции

#КонецОбласти

// НЕ желудь сознательно: витрину собирает её запуск и тест кита, в контейнере ОСени
// ей делать нечего — зависимости приходят обычными параметрами.
//
// Параметры:
//  _Набор     - НаборКомпонентов - фасад компонентов; в исходниках образцов он «Набор».
//  _Кит       - Кит              - холст; в исходниках образцов он «Кит».
//  _Формы     - Формы            - фабрика объявлений; в исходниках образцов она «Формы».
//  _Настройки - РендерерНастроек - каркас дома настроек; в образцах он «Настройки».
//  _Печать    - РазметкаЭлементов - словарь родов узлов.
//  _Страница  - ОбразцыСтраницы  - каталог образцов страницы объекта.
//  _Ввод      - ОбразцыВвода     - каталог образцов ввода.
//  _Показ     - ОбразцыПоказа    - каталог образцов показа.
//  _Холст     - ОбразцыХолста    - каталог образцов родов узлов.
//
Процедура ПриСозданииОбъекта(Знач _Набор, Знач _Кит, Знач _Формы, Знач _Настройки,
	Знач _Печать, Знач _Страница, Знач _Ввод, Знач _Показ, Знач _Холст) Экспорт

	Набор = _Набор;
	Кит = _Кит;
	Формы = _Формы;
	Настройки = _Настройки;
	Печать = _Печать;

	Каталоги = Новый Массив();
	Каталоги.Добавить(_Страница);
	Каталоги.Добавить(_Ввод);
	Каталоги.Добавить(_Показ);
	Каталоги.Добавить(_Холст);

КонецПроцедуры
