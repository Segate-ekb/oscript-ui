// Каталог образцов холста: по образцу на каждый род узла — от корня документа до готового
// куска чужой разметки. Здесь лежат ИСХОДНИКИ образцов — тот самый код, которым витрина
// их и рисует.

Перем Сборка;  // СборкаОбразцов

// Разделы витрины для родов узлов холста.
//
// Возвращаемое значение:
//  Массив из Структура - Ключ, Заголовок, Словарь, Образцы (см. СборкаОбразцов).
//
Функция Разделы() Экспорт

	Результат = Новый Массив();

	Результат.Добавить(Сборка.Раздел("КаркасДокумента", "Роды: каркас документа",
		"род:документ, род:голова, род:титул, род:мета, род:ресурс, род:стиль,"
			+ " род:скрипт, род:тело",
		ОбразцыКаркаса()));
	Результат.Добавить(Сборка.Раздел("Лендмарки", "Роды: лендмарки страницы",
		"род:шапка, род:основное, род:подвал, род:навигация", ОбразцыЛендмарков()));
	Результат.Добавить(Сборка.Раздел("Раскладка", "Роды: раскладка",
		"род:холст, род:область, род:ряд, род:статья, род:раскрывашка, род:группа",
		ОбразцыРаскладки()));
	Результат.Добавить(Сборка.Раздел("Списки", "Роды: списки и пары",
		"род:список, род:пункт, род:свойства, род:свойство", ОбразцыСписков()));
	Результат.Добавить(Сборка.Раздел("ТаблицаДеревом", "Роды: таблица",
		"род:таблица, род:колонка, род:запись, род:ячейка", ОбразцыТаблицы()));
	Результат.Добавить(Сборка.Раздел("ФормыДеревом", "Роды: формы",
		"род:форма, род:форма-без-сессии, род:форма-отбора, род:форма-без-токена,"
			+ " компонент:объявление, компонент:окно",
		ОбразцыФорм()));
	Результат.Добавить(Сборка.Раздел("Текст", "Роды: текст и значения",
		"род:заголовок, род:надпись, род:примечание, род:ссылка, род:текст, род:код,"
			+ " род:шаблон, род:картинка, род:готовое",
		ОбразцыТекста()));
	Результат.Добавить(Сборка.Раздел("Компонент", "Роды: компонент в дереве",
		"род:компонент", ОбразцыКомпонента()));
	Результат.Добавить(Сборка.Раздел("Экран", "Экран, собранный деревом",
		"", ОбразцыЭкрана()));

	Возврат Результат;

КонецФункции

#Область КаркасДокумента

Функция ОбразцыКаркаса()

	Список = Новый Массив();

	Список.Добавить(Сборка.ОбразецРазметкой("документ целиком: голова и тело",
		"Документ = Кит.Документ(""ru"", ""тёмная"");
		|
		|Голова = Документ.Добавить(Кит.Голова());
		|Голова.Добавить(Кит.Титул(""Проекты""));
		|
		|Тело = Документ.Добавить(Кит.Тело());
		|Тело.Добавить(Кит.Основное(""полоса""));
		|
		|HTML = Документ.Рендер();"));

	Список.Добавить(Сборка.ОбразецРазметкой("объявления головы",
		"Голова = Кит.Голова();
		|Голова.Добавить(Кит.Кодировка(""utf-8""));
		|Голова.Добавить(Кит.Мета(""viewport"", ""width=device-width, initial-scale=1""));
		|
		|HTML = Голова.Рендер();"));

	Список.Добавить(Сборка.ОбразецРазметкой("ресурсы: лист стилей и иконка вкладки",
		"Голова = Кит.Голова();
		|Голова.Добавить(Кит.Ресурс(""stylesheet"", ""/static/app.css"", ""text/css""));
		|Голова.Добавить(Кит.Ресурс(""icon"", ""/static/знак.svg"", ""image/svg+xml"", ""32x32""));
		|Голова.Добавить(Кит.Ресурс(""icon"", """"));
		|
		|HTML = Голова.Рендер();"));

	Список.Добавить(Сборка.ОбразецРазметкой("палитра инлайном",
		"HTML = Кит.Стиль(""токены-темы"", "":root { --layout-width: 1280px; }"").Рендер();"));

	Список.Добавить(Сборка.ОбразецРазметкой("отложенный скрипт",
		"HTML = Кит.Скрипт(""/static/app.js"").Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Лендмарки

Функция ОбразцыЛендмарков()

	Список = Новый Массив();

	Список.Добавить(Сборка.ОбразецРазметкой("страница из лендмарков",
		"Тело = Кит.Тело();
		|
		|Шапка = Тело.Добавить(Кит.Шапка(""страницы""));
		|Шапка.Добавить(Кит.Навигация(""верхняя"")).Подпись(""Основная навигация"");
		|
		|Тело.Добавить(Кит.Основное(""полоса""));
		|Тело.Добавить(Кит.Подвал(""страницы""));
		|
		|HTML = Тело.Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Раскладка

Функция ОбразцыРаскладки()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("холст — группировка без своего тега",
		"Холст = Кит.Холст();
		|Холст.Добавить(Кит.Примечание(""первый абзац""));
		|Холст.Добавить(Кит.Примечание(""второй абзац""));
		|
		|HTML = Холст.Рендер();"));

	Список.Добавить(Сборка.Образец("область — блок со своим тегом, видом и признаком",
		"Область = Кит.Область(""вставка"");
		|Область.Признак(""шаг"", ""1"");
		|Область.Добавить(Кит.Примечание(""врезка пунктиром внутри формы""));
		|
		|HTML = Область.Рендер();"));

	Список.Добавить(Сборка.Образец("ряд — элементы в строку с переносом",
		"Ряд = Кит.Ряд(""выбор"");
		|Ряд.Добавить(Кит.Кнопка(Новый Структура(""Подпись, Вариант"", ""Все"", ""вторичная"")));
		|Ряд.Добавить(Кит.Кнопка(Новый Структура(""Подпись, Вариант"", ""Мои"", ""вторичная"")));
		|
		|HTML = Ряд.Рендер();"));

	Список.Добавить(Сборка.Образец("статья — кусок, который можно вынуть из списка",
		"Статья = Кит.Статья(""карточка"");
		|Статья.Добавить(Кит.Заголовок(3)).Добавить(Кит.Текст(""Проект «Альфа»""));
		|Статья.Добавить(Кит.Примечание(""Проект по умолчанию"", ""описание""));
		|
		|HTML = Статья.Рендер();"));

	Список.Добавить(Сборка.Образец("раскрывашка — свёрнутая строка наполняется через Шапка()",
		"Раскрывашка = Кит.Раскрывашка(""врезка"");
		|Раскрывашка.Шапка().Добавить(Кит.Текст(""Ещё три источника""));
		|Раскрывашка.Добавить(Кит.Примечание(""содержимое видно после раскрытия""));
		|
		|HTML = Раскрывашка.Рендер();"));

	Список.Добавить(Сборка.Образец("раскрывашка, открытая сразу",
		"Раскрывашка = Кит.Раскрывашка();
		|Раскрывашка.Открыть();
		|Раскрывашка.Шапка().Добавить(Кит.Текст(""Подробности""));
		|Раскрывашка.Добавить(Кит.Примечание(""открыта по умолчанию""));
		|
		|HTML = Раскрывашка.Рендер();"));

	Список.Добавить(Сборка.Образец("группа — набор полей со своей легендой",
		"Группа = Кит.Группа(""Видимость"", ""набор"");
		|Группа.Добавить(Кит.Поле(Новый Структура(""Имя, Метка, Тип, Отмечено"",
		|	""публичный"", ""Показывать всем"", ""флажок"", Истина)));
		|
		|HTML = Группа.Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Списки

Функция ОбразцыСписков()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("список и пункты",
		"Перечень = Кит.Список();
		|Перечень.Добавить(Кит.Пункт()).Добавить(Кит.Текст(""первый""));
		|
		|Второй = Перечень.Добавить(Кит.Пункт());
		|Второй.Добавить(Кит.Ссылка(""/документы"")).Добавить(Кит.Текст(""второй, ссылкой""));
		|
		|HTML = Перечень.Рендер();"));

	Список.Добавить(Сборка.Образец("список-сноска под полем",
		"Перечень = Кит.Список(""сноска"");
		|Перечень.Добавить(Кит.Пункт()).Добавить(Кит.Текст(""только латиница и дефис""));
		|Перечень.Добавить(Кит.Пункт()).Добавить(Кит.Текст(""не длиннее 64 символов""));
		|
		|HTML = Перечень.Рендер();"));

	Список.Добавить(Сборка.Образец("свойства — пары «имя — значение»",
		"Свойства = Кит.Свойства();
		|Свойства.Добавить(Кит.Свойство(""Создан"")).Добавить(Кит.Текст(""вчера""));
		|Свойства.Добавить(Кит.Свойство(""Размер"")).Добавить(Кит.Код(""430 МБ""));
		|
		|HTML = Свойства.Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Таблица

Функция ОбразцыТаблицы()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("колонки, запись, ячейка и разворот",
		"Таблица = Кит.Таблица();
		|Таблица.Добавить(Кит.Колонка(""Имя""));
		|Таблица.Добавить(Кит.Колонка(""Признак""));
		|
		|Запись = Таблица.Добавить(Кит.Запись());
		|Запись.Добавить(Кит.Ячейка()).Добавить(Кит.Код(""значение""));
		|Запись.Добавить(Кит.Ячейка()).Добавить(
		|	Кит.Плашка(Новый Структура(""Текст, Вид"", ""готово"", ""ok"")));
		|Запись.Разворот().Добавить(Кит.Примечание(""разворот печатается во всю ширину""));
		|
		|HTML = Таблица.Рендер();"));

	Список.Добавить(Сборка.Образец("пустая таблица отвечает словами",
		"Таблица = Кит.Таблица();
		|Таблица.Добавить(Кит.Колонка(""Имя""));
		|Таблица.Пусто().Добавить(Кит.Примечание(""Ничего не найдено""));
		|
		|HTML = Таблица.Рендер();"));

	Список.Добавить(Сборка.Образец("ячейка столбиком — два этажа значения",
		"Таблица = Кит.Таблица(""карточками"");
		|Таблица.Добавить(Кит.Колонка(""Документ""));
		|
		|Ячейка = Таблица.Добавить(Кит.Запись()).Добавить(Кит.Ячейка(""столбиком""));
		|Ячейка.Добавить(Кит.Надпись(""название"")).Добавить(Кит.Текст(""отчёт""));
		|Ячейка.Добавить(Кит.Надпись(""пояснение"")).Добавить(Кит.Текст(""обновлён вчера""));
		|
		|HTML = Таблица.Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Формы

Функция ОбразцыФорм()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("форма вошедшего — токен встаёт первым ребёнком",
		"Форма = Кит.Форма(""/проекты"", ""т0кен-сессии"", ""строкой"");
		|Форма.Добавить(Кит.Поле(Новый Структура(""Имя, Метка"", ""имя"", ""Имя проекта"")));
		|Форма.Добавить(Кит.Кнопка(Новый Структура(""Подпись, Вариант"", ""Создать"", ""основная"")));
		|
		|HTML = Форма.Рендер();"));

	Список.Добавить(Сборка.Образец("форма посетителя без сессии",
		"Форма = Кит.ФормаБезСессии(""/вход"", ""столбик"");
		|Форма.Добавить(Кит.Поле(Новый Структура(""Имя, Метка"", ""почта"", ""Почта"")));
		|Форма.Добавить(Кит.Кнопка(Новый Структура(""Подпись, Вариант"", ""Войти"", ""основная"")));
		|
		|HTML = Форма.Рендер();"));

	Список.Добавить(Сборка.Образец("форма отбора — GET, ничего не меняет",
		"Форма = Кит.ФормаОтбора(""/документы"", ""строкой"");
		|Форма.Добавить(Кит.Поле(Новый Структура(""Имя, Метка"", ""q"", ""Поиск"")));
		|Форма.Добавить(Кит.Кнопка(Новый Структура(""Подпись, Вариант"", ""Найти"", ""вторичная"")));
		|
		|HTML = Форма.Рендер();"));

	Список.Добавить(Сборка.Образец("форма, у которой сервер токена не спрашивает",
		"Форма = Кит.ФормаБезТокена(""/оформление"", ""переключатель"");
		|Форма.Добавить(Кит.Кнопка(Новый Структура(""Подпись, Вариант, Иконка, ТолькоИконка"",
		|	""Переключить тему"", ""ссылка"", ""луна"", Истина)));
		|
		|HTML = Форма.Рендер();"));

	Список.Добавить(Сборка.Образец("объявленная форма — состав знает она сама",
		"Объявление = Формы.Новая();
		|Объявление.Поле(""имя"", ""Имя проекта"", ""строка"",
		|	Новый Структура(""Обязательное, Подсказка"", Истина, ""латиница и дефис""));
		|Объявление.Поле(""описание"", ""Описание"", ""многострочное"");
		|
		|HTML = Кит.ОбъявленнаяФорма(Объявление, Новый Структура(""имя"", ""main""),
		|	""/проекты"", ""т0кен-сессии"", ""столбик"").Рендер();"));

	Список.Добавить(Сборка.Образец("та же форма окном поверх экрана",
		"Объявление = Формы.Новая();
		|Объявление.Поле(""имя"", ""Имя проекта"");
		|
		|Окно = Новый Структура(""Заголовок, Открывашка, Отправка"",
		|	""Новый проект"", ""Создать проект"", ""Создать"");
		|
		|HTML = Кит.Окно(Объявление, Новый Структура(), ""/проекты"", ""т0кен-сессии"", Окно).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Текст

Функция ОбразцыТекста()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("заголовки — уровень числом, а не тегом",
		"Холст = Кит.Холст();
		|Холст.Добавить(Кит.Заголовок(2, ""имя"")).Добавить(Кит.Текст(""Документы проекта""));
		|Холст.Добавить(Кит.Заголовок(3)).Добавить(Кит.Текст(""Редакции""));
		|
		|HTML = Холст.Рендер();"));

	Список.Добавить(Сборка.Образец("надписи — кусок строки со своей ролью",
		"Ряд = Кит.Ряд(""строкой"");
		|Ряд.Добавить(Кит.Надпись(""название"")).Добавить(Кит.Текст(""отчёт""));
		|Ряд.Добавить(Кит.Надпись(""пояснение"")).Добавить(Кит.Текст(""обновлён вчера""));
		|Ряд.Добавить(Кит.Надпись(""приглушённая"")).Добавить(Кит.Текст(""черновик""));
		|
		|HTML = Ряд.Рендер();"));

	Список.Добавить(Сборка.Образец("примечание — абзац мелким шрифтом",
		"HTML = Кит.Примечание(""Ключ показывается один раз."", ""описание"").Рендер();"));

	Список.Добавить(Сборка.Образец("ссылка — холст, а не только текст",
		"Ссылка = Кит.Ссылка(""/документы"", ""пилюля"");
		|Ссылка.Добавить(Кит.Иконка(""куб""));
		|Ссылка.Добавить(Кит.Текст("" Документы""));
		|
		|HTML = Ссылка.Рендер();"));

	Список.Добавить(Сборка.Образец("текст экранируется по своей природе",
		"HTML = Кит.Примечание().Добавить(
		|	Кит.Текст(""<script>alert(1)</script> — и это видно как текст"")).Родитель().Рендер();"));

	Список.Добавить(Сборка.Образец("код — машинное значение моноширинным",
		"Холст = Кит.Холст();
		|Холст.Добавить(Кит.Код(""приложение установить отчёт""));
		|Холст.Добавить(Кит.Код(""Холст = Кит.Холст();"", ""блочный""));
		|
		|HTML = Холст.Рендер();"));

	Список.Добавить(Сборка.Образец("шаблон — фраза цельная, вставки собираются деревом",
		"Шаблон = Кит.Шаблон(""Проект %1 обновлён %2"");
		|Шаблон.Добавить(Кит.Код(""main""));
		|Шаблон.Добавить(Кит.Надпись(""приглушённая"").Добавить(Кит.Текст(""вчера"")).Родитель());
		|
		|HTML = Кит.Примечание().Добавить(Шаблон).Родитель().Рендер();"));

	// Разметкой, а не живьём: файла рядом со страницей витрины нет, и живой образец
	// показал бы значок битой картинки вместо того, о чём образец.
	Список.Добавить(Сборка.ОбразецРазметкой("картинка — внешний рисунок, Подпись() даёт alt",
		"Знак = Кит.Картинка(""/static/знак.svg"", ""значок"");
		|Знак.Подпись(""Знак проекта"");
		|Знак.Высота(32);
		|
		|HTML = Знак.Рендер();"));

	Список.Добавить(Сборка.Образец("готовое — ⚠ костыль перехода: узел ничего не экранирует",
		"HTML = Кит.Готовое(Набор.Тег().Отрисовать(""собрано строкой"")).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Компонент

Функция ОбразцыКомпонента()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("компонент печатает себя целиком и принимает детей",
		"Карточка = Кит.Карточка(Новый Структура(""Заголовок"", ""Проекты""));
		|Карточка.Добавить(Кит.Кнопка(Новый Структура(""Подпись, Вариант"",
		|	""Создать"", ""основная"")));
		|
		|HTML = Карточка.Рендер();"));

	Список.Добавить(Сборка.Образец("в дереве компонент виден по имени, а не куском HTML",
		"Карточка = Кит.Карточка(Новый Структура(""Заголовок"", ""Проекты""));
		|Карточка.Добавить(Кит.Кнопка(Новый Структура(""Подпись"", ""Создать"")));
		|
		|HTML = Кит.Код(Карточка.Дерево(), ""блочный"").Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Экран

Функция ОбразцыЭкрана()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("список объектов: шапка, таблица, карточки, действие",
		"Холст = Кит.Холст();
		|
		|Шапка = Холст.Добавить(Кит.Ряд(""выбор""));
		|Шапка.Добавить(Кит.Надпись(""название"")).Добавить(Кит.Текст(""Витрина""));
		|Шапка.Добавить(Кит.Надпись(""пояснение"")).Добавить(
		|	Кит.Текст(""холст, ряд, надпись, текст""));
		|
		|Таблица = Холст.Добавить(Кит.Таблица());
		|Таблица.Добавить(Кит.Колонка(""Имя""));
		|Таблица.Добавить(Кит.Запись()).Добавить(Кит.Ячейка()).Добавить(Кит.Код(""отчёт""));
		|
		|Карточка = Холст.Добавить(Кит.Область(""карточки"")).Добавить(Кит.Статья(""карточка""));
		|Карточка.Добавить(Кит.Заголовок(3, ""имя"")).Добавить(Кит.Текст(""объект""));
		|Карточка.Добавить(Кит.Примечание(""описание объекта"", ""описание""));
		|
		|Холст.Добавить(Кит.Кнопка(Новый Структура(""Подпись, Вариант"",
		|	""Действие"", ""основная"")));
		|
		|HTML = Холст.Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

// НЕ желудь: каталог образцов нужен только витрине и тесту кита.
//
// Параметры:
//  _Сборка - СборкаОбразцов - записи раздела и образца.
//
Процедура ПриСозданииОбъекта(Знач _Сборка) Экспорт

	Сборка = _Сборка;

КонецПроцедуры
