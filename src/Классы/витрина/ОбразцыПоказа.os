// Каталог образцов показа: таблица, тост, пустое состояние, пагинация, плитка, сетка,
// полоса заполнения, сводка, дерево галок. Здесь лежат ИСХОДНИКИ образцов — тот самый код, которым витрина
// их и рисует.

Перем Сборка;  // СборкаОбразцов

// Разделы витрины для компонентов показа.
//
// Возвращаемое значение:
//  Массив из Структура - Ключ, Заголовок, Словарь, Образцы (см. СборкаОбразцов).
//
Функция Разделы() Экспорт

	Результат = Новый Массив();

	Результат.Добавить(Сборка.Раздел("Таблица", "Таблица строкой",
		"", ОбразцыТаблицы()));
	Результат.Добавить(Сборка.Раздел("Тост", "Тост",
		"компонент:уведомление", ОбразцыТоста()));
	Результат.Добавить(Сборка.Раздел("ПустоеСостояние", "Пустое состояние",
		"компонент:пустое", ОбразцыПустоты()));
	Результат.Добавить(Сборка.Раздел("Пагинация", "Пагинация",
		"компонент:страницы", ОбразцыПагинации()));
	Результат.Добавить(Сборка.Раздел("Плитка", "Плитка показателя",
		"компонент:плитка", ОбразцыПлитки()));
	Результат.Добавить(Сборка.Раздел("Сетка", "Сетка",
		"компонент:сетка", ОбразцыСетки()));
	Результат.Добавить(Сборка.Раздел("ПолосаЗаполнения", "Полоса заполнения",
		"компонент:полоса", ОбразцыПолосыЗаполнения()));
	Результат.Добавить(Сборка.Раздел("Сводка", "Сводка",
		"компонент:сводка", ОбразцыСводки()));
	Результат.Добавить(Сборка.Раздел("ДеревоГалок", "Дерево галок",
		"компонент:дерево-галок", ОбразцыДереваГалок()));

	Возврат Результат;

КонецФункции

#Область Таблица

Функция ОбразцыТаблицы()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("шапка и строки",
		"Колонки = Новый Массив();
		|Колонки.Добавить(""Редакция"");
		|Колонки.Добавить(""Дата"");
		|
		|Первая = Новый Массив();
		|Первая.Добавить(""1.0.0"");
		|Первая.Добавить(""2026-07-29"");
		|
		|Строки = Новый Массив();
		|Строки.Добавить(Первая);
		|
		|HTML = Набор.Таблица().Отрисовать(Новый Структура(""Колонки, Строки"", Колонки, Строки));"));

	Список.Добавить(Сборка.Образец("пустая — вместо строк слова",
		"Колонки = Новый Массив();
		|Колонки.Добавить(""Редакция"");
		|
		|HTML = Набор.Таблица().Отрисовать(Новый Структура(""Колонки, Строки, Пусто"",
		|	Колонки, Новый Массив(), ""Редакций пока нет""));"));

	Список.Добавить(Сборка.Образец("карточками — на телефоне ячейка подписана колонкой",
		"Таблица = Кит.Таблица(""карточками"");
		|Таблица.Добавить(Кит.Колонка(""Редакция""));
		|Таблица.Добавить(Кит.Колонка(""Дата""));
		|Таблица.Добавить(Кит.Колонка(""Состояние"").БезПодписиВЗаписи());
		|Таблица.Добавить(Кит.Колонка(""Объём"").БезПодписиВЗаписи());
		|
		|Первая = Таблица.Добавить(Кит.Запись());
		|Первая.Добавить(Кит.Ячейка()).Добавить(Кит.Текст(""1.1.0""));
		|Первая.Добавить(Кит.Ячейка()).Добавить(Кит.Текст(""2026-07-29""));
		|Первая.Добавить(Кит.Ячейка()).Добавить(Кит.Плашка(""действует""));
		|Первая.Добавить(Кит.Ячейка(""величина"")).Добавить(Кит.Текст(""занято 12 КБ из 100""));
		|
		|Вторая = Таблица.Добавить(Кит.Запись());
		|Вторая.Добавить(Кит.Ячейка()).Добавить(Кит.Текст(""1.0.0""));
		|Вторая.Добавить(Кит.Ячейка());
		|Вторая.Добавить(Кит.Ячейка()).Добавить(Кит.Плашка(""снята""));
		|Вторая.Добавить(Кит.Ячейка(""величина"")).Добавить(Кит.Текст(""занято 9 КБ из 100""));
		|
		|HTML = Таблица.Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Тост

Функция ОбразцыТоста()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("успех",
		"HTML = Набор.Тост().Отрисовать(""Сохранено"");"));

	Список.Добавить(Сборка.Образец("предупреждение",
		"HTML = Набор.Тост().Отрисовать(Новый Структура(""Текст, Вид"",
		|	""Проект почти исчерпал лимит"", ""warn""));"));

	Список.Добавить(Сборка.Образец("ошибка",
		"HTML = Набор.Тост().Отрисовать(Новый Структура(""Текст, Вид"", ""Не сохранено"", ""err""));"));

	Список.Добавить(Сборка.Образец("сообщение с заголовком",
		"HTML = Набор.Тост().Отрисовать(Новый Структура(""Текст, Заголовок, Вид"",
		|	""Синхронизация запущена"", ""Синхронизация"", ""info""));"));

	Список.Добавить(Сборка.Образец("узлом дерева — уведомление",
		"HTML = Кит.Уведомление(Новый Структура(""Текст, Вид"", ""Сохранено"", ""ok"")).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область ПустоеСостояние

Функция ОбразцыПустоты()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("с призывом к действию",
		"HTML = Набор.ПустоеСостояние().Отрисовать(
		|	Новый Структура(""Заголовок, Пояснение, Иконка, Действие"",
		|		""В проекте пока нет документов"",
		|		""Создайте первый документ — он появится здесь сразу."",
		|		""куб"",
		|		Новый Структура(""Подпись, Адрес, Иконка"",
		|			""Как опубликовать"", ""/кабинет/публикация"", ""скачать"")));"));

	Список.Добавить(Сборка.Образец("только объяснение",
		"HTML = Набор.ПустоеСостояние().Отрисовать(""У этой редакции нет описания."");"));

	Список.Добавить(Сборка.Образец("компактное — для колонки",
		"HTML = Набор.ПустоеСостояние().Отрисовать(Новый Структура(""Пояснение, Компактное"",
		|	""Связей нет"", Истина));"));

	Список.Добавить(Сборка.Образец("узлом дерева",
		"HTML = Кит.ПустоеСостояние(Новый Структура(""Заголовок, Пояснение"",
		|	""Ничего не найдено"", ""Уточните отбор."")).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Пагинация

Функция ОбразцыПагинации()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("середина списка",
		"HTML = Набор.Пагинация().Отрисовать(Новый Структура(""Страница, ВсегоСтраниц, Основа"",
		|	3, 7, ""/документы""));"));

	Список.Добавить(Сборка.Образец("первая страница — без «назад»",
		"HTML = Набор.Пагинация().Отрисовать(Новый Структура(""Страница, ВсегоСтраниц, Основа"",
		|	1, 7, ""/документы""));"));

	Список.Добавить(Сборка.Образец("последняя страница — без «вперёд»",
		"HTML = Набор.Пагинация().Отрисовать(Новый Структура(""Страница, ВсегоСтраниц, Основа"",
		|	7, 7, ""/документы""));"));

	Список.Добавить(Сборка.Образец("с сохранением отбора",
		"Отбор = Новый Массив();
		|Отбор.Добавить(Новый Структура(""Имя, Значение"", ""q"", ""отчёт""));
		|
		|HTML = Набор.Пагинация().Отрисовать(
		|	Новый Структура(""Страница, ВсегоСтраниц, Основа, Параметры"",
		|		2, 4, ""/документы"", Отбор));"));

	Список.Добавить(Сборка.Образец("одна страница — навигации нет",
		"HTML = Набор.Пагинация().Отрисовать(Новый Структура(""Страница, ВсегоСтраниц, Основа"",
		|	1, 1, ""/документы""));"));

	Список.Добавить(Сборка.Образец("число страниц неизвестно, дальше есть",
		"HTML = Набор.Пагинация().Отрисовать(Новый Структура(""Страница, ЕстьСледующая, Основа"",
		|	1, Истина, ""/настройки/журнал""));"));

	Список.Добавить(Сборка.Образец("число страниц неизвестно, дальше пусто",
		"HTML = Набор.Пагинация().Отрисовать(Новый Структура(""Страница, ЕстьСледующая, Основа"",
		|	3, Ложь, ""/настройки/журнал""));"));

	Список.Добавить(Сборка.Образец("узлом дерева",
		"HTML = Кит.Пагинация(Новый Структура(""Страница, ВсегоСтраниц, Основа"",
		|	2, 5, ""/документы"")).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Плитка

Функция ОбразцыПлитки()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("кликабельная с пояснением",
		"HTML = Набор.Плитка().Отрисовать(
		|	Новый Структура(""Значение, Подпись, Пояснение, Адрес, Иконка"",
		|		""1 204"", ""документов"", ""во всех открытых проектах"", ""/документы"", ""куб""));"));

	Список.Добавить(Сборка.Образец("без ссылки",
		"HTML = Набор.Плитка().Отрисовать(Новый Структура(""Значение, Подпись"",
		|	""18"", ""проектов""));"));

	Виды = Новый Массив();
	Виды.Добавить("ok");
	Виды.Добавить("warn");
	Виды.Добавить("err");
	Виды.Добавить("accent");

	Для Каждого Вид Из Виды Цикл
		Список.Добавить(Сборка.Образец("вид: " + Вид, СтрШаблон(
			"HTML = Набор.Плитка().Отрисовать(Новый Структура(""Значение, Подпись, Вид"",
			|	""7"", ""проектов с источниками"", ""%1""));", Вид)));
	КонецЦикла;

	Список.Добавить(Сборка.Образец("узлом дерева",
		"HTML = Кит.Плитка(Новый Структура(""Значение, Подпись"", ""18"", ""проектов"")).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Сетка

Функция ОбразцыСетки()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("авто — плитки сводки",
		"Ячейки = Новый Массив();
		|Ячейки.Добавить(Набор.Плитка().Отрисовать(Новый Структура(""Значение, Подпись, Адрес"",
		|	""1 204"", ""документов"", ""/документы"")));
		|Ячейки.Добавить(Набор.Плитка().Отрисовать(Новый Структура(""Значение, Подпись"",
		|	""18"", ""проектов"")));
		|Ячейки.Добавить(Набор.Плитка().Отрисовать(Новый Структура(""Значение, Подпись"",
		|	""7"", ""проектов с источниками"")));
		|
		|HTML = Набор.Сетка().Отрисовать(Новый Структура(""Ячейки, Заголовок"", Ячейки, ""Сводка""));"));

	Список.Добавить(Сборка.Образец("две колонки — связи объекта",
		"Ячейки = Новый Массив();
		|Ячейки.Добавить(Набор.Карточка().Отрисовать(Новый Структура(""Заголовок, Тело"",
		|	""Ссылается на"", ""<p>отчёт, справочник</p>"")));
		|Ячейки.Добавить(Набор.Карточка().Отрисовать(Новый Структура(""Заголовок, Тело"",
		|	""Ссылаются сюда"", ""<p>сводка</p>"")));
		|
		|HTML = Набор.Сетка().Отрисовать(Новый Структура(""Ячейки, Колонки"", Ячейки, 2));"));

	Список.Добавить(Сборка.Образец("плотная — кнопки входа",
		"Ячейки = Новый Массив();
		|Ячейки.Добавить(Набор.Кнопка().Отрисовать(Новый Структура(""Подпись, Вариант, Адрес"",
		|	""Войти через провайдера 1"", ""вторичная"", ""/вход/провайдер-1"")));
		|Ячейки.Добавить(Набор.Кнопка().Отрисовать(Новый Структура(""Подпись, Вариант, Адрес"",
		|	""Войти через провайдера 2"", ""вторичная"", ""/вход/провайдер-2"")));
		|
		|HTML = Набор.Сетка().Отрисовать(Новый Структура(""Ячейки, Плотная"", Ячейки, Истина));"));

	Список.Добавить(Сборка.Образец("пустая — ничего",
		"HTML = Набор.Сетка().Отрисовать(Новый Структура(""Ячейки"", Новый Массив()));"));

	Список.Добавить(Сборка.Образец("узлом дерева — ячейки кладут детьми",
		"Сетка = Кит.Сетка(Новый Структура(""Колонки"", 2));
		|Сетка.Добавить(Кит.Примечание(""слева""));
		|Сетка.Добавить(Кит.Примечание(""справа""));
		|
		|HTML = Сетка.Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область ПолосаЗаполнения

Функция ОбразцыПолосыЗаполнения()

	Список = Новый Массив();
	Ступени = Новый Массив();
	Ступени.Добавить(Новый Структура("Процент, Подпись, Пояснение", 0, "0 из 1024 МБ", "пусто"));
	Ступени.Добавить(Новый Структура("Процент, Подпись, Пояснение",
		3, "31 из 1024 МБ", "просвет у малой доли"));
	Ступени.Добавить(Новый Структура("Процент, Подпись, Пояснение",
		42, "430 из 1024 МБ", "нейтральная"));
	Ступени.Добавить(Новый Структура("Процент, Подпись, Пояснение",
		78, "799 из 1024 МБ", "предупреждение с 75%"));
	Ступени.Добавить(Новый Структура("Процент, Подпись, Пояснение",
		94, "963 из 1024 МБ", "тревога с 90%"));
	Ступени.Добавить(Новый Структура("Процент, Подпись, Пояснение",
		137, "1403 из 1024 МБ", "переполнение"));

	Для Каждого Ступень Из Ступени Цикл
		Список.Добавить(Сборка.Образец(Ступень.Пояснение, СтрШаблон(
			"HTML = Набор.ПолосаЗаполнения().Отрисовать(
			|	Новый Структура(""Процент, Метка, Подпись"",
			|		%1, ""Заполнение хранилища"", ""%2""));",
			Формат(Ступень.Процент, "ЧН=0; ЧГ=0"), Ступень.Подпись)));
	КонецЦикла;

	Список.Добавить(Сборка.Образец("вид задан явно",
		"HTML = Набор.ПолосаЗаполнения().Отрисовать(
		|	Новый Структура(""Процент, Метка, Подпись, Вид"",
		|		42, ""Заполнение хранилища"", ""430 из 1024 МБ"", ""ok""));"));

	Список.Добавить(Сборка.Образец("компактная — для ячейки таблицы",
		"HTML = Набор.ПолосаЗаполнения().Отрисовать(
		|	Новый Структура(""Процент, Метка, Подпись, Компактная"",
		|		61, ""Заполнение хранилища"", ""625 из 1024 МБ"", Истина));"));

	Список.Добавить(Сборка.Образец("узлом дерева",
		"HTML = Кит.ПолосаЗаполнения(Новый Структура(""Процент, Метка, Подпись"",
		|	42, ""Заполнение хранилища"", ""430 из 1024 МБ"")).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Сводка

Функция ОбразцыСводки()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("название, подпись и сведения",
		"Сведения = Новый Массив();
		|Сведения.Добавить(Новый Структура(""Подпись, Значение"", ""Когда"", ""по будням в 9:00""));
		|Сведения.Добавить(Новый Структура(""Подпись, Значение"", ""Кому"", ""всем участникам""));
		|
		|HTML = Набор.Сводка().Отрисовать(Новый Структура(""Название, Подпись, Сведения"",
		|	""Утренняя рассылка"", ""почта · общий ящик"", Сведения));"));

	Список.Добавить(Сборка.Образец("знак состояния у названия, длинный перечень переносится в колонке значения",
		"Знаки = Новый Массив();
		|Знаки.Добавить(Новый Структура(""Текст, Вид"", ""выключена"", ""warn""));
		|
		|Подпись = Новый Массив();
		|Подпись.Добавить(""почта"");
		|Подпись.Добавить(""отдел продаж"");
		|
		|Сведения = Новый Массив();
		|Сведения.Добавить(Новый Структура(""Подпись, Значение"", ""Темы"",
		|	""Новые заказы, Отмены заказов, Возвраты, Жалобы клиентов, Отзывы, Сбои оплаты""));
		|Сведения.Добавить(Новый Структура(""Подпись, Значение, Вид"", ""Пропало"", ""Опросы"", ""warn""));
		|
		|HTML = Кит.Сводка(Новый Структура(""Название, Знаки, Подпись, Сведения"",
		|	""Вечерний отчёт"", Знаки, Подпись, Сведения)).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область ДеревоГалок

Функция ОбразцыДереваГалок()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("три состояния ветки: включена, частично, снята",
		"Север = Новый Массив();
		|Север.Добавить(Новый Структура(""Имя, Подпись"", ""город_1"", ""Архангельск""));
		|Север.Добавить(Новый Структура(""Имя, Подпись, Состояние"", ""город_2"", ""Мурманск"", ""выкл""));
		|
		|Юг = Новый Массив();
		|Юг.Добавить(Новый Структура(""Имя, Подпись"", ""город_3"", ""Краснодар""));
		|
		|Восток = Новый Массив();
		|Восток.Добавить(Новый Структура(""Имя, Подпись, Состояние, Отключён"", ""город_4"", ""Владивосток"", ""выкл"", Истина));
		|
		|Узлы = Новый Массив();
		|Узлы.Добавить(Новый Структура(""Имя, Подпись, Пояснение, Состояние, Дети, Открыт"",
		|	""край_1"", ""Север"", ""2 города, снят 1"", ""частично"", Север, Истина));
		|Узлы.Добавить(Новый Структура(""Имя, Подпись, Пояснение, Дети"", ""край_2"", ""Юг"", ""1 город"", Юг));
		|Узлы.Добавить(Новый Структура(""Имя, Подпись, Состояние, Дети, Открыт, Примечание"",
		|	""край_3"", ""Восток"", ""выкл"", Восток, Истина, ""Показан 1 из 40""));
		|
		|HTML = Набор.ДеревоГалок().Отрисовать(Новый Структура(""Подпись, Узлы"", ""Где работаем"", Узлы));"));

	Список.Добавить(Сборка.Образец("один уровень с плашками и данными для скрипта",
		"Данные = Новый Соответствие();
		|Данные.Вставить(""key"", ""город_1"");
		|
		|Признаки = Новый Массив();
		|Признаки.Добавить(""столица"");
		|
		|Узлы = Новый Массив();
		|Узлы.Добавить(Новый Структура(""Имя, Подпись, Признаки, Данные"", ""город_1"", ""Москва"", Признаки, Данные));
		|Узлы.Добавить(Новый Структура(""Имя, Подпись, Состояние"", ""город_2"", ""Тверь"", ""выкл""));
		|
		|HTML = Кит.ДеревоГалок(Новый Структура(""Узлы"", Узлы)).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

// НЕ желудь: каталог образцов нужен только витрине и тесту кита.
//
// Параметры:
//  _Сборка - СборкаОбразцов - записи раздела и образца.
//
Процедура ПриСозданииОбъекта(Знач _Сборка) Экспорт

	Сборка = _Сборка;

КонецПроцедуры
