// Каталог образцов, из которых складывается страница объекта: значок, кнопка, плашка,
// карточка, дерево разделов, проводник, вкладки, блок команды, шапка объекта, заголовок,
// страница отказа, меню строки, ряд меты. Здесь лежат ИСХОДНИКИ образцов — тот самый код,
// которым витрина их и рисует.

Перем Сборка;  // СборкаОбразцов

// Разделы витрины для компонентов страницы.
//
// Возвращаемое значение:
//  Массив из Структура - Ключ, Заголовок, Словарь, Образцы (см. СборкаОбразцов).
//
Функция Разделы() Экспорт

	Результат = Новый Массив();

	Результат.Добавить(Сборка.Раздел("Иконка", "Иконка",
		"компонент:иконка", ОбразцыИконки()));
	Результат.Добавить(Сборка.Раздел("Кнопка", "Кнопка",
		"компонент:кнопка", ОбразцыКнопки()));
	Результат.Добавить(Сборка.Раздел("Тег", "Тег (Плашка)",
		"компонент:плашка, компонент:плашки", ОбразцыПлашки()));
	Результат.Добавить(Сборка.Раздел("Карточка", "Карточка",
		"компонент:карточка", ОбразцыКарточки()));
	Результат.Добавить(Сборка.Раздел("ДеревоРазделов", "Дерево разделов",
		"компонент:разделы", ОбразцыДерева()));
	Результат.Добавить(Сборка.Раздел("Проводник", "Проводник",
		"компонент:шаги", ОбразцыПроводника()));
	Результат.Добавить(Сборка.Раздел("Табы", "Табы",
		"компонент:вкладки", ОбразцыТабов()));
	Результат.Добавить(Сборка.Раздел("БлокКоманды", "Блок команды",
		"компонент:команда", ОбразцыБлокаКоманды()));
	Результат.Добавить(Сборка.Раздел("ШапкаОбъекта", "Шапка объекта",
		"компонент:шапка", ОбразцыШапки()));
	Результат.Добавить(Сборка.Раздел("ЗаголовокСтраницы", "Заголовок страницы",
		"компонент:заглавие", ОбразцыЗаголовка()));
	Результат.Добавить(Сборка.Раздел("СтраницаОшибки", "Страница ошибки",
		"компонент:отказ", ОбразцыСтраницыОшибки()));
	Результат.Добавить(Сборка.Раздел("Меню", "Меню строки и учётки",
		"компонент:меню", ОбразцыМеню()));
	Результат.Добавить(Сборка.Раздел("РядМеты", "Ряд меты",
		"компонент:мета", ОбразцыРядаМеты()));

	Возврат Результат;

КонецФункции

#Область Иконка

Функция ОбразцыИконки()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("декоративная",
		"HTML = Набор.Иконка().Отрисовать(""куб"");"));

	Список.Добавить(Сборка.Образец("с подписью для скринридера",
		"HTML = Набор.Иконка().Отрисовать(Новый Структура(""Имя, Подпись"",
		|	""ключ"", ""ключ подписи""));"));

	Список.Добавить(Сборка.Образец("неизвестное имя — пусто",
		"HTML = Набор.Иконка().Отрисовать(""такой-иконки-нет"");"));

	Список.Добавить(Сборка.Образец("узлом дерева",
		"HTML = Кит.Иконка(""куб"").Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Кнопка

Функция ОбразцыКнопки()

	Список = Новый Массив();
	Виды = Новый Массив();
	Виды.Добавить("основная");
	Виды.Добавить("вторичная");
	Виды.Добавить("опасная");
	Виды.Добавить("ссылка");

	Для Каждого Вид Из Виды Цикл
		Список.Добавить(Сборка.Образец(Вид, СтрШаблон(
			"HTML = Набор.Кнопка().Отрисовать(Новый Структура(""Подпись, Вариант, Иконка"",
			|	""Сохранить"", ""%1"", ""сохранить""));", Вид)));
	КонецЦикла;

	Список.Добавить(Сборка.Образец("размер: малый",
		"HTML = Набор.Кнопка().Отрисовать(Новый Структура(""Подпись, Размер"",
		|	""Малая"", ""малый""));"));

	Список.Добавить(Сборка.Образец("размер: большой",
		"HTML = Набор.Кнопка().Отрисовать(Новый Структура(""Подпись, Размер"",
		|	""Большая"", ""большой""));"));

	Список.Добавить(Сборка.Образец("во всю ширину",
		"HTML = Набор.Кнопка().Отрисовать(Новый Структура(""Подпись, ВоВсюШирину"",
		|	""Во всю ширину"", Истина));"));

	Список.Добавить(Сборка.Образец("ссылка-кнопка",
		"HTML = Набор.Кнопка().Отрисовать(Новый Структура(""Подпись, Адрес, Иконка"",
		|	""Открыть список"", ""/документы"", ""вправо""));"));

	Список.Добавить(Сборка.Образец("заблокирована",
		"HTML = Набор.Кнопка().Отрисовать(Новый Структура(""Подпись, Заблокирована"",
		|	""Нельзя"", Истина));"));

	Список.Добавить(Сборка.Образец("занята",
		"HTML = Набор.Кнопка().Отрисовать(Новый Структура(""Подпись, Занята"",
		|	""Сохраняется"", Истина));"));

	Список.Добавить(Сборка.Образец("только иконка — переключатель темы",
		"HTML = Набор.Кнопка().Отрисовать(
		|	Новый Структура(""Подпись, Вариант, Размер, Иконка, ТолькоИконка"",
		|		""Переключить тему"", ""ссылка"", ""малый"", ""луна"", Истина));"));

	Список.Добавить(Сборка.Образец("заблокированная ссылка-кнопка",
		"HTML = Набор.Кнопка().Отрисовать(Новый Структура(""Подпись, Адрес, Заблокирована"",
		|	""Недоступно"", ""/документы"", Истина));"));

	Список.Добавить(Сборка.Образец("узлом дерева",
		"HTML = Кит.Кнопка(Новый Структура(""Подпись, Вариант"",
		|	""Сохранить"", ""основная"")).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Тег

Функция ОбразцыПлашки()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("нейтральная",
		"HTML = Набор.Тег().Отрисовать(""черновик"");"));

	Виды = Новый Массив();
	Виды.Добавить(Новый Структура("Текст, Вид", "готово", "ok"));
	Виды.Добавить(Новый Структура("Текст, Вид", "устаревший", "warn"));
	Виды.Добавить(Новый Структура("Текст, Вид", "отозвано", "err"));
	Виды.Добавить(Новый Структура("Текст, Вид", "текущее", "accent"));

	Для Каждого Плашка Из Виды Цикл
		Список.Добавить(Сборка.Образец("вид: " + Плашка.Вид, СтрШаблон(
			"HTML = Набор.Тег().Отрисовать(Новый Структура(""Текст, Вид"", ""%1"", ""%2""));",
			Плашка.Текст, Плашка.Вид)));
	КонецЦикла;

	Список.Добавить(Сборка.Образец("ссылка с иконкой",
		"HTML = Набор.Тег().Отрисовать(Новый Структура(""Текст, Адрес, Иконка"",
		|	""внешний"", ""/проекты"", ""тег""));"));

	Список.Добавить(Сборка.Образец("с крестиком снятия — кнопка живёт ВНУТРИ плашки",
		"Крестик = Набор.Кнопка().Отрисовать(
		|	Новый Структура(""Подпись, Вариант, Размер, Иконка, ТолькоИконка"",
		|		""Снять метку"", ""ссылка"", ""малый"", ""закрыть"", Истина));
		|
		|HTML = Набор.Тег().Отрисовать(Новый Структура(""Текст, Вид, Действие"",
		|	""избранное"", ""accent"", Крестик));"));

	Список.Добавить(Сборка.Образец("ряд плашек — один элемент разметки",
		"Плашки = Новый Массив();
		|Плашки.Добавить(Новый Структура(""Текст, Вид"", ""Основное"", ""accent""));
		|Плашки.Добавить(Новый Структура(""Текст, Вид"", ""Открытое"", ""ok""));
		|
		|HTML = Набор.Тег().Ряд(Плашки);"));

	Список.Добавить(Сборка.Образец("узлом дерева",
		"HTML = Кит.Плашка(Новый Структура(""Текст, Вид"", ""свежий"", ""ok"")).Рендер();"));

	Список.Добавить(Сборка.Образец("рядом плашек узлом дерева",
		"Плашки = Новый Массив();
		|Плашки.Добавить(Новый Структура(""Текст, Вид"", ""Основное"", ""accent""));
		|Плашки.Добавить(Новый Структура(""Текст"", ""Открытое""));
		|
		|HTML = Кит.РядПлашек(Плашки).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Карточка

Функция ОбразцыКарточки()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("заголовок, описание, тело",
		"HTML = Набор.Карточка().Отрисовать(Новый Структура(""Заголовок, Описание, Тело, Иконка"",
		|	""Проект «Альфа»"", ""Проект по умолчанию"", ""<p>тело карточки</p>"", ""куб""));"));

	Список.Добавить(Сборка.Образец("с полосой действий",
		"HTML = Набор.Карточка().Отрисовать(Новый Структура(""Заголовок, Тело, Действия"",
		|	""С действиями"", ""<p>тело</p>"", Набор.Кнопка().Отрисовать(""Применить"")));"));

	Список.Добавить(Сборка.Образец("без заголовка",
		"HTML = Набор.Карточка().Отрисовать(Новый Структура(""Тело"", ""<p>только тело</p>""));"));

	Список.Добавить(Сборка.Образец("узлом дерева — тело кладут детьми",
		"Карточка = Кит.Карточка(Новый Структура(""Заголовок"", ""Проекты""));
		|Карточка.Добавить(Кит.Примечание(""две штуки""));
		|
		|HTML = Карточка.Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область ДеревоРазделов

Функция ОбразцыДерева()

	Разделы = "Дети = Новый Массив();
		|Дети.Добавить(Новый Структура(""Подпись, Адрес"", ""Метки"", ""/настройки/метки""));
		|
		|Разделы = Новый Массив();
		|Разделы.Добавить(Новый Структура(""Подпись, Адрес, Активен, Иконка"",
		|	""Общие"", ""/настройки"", Истина, ""шестерёнка""));
		|Разделы.Добавить(Новый Структура(""Подпись, Адрес, Дети"",
		|	""Доступ"", ""/настройки/доступ"", Дети));
		|";

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("вертикаль — дом настроек", Разделы
		+ "
		|HTML = Набор.ДеревоРазделов().Отрисовать(Новый Структура(""Заголовок, Разделы"",
		|	""Настройки проекта"", Разделы));"));

	Список.Добавить(Сборка.Образец("горизонталь — шапка", Разделы
		+ "
		|HTML = Набор.ДеревоРазделов().Отрисовать(
		|	Новый Структура(""Заголовок, Разделы, Ориентация"",
		|		""Основная навигация"", Разделы, ""горизонталь""));"));

	Список.Добавить(Сборка.Образец("узлом дерева", Разделы
		+ "
		|HTML = Кит.ДеревоРазделов(Новый Структура(""Заголовок, Разделы"",
		|	""Настройки проекта"", Разделы)).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Проводник

Функция ОбразцыПроводника()

	Шаги = "Шаги = Новый Массив();
		|Шаги.Добавить(Новый Структура(""Заголовок, Пояснение, Выполнен, Текущий"",
		|	""Создать учётную запись"", ""Мастер закрывается после первой записи"", Истина, Ложь));
		|Шаги.Добавить(Новый Структура(""Заголовок, Выполнен, Текущий, Адрес, ПодписьСсылки"",
		|	""Выпустить ключ доступа"", Ложь, Истина, ""/кабинет/ключи"", ""Мои ключи""));
		|Шаги.Добавить(Новый Структура(""Заголовок, Выполнен, Текущий"",
		|	""Создать первый документ"", Ложь, Ложь));
		|";

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("шаги и прогресс", Шаги
		+ "
		|HTML = Набор.Проводник().Отрисовать(Новый Структура(""Шаги"", Шаги));"));

	Список.Добавить(Сборка.Образец("без шагов — заглушка",
		"HTML = Набор.Проводник().Отрисовать(Новый Структура(""Шаги, Пусто"",
		|	Новый Массив(), ""Шагов пока нет""));"));

	Список.Добавить(Сборка.Образец("узлом дерева", Шаги
		+ "
		|HTML = Кит.Проводник(Новый Структура(""Шаги"", Шаги)).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Табы

Функция ОбразцыТабов()

	Вкладки = "Вкладки = Новый Массив();
		|Вкладки.Добавить(Новый Структура(""Подпись, Адрес, Активна"",
		|	""Описание"", ""/документы/отчёт"", Истина));
		|Вкладки.Добавить(Новый Структура(""Подпись, Адрес, Счётчик"",
		|	""Редакции"", ""/документы/отчёт/редакции"", 12));
		|Вкладки.Добавить(Новый Структура(""Подпись, Адрес"", ""Связи"", ""/документы/отчёт/связи""));
		|";

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("вкладки страницы объекта", Вкладки
		+ "
		|HTML = Набор.Табы().Отрисовать(Новый Структура(""Вкладки, Заголовок"",
		|	Вкладки, ""Разделы объекта""));"));

	Список.Добавить(Сборка.Образец("пустой список — ничего",
		"HTML = Набор.Табы().Отрисовать(Новый Структура(""Вкладки"", Новый Массив()));"));

	Список.Добавить(Сборка.Образец("узлом дерева", Вкладки
		+ "
		|HTML = Кит.Табы(Новый Структура(""Вкладки"", Вкладки)).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область БлокКоманды

Функция ОбразцыБлокаКоманды()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("команда с копированием",
		"HTML = Набор.БлокКоманды().Отрисовать(""приложение установить отчёт"");"));

	Список.Добавить(Сборка.Образец("с пояснением",
		"HTML = Набор.БлокКоманды().Отрисовать(Новый Структура(""Команда, Пояснение"",
		|	""приложение отправить отчёт-1.0.0"", ""Выполните в каталоге проекта:""));"));

	Список.Добавить(Сборка.Образец("без кнопки копирования",
		"HTML = Набор.БлокКоманды().Отрисовать(Новый Структура(""Команда, БезКопирования"",
		|	""приложение установить отчёт"", Истина));"));

	Список.Добавить(Сборка.Образец("узлом дерева",
		"HTML = Кит.БлокКоманды(""приложение установить отчёт"").Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область ШапкаОбъекта

Функция ОбразцыШапки()

	Заготовка = "Плашки = Новый Массив();
		|Плашки.Добавить(Новый Структура(""Текст, Вид"", ""внешний"", ""accent""));
		|Плашки.Добавить(Новый Структура(""Текст, Вид"", ""устаревший"", ""warn""));
		|
		|Мета = Новый Массив();
		|Мета.Добавить(Новый Структура(""Подпись, Значение, Значок"",
		|	""автор"", ""а.иванова"", ""аккаунт""));
		|Мета.Добавить(Новый Структура(""Подпись, Значение"", ""срок"", ""бессрочно""));
		|Мета.Добавить(Новый Структура(""Подпись, Адрес"",
		|	""источник"", ""https://пример.рф/источник""));
		|";

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("со значком, подписью и командой", Заготовка
		+ "
		|HTML = Набор.ШапкаОбъекта().Отрисовать(
		|	Новый Структура(""Имя, Вид, Иконка, Подпись, Описание, Плашки, Мета, Команда"",
		|		""отчёт"", ""document"", ""куб"", ""документ"", ""Сводный отчёт за период"",
		|		Плашки, Мета, ""приложение установить отчёт""));"));

	Список.Добавить(Сборка.Образец("другой объект — другой значок",
		"Плашки = Новый Массив();
		|Плашки.Добавить(Новый Структура(""Текст, Вид"", ""внешний"", ""accent""));
		|
		|HTML = Набор.ШапкаОбъекта().Отрисовать(
		|	Новый Структура(""Имя, Вид, Иконка, Подпись, Плашки"",
		|		""альфа"", ""project"", ""куб"", ""проект"", Плашки));"));

	Список.Добавить(Сборка.Образец("без значка и подписи",
		"Действия = Набор.Кнопка().Отрисовать(Новый Структура(""Подпись, Вариант, Иконка, Адрес"",
		|	""Настройки"", ""вторичная"", ""шестерёнка"", ""/настройки/проекты""));
		|
		|HTML = Набор.ШапкаОбъекта().Отрисовать(Новый Структура(""Имя, Действия"",
		|	""группа-разработки"", Действия));"));

	Список.Добавить(Сборка.Образец("узлом дерева — действия кладут детьми",
		"Шапка = Кит.ШапкаОбъекта(Новый Структура(""Имя, Подпись"", ""отчёт"", ""документ""));
		|Шапка.Добавить(Кит.Кнопка(Новый Структура(""Подпись, Вариант"",
		|	""Настройки"", ""вторичная"")));
		|
		|HTML = Шапка.Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область ЗаголовокСтраницы

Функция ОбразцыЗаголовка()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("h1 страницы",
		"HTML = Набор.ЗаголовокСтраницы().Отрисовать(""Управление проектами"");"));

	Список.Добавить(Сборка.Образец("h1 с пояснением",
		"HTML = Набор.ЗаголовокСтраницы().Отрисовать(Новый Структура(""Заголовок, Пояснение"",
		|	""Внешние источники"", ""Синхронизация чужих данных в это приложение""));"));

	Список.Добавить(Сборка.Образец("h2 блока",
		"HTML = Набор.ЗаголовокСтраницы().Отрисовать(Новый Структура(""Заголовок, Уровень"",
		|	""Документы проекта"", 2));"));

	Список.Добавить(Сборка.Образец("примечание отдельно",
		"HTML = Набор.ЗаголовокСтраницы().Примечание(
		|	""Ключ показывается один раз — сохраните его сразу."");"));

	Список.Добавить(Сборка.Образец("узлом дерева",
		"HTML = Кит.ЗаголовокСтраницы(Новый Структура(""Заголовок, Пояснение"",
		|	""Управление проектами"", ""Все проекты инсталляции"")).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область СтраницаОшибки

Функция ОбразцыСтраницыОшибки()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("404",
		"HTML = Набор.СтраницаОшибки().Отрисовать(Новый Структура(""Код, Сообщение"",
		|	404, ""Объект не найден""));"));

	Список.Добавить(Сборка.Образец("403 без пояснения",
		"HTML = Набор.СтраницаОшибки().Отрисовать(Новый Структура(""Код"", 403));"));

	Список.Добавить(Сборка.Образец("узлом дерева",
		"HTML = Кит.СтраницаОшибки(Новый Структура(""Код, Сообщение"",
		|	404, ""Объект не найден"")).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Меню

Функция ОбразцыМеню()

	Пункты = "Пункты = Новый Массив();
		|Пункты.Добавить(Новый Структура(""Подпись, Адрес, Иконка"",
		|	""Настройки"", ""/настройки"", ""шестерёнка""));
		|Пункты.Добавить(Новый Структура(""Подпись, Адрес, Иконка"",
		|	""Права"", ""/настройки/доступ"", ""замок""));
		|Пункты.Добавить(Новый Структура(""HTML"", Набор.Кнопка().Отрисовать(
		|	Новый Структура(""Подпись, Вариант, Размер"",
		|		""Сделать основным"", ""вторичная"", ""малый""))));
		|";

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("действия строки", Пункты
		+ "
		|HTML = Набор.Меню().Отрисовать(Новый Структура(""Подпись, Пункты"",
		|	""Меню строки «Альфа»"", Пункты));"));

	// Два меню подряд — образец соседства: идентификаторы связи у них разные, поэтому
	// кнопка каждого открывает СВОЮ панель, а не соседнюю.
	Список.Добавить(Сборка.Образец("соседнее меню — свой идентификатор", Пункты
		+ "
		|HTML = Набор.Меню().Отрисовать(Новый Структура(""Подпись, Пункты"",
		|	""Меню строки «Бета»"", Пункты));"));

	// Та же панель, но открывает её кнопка с именем: значок, имя текстом, счётчик
	// и шеврон раскрытия. Так меню стоит в шапке, а не в последней колонке таблицы.
	Список.Добавить(Сборка.Образец("учётка: имя, счётчик и шеврон раскрытия",
		"Пункты = Новый Массив();
		|Пункты.Добавить(Новый Структура(""Подпись, Адрес, Иконка"",
		|	""Кабинет"", ""/кабинет"", ""аккаунт""));
		|Пункты.Добавить(Новый Структура(""HTML"", Набор.Кнопка().Отрисовать(
		|	Новый Структура(""Подпись, Вариант, Размер, Иконка"",
		|		""Выйти"", ""ссылка"", ""малый"", ""выход""))));
		|
		|HTML = Набор.Меню().Отрисовать(Новый Структура(
		|	""Подпись, Аккаунт, Счётчик, ПодписьСчётчика, Пункты"",
		|	""Меню учётки"", ""а.иванова"", 3, ""3 непрочитанных"", Пункты));"));

	Список.Добавить(Сборка.Образец("узлом дерева", Пункты
		+ "
		|HTML = Кит.Меню(Новый Структура(""Подпись, Пункты"",
		|	""Меню строки «Гамма»"", Пункты)).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область РядМеты

Функция ОбразцыРядаМеты()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("со значками, второй элемент — ссылка",
		"Элементы = Новый Массив();
		|Элементы.Добавить(Новый Структура(""Подпись, Значение, Значок"",
		|	""Открытий"", ""1 204"", ""скачать""));
		|Элементы.Добавить(Новый Структура(""Подпись, Значение, Значок, Адрес"",
		|	""Автор"", ""а.иванова"", ""аккаунт"", ""/люди/а.иванова""));
		|
		|HTML = Набор.РядМеты().Отрисовать(Элементы, ""objhead__meta"", ""objhead__meta-item"");"));

	Список.Добавить(Сборка.Образец("без значка — пара «подпись: значение»",
		"Элементы = Новый Массив();
		|Элементы.Добавить(Новый Структура(""Подпись, Значение"", ""Обновлено"", ""вчера""));
		|
		|HTML = Набор.РядМеты().Отрисовать(Элементы, ""objhead__meta"", ""objhead__meta-item"");"));

	Список.Добавить(Сборка.Образец("пустой ряд не печатается вовсе",
		"HTML = Набор.РядМеты().Отрисовать(Новый Массив(),
		|	""objhead__meta"", ""objhead__meta-item"");"));

	Список.Добавить(Сборка.Образец("узлом дерева — классы даёт вид, а не вызывающий",
		"Элементы = Новый Массив();
		|Элементы.Добавить(Новый Структура(""Подпись, Значение"", ""Обновлён"", ""вчера""));
		|
		|HTML = Кит.РядМеты(Элементы, ""карточка"").Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

// НЕ желудь: каталог образцов нужен только витрине и тесту кита.
//
// Параметры:
//  _Сборка - СборкаОбразцов - записи раздела и образца.
//
Процедура ПриСозданииОбъекта(Знач _Сборка) Экспорт

	Сборка = _Сборка;

КонецПроцедуры
