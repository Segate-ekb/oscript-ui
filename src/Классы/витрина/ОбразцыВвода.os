// Каталог образцов ввода: поле, тумблер, поле из конфига, панель сохранения, опасная
// зона, скрытое поле, форма отбора. Здесь лежат ИСХОДНИКИ образцов — тот самый код,
// которым витрина их и рисует.

Перем Сборка;  // СборкаОбразцов

// Разделы витрины для компонентов ввода.
//
// Возвращаемое значение:
//  Массив из Структура - Ключ, Заголовок, Словарь, Образцы (см. СборкаОбразцов).
//
Функция Разделы() Экспорт

	Результат = Новый Массив();

	Результат.Добавить(Сборка.Раздел("Поле", "Поле формы",
		"компонент:поле", ОбразцыПоля()));
	Результат.Добавить(Сборка.Раздел("Тумблер", "Тумблер",
		"компонент:тумблер", ОбразцыТумблера()));
	Результат.Добавить(Сборка.Раздел("ПолеИзКонфига", "Поле из конфига",
		"компонент:поле-конфига", ОбразцыПоляКонфига()));
	Результат.Добавить(Сборка.Раздел("ПанельСохранения", "Панель сохранения",
		"компонент:панель", ОбразцыПанели()));
	Результат.Добавить(Сборка.Раздел("ОпаснаяЗона", "Опасная зона",
		"компонент:зона", ОбразцыОпаснойЗоны()));
	Результат.Добавить(Сборка.Раздел("СкрытоеПоле", "Скрытое поле",
		"компонент:скрытое", ОбразцыСкрытогоПоля()));
	Результат.Добавить(Сборка.Раздел("ФормаОтбора", "Форма отбора",
		"компонент:поиск", ОбразцыФормыОтбора()));

	Возврат Результат;

КонецФункции

#Область Поле

Функция ОбразцыПоля()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("текст",
		"HTML = Набор.Поле().Отрисовать(Новый Структура(""Имя, Метка, Значение, Подсказка"",
		|	""имя"", ""Имя проекта"", ""main"", ""латиница и дефис""));"));

	Список.Добавить(Сборка.Образец("пароль",
		"HTML = Набор.Поле().Отрисовать(Новый Структура(""Имя, Метка, Тип"",
		|	""пароль"", ""Пароль"", ""пароль""));"));

	Список.Добавить(Сборка.Образец("число",
		"HTML = Набор.Поле().Отрисовать(Новый Структура(""Имя, Метка, Тип, Значение"",
		|	""лимит"", ""Лимит, МБ"", ""число"", ""0""));"));

	Список.Добавить(Сборка.Образец("флажок",
		"HTML = Набор.Поле().Отрисовать(Новый Структура(""Имя, Метка, Тип, Отмечено"",
		|	""скрыт"", ""Скрыть из списка"", ""флажок"", Истина));"));

	Список.Добавить(Сборка.Образец("многострочное",
		"HTML = Набор.Поле().Отрисовать(Новый Структура(""Имя, Метка, Тип, Значение"",
		|	""описание"", ""Описание"", ""многострочное"", ""текст""));"));

	Список.Добавить(Сборка.Образец("выбор",
		"Варианты = Новый Массив();
		|Варианты.Добавить(Новый Структура(""Значение, Подпись"", ""локальный"", ""Локальный""));
		|Варианты.Добавить(Новый Структура(""Значение, Подпись"", ""внешний"", ""Внешний""));
		|
		|HTML = Набор.Поле().Отрисовать(Новый Структура(""Имя, Метка, Тип, Значение, Варианты"",
		|	""тип"", ""Тип проекта"", ""выбор"", ""внешний"", Варианты));"));

	Список.Добавить(Сборка.Образец("с ошибкой",
		"HTML = Набор.Поле().Отрисовать(Новый Структура(""Имя, Метка, Ошибка"",
		|	""имя"", ""Имя проекта"", ""Имя занято""));"));

	Список.Добавить(Сборка.Образец("заблокированное — витрина значения",
		"HTML = Набор.Поле().Отрисовать(Новый Структура(""Метка, Значение, Заблокировано"",
		|	""Каталог данных"", ""/var/lib/приложение"", Истина));"));

	Список.Добавить(Сборка.Образец("узлом дерева",
		"HTML = Кит.Поле(Новый Структура(""Имя, Метка, Значение"",
		|	""имя"", ""Имя проекта"", ""main"")).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область Тумблер

Функция ОбразцыТумблера()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("включён",
		"HTML = Набор.Тумблер().Отрисовать(
		|	Новый Структура(""Имя, Метка, Включено, ПодписьВкл, ПодписьВыкл"",
		|		""видимость"", ""Видимость проекта"", Истина, ""публичный"", ""приватный""));"));

	Список.Добавить(Сборка.Образец("выключен",
		"HTML = Набор.Тумблер().Отрисовать(
		|	Новый Структура(""Имя, Метка, Включено, ПодписьВкл, ПодписьВыкл"",
		|		""видимость"", ""Видимость проекта"", Ложь, ""публичный"", ""приватный""));"));

	Список.Добавить(Сборка.Образец("заблокирован",
		"HTML = Набор.Тумблер().Отрисовать(Новый Структура(""Метка, Включено, Заблокировано"",
		|	""Внешние источники"", Ложь, Истина));"));

	Список.Добавить(Сборка.Образец("узлом дерева",
		"HTML = Кит.Тумблер(Новый Структура(""Имя, Метка, Включено"",
		|	""видимость"", ""Видимость проекта"", Истина)).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область ПолеИзКонфига

Функция ОбразцыПоляКонфига()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("значение из детальки",
		"HTML = Набор.ПолеИзКонфига().Отрисовать(
		|	Новый Структура(""Метка, Значение, Деталька, Переменная"",
		|		""Каталог данных"", ""/var/lib/приложение"",
		|		""app.storage.root"", ""APP_STORAGE_ROOT""));"));

	Список.Добавить(Сборка.Образец("секрет",
		"HTML = Набор.ПолеИзКонфига().Отрисовать(
		|	Новый Структура(""Метка, Значение, Деталька, Переменная, Секрет"",
		|		""Пароль админа"", ""s3cret"",
		|		""app.admin.password"", ""APP_ADMIN_PASSWORD"", Истина));"));

	Список.Добавить(Сборка.Образец("узлом дерева",
		"HTML = Кит.ПолеИзКонфига(Новый Структура(""Метка, Значение, Деталька"",
		|	""Каталог данных"", ""/var/lib/приложение"", ""app.storage.root"")).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область ПанельСохранения

Функция ОбразцыПанели()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("сохранение",
		"HTML = Набор.ПанельСохранения().Отрисовать(
		|	Новый Структура(""Подпись, Пояснение, АдресОтмены"",
		|		""Сохранить"", ""Есть несохранённые изменения"", ""/настройки""));"));

	Список.Добавить(Сборка.Образец("опасное действие",
		"HTML = Набор.ПанельСохранения().Отрисовать(
		|	Новый Структура(""Подпись, Опасное"", ""Удалить проект"", Истина));"));

	Список.Добавить(Сборка.Образец("заблокирована",
		"HTML = Набор.ПанельСохранения().Отрисовать(
		|	Новый Структура(""Подпись, Заблокирована"", ""Сохранить"", Истина));"));

	Список.Добавить(Сборка.Образец("узлом дерева",
		"HTML = Кит.ПанельСохранения(Новый Структура(""Подпись"", ""Сохранить"")).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область ОпаснаяЗона

Функция ОбразцыОпаснойЗоны()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("удаление проекта",
		"HTML = Набор.ОпаснаяЗона().Отрисовать(
		|	Новый Структура(""Заголовок, Пояснение, Подтверждение"",
		|		""Удаление проекта"",
		|		""Проект и все его документы будут удалены безвозвратно. Отменить это нельзя."",
		|		Новый Структура(""Имя, Образец, Подсказка"",
		|			""подтверждение"", ""main"",
		|			""Введите имя проекта ровно так, как оно написано выше"")));"));

	Список.Добавить(Сборка.Образец("своя кнопка — вид навязан опасным",
		"HTML = Набор.ОпаснаяЗона().Отрисовать(
		|	Новый Структура(""Заголовок, Подтверждение, Кнопка"",
		|		""Отзыв публикации"",
		|		Новый Структура(""Имя, Образец"", ""подтверждение"", ""1.0.0""),
		|		Новый Структура(""Подпись, Иконка"", ""Отозвать публикацию"", ""закрыть"")));"));

	Список.Добавить(Сборка.Образец("узлом дерева — тело кладут детьми",
		"Зона = Кит.ОпаснаяЗона(Новый Структура(""Заголовок, Подтверждение"",
		|	""Удаление проекта"", Новый Структура(""Имя, Образец"", ""подтверждение"", ""main"")));
		|Зона.Добавить(Кит.Примечание(""Отменить это нельзя.""));
		|
		|HTML = Зона.Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область СкрытоеПоле

Функция ОбразцыСкрытогоПоля()

	Список = Новый Массив();

	Список.Добавить(Сборка.ОбразецРазметкой("имя и значение",
		"HTML = Набор.СкрытоеПоле().Отрисовать(
		|	Новый Структура(""Имя, Значение"", ""проект"", ""main""));"));

	Список.Добавить(Сборка.ОбразецРазметкой("пустое значение — сброс признака",
		"HTML = Набор.СкрытоеПоле().Отрисовать(Новый Структура(""Имя"", ""включить""));"));

	Список.Добавить(Сборка.ОбразецРазметкой("узлом дерева",
		"HTML = Кит.СкрытоеПоле(""проект"", ""main"").Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

#Область ФормаОтбора

Функция ОбразцыФормыОтбора()

	Список = Новый Массив();

	Список.Добавить(Сборка.Образец("поле и кнопка",
		"HTML = Набор.ФормаОтбора().Отрисовать(Новый Структура(""Действие, Метка, Кнопка"",
		|	""/настройки/проекты"", ""Отбор по имени проекта"", ""Отобрать""));"));

	Список.Добавить(Сборка.Образец("с сохранением GET-отбора",
		"Скрытые = Новый Массив();
		|Скрытые.Добавить(Новый Структура(""Имя, Значение"", ""проект"", ""main""));
		|
		|HTML = Набор.ФормаОтбора().Отрисовать(
		|	Новый Структура(""Действие, Метка, Значение, Плейсхолдер, Кнопка, Иконка, СкрытыеПоля"",
		|		""/документы"", ""Поиск"", ""отчёт"", ""Имя документа или его часть"",
		|		""Найти"", ""поиск"", Скрытые));"));

	Список.Добавить(Сборка.Образец("несколько полей отбора",
		"Варианты = Новый Массив();
		|Варианты.Добавить(Новый Структура(""Значение, Подпись"", """", ""Все события""));
		|Варианты.Добавить(Новый Структура(""Значение, Подпись"", ""доступ.выдан"", ""Доступ: выдан""));
		|
		|Поля = Новый Массив();
		|Поля.Добавить(Новый Структура(""Имя, Метка, Тип, Варианты"",
		|	""type"", ""Событие"", ""выбор"", Варианты));
		|Поля.Добавить(Новый Структура(""Имя, Метка, Плейсхолдер"", ""who"", ""Кто"", ""Логин""));
		|Поля.Добавить(Новый Структура(""Имя, Метка, Тип"", ""since"", ""С даты (UTC)"", ""date""));
		|
		|HTML = Набор.ФормаОтбора().Отрисовать(Новый Структура(""Действие, Кнопка, Иконка, Поля"",
		|	""/настройки/журнал"", ""Показать"", ""поиск"", Поля));"));

	Список.Добавить(Сборка.Образец("узлом дерева — строка поиска",
		"HTML = Кит.СтрокаПоиска(Новый Структура(""Действие, Метка, Кнопка"",
		|	""/документы"", ""Поиск"", ""Найти"")).Рендер();"));

	Возврат Список;

КонецФункции

#КонецОбласти

// НЕ желудь: каталог образцов нужен только витрине и тесту кита.
//
// Параметры:
//  _Сборка - СборкаОбразцов - записи раздела и образца.
//
Процедура ПриСозданииОбъекта(Знач _Сборка) Экспорт

	Сборка = _Сборка;

КонецПроцедуры
