// Компонент «Заголовок страницы» — желудь UI-кита: <h1>/<h2> плюс абзац-пояснение.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели

// Отрисовывает заголовок страницы или блока с необязательным пояснением.
//
// Параметры:
//  Модель - Структура, Строка - текст заголовка либо структура: Заголовок (обязателен,
//           экранируется), Уровень (1 либо 2), Пояснение (сырой текст, экранируется),
//           ПояснениеHTML (ДОВЕРЕННАЯ разметка, задаётся вместо Пояснение).
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент. Кидается исключением, если Заголовок пуст.
//
Функция Отрисовать(Знач Модель) Экспорт

	Если ТипЗнч(Модель) <> Тип("Структура") Тогда
		Модель = Новый Структура("Заголовок", ?(Модель = Неопределено, "", Строка(Модель)));
	КонецЕсли;

	Заголовок = Модели.Текст(Модель, "Заголовок");
	Если НЕ ЗначениеЗаполнено(Заголовок) Тогда
		ВызватьИсключение "Заголовок страницы: в модели не заполнен Заголовок —"
			+ " пустой <h1> бессмыслен и для читателя, и для скринридера.";
	КонецЕсли;

	Возврат СтрШаблон("<%1>%2</%1>%3",
		ТегЗаголовка(Модель), Экран.Экранировать(Заголовок), Пояснение(Модель));

КонецФункции

// Отрисовывает абзац-пояснение «мелким шрифтом» без заголовка.
//
// Параметры:
//  Текст     - Строка - текст пояснения.
//  Доверенно - Булево - (необязательный, по умолчанию Ложь) Истина: Текст — ДОВЕРЕННАЯ
//              разметка, не экранировать.
//
// Возвращаемое значение:
//  Строка - <p class="muted">…</p> либо "" для пустого текста.
//
Функция Примечание(Знач Текст, Знач Доверенно = Ложь) Экспорт

	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("<p class=""muted"">%1</p>",
		?(Доверенно = Истина, Текст, Экран.Экранировать(Текст)));

КонецФункции

Функция ТегЗаголовка(Знач Модель)

	Уровень = Модели.Значение(Модель, "Уровень");

	Попытка
		Номер = ?(Уровень = Неопределено, 1, Число(Уровень));
	Исключение
		Номер = 1;
	КонецПопытки;

	Если Номер < 1 ИЛИ Номер > 2 Тогда
		Номер = 1;
	КонецЕсли;

	Возврат "h" + Формат(Номер, "ЧН=; ЧГ=0");

КонецФункции

Функция Пояснение(Знач Модель)

	Доверенное = Модели.Текст(Модель, "ПояснениеHTML");
	Если ЗначениеЗаполнено(Доверенное) Тогда
		Возврат Примечание(Доверенное, Истина);
	КонецЕсли;

	Возврат Примечание(Модели.Текст(Модель, "Пояснение"));

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели) Экспорт

	Экран = _Экран;
	Модели = _Модели;

КонецПроцедуры
