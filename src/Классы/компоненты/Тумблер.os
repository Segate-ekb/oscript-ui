// Компонент «Тумблер» — желудь UI-кита: поле выбора из двух состояний
// на <input type="checkbox"> с парным скрытым полем выключенного значения.
//
// ПОРЯДОК ПАРЫ НЕ ПРОИЗВОЛЕН: браузер не отправляет невыбранный checkbox вовсе,
// а РазборФормы берёт ПЕРВОЕ значение многозначного поля. Скрытое поле обязано идти
// ПОСЛЕ флажка: включено → "1&0" → 1; выключено → "0" → 0. Переставь — тумблер
// навсегда «выключен», и это не видно глазом.
//
// ЧИТАТЬ НА СЕРВЕРЕ только сравнением: РазборФормы.Флажок(Форма, Имя) либо
// Поле(Форма, Имя) = ЗначениеВкл. ЗначениеЗаполнено(Поле(…)) НЕПРИГОДНО: выключенный
// тумблер даёт явное "0", а ЗначениеЗаполнено("0") — Истина.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели

// Отрисовывает тумблер как фрагмент <div class="toggle">.
//
// Параметры:
//  Модель - Структура - Имя (атрибут name, обязательно, кроме заблокированного),
//           Метка, Включено, ЗначениеВкл ("1"), ЗначениеВыкл ("0"), ПодписьВкл,
//           ПодписьВыкл, Подсказка, Заблокировано (только показ, скрытого поля нет),
//           СохранятьСразу (переключение само отправляет форму тумблера: у формы
//           БезПерезагрузки() — в фоне, без перезагрузки страницы. Кнопку сохранения
//           форме всё равно оставьте: без скрипта отправить её больше нечем).
//           Источник — откуда взялось значение («по умолчанию · mail.enabled»): мелкая
//           надпись справа в строке подсказки, как у поля. Справка — длинное пояснение:
//           значок «?» рядом с тумблером открывает поповер, тумблер ссылается на него
//           aria-describedby. Без Источника и Справки разметка прежняя.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент. Кидается исключением, если у активного тумблера нет Имени.
//
Функция Отрисовать(Знач Модель) Экспорт

	Имя = Модели.Текст(Модель, "Имя");
	Заблокировано = Модели.Флаг(Модель, "Заблокировано");
	ПроверитьИмя(Модель, Имя, Заблокировано);

	Включено = Модели.Флаг(Модель, "Включено");
	ЗначениеВкл = Модели.Текст(Модель, "ЗначениеВкл", "1");
	ЗначениеВыкл = Модели.Текст(Модель, "ЗначениеВыкл", "0");
	Метка = Модели.Текст(Модель, "Метка");
	Подсказка = Модели.Текст(Модель, "Подсказка");

	Справка = Модели.Текст(Модель, "Справка");
	ИдСправки = ?(ЗначениеЗаполнено(Справка), "help-" + Имя, "");

	Флажок = СтрШаблон("<input type=""checkbox"" class=""toggle__input""%1%2%3%4%5%6>",
		Экран.Атрибут("name", Имя),
		Экран.Атрибут("value", ЗначениеВкл),
		Экран.БулевАтрибут("checked", Включено),
		Экран.БулевАтрибут("disabled", Заблокировано),
		Экран.БулевАтрибут("data-autosubmit", Модели.Флаг(Модель, "СохранятьСразу")),
		?(ЗначениеЗаполнено(ИдСправки), Экран.Атрибут("aria-describedby", ИдСправки), ""));

	Дорожка = "<span class=""toggle__track"" aria-hidden=""true""><span class=""toggle__thumb""></span></span>";

	Текст = "";
	Если ЗначениеЗаполнено(Метка) Тогда
		Текст = Текст + СтрШаблон("<span class=""toggle__label"">%1</span>", Экран.Экранировать(Метка));
	КонецЕсли;
	Состояние = Состояние(Модель, Включено);
	Если ЗначениеЗаполнено(Состояние) Тогда
		Текст = Текст + СтрШаблон("<span class=""toggle__state"">%1</span>", Экран.Экранировать(Состояние));
	КонецЕсли;

	Результат = СтрШаблон("<label class=""toggle__box"">%1%2%3</label>",
		Флажок, Дорожка, ?(ЗначениеЗаполнено(Текст), "<span class=""toggle__text"">" + Текст + "</span>", ""));

	// см. шапку класса: скрытое поле ТОЛЬКО после флажка
	Если НЕ Заблокировано Тогда
		Результат = Результат + СтрШаблон("<input type=""hidden""%1%2>",
			Экран.Атрибут("name", Имя), Экран.Атрибут("value", ЗначениеВыкл));
	КонецЕсли;

	Источник = Модели.Текст(Модель, "Источник");
	Если ЗначениеЗаполнено(Источник) Тогда
		// источник — справка о значении, мелко справа в строке подсказки, как у поля: прежде
		// приложения печатали его своим абзацем крупнее самой подсказки
		Результат = Результат + СтрШаблон("<span class=""toggle__hint toggle__hint--origin"">%1"
				+ "<span class=""field__origin"">%2</span></span>",
			Экран.Экранировать(Подсказка), Экран.Экранировать(Источник));
	ИначеЕсли ЗначениеЗаполнено(Подсказка) Тогда
		Результат = Результат + СтрШаблон("<span class=""toggle__hint"">%1</span>",
			Экран.Экранировать(Подсказка));
	КонецЕсли;

	Результат = СтрШаблон("<div class=""toggle"">%1</div>", Результат);
	Если ЗначениеЗаполнено(Справка) Тогда
		Результат = СоСправкой(Результат, ИдСправки, Справка);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Значок «?» и поповер рядом с тумблером — та же пара, что у поля (ПолеФормы.СправкаПоля)
// и узла Кит.Подсказка (холст/Подсказка.os): меняйте все три. Пара стоит ВНЕ <label>
// тумблера: кнопка внутри метки стала бы вторым управляемым элементом в ней.
Функция СоСправкой(Знач Тумблер_, Знач ИдСправки, Знач Справка)

	Возврат СтрШаблон("<div class=""field-help"">%1<button type=""button"" class=""help"""
		+ " popovertarget=""%2""><span class=""help__mark"">?</span></button>"
		+ "<span class=""help__pop"" id=""%2"" popover>%3</span></div>",
		Тумблер_, Экран.Экранировать(ИдСправки), Экран.Экранировать(Справка));

КонецФункции

Функция Состояние(Знач Модель, Знач Включено)
	Возврат ?(Включено, Модели.Текст(Модель, "ПодписьВкл"), Модели.Текст(Модель, "ПодписьВыкл"));
КонецФункции

Процедура ПроверитьИмя(Знач Модель, Знач Имя, Знач Заблокировано)

	Если ЗначениеЗаполнено(Имя) ИЛИ Заблокировано Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Компонент «Тумблер»: не задано Имя (атрибут name) для тумблера «%1» — браузер не"
		+ " отправит его состояние. Задайте Имя либо пометьте тумблер Заблокировано, если"
		+ " он только для показа.",
		Модели.Текст(Модель, "Метка", "без метки"));

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели) Экспорт

	Экран = _Экран;
	Модели = _Модели;

КонецПроцедуры
