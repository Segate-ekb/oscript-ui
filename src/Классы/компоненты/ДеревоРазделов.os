// Компонент «Дерево разделов» — желудь UI-кита: навигация внутри объекта.
// Каждый раздел — обычная ссылка, раскрытие активной ветки делает сервер (поле Активен).
// Длинный список читается рубриками (поле Рубрика), а опасный раздел стоит последним
// и цветом ошибки (поле Опасный): порядок рубрик и опасного раздела решает этот компонент,
// и единое меню печатает разделы экрана в том же порядке (ПунктыПоПорядку).

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Значки;  // Иконка

// Отрисовывает дерево разделов.
//
// Параметры:
//  Модель - Структура - Заголовок (aria-label, "Разделы"), Разделы (массив структур
//           Подпись, Адрес, Активен, Иконка, Рубрика (подпись над первым разделом с этим
//           именем рубрики; в горизонтали не печатается), Опасный (раздел цветом ошибки,
//           всегда последним и без рубрики), Дети — вложенные разделы той же формы),
//           Класс, Ориентация ("вертикаль" | "горизонталь").
//
// Возвращаемое значение:
//  Строка - фрагмент <nav class="tree"> либо "" для пустого списка разделов.
//
Функция Отрисовать(Знач Модель) Экспорт

	Разделы = Модели.Список(Модель, "Разделы");
	Если Разделы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Класс = Модели.Текст(Модель, "Класс");
	Ориентация = НРег(Модели.Текст(Модель, "Ориентация", "вертикаль"));

	Классы = "tree tree--" + ?(Ориентация = "горизонталь", "row", "column")
		+ ?(ЗначениеЗаполнено(Класс), " " + Класс, "");

	Возврат СтрШаблон("<nav%1%2>%3</nav>",
		Экран.Атрибут("class", Классы),
		Экран.Атрибут("aria-label", Модели.Текст(Модель, "Заголовок", "Разделы")),
		Ветка(Разделы, 0, Ориентация <> "горизонталь"));

КонецФункции

// Разделы в порядке печати и подписи рубрик над ними. Рубрика печатается над ПЕРВЫМ
// разделом со своим именем: разделы не переставляются, поэтому порядок, который выбрал
// дом, сохраняется. Опасные разделы уходят в конец и рубрики не получают: необратимое
// не должно стоять между «Метками» и «Тегами», и под чужой рубрикой ему тоже не место.
//
// Параметры:
//  Разделы - Массив из Структура - разделы одного уровня, см. Отрисовать.
//
// Возвращаемое значение:
//  Массив из Структура - Раздел (структура раздела как пришла), Рубрика (подпись, которую
//                        печатать над ним; "" — не печатать).
//
Функция ПунктыПоПорядку(Знач Разделы) Экспорт

	Результат = Новый Массив();
	Опасные = Новый Массив();
	Встреченные = Новый Соответствие();

	Для Каждого Раздел Из Разделы Цикл

		Если Модели.Флаг(Раздел, "Опасный") Тогда
			Опасные.Добавить(Раздел);
			Продолжить;
		КонецЕсли;

		Рубрика = СокрЛП(Модели.Текст(Раздел, "Рубрика"));
		Если Встреченные.Получить(Рубрика) <> Неопределено Тогда
			Рубрика = "";
		ИначеЕсли ЗначениеЗаполнено(Рубрика) Тогда
			Встреченные.Вставить(Рубрика, Истина);
		КонецЕсли;

		Результат.Добавить(Новый Структура("Раздел, Рубрика", Раздел, Рубрика));

	КонецЦикла;

	Для Каждого Раздел Из Опасные Цикл
		Результат.Добавить(Новый Структура("Раздел, Рубрика", Раздел, ""));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Предельная глубина вложенности разделов — страховка от бесконечной рекурсии:
// модель приходит извне, и раздел может оказаться в собственных «Детях».
//
// Возвращаемое значение:
//  Число
//
Функция ПредельнаяГлубина() Экспорт
	Возврат 4;
КонецФункции

// Рубрики печатаются только колонкой: в ряду шапки подпись между ходами читалась бы
// ещё одним ходом, по которому нельзя перейти.
Функция Ветка(Знач Разделы, Знач Глубина, Знач СРубриками)

	Если Глубина >= ПредельнаяГлубина() Тогда
		Возврат "";
	КонецЕсли;

	Пункты = "";

	Для Каждого Пункт Из ПунктыПоПорядку(Разделы) Цикл

		Раздел = Пункт.Раздел;
		Если СРубриками И ЗначениеЗаполнено(Пункт.Рубрика) Тогда
			Пункты = Пункты + СтрШаблон("<li class=""tree__rubric"">%1</li>",
				Экран.Экранировать(Пункт.Рубрика));
		КонецЕсли;

		Активен = Модели.Флаг(Раздел, "Активен");
		Модификаторы = ?(Активен, " tree__link--active", "")
			+ ?(Модели.Флаг(Раздел, "Опасный"), " tree__link--danger", "");
		Подпись = Модели.Текст(Раздел, "Подпись");
		Адрес = Модели.Текст(Раздел, "Адрес");
		Дети = Модели.Список(Раздел, "Дети");

		Внутри = Значки.Отрисовать(Модели.Текст(Раздел, "Иконка")) + Экран.Экранировать(Подпись);

		// небезопасная схема адреса — пункт остаётся, но перестаёт быть ссылкой
		Если ЗначениеЗаполнено(Адрес) И Экран.URLБезопасенДляHref(Адрес) Тогда
			ПунктHTML = СтрШаблон("<a href=""%1"" class=""tree__link%2""%3>%4</a>",
				Экран.Экранировать(Адрес),
				Модификаторы,
				?(Активен, " aria-current=""page""", ""),
				Внутри);
		Иначе
			ПунктHTML = СтрШаблон("<span class=""tree__link tree__link--plain%1"">%2</span>",
				Модификаторы, Внутри);
		КонецЕсли;

		Вложенные = ?(Дети.Количество() > 0, Ветка(Дети, Глубина + 1, СРубриками), "");

		Пункты = Пункты + СтрШаблон("<li class=""tree__item"">%1%2</li>", ПунктHTML, Вложенные);

	КонецЦикла;

	// модификатор уровня — только со второго: правила `tree__list--0` в CSS нет
	Уровень = ?(Глубина = 0, "", СтрШаблон(" tree__list--%1", Формат(Глубина, "ЧН=0; ЧГ=0")));

	Возврат СтрШаблон("<ul class=""tree__list%1"">%2</ul>", Уровень, Пункты);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Иконка") _Значки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Значки = _Значки;

КонецПроцедуры
