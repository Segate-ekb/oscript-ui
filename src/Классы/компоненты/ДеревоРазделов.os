// Компонент «Дерево разделов» — желудь UI-кита: навигация внутри объекта.
// Каждый раздел — обычная ссылка, раскрытие активной ветки делает сервер (поле Активен).

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Значки;  // Иконка

// Отрисовывает дерево разделов.
//
// Параметры:
//  Модель - Структура - Заголовок (aria-label, "Разделы"), Разделы (массив структур
//           Подпись, Адрес, Активен, Иконка, Дети — вложенные разделы той же формы),
//           Класс, Ориентация ("вертикаль" | "горизонталь").
//
// Возвращаемое значение:
//  Строка - фрагмент <nav class="tree"> либо "" для пустого списка разделов.
//
Функция Отрисовать(Знач Модель) Экспорт

	Разделы = Модели.Список(Модель, "Разделы");
	Если Разделы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Класс = Модели.Текст(Модель, "Класс");
	Ориентация = НРег(Модели.Текст(Модель, "Ориентация", "вертикаль"));

	Классы = "tree tree--" + ?(Ориентация = "горизонталь", "row", "column")
		+ ?(ЗначениеЗаполнено(Класс), " " + Класс, "");

	Возврат СтрШаблон("<nav%1%2>%3</nav>",
		Экран.Атрибут("class", Классы),
		Экран.Атрибут("aria-label", Модели.Текст(Модель, "Заголовок", "Разделы")),
		Ветка(Разделы, 0));

КонецФункции

// Предельная глубина вложенности разделов — страховка от бесконечной рекурсии:
// модель приходит извне, и раздел может оказаться в собственных «Детях».
//
// Возвращаемое значение:
//  Число
//
Функция ПредельнаяГлубина() Экспорт
	Возврат 4;
КонецФункции

Функция Ветка(Знач Разделы, Знач Глубина)

	Если Глубина >= ПредельнаяГлубина() Тогда
		Возврат "";
	КонецЕсли;

	Пункты = "";

	Для Каждого Раздел Из Разделы Цикл

		Активен = Модели.Флаг(Раздел, "Активен");
		Подпись = Модели.Текст(Раздел, "Подпись");
		Адрес = Модели.Текст(Раздел, "Адрес");
		Дети = Модели.Список(Раздел, "Дети");

		Внутри = Значки.Отрисовать(Модели.Текст(Раздел, "Иконка")) + Экран.Экранировать(Подпись);

		// небезопасная схема адреса — пункт остаётся, но перестаёт быть ссылкой
		Если ЗначениеЗаполнено(Адрес) И Экран.URLБезопасенДляHref(Адрес) Тогда
			ПунктHTML = СтрШаблон("<a href=""%1"" class=""tree__link%2""%3>%4</a>",
				Экран.Экранировать(Адрес),
				?(Активен, " tree__link--active", ""),
				?(Активен, " aria-current=""page""", ""),
				Внутри);
		Иначе
			ПунктHTML = СтрШаблон("<span class=""tree__link tree__link--plain%1"">%2</span>",
				?(Активен, " tree__link--active", ""), Внутри);
		КонецЕсли;

		Вложенные = ?(Дети.Количество() > 0, Ветка(Дети, Глубина + 1), "");

		Пункты = Пункты + СтрШаблон("<li class=""tree__item"">%1%2</li>", ПунктHTML, Вложенные);

	КонецЦикла;

	// модификатор уровня — только со второго: правила `tree__list--0` в CSS нет
	Уровень = ?(Глубина = 0, "", СтрШаблон(" tree__list--%1", Формат(Глубина, "ЧН=0; ЧГ=0")));

	Возврат СтрШаблон("<ul class=""tree__list%1"">%2</ul>", Уровень, Пункты);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Иконка") _Значки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Значки = _Значки;

КонецПроцедуры
