// Компонент «Сетка» — желудь UI-кита: раскладка равнозначных блоков в ряд с переносом.
// Раскладка — единственная ответственность: ячейки приходят готовым ДОВЕРЕННЫМ HTML.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели

// Отрисовывает сетку равнозначных блоков.
//
// Параметры:
//  Модель - Структура - Ячейки (массив: ДОВЕРЕННЫЙ HTML строкой либо структура с полем
//           HTML; пустые пропускаются), Колонки ("авто" | 1 | 2 | 3 | 4; 1 — стопка
//           в один столбец), Заголовок (aria-label области), Плотная (уменьшенный зазор).
//
// Возвращаемое значение:
//  Строка - фрагмент <div class="grid"> либо "" для пустого набора ячеек.
//
Функция Отрисовать(Знач Модель) Экспорт

	Ячейки = Модели.Список(Модель, "Ячейки");

	Внутри = "";
	Для Каждого Ячейка Из Ячейки Цикл
		HTML = ?(ТипЗнч(Ячейка) = Тип("Структура"), Модели.Текст(Ячейка, "HTML"),
			?(Ячейка = Неопределено, "", Строка(Ячейка)));
		Если ЗначениеЗаполнено(HTML) Тогда
			Внутри = Внутри + СтрШаблон("<div class=""grid__cell"">%1</div>", HTML);
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЗначениеЗаполнено(Внутри) Тогда
		Возврат "";
	КонецЕсли;

	Классы = "grid grid--" + НормализованныеКолонки(Модели.Значение(Модель, "Колонки"))
		+ ?(Модели.Флаг(Модель, "Плотная"), " grid--tight", "");

	Возврат СтрШаблон("<div%1%2>%3</div>",
		Экран.Атрибут("class", Классы),
		Экран.Атрибут("aria-label", Модели.Текст(Модель, "Заголовок")),
		Внутри);

КонецФункции

// Приводит число колонок к allowlist: значение из модели попадает в CSS-класс.
//
// Параметры:
//  Колонки - Произвольный - число колонок из модели.
//
// Возвращаемое значение:
//  Строка - "1" | "2" | "3" | "4" либо "auto" для неизвестного значения.
//
Функция НормализованныеКолонки(Знач Колонки) Экспорт

	Значение = НРег(СокрЛП(?(Колонки = Неопределено, "", Строка(Колонки))));

	Если Значение = "1" Тогда
		Возврат "1";
	ИначеЕсли Значение = "2" Тогда
		Возврат "2";
	ИначеЕсли Значение = "3" Тогда
		Возврат "3";
	ИначеЕсли Значение = "4" Тогда
		Возврат "4";
	КонецЕсли;

	Возврат "auto";

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели) Экспорт

	Экран = _Экран;
	Модели = _Модели;

КонецПроцедуры
