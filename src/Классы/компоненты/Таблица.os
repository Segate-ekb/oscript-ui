// Компонент «Таблица» — желудь UI-кита: семантическая <table>. Ячейка — строка/число
// (экранируется) либо структура с полем HTML (ДОВЕРЕННЫЙ); строка может нести разворот.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели

// Отрисовывает таблицу.
//
// Параметры:
//  Модель - Структура - Колонки (массив строк-заголовков либо структур Заголовок,
//           Класс), Строки (массив строк таблицы), Подпись (<caption>), Пусто (текст
//           при отсутствии строк, "Ничего не найдено"), Класс.
//           Строка таблицы — массив ячеек, одиночная ячейка либо структура
//           Ячейки (массив), Разворот (ДОВЕРЕННЫЙ HTML: печатается СЛЕДУЮЩИМ за строкой
//           <tr> во всю ширину таблицы, пустой — не печатается вовсе).
//
// Возвращаемое значение:
//  Строка - фрагмент <table> в прокручиваемой обёртке либо блок «пусто».
//
Функция Отрисовать(Знач Модель) Экспорт

	Колонки = Модели.Список(Модель, "Колонки");
	Строки = Модели.Список(Модель, "Строки");
	Класс = Модели.Текст(Модель, "Класс");

	Если Строки.Количество() = 0 Тогда
		Возврат СтрШаблон("<p class=""note-empty"">%1</p>",
			Экран.Экранировать(Модели.Текст(Модель, "Пусто", "Ничего не найдено")));
	КонецЕсли;

	Подпись = Модели.Текст(Модель, "Подпись");
	Заголовок = ?(ЗначениеЗаполнено(Подпись),
		СтрШаблон("<caption>%1</caption>", Экран.Экранировать(Подпись)), "");

	Возврат СтрШаблон("<div class=""table-scroll""><table%1>%2%3%4</table></div>",
		Экран.Атрибут("class", "table" + ?(ЗначениеЗаполнено(Класс), " " + Класс, "")),
		Заголовок,
		Шапка(Колонки),
		Тело(Строки, ШиринаТаблицы(Колонки, Строки)));

КонецФункции

Функция Шапка(Знач Колонки)

	Если Колонки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Ячейки = "";
	Для Каждого Колонка Из Колонки Цикл
		Если ТипЗнч(Колонка) = Тип("Структура") Тогда
			Ячейки = Ячейки + СтрШаблон("<th scope=""col""%1>%2</th>",
				Экран.Атрибут("class", Модели.Текст(Колонка, "Класс")),
				Экран.Экранировать(Модели.Текст(Колонка, "Заголовок")));
		Иначе
			Ячейки = Ячейки + СтрШаблон("<th scope=""col"">%1</th>", Экран.Экранировать(Колонка));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрШаблон("<thead><tr>%1</tr></thead>", Ячейки);

КонецФункции

Функция Тело(Знач Строки, Знач Ширина)

	Результат = "";

	Для Каждого СтрокаТаблицы Из Строки Цикл

		Ячейки = ЯчейкиHTML(ЯчейкиСтроки(СтрокаТаблицы));
		Разворот = Модели.Текст(СтрокаТаблицы, "Разворот");

		Если ЗначениеЗаполнено(Разворот) Тогда
			Результат = Результат + СтрШаблон(
				"<tr class=""table__record"">%1</tr>"
					+ "<tr class=""table__expand""><td colspan=""%2"">%3</td></tr>",
				Ячейки, Формат(Ширина, "ЧН=0; ЧГ=0"), Разворот);
		Иначе
			Результат = Результат + СтрШаблон("<tr>%1</tr>", Ячейки);
		КонецЕсли;

	КонецЦикла;

	Возврат СтрШаблон("<tbody>%1</tbody>", Результат);

КонецФункции

// У строки-структуры ячейки лежат в поле, у простой строки ими служит она сама.
Функция ЯчейкиСтроки(Знач СтрокаТаблицы)
	Ячейки = Модели.Значение(СтрокаТаблицы, "Ячейки");
	Возврат ?(ТипЗнч(Ячейки) = Тип("Массив"), Ячейки, СтрокаТаблицы);
КонецФункции

Функция ЯчейкиHTML(Знач Содержимое)

	Если ТипЗнч(Содержимое) <> Тип("Массив") Тогда
		Возврат ЯчейкаHTML(Содержимое);
	КонецЕсли;

	Результат = "";
	Для Каждого Значение Из Содержимое Цикл
		Результат = Результат + ЯчейкаHTML(Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Во столько колонок печатается разворот. Без шапки считать не по чему, кроме самих
// строк: colspan="0" браузер понимает как одну колонку, и разворот съёжился бы в неё.
Функция ШиринаТаблицы(Знач Колонки, Знач Строки)

	Если Колонки.Количество() > 0 Тогда
		Возврат Колонки.Количество();
	КонецЕсли;

	Результат = 1;
	Для Каждого СтрокаТаблицы Из Строки Цикл
		Ячейки = ЯчейкиСтроки(СтрокаТаблицы);
		Если ТипЗнч(Ячейки) = Тип("Массив") Тогда
			Результат = Макс(Результат, Ячейки.Количество());
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЯчейкаHTML(Знач Значение)

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Содержимое = Модели.Значение(Значение, "HTML");
		Если Содержимое = Неопределено Тогда
			Содержимое = Экран.Экранировать(Модели.Текст(Значение, "Текст"));
		Иначе
			Содержимое = Строка(Содержимое);
		КонецЕсли;
		Возврат СтрШаблон("<td%1>%2</td>", Экран.Атрибут("class", Модели.Текст(Значение, "Класс")), Содержимое);
	КонецЕсли;

	Возврат СтрШаблон("<td>%1</td>", Экран.Экранировать(Значение));

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели) Экспорт

	Экран = _Экран;
	Модели = _Модели;

КонецПроцедуры
