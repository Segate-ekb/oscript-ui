// Компонент «Страница ошибки» — желудь UI-кита: тело страницы отказа.
// Каркас (шапку, тему, статику) добавляет вызывающий.

Перем Модели;   // ЧтениеМодели
Перем Заглавия; // ЗаголовокСтраницы

// Отрисовывает тело страницы отказа: код состояния и приглушённое пояснение.
//
// Параметры:
//  Модель - Структура - Код (состояние HTTP, целое 100..599, ОБЯЗАТЕЛЕН), Сообщение
//           (экранируется), СообщениеHTML (ДОВЕРЕННАЯ разметка, вместо Сообщение).
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент. Кидается исключением, если Код невалиден.
//
Функция Отрисовать(Знач Модель) Экспорт

	Возврат Заглавия.Отрисовать(Новый Структура(
		"Заголовок, Пояснение, ПояснениеHTML",
		КодТекстом(Модель),
		Модели.Текст(Модель, "Сообщение"),
		Модели.Текст(Модель, "СообщениеHTML")));

КонецФункции

Функция КодТекстом(Знач Модель)

	Код = Модели.Значение(Модель, "Код");

	Попытка
		Номер = Число(Код);
	Исключение
		Номер = 0;
	КонецПопытки;

	Если Номер < 100 ИЛИ Номер > 599 ИЛИ Номер <> Цел(Номер) Тогда
		ВызватьИсключение "Страница ошибки: в модели нет валидного кода состояния HTTP"
			+ " (поле Код, целое 100..599).";
	КонецЕсли;

	Возврат Формат(Номер, "ЧН=0; ЧГ=0");

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "ЗаголовокСтраницы") _Заглавия) Экспорт

	Модели = _Модели;
	Заглавия = _Заглавия;

КонецПроцедуры
