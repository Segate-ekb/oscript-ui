// Компонент «Скрытое поле» — желудь UI-кита: единственный источник разметки
// <input type="hidden"> в слое.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели

// Отрисовывает скрытое поле формы; имя и значение экранируются.
//
// Параметры:
//  Модель - Структура - Имя (атрибут name, обязательно), Значение (приводится к строке).
//
// Возвращаемое значение:
//  Строка - фрагмент <input type="hidden">. Кидается исключением, если Имя пусто.
//
Функция Отрисовать(Знач Модель) Экспорт

	Имя = Модели.Текст(Модель, "Имя");
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		ВызватьИсключение "Скрытое поле: в модели не заполнено Имя — поле без name"
			+ " формой не отправляется, и такая разметка молча теряет данные.";
	КонецЕсли;

	Возврат СтрШаблон("<input type=""hidden""%1%2>",
		Экран.Атрибут("name", Имя),
		АтрибутЗначения(Модель));

КонецФункции

// value печатается и для пустого значения: пустое value легально (сброс признака).
Функция АтрибутЗначения(Знач Модель)

	Значение = Модели.Значение(Модель, "Значение");
	Текст = ?(Значение = Неопределено, "", Строка(Значение));
	Возврат СтрШаблон(" value=""%1""", Экран.Экранировать(Текст));

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели) Экспорт

	Экран = _Экран;
	Модели = _Модели;

КонецПроцедуры
