// Компонент «Панель сохранения» — желудь UI-кита: липкая полоса внизу секции настроек.
// Без JS рабочая: submit внутри формы секции, липкость даёт CSS; JS лишь подсвечивает изменения.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Кнопки;  // Кнопка

// Отрисовывает панель сохранения секции настроек.
//
// Параметры:
//  Модель - Структура - (необязательный, по умолчанию Неопределено) Подпись
//           ("Сохранить"), Пояснение (текст слева от кнопок), АдресОтмены (пусто —
//           кнопки отмены нет), ПодписьОтмены ("Отменить"), Заблокирована, Опасное,
//           Иконка (пусто — «сохранить», у опасной секции «корзина»), Имя и Значение
//           (name/value кнопки: форма с двумя кнопками отличает нажатую).
//
// Возвращаемое значение:
//  Строка - фрагмент <div class="savebar">.
//
Функция Отрисовать(Знач Модель = Неопределено) Экспорт

	Подпись = Модели.Текст(Модель, "Подпись", "Сохранить");
	Пояснение = Модели.Текст(Модель, "Пояснение");
	АдресОтмены = Модели.Текст(Модель, "АдресОтмены");
	Опасное = Модели.Флаг(Модель, "Опасное");

	Текст = ?(ЗначениеЗаполнено(Пояснение),
		СтрШаблон("<span class=""savebar__note"">%1</span>", Экран.Экранировать(Пояснение)), "");

	Отмена = "";
	Если ЗначениеЗаполнено(АдресОтмены) Тогда
		Отмена = Кнопки.Отрисовать(Новый Структура("Подпись, Вариант, Адрес",
			Модели.Текст(Модель, "ПодписьОтмены", "Отменить"), "вторичная", АдресОтмены));
	КонецЕсли;

	// иконку называет секция: не всякое действие секции — «сохранение», и дискета
	// на «Доверить конвейеру» читается неверно
	Иконка = Модели.Текст(Модель, "Иконка");

	Сохранение = Кнопки.Отрисовать(Новый Структура(
		"Подпись, Вариант, Иконка, Заблокирована, Имя, Значение",
		Подпись,
		?(Опасное, "опасная", "основная"),
		?(ЗначениеЗаполнено(Иконка), Иконка, ?(Опасное, "корзина", "сохранить")),
		Модели.Флаг(Модель, "Заблокирована"),
		Модели.Текст(Модель, "Имя"),
		Модели.Текст(Модель, "Значение")));

	Возврат СтрШаблон("<div class=""savebar"" data-savebar>%1<div class=""savebar__actions"">%2%3</div></div>",
		Текст, Отмена, Сохранение);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Кнопка") _Кнопки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Кнопки = _Кнопки;

КонецПроцедуры
