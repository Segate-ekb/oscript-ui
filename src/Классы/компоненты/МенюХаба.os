// Компонент «Меню хаба» — желудь UI-кита: ОДНА навигация инсталляции на обе ширины.
// Печатает три части одной модели: бургер для узкой шапки, кнопку-учётку для широкой
// и панель, которую открывают обе. Содержимое панели одно на всех: второй копии пунктов
// в разметке нет. На широком экране дороги стоят ещё и в самой шапке — их печатает
// каркас тем же деревом разделов, что и прежняя навигация инсталляции.
//
// Панель уходит в ВЕРХНИЙ СЛОЙ браузера (атрибут popover). Открытие, закрытие крестом,
// щелчком мимо и по Esc, возврат фокуса — работа движка; JS здесь нет.
//
// ⚠ Идентификатор панели ПОСТОЯНЕН («hubmenu»), потому что ответ страницы обязан
// повторяться байт в байт. Отсюда допущение: меню инсталляции на странице ОДНО — его
// печатает каркас, и печатает единожды. Компонент публичен (НаборКомпонентов.МенюХаба),
// поэтому напечатать второе можно руками — не делайте так: два элемента с одним id дадут
// кнопку, открывающую чужую панель. Проверкой это не закрыто сознательно: желудь —
// одиночка на весь процесс, и счётчик вызовов ловил бы не второе меню на странице,
// а второй запрос к серверу.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Кнопки;  // Кнопка
Перем Тексты;  // ТекстыИнтерфейса

// Отрисовывает единое меню: бургер, рейку и панель — три части ОДНОЙ модели с общим
// идентификатором связи.
//
// Параметры:
//  Модель - Структура - Счётчик (сумма дел на бургере; ноль и пусто не печатаются),
//           ПодписьСчётчика (чем эта сумма зовётся в речи; обязательна, когда печатается),
//           Учётка (Структура: Логин, Роль, Адрес — блок вошедшего и ход в его кабинет;
//           пустой Логин — блока нет), Дела (Массив: Подпись, Адрес, Иконка, Счётчик,
//           ПодписьСчётчика), Навигация (Массив: Подпись, Адрес, Иконка, Активен),
//           Разделы (Массив той же формы — разделы ТЕКУЩЕГО экрана; пусто — секции нет),
//           Знак, Вход, Тема, Выход (ДОВЕРЕННЫЕ фрагменты: ход на главную, ход ко входу
//           для гостя, форма переключателя оформления и форма выхода — их собирает каркас
//           страницы). Тема стоит отдельной строкой подвала: на широком экране лист её
//           прячет — там переключатель живёт в самой шапке.
//
// Возвращаемое значение:
//  Структура - Бургер, Учётка, Панель: три фрагмента HTML. Учётка пуста, когда вошедшего
//              нет: открывать панель на широком экране гостю нечем и незачем — дороги
//              и оформление стоят у него прямо в шапке. Пустое меню (ни дел, ни навигации,
//              ни учётки) даёт три пустые строки.
//
Функция Отрисовать(Знач Модель) Экспорт

	Если Пустое(Модель) Тогда
		Возврат Новый Структура("Бургер, Учётка, Панель", "", "", "");
	КонецЕсли;

	ПроверитьУчётку(Модель);
	ПроверитьПункты(Модели.Список(Модель, "Дела"), "Дела");
	ПроверитьПункты(Модели.Список(Модель, "Навигация"), "Навигация");
	ПроверитьПункты(Модели.Список(Модель, "Разделы"), "Разделы");
	ПроверитьЧисло(Модель, "МенюХаба");

	Ид = ИдентификаторПанели();

	Возврат Новый Структура("Бургер, Учётка, Панель",
		Бургер(Модель, Ид), ОткрывашкаУчётки(Модель, Ид), Панель(Модель, Ид));

КонецФункции

// Меню, которому нечего показать. Инсталляция, не заполнившая слот, получает прежнюю
// шапку целиком — кнопка, открывающая пустоту, хуже старой навигации.
//
// Параметры:
//  Модель - Структура, Неопределено - модель меню, см. Отрисовать.
//
// Возвращаемое значение:
//  Булево
//
Функция Пустое(Знач Модель) Экспорт

	Возврат Модели.Список(Модель, "Дела").Количество() = 0
		И Модели.Список(Модель, "Навигация").Количество() = 0
		И НЕ ЗначениеЗаполнено(Логин(Модель));

КонецФункции

#Область Части

// Бургер шапки: узкий экран. Сумма непрочитанного печатается на нём бейджем — ради неё
// на кнопку смотрят, не открывая меню.
Функция Бургер(Знач Модель, Знач Ид)

	Возврат СтрШаблон("<div class=""hubmenu__opener"">%1</div>",
		Кнопки.Отрисовать(Новый Структура(
			"Подпись, Вариант, Иконка, ТолькоИконка, Тип, Открывает, Счётчик, ПодписьСчётчика",
			Тексты.Текст("chrome.menu.open"), "вторичная", "меню", Истина, "обычная", Ид,
			Модели.Значение(Модель, "Счётчик"), Модели.Текст(Модель, "ПодписьСчётчика"))));

КонецФункции

// Открывашка широкого экрана — та же кнопка-учётка, что у меню строки: значок, имя
// вошедшего ТЕКСТОМ, число дел бейджем и шеврон раскрытия. Шеврон обязателен: без него
// кнопка неотличима от хода по ссылке, и человек не знает, что она раскроется.
// Гостю кнопки нет: панель ему нечем наполнить сверх того, что уже стоит в шапке.
Функция ОткрывашкаУчётки(Знач Модель, Знач Ид)

	Логин = Логин(Модель);
	Если НЕ ЗначениеЗаполнено(Логин) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("<div class=""hubmenu__user"">%1</div>",
		Кнопки.Отрисовать(Новый Структура(
			"Подпись, Подсказка, Вариант, Размер, Иконка, ЗнакРаскрытия, Тип, Открывает,"
				+ " Счётчик, ПодписьСчётчика",
			Логин, Тексты.Текст("chrome.menu.open"), "вторичная", "малый", "аккаунт",
			Истина, "обычная", Ид,
			Модели.Значение(Модель, "Счётчик"), Модели.Текст(Модель, "ПодписьСчётчика"))));

КонецФункции

// Панель — единственное место, где живут пункты меню. Крест стоит первой строкой, на месте
// бургера: человек закрывает меню там же, где открыл.
Функция Панель(Знач Модель, Знач Ид)

	Возврат СтрШаблон("<div class=""hubmenu""%1 popover>"
			+ "<div class=""hubmenu__head""><span class=""hubmenu__brand"">%2</span>"
			+ "<span class=""hubmenu__close"">%3</span></div>%4%5%6%7"
			+ "<div class=""hubmenu__foot"">"
			+ "<div class=""hubmenu__theme"">%8</div>%9</div></div>",
		Экран.Атрибут("id", Ид),
		Модели.Текст(Модель, "Знак"),
		Крест(Ид),
		БлокУчётки(Модель),
		Секция("chrome.menu.section.deeds", ПунктыДел(Модели.Список(Модель, "Дела"))),
		Секция("chrome.menu.section.nav", ПунктыДорог(Модели.Список(Модель, "Навигация"))),
		Секция("chrome.menu.section.screen", ПунктыДорог(Модели.Список(Модель, "Разделы")),
			"hubmenu__section--screen"),
		Модели.Текст(Модель, "Тема"),
		Модели.Текст(Модель, "Выход"));

КонецФункции

// Крест закрывает панель тем же popovertarget. Без верхнего слоя закрывать нечего —
// панель стоит блоком в потоке, — поэтому обёртка ему нужна своя: лист прячет её там же,
// где прячет бургер и кнопку-учётку.
Функция Крест(Знач Ид)

	Возврат Кнопки.Отрисовать(Новый Структура(
		"Подпись, Вариант, Иконка, ТолькоИконка, Тип, Открывает",
		Тексты.Текст("chrome.menu.close"), "вторичная", "закрыть", Истина, "обычная", Ид));

КонецФункции

#КонецОбласти

#Область Содержимое

// Блок вошедшего — он же ход в кабинет: аватар с первой буквой логина, сам логин и роль.
// Аватар декоративен, имя блока собирается из текста.
Функция БлокУчётки(Знач Модель)

	Логин = Логин(Модель);
	Если НЕ ЗначениеЗаполнено(Логин) Тогда
		// у гостя на месте учётки — ход ко входу: на телефоне полоса ходов спрятана,
		// и без него войти было бы неоткуда. Ссылку собирает каркас: адрес входа и слово
		// «Войти» — его забота, инсталляция их не присылает
		Возврат Модели.Текст(Модель, "Вход");
	КонецЕсли;

	Учётка = Модели.Значение(Модель, "Учётка");
	Роль = Модели.Текст(Учётка, "Роль");

	Внутри = СтрШаблон("<span class=""hubmenu__avatar"" aria-hidden=""true"">%1</span>"
			+ "<span class=""hubmenu__who""><span class=""hubmenu__login"">%2</span>%3</span>",
		Экран.Экранировать(ПерваяБуква(Логин)),
		Экран.Экранировать(Логин),
		?(ЗначениеЗаполнено(Роль),
			СтрШаблон("<span class=""hubmenu__role"">%1</span>", Экран.Экранировать(Роль)), ""));

	Адрес = Модели.Текст(Учётка, "Адрес");
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат СтрШаблон("<div class=""hubmenu__account"">%1</div>", Внутри);
	КонецЕсли;

	Возврат Экран.Ссылка(Адрес, Логин, "hubmenu__account", Внутри);

КонецФункции

// Пункт дела: подпись, значок и своё число. Числа у дел РАЗДЕЛЬНЫЕ — сумма живёт только
// на бургере, а в меню человек должен видеть, где именно его ждут.
Функция ПунктыДел(Знач Список)

	Результат = "";

	Для Каждого Дело Из Список Цикл
		Результат = Результат + Кнопки.Отрисовать(Новый Структура(
			"Подпись, Адрес, Иконка, Вариант, ВоВсюШирину, Счётчик, ПодписьСчётчика, Текущая",
			Модели.Текст(Дело, "Подпись"), Модели.Текст(Дело, "Адрес"),
			Модели.Текст(Дело, "Иконка"), "вторичная", Истина,
			Модели.Значение(Дело, "Счётчик"), Модели.Текст(Дело, "ПодписьСчётчика"),
			Модели.Флаг(Дело, "Активен")));
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПунктыДорог(Знач Список)

	Результат = "";

	Для Каждого Дорога Из Список Цикл
		Результат = Результат + Кнопки.Отрисовать(Новый Структура(
			"Подпись, Адрес, Иконка, Вариант, ВоВсюШирину, Текущая",
			Модели.Текст(Дорога, "Подпись"), Модели.Текст(Дорога, "Адрес"),
			Модели.Текст(Дорога, "Иконка"), "вторичная", Истина,
			Модели.Флаг(Дорога, "Активен")));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Рубрика печатается только над непустым списком: заголовок над пустотой обещает пункты,
// которых нет.
// Секции различаются классом, потому что видны они не везде одинаково: разделы ТЕКУЩЕГО
// экрана на широком уже стоят колонкой на самой странице, и повторять их в меню незачем —
// прячет их лист по этому самому классу.
Функция Секция(Знач КлючРубрики, Знач Пункты, Знач Класс = "")

	Если НЕ ЗначениеЗаполнено(Пункты) Тогда
		Возврат "";
	КонецЕсли;

	Рубрика = Тексты.Текст(КлючРубрики);

	Возврат СтрШаблон("<nav%1%2><p class=""hubmenu__title"">%3</p>%4</nav>",
		Экран.Атрибут("class", СокрЛП("hubmenu__section " + Класс)),
		Экран.Атрибут("aria-label", Рубрика), Экран.Экранировать(Рубрика), Пункты);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Учётка без логина не собирается: кружок аватара берёт первую букву именно из него,
// а меню стоит на КАЖДОЙ странице инсталляции. Отказ называет поле контракта — иначе
// искать его будут в компоненте, которого на этом экране никто не звал.
Процедура ПроверитьУчётку(Знач Модель)

	Учётка = Модели.Значение(Модель, "Учётка");
	Если ЗначениеЗаполнено(Логин(Модель)) Тогда
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Модели.Текст(Учётка, "Роль"))
		И НЕ ЗначениеЗаполнено(Модели.Текст(Учётка, "Адрес")) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение "Обрамление инсталляции: в модели МенюХаба заполнена Учётка,"
		+ " но не задан МенюХаба.Учётка.Логин. Именно им подписан блок вошедшего и из него"
		+ " берётся буква аватара, поэтому блок не собрать. Заполните Логин либо не"
		+ " присылайте Учётку вовсе: меню соберётся без блока вошедшего.";

КонецПроцедуры

// Пункт без подписи не читается ни глазом, ни скринридером. Проверяется здесь, а не
// в кнопке: имя поля контракта знает только тот, кто этот контракт объявил.
Процедура ПроверитьПункты(Знач Список, Знач Поле)

	Номер = 0;
	Для Каждого Пункт Из Список Цикл

		Номер = Номер + 1;
		Адрес = СтрШаблон("МенюХаба.%1[%2]", Поле, Формат(Номер, "ЧН=0; ЧГ=0"));

		Если НЕ ЗначениеЗаполнено(Модели.Текст(Пункт, "Подпись")) Тогда
			ВызватьИсключение СтрШаблон("Обрамление инсталляции: пункт %1 не несёт Подписи."
				+ " Она и есть текст пункта меню — без неё в меню окажется пустая строка,"
				+ " ведущая неизвестно куда.", Адрес);
		КонецЕсли;

		ПроверитьЧисло(Пункт, Адрес);

	КонецЦикла;

КонецПроцедуры

// Число без подписи скринридер прочитает голой цифрой: «три» — три чего? Правило одно
// на все числа меню, поэтому и проверка одна: и сумма на бургере, и число у пункта.
Процедура ПроверитьЧисло(Знач Владелец, Знач Адрес)

	Значение = Модели.Значение(Владелец, "Счётчик");
	Если Значение = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СокрЛП(Модели.Текст(Владелец, "Счётчик"))) Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") И Значение = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Модели.Текст(Владелец, "ПодписьСчётчика")) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Обрамление инсталляции: %1.Счётчик задан, а"
		+ " %1.ПодписьСчётчика — нет. Цифра на кнопке — картинка для глаза: скринридер"
		+ " услышал бы голое число. Назовите, что это за число.", Адрес);

КонецПроцедуры

// Идентификатор связи ПОСТОЯНЕН. Меню инсталляции на странице ровно одно — второму
// взяться неоткуда, — а порядковый номер сделал бы каждый ответ побайтово новым: у хаба
// на этом разъехались ETag, и страница, которая обязана отвечать 304, отвечала 200
// на каждый запрос. Из данных в идентификатор по-прежнему не попадает ничего.
Функция ИдентификаторПанели()
	Возврат "hubmenu";
КонецФункции

Функция Логин(Знач Модель)
	Возврат Модели.Текст(Модели.Значение(Модель, "Учётка"), "Логин");
КонецФункции

// Первая буква логина — то, что рисуется в кружке аватара. Регистр верхний: в кружке
// стоит одна буква, и строчная в нём выглядит опечаткой.
Функция ПерваяБуква(Знач Логин)
	Возврат ВРег(Лев(СокрЛП(Логин), 1));
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Кнопка") _Кнопки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Кнопки = _Кнопки;
	Тексты = _Тексты;

КонецПроцедуры
