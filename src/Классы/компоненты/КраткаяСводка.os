// Компонент «Сводка» — желудь UI-кита: запись списка одним взглядом. Название первым
// и крупно, знаки состояния рядом с ним, подпись под ним, ниже — подписанные строки
// «подпись — значение». Вся разметка строчная: сводка ложится и в свёрнутую строку
// раскрывашки, куда блочные теги не кладут.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Плашки;  // Плашка

// Отрисовывает сводку.
//
// Параметры:
//  Модель - Структура - Название (обязательно), Знаки (Массив моделей «Плашки» — состояние
//           у названия), Подпись (Строка либо Массив из Строка — части через « · »),
//           Сведения (Массив из Структура: Подпись, Значение, Вид — "" | "warn"; строка
//           с пустым значением не печатается).
//
// Возвращаемое значение:
//  Строка - фрагмент span.brief. Кидается исключением, если Название пусто.
//
Функция Отрисовать(Знач Модель) Экспорт

	Название = Модели.Текст(Модель, "Название");
	Если НЕ ЗначениеЗаполнено(Название) Тогда
		ВызватьИсключение "Компонент «Сводка»: без Названия сводка не говорит, о чём она."
			+ " Назовите запись — именем, адресом, номером.";
	КонецЕсли;

	Возврат СтрШаблон("<span class=""brief"">%1%2%3</span>",
		Голова(Название, Модели.Список(Модель, "Знаки")),
		ПодписьHTML(Модели.Значение(Модель, "Подпись")),
		СведенияHTML(Модели.Список(Модель, "Сведения")));

КонецФункции

#Область Части

// Знаки идут после названия: их читают вторыми, но видят сразу.
Функция Голова(Знач Название, Знач Знаки)

	ЗнакиHTML = "";
	Для Каждого Знак Из Знаки Цикл
		ЗнакиHTML = ЗнакиHTML + Плашки.Отрисовать(Знак);
	КонецЦикла;

	Возврат СтрШаблон("<span class=""brief__head""><span class=""brief__name"">%1</span>%2</span>",
		Экран.Экранировать(Название), ЗнакиHTML);

КонецФункции

Функция ПодписьHTML(Знач Подпись)

	Части = Новый Массив();
	Если ТипЗнч(Подпись) = Тип("Массив") Тогда
		Для Каждого Часть Из Подпись Цикл
			Если ЗначениеЗаполнено(Часть) Тогда
				Части.Добавить(Экран.Экранировать(Строка(Часть)));
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ЗначениеЗаполнено(Подпись) Тогда
		Части.Добавить(Экран.Экранировать(Строка(Подпись)));
	КонецЕсли;

	Если Части.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон("<span class=""brief__sub"">%1</span>", СтрСоединить(Части, " · "));

КонецФункции

// Подпись и значение — соседи одной строки: на широком экране колонками, на узком
// подпись встаёт над значением, и длинный перечень переносится в своей колонке.
Функция СведенияHTML(Знач Сведения)

	Строки = "";
	Для Каждого Сведение Из Сведения Цикл
		Значение = Модели.Текст(Сведение, "Значение");
		Если НЕ ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Предупреждение = НРег(Модели.Текст(Сведение, "Вид")) = "warn";
		Строки = Строки + СтрШаблон("<span class=""brief__fact""><span class=""brief__label"">%1</span>"
			+ "<span class=""%2"">%3</span></span>",
			Экран.Экранировать(Модели.Текст(Сведение, "Подпись")),
			?(Предупреждение, "brief__value brief__value--warn", "brief__value"),
			Экран.Экранировать(Значение));
	КонецЦикла;

	Возврат ?(ЗначениеЗаполнено(Строки), СтрШаблон("<span class=""brief__facts"">%1</span>", Строки), "");

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Плашка") _Плашки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Плашки = _Плашки;

КонецПроцедуры
