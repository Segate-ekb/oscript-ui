// Компонент «Плашка» — желудь UI-кита: имя тега, метка версии, тип пула.
// В интерфейсе зовётся «Тег», но имя типа `Тег` занято сущностью db/Классы/пакеты/Тег.os,
// а имена типов в OneScript глобальны — ОСень падает на одноимённых желудях.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Значки;  // Иконка

// Отрисовывает плашку.
//
// Параметры:
//  Модель - Структура, Строка, Неопределено - текст плашки либо структура: Текст
//           (экранируется), Вид ("" | "ok" | "warn" | "err" | "accent"), Адрес (плашка
//           становится ссылкой), Иконка, Подсказка (атрибут title), Действие —
//           ДОВЕРЕННЫЙ HTML управления при плашке (крестик снятия): печатается ВНУТРИ
//           неё, поэтому перенос строки не отрывает его от подписи. С Адресом
//           несовместимо. Неопределено — признака нет, плашка не печатается. Внутри —
//           ДОВЕРЕННЫЙ HTML содержимого: печатается ВМЕСТО значка и текста, когда плашку
//           собирают из своих узлов.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент; "" для Неопределено. Кидается исключением, если Действие
//           задано вместе с Адресом.
//
Функция Отрисовать(Знач Модель) Экспорт

	// «модели нет — нет и пилюли»: правило живёт здесь, чтобы каждый вызывающий не носил
	// свою копию проверки (и не забывал её)
	Если Модель = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(Модель) = Тип("Структура") Тогда
		Текст = Модели.Текст(Модель, "Текст");
		Вид = НРег(СокрЛП(Модели.Текст(Модель, "Вид")));
		Адрес = Модели.Текст(Модель, "Адрес");
		ИмяИконки = Модели.Текст(Модель, "Иконка");
		Подсказка = Модели.Текст(Модель, "Подсказка");
		Действие = Модели.Текст(Модель, "Действие");
		Внутри = Модели.Текст(Модель, "Внутри");
	Иначе
		Текст = Строка(Модель);
		Вид = "";
		Адрес = "";
		ИмяИконки = "";
		Подсказка = "";
		Действие = "";
		Внутри = "";
	КонецЕсли;

	Вид = НормализованныйВид(Вид);
	Классы = "tag" + ?(ЗначениеЗаполнено(Вид), " tag--" + Вид, "");
	Если НЕ ЗначениеЗаполнено(Внутри) Тогда
		Внутри = Значки.Отрисовать(ИмяИконки) + Экран.Экранировать(Текст);
	КонецЕсли;
	Внутри = Внутри + ДействиеHTML(Действие);

	Если ЗначениеЗаполнено(Адрес) Тогда
		ПроверитьСовместимость(Действие);
		Возврат Экран.Ссылка(Адрес, Текст, Классы, Внутри);
	КонецЕсли;

	Возврат СтрШаблон("<span%1%2>%3</span>",
		Экран.Атрибут("class", Классы), Экран.Атрибут("title", Подсказка), Внутри);

КонецФункции

// Отрисовывает ряд плашек одним элементом: они стоят в строку и переносятся вместе.
// Соседними детьми контейнера плашки не печатаются — вертикальный ритм контейнера
// достался бы каждой из них и опустил бы строку.
//
// Параметры:
//  Список - Массив - модели плашек (см. Отрисовать); Неопределено в списке пропускается.
//
// Возвращаемое значение:
//  Строка - фрагмент div.tag-row либо пустая строка для пустого ряда. Имя класса без
//           кавычек намеренно: закавыченное сканер мёртвых правил CSS зачтёт за разметку.
//
Функция Ряд(Знач Список) Экспорт

	Если ТипЗнч(Список) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;

	Внутри = "";
	Для Каждого Модель Из Список Цикл
		Внутри = Внутри + Отрисовать(Модель);
	КонецЦикла;

	Возврат ?(ЗначениеЗаполнено(Внутри),
		СтрШаблон("<div class=""tag-row"">%1</div>", Внутри), "");

КонецФункции

Функция ДействиеHTML(Знач Действие)
	Возврат ?(ЗначениеЗаполнено(Действие),
		СтрШаблон("<span class=""tag__action"">%1</span>", Действие), "");
КонецФункции

Процедура ПроверитьСовместимость(Знач Действие)

	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение "Компонент «Плашка»: Действие несовместимо с Адресом — кнопка внутри"
		+ " ссылки не нажимается. Уберите Адрес либо выносите действие отдельной плашкой.";

КонецПроцедуры

// Приводит вид плашки к allowlist: значение из модели попадает в CSS-класс.
//
// Параметры:
//  Вид - Строка - вид из модели.
//
// Возвращаемое значение:
//  Строка - "ok" | "warn" | "err" | "accent" либо "" для нейтральной плашки.
//
Функция НормализованныйВид(Знач Вид) Экспорт

	Значение = НРег(СокрЛП(Строка(Вид)));

	Если Значение = "ok" ИЛИ Значение = "успех" Тогда
		Возврат "ok";
	ИначеЕсли Значение = "warn" ИЛИ Значение = "предупреждение" Тогда
		Возврат "warn";
	ИначеЕсли Значение = "err" ИЛИ Значение = "error" ИЛИ Значение = "ошибка" Тогда
		Возврат "err";
	ИначеЕсли Значение = "accent" ИЛИ Значение = "акцент" Тогда
		Возврат "accent";
	КонецЕсли;

	Возврат "";

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Иконка") _Значки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Значки = _Значки;

КонецПроцедуры
