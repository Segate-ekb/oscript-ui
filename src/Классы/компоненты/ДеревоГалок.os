// Компонент «Дерево галок» — желудь UI-кита: выбор по дереву с трёхпозиционной галкой
// у ветки («включено», «снято», «частично»). Ветки сворачиваются нативной раскрывашкой,
// отступ и линия показывают вложенность. Три состояния печатает сервер: «частично» видно
// и без скрипта — знаком в самой галке и aria-checked="mixed". Пересчёт на лету — дело
// скрипта: он берёт дерево по data-checktree, галку — по data-checktree-box.
//
// Дерево на тысячу пунктов (выпуск 0.13): ветка печатает первые 50 детей, остальные
// приезжают страницами по адресу ветки; поиск через сервер над деревом; режим ветки
// «все / выбранные / никакие» сегментами; форма отдаёт только правки. Без этих полей модели
// дерево печатается прежней дорогой, байт в байт.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Плашки;  // Плашка
// --- дерево галок (выпуск 0.13) ---
Перем Тексты;  // ТекстыИнтерфейса — подписи поиска, режимов, «показать ещё» и правок
Перем Значки;  // Иконка — галка сегмента режима и крестик плашки правки
Перем Кнопки;  // Кнопка — «Найти», «Показать ещё», «Включить / снять найденные»
Перем Поля;    // ПолеФормы — поле поиска над деревом

// Отрисовывает дерево галок.
//
// Параметры:
//  Модель - Структура - Подпись (доступное имя дерева), Узлы (Массив из Структура):
//    * Имя - Строка - имя галки в форме (обязательно);
//    * Значение - Строка - что галка отправляет отмеченной (по умолчанию "1");
//    * Подпись - Строка - что за узел;
//    * Пояснение - Строка - приглушённая приписка после подписи;
//    * Признаки - Массив - модели плашек после подписи;
//    * Состояние - Строка - "вкл" | "выкл" | "частично"; «частично» отправляется
//      отмеченной галкой;
//    * Отключён - Булево - галка не отправляется и не правится;
//    * Дети - Массив из Структура - узлы ветки той же формы; есть ключ — узел ветка,
//      даже пустая;
//    * Открыт - Булево - ветка приезжает раскрытой;
//    * Примечание - Строка - строка в конце ветки (что показано не всё и т. п.);
//    * Данные - Соответствие - дополнительные data-атрибуты галки для скрипта страницы
//      (имя без приставки data-);
//    * Всего - Число - (выпуск 0.13) сколько детей у ветки на сервере; больше
//      напечатанных — под ветвью «Показать ещё». С Адресом узел с Всего > 0 — ветка и без
//      Детей: её дети приедут при раскрытии;
//    * Режим - Строка - (выпуск 0.13) "все" | "выбранные" | "никакие" — режим ветки при
//      Режимах; по умолчанию из Состояния: вкл — все, выкл — никакие, частично — выбранные.
//  Поля модели выпуска 0.13 (любое из них печатает дерево в обёртке data-checktree-set):
//    * Адрес - Строка - адрес страниц веток: ветка печатает первые 50 детей
//      (РазмерСтраницы), «Показать ещё» ведёт на Адрес?ветка=<ключ>&страница=<N>
//      (у корня — без «ветка»), и скрипт дописывает страницу в ветку;
//    * Всего - Число - сколько узлов в корне на сервере (страницы корня — как у ветки);
//    * Поиск - Строка - адрес поиска: над деревом поле «найти» и кнопка «Найти»;
//      скрипт берёт Поиск?найти=<строка> и кладёт ответ (data-checktree-found) на место
//      веток; без скрипта кнопка отправляет форму на этот адрес;
//    * Режимы - Булево - у каждой ветки сегменты «все / выбранные / никакие»
//      (радиокнопки «режим:<ключ>») вместо галки ветки;
//    * ТолькоПравки - Булево - со скриптом форма отдаёт не галки, а правки: правки=1,
//      включить=<ключ>, снять=<ключ>, режим=<ключ>:<режим>; правки видны плашками под
//      деревом, любую можно снять. Без скрипта уходят галки, как обычно;
//    * Найдено - Строка - дерево — ответ поиска по этой строке: Узлы — совпадения,
//      над ними число найденного и кнопки «Включить / Снять найденные»;
//    * Ветка, Страница - Строка, Число - дерево — фрагмент: страница Страница (с 1)
//      детей ветки с этим ключом ("" — корня), без обёртки и поиска.
//  Ключ узла — его Значение, если оно своё (не "1"), иначе Имя: по ключу сервер узнаёт
//  узел в адресе ветки и в правках.
//
// Возвращаемое значение:
//  Строка - фрагмент ul.checktree либо "" для пустого списка узлов (с полями 0.13 —
//           div.checktree-set, у фрагмента — ul с data-checktree-page). Кидается
//           исключением, если у узла нет Имени, Состояние не из трёх или Режим не из трёх.
//
Функция Отрисовать(Знач Модель) Экспорт

	Узлы = Модели.Список(Модель, "Узлы");
	// --- дерево галок (выпуск 0.13): новые поля печатают дерево своей дорогой, дерево без
	// них — прежней, байт в байт
	Если Расширено(Модель) Тогда
		Возврат РасширенноеДерево(Модель, Узлы);
	КонецЕсли;

	Если Узлы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("<ul class=""checktree"" data-checktree%1>%2</ul>",
		Экран.Атрибут("aria-label", Модели.Текст(Модель, "Подпись")), Узлы(Узлы, 0));

КонецФункции

// Предельная глубина дерева — страховка от бесконечной рекурсии: модель приходит
// извне, и узел может оказаться в собственных «Детях».
//
// Возвращаемое значение:
//  Число
//
Функция ПредельнаяГлубина() Экспорт
	Возврат 4;
КонецФункции

// --- дерево галок (выпуск 0.13) ---

// Сколько детей печатает ветка за раз (с Адресом): столько же сервер отдаёт на одной
// странице ветки.
//
// Возвращаемое значение:
//  Число
//
Функция РазмерСтраницы() Экспорт
	Возврат 50;
КонецФункции

// Разбирает правки дерева из тела формы. Тело — строкой (application/x-www-form-urlencoded):
// правок одного имени приходит несколько, а соответствие оставило бы одну. Режимы веток
// разбираются в обоих видах: правкой «режим=<ключ>:<режим>» (со скриптом) и радиокнопкой
// «режим:<ключ>=<режим>» (без скрипта). Чужие режимы отбрасываются: тело пришло извне.
//
// Параметры:
//  Тело - Строка - сырое тело запроса.
//
// Возвращаемое значение:
//  Структура - Правки (Булево — форма прислала правки, а не галки: пришло «правки=1»),
//              Включить и Снять (Массив из Строка — ключи узлов), Режимы (Соответствие:
//              ключ ветки — "все" | "выбранные" | "никакие").
//
Функция РазобратьПравки(Знач Тело) Экспорт

	Результат = Новый Структура("Правки, Включить, Снять, Режимы", Ложь, Новый Массив(),
		Новый Массив(), Новый Соответствие());
	Если ТипЗнч(Тело) <> Тип("Строка") Тогда
		Возврат Результат;
	КонецЕсли;

	ИзвестныеРежимы = ИзвестныеРежимы();
	Для Каждого Пара Из СтрРазделить(Тело, "&", Ложь) Цикл
		Позиция = СтрНайти(Пара, "=");
		Имя = Раскодировать(?(Позиция = 0, Пара, Лев(Пара, Позиция - 1)));
		Значение = ?(Позиция = 0, "", Раскодировать(Сред(Пара, Позиция + 1)));
		Если Имя = ИмяПравок() Тогда
			Результат.Правки = Истина;
		ИначеЕсли Имя = "включить" Тогда
			Результат.Включить.Добавить(Значение);
		ИначеЕсли Имя = "снять" Тогда
			Результат.Снять.Добавить(Значение);
		ИначеЕсли Имя = "режим" Тогда
			// ключ может нести двоеточие, режим — нет: делим по последнему
			Разрез = СтрНайти(Значение, ":", НаправлениеПоиска.СКонца);
			Режим = ?(Разрез = 0, "", Сред(Значение, Разрез + 1));
			Если Разрез > 0 И ИзвестныеРежимы.Найти(Режим) <> Неопределено Тогда
				Результат.Режимы.Вставить(Лев(Значение, Разрез - 1), Режим);
			КонецЕсли;
		ИначеЕсли СтрНачинаетсяС(Имя, ПриставкаРежима()) И ИзвестныеРежимы.Найти(Значение) <> Неопределено Тогда
			Результат.Режимы.Вставить(Сред(Имя, СтрДлина(ПриставкаРежима()) + 1), Значение);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#Область Узлы

// Конт — Неопределено у прежнего дерева: каждая его строка печатается как до выпуска 0.13.
Функция Узлы(Знач Узлы, Знач Глубина, Знач Конт = Неопределено)

	Результат = "";
	Для Каждого Узел Из Узлы Цикл
		Результат = Результат + Узел(Узел, Глубина, Конт);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Строка узла стоит в разметке ПОСЛЕ ветки, а на экране — первой (order): так шеврон
// раскрытия идёт в порядке фокуса раньше галки, а галка не вложена в кнопку раскрытия —
// скринридер назвал бы её частью кнопки, а щелчок по подписи спорил бы с раскрытием.
Функция Узел(Знач Узел, Знач Глубина, Знач Конт = Неопределено)

	Ветка = ЭтоВетка(Узел, Конт) И Глубина + 1 < ПредельнаяГлубина();
	Возврат СтрШаблон("<li class=""checktree__node"">%1%2</li>",
		?(Ветка, ВеткаHTML(Узел, Глубина, Конт), ""),
		СтрокаУзла(Узел, Ветка, Конт));

КонецФункции

Функция ВеткаHTML(Знач Узел, Знач Глубина, Знач Конт = Неопределено)

	Примечание = Модели.Текст(Узел, "Примечание");
	Дети = Модели.Список(Узел, "Дети");
	// --- дерево галок (выпуск 0.13): с адресом — первая страница детей и «Показать ещё»
	Страница = "";
	Список = "";
	Если ЕстьАдрес(Конт) Тогда
		Ключ = Ключ(Узел);
		Показано = Первые(Дети);
		Список = Экран.АтрибутВсегда(ПризнакСтраницы(), Ключ);
		Страница = Ещё(Конт, Ключ, Ложь, Цел(Показано.Количество() / РазмерСтраницы()) + 1,
			Показано.Количество(), Макс(ЧислоИз(Узел, "Всего"), Дети.Количество()));
		Дети = Показано;
	КонецЕсли;

	Возврат СтрШаблон("<details class=""checktree__branch""%1><summary class=""checktree__toggle"">"
		+ "<span class=""visually-hidden"">%2</span></summary><ul class=""checktree__children""%5>%3</ul>%6%4</details>",
		Экран.БулевАтрибут("open", Модели.Флаг(Узел, "Открыт")),
		Экран.Экранировать(Модели.Текст(Узел, "Подпись")),
		Узлы(Дети, Глубина + 1, Конт),
		?(ЗначениеЗаполнено(Примечание),
			СтрШаблон("<p class=""checktree__more"">%1</p>", Экран.Экранировать(Примечание)), ""),
		Список, Страница);

КонецФункции

Функция СтрокаУзла(Знач Узел, Знач Ветка = Ложь, Знач Конт = Неопределено)

	Пояснение = Модели.Текст(Узел, "Пояснение");
	Признаки = "";
	Для Каждого Признак Из Модели.Список(Узел, "Признаки") Цикл
		Признаки = Признаки + Плашки.Отрисовать(Признак);
	КонецЦикла;

	// --- дерево галок (выпуск 0.13): ветка с режимами вместо галки несёт сегменты режима —
	// «все / никакие» и есть её «включена / снята», а «выбранные» — её «частично»
	Если Ветка И СРежимами(Конт) Тогда
		ПроверитьИмя(Узел);
		Возврат СтрШаблон("<div class=""checktree__row""><span class=""checktree__item"">"
			+ "<span class=""checktree__label"">%1</span></span>%2%3%4</div>",
			Экран.Экранировать(Модели.Текст(Узел, "Подпись")),
			?(ЗначениеЗаполнено(Пояснение),
				СтрШаблон("<span class=""checktree__note"">%1</span>", Экран.Экранировать(Пояснение)), ""),
			?(ЗначениеЗаполнено(Признаки), СтрШаблон("<span class=""checktree__marks"">%1</span>", Признаки), ""),
			РежимыВетки(Узел));
	КонецЕсли;

	// приписка — за подписью, а не внутри неё: на узком экране она уходит строкой ниже, а имя
	// узла не рвётся по буквам
	Возврат СтрШаблон("<div class=""checktree__row""><label class=""checktree__item"">%1"
		+ "<span class=""checktree__label"">%2</span></label>%3%4</div>",
		Галка(Узел),
		Экран.Экранировать(Модели.Текст(Узел, "Подпись")),
		?(ЗначениеЗаполнено(Пояснение),
			СтрШаблон("<span class=""checktree__note"">%1</span>", Экран.Экранировать(Пояснение)), ""),
		?(ЗначениеЗаполнено(Признаки), СтрШаблон("<span class=""checktree__marks"">%1</span>", Признаки), ""));

КонецФункции

// «Частично» отправляется отмеченной галкой: без скрипта щелчок по ней снимает узел целиком,
// повторный возвращает прежнюю частичную отметку — дети при этом не трогаются.
Функция Галка(Знач Узел)

	Имя = ПроверитьИмя(Узел);
	Состояние = Состояние(Узел);
	Значение = Модели.Текст(Узел, "Значение", "1");

	Возврат СтрШаблон("<input type=""checkbox"" class=""checktree__box"" data-checktree-box%1%2%3%4%5%6%7>",
		Экран.Атрибут("name", Имя),
		Экран.Атрибут("value", ?(ЗначениеЗаполнено(Значение), Значение, "1")),
		Экран.АтрибутВсегда("data-checktree-state", Состояние),
		Экран.БулевАтрибут("checked", Состояние <> "off"),
		?(Состояние = "mixed", Экран.Атрибут("aria-checked", "mixed"), ""),
		Экран.БулевАтрибут("disabled", Модели.Флаг(Узел, "Отключён")),
		Данные(Узел));

КонецФункции

Функция Данные(Знач Узел)

	Данные = Модели.Значение(Узел, "Данные");
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Результат = "";
	Для Каждого КиЗ Из Данные Цикл
		Имя = "data-" + СокрЛП(Строка(КиЗ.Ключ));
		Если Экран.ИмяАтрибутаДопустимо(Имя) Тогда
			Результат = Результат + Экран.АтрибутВсегда(Имя, Строка(КиЗ.Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ДеревоНаТысячуПунктов

// --- дерево галок (выпуск 0.13) ---

// Признаки data-* дерева галок — единственное место, где они названы. Их же перечисляет
// страница «Движение» в списке «Что делает скрипт».
//
//   data-checktree             корень дерева (ul) — прежний признак
//   data-checktree-box         галка узла — прежний признак
//   data-checktree-state       состояние галки, напечатанное сервером: on | off | mixed;
//                              скрипт сверяет с ним правки и его не переписывает
//   data-checktree-set         обёртка дерева с полями 0.13: поиск, дерево, правки
//   data-checktree-edits-only  у обёртки: форма отдаёт правки, а не галки (ТолькоПравки)
//   data-checktree-page        список узлов одной ветки; значение — ключ ветки, "" — корень.
//                              В ответе адреса ветки скрипт ищет список с этим ключом
//   data-checktree-more        строка «Показать ещё» под веткой; значение — ключ ветки
//   data-checktree-modes       сегменты режима ветки; значение — ключ ветки
//   data-checktree-search      поле поиска и кнопка «Найти» над деревом
//   data-checktree-found       ответ поиска: число найденного, кнопки и совпадения
//   data-checktree-edits       ряд плашек правок (печатается hidden, показывает скрипт)
//   data-checktree-chip        шаблон плашки правки (<template>); тексты плашки —
//                              data-checktree-text-on, -off, -mode (%1 — узел, %2 — режим)
//   data-checktree-undo        крестик плашки: снимает правку (значение ставит скрипт)

Функция ПризнакСтраницы()
	Возврат "data-checktree-page";
КонецФункции

Функция ПризнакЕщё()
	Возврат "data-checktree-more";
КонецФункции

// Модель печатается новой дорогой, если в ней есть хоть одно поле выпуска 0.13: прежнее
// дерево его не видело, поэтому разметка у него прежняя.
Функция Расширено(Знач Модель)

	Возврат ЗначениеЗаполнено(Модели.Текст(Модель, "Адрес"))
		ИЛИ ЗначениеЗаполнено(Модели.Текст(Модель, "Поиск"))
		ИЛИ Модели.Флаг(Модель, "Режимы")
		ИЛИ Модели.Флаг(Модель, "ТолькоПравки")
		ИЛИ Модели.Значение(Модель, "Найдено") <> Неопределено
		ИЛИ Модели.Значение(Модель, "Ветка") <> Неопределено;

КонецФункции

Функция РасширенноеДерево(Знач Модель, Знач Узлы)

	ПроверитьЗависимости();
	Конт = Новый Структура("Адрес, Режимы",
		Модели.Текст(Модель, "Адрес"), Модели.Флаг(Модель, "Режимы"));

	Если Модели.Значение(Модель, "Ветка") <> Неопределено Тогда
		Возврат Фрагмент(Модель, Узлы, Конт);
	КонецЕсли;

	Найдено = Модели.Значение(Модель, "Найдено");
	Если Найдено = Неопределено И Узлы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив();
	Части.Добавить(СтрШаблон("<div class=""checktree-set"" data-checktree-set%1>",
		Экран.БулевАтрибут("data-checktree-edits-only", Модели.Флаг(Модель, "ТолькоПравки"))));
	Если ЗначениеЗаполнено(Модели.Текст(Модель, "Поиск")) Тогда
		Части.Добавить(ПолеПоиска(Модели.Текст(Модель, "Поиск"), Строка(?(Найдено = Неопределено, "", Найдено))));
	КонецЕсли;

	Если Найдено <> Неопределено Тогда
		Части.Добавить(НайденоHTML(Модель, Строка(Найдено), Узлы, Конт));
	Иначе
		Показано = ?(ЕстьАдрес(Конт), Первые(Узлы), Узлы);
		Части.Добавить(СтрШаблон("<ul class=""checktree"" data-checktree%1%2>%3</ul>",
			Экран.Атрибут("aria-label", Модели.Текст(Модель, "Подпись")),
			?(ЕстьАдрес(Конт), Экран.АтрибутВсегда(ПризнакСтраницы(), ""), ""),
			Узлы(Показано, 0, Конт)));
		Части.Добавить(Ещё(Конт, "", Истина, Цел(Показано.Количество() / РазмерСтраницы()) + 1,
			Показано.Количество(), Макс(ЧислоИз(Модель, "Всего"), Узлы.Количество())));
	КонецЕсли;

	Если Модели.Флаг(Модель, "ТолькоПравки") Тогда
		Части.Добавить(РядПравок());
	КонецЕсли;
	Части.Добавить("</div>");

	Возврат СтрСоединить(Части, "");

КонецФункции

// Фрагмент — ответ адреса ветки: страница её детей и «Показать ещё» до следующей. Обёртки
// нет: скрипт берёт из ответа список data-checktree-page с ключом ветки, а без скрипта
// фрагмент в каркасе страницы читается обычным списком.
Функция Фрагмент(Знач Модель, Знач Узлы, Знач Конт)

	Ключ = Модели.Текст(Модель, "Ветка");
	Номер = Макс(1, ЧислоИз(Модель, "Страница"));
	Показано = Первые(Узлы);
	До = (Номер - 1) * РазмерСтраницы() + Показано.Количество();

	Возврат СтрШаблон("<ul class=""checktree""%1%2>%3</ul>",
			Экран.АтрибутВсегда(ПризнакСтраницы(), Ключ),
			Экран.Атрибут("aria-label", Модели.Текст(Модель, "Подпись")),
			Узлы(Показано, 1, Конт))
		+ Ещё(Конт, Ключ, Ключ = "", Номер + 1, До, Макс(ЧислоИз(Модель, "Всего"), До));

КонецФункции

// «Показать ещё» — ссылка на следующую страницу ветки и счёт показанного. Без адреса
// и когда показано всё, строки нет.
Функция Ещё(Знач Конт, Знач Ключ, Знач Корень, Знач Номер, Знач Показано, Знач Всего)

	Если НЕ ЕстьАдрес(Конт) ИЛИ Показано >= Всего Тогда
		Возврат "";
	КонецЕсли;

	Ссылка = Кнопки.Отрисовать(Новый Структура("Подпись, Адрес, Вариант, Размер",
		Тексты.Текст("checktree.more"), АдресСтраницы(Конт.Адрес, Ключ, Корень, Номер), "ссылка", "малый"));
	Возврат СтрШаблон("<p class=""checktree__more checktree__page""%1>%2"
		+ "<span class=""checktree__count"">%3</span></p>",
		Экран.АтрибутВсегда(ПризнакЕщё(), Ключ), Ссылка,
		Экран.Экранировать(Тексты.Шаблон("checktree.shown", Число_(Показано), Число_(Всего))));

КонецФункции

Функция АдресСтраницы(Знач Адрес, Знач Ключ, Знач Корень, Знач Номер)

	Части = Новый Массив();
	Если НЕ Корень Тогда
		Части.Добавить(Код("ветка") + "=" + Код(Ключ));
	КонецЕсли;
	Части.Добавить(Код("страница") + "=" + Число_(Номер));
	Возврат Адрес + ?(СтрНайти(Адрес, "?") > 0, "&", "?") + СтрСоединить(Части, "&");

КонецФункции

// Поле поиска — в форме дерева, кнопка «Найти» отправляет форму на адрес поиска (без
// проверки полей: обязательное поле формы ниже не мешает искать). Скрипт эту отправку
// перехватывает и берёт ответ запросом Поиск?найти=<строка>.
Функция ПолеПоиска(Знач Адрес, Знач Запрос)

	Поле_ = Поля.Отрисовать(Новый Структура("Имя, Метка, Тип, Значение, Автозаполнение",
		ИмяПоиска(), Тексты.Текст("checktree.search"), "search", Запрос, "off"));
	Кнопка_ = Кнопки.Отрисовать(Новый Структура("Подпись, Вариант, АдресОтправки, БезВалидации",
		Тексты.Текст("checktree.search.go"), "вторичная", Адрес, Истина));
	Возврат СтрШаблон("<div class=""checktree__search"" role=""search"" data-checktree-search>%1%2</div>",
		Поле_, Кнопка_);

КонецФункции

// Ответ поиска: число найденного (role="status" — его прочтёт скринридер), «Включить /
// Снять найденные» и совпадения списком. Без скрипта кнопки отправляют форму с
// найденные=вкл | выкл: что отметить, сервер знает по строке поиска в форме.
Функция НайденоHTML(Знач Модель, Знач Запрос, Знач Узлы, Знач Конт)

	Если Узлы.Количество() = 0 Тогда
		Возврат СтрШаблон("<div class=""checktree__found"" data-checktree-found>"
			+ "<p class=""checktree__found-count"" role=""status"">%1</p></div>",
			Экран.Экранировать(Тексты.Шаблон("checktree.found.none", Запрос)));
	КонецЕсли;

	Всего = Макс(ЧислоИз(Модель, "Всего"), Узлы.Количество());
	Показано = Первые(Узлы);
	Действия = Кнопки.Отрисовать(Новый Структура("Подпись, Вариант, Размер, Имя, Значение, БезВалидации",
			Тексты.Текст("checktree.found.on"), "вторичная", "малый", ИмяНайденных(), "вкл", Истина))
		+ Кнопки.Отрисовать(Новый Структура("Подпись, Вариант, Размер, Имя, Значение, БезВалидации",
			Тексты.Текст("checktree.found.off"), "вторичная", "малый", ИмяНайденных(), "выкл", Истина));
	Обрезано = ?(Показано.Количество() < Всего, СтрШаблон("<p class=""checktree__more"">%1</p>",
		Экран.Экранировать(Тексты.Шаблон("checktree.found.cut", Число_(Показано.Количество()), Число_(Всего)))), "");

	Возврат СтрШаблон("<div class=""checktree__found"" data-checktree-found><div class=""checktree__found-head"">"
		+ "<p class=""checktree__found-count"" role=""status"">%1</p><div class=""checktree__found-actions"">%2</div></div>"
		+ "<ul class=""checktree checktree--found""%3>%4</ul>%5</div>",
		Экран.Экранировать(Тексты.Шаблон("checktree.found", Запрос, Число_(Всего))), Действия,
		Экран.Атрибут("aria-label", Модели.Текст(Модель, "Подпись")),
		Узлы(Показано, 0, Конт), Обрезано);

КонецФункции

// Ряд правок под деревом — над кнопками формы. Пуст и спрятан: правки копит скрипт,
// плашку он клонирует из шаблона, напечатанного здесь; без скрипта ряда не видно.
Функция РядПравок()

	Плашка = СтрШаблон("<span class=""chips-in__chip checktree__edit"" role=""listitem"">"
		+ "<span class=""chips-in__text""></span><button type=""button"" class=""chips-in__remove""%1"
		+ " data-checktree-undo>%2</button></span>",
		Экран.Атрибут("aria-label", Тексты.Шаблон("checktree.edit.undo", "%1")), Значки.Отрисовать("закрыть"));

	Возврат СтрШаблон("<div class=""checktree__edits"" data-checktree-edits hidden>"
		+ "<span class=""checktree__edits-label"">%1</span><span class=""checktree__edits-list"" role=""list""></span>"
		+ "<template data-checktree-chip%2%3%4>%5</template></div>",
		Экран.Экранировать(Тексты.Текст("checktree.edits")),
		Экран.АтрибутВсегда("data-checktree-text-on", Тексты.Шаблон("checktree.edit.on", "%1")),
		Экран.АтрибутВсегда("data-checktree-text-off", Тексты.Шаблон("checktree.edit.off", "%1")),
		Экран.АтрибутВсегда("data-checktree-text-mode", Тексты.Шаблон("checktree.edit.mode", "%1", "%2")),
		Плашка);

КонецФункции

// Сегменты режима — та же разметка, что у Кит.Сегменты со словом Малые (холст/Сегменты.os):
// меняйте обе. Своим рисователем сегментов компонент не пользуется — тот сам опирается на
// набор компонентов, в котором живёт дерево. Радиокнопки «режим:<ключ>» — своё имя у каждой
// ветки: одно имя на всех сделало бы из режимов всех веток одну группу.
Функция РежимыВетки(Знач Узел)

	Ключ = Ключ(Узел);
	Выбран = Режим(Узел);
	Отключён = Модели.Флаг(Узел, "Отключён");
	Галочка = Значки.Отрисовать("галочка");

	Части = Новый Массив();
	Части.Добавить(СтрШаблон("<div class=""segments segments--small checktree__modes"" role=""radiogroup""%1%2>",
		Экран.Атрибут("aria-label", Тексты.Шаблон("checktree.mode", Модели.Текст(Узел, "Подпись"))),
		Экран.АтрибутВсегда("data-checktree-modes", Ключ)));
	Подписи = СтрРазделить("checktree.mode.all,checktree.mode.picked,checktree.mode.none", ",");
	Номер = 0;
	Для Каждого Режим Из ИзвестныеРежимы() Цикл
		Части.Добавить(СтрШаблон("<label class=""segments__item""><input type=""radio"""
			+ " class=""segments__input""%1%2%3%4><span class=""segments__label"">"
			+ "<span class=""segments__check"" aria-hidden=""true"">%5</span>"
			+ "<span class=""segments__text"">%6</span></span></label>",
			Экран.Атрибут("name", ПриставкаРежима() + Ключ),
			Экран.АтрибутВсегда("value", Режим),
			Экран.БулевАтрибут("checked", Режим = Выбран),
			Экран.БулевАтрибут("disabled", Отключён),
			Галочка, Экран.Экранировать(Тексты.Текст(Подписи[Номер]))));
		Номер = Номер + 1;
	КонецЦикла;
	Части.Добавить("</div>");
	Возврат СтрСоединить(Части, "");

КонецФункции

// Режим ветки — из модели, а без него — из состояния: «включена» и есть «все», «снята» —
// «никакие», «частично» — «выбранные».
Функция Режим(Знач Узел)

	Режим = НРег(СокрЛП(Модели.Текст(Узел, "Режим")));
	Если НЕ ЗначениеЗаполнено(Режим) Тогда
		Состояние = Состояние(Узел);
		Возврат ?(Состояние = "on", "все", ?(Состояние = "off", "никакие", "выбранные"));
	КонецЕсли;
	Если ИзвестныеРежимы().Найти(Режим) = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Компонент «Дерево галок»: режима ветки «%1» не бывает —"
			+ " ветка «все», «выбранные» или «никакие».", Режим);
	КонецЕсли;
	Возврат Режим;

КонецФункции

// Порядок режимов — порядок сегментов: лист кита узнаёт «все» и «никакие» по месту.
Функция ИзвестныеРежимы()
	Возврат СтрРазделить("все,выбранные,никакие", ",");
КонецФункции

// Ключ узла — то, по чему сервер его узнаёт: своё значение галки, а при значении по
// умолчанию — её имя. Скрипт считает ключ тем же правилом.
Функция Ключ(Знач Узел)

	Значение = Модели.Текст(Узел, "Значение");
	Если ЗначениеЗаполнено(Значение) И Значение <> "1" Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПроверитьИмя(Узел);

КонецФункции

Функция Первые(Знач Узлы)

	Если Узлы.Количество() <= РазмерСтраницы() Тогда
		Возврат Узлы;
	КонецЕсли;
	Результат = Новый Массив();
	Для Номер = 0 По РазмерСтраницы() - 1 Цикл
		Результат.Добавить(Узлы[Номер]);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ЕстьАдрес(Знач Конт)
	Возврат Конт <> Неопределено И ЗначениеЗаполнено(Конт.Адрес);
КонецФункции

Функция СРежимами(Знач Конт)
	Возврат Конт <> Неопределено И Конт.Режимы;
КонецФункции

Функция ЧислоИз(Знач Модель, Знач Поле)

	Значение = Модели.Значение(Модель, Поле);
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Цел(Значение);
	КонецЕсли;
	Попытка
		Возврат ?(ЗначениеЗаполнено(Значение), Цел(Число(Значение)), 0);
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция ИмяПоиска()
	Возврат "найти";
КонецФункции

Функция ИмяНайденных()
	Возврат "найденные";
КонецФункции

Функция ИмяПравок()
	Возврат "правки";
КонецФункции

Функция ПриставкаРежима()
	Возврат "режим:";
КонецФункции

Функция Код(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Раскодировать(Знач Текст)
	Возврат РаскодироватьСтроку(СтрЗаменить(Текст, "+", " "), СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Число_(Знач Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

// Компонент, собранный руками по-старому (три зависимости), печатает прежнее дерево;
// поля 0.13 без словаря, значков, кнопок и поля напечатать нечем.
Процедура ПроверитьЗависимости()

	Если Тексты = Неопределено ИЛИ Значки = Неопределено ИЛИ Кнопки = Неопределено ИЛИ Поля = Неопределено Тогда
		ВызватьИсключение "Компонент «Дерево галок»: поля выпуска 0.13 (Адрес, Поиск, Режимы,"
			+ " ТолькоПравки, Найдено, Ветка) печатаются словарём, значками, кнопкой и полем —"
			+ " соберите компонент со всеми зависимостями: Новый ДеревоГалок(Экран, Модели, Плашки,"
			+ " Тексты, Значки, Кнопки, Поля).";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// --- дерево галок (выпуск 0.13): с адресом ветка — и узел без детей, у которого Всего > 0:
// её дети приедут по адресу
Функция ЭтоВетка(Знач Узел, Знач Конт = Неопределено)

	Если ТипЗнч(Узел) = Тип("Структура") И Узел.Свойство("Дети") И ТипЗнч(Узел.Дети) = Тип("Массив") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ЕстьАдрес(Конт) И ЧислоИз(Узел, "Всего") > 0;

КонецФункции

Функция ПроверитьИмя(Знач Узел)

	Имя = Модели.Текст(Узел, "Имя");
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		ВызватьИсключение "Компонент «Дерево галок»: у узла нет Имени — галка без имени"
			+ " в форму не уходит, и выбор пропал бы молча.";
	КонецЕсли;
	Возврат Имя;

КонецФункции

// Состояние уходит в разметку словом скрипта страницы: on | off | mixed.
Функция Состояние(Знач Узел)

	Значение = НРег(СокрЛП(Модели.Текст(Узел, "Состояние", "вкл")));
	Если Значение = "вкл" Тогда
		Возврат "on";
	ИначеЕсли Значение = "выкл" Тогда
		Возврат "off";
	ИначеЕсли Значение = "частично" Тогда
		Возврат "mixed";
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Компонент «Дерево галок»: состояния «%1» не бывает —"
		+ " узел «вкл», «выкл» или «частично».", Значение);

КонецФункции

#КонецОбласти

// Тексты, Значки, Кнопки и Поля (выпуск 0.13) необязательны: компонент, собранный руками
// по-старому, печатает прежнее дерево.
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Плашка") _Плашки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты = Неопределено,
	&Пластилин(Значение = "Иконка") _Значки = Неопределено,
	&Пластилин(Значение = "Кнопка") _Кнопки = Неопределено,
	&Пластилин(Значение = "ПолеФормы") _Поля = Неопределено) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Плашки = _Плашки;
	Тексты = _Тексты;
	Значки = _Значки;
	Кнопки = _Кнопки;
	Поля = _Поля;

КонецПроцедуры
