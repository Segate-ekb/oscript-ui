// Компонент «Меню» — желудь UI-кита: кнопка-открывашка и панель пунктов при ней.
// Панель уходит в ВЕРХНИЙ СЛОЙ браузера (атрибут popover): она не в потоке, поэтому
// строка не растёт, и её не обрезает предок с overflow.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Кнопки;  // Кнопка

Перем Выдано;  // сколько панелей выдано: порядковый номер и есть идентификатор связи

// Отрисовывает меню: кнопку-открывашку и её панель.
//
// Параметры:
//  Модель - Структура - Подпись (обязательна: имя кнопки для скринридера), Иконка
//           (по умолчанию "шестерёнка", у меню учётки — "аккаунт"), Аккаунт (имя,
//           которое кнопка показывает ТЕКСТОМ: с ним открывашка печатается учёткой —
//           значок, имя и шеврон раскрытия, — а без него остаётся кнопкой-значком),
//           Счётчик (число на открывашке; ноль и отсутствие бейджа не печатают),
//           ПодписьСчётчика (чем это число называется в речи; обязательна, когда бейдж
//           печатается), Пункты (Массив: либо модель кнопки-ссылки — Подпись, Адрес,
//           Иконка, — либо структура с полем HTML: ДОВЕРЕННЫЙ фрагмент, например форма
//           или примечание. Пункт без Адреса и без HTML пропускается).
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент. Кидается исключением, если Подпись пуста либо панель
//           осталась пустой.
//
Функция Отрисовать(Знач Модель) Экспорт

	Подпись = Модели.Текст(Модель, "Подпись");
	ПроверитьПодпись(Подпись);

	Панель = ПунктыHTML(Модели.Список(Модель, "Пункты"));
	ПроверитьПанель(Подпись, Панель);

	Ид = СледующийИдентификатор();

	Возврат СтрШаблон("<div class=""menu"">%1<div%2 popover class=""menu__panel"">%3</div></div>",
		Открывашка(Модель, Подпись, Ид),
		Экран.Атрибут("id", Ид),
		Панель);

КонецФункции

// Идентификатор связи генерирует КИТ порядковым номером. Значение из данных в него
// не попадает вовсе: два похожих имени дали бы один идентификатор, и кнопка открыла бы
// чужое меню — в чужой строке.
//
// ⚠ ИЗВЕСТНЫЙ ДОЛГ. Счётчик живёт на желуде, а желудь — одиночка на весь процесс, поэтому
// номер растёт ЧЕРЕЗ запросы: страница со строчным меню от запроса к запросу отдаёт разную
// разметку, и побайтовое сравнение ответов (метка ответа, кэш) на ней не работает.
// Константой это не лечится — строчных меню на странице много; счётчик уровня рендера
// упирается в общий на потоки желудь. Решение отдельное, за пределами этого класса.
Функция СледующийИдентификатор()

	Выдано = Выдано + 1;
	Возврат "menu-" + Формат(Выдано, "ЧН=0; ЧГ=0");

КонецФункции

// Связь кнопки с панелью — атрибут popovertarget. Открытие, закрытие щелчком мимо и по
// Esc, возврат фокуса на кнопку и состояние «открыто» для вспомогательных технологий
// даёт движок браузера; своего кода здесь нет. Тип «обычная»: кнопка ничего не отправляет,
// иначе меню внутри формы отправляло бы её при попытке открыться.
Функция Открывашка(Знач Модель, Знач Подпись, Знач Ид)

	Аккаунт = Модели.Текст(Модель, "Аккаунт");

	Возврат ?(ЗначениеЗаполнено(Аккаунт),
		КнопкаУчётки(Модель, Подпись, Ид, Аккаунт),
		КнопкаЗначка(Модель, Подпись, Ид));

КонецФункции

// Открывашка-значок: подпись у неё есть, но живёт в aria-label — в строке таблицы,
// откуда это меню родом, места под текст нет.
Функция КнопкаЗначка(Знач Модель, Знач Подпись, Знач Ид)

	Возврат Кнопки.Отрисовать(Новый Структура(
		"Подпись, Вариант, Размер, Иконка, ТолькоИконка, Тип, Открывает,"
			+ " Счётчик, ПодписьСчётчика",
		Подпись, "вторичная", "малый", Модели.Текст(Модель, "Иконка", "шестерёнка"),
		Истина, "обычная", Ид,
		Модели.Значение(Модель, "Счётчик"), Модели.Текст(Модель, "ПодписьСчётчика")));

КонецФункции

// Открывашка-учётка: значок, имя и шеврон раскрытия в одной кнопке. Видимый текст — само
// имя, поэтому подпись меню уходит в подсказку: спрятать имя в aria-label и назвать кнопку
// иначе значило бы читать скринридеру не то, что человек видит на экране.
Функция КнопкаУчётки(Знач Модель, Знач Подпись, Знач Ид, Знач Аккаунт)

	Возврат Кнопки.Отрисовать(Новый Структура(
		"Подпись, Подсказка, Вариант, Размер, Иконка, ЗнакРаскрытия, Тип, Открывает,"
			+ " Счётчик, ПодписьСчётчика",
		Аккаунт, Подпись, "вторичная", "малый", Модели.Текст(Модель, "Иконка", "аккаунт"),
		Истина, "обычная", Ид,
		Модели.Значение(Модель, "Счётчик"), Модели.Текст(Модель, "ПодписьСчётчика")));

КонецФункции

// Вид и размер пунктов задаёт меню: вызывающему остаются подпись, адрес и значок.
Функция ПунктыHTML(Знач Пункты)

	Результат = "";

	Для Каждого Пункт Из Пункты Цикл

		Готовый = Модели.Текст(Пункт, "HTML");
		Если ЗначениеЗаполнено(Готовый) Тогда
			Результат = Результат + Готовый;
			Продолжить;
		КонецЕсли;

		Адрес = Модели.Текст(Пункт, "Адрес");
		Если НЕ ЗначениеЗаполнено(Адрес) Тогда
			Продолжить;
		КонецЕсли;

		Результат = Результат + Кнопки.Отрисовать(Новый Структура(
			"Подпись, Адрес, Иконка, Вариант, Размер",
			Модели.Текст(Пункт, "Подпись"), Адрес, Модели.Текст(Пункт, "Иконка"),
			"вторичная", "малый"));

	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ПроверитьПодпись(Знач Подпись)

	Если ЗначениеЗаполнено(Подпись) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение "Компонент «Меню»: не задана Подпись. Кнопка-шестерёнка не несёт"
		+ " видимого текста, и без подписи её не прочитает скринридер, а одинаковых"
		+ " меню в списке столько же, сколько строк.";

КонецПроцедуры

Процедура ПроверитьПанель(Знач Подпись, Знач Панель)

	Если ЗначениеЗаполнено(Панель) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Компонент «Меню» (%1): в панели нет ни одного пункта"
		+ " с Адресом или готовым HTML. Кнопка, открывающая пустоту, — сломанный экран:"
		+ " не печатайте меню вовсе.", Подпись);

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Кнопка") _Кнопки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Кнопки = _Кнопки;
	Выдано = 0;

КонецПроцедуры
