// Компонент «Крошки» — желудь UI-кита: путь от корня к текущей странице строкой ссылок.
// Последний пункт — сама страница: ссылка на неё только вернула бы человека туда, где он
// уже стоит, поэтому он печатается текстом и помечен aria-current.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Тексты;  // ТекстыИнтерфейса

// Отрисовывает крошки.
//
// Параметры:
//  Модель - Структура, Массив - Пункты (массив структур: Подпись, Адрес — пустой адрес
//           печатает пункт текстом; у последнего пункта адрес не печатается вовсе),
//           Подпись (aria-label навигации; по умолчанию текст словаря «chrome.crumbs»).
//           Массив на месте модели — сами пункты.
//
// Возвращаемое значение:
//  Строка - фрагмент <nav class="crumbs"> либо "" для пустого списка: строка без пунктов
//           ни о чём не говорит, а место занимает.
//
Функция Отрисовать(Знач Модель) Экспорт

	Если ТипЗнч(Модель) = Тип("Массив") Тогда
		Модель = Новый Структура("Пункты", Модель);
	КонецЕсли;

	Пункты = Модели.Список(Модель, "Пункты");
	Если Пункты.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив();
	Последний = Пункты.ВГраница();
	Для Номер = 0 По Последний Цикл
		Части.Добавить(Пункт(Пункты[Номер], Номер = Последний));
	КонецЦикла;

	Подпись = Модели.Текст(Модель, "Подпись");
	Если НЕ ЗначениеЗаполнено(Подпись) Тогда
		Подпись = Тексты.Текст("chrome.crumbs");
	КонецЕсли;

	Возврат СтрШаблон("<nav class=""crumbs""%1><ul class=""crumbs__list"">%2</ul></nav>",
		Экран.Атрибут("aria-label", Подпись), СтрСоединить(Части, ""));

КонецФункции

// Текущий пункт несёт aria-current на самом пункте: ссылки у него нет, а скринридер должен
// прочесть «текущая страница», а не просто последнее слово строки.
Функция Пункт(Знач Описание, Знач Текущий)

	Подпись = Модели.Текст(Описание, "Подпись");
	Если Текущий Тогда
		Возврат СтрШаблон("<li class=""crumbs__item"" aria-current=""page"">%1</li>",
			Экран.Экранировать(Подпись));
	КонецЕсли;

	Адрес = Модели.Текст(Описание, "Адрес");
	Содержимое = ?(ЗначениеЗаполнено(Адрес),
		Экран.Ссылка(Адрес, Подпись, "crumbs__link"), Экран.Экранировать(Подпись));
	Возврат СтрШаблон("<li class=""crumbs__item"">%1</li>", Содержимое);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Тексты = _Тексты;

КонецПроцедуры
