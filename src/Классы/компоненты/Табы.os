// Компонент «Табы» — желудь UI-кита: полоса вкладок страницы объекта.
// Каждая вкладка — свой URL, обычный список ссылок; панель содержимого рисует контроллер.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Значки;  // Иконка

// Отрисовывает полосу вкладок.
//
// Параметры:
//  Модель - Структура - Вкладки (массив структур: Подпись, Адрес — ОБЯЗАТЕЛЕН, Активна,
//           Иконка, Счётчик), Заголовок (aria-label, "Разделы страницы"), Класс.
//
// Возвращаемое значение:
//  Строка - фрагмент <nav class="tabs"> либо "" для пустого списка. Кидается
//           исключением, если у вкладки нет Адреса.
//
Функция Отрисовать(Знач Модель) Экспорт

	Вкладки = Модели.Список(Модель, "Вкладки");
	Если Вкладки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Пункты = "";
	Для Каждого Вкладка Из Вкладки Цикл
		Пункты = Пункты + Пункт(Вкладка);
	КонецЦикла;

	Дополнительный = НормализованныйКласс(Модели.Текст(Модель, "Класс"));
	Классы = "tabs" + ?(ЗначениеЗаполнено(Дополнительный), " " + Дополнительный, "");

	Возврат СтрШаблон("<nav%1%2><ul class=""tabs__list"">%3</ul></nav>",
		Экран.Атрибут("class", Классы),
		Экран.Атрибут("aria-label", Модели.Текст(Модель, "Заголовок", "Разделы страницы")),
		Пункты);

КонецФункции

Функция Пункт(Знач Вкладка)

	Подпись = Модели.Текст(Вкладка, "Подпись");
	Адрес = Модели.Текст(Вкладка, "Адрес");
	ПроверитьАдрес(Подпись, Адрес);

	Активна = Модели.Флаг(Вкладка, "Активна");
	Классы = "tabs__link" + ?(Активна, " tabs__link--active", "");

	Счётчик = Модели.Текст(Вкладка, "Счётчик");
	Внутри = Значки.Отрисовать(Модели.Текст(Вкладка, "Иконка"))
		+ СтрШаблон("<span>%1</span>", Экран.Экранировать(Подпись))
		+ ?(ЗначениеЗаполнено(Счётчик),
			СтрШаблон("<span class=""tabs__count"">%1</span>", Экран.Экранировать(Счётчик)), "");

	// небезопасная схема — вкладка видима, но не ссылка; aria-current только у активной:
	// значение "false" скринридеры трактуют неодинаково, а отсутствие — однозначно
	Если Экран.URLБезопасенДляHref(Адрес) Тогда
		ПунктHTML = СтрШаблон("<a href=""%1""%2%3>%4</a>",
			Экран.Экранировать(Адрес),
			Экран.Атрибут("class", Классы),
			?(Активна, " aria-current=""page""", ""),
			Внутри);
	Иначе
		ПунктHTML = СтрШаблон("<span%1>%2</span>",
			Экран.Атрибут("class", Классы + " tabs__link--plain"), Внутри);
	КонецЕсли;

	Возврат СтрШаблон("<li class=""tabs__item"">%1</li>", ПунктHTML);

КонецФункции

// Приводит дополнительный класс контейнера к allowlist: значение из модели попадает
// в CSS-класс.
//
// Параметры:
//  Класс - Произвольный - класс из модели.
//
// Возвращаемое значение:
//  Строка - "tabs--settings" либо "" для чужого значения.
//
Функция НормализованныйКласс(Знач Класс) Экспорт

	Значение = НРег(СокрЛП(?(Класс = Неопределено, "", Строка(Класс))));

	Если Значение = "tabs--settings" ИЛИ Значение = "настройки" Тогда
		Возврат "tabs--settings";
	КонецЕсли;

	Возврат "";

КонецФункции

Процедура ПроверитьАдрес(Знач Подпись, Знач Адрес)

	Если ЗначениеЗаполнено(Адрес) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Компонент «Табы»: у вкладки «%1» не задан Адрес. Каждая вкладка обязана быть"
		+ " отдельным URL — иначе её нельзя ни открыть ссылкой, ни вернуть кнопкой «назад».",
		?(ЗначениеЗаполнено(Подпись), Подпись, "без подписи"));

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Иконка") _Значки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Значки = _Значки;

КонецПроцедуры
