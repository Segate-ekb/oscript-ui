// Компонент «Полоса заполнения» — желудь UI-кита: индикатор доли занятого.
// Это показание, а не орган управления: значение не меняется мышью и не требует JS.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели

// Отрисовывает полосу заполнения.
//
// Параметры:
//  Модель - Структура - Процент (ОБЯЗАТЕЛЕН, Число; больше 100 — переполнение: полоса
//           полна, aria-valuenow держится в объявленном максимуме, истинная величина
//           остаётся в подписи и доступном имени),
//           Метка (ОБЯЗАТЕЛЬНА — доступное имя индикатора), Подпись (абсолютные величины
//           рядом с процентом; форматирует вызывающий — компонент не знает единиц),
//           Вид ("" | "ok" | "warn" | "err"; пустой выводится из процента),
//           Компактная (Булево — вариант для ячейки таблицы, без текстовой строки).
//
// Возвращаемое значение:
//  Строка - фрагмент <div class="meter">. Кидается исключением, если Процент не число
//           или пуста Метка.
//
Функция Отрисовать(Знач Модель) Экспорт

	Процент = ПроверенныйПроцент(Модель);
	Метка = Модели.Текст(Модель, "Метка");
	Если НЕ ЗначениеЗаполнено(Метка) Тогда
		ВызватьИсключение "Компонент «Полоса заполнения»: Метка обязательна —"
			+ " без неё индикатор не назовёт себя скринридеру";
	КонецЕсли;

	Подпись = Модели.Текст(Модель, "Подпись");
	Компактная = Модели.Флаг(Модель, "Компактная");
	Вид = ?(ЗначениеЗаполнено(Модели.Текст(Модель, "Вид")),
		НормализованныйВид(Модели.Текст(Модель, "Вид")), ВидПоПроценту(Процент));

	Классы = "meter" + ?(ЗначениеЗаполнено(Вид), " meter--" + Вид, "")
		+ ?(Компактная, " meter--compact", "");

	// Доступное имя собирается в один атрибут: скринридер читает индикатор одной
	// фразой, а не «Заполнение пула» и отдельно проценты неизвестно от чего.
	ТекстСостояния = ЦелоеТекстом(Процент) + "%" + ?(ЗначениеЗаполнено(Подпись), ", " + Подпись, "");

	Шкала = СтрШаблон("<div class=""meter__track"" role=""progressbar""%1%2%3%4>%5</div>",
		Экран.Атрибут("aria-valuenow", ЦелоеТекстом(Мин(100, Процент))),
		Экран.Атрибут("aria-valuemin", "0"),
		Экран.Атрибут("aria-valuemax", "100"),
		Экран.Атрибут("aria-label", Метка + ": " + ТекстСостояния),
		ЗаливкаHTML(Процент));

	Возврат СтрШаблон("<div%1>%2%3</div>",
		Экран.Атрибут("class", Классы), Шкала, СтрокаЗначения(Компактная, Метка, ТекстСостояния));

КонецФункции

// Приводит вид полосы к allowlist: значение из модели попадает в CSS-класс.
//
// Параметры:
//  Вид - Произвольный - вид из модели.
//
// Возвращаемое значение:
//  Строка - "ok" | "warn" | "err" либо "" для нейтральной полосы.
//
Функция НормализованныйВид(Знач Вид) Экспорт

	Значение = НРег(СокрЛП(?(Вид = Неопределено, "", Строка(Вид))));

	Если Значение = "ok" ИЛИ Значение = "успех" Тогда
		Возврат "ok";
	ИначеЕсли Значение = "warn" ИЛИ Значение = "предупреждение" Тогда
		Возврат "warn";
	ИначеЕсли Значение = "err" ИЛИ Значение = "error" ИЛИ Значение = "ошибка" Тогда
		Возврат "err";
	КонецЕсли;

	Возврат "";

КонецФункции

// Тон полосы по проценту, когда вызывающий его не назвал: близость к пределу видна
// цветом, но цвет не единственный носитель смысла — процент напечатан текстом.
//
// Параметры:
//  Процент - Число - доля заполнения.
//
// Возвращаемое значение:
//  Строка - "" | "warn" | "err".
//
Функция ВидПоПроценту(Знач Процент) Экспорт

	Если Процент >= 90 Тогда
		Возврат "err";
	ИначеЕсли Процент >= 75 Тогда
		Возврат "warn";
	КонецЕсли;
	Возврат "";

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ПроверенныйПроцент(Знач Модель)

	Значение = Неопределено;
	Если ТипЗнч(Модель) = Тип("Структура") Тогда
		Модель.Свойство("Процент", Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Число") Тогда
		ВызватьИсключение "Компонент «Полоса заполнения»: Процент обязателен и должен быть числом";
	КонецЕсли;
	Возврат Макс(0, Цел(Значение));

КонецФункции

// Ширина берётся классом-ступенью, а не инлайновым стилем: в ките инлайновых стилей нет.
// Ступень округляется ВНИЗ — индикатор предела не вправе преувеличивать остаток; истинная
// величина остаётся в тексте и в доступном имени. Пустая полоса заливки не печатает вовсе,
// поэтому у ненулевой доли всегда виден хотя бы просвет.
Функция ЗаливкаHTML(Знач Процент)

	Если Процент <= 0 Тогда
		Возврат "";
	КонецЕсли;
	Ступень = Цел(Мин(100, Процент) / ШагСтупени()) * ШагСтупени();
	Возврат СтрШаблон("<div%1></div>",
		Экран.Атрибут("class", "meter__fill meter__fill--" + ЦелоеТекстом(Ступень)));

КонецФункции

Функция ШагСтупени()
	Возврат 5;
КонецФункции

Функция СтрокаЗначения(Знач Компактная, Знач Метка, Знач ТекстСостояния)

	Если Компактная Тогда
		Возврат ""; // в ячейке таблицы подпись читается из aria-label
	КонецЕсли;
	Возврат СтрШаблон("<p class=""meter__value""><span class=""meter__label"">%1</span>%2</p>",
		Экран.Экранировать(Метка), Экран.Экранировать(ТекстСостояния));

КонецФункции

Функция ЦелоеТекстом(Знач Значение)
	Возврат Формат(Цел(Значение), "ЧГ=0; ЧН=0");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели) Экспорт

	Экран = _Экран;
	Модели = _Модели;

КонецПроцедуры
