// Компонент «Карточка» — желудь UI-кита: поверхность контента.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Значки;  // Иконка

// Отрисовывает карточку.
//
// Параметры:
//  Модель - Структура - Заголовок (экранируется), Адрес (заголовок становится ссылкой),
//           Описание, Иконка, Класс, Уровень (заголовка, 1..6, по умолчанию 2),
//           Якорь (атрибут id — цель ссылки на эту карточку),
//           Тело и Действия — ДОВЕРЕННЫЙ HTML, собранный вызывающим через кит.
//
// Возвращаемое значение:
//  Строка - фрагмент <section class="card">.
//
Функция Отрисовать(Знач Модель) Экспорт

	Тело = Модели.Текст(Модель, "Тело");
	Действия = Модели.Текст(Модель, "Действия");

	Содержимое = ?(ЗначениеЗаполнено(Тело), СтрШаблон("<div class=""card__body"">%1</div>", Тело), "");
	Низ = ?(ЗначениеЗаполнено(Действия), СтрШаблон("<div class=""card__actions"">%1</div>", Действия), "");

	Возврат Контейнер(Новый Структура("Заголовок, Описание, Адрес, Иконка, Уровень, Классы, Якорь, ВнутриHTML",
		Модели.Текст(Модель, "Заголовок"),
		Модели.Текст(Модель, "Описание"),
		Модели.Текст(Модель, "Адрес"),
		Модели.Текст(Модель, "Иконка"),
		Модели.Значение(Модель, "Уровень"),
		Модели.Текст(Модель, "Класс"),
		Модели.Текст(Модель, "Якорь"),
		Содержимое + Низ));

КонецФункции

// Отрисовывает общий контейнер поверхности контента — карточку либо секцию настроек.
// Имена классов записаны целиком в обеих ветках: склеенный из кусков класс выпал бы
// из корпуса скана «мёртвых правил CSS» (ложная мёртвость section__title).
//
// Параметры:
//  Модель - Структура - Префикс ("card" по умолчанию либо "section": заголовок и лид
//           уходят в <header class="section__head">), Заголовок, Описание, Адрес,
//           Иконка, Уровень (1..6, по умолчанию 2), Классы, Якорь (атрибут id),
//           ВнутриHTML (ДОВЕРЕННАЯ разметка после шапки).
//
// Возвращаемое значение:
//  Строка - фрагмент <section>.
//
Функция Контейнер(Знач Модель) Экспорт

	Секция = (Модели.Текст(Модель, "Префикс") = "section");
	Заголовок = Модели.Текст(Модель, "Заголовок");
	Описание = Модели.Текст(Модель, "Описание");
	Адрес = Модели.Текст(Модель, "Адрес");
	ИмяИконки = Модели.Текст(Модель, "Иконка");
	Классы = Модели.Текст(Модель, "Классы");

	Шапка = "";
	Если ЗначениеЗаполнено(Заголовок) Тогда
		Тег = ТегЗаголовка(Модель);
		Подпись = Значки.Отрисовать(ИмяИконки) + Экран.Экранировать(Заголовок);
		Если ЗначениеЗаполнено(Адрес) Тогда
			Подпись = Экран.Ссылка(Адрес, Заголовок, "", Подпись);
		КонецЕсли;
		Шапка = СтрШаблон("<%1 class=""%2"">%3</%1>",
			Тег, ?(Секция, "section__title", "card__title"), Подпись);
	КонецЕсли;

	Если ЗначениеЗаполнено(Описание) Тогда
		Шапка = Шапка + СтрШаблон("<p class=""%1"">%2</p>",
			?(Секция, "section__lead", "card__lead"), Экран.Экранировать(Описание));
	КонецЕсли;

	Если ЗначениеЗаполнено(Шапка) И Секция Тогда
		Шапка = СтрШаблон("<header class=""section__head"">%1</header>", Шапка);
	КонецЕсли;

	Возврат СтрШаблон("<section%1%2>%3%4</section>",
		Экран.Атрибут("class", ?(Секция, "section", "card")
			+ ?(ЗначениеЗаполнено(Классы), " " + Классы, "")),
		Экран.Атрибут("id", Модели.Текст(Модель, "Якорь")),
		Шапка,
		Модели.Текст(Модель, "ВнутриHTML"));

КонецФункции

Функция ТегЗаголовка(Знач Модель)

	Уровень = Модели.Значение(Модель, "Уровень");

	Попытка
		Номер = ?(Уровень = Неопределено, 2, Число(Уровень));
	Исключение
		Номер = 2;
	КонецПопытки;

	Если Номер < 1 ИЛИ Номер > 6 Тогда
		Номер = 2;
	КонецЕсли;

	Возврат "h" + Формат(Номер, "ЧН=; ЧГ=0");

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Иконка") _Значки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Значки = _Значки;

КонецПроцедуры
