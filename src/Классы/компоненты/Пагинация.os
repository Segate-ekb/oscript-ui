// Компонент «Пагинация» — желудь UI-кита: постраничная навигация списков.
// Адреса страниц собирает компонент, а не вызывающий: иначе отбор теряется при переходе.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Значки;  // Иконка
Перем Тексты;  // ТекстыИнтерфейса, Неопределено — строка «N из M» (выпуск 0.13)

// Отрисовывает постраничную навигацию.
//
// Параметры:
//  Модель - Структура - Страница (текущая, с 1), ВсегоСтраниц, ЕстьСледующая (Булево —
//           для списков, где число страниц неизвестно: за ним нет счёта строк), Основа
//           (базовый путь списка, ОБЯЗАТЕЛЕН), Параметр (имя параметра страницы, "page"),
//           Параметры (массив структур Имя, Значение — переживают переход), ПодписьНазад,
//           ПодписьВперёд, Заголовок (aria-label). Выпуск 0.13: Всего (сколько записей
//           в списке) и НаСтранице (сколько их на странице) — вместе печатают «41–60 из 137»
//           текстом словаря «pagination.of» и, если ВсегоСтраниц не задано, считают его;
//           БезПерезагрузки (Булево) — ссылки страниц уходят тихо (data-quiet), а состояние
//           читается скринридером при смене (aria-live).
//
// Возвращаемое значение:
//  Строка - фрагмент <nav class="pagination"> либо "" при единственной странице. Кидается
//           исключением, если Основа пуста или её схема недопустима.
//
Функция Отрисовать(Знач Модель) Экспорт

	// гейт до раннего возврата: иначе забытая основа не всплывёт на коротком списке
	ПроверитьОснову(Модели.Текст(Модель, "Основа"));

	Всего = Целое(Модели.Значение(Модель, "ВсегоСтраниц"));
	// --- страницы и отбор без перезагрузки (выпуск 0.13): число страниц из числа записей
	Записей = Целое(Модели.Значение(Модель, "Всего"));
	НаСтранице = Целое(Модели.Значение(Модель, "НаСтранице"));
	Если Всего <= 0 И Записей > 0 И НаСтранице > 0 Тогда
		Всего = Цел((Записей + НаСтранице - 1) / НаСтранице);
	КонецЕсли;
	ЕстьСледующая = Модели.Флаг(Модель, "ЕстьСледующая");

	Если Всего > 1 Тогда
		Текущая = Мин(Макс(1, Целое(Модели.Значение(Модель, "Страница"))), Всего);
		ВперёдЕсть = Текущая < Всего;
		Состояние = СтрШаблон("Страница %1 из %2",
			Формат(Текущая, "ЧН=0; ЧГ=0"), Формат(Всего, "ЧН=0; ЧГ=0"));
	Иначе
		// Числа страниц нет: номер последней знал бы только счёт строк. Тогда «вперёд»
		// печатается по явному признаку, а «назад» — по номеру текущей, иначе уход
		// со второй страницы был бы дорогой в один конец.
		Текущая = Макс(1, Целое(Модели.Значение(Модель, "Страница")));
		Если НЕ ЕстьСледующая И Текущая <= 1 Тогда
			Возврат "";
		КонецЕсли;
		ВперёдЕсть = ЕстьСледующая;
		Состояние = СтрШаблон("Страница %1", Формат(Текущая, "ЧН=0; ЧГ=0"));
	КонецЕсли;

	Назад = "";
	Если Текущая > 1 Тогда
		Назад = Ссылка(Модель, Текущая - 1, Модели.Текст(Модель, "ПодписьНазад", "Назад"),
			"pagination__link pagination__link--prev", "prev", "влево");
	КонецЕсли;

	Вперёд = "";
	Если ВперёдЕсть Тогда
		Вперёд = Ссылка(Модель, Текущая + 1, Модели.Текст(Модель, "ПодписьВперёд", "Вперёд"),
			"pagination__link pagination__link--next", "next", "вправо");
	КонецЕсли;

	Возврат СтрШаблон("<nav class=""pagination""%1>%2%3%4%5</nav>",
		Экран.Атрибут("aria-label", Модели.Текст(Модель, "Заголовок", "Постраничная навигация")),
		Назад,
		СтрШаблон("<span class=""pagination__status""%1>%2</span>", Живое(Модель),
			Экран.Экранировать(Состояние)),
		Счёт(Текущая, Записей, НаСтранице),
		Вперёд);

КонецФункции

Функция Ссылка(Знач Модель, Знач Номер, Знач Подпись, Знач Класс, Знач Отношение, Знач ИмяИконки)

	Внутри = ?(Отношение = "prev", Значки.Отрисовать(ИмяИконки), "")
		+ СтрШаблон("<span>%1</span>", Экран.Экранировать(Подпись))
		+ ?(Отношение = "next", Значки.Отрисовать(ИмяИконки), "");

	Возврат СтрШаблон("<a href=""%1""%2 rel=""%3""%4>%5</a>",
		Экран.Экранировать(АдресСтраницы(Модель, Номер)),
		Экран.Атрибут("class", Класс),
		Отношение,
		?(Тихо(Модель), " data-quiet=""""", ""),
		Внутри);

КонецФункции

// --- страницы и отбор без перезагрузки (выпуск 0.13) ---

// Ссылка страницы уходит тихо: скрипт кита берёт страницу запросом в фоне и кладёт её
// на место (data-quiet — тот же признак, что у тихой формы). Признак печатается ЗДЕСЬ,
// в одном месте: ссылки пагинация собирает сама, мимо узлов холста.
Функция Тихо(Знач Модель)
	Возврат Модели.Флаг(Модель, "БезПерезагрузки");
КонецФункции

// Страница сменилась без перезагрузки — скринридер этого не заметил бы: состояние
// навигации объявляется живой областью, и новое «Страница 2 из 5» читается само.
Функция Живое(Знач Модель)
	Возврат ?(Тихо(Модель), " aria-live=""polite""", "");
КонецФункции

// «41–60 из 137»: какие записи на экране и сколько их всего. Печатается, только когда
// известны оба числа: по одному из них диапазон не посчитать. Последняя страница
// кончается последней записью, а не полной страницей. Живой областью диапазон не
// объявлен: при смене страницы скринридеру хватает одного «Страница 2 из 7».
Функция Счёт(Знач Текущая, Знач Записей, Знач НаСтранице)

	Если Записей <= 0 ИЛИ НаСтранице <= 0 Тогда
		Возврат "";
	КонецЕсли;

	Первая = Мин((Текущая - 1) * НаСтранице + 1, Записей);
	Последняя = Мин(Текущая * НаСтранице, Записей);
	Текст = ТекстСчёта(ЧислоТекстом(Первая), ЧислоТекстом(Последняя), ЧислоТекстом(Записей));

	Возврат СтрШаблон("<span class=""pagination__count"">%1</span>", Экран.Экранировать(Текст));

КонецФункции

// Без резолвера текстов (компонент собран руками, как до 0.13) строка печатается
// по-русски тем же образцом, что у ключа «pagination.of» в словаре документации.
Функция ТекстСчёта(Знач Первая, Знач Последняя, Знач Всего)
	Если Тексты = Неопределено Тогда
		Возврат СтрШаблон("%1–%2 из %3", Первая, Последняя, Всего);
	КонецЕсли;
	Возврат Тексты.Шаблон("pagination.of", Первая, Последняя, Всего);
КонецФункции

Функция ЧислоТекстом(Знач Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

// Собирает адрес страницы: основа, сохраняемые параметры и параметр страницы.
// Значения параметров URL-кодируются.
//
// Параметры:
//  Модель - Структура - модель пагинации, см. Отрисовать.
//  Номер  - Число     - номер страницы.
//
// Возвращаемое значение:
//  Строка - относительный URL.
//
Функция АдресСтраницы(Знач Модель, Знач Номер) Экспорт

	Пары = Новый Массив();

	Для Каждого Параметр Из Модели.Список(Модель, "Параметры") Цикл
		Имя = Модели.Текст(Параметр, "Имя");
		Значение = Модели.Текст(Параметр, "Значение");
		Если ЗначениеЗаполнено(Имя) И ЗначениеЗаполнено(Значение) Тогда
			Пары.Добавить(Кодировать(Имя) + "=" + Кодировать(Значение));
		КонецЕсли;
	КонецЦикла;

	Пары.Добавить(Кодировать(Модели.Текст(Модель, "Параметр", "page")) + "="
		+ Кодировать(Формат(Номер, "ЧН=0; ЧГ=0")));

	// основа уже с запросом («/документы?вид=таблица») продолжается через «&»: второй «?»
	// сделал бы номер страницы частью значения первого параметра
	Основа = Модели.Текст(Модель, "Основа");
	Возврат Основа + ?(СтрНайти(Основа, "?") > 0, "&", "?") + СтрСоединить(Пары, "&");

КонецФункции

Функция Кодировать(Знач Значение)
	Возврат КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Целое(Знач Значение)
	Попытка
		Возврат Цел(Число(?(Значение = Неопределено, 0, Значение)));
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

// Схему основы фильтруем здесь явно: <a> с rel=prev/next пагинация собирает сама,
// мимо ЭкранированиеHTML.Ссылка.
Процедура ПроверитьОснову(Знач Основа)

	Если НЕ ЗначениеЗаполнено(Основа) Тогда
		ВызватьИсключение "Компонент «Пагинация»: не задана Основа (базовый путь списка) —"
			+ " ссылки страниц вели бы относительно текущего адреса.";
	КонецЕсли;

	Если НЕ Экран.URLБезопасенДляHref(Основа) Тогда
		ВызватьИсключение "Компонент «Пагинация»: недопустимая схема в Основа —"
			+ " ссылки страниц попадают в href, и такая основа дала бы исполняемый адрес.";
	КонецЕсли;

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Иконка") _Значки,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты = Неопределено) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Значки = _Значки;
	Тексты = _Тексты;

КонецПроцедуры
