// Компонент «Поле из конфига» — желудь UI-кита: «конфиг — эталон, UI — зеркало».
// Значение из autumn-properties.json / ENV показывается заблокированным: правка в UI
// откатилась бы на рестарте.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Поля;    // ПолеФормы
Перем Значки;  // Иконка

// Отрисовывает заблокированное поле со ссылкой на источник и ENV-сниппетом.
//
// Параметры:
//  Модель - Структура - Метка, Значение (действующее, экранируется), Деталька (имя
//           детальки-источника), Переменная (имя переменной окружения), Подсказка,
//           Секрет (значение не показывать).
//
// Возвращаемое значение:
//  Строка - фрагмент <div class="from-config">.
//
Функция Отрисовать(Знач Модель) Экспорт

	Деталька = Модели.Текст(Модель, "Деталька");
	Переменная = Модели.Текст(Модель, "Переменная");
	Секрет = Модели.Флаг(Модель, "Секрет");
	Значение = ?(Секрет, "", Модели.Текст(Модель, "Значение"));

	МодельПоля = Новый Структура("Имя, Метка, Значение, Подсказка, Заблокировано, Плейсхолдер",
		"", Модели.Текст(Модель, "Метка"), Значение, Модели.Текст(Модель, "Подсказка"),
		Истина, ?(Секрет, "значение скрыто", ""));

	Источник = "";
	Если ЗначениеЗаполнено(Деталька) Тогда
		Источник = СтрШаблон("<span class=""from-config__source"">%1<code>%2</code></span>",
			Значки.Отрисовать(Новый Структура("Имя, Подпись", "замок", "значение задано конфигурацией")),
			Экран.Экранировать(Деталька));
	КонецЕсли;

	Сниппет = "";
	Если ЗначениеЗаполнено(Переменная) Тогда
		Сниппет = БлокСниппета(Переменная, Значение, Секрет);
	КонецЕсли;

	Возврат СтрШаблон("<div class=""from-config"">%1%2%3</div>",
		Поля.Отрисовать(МодельПоля), Источник, Сниппет);

КонецФункции

Функция БлокСниппета(Знач Переменная, Знач Значение, Знач Секрет)

	Текст = Переменная + "=" + ?(Секрет, "<значение>", Значение);

	Возврат СтрШаблон(
		"<div class=""from-config__env""><code>%1</code>"
		+ "<button type=""button"" class=""copy"" data-copy=""%1"">%2<span>Копировать</span></button></div>",
		Экран.Экранировать(Текст),
		Значки.Отрисовать("копировать"));

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "ПолеФормы") _Поля,
	&Пластилин(Значение = "Иконка") _Значки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Поля = _Поля;
	Значки = _Значки;

КонецПроцедуры
