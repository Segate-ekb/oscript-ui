// Компонент «Пустое состояние» — желудь UI-кита: иконка, заголовок, объяснение,
// призыв к действию. Без единого слова объяснения не рендерится.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Значки;  // Иконка
Перем Кнопки;  // Кнопка

// Отрисовывает пустое состояние.
//
// Параметры:
//  Модель - Структура, Строка - текст пояснения либо структура: Заголовок, Пояснение,
//           Иконка (по умолчанию "инфо"), Действие (модель компонента Кнопка),
//           Компактное (вариант для ячейки таблицы или узкой колонки).
//
// Возвращаемое значение:
//  Строка - фрагмент <div class="empty">. Кидается исключением, если не задано ни
//           Заголовка, ни Пояснения.
//
Функция Отрисовать(Знач Модель) Экспорт

	Если ТипЗнч(Модель) <> Тип("Структура") Тогда
		Модель = Новый Структура("Пояснение", ?(Модель = Неопределено, "", Строка(Модель)));
	КонецЕсли;

	Заголовок = Модели.Текст(Модель, "Заголовок");
	Пояснение = Модели.Текст(Модель, "Пояснение");
	ПроверитьОбъяснение(Заголовок, Пояснение);

	Классы = "empty" + ?(Модели.Флаг(Модель, "Компактное"), " empty--compact", "");

	Внутри = СтрШаблон("<div class=""empty__icon"">%1</div>",
		Значки.Отрисовать(Модели.Текст(Модель, "Иконка", "инфо")));

	Если ЗначениеЗаполнено(Заголовок) Тогда
		Внутри = Внутри + СтрШаблон("<p class=""empty__title"">%1</p>", Экран.Экранировать(Заголовок));
	КонецЕсли;

	Если ЗначениеЗаполнено(Пояснение) Тогда
		Внутри = Внутри + СтрШаблон("<p class=""empty__text"">%1</p>", Экран.Экранировать(Пояснение));
	КонецЕсли;

	Действие = Модели.Значение(Модель, "Действие");
	Если ТипЗнч(Действие) = Тип("Структура") Тогда
		Внутри = Внутри + СтрШаблон("<div class=""empty__action"">%1</div>", Кнопки.Отрисовать(Действие));
	КонецЕсли;

	Возврат СтрШаблон("<div%1>%2</div>", Экран.Атрибут("class", Классы), Внутри);

КонецФункции

Процедура ПроверитьОбъяснение(Знач Заголовок, Знач Пояснение)

	Если ЗначениеЗаполнено(Заголовок) ИЛИ ЗначениеЗаполнено(Пояснение) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение "Компонент «Пустое состояние»: не задано ни Заголовка, ни Пояснения."
		+ " Пустой блок неотличим от несработавшей загрузки — объясните пользователю,"
		+ " что здесь появится и что для этого сделать.";

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Иконка") _Значки,
	&Пластилин(Значение = "Кнопка") _Кнопки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Значки = _Значки;
	Кнопки = _Кнопки;

КонецПроцедуры
