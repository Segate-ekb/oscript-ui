// Компонент «Пустое состояние» — желудь UI-кита: иконка, заголовок, объяснение,
// призыв к действию. Без единого слова объяснения не рендерится.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Значки;  // Иконка
Перем Кнопки;  // Кнопка

// Отрисовывает пустое состояние.
//
// Параметры:
//  Модель - Структура, Строка - текст пояснения либо структура: Заголовок, Пояснение,
//           Иконка (по умолчанию "инфо"), Действие (модель компонента Кнопка),
//           Действия (дев-сборка 9: Массив моделей кнопок — второй и следующие пути из
//           пустоты; печатаются после Действия, кнопка без своего Варианта — вторичной),
//           Компактное (вариант для ячейки таблицы или узкой колонки).
//
// Возвращаемое значение:
//  Строка - фрагмент <div class="empty">. Одно действие — в <div class="empty__action">,
//           как прежде; два и больше — рядом в <div class="empty__actions"> (на телефоне
//           столбиком). Кидается исключением, если не задано ни Заголовка, ни Пояснения.
//
Функция Отрисовать(Знач Модель) Экспорт

	Если ТипЗнч(Модель) <> Тип("Структура") Тогда
		Модель = Новый Структура("Пояснение", ?(Модель = Неопределено, "", Строка(Модель)));
	КонецЕсли;

	Заголовок = Модели.Текст(Модель, "Заголовок");
	Пояснение = Модели.Текст(Модель, "Пояснение");
	ПроверитьОбъяснение(Заголовок, Пояснение);

	Классы = "empty" + ?(Модели.Флаг(Модель, "Компактное"), " empty--compact", "");

	Внутри = СтрШаблон("<div class=""empty__icon"">%1</div>",
		Значки.Отрисовать(Модели.Текст(Модель, "Иконка", "инфо")));

	Если ЗначениеЗаполнено(Заголовок) Тогда
		Внутри = Внутри + СтрШаблон("<p class=""empty__title"">%1</p>", Экран.Экранировать(Заголовок));
	КонецЕсли;

	Если ЗначениеЗаполнено(Пояснение) Тогда
		Внутри = Внутри + СтрШаблон("<p class=""empty__text"">%1</p>", Экран.Экранировать(Пояснение));
	КонецЕсли;

	Внутри = Внутри + ДействияHTML(Модель);

	Возврат СтрШаблон("<div%1>%2</div>", Экран.Атрибут("class", Классы), Внутри);

КонецФункции

// Пути из пустоты. Один — прежняя обёртка байт в байт. Два (дев-сборка 9, пробел хаба П4:
// «опубликовать» и «перенести» из пустого пула) — рядом одной группой: первый — тем видом,
// что дал вызывающий (обычно основной), следующие без своего вида — вторичными, чтобы
// главный путь читался главным. Ряд на телефоне встаёт столбиком — правило листа.
Функция ДействияHTML(Знач Модель)

	Кнопки_ = Новый Массив();
	Действие = Модели.Значение(Модель, "Действие");
	Если ТипЗнч(Действие) = Тип("Структура") Тогда
		Кнопки_.Добавить(Кнопки.Отрисовать(Действие));
	КонецЕсли;
	Для Каждого Ещё Из Модели.Список(Модель, "Действия") Цикл
		Если ТипЗнч(Ещё) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Если Кнопки_.Количество() > 0 И НЕ ЗначениеЗаполнено(Модели.Текст(Ещё, "Вариант")) Тогда
			Ещё = СВариантом(Ещё, "вторичная");
		КонецЕсли;
		Кнопки_.Добавить(Кнопки.Отрисовать(Ещё));
	КонецЦикла;

	Если Кнопки_.Количество() = 0 Тогда
		Возврат "";
	ИначеЕсли Кнопки_.Количество() = 1 Тогда
		Возврат СтрШаблон("<div class=""empty__action"">%1</div>", Кнопки_[0]);
	КонецЕсли;
	Возврат СтрШаблон("<div class=""empty__actions"">%1</div>", СтрСоединить(Кнопки_));

КонецФункции

// Копия модели кнопки с видом: модель пришла от вызывающего, и вписанный в неё вид всплыл бы
// у него в следующей сборке.
Функция СВариантом(Знач Модель, Знач Вариант)

	Копия = Новый Структура();
	Для Каждого Поле Из Модель Цикл
		Копия.Вставить(Поле.Ключ, Поле.Значение);
	КонецЦикла;
	Копия.Вставить("Вариант", Вариант);
	Возврат Копия;

КонецФункции

Процедура ПроверитьОбъяснение(Знач Заголовок, Знач Пояснение)

	Если ЗначениеЗаполнено(Заголовок) ИЛИ ЗначениеЗаполнено(Пояснение) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение "Компонент «Пустое состояние»: не задано ни Заголовка, ни Пояснения."
		+ " Пустой блок неотличим от несработавшей загрузки — объясните пользователю,"
		+ " что здесь появится и что для этого сделать.";

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Иконка") _Значки,
	&Пластилин(Значение = "Кнопка") _Кнопки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Значки = _Значки;
	Кнопки = _Кнопки;

КонецПроцедуры
