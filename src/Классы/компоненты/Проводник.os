// Компонент «Проводник» — желудь UI-кита: список шагов многошаговой задачи.
// Состояние «выполнен ли шаг» считает доменная служба, компонент только показывает.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Значки;  // Иконка

// Отрисовывает строку прогресса и список шагов.
//
// Параметры:
//  Модель - Структура - Пусто (текст, когда шагов нет), Шаги (массив структур:
//           Заголовок, Пояснение, Выполнен, Текущий, Адрес, ПодписьСсылки,
//           ТелоHTML — ДОВЕРЕННЫЙ HTML под шагом).
//
// Возвращаемое значение:
//  Строка - прогресс и <ol class="guide__list"> либо заглушка пустого списка.
//
Функция Отрисовать(Знач Модель) Экспорт

	Шаги = Модели.Список(Модель, "Шаги");
	Если Шаги.Количество() = 0 Тогда
		Пусто = Модели.Текст(Модель, "Пусто");
		Возврат ?(ЗначениеЗаполнено(Пусто),
			СтрШаблон("<p class=""muted"">%1</p>", Экран.Экранировать(Пусто)), "");
	КонецЕсли;

	Пройдено = 0;
	Пункты = "";
	Для Каждого Шаг Из Шаги Цикл
		Пункты = Пункты + Пункт(Шаг);
		Если Модели.Флаг(Шаг, "Выполнен") Тогда
			Пройдено = Пройдено + 1;
		КонецЕсли;
	КонецЦикла;

	Прогресс = СтрШаблон("<p class=""guide__progress"">Пройдено %1 из %2</p>",
		Формат(Пройдено, "ЧН=; ЧГ=0"), Формат(Шаги.Количество(), "ЧН=; ЧГ=0"));

	Возврат Прогресс + СтрШаблон("<ol class=""guide__list"">%1</ol>", Пункты);

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция Пункт(Знач Шаг)

	Выполнен = Модели.Флаг(Шаг, "Выполнен");
	Текущий = Модели.Флаг(Шаг, "Текущий") И НЕ Выполнен;

	Классы = "guide__step"
		+ ?(Выполнен, " guide__step--done", "")
		+ ?(Текущий, " guide__step--current", "");

	Тело = СтрШаблон("<span class=""guide__title"">%1</span>",
		Экран.Экранировать(Модели.Текст(Шаг, "Заголовок")));

	Пояснение = Модели.Текст(Шаг, "Пояснение");
	Если ЗначениеЗаполнено(Пояснение) Тогда
		Тело = Тело + СтрШаблон("<span class=""guide__hint"">%1</span>", Экран.Экранировать(Пояснение));
	КонецЕсли;

	ТелоHTML = Модели.Текст(Шаг, "ТелоHTML");
	Если ЗначениеЗаполнено(ТелоHTML) Тогда
		Тело = Тело + ТелоHTML; // ДОВЕРЕННЫЙ HTML
	КонецЕсли;

	Адрес = Модели.Текст(Шаг, "Адрес");
	Если ЗначениеЗаполнено(Адрес) Тогда
		Тело = Тело + Экран.Ссылка(Адрес, Модели.Текст(Шаг, "ПодписьСсылки", "Перейти"));
	КонецЕсли;

	Возврат СтрШаблон("<li%1><span class=""guide__mark"">%2</span><span class=""guide__body"">%3</span></li>",
		Экран.Атрибут("class", Классы), Значки.Отрисовать(ИмяЗначка(Выполнен, Текущий)), Тело);

КонецФункции

// Для будущего шага «инфо» — нейтральный маркер: отдельного кружка в наборе нет.
Функция ИмяЗначка(Знач Выполнен, Знач Текущий)
	Если Выполнен Тогда
		Возврат "успех";
	ИначеЕсли Текущий Тогда
		Возврат "стрелка";
	КонецЕсли;
	Возврат "инфо";
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Иконка") _Значки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Значки = _Значки;

КонецПроцедуры
