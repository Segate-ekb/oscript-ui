// Компонент «Тост» — желудь UI-кита: уведомление о результате действия.
// Рендерится сервером в потоке страницы; ошибка — role="alert", остальное — role="status".

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Значки;  // Иконка

// Отрисовывает тост.
//
// Параметры:
//  Модель - Структура, Строка - текст сообщения либо структура: Текст (экранируется),
//           Вид ("ok" | "warn" | "err" | "info", по умолчанию "ok"), Заголовок,
//           Закрываемый (показывать кнопку закрытия).
//
// Возвращаемое значение:
//  Строка - фрагмент <div class="toast">.
//
Функция Отрисовать(Знач Модель) Экспорт

	Если ТипЗнч(Модель) = Тип("Структура") Тогда
		Текст = Модели.Текст(Модель, "Текст");
		Вид = НормализованныйВид(Модели.Текст(Модель, "Вид", "ok"));
		Заголовок = Модели.Текст(Модель, "Заголовок");
		Закрываемый = Модели.Флаг(Модель, "Закрываемый");
	Иначе
		Текст = ?(Модель = Неопределено, "", Строка(Модель));
		Вид = "ok";
		Заголовок = "";
		Закрываемый = Ложь;
	КонецЕсли;

	Роль = ?(Вид = "err", "alert", "status");

	Внутри = Значки.Отрисовать(ИконкаВида(Вид));

	Если ЗначениеЗаполнено(Заголовок) Тогда
		Внутри = Внутри + СтрШаблон("<strong class=""toast__title"">%1</strong>", Экран.Экранировать(Заголовок));
	КонецЕсли;

	Внутри = Внутри + СтрШаблон("<span class=""toast__text"">%1</span>", Экран.Экранировать(Текст));

	Если Закрываемый Тогда
		Внутри = Внутри + СтрШаблон(
			"<button type=""button"" class=""toast__close"" data-close aria-label=""Закрыть"">%1</button>",
			Значки.Отрисовать("закрыть"));
	КонецЕсли;

	Возврат СтрШаблон("<div class=""toast toast--%1"" role=""%2"">%3</div>", Вид, Роль, Внутри);

КонецФункции

// Приводит вид сообщения к allowlist.
//
// Параметры:
//  Вид - Строка - вид из модели.
//
// Возвращаемое значение:
//  Строка - "ok" | "warn" | "err" либо "info" для неизвестного значения.
//
Функция НормализованныйВид(Знач Вид) Экспорт

	Значение = НРег(СокрЛП(Строка(Вид)));

	Если Значение = "ok" ИЛИ Значение = "успех" Тогда
		Возврат "ok";
	ИначеЕсли Значение = "warn" ИЛИ Значение = "предупреждение" Тогда
		Возврат "warn";
	ИначеЕсли Значение = "err" ИЛИ Значение = "error" ИЛИ Значение = "ошибка" Тогда
		Возврат "err";
	КонецЕсли;

	Возврат "info";

КонецФункции

Функция ИконкаВида(Знач Вид)

	Если Вид = "ok" Тогда
		Возврат "успех";
	ИначеЕсли Вид = "warn" Тогда
		Возврат "предупреждение";
	ИначеЕсли Вид = "err" Тогда
		Возврат "ошибка";
	КонецЕсли;

	Возврат "инфо";

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Иконка") _Значки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Значки = _Значки;

КонецПроцедуры
