// Ряд метаданных — желудь UI-кита: общая строка «значок + значение». Какие подписи
// бывают и какой значок у каждой — знание вызывающего: имя значка приходит В ЭЛЕМЕНТЕ.
// Элемент без значка печатается текстом «подпись: значение».

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Значки;  // Иконка

// Отрисовывает ряд метаданных.
//
// Параметры:
//  Элементы       - Массив из Структура - Подпись, Значение, Значок (необязательный:
//                   имя иконки из НаборИконок; без него пара печатается текстом),
//                   Адрес (необязательный: значение станет ссылкой).
//  Класс          - Строка - CSS-класс ряда.
//  КлассЭлемента  - Строка - CSS-класс одного элемента ряда.
//
// Возвращаемое значение:
//  Строка - фрагмент <div class="<Класс>"> либо "" для пустого ряда.
//
Функция Отрисовать(Знач Элементы, Знач Класс, Знач КлассЭлемента) Экспорт

	Если ТипЗнч(Элементы) <> Тип("Массив") Тогда
		Возврат "";
	КонецЕсли;

	Строки = "";
	Для Каждого Запись Из Элементы Цикл
		Строки = Строки + ЭлементРяда(Запись, КлассЭлемента);
	КонецЦикла;

	Возврат ?(ЗначениеЗаполнено(Строки),
		СтрШаблон("<div%1>%2</div>", Экран.Атрибут("class", Класс), Строки), "");

КонецФункции

// Значок декоративен: подпись несёт визуально скрытая текстовая пара рядом со значением.
Функция ЭлементРяда(Знач Запись, Знач Класс)

	Подпись = Модели.Текст(Запись, "Подпись");
	Значение = Модели.Текст(Запись, "Значение");
	Адрес = Модели.Текст(Запись, "Адрес");

	Видимое = ?(ЗначениеЗаполнено(Значение), Значение, Подпись);
	Если НЕ ЗначениеЗаполнено(Видимое) Тогда
		Возврат "";
	КонецЕсли;

	Парная = ЗначениеЗаполнено(Подпись) И ЗначениеЗаполнено(Значение);
	ИмяЗначка = ?(Парная, Модели.Текст(Запись, "Значок"), "");

	Если НЕ ЗначениеЗаполнено(ИмяЗначка) Тогда
		Возврат СтрШаблон("<span%1>%2</span>",
			Экран.Атрибут("class", Класс),
			Оформить(?(Парная, Подпись + ": " + Значение, Видимое), Адрес));
	КонецЕсли;

	Возврат СтрШаблон("<span%1%2>%3<span class=""visually-hidden"">%4: </span>%5</span>",
		Экран.Атрибут("class", Класс),
		Экран.Атрибут("title", Подпись),
		Значки.Отрисовать(ИмяЗначка),
		Экран.Экранировать(Подпись),
		Оформить(Значение, Адрес));

КонецФункции

Функция Оформить(Знач Текст, Знач Адрес)
	Возврат ?(ЗначениеЗаполнено(Адрес), Экран.Ссылка(Адрес, Текст), Экран.Экранировать(Текст));
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Иконка") _Значки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Значки = _Значки;

КонецПроцедуры
