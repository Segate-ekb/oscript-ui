// Компонент «Иконка» — желудь UI-кита: инлайновый <svg> по глифу из НаборИконок.
// Неизвестное имя — пустая строка, страница не падает.

Перем Экран;   // ЭкранированиеHTML
Перем Набор;   // НаборИконок
Перем Модели;  // ЧтениеМодели

// Отрисовывает инлайновый <svg> иконки.
//
// Параметры:
//  Модель - Структура, Строка - имя иконки либо структура: Имя, Подпись (для скринридера;
//           без неё иконка декоративна и скрыта), Класс.
//
// Возвращаемое значение:
//  Строка - фрагмент <svg> либо "" для неизвестной иконки.
//
Функция Отрисовать(Знач Модель) Экспорт

	Если ТипЗнч(Модель) <> Тип("Структура") Тогда
		Имя = ?(Модель = Неопределено, "", Строка(Модель));
		Подпись = "";
		Класс = "";
	Иначе
		Имя = Модели.Текст(Модель, "Имя");
		Подпись = Модели.Текст(Модель, "Подпись");
		Класс = Модели.Текст(Модель, "Класс");
	КонецЕсли;

	Если НЕ Набор.Содержит(Имя) Тогда
		Возврат "";
	КонецЕсли;

	Классы = "icon" + ?(ЗначениеЗаполнено(Класс), " " + Класс, "");

	Если ЗначениеЗаполнено(Подпись) Тогда
		Доступность = " role=""img""";
		Заголовок = "<title>" + Экран.Экранировать(Подпись) + "</title>";
	Иначе
		Доступность = " aria-hidden=""true"" focusable=""false""";
		Заголовок = "";
	КонецЕсли;

	// Разметка рисунка вставляется как есть — она и есть разметка. Разобрал и проверил её
	// ЧтениеГлифа при загрузке набора: в странице оказывается только рисунок из файла
	// репозитория. Всё остальное — класс, область рисунка, подпись — через экранирование.
	Возврат СтрШаблон(
		"<svg%1 viewBox=""%2""%3 fill=""currentColor"" xmlns=""http://www.w3.org/2000/svg"">%4%5</svg>",
		Экран.Атрибут("class", Классы),
		Экран.Экранировать(Набор.ОбластьРисунка(Имя)),
		Доступность,
		Заголовок,
		Набор.Содержимое(Имя));

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "НаборИконок") _Набор,
	&Пластилин(Значение = "ЧтениеМодели") _Модели) Экспорт

	Экран = _Экран;
	Набор = _Набор;
	Модели = _Модели;

КонецПроцедуры
