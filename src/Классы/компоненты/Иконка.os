// Компонент «Иконка» — желудь UI-кита: инлайновый <svg> по глифу из НаборИконок.
// Неизвестное имя — пустая строка, страница не падает.

Перем Экран;   // ЭкранированиеHTML
Перем Набор;   // НаборИконок
Перем Модели;  // ЧтениеМодели

// Отрисовывает инлайновый <svg> иконки.
//
// Параметры:
//  Модель - Структура, Строка - имя иконки либо структура: Имя, Подпись (для скринридера;
//           без неё иконка декоративна и скрыта), Класс. Дев-сборка 8: имя «бренд:<ключ>»
//           (бренд:telegram, бренд:github…) — логотип бренда из значков провайдеров цветом
//           бренда; тёмный логотип в тёмной теме — цветом текста.
//
// Возвращаемое значение:
//  Строка - фрагмент <svg> либо "" для неизвестной иконки. Неизвестный бренд останавливает
//           сборку исключением с перечнем известных.
//
Функция Отрисовать(Знач Модель) Экспорт

	Если ТипЗнч(Модель) <> Тип("Структура") Тогда
		Имя = ?(Модель = Неопределено, "", Строка(Модель));
		Подпись = "";
		Класс = "";
	Иначе
		Имя = Модели.Текст(Модель, "Имя");
		Подпись = Модели.Текст(Модель, "Подпись");
		Класс = Модели.Текст(Модель, "Класс");
	КонецЕсли;

	// --- значки брендов (дев-сборка 8)
	Если СтрНачинаетсяС(НРег(СокрЛП(Имя)), Набор.ПриставкаБренда()) Тогда
		Возврат ЗначокБренда(Имя, Подпись, Класс);
	КонецЕсли;

	Если НЕ Набор.Содержит(Имя) Тогда
		Возврат "";
	КонецЕсли;

	Классы = "icon" + ?(ЗначениеЗаполнено(Класс), " " + Класс, "");

	Если ЗначениеЗаполнено(Подпись) Тогда
		Доступность = " role=""img""";
		Заголовок = "<title>" + Экран.Экранировать(Подпись) + "</title>";
	Иначе
		Доступность = " aria-hidden=""true"" focusable=""false""";
		Заголовок = "";
	КонецЕсли;

	// Разметка рисунка вставляется как есть — она и есть разметка. Разобрал и проверил её
	// ЧтениеГлифа при загрузке набора: в странице оказывается только рисунок из файла
	// репозитория. Всё остальное — класс, область рисунка, подпись — через экранирование.
	Возврат СтрШаблон(
		"<svg%1 viewBox=""%2""%3 fill=""currentColor"" xmlns=""http://www.w3.org/2000/svg"">%4%5</svg>",
		Экран.Атрибут("class", Классы),
		Экран.Экранировать(Набор.ОбластьРисунка(Имя)),
		Доступность,
		Заголовок,
		Набор.Содержимое(Имя));

КонецФункции

// Имя бренда — то, чем значок бренда называет себя скринридеру, когда стоит один.
//
// Параметры:
//  Имя - Строка - имя иконки «бренд:<ключ>».
//
// Возвращаемое значение:
//  Строка - название бренда; "" — это не бренд или такого нет.
//
Функция НазваниеБренда(Знач Имя) Экспорт

	Имя = НРег(СокрЛП(Строка(Имя)));
	Если НЕ СтрНачинаетсяС(Имя, Набор.ПриставкаБренда()) Тогда
		Возврат "";
	КонецЕсли;
	Бренд = Набор.Бренд(Сред(Имя, СтрДлина(Набор.ПриставкаБренда()) + 1));
	Возврат ?(Бренд = Неопределено, "", Бренд.Название);

КонецФункции

// --- выбор значка (дев-сборка 9) ---

// Имена глифов набора по алфавиту — то, что принимает Кит.Иконка(Имя).
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ИменаГлифов() Экспорт
	Возврат ПоАлфавиту(Набор.Имена());
КонецФункции

// Имена брендов по алфавиту ключа — «бренд:<ключ>», как их принимает Кит.Иконка(Имя).
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ИменаБрендов() Экспорт

	Результат = Новый Массив();
	Для Каждого Ключ Из ПоАлфавиту(Набор.КлючиБрендов()) Цикл
		Результат.Добавить(Набор.ПриставкаБренда() + Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПоАлфавиту(Знач Имена)

	Список = Новый СписокЗначений();
	Для Каждого Имя Из Имена Цикл
		Список.Добавить(Имя);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Возврат Список.ВыгрузитьЗначения();

КонецФункции

// Логотип — тем же <svg>, что глиф, но цветом бренда (атрибут fill: правило листа старше
// и перекрашивает тёмный логотип в тёмной теме). Неизвестный бренд — дефект вызывающего:
// пустое место на кнопке входа хуже остановки сборки.
Функция ЗначокБренда(Знач Имя, Знач Подпись, Знач Класс)

	Ключ = Сред(НРег(СокрЛП(Имя)), СтрДлина(Набор.ПриставкаБренда()) + 1);
	Бренд = Набор.Бренд(Ключ);
	Если Бренд = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Компонент «Иконка»: бренда «%1» в ките нет — известны %2."
			+ " Свой логотип кладут файлом в статику инсталляции или глифом.",
			Ключ, СтрСоединить(Набор.КлючиБрендов(), ", "));
	КонецЕсли;

	Классы = "icon icon--brand" + ?(Бренд.Чернила, " icon--brand-ink", "")
		+ ?(ЗначениеЗаполнено(Класс), " " + Класс, "");
	Если ЗначениеЗаполнено(Подпись) Тогда
		Доступность = " role=""img""";
		Заголовок = "<title>" + Экран.Экранировать(Подпись) + "</title>";
	Иначе
		Доступность = " aria-hidden=""true"" focusable=""false""";
		Заголовок = "";
	КонецЕсли;

	Возврат СтрШаблон(
		"<svg%1 viewBox=""%2""%3%4 xmlns=""http://www.w3.org/2000/svg"">%5%6</svg>",
		Экран.Атрибут("class", Классы),
		Экран.Экранировать(Бренд.ОбластьРисунка),
		Доступность,
		Экран.Атрибут("fill", Бренд.Цвет),
		Заголовок,
		Бренд.Содержимое);

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "НаборИконок") _Набор,
	&Пластилин(Значение = "ЧтениеМодели") _Модели) Экспорт

	Экран = _Экран;
	Набор = _Набор;
	Модели = _Модели;

КонецПроцедуры
