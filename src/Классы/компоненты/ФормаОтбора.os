// Компонент «Форма отбора» — желудь UI-кита: поле подстроки, кнопка и скрытые
// поля, сохраняющие остальные GET-параметры. Метод GET фиксирован: отбор живёт в адресе.

Перем Экран;    // ЭкранированиеHTML
Перем Модели;   // ЧтениеМодели
Перем Поля;     // ПолеФормы
Перем Кнопки;   // Кнопка
Перем Скрытые;  // СкрытоеПоле
Перем Тексты;   // ТекстыИнтерфейса — имя кнопки-значка поиска (search.submit); Неопределено у
                // графа, собранного руками по-старому: тогда имя — метка поля

// Отрисовывает форму отбора списка.
//
// Параметры:
//  Модель - Структура - Действие (URL отправки, ОБЯЗАТЕЛЕН), Имя (GET-параметр поля,
//           "q"), Метка, Значение (текущий отбор), Плейсхолдер, Поля (массив моделей
//           компонента «Поле» — форма из нескольких полей; заданы они — одиночное поле
//           не печатается), Кнопка (подпись, обязательна), Иконка кнопки, СкрытыеПоля
//           (массив структур Имя, Значение — GET-параметры, которые отправка обязана
//           сохранить). Выпуск 0.13: БезПерезагрузки (Булево) — форма уходит тихо
//           (data-quiet): ответ ложится на страницу на место, адрес меняется в истории
//           вкладки, а отбор уходит сам по изменению поля, с задержкой.
//           Выпуск 0.13 (дев-сборка 5): СкрытаяМетка (Булево) — метка одиночного поля
//           только для скринридера, доступное имя не от примера.
//           Выпуск 0.13 (дев-сборка 6): без Кнопки у одиночного поля — строка поиска Material:
//           кнопка-значок «поиск» внутри рамки поля, справа (обёртка .search-bar), имя
//           кнопки — текст словаря search.submit; Enter и значок отправляют форму, на любой
//           ширине ничего не переносится. С Кнопкой — прежний вид с отдельной кнопкой.
//
// Возвращаемое значение:
//  Строка - фрагмент <form class="filters" method="get">. Кидается исключением,
//           если Действие пусто.
//
Функция Отрисовать(Знач Модель) Экспорт

	Действие = Модели.Текст(Модель, "Действие");
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		ВызватьИсключение "Форма отбора: в модели не заполнено Действие —"
			+ " форма без адреса отправляется «куда-то», и это дефект вызывающего.";
	КонецЕсли;

	// --- страницы и отбор без перезагрузки (выпуск 0.13): признак тихой отправки — тот же,
	// что печатает слово БезПерезагрузки у формы холста
	Тихо = ?(Модели.Флаг(Модель, "БезПерезагрузки"), " data-quiet=""""", "");

	// --- строка поиска со значком (0.13, дев-сборка 6): подписи кнопки нет — значок внутри
	// поля, как у строки поиска Material и в поисковиках: отдельная кнопка на телефоне
	// уезжала второй строкой под поле
	Если НЕ ЗначениеЗаполнено(Модели.Текст(Модель, "Кнопка")) Тогда
		Возврат СтрШаблон("<form class=""filters"" method=""get"" action=""%1""%2>%3%4</form>",
			Экран.Экранировать(Действие), Тихо, СтрокаСоЗначком(Модель), СкрытыеПоля(Модель));
	КонецЕсли;

	Кнопка = Кнопки.Отрисовать(Новый Структура("Подпись, Иконка",
		Модели.Текст(Модель, "Кнопка"), Модели.Текст(Модель, "Иконка")));

	Возврат СтрШаблон("<form class=""filters"" method=""get"" action=""%1""%2>%3%4%5</form>",
		Экран.Экранировать(Действие), Тихо, ПоляФормы(Модель), СкрытыеПоля(Модель), Кнопка);

КонецФункции

// Одно поле подстроки — частый случай; список Поля — форма отбора из нескольких полей.
Функция ПоляФормы(Знач Модель)

	Список = Модели.Список(Модель, "Поля");
	Если Список.Количество() = 0 Тогда
		Возврат Поля.Отрисовать(Новый Структура("Имя, Метка, Значение, Плейсхолдер, СкрытаяМетка",
			Модели.Текст(Модель, "Имя", "q"),
			Модели.Текст(Модель, "Метка"),
			Модели.Текст(Модель, "Значение"),
			Модели.Текст(Модель, "Плейсхолдер"),
			Модели.Флаг(Модель, "СкрытаяМетка")));
	КонецЕсли;

	Результат = "";
	Для Каждого Описание Из Список Цикл
		Результат = Результат + Поля.Отрисовать(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Поле и кнопка-значок в одной обёртке: значок стоит внутри рамки поля справа (лист), это
// настоящая кнопка отправки — Enter в поле и щелчок по значку отправляют форму без скрипта.
// Формой из нескольких полей значок не бывает: внутри какого поля его ставить, не ясно.
Функция СтрокаСоЗначком(Знач Модель)

	Если Модели.Список(Модель, "Поля").Количество() > 0 Тогда
		ВызватьИсключение "Форма отбора: у формы из нескольких полей не задана Кнопка — значок"
			+ " поиска встаёт внутрь одиночного поля, а здесь полей несколько. Назовите кнопку"
			+ " словом .Кнопка(""Показать"") (в модели — поле Кнопка).";
	КонецЕсли;

	Имя = ?(Тексты = Неопределено, Модели.Текст(Модель, "Метка"), Тексты.Текст("search.submit"));
	Значок = Кнопки.Отрисовать(Новый Структура("Подпись, Вариант, Иконка, ТолькоИконка",
		Имя, "ссылка", ?(ЗначениеЗаполнено(Модели.Текст(Модель, "Иконка")),
			Модели.Текст(Модель, "Иконка"), "поиск"), Истина));

	Возврат СтрШаблон("<div class=""search-bar"">%1%2</div>", ПоляФормы(Модель), Значок);

КонецФункции

Функция СкрытыеПоля(Знач Модель)

	Результат = "";
	Для Каждого Описание Из Модели.Список(Модель, "СкрытыеПоля") Цикл
		Результат = Результат + Скрытые.Отрисовать(Описание);
	КонецЦикла;
	Возврат Результат;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "ПолеФормы") _Поля,
	&Пластилин(Значение = "Кнопка") _Кнопки,
	&Пластилин(Значение = "СкрытоеПоле") _Скрытые,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты = Неопределено) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Поля = _Поля;
	Кнопки = _Кнопки;
	Скрытые = _Скрытые;
	Тексты = _Тексты;

КонецПроцедуры
