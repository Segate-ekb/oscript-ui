// Компонент «Блок команды» — желудь UI-кита: копируемая команда или секрет.
// Кнопку «Копировать» оживляет скрипт инсталляции по атрибуту data-copy; без JS блок осмыслен.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Значки;  // Иконка

// Отрисовывает блок копируемой команды.
//
// Параметры:
//  Модель - Строка, Структура - текст команды либо структура: Команда (обязательна),
//           Подпись (надпись кнопки, "Копировать"), Пояснение (строка над блоком),
//           БезКопирования (не рисовать кнопку).
//
// Возвращаемое значение:
//  Строка - фрагмент <div class="cmd">. Кидается исключением, если Команда пуста.
//
Функция Отрисовать(Знач Модель) Экспорт

	Если ТипЗнч(Модель) <> Тип("Структура") Тогда
		Модель = Новый Структура("Команда", ?(Модель = Неопределено, "", Строка(Модель)));
	КонецЕсли;

	Команда = Модели.Текст(Модель, "Команда");
	ПроверитьКоманду(Команда);

	Кнопка = "";
	Если НЕ Модели.Флаг(Модель, "БезКопирования") Тогда
		Кнопка = СтрШаблон("<button class=""copy"" type=""button""%1>%2<span>%3</span></button>",
			Экран.Атрибут("data-copy", Команда),
			Значки.Отрисовать("копировать"),
			Экран.Экранировать(Модели.Текст(Модель, "Подпись", "Копировать")));
	КонецЕсли;

	Блок = СтрШаблон("<div class=""cmd""><code>%1</code>%2</div>",
		Экран.Экранировать(Команда), Кнопка);

	Пояснение = Модели.Текст(Модель, "Пояснение");
	Если ЗначениеЗаполнено(Пояснение) Тогда
		Возврат СтрШаблон("<p class=""cmd__note"">%1</p>", Экран.Экранировать(Пояснение)) + Блок;
	КонецЕсли;

	Возврат Блок;

КонецФункции

Процедура ПроверитьКоманду(Знач Команда)

	Если ЗначениеЗаполнено(Команда) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение "Компонент «Блок команды»: не задана Команда — блок нарисовал бы"
		+ " пустую рамку с кнопкой, копирующей пустоту.";

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Иконка") _Значки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Значки = _Значки;

КонецПроцедуры
