// Компонент «Опасная зона» — желудь UI-кита: контейнер необратимых действий.
// Проверка введённого подтверждения на клиенте — удобство, гарантия — серверная.
// Форму компонент НЕ печатает: зона живёт внутри <form> секции, вложенная форма невалидна.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Значки;  // Иконка
Перем Поля;    // ПолеФормы
Перем Кнопки;  // Кнопка

// Отрисовывает опасную зону — контейнер необратимого действия с блоком подтверждения.
//
// Параметры:
//  Модель - Структура - Заголовок ("Опасная зона"), Пояснение, Тело (ДОВЕРЕННЫЙ HTML
//           над блоком подтверждения), Кнопка (модель компонента Кнопка; вид «опасная»
//           навязывается), Подтверждение (ОБЯЗАТЕЛЬНО, структура: Имя поля — его
//           значение сверяет сервер, Метка, Образец, Подсказка).
//
// Возвращаемое значение:
//  Строка - фрагмент <div class="danger-zone">. Кидается исключением, если нет
//           Подтверждения с Именем поля.
//
Функция Отрисовать(Знач Модель) Экспорт

	Заголовок = Модели.Текст(Модель, "Заголовок", "Опасная зона");
	Подтверждение = Модели.Значение(Модель, "Подтверждение");
	ПроверитьПодтверждение(Заголовок, Подтверждение);

	Внутри = СтрШаблон("<div class=""danger-zone__head""><h3 class=""danger-zone__title"">%1%2</h3>%3</div>",
		Значки.Отрисовать("предупреждение"),
		Экран.Экранировать(Заголовок),
		Пояснение(Модель));

	Тело = Модели.Текст(Модель, "Тело");
	Если ЗначениеЗаполнено(Тело) Тогда
		Внутри = Внутри + СтрШаблон("<div class=""danger-zone__body"">%1</div>", Тело);
	КонецЕсли;

	Внутри = Внутри + СтрШаблон("<div class=""danger-zone__confirm"">%1</div>",
		ПолеПодтверждения(Подтверждение));

	Внутри = Внутри + СтрШаблон("<div class=""danger-zone__actions"">%1</div>", Кнопка(Модель));

	Возврат СтрШаблон("<div class=""danger-zone"">%1</div>", Внутри);

КонецФункции

Функция Пояснение(Знач Модель)
	Текст = Модели.Текст(Модель, "Пояснение");
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон("<p class=""danger-zone__text"">%1</p>", Экран.Экранировать(Текст));
КонецФункции

// Образец показывается подписью, а не значением поля: иначе подтверждение — лишний клик.
Функция ПолеПодтверждения(Знач Подтверждение)

	Образец = Модели.Текст(Подтверждение, "Образец");
	Метка = Модели.Текст(Подтверждение, "Метка",
		?(ЗначениеЗаполнено(Образец),
			СтрШаблон("Введите «%1» для подтверждения", Образец),
			"Подтвердите необратимое действие"));

	Возврат Поля.Отрисовать(Новый Структура(
		"Имя, Метка, Подсказка, Плейсхолдер, Обязательное, Автозаполнение",
		Модели.Текст(Подтверждение, "Имя"),
		Метка,
		Модели.Текст(Подтверждение, "Подсказка"),
		Образец,
		Истина,
		"off"));

КонецФункции

Функция Кнопка(Знач Модель)

	Заданная = Модели.Значение(Модель, "Кнопка");
	Если ТипЗнч(Заданная) <> Тип("Структура") Тогда
		Возврат Кнопки.Отрисовать(Новый Структура("Подпись, Вариант, Иконка",
			"Удалить", "опасная", "корзина"));
	КонецЕсли;

	// вид «опасная» навязывается на копии: модель вызывающего пришла по ссылке
	Копия = Новый Структура();
	Для Каждого КиЗ Из Заданная Цикл
		Копия.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Копия.Вставить("Вариант", "опасная");

	Возврат Кнопки.Отрисовать(Копия);

КонецФункции

Процедура ПроверитьПодтверждение(Знач Заголовок, Знач Подтверждение)

	Если ТипЗнч(Подтверждение) = Тип("Структура")
		И ЗначениеЗаполнено(Модели.Текст(Подтверждение, "Имя")) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Компонент «Опасная зона» («%1»): не задано Подтверждение с Именем поля."
		+ " Необратимое действие без подтверждения выполняется с первого клика,"
		+ " а красная рамка вокруг кнопки — оформление, а не защита.", Заголовок);

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Иконка") _Значки,
	&Пластилин(Значение = "ПолеФормы") _Поля,
	&Пластилин(Значение = "Кнопка") _Кнопки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Значки = _Значки;
	Поля = _Поля;
	Кнопки = _Кнопки;

КонецПроцедуры
