// Компонент «Шапка объекта» — желудь UI-кита: первый экран объекта. Каким объект бывает,
// не знает вовсе: иконка, подпись вида и слаг для data-kind приходят В МОДЕЛИ.

Перем Экран;    // ЭкранированиеHTML
Перем Модели;   // ЧтениеМодели
Перем Значки;   // Иконка
Перем Плашки;   // Плашка
Перем Команды;  // БлокКоманды
Перем Ряды;     // РядМеты

// Отрисовывает шапку объекта.
//
// Параметры:
//  Модель - Структура - Имя (ОБЯЗАТЕЛЬНО), Вид (слаг для data-kind: строчная латиница,
//           цифры и дефис; всё прочее в разметку не попадает), Иконка (имя из НаборИконок),
//           Подпись (подпись вида рядом с именем), Описание, Плашки (массив моделей
//           компонента Плашка), Мета (массив структур Подпись, Значение, Значок, Адрес —
//           с адресом значение становится ссылкой), Команда (модель БлокКоманды, главный
//           CTA), Действия (ДОВЕРЕННЫЙ HTML кнопок), Признаки (массив структур Иконка,
//           Подпись — значки сразу за именем в той же строке: имя глифа из НаборИконок
//           и подпись, она же доступное имя и всплывающая подсказка значка; значок
//           держится за последний символ имени и на новую строку один не уходит;
//           признак с неизвестным глифом не печатается).
//
// Возвращаемое значение:
//  Строка - фрагмент <header class="objhead">. Кидается исключением, если Имя пусто
//           либо у признака нет подписи.
//
Функция Отрисовать(Знач Модель) Экспорт

	Имя = Модели.Текст(Модель, "Имя");
	ПроверитьИмя(Имя);

	Заголовок = СтрШаблон("<h1 class=""objhead__title"">%1<span>%2</span>%3</h1>",
		Значки.Отрисовать(Модели.Текст(Модель, "Иконка")),
		ИмяСПризнаками(Имя, ПризнакиHTML(Модель)),
		Подпись(Модель));

	Внутри = СтрШаблон("<div class=""objhead__top"">%1%2</div>", Заголовок, Действия(Модель))
		+ ПлашкиHTML(Модель)
		+ Описание(Модель)
		+ Мета(Модель)
		+ Команда(Модель);

	// вид объекта — data-атрибут, а не класс: собственного оформления у вида нет
	Возврат СтрШаблон("<header class=""objhead""%1>%2</header>",
		Экран.Атрибут("data-kind", СлагВида(Модели.Текст(Модель, "Вид"))), Внутри);

КонецФункции

// Имя с признаками. Значки приклеены к ПОСЛЕДНЕМУ символу имени неразрывным куском:
// перенос внутри имени остаётся прежним, а значок не уходит на строку один. Символ за
// пределами BMP — два юнита строки (суррогатная пара), и режется он целиком. Без
// признаков имя печатается как было, байт в байт.
Функция ИмяСПризнаками(Знач Имя, Знач Признаки)

	Если НЕ ЗначениеЗаполнено(Признаки) Тогда
		Возврат Экран.Экранировать(Имя);
	КонецЕсли;

	Длина = СтрДлина(Имя);
	Последний = ?(Длина > 1 И ЭтоВтораяПоловинаПары(КодСимвола(Имя, Длина)), 2, 1);

	Возврат СтрШаблон("%1<span class=""objhead__tail"">%2%3</span>",
		Экран.Экранировать(Лев(Имя, Длина - Последний)),
		Экран.Экранировать(Прав(Имя, Последний)),
		Признаки);

КонецФункции

// Младший юнит суррогатной пары: символ, который без предыдущего юнита не существует.
Функция ЭтоВтораяПоловинаПары(Знач Код)
	Возврат Код >= 56320 И Код <= 57343;
КонецФункции

// Признак — значок с доступным именем: подпись печатается его <title>, и она же — его
// всплывающая подсказка. Подпись обязательна: немой значок у имени скринридеру ничего
// не скажет. Признак с неизвестным глифом не печатается — как и сама иконка кита.
Функция ПризнакиHTML(Знач Модель)

	Результат = "";
	Для Каждого Признак Из Модели.Список(Модель, "Признаки") Цикл

		Подпись = Модели.Текст(Признак, "Подпись");
		ПроверитьПодписьПризнака(Подпись);

		Значок = Значки.Отрисовать(Новый Структура("Имя, Подпись",
			Модели.Текст(Признак, "Иконка"), Подпись));
		Если ЗначениеЗаполнено(Значок) Тогда
			Результат = Результат + СтрШаблон("<span class=""objhead__mark"">%1</span>", Значок);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Процедура ПроверитьПодписьПризнака(Знач Подпись)

	Если ЗначениеЗаполнено(Подпись) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение "Компонент «Шапка объекта»: у признака не задана Подпись. Значок"
		+ " у имени без подписи немой: скринридер его не назовёт, а подсказки у него нет.";

КонецПроцедуры

Функция Подпись(Знач Модель)
	Текст = Модели.Текст(Модель, "Подпись");
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон("<span class=""objhead__kind"">%1</span>", Экран.Экранировать(Текст));
КонецФункции

Функция Действия(Знач Модель)
	HTML = Модели.Текст(Модель, "Действия");
	Возврат ?(ЗначениеЗаполнено(HTML), СтрШаблон("<div class=""objhead__actions"">%1</div>", HTML), "");
КонецФункции

Функция ПлашкиHTML(Знач Модель)

	Список = Модели.Список(Модель, "Плашки");
	Если Список.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Результат = "";
	Для Каждого Элемент Из Список Цикл
		Результат = Результат + Плашки.Отрисовать(Элемент);
	КонецЦикла;

	Возврат СтрШаблон("<div class=""objhead__chips"">%1</div>", Результат);

КонецФункции

Функция Описание(Знач Модель)
	Текст = Модели.Текст(Модель, "Описание");
	Возврат ?(ЗначениеЗаполнено(Текст),
		СтрШаблон("<p class=""objhead__lead"">%1</p>", Экран.Экранировать(Текст)), "");
КонецФункции

Функция Мета(Знач Модель)
	Возврат Ряды.Отрисовать(Модели.Список(Модель, "Мета"), "objhead__meta", "objhead__meta-item");
КонецФункции

Функция Команда(Знач Модель)

	Значение = Модели.Значение(Модель, "Команда");
	Если Значение = Неопределено ИЛИ (ТипЗнч(Значение) = Тип("Строка") И НЕ ЗначениеЗаполнено(Значение)) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("<div class=""objhead__cmd"">%1</div>", Команды.Отрисовать(Значение));

КонецФункции

// Слаг вида для data-kind: строчная латиница, цифры и дефис. Это ФОРМА, а не словарь —
// какие виды объектов бывают, решает вызывающий; кит лишь не пускает в атрибут то,
// что атрибутом быть не может. Прежде здесь стоял разбор «пакет|пул|группа» с дефолтом
// «package», и шапка чего угодно молча становилась шапкой пакета.
//
// Параметры:
//  Вид - Строка - вид из модели.
//
// Возвращаемое значение:
//  Строка - слаг либо "" (тогда атрибут не печатается вовсе).
//
Функция СлагВида(Знач Вид) Экспорт

	Значение = НРег(СокрЛП(Вид));
	Допустимые = "abcdefghijklmnopqrstuvwxyz0123456789-";

	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти(Допустимые, Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	Возврат Значение;

КонецФункции

Процедура ПроверитьИмя(Знач Имя)

	Если ЗначениеЗаполнено(Имя) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение "Компонент «Шапка объекта»: не задано Имя — страница объекта"
		+ " осталась бы без заголовка, на котором написан сам объект.";

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Иконка") _Значки,
	&Пластилин(Значение = "Плашка") _Плашки,
	&Пластилин(Значение = "БлокКоманды") _Команды,
	&Пластилин(Значение = "РядМеты") _Ряды) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Значки = _Значки;
	Плашки = _Плашки;
	Команды = _Команды;
	Ряды = _Ряды;

КонецПроцедуры
