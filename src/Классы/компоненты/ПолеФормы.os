// Компонент «Поле» — желудь UI-кита. Класс зовётся ПолеФормы, потому что тип
// `Поле` занят транзитивно подгружаемой библиотекой decorator, а имена типов в
// OneScript глобальны; в наборе компонентов доступен как НаборКомпонентов.Поле().

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
// поля список и цвет (выпуск 0.12)
Перем Тексты;  // ТекстыИнтерфейса — подписи образцов и крестика плашки
Перем Значки;  // Иконка — крестик плашки
Перем Типы;    // ТипыПоля — значения списка и код цвета

// Отрисовывает поле формы: подпись, ввод, пояснение и сообщение об ошибке.
//
// Параметры:
//  Модель - Структура - Имя (атрибут name; обязательно, кроме заблокированного поля),
//           Метка, Значение, Тип ("текст" | "пароль" | "число" | "флажок" | "файл" |
//           "многострочное" | "выбор" либо любой валидный type HTML), Подсказка,
//           Плейсхолдер, Автозаполнение (атрибут autocomplete), Ошибка, Обязательное,
//           Заблокировано, ТолькоЧтение, Отмечено (для флажка), Варианты (для выбора:
//           массив структур Значение, Подпись, Выбрано, Данные — Соответствие
//           дополнительных data-атрибутов варианта). Вариант с пустым Значением
//           допустим и выбирается пустым Значением поля. Ид — идентификатор управления:
//           задан, значит печатаются id, <label for> и aria-describedby сообщения
//           об ошибке; без него подпись связана с полем вложением. Минимум, Максимум,
//           Шаг и ДлинаМакс — атрибуты min, max, step и maxlength (пустые не печатаются;
//           их выводит тип значения поля, см. ТипыПоля). Шаблон — атрибут pattern
//           (регулярное выражение, которому значение обязано совпасть целиком), Форма —
//           атрибут form (якорь формы вне поля); пустые не печатаются.
//           Тип «список» — значения плашками: Значение строкой через запятую или массивом
//           строк. Тип «цвет» — образцы кружками: Образцы (массив структур Цвет — код
//           #rrggbb, Имя), Значение — код выбранного; пустое значит «по умолчанию».
//
// Возвращаемое значение:
//  Строка - фрагмент <label class="field"> (у списка — <div class="field">, у цвета —
//           <fieldset class="field">). Кидается исключением, если у незаблокированного
//           поля нет Имени.
//
Функция Отрисовать(Знач Модель) Экспорт

	Имя = Модели.Текст(Модель, "Имя");
	Метка = Модели.Текст(Модель, "Метка");
	Подсказка = Модели.Текст(Модель, "Подсказка");
	Ошибка = Модели.Текст(Модель, "Ошибка");
	Ид = Модели.Текст(Модель, "Ид");
	Тип = НРег(Модели.Текст(Модель, "Тип", "текст"));

	// поля список и цвет (выпуск 0.12): своя разметка, прежние типы её не видят
	Если Тип = "список" Тогда
		Возврат ПолеСписок(Модель, Имя, Метка, Подсказка, Ошибка, Ид);
	ИначеЕсли Тип = "цвет" Тогда
		Возврат ПолеЦвет(Модель, Имя, Метка, Подсказка, Ошибка, Ид);
	КонецЕсли;

	// модификатор печатается только там, где для него есть правило CSS
	Классы = "field" + ?(Тип = "флажок", " field--check", "")
		+ ?(ЗначениеЗаполнено(Ошибка), " field--error", "");

	Управление = Управление(Модель, Тип, Имя, Ид, Ошибка);
	ПодписьHTML = ?(ЗначениеЗаполнено(Метка),
		СтрШаблон("<span class=""field__label"">%1</span>", Экран.Экранировать(Метка)), "");

	// у флажка подпись идёт ПОСЛЕ управления — иначе кликабельная зона нелогична
	Внутри = ?(Тип = "флажок", Управление + ПодписьHTML, ПодписьHTML + Управление);

	Если ЗначениеЗаполнено(Подсказка) Тогда
		Внутри = Внутри + СтрШаблон("<span class=""field__hint"">%1</span>", Экран.Экранировать(Подсказка));
	КонецЕсли;

	Если ЗначениеЗаполнено(Ошибка) Тогда
		Внутри = Внутри + СтрШаблон("<span class=""field__error"" role=""alert""%1>%2</span>",
			Экран.Атрибут("id", ИдОшибки(Ид)), Экран.Экранировать(Ошибка));
	КонецЕсли;

	Возврат СтрШаблон("<label%1%2>%3</label>",
		Экран.Атрибут("class", Классы), Экран.Атрибут("for", Ид), Внутри);

КонецФункции

// Идентификатор сообщения об ошибке: он же адресуется из aria-describedby, поэтому
// считается ОДНИМ местом — иначе скринридер получил бы ссылку в пустоту.
Функция ИдОшибки(Знач Ид)
	Возврат ?(ЗначениеЗаполнено(Ид), Ид + "-err", "");
КонецФункции

Функция Управление(Знач Модель, Знач Тип, Знач Имя, Знач Ид = "", Знач Ошибка = "")

	ПроверитьИмя(Модель, Имя);

	Значение = Модели.Текст(Модель, "Значение");

	Общие = Экран.Атрибут("id", Ид)
		+ Экран.Атрибут("name", Имя)
		// без autocomplete менеджеры паролей подставляют в мастер первого запуска старую пару
		+ Экран.Атрибут("autocomplete", Модели.Текст(Модель, "Автозаполнение"))
		+ Экран.БулевАтрибут("required", Модели.Флаг(Модель, "Обязательное"))
		+ Экран.БулевАтрибут("disabled", Модели.Флаг(Модель, "Заблокировано"))
		+ Экран.БулевАтрибут("readonly", Модели.Флаг(Модель, "ТолькоЧтение"))
		// отбитое поле называет себя скринридеру само: и что оно отбито, и чем именно
		+ ?(ЗначениеЗаполнено(Ошибка), Экран.Атрибут("aria-invalid", "true")
			+ Экран.Атрибут("aria-describedby", ИдОшибки(Ид)), "")
		// поле формы вне неё: эхо-поле подтверждения стоит в окне, а уходит с формой страницы
		+ Экран.Атрибут("form", Модели.Текст(Модель, "Форма"));

	Если Тип = "многострочное" Тогда
		Возврат СтрШаблон("<textarea class=""field__control""%1%2%3>%4</textarea>",
			Общие, Экран.Атрибут("placeholder", Модели.Текст(Модель, "Плейсхолдер")),
			Экран.Атрибут("maxlength", Модели.Текст(Модель, "ДлинаМакс")),
			Экран.Экранировать(Значение));
	КонецЕсли;

	Если Тип = "выбор" Тогда
		Возврат СтрШаблон("<select class=""field__control""%1>%2</select>", Общие, Варианты(Модель, Значение));
	КонецЕсли;

	Если Тип = "флажок" Тогда
		Возврат СтрШаблон("<input type=""checkbox"" class=""field__check""%1%2%3>",
			Общие,
			Экран.Атрибут("value", ?(ЗначениеЗаполнено(Значение), Значение, "1")),
			Экран.БулевАтрибут("checked", Модели.Флаг(Модель, "Отмечено")));
	КонецЕсли;

	Возврат СтрШаблон("<input class=""field__control""%1%2%3%4%5>",
		Экран.Атрибут("type", ТипВвода(Тип)),
		Общие,
		Экран.Атрибут("value", Значение),
		Экран.Атрибут("placeholder", Модели.Текст(Модель, "Плейсхолдер")),
		Пределы(Модель));

КонецФункции

// Пределы ввода печатаются только заданными: поле без них остаётся тем же байт в байт.
// Задаёт их тип значения поля (ТипыПоля): шаг и максимум — квалификаторы числа, длина —
// квалификатор строки.
Функция Пределы(Знач Модель)

	Возврат Экран.Атрибут("min", Модели.Текст(Модель, "Минимум"))
		+ Экран.Атрибут("max", Модели.Текст(Модель, "Максимум"))
		+ Экран.Атрибут("step", Модели.Текст(Модель, "Шаг"))
		+ Экран.Атрибут("maxlength", Модели.Текст(Модель, "ДлинаМакс"))
		+ Экран.Атрибут("pattern", Модели.Текст(Модель, "Шаблон"));

КонецФункции

Функция Варианты(Знач Модель, Знач Значение)

	Список = Модели.Список(Модель, "Варианты");
	Выбранный = НомерВыбранного(Список, Значение);

	Результат = "";
	Номер = 0;
	Для Каждого Вариант Из Список Цикл
		ЗначениеВарианта = Модели.Текст(Вариант, "Значение");
		Подпись = Модели.Текст(Вариант, "Подпись", ЗначениеВарианта);
		// value печатается ВСЕГДА: <option> без него отправляет собственный текст,
		// и вариант с пустым значением приезжал бы на сервер своей подписью
		Результат = Результат + СтрШаблон("<option%1%2%3>%4</option>",
			Экран.АтрибутВсегда("value", ЗначениеВарианта),
			ДанныеВарианта(Вариант),
			Экран.БулевАтрибут("selected", Номер = Выбранный),
			Экран.Экранировать(Подпись));
		Номер = Номер + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Пометку `selected` получает РОВНО ОДИН вариант: у одиночного <select> их не бывает
// больше, и разметка с двумя пометками читается по-разному кем угодно (браузер берёт
// последнюю, любой разбор — первую). Побеждает явный флаг варианта, а совпадение
// значения поля — запасной путь: пустое значение поля так по-прежнему предвыбирает
// вариант с пустым значением, если явного флага не проставил никто.
Функция НомерВыбранного(Знач Список, Знач Значение)

	Номер = 0;
	Для Каждого Вариант Из Список Цикл
		Если Модели.Флаг(Вариант, "Выбрано") Тогда
			Возврат Номер;
		КонецЕсли;
		Номер = Номер + 1;
	КонецЦикла;

	Номер = 0;
	Для Каждого Вариант Из Список Цикл
		Если Модели.Текст(Вариант, "Значение") = Значение Тогда
			Возврат Номер;
		КонецЕсли;
		Номер = Номер + 1;
	КонецЦикла;

	Возврат -1;

КонецФункции

// Дополнительные data-атрибуты варианта: ими вызывающий объявляет соответствие «значение —
// его показ», чтобы прогрессивное улучшение не заводило вторую копию этого знания.
Функция ДанныеВарианта(Знач Вариант)

	Данные = Модели.Значение(Вариант, "Данные");
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Результат = "";
	Для Каждого КиЗ Из Данные Цикл
		// только data-*: иначе вызывающий напечатал бы через эту дверь onclick
		Если СтрНачинаетсяС(НРег(Строка(КиЗ.Ключ)), "data-") Тогда
			Результат = Результат + Экран.Атрибут(Строка(КиЗ.Ключ), КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Заблокированное поле имени не требует: оно не отправляется и служит витриной значения.
Процедура ПроверитьИмя(Знач Модель, Знач Имя)

	Если ЗначениеЗаполнено(Имя) ИЛИ Модели.Флаг(Модель, "Заблокировано") Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Компонент «Поле»: не задано Имя (атрибут name) для поля «%1» — браузер не отправит"
		+ " его значение. Задайте Имя либо пометьте поле Заблокировано, если оно только для показа.",
		Модели.Текст(Модель, "Метка", "без метки"));

КонецПроцедуры

// Русский тип поля → type HTML; незнакомое отдаётся как есть (email/url/date).
Функция ТипВвода(Знач Тип)

	Если Тип = "текст" ИЛИ НЕ ЗначениеЗаполнено(Тип) Тогда
		Возврат "text";
	ИначеЕсли Тип = "пароль" Тогда
		Возврат "password";
	ИначеЕсли Тип = "число" Тогда
		Возврат "number";
	ИначеЕсли Тип = "скрытое" Тогда
		Возврат "hidden";
	ИначеЕсли Тип = "файл" Тогда
		Возврат "file";
	КонецЕсли;

	Возврат Тип;

КонецФункции

#Область ПоляСписокИЦвет

// --- поля список и цвет (выпуск 0.12) ---

// Признаки data-* полей список и цвет — единственное место, где они названы. Их же
// перечисляет страница «Движение» в списке «Что делает скрипт».
//
//   data-chips          корень поля-списка (печатает сервер)
//   data-chips-value    скрытое поле со строкой через запятую: печатается disabled, и без
//                       скрипта форму несёт текстовое поле; скрипт включает его
//   data-chips-remove   крестик плашки
//   data-chips-chip     шаблон плашки (<template>): из него скрипт делает новые плашки
//   data-chips-live     корень, который ведёт скрипт (ставит скрипт)
//   data-swatches       корень поля цвета (печатает сервер)
//   data-swatches-row   ряд образцов (печатается hidden, показывает скрипт)
//   data-swatches-own   свой цвет — системный <input type="color"> в ряду образцов
//   data-swatches-name  имя выбранного рядом с кодом
//   data-swatches-live  корень, который ведёт скрипт (ставит скрипт)

// Поле-список: значения плашками с крестиком и строка ввода в одной рамке. Без скрипта
// это обычное текстовое поле со строкой через запятую — оно и уходит с формой; плашки
// спрятаны, скрытое поле выключено. Скрипт показывает плашки, отдаёт имя скрытому полю
// и пишет в него ту же строку.
//
// Обёртка — <div>, а не <label>: крестики плашек — кнопки, а кнопке внутри подписи чужого
// поля не место (подпись досталась бы первой из них). Подпись связана с вводом вложением.
Функция ПолеСписок(Знач Модель, Знач Имя, Знач Метка, Знач Подсказка, Знач Ошибка, Знач Ид)

	ПроверитьИмя(Модель, Имя);

	Значения = Типы.ЭлементыСписка(Модели.Значение(Модель, "Значение"));
	Строкой = СтрСоединить(Значения, ", ");
	Неизменяемое = Модели.Флаг(Модель, "Заблокировано") ИЛИ Модели.Флаг(Модель, "ТолькоЧтение");

	Плашки = "";
	Для Каждого Значение Из Значения Цикл
		Плашки = Плашки + ПлашкаСписка(Значение, Тексты.Шаблон("field.list.remove", Значение), Неизменяемое);
	КонецЦикла;

	ПодписьHTML = ?(ЗначениеЗаполнено(Метка),
		СтрШаблон("<span class=""field__label"">%1</span>", Экран.Экранировать(Метка)), "");

	Ввод = СтрШаблон("<label class=""chips-in__entry""%1>%2<input class=""field__control chips-in__input"""
			+ " type=""text""%3%4%5></label>",
		Экран.Атрибут("for", Ид), ПодписьHTML, АтрибутыВвода(Модель, Имя, Ид, Ошибка),
		Экран.Атрибут("value", Строкой), Экран.Атрибут("placeholder", Модели.Текст(Модель, "Плейсхолдер")));

	Список = СтрШаблон("<span class=""chips-in__list"" role=""list""%1 hidden>%2</span>",
		Экран.Атрибут("aria-label", Метка), Плашки);

	Скрытое = СтрШаблон("<input type=""hidden""%1%2%3 disabled data-chips-value>",
		Экран.Атрибут("name", Имя), Экран.АтрибутВсегда("value", Строкой),
		Экран.Атрибут("form", Модели.Текст(Модель, "Форма")));

	// подпись крестика новой плашки — тот же текст словаря, %1 подставляет скрипт
	Заготовка = СтрШаблон("<template data-chips-chip>%1</template>",
		ПлашкаСписка("", Тексты.Шаблон("field.list.remove", "%1"), Ложь));

	Внутри = СтрШаблон("<div class=""chips-in"">%1%2</div>%3%4", Ввод, Список, Скрытое, Заготовка)
		+ Пояснения(Подсказка, Ошибка, Ид);

	Возврат СтрШаблон("<div class=""field field--chips%1"" data-chips>%2</div>",
		?(ЗначениеЗаполнено(Ошибка), " field--error", ""), Внутри);

КонецФункции

Функция ПлашкаСписка(Знач Значение, Знач ПодписьКрестика, Знач Неизменяемое)

	Возврат СтрШаблон("<span class=""chips-in__chip"" role=""listitem""><span class=""chips-in__text"">%1</span>"
			+ "<button type=""button"" class=""chips-in__remove""%2%3 data-chips-remove>%4</button></span>",
		Экран.Экранировать(Значение), Экран.Атрибут("aria-label", ПодписьКрестика),
		Экран.БулевАтрибут("disabled", Неизменяемое), Значки.Отрисовать("закрыть"));

КонецФункции

// Поле цвета: ряд образцов кружками-радиокнопками, «свой» — системный выбор цвета, рядом
// имя и код выбранного. Значение несёт ОДНО поле — код текстом с pattern: оно уходит
// с формой и со скриптом, и без него; пустое значит «по умолчанию». Без скрипта ряд
// образцов спрятан (выбрать кружком, не меняя поля кода, нечем), и человек набирает код.
//
// Радиокнопки и выбор цвета в отправку не входят: атрибут form без формы отвязывает их от
// формы вокруг, поэтому имени поля второе значение не достаётся, а группой радиокнопки
// остаются — стрелки ходят по ряду, как у любой группы. Группа без формы общая на всю
// страницу, поэтому скрипт, показывая ряд, даёт ей своё имя (два поля с одним именем
// иначе делили бы выбор); отметку он выводит из кода.
Функция ПолеЦвет(Знач Модель, Знач Имя, Знач Метка, Знач Подсказка, Знач Ошибка, Знач Ид)

	ПроверитьИмя(Модель, Имя);

	Значение = СокрЛП(Модели.Текст(Модель, "Значение"));
	Код = Типы.КодЦвета(Значение);
	Образцы = ОбразцыЦвета(Модель);
	Неизменяемое = Модели.Флаг(Модель, "Заблокировано") ИЛИ Модели.Флаг(Модель, "ТолькоЧтение");
	ПоУмолчанию = Тексты.Текст("field.color.default");
	Свой = Тексты.Текст("field.color.own");

	ИмяВыбранного = ?(ЗначениеЗаполнено(Значение), Свой, ПоУмолчанию);
	ЕстьВыбранный = НЕ ЗначениеЗаполнено(Значение);

	Ряд = "";
	// обязательное поле пустым не бывает: «по умолчанию» ему не предлагается
	Если НЕ Модели.Флаг(Модель, "Обязательное") Тогда
		Ряд = Ряд + ОбразецЦвета(Имя, "", ПоУмолчанию, НЕ ЗначениеЗаполнено(Значение), Неизменяемое,
			" swatches__item--default");
	КонецЕсли;
	Для Каждого Образец Из Образцы Цикл
		// два образца одного цвета: отмечен первый — у группы радиокнопок выбор один
		Выбран = ЗначениеЗаполнено(Код) И НЕ ЕстьВыбранный И Образец.Цвет = Код;
		Если Выбран Тогда
			ИмяВыбранного = Образец.Имя;
			ЕстьВыбранный = Истина;
		КонецЕсли;
		Ряд = Ряд + ОбразецЦвета(Имя, Образец.Цвет, Образец.Имя, Выбран, Неизменяемое, "");
	КонецЦикла;

	// свой цвет: кружок показывает его, когда выбранное — не образец
	СвойКод = ?(ЗначениеЗаполнено(Код) И НЕ ЕстьВыбранный, Код, "");
	Ряд = Ряд + СтрШаблон("<label class=""swatches__item swatches__item--own""%1><span class=""swatches__dot""%2>"
			+ "</span><input type=""color"" class=""swatches__picker""%3%4%5 data-swatches-own>"
			+ "<span class=""visually-hidden"">%6</span></label>",
		Экран.Атрибут("title", Свой), Экран.Атрибут("style", ?(ЗначениеЗаполнено(СвойКод), "--_swatch: " + СвойКод, "")),
		Экран.АтрибутВсегда("value", ?(ЗначениеЗаполнено(Код), Код, "#000000")), Экран.АтрибутВсегда("form", ""),
		Экран.БулевАтрибут("disabled", Неизменяемое), Экран.Экранировать(Свой));

	КодHTML = СтрШаблон("<input class=""field__control swatches__code"" type=""text""%1%2%3%4%5"
			+ " spellcheck=""false"">",
		АтрибутыВвода(Модель, Имя, Ид, Ошибка), Экран.Атрибут("value", Значение),
		Экран.Атрибут("pattern", Типы.ШаблонКодаЦвета()), Экран.Атрибут("maxlength", "7"),
		Экран.Атрибут("placeholder", ПоУмолчанию) + Экран.Атрибут("aria-label", Тексты.Текст("field.color.code")));

	ПодписьHTML = ?(ЗначениеЗаполнено(Метка),
		СтрШаблон("<legend class=""field__label"">%1</legend>", Экран.Экранировать(Метка)), "");

	Внутри = ПодписьHTML
		+ СтрШаблон("<div class=""swatches"" data-swatches-row hidden>%1</div>", Ряд)
		+ СтрШаблон("<div class=""swatches__current"">%1<span class=""swatches__name"" data-swatches-name>%2</span></div>",
			КодHTML, Экран.Экранировать(ИмяВыбранного))
		+ Пояснения(Подсказка, Ошибка, Ид);

	Возврат СтрШаблон("<fieldset class=""field field--color%1"" data-swatches>%2</fieldset>",
		?(ЗначениеЗаполнено(Ошибка), " field--error", ""), Внутри);

КонецФункции

// Образец — радиокнопка-кружок: цвет кружка приходит пользовательским свойством --_swatch,
// в которое попадает только проверенный код (#rrggbb), поэтому строка стиля безопасна.
Функция ОбразецЦвета(Знач Имя, Знач Цвет, Знач Подпись, Знач Выбран, Знач Неизменяемое, Знач Вид)

	Возврат СтрШаблон("<label class=""swatches__item%1""%2><input type=""radio"" class=""swatches__radio""%3%4%5%6%7%8>"
			+ "<span class=""visually-hidden"">%9</span></label>",
		Вид, Экран.Атрибут("title", Подпись), Экран.Атрибут("name", Имя), Экран.АтрибутВсегда("value", Цвет),
		Экран.АтрибутВсегда("form", ""), Экран.Атрибут("style", ?(ЗначениеЗаполнено(Цвет), "--_swatch: " + Цвет, "")),
		Экран.БулевАтрибут("checked", Выбран), Экран.БулевАтрибут("disabled", Неизменяемое),
		Экран.Экранировать(Подпись));

КонецФункции

// Образцы приходят из кода экрана, а не от человека: код не того вида — ошибка сборки,
// а не молча серый кружок.
Функция ОбразцыЦвета(Знач Модель)

	Результат = Новый Массив();
	Для Каждого Образец Из Модели.Список(Модель, "Образцы") Цикл
		Исходный = Модели.Текст(Образец, "Цвет");
		Код = Типы.КодЦвета(Исходный);
		Если НЕ ЗначениеЗаполнено(Код) Тогда
			ВызватьИсключение СтрШаблон("Компонент «Поле»: образец цвета «%1» поля «%2» — не код"
				+ " цвета. Образец задаётся кодом вида #rrggbb, например Образец(""#1a73e8"", ""Синий"").",
				Исходный, Модели.Текст(Модель, "Метка", Модели.Текст(Модель, "Имя")));
		КонецЕсли;
		Результат.Добавить(Новый Структура("Цвет, Имя", Код, Модели.Текст(Образец, "Имя", Код)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Атрибуты ввода, общие у поля-списка и поля цвета, — те же, что у прочих полей.
Функция АтрибутыВвода(Знач Модель, Знач Имя, Знач Ид, Знач Ошибка)

	Возврат Экран.Атрибут("id", Ид)
		+ Экран.Атрибут("name", Имя)
		+ Экран.Атрибут("autocomplete", Модели.Текст(Модель, "Автозаполнение"))
		+ Экран.БулевАтрибут("required", Модели.Флаг(Модель, "Обязательное"))
		+ Экран.БулевАтрибут("disabled", Модели.Флаг(Модель, "Заблокировано"))
		+ Экран.БулевАтрибут("readonly", Модели.Флаг(Модель, "ТолькоЧтение"))
		+ ?(ЗначениеЗаполнено(Ошибка), Экран.Атрибут("aria-invalid", "true")
			+ Экран.Атрибут("aria-describedby", ИдОшибки(Ид)), "")
		+ Экран.Атрибут("form", Модели.Текст(Модель, "Форма"));

КонецФункции

Функция Пояснения(Знач Подсказка, Знач Ошибка, Знач Ид)

	Результат = "";
	Если ЗначениеЗаполнено(Подсказка) Тогда
		Результат = Результат + СтрШаблон("<span class=""field__hint"">%1</span>", Экран.Экранировать(Подсказка));
	КонецЕсли;
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Результат = Результат + СтрШаблон("<span class=""field__error"" role=""alert""%1>%2</span>",
			Экран.Атрибут("id", ИдОшибки(Ид)), Экран.Экранировать(Ошибка));
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "Иконка") _Значки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	// поля список и цвет (выпуск 0.12)
	Тексты = _Тексты;
	Значки = _Значки;
	Типы = Новый ТипыПоля();

КонецПроцедуры
