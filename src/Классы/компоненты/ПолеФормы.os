// Компонент «Поле» — желудь UI-кита. Класс зовётся ПолеФормы, потому что тип
// `Поле` занят транзитивно подгружаемой библиотекой decorator, а имена типов в
// OneScript глобальны; в наборе компонентов доступен как НаборКомпонентов.Поле().

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Тексты;  // ТекстыИнтерфейса — тексты отказов form.error.* для проверки до отправки

// Отрисовывает поле формы: подпись, ввод, пояснение и сообщение об ошибке.
//
// Параметры:
//  Модель - Структура - Имя (атрибут name; обязательно, кроме заблокированного поля),
//           Метка, Значение, Тип ("текст" | "пароль" | "число" | "флажок" | "файл" |
//           "многострочное" | "выбор" либо любой валидный type HTML), Подсказка,
//           Плейсхолдер, Автозаполнение (атрибут autocomplete), Ошибка, Обязательное,
//           Заблокировано, ТолькоЧтение, Отмечено (для флажка), Варианты (для выбора:
//           массив структур Значение, Подпись, Выбрано, Данные — Соответствие
//           дополнительных data-атрибутов варианта). Вариант с пустым Значением
//           допустим и выбирается пустым Значением поля. Ид — идентификатор управления:
//           задан, значит печатаются id, <label for> и aria-describedby сообщения
//           об ошибке; без него подпись связана с полем вложением. Минимум, Максимум,
//           Шаг и ДлинаМакс — атрибуты min, max, step и maxlength (пустые не печатаются;
//           их выводит тип значения поля, см. ТипыПоля). Шаблон — атрибут pattern
//           (регулярное выражение, которому значение обязано совпасть целиком), Форма —
//           атрибут form (якорь формы вне поля); пустые не печатаются.
//           Проверка до отправки (выпуск 0.12): ДлинаМин — атрибут minlength; Проверка
//           (Булево) — поле несёт тексты отказов словаря form.error.* признаками
//           data-error-* для каждого своего ограничения (скрипт кита пишет их под полем);
//           АдресПроверки — признак data-check: адрес, у которого скрипт спрашивает,
//           свободно ли значение (200 — свободно, 409 с текстом — занято).
//
// Возвращаемое значение:
//  Строка - фрагмент <label class="field">. Кидается исключением, если у незаблокированного
//           поля нет Имени.
//
Функция Отрисовать(Знач Модель) Экспорт

	Имя = Модели.Текст(Модель, "Имя");
	Метка = Модели.Текст(Модель, "Метка");
	Подсказка = Модели.Текст(Модель, "Подсказка");
	Ошибка = Модели.Текст(Модель, "Ошибка");
	Ид = Модели.Текст(Модель, "Ид");
	Тип = НРег(Модели.Текст(Модель, "Тип", "текст"));

	// модификатор печатается только там, где для него есть правило CSS
	Классы = "field" + ?(Тип = "флажок", " field--check", "")
		+ ?(ЗначениеЗаполнено(Ошибка), " field--error", "");

	Управление = Управление(Модель, Тип, Имя, Ид, Ошибка);
	ПодписьHTML = ?(ЗначениеЗаполнено(Метка),
		СтрШаблон("<span class=""field__label"">%1</span>", Экран.Экранировать(Метка)), "");

	// у флажка подпись идёт ПОСЛЕ управления — иначе кликабельная зона нелогична
	Внутри = ?(Тип = "флажок", Управление + ПодписьHTML, ПодписьHTML + Управление);

	Если ЗначениеЗаполнено(Подсказка) Тогда
		Внутри = Внутри + СтрШаблон("<span class=""field__hint"">%1</span>", Экран.Экранировать(Подсказка));
	КонецЕсли;

	Если ЗначениеЗаполнено(Ошибка) Тогда
		Внутри = Внутри + СтрШаблон("<span class=""field__error"" role=""alert""%1>%2</span>",
			Экран.Атрибут("id", ИдОшибки(Ид)), Экран.Экранировать(Ошибка));
	КонецЕсли;

	Возврат СтрШаблон("<label%1%2>%3</label>",
		Экран.Атрибут("class", Классы), Экран.Атрибут("for", Ид), Внутри);

КонецФункции

// Идентификатор сообщения об ошибке: он же адресуется из aria-describedby, поэтому
// считается ОДНИМ местом — иначе скринридер получил бы ссылку в пустоту.
Функция ИдОшибки(Знач Ид)
	Возврат ?(ЗначениеЗаполнено(Ид), Ид + "-err", "");
КонецФункции

Функция Управление(Знач Модель, Знач Тип, Знач Имя, Знач Ид = "", Знач Ошибка = "")

	ПроверитьИмя(Модель, Имя);

	Значение = Модели.Текст(Модель, "Значение");

	Общие = Экран.Атрибут("id", Ид)
		+ Экран.Атрибут("name", Имя)
		// без autocomplete менеджеры паролей подставляют в мастер первого запуска старую пару
		+ Экран.Атрибут("autocomplete", Модели.Текст(Модель, "Автозаполнение"))
		+ Экран.БулевАтрибут("required", Модели.Флаг(Модель, "Обязательное"))
		+ Экран.БулевАтрибут("disabled", Модели.Флаг(Модель, "Заблокировано"))
		+ Экран.БулевАтрибут("readonly", Модели.Флаг(Модель, "ТолькоЧтение"))
		// отбитое поле называет себя скринридеру само: и что оно отбито, и чем именно
		+ ?(ЗначениеЗаполнено(Ошибка), Экран.Атрибут("aria-invalid", "true")
			+ Экран.Атрибут("aria-describedby", ИдОшибки(Ид)), "")
		// поле формы вне неё: эхо-поле подтверждения стоит в окне, а уходит с формой страницы
		+ Экран.Атрибут("form", Модели.Текст(Модель, "Форма"));

	Если Тип = "многострочное" Тогда
		Возврат СтрШаблон("<textarea class=""field__control""%1%2%3%4%5>%6</textarea>",
			Общие, Экран.Атрибут("placeholder", Модели.Текст(Модель, "Плейсхолдер")),
			Экран.Атрибут("minlength", Модели.Текст(Модель, "ДлинаМин")),
			Экран.Атрибут("maxlength", Модели.Текст(Модель, "ДлинаМакс")),
			ПроверкаДоОтправки(Модель, Тип),
			Экран.Экранировать(Значение));
	КонецЕсли;

	Если Тип = "выбор" Тогда
		Возврат СтрШаблон("<select class=""field__control""%1%2>%3</select>", Общие,
			ПроверкаДоОтправки(Модель, Тип), Варианты(Модель, Значение));
	КонецЕсли;

	Если Тип = "флажок" Тогда
		Возврат СтрШаблон("<input type=""checkbox"" class=""field__check""%1%2%3%4>",
			Общие,
			Экран.Атрибут("value", ?(ЗначениеЗаполнено(Значение), Значение, "1")),
			Экран.БулевАтрибут("checked", Модели.Флаг(Модель, "Отмечено")),
			ПроверкаДоОтправки(Модель, Тип));
	КонецЕсли;

	Возврат СтрШаблон("<input class=""field__control""%1%2%3%4%5%6>",
		Экран.Атрибут("type", ТипВвода(Тип)),
		Общие,
		Экран.Атрибут("value", Значение),
		Экран.Атрибут("placeholder", Модели.Текст(Модель, "Плейсхолдер")),
		Пределы(Модель),
		ПроверкаДоОтправки(Модель, Тип));

КонецФункции

// Пределы ввода печатаются только заданными: поле без них остаётся тем же байт в байт.
// Задаёт их тип значения поля (ТипыПоля): шаг и максимум — квалификаторы числа, длина —
// квалификатор строки.
Функция Пределы(Знач Модель)

	Возврат Экран.Атрибут("min", Модели.Текст(Модель, "Минимум"))
		+ Экран.Атрибут("max", Модели.Текст(Модель, "Максимум"))
		+ Экран.Атрибут("step", Модели.Текст(Модель, "Шаг"))
		+ Экран.Атрибут("minlength", Модели.Текст(Модель, "ДлинаМин"))
		+ Экран.Атрибут("maxlength", Модели.Текст(Модель, "ДлинаМакс"))
		+ Экран.Атрибут("pattern", Модели.Текст(Модель, "Шаблон"));

КонецФункции

// --- проверка до отправки и тост (выпуск 0.12) ---
// Признаки проверки до отправки объявлены ЗДЕСЬ, в одном месте, — печатает их только поле:
//   data-check="адрес"     — у адреса скрипт спрашивает, свободно ли значение: GET адрес?имя=значение,
//                            200 — свободно, 409 с текстом — занято (текст и есть отказ);
//   data-error-required    — текст form.error.required (поле пусто);
//   data-error-type        — form.error.email или form.error.url (значение не почта, не адрес);
//   data-error-number      — form.error.number (в числовом поле не число);
//   data-error-pattern     — form.error.pattern (не совпало с шаблоном);
//   data-error-minlength   — form.error.minlength с длиной (короче minlength);
//   data-error-maxlength   — form.error.maxlength с длиной (длиннее maxlength);
//   data-error-min         — form.error.min с пределом (меньше min);
//   data-error-max         — form.error.max с пределом (больше max).
// Текст приезжает разметкой, а не живёт в скрипте: словарь один у сервера и у браузера,
// и отказ до отправки звучит теми же словами, что и отказ сервера после неё. Печатается
// только у поля с Проверкой и только для его ограничений: прежнее поле — то же байт в байт.
Функция ПроверкаДоОтправки(Знач Модель, Знач Тип)

	Результат = Экран.Атрибут("data-check", Модели.Текст(Модель, "АдресПроверки"));
	Если НЕ Модели.Флаг(Модель, "Проверка") Тогда
		Возврат Результат;
	КонецЕсли;

	Если Модели.Флаг(Модель, "Обязательное") Тогда
		Результат = Результат + Экран.Атрибут("data-error-required", Тексты.Текст("form.error.required"));
	КонецЕсли;

	Ввод = ТипВвода(Тип);
	Если Ввод = "email" ИЛИ Ввод = "url" Тогда
		Результат = Результат + Экран.Атрибут("data-error-type", Тексты.Текст("form.error." + Ввод));
	ИначеЕсли Ввод = "number" Тогда
		Результат = Результат + Экран.Атрибут("data-error-number", Тексты.Текст("form.error.number"));
	КонецЕсли;

	Если ЗначениеЗаполнено(Модели.Текст(Модель, "Шаблон")) Тогда
		Результат = Результат + Экран.Атрибут("data-error-pattern", Тексты.Текст("form.error.pattern"));
	КонецЕсли;

	Для Каждого Предел Из СтрРазделить("ДлинаМин:minlength,ДлинаМакс:maxlength,Минимум:min,Максимум:max", ",") Цикл
		Части = СтрРазделить(Предел, ":");
		Значение = Модели.Текст(Модель, Части[0]);
		Если ЗначениеЗаполнено(Значение) Тогда
			Результат = Результат + Экран.Атрибут("data-error-" + Части[1],
				Тексты.Шаблон("form.error." + Части[1], Значение));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Варианты(Знач Модель, Знач Значение)

	Список = Модели.Список(Модель, "Варианты");
	Выбранный = НомерВыбранного(Список, Значение);

	Результат = "";
	Номер = 0;
	Для Каждого Вариант Из Список Цикл
		ЗначениеВарианта = Модели.Текст(Вариант, "Значение");
		Подпись = Модели.Текст(Вариант, "Подпись", ЗначениеВарианта);
		// value печатается ВСЕГДА: <option> без него отправляет собственный текст,
		// и вариант с пустым значением приезжал бы на сервер своей подписью
		Результат = Результат + СтрШаблон("<option%1%2%3>%4</option>",
			Экран.АтрибутВсегда("value", ЗначениеВарианта),
			ДанныеВарианта(Вариант),
			Экран.БулевАтрибут("selected", Номер = Выбранный),
			Экран.Экранировать(Подпись));
		Номер = Номер + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Пометку `selected` получает РОВНО ОДИН вариант: у одиночного <select> их не бывает
// больше, и разметка с двумя пометками читается по-разному кем угодно (браузер берёт
// последнюю, любой разбор — первую). Побеждает явный флаг варианта, а совпадение
// значения поля — запасной путь: пустое значение поля так по-прежнему предвыбирает
// вариант с пустым значением, если явного флага не проставил никто.
Функция НомерВыбранного(Знач Список, Знач Значение)

	Номер = 0;
	Для Каждого Вариант Из Список Цикл
		Если Модели.Флаг(Вариант, "Выбрано") Тогда
			Возврат Номер;
		КонецЕсли;
		Номер = Номер + 1;
	КонецЦикла;

	Номер = 0;
	Для Каждого Вариант Из Список Цикл
		Если Модели.Текст(Вариант, "Значение") = Значение Тогда
			Возврат Номер;
		КонецЕсли;
		Номер = Номер + 1;
	КонецЦикла;

	Возврат -1;

КонецФункции

// Дополнительные data-атрибуты варианта: ими вызывающий объявляет соответствие «значение —
// его показ», чтобы прогрессивное улучшение не заводило вторую копию этого знания.
Функция ДанныеВарианта(Знач Вариант)

	Данные = Модели.Значение(Вариант, "Данные");
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат "";
	КонецЕсли;

	Результат = "";
	Для Каждого КиЗ Из Данные Цикл
		// только data-*: иначе вызывающий напечатал бы через эту дверь onclick
		Если СтрНачинаетсяС(НРег(Строка(КиЗ.Ключ)), "data-") Тогда
			Результат = Результат + Экран.Атрибут(Строка(КиЗ.Ключ), КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Заблокированное поле имени не требует: оно не отправляется и служит витриной значения.
Процедура ПроверитьИмя(Знач Модель, Знач Имя)

	Если ЗначениеЗаполнено(Имя) ИЛИ Модели.Флаг(Модель, "Заблокировано") Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон(
		"Компонент «Поле»: не задано Имя (атрибут name) для поля «%1» — браузер не отправит"
		+ " его значение. Задайте Имя либо пометьте поле Заблокировано, если оно только для показа.",
		Модели.Текст(Модель, "Метка", "без метки"));

КонецПроцедуры

// Русский тип поля → type HTML; незнакомое отдаётся как есть (email/url/date).
Функция ТипВвода(Знач Тип)

	Если Тип = "текст" ИЛИ НЕ ЗначениеЗаполнено(Тип) Тогда
		Возврат "text";
	ИначеЕсли Тип = "пароль" Тогда
		Возврат "password";
	ИначеЕсли Тип = "число" Тогда
		Возврат "number";
	ИначеЕсли Тип = "скрытое" Тогда
		Возврат "hidden";
	ИначеЕсли Тип = "файл" Тогда
		Возврат "file";
	КонецЕсли;

	Возврат Тип;

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	// проверка до отправки и тост (выпуск 0.12): тексты отказов печатаются у поля
	Тексты = _Тексты;

КонецПроцедуры
