// Компонент «Плитка» — желудь UI-кита: сводный показатель со ссылкой на список за ним.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Значки;  // Иконка

// Отрисовывает плитку сводного показателя.
//
// Параметры:
//  Модель - Структура - Значение (ОБЯЗАТЕЛЬНО; форматирует вызывающий — компонент не
//           знает ни локали, ни единиц), Подпись (ОБЯЗАТЕЛЬНА), Пояснение, Адрес
//           (плитка целиком становится ссылкой), Иконка, Вид ("" | "ok" | "warn" |
//           "err" | "accent").
//
// Возвращаемое значение:
//  Строка - фрагмент <a|div class="tile">. Кидается исключением, если пусто Значение
//           или Подпись.
//
Функция Отрисовать(Знач Модель) Экспорт

	Значение = Модели.Текст(Модель, "Значение");
	Подпись = Модели.Текст(Модель, "Подпись");
	ПроверитьМодель(Значение, Подпись);

	Вид = НормализованныйВид(Модели.Текст(Модель, "Вид"));
	Классы = "tile" + ?(ЗначениеЗаполнено(Вид), " tile--" + Вид, "");

	Внутри = СтрШаблон("<span class=""tile__value"">%1%2</span>",
			Значки.Отрисовать(Модели.Текст(Модель, "Иконка")), Экран.Экранировать(Значение))
		+ СтрШаблон("<span class=""tile__label"">%1</span>", Экран.Экранировать(Подпись));

	Пояснение = Модели.Текст(Модель, "Пояснение");
	Если ЗначениеЗаполнено(Пояснение) Тогда
		Внутри = Внутри + СтрШаблон("<span class=""tile__hint"">%1</span>", Экран.Экранировать(Пояснение));
	КонецЕсли;

	Адрес = Модели.Текст(Модель, "Адрес");
	Если ЗначениеЗаполнено(Адрес) Тогда
		// при недопустимой схеме плитка остаётся плиткой, но перестаёт быть ссылкой
		Возврат Экран.Ссылка(Адрес, Подпись, Классы + " tile--link", Внутри);
	КонецЕсли;

	Возврат СтрШаблон("<div%1>%2</div>", Экран.Атрибут("class", Классы), Внутри);

КонецФункции

// Приводит вид плитки к allowlist: значение из модели попадает в CSS-класс.
//
// Параметры:
//  Вид - Произвольный - вид из модели.
//
// Возвращаемое значение:
//  Строка - "ok" | "warn" | "err" | "accent" либо "" для нейтральной плитки.
//
Функция НормализованныйВид(Знач Вид) Экспорт

	Значение = НРег(СокрЛП(?(Вид = Неопределено, "", Строка(Вид))));

	Если Значение = "ok" ИЛИ Значение = "успех" Тогда
		Возврат "ok";
	ИначеЕсли Значение = "warn" ИЛИ Значение = "предупреждение" Тогда
		Возврат "warn";
	ИначеЕсли Значение = "err" ИЛИ Значение = "error" ИЛИ Значение = "ошибка" Тогда
		Возврат "err";
	ИначеЕсли Значение = "accent" ИЛИ Значение = "акцент" Тогда
		Возврат "accent";
	КонецЕсли;

	Возврат "";

КонецФункции

Процедура ПроверитьМодель(Знач Значение, Знач Подпись)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		ВызватьИсключение СтрШаблон(
			"Компонент «Плитка» («%1»): не задано Значение — плитка нарисовала бы пустую рамку.",
			?(ЗначениеЗаполнено(Подпись), Подпись, "без подписи"));
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Подпись) Тогда
		ВызватьИсключение СтрШаблон(
			"Компонент «Плитка» («%1»): не задана Подпись — читатель не узнает, что считает это число.",
			Значение);
	КонецЕсли;

КонецПроцедуры

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "Иконка") _Значки) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Значки = _Значки;

КонецПроцедуры
