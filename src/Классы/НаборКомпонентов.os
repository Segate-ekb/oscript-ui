// Набор компонентов — желудь UI-кита: одна точка доступа к слою компонентов,
// чтобы вызывающий не объявлял два десятка пластилинов. Логики рендера здесь нет.

Перем Карточки;    // Карточка
Перем Поля;        // ПолеФормы
Перем ПоляКонфига; // ПолеИзКонфига
Перем Таблицы;     // Таблица
Перем Тосты;       // Тост
Перем Плашки;      // Плашка
Перем Деревья;     // ДеревоРазделов
Перем Панели;      // ПанельСохранения
Перем Значки;      // Иконка
Перем Тумблеры;    // Тумблер
Перем Проводники;  // Проводник
Перем Кнопки;      // Кнопка
Перем Вкладки;     // Табы
Перем Пустоты;     // ПустоеСостояние
Перем Зоны;        // ОпаснаяЗона
Перем Команды;     // БлокКоманды
Перем Шапки;       // ШапкаОбъекта
Перем Страницы;    // Пагинация
Перем Плитки;      // Плитка
Перем Сетки;       // Сетка
Перем ПоляСкрытые; // СкрытоеПоле
Перем Заглавия;    // ЗаголовокСтраницы
Перем СтраницыОшибок; // СтраницаОшибки
Перем ФормыОтбора; // ФормаОтбора
Перем Полосы;      // ПолосаЗаполнения
Перем Менюшки;     // Меню
Перем РядыМеты;    // РядМеты

// Компонент «Карточка».
//
// Возвращаемое значение:
//  Карточка - желудь компонента.
//
Функция Карточка() Экспорт
	Возврат Карточки;
КонецФункции

// Компонент «Поле».
//
// Возвращаемое значение:
//  ПолеФормы - желудь компонента.
//
Функция Поле() Экспорт
	Возврат Поля;
КонецФункции

// Компонент «Поле из конфига».
//
// Возвращаемое значение:
//  ПолеИзКонфига - желудь компонента.
//
Функция ПолеИзКонфига() Экспорт
	Возврат ПоляКонфига;
КонецФункции

// Компонент «Таблица».
//
// Возвращаемое значение:
//  Таблица - желудь компонента.
//
Функция Таблица() Экспорт
	Возврат Таблицы;
КонецФункции

// Компонент «Тост».
//
// Возвращаемое значение:
//  Тост - желудь компонента.
//
Функция Тост() Экспорт
	Возврат Тосты;
КонецФункции

// Компонент «Тег»; класс называется Плашка — имя Тег занято сущностью db/Тег.
//
// Возвращаемое значение:
//  Плашка - желудь компонента.
//
Функция Тег() Экспорт
	Возврат Плашки;
КонецФункции

// Компонент «Дерево разделов».
//
// Возвращаемое значение:
//  ДеревоРазделов - желудь компонента.
//
Функция ДеревоРазделов() Экспорт
	Возврат Деревья;
КонецФункции

// Компонент «Панель сохранения».
//
// Возвращаемое значение:
//  ПанельСохранения - желудь компонента.
//
Функция ПанельСохранения() Экспорт
	Возврат Панели;
КонецФункции

// Компонент «Иконка».
//
// Возвращаемое значение:
//  Иконка - желудь компонента.
//
Функция Иконка() Экспорт
	Возврат Значки;
КонецФункции

// Компонент «Тумблер» — поле выбора из двух состояний.
//
// Возвращаемое значение:
//  Тумблер - желудь компонента.
//
Функция Тумблер() Экспорт
	Возврат Тумблеры;
КонецФункции

// Компонент «Проводник» — список шагов многошаговой задачи.
//
// Возвращаемое значение:
//  Проводник - желудь компонента.
//
Функция Проводник() Экспорт
	Возврат Проводники;
КонецФункции

// Компонент «Кнопка» — основная/вторичная/опасная/ссылка, размеры, «занята».
//
// Возвращаемое значение:
//  Кнопка - желудь компонента.
//
Функция Кнопка() Экспорт
	Возврат Кнопки;
КонецФункции

// Компонент «Табы» — вкладки страницы объекта, каждая своим URL.
//
// Возвращаемое значение:
//  Табы - желудь компонента.
//
Функция Табы() Экспорт
	Возврат Вкладки;
КонецФункции

// Компонент «Пустое состояние» — иконка, объяснение, призыв к действию.
//
// Возвращаемое значение:
//  ПустоеСостояние - желудь компонента.
//
Функция ПустоеСостояние() Экспорт
	Возврат Пустоты;
КонецФункции

// Компонент «Опасная зона» — необратимые действия с обязательным подтверждением.
//
// Возвращаемое значение:
//  ОпаснаяЗона - желудь компонента.
//
Функция ОпаснаяЗона() Экспорт
	Возврат Зоны;
КонецФункции

// Компонент «Блок команды» — копируемая команда (главный CTA страницы пакета).
//
// Возвращаемое значение:
//  БлокКоманды - желудь компонента.
//
Функция БлокКоманды() Экспорт
	Возврат Команды;
КонецФункции

// Компонент «Шапка объекта» — пакет / пул / группа.
//
// Возвращаемое значение:
//  ШапкаОбъекта - желудь компонента.
//
Функция ШапкаОбъекта() Экспорт
	Возврат Шапки;
КонецФункции

// Компонент «Пагинация» — постраничная навигация списков.
//
// Возвращаемое значение:
//  Пагинация - желудь компонента.
//
Функция Пагинация() Экспорт
	Возврат Страницы;
КонецФункции

// Компонент «Плитка» — сводный показатель.
//
// Возвращаемое значение:
//  Плитка - желудь компонента.
//
Функция Плитка() Экспорт
	Возврат Плитки;
КонецФункции

// Компонент «Сетка» — раскладка равнозначных блоков в ряд с переносом.
//
// Возвращаемое значение:
//  Сетка - желудь компонента.
//
Функция Сетка() Экспорт
	Возврат Сетки;
КонецФункции

// Компонент «Скрытое поле» — <input type="hidden"> с экранированием.
//
// Возвращаемое значение:
//  СкрытоеПоле - желудь компонента.
//
Функция СкрытоеПоле() Экспорт
	Возврат ПоляСкрытые;
КонецФункции

// Компонент «Заголовок страницы» — <h1>/<h2> с muted-пояснением.
//
// Возвращаемое значение:
//  ЗаголовокСтраницы - желудь компонента.
//
Функция ЗаголовокСтраницы() Экспорт
	Возврат Заглавия;
КонецФункции

// Компонент «Страница ошибки» — тело страницы отказа 403/404/405.
//
// Возвращаемое значение:
//  СтраницаОшибки - желудь компонента.
//
Функция СтраницаОшибки() Экспорт
	Возврат СтраницыОшибок;
КонецФункции

// Компонент «Форма отбора» — поле, кнопка и сохранение GET-параметров.
//
// Возвращаемое значение:
//  ФормаОтбора - желудь компонента.
//
Функция ФормаОтбора() Экспорт
	Возврат ФормыОтбора;
КонецФункции

// Компонент «Полоса заполнения» — индикатор доли занятого.
//
// Возвращаемое значение:
//  ПолосаЗаполнения - желудь компонента.
//
Функция ПолосаЗаполнения() Экспорт
	Возврат Полосы;
КонецФункции

// Компонент «Меню» — кнопка-открывашка и панель пунктов в верхнем слое браузера.
//
// Возвращаемое значение:
//  Меню - желудь компонента.
//
Функция Меню() Экспорт
	Возврат Менюшки;
КонецФункции

// Компонент «Ряд меты» — строка «значок + значение»; какие подписи бывают, знает вызывающий.
//
// Возвращаемое значение:
//  РядМеты - желудь компонента.
//
Функция РядМеты() Экспорт
	Возврат РядыМеты;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Карточка") _Карточки,
	&Пластилин(Значение = "ПолеФормы") _Поля,
	&Пластилин(Значение = "ПолеИзКонфига") _ПоляКонфига,
	&Пластилин(Значение = "Таблица") _Таблицы,
	&Пластилин(Значение = "Тост") _Тосты,
	&Пластилин(Значение = "Плашка") _Плашки,
	&Пластилин(Значение = "ДеревоРазделов") _Деревья,
	&Пластилин(Значение = "ПанельСохранения") _Панели,
	&Пластилин(Значение = "Иконка") _Значки,
	&Пластилин(Значение = "Тумблер") _Тумблеры,
	&Пластилин(Значение = "Проводник") _Проводники,
	&Пластилин(Значение = "Кнопка") _Кнопки,
	&Пластилин(Значение = "Табы") _Вкладки,
	&Пластилин(Значение = "ПустоеСостояние") _Пустоты,
	&Пластилин(Значение = "ОпаснаяЗона") _Зоны,
	&Пластилин(Значение = "БлокКоманды") _Команды,
	&Пластилин(Значение = "ШапкаОбъекта") _Шапки,
	&Пластилин(Значение = "Пагинация") _Страницы,
	&Пластилин(Значение = "Плитка") _Плитки,
	&Пластилин(Значение = "Сетка") _Сетки,
	&Пластилин(Значение = "СкрытоеПоле") _ПоляСкрытые,
	&Пластилин(Значение = "ЗаголовокСтраницы") _Заглавия,
	&Пластилин(Значение = "СтраницаОшибки") _СтраницыОшибок,
	&Пластилин(Значение = "ФормаОтбора") _ФормыОтбора,
	&Пластилин(Значение = "ПолосаЗаполнения") _Полосы,
	&Пластилин(Значение = "Меню") _Менюшки,
	&Пластилин(Значение = "РядМеты") _РядыМеты) Экспорт

	Карточки = _Карточки;
	Поля = _Поля;
	ПоляКонфига = _ПоляКонфига;
	Таблицы = _Таблицы;
	Тосты = _Тосты;
	Плашки = _Плашки;
	Деревья = _Деревья;
	Панели = _Панели;
	Значки = _Значки;
	Тумблеры = _Тумблеры;
	Проводники = _Проводники;
	Кнопки = _Кнопки;
	Вкладки = _Вкладки;
	Пустоты = _Пустоты;
	Зоны = _Зоны;
	Команды = _Команды;
	Шапки = _Шапки;
	Страницы = _Страницы;
	Плитки = _Плитки;
	Сетки = _Сетки;
	ПоляСкрытые = _ПоляСкрытые;
	Заглавия = _Заглавия;
	СтраницыОшибок = _СтраницыОшибок;
	ФормыОтбора = _ФормыОтбора;
	Полосы = _Полосы;
	Менюшки = _Менюшки;
	РядыМеты = _РядыМеты;

КонецПроцедуры
