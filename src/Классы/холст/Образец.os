// Образец — желудь UI-кита: печать узла Кит.Образец (выпуск 0.12, шаг 17). Рамка
// предпросмотра: подпись, переключатель темы и сама рамка, в которую кладут любое дерево —
// что именно показывать, решает приложение. Вместе с зеркалом значения (слово Зеркало
// у любого узла) образец меняется по мере ввода, без сервера.
//
// Тема рамки — атрибут data-theme на ней. Палитры в голове страницы привязаны к <html>
// (тёмная — :root, светлая — html[data-theme="light"]), поэтому вложенная рамка их
// не наследует: палитру для рамки скрипт кита собирает из того же блока токенов страницы.
// Без скрипта рамка показана в теме страницы, а переключатель лист прячет — кнопка,
// которая ничего не меняет, хуже, чем никакой.

Перем Экран;   // ЭкранированиеHTML
Перем Тексты;  // ТекстыИнтерфейса

#Область ПубличныйИнтерфейс

// Печатает рамку образца.
//
// Параметры:
//  Модель - Структура - Подпись (обязательна: что показано — она и подпись фигуры для
//           скринридера), Тема («light» | «dark» | "" — тема рамки при печати; пусто —
//           тема страницы), Атрибуты (ДОВЕРЕННЫЙ фрагмент атрибутов фигуры: id, класс,
//           data-признаки — его печатает холст), Тело (ДОВЕРЕННЫЙ HTML содержимого рамки).
//
// Возвращаемое значение:
//  Строка - HTML <figure>.
//
Функция Отрисовать(Знач Модель) Экспорт

	Подпись = Поле(Модель, "Подпись");
	Если НЕ ЗначениеЗаполнено(СокрЛП(Подпись)) Тогда
		ВызватьИсключение "Образец: не задана подпись. Ею фигура названа для скринридера,"
			+ " и без неё два образца на странице не различить. Кит.Образец(""Шапка сайта"", …).";
	КонецЕсли;

	Тема = Поле(Модель, "Тема");

	Возврат СтрШаблон("<figure%1><figcaption class=""preview__label"">%2</figcaption>"
			+ "<div class=""preview__themes"" role=""group""%3>%4%5</div>"
			+ "<div class=""preview__frame""%6>%7</div></figure>",
		Поле(Модель, "Атрибуты"),
		Экран.Экранировать(Подпись),
		Экран.Атрибут("aria-label", Тексты.Текст("preview.theme")),
		КнопкаТемы("light", Тексты.Текст("preview.light"), Тема),
		КнопкаТемы("dark", Тексты.Текст("preview.dark"), Тема),
		Экран.Атрибут("data-theme", Тема),
		Поле(Модель, "Тело"));

КонецФункции

// Тема образца из слова Тема: по-русски, как в остальном словаре кита, или значением
// атрибута. Неизвестная тема останавливает сборку: рамка тихо осталась бы в теме страницы.
//
// Параметры:
//  Значение - Строка - «светлая» | «тёмная» | «light» | «dark» | "".
//
// Возвращаемое значение:
//  Строка - «light», «dark» или "".
//
Функция ЗначениеТемы(Знач Значение) Экспорт

	Текст = НРег(СокрЛП(Строка(?(Значение = Неопределено, "", Значение))));
	Если Текст = "" Тогда
		Возврат "";
	ИначеЕсли Текст = "светлая" ИЛИ Текст = "light" Тогда
		Возврат "light";
	ИначеЕсли Текст = "тёмная" ИЛИ Текст = "темная" ИЛИ Текст = "dark" Тогда
		Возврат "dark";
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Образец: темы «%1» нет. Темы образца: «светлая», «тёмная»;"
		+ " без слова Тема рамка показана в теме страницы.", Значение);

КонецФункции

// Признак кнопки переключателя темы: по нему скрипт находит кнопку и узнаёт её тему.
//
// Возвращаемое значение:
//  Строка - имя атрибута.
//
Функция ПризнакТемы() Экспорт
	Возврат "data-preview-theme";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Переключатель — две кнопки-тумблера (aria-pressed), а не радиокнопки: радиокнопки
// внутри формы ушли бы на сервер её полем, а тема образца серверу не нужна.
Функция КнопкаТемы(Знач Значение, Знач Подпись, Знач Тема)

	Возврат СтрШаблон("<button type=""button"" class=""preview__theme""%1 aria-pressed=""%2"">%3</button>",
		Экран.Атрибут(ПризнакТемы(), Значение),
		?(Тема = Значение, "true", "false"),
		Экран.Экранировать(Подпись));

КонецФункции

Функция Поле(Знач Модель, Знач Имя)

	Значение = "";
	Если НЕ Модель.Свойство(Имя, Значение) ИЛИ Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Значение;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Экран = _Экран;
	Тексты = _Тексты;

КонецПроцедуры
