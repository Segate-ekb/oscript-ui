// Сегменты — желудь UI-кита: печать узла Кит.Сегменты — выбора одного из немногих
// (пресет, тема, режим) рядом кнопок в одной пилюле. Дерево узлов собирает модель
// (РазметкаЭлементов), здесь она становится разметкой; признаки data-* сегментов объявлены
// здесь, в одном месте.
//
// Под капотом — настоящие <input type="radio"> одного имени: выбор уходит с формой
// без скрипта, стрелки двигают выбор движком браузера, выбранный сегмент лист заливает
// по :checked. Наборы полей под сегментами переключает тоже лист: панель номер N видна,
// когда отмечен сегмент номер N (:has(:checked)), — скрипта нет и тут.

Перем Экран;   // ЭкранированиеHTML
Перем Набор;   // НаборКомпонентов — галка выбранного сегмента

#Область ПубличныйИнтерфейс

// Печатает сегменты: группу радиокнопок в пилюле и, если у сегментов есть наборы полей,
// панели этих наборов под ней. Без сегментов не печатает ничего.
//
// Параметры:
//  Модель - Структура - Атрибуты (ДОВЕРЕННАЯ строка атрибутов группы: класс, id, data-*),
//           Имя (атрибут name радиокнопок), Подпись (имя группы для скринридера,
//           aria-label), Выбрано (значение выбранного сегмента), СохранятьСразу (выбор сам
//           отправляет форму), Сегменты (массив структур: Значение, Подпись, Выбран —
//           Булево, Набор — ДОВЕРЕННЫЙ HTML набора полей сегмента или ""), Источник
//           (необязательно: откуда значение — «по умолчанию · ui.theme»; печатается перед
//           группой и стоит справа на строке подписи группы), ИдИсточника (id источника:
//           на него ссылается aria-describedby группы), Ошибка (необязательно, дев-сборка
//           10: отказ сервера словами — строкой под пилюлей, как отказ под полем; группа
//           aria-invalid="true"), ИдОшибки (id строки отказа: на него ссылается
//           aria-describedby группы).
//
// Возвращаемое значение:
//  Строка - <div class="segments" role="radiogroup"> либо обёртка .segments-set с группой
//           и панелями наборов; "" без сегментов.
//
Функция Отрисовать(Знач Модель) Экспорт

	Сегменты_ = Модель.Сегменты;
	Если Сегменты_.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	ПроверитьЗначения(Сегменты_, Модель.Имя);

	Выбранный = НомерВыбранного(Сегменты_, Модель.Выбрано);
	ЕстьНаборы = ЕстьНаборы(Сегменты_);
	Если ЕстьНаборы И Сегменты_.Количество() > НаборовНаЛисте() Тогда
		ВызватьИсключение СтрШаблон("Сегменты «%1»: наборов полей у них %2, а лист кита"
			+ " переключает не больше %3 — так много вариантов сегментами не выбирают:"
			+ " положите выбор в поле .Вариант(…), а наборы — в шаги или разделы формы.",
			Модель.Имя, Число_(Сегменты_.Количество()), Число_(НаборовНаЛисте()));
	КонецЕсли;

	Галка = Набор.Иконка().Отрисовать("галочка");
	Сохранять = Модель.СохранятьСразу = Истина;

	Источник = "";
	ИдИсточника = "";
	Если Модель.Свойство("Источник", Источник) И ЗначениеЗаполнено(Источник) Тогда
		Модель.Свойство("ИдИсточника", ИдИсточника);
	Иначе
		Источник = "";
	КонецЕсли;

	Ошибка = "";
	ИдОшибки = "";
	Если Модель.Свойство("Ошибка", Ошибка) И ЗначениеЗаполнено(Ошибка) Тогда
		Модель.Свойство("ИдОшибки", ИдОшибки);
	Иначе
		Ошибка = "";
	КонецЕсли;
	Описания = Новый Массив();
	Если ЗначениеЗаполнено(Источник) Тогда
		Описания.Добавить(ИдИсточника);
	КонецЕсли;
	Если ЗначениеЗаполнено(Ошибка) Тогда
		Описания.Добавить(ИдОшибки);
	КонецЕсли;

	Части = Новый Массив();
	Части.Добавить(СтрШаблон("<div%1 role=""radiogroup""%2%3%4>", Модель.Атрибуты,
		Экран.Атрибут("aria-label", Модель.Подпись),
		?(Описания.Количество() > 0, Экран.Атрибут("aria-describedby", СтрСоединить(Описания, " ")), ""),
		?(ЗначениеЗаполнено(Ошибка), " aria-invalid=""true""", "")));
	Номер = 0;
	Для Каждого Сегмент Из Сегменты_ Цикл
		Части.Добавить(СтрШаблон("<label class=""segments__item""><input type=""radio"""
			+ " class=""segments__input""%1%2%3%4><span class=""segments__label"">"
			+ "<span class=""segments__check"" aria-hidden=""true"">%5</span>"
			+ "<span class=""segments__text"">%6</span></span></label>",
			Экран.Атрибут("name", Модель.Имя),
			Экран.АтрибутВсегда("value", Сегмент.Значение),
			Экран.БулевАтрибут("checked", Номер = Выбранный),
			Экран.БулевАтрибут(ПризнакСохранения(), Сохранять),
			Галка, Экран.Экранировать(Сегмент.Подпись)));
		Номер = Номер + 1;
	КонецЦикла;
	Части.Добавить("</div>");
	Отказ = СтрокаОтказа(Ошибка, ИдОшибки);

	Если НЕ ЕстьНаборы Тогда
		Возврат СИсточником(СтрСоединить(Части, "") + Отказ, Источник, ИдИсточника);
	КонецЕсли;

	// панель печатается у КАЖДОГО сегмента, и у того, чей набор пуст: лист сопоставляет
	// сегмент с панелью по номеру, и пропущенная панель сдвинула бы все следующие
	Части.Вставить(0, "<div class=""segments-set"">");
	Для Каждого Сегмент Из Сегменты_ Цикл
		Части.Добавить(СтрШаблон("<div class=""segments__panel""%1>%2</div>",
			Экран.АтрибутВсегда(ПризнакНабора(), Сегмент.Значение), Сегмент.Набор));
	КонецЦикла;
	// строка отказа — после панелей: лист сопоставляет панель с сегментом по её номеру среди
	// детей набора, и строка между группой и панелями сдвинула бы их; под пилюлю её ставит
	// порядок флекса
	Части.Добавить(Отказ);
	Части.Добавить("</div>");

	Возврат СИсточником(СтрСоединить(Части, ""), Источник, ИдИсточника);

КонецФункции

// Печатает панель сегмента вне его набора: область с местом группы сегментов и номером
// сегмента — по ним лист показывает её, пока в той же форме отмечен этот сегмент.
//
// Параметры:
//  Модель - Структура - Атрибуты (ДОВЕРЕННАЯ строка атрибутов: класс, id, data-*), Место
//           (номер группы сегментов среди групп формы с панелями, с 1), Номер (номер
//           сегмента с 1), Значение (значение этого сегмента), Содержимое (ДОВЕРЕННЫЙ HTML).
//
// Возвращаемое значение:
//  Строка - <div class="segments-panel" data-segments-slot data-segments-number data-segment>.
//
Функция ОтрисоватьПанель(Знач Модель) Экспорт

	Возврат СтрШаблон("<div%1%2%3%4>%5</div>", Модель.Атрибуты,
		ПризнакМестаГруппы(Модель.Место),
		Экран.АтрибутВсегда(ПризнакНомераСегмента(), Число_(Модель.Номер)),
		Экран.АтрибутВсегда(ПризнакНабора(), Модель.Значение),
		Модель.Содержимое);

КонецФункции

// Признак места группы сегментов среди групп формы с панелями — его печатают и группа,
// и её панели вне набора: лист сопоставляет их по нему.
//
// Параметры:
//  Место - Число - номер группы с 1.
//
// Возвращаемое значение:
//  Строка - « data-segments-slot="N"».
//
Функция ПризнакМестаГруппы(Знач Место) Экспорт
	Возврат Экран.АтрибутВсегда("data-segments-slot", Число_(Место));
КонецФункции

// Сколько групп сегментов с панелями вне набора различает лист кита в одной форме: правила
// в oscript-ui.css перечислены по месту группы и номеру сегмента, число обязано совпадать.
//
// Возвращаемое значение:
//  Число
//
Функция МестПанелейНаЛисте() Экспорт
	Возврат 4;
КонецФункции

// Сколько наборов полей переключает лист кита: правила :has() в oscript-ui.css
// перечислены по номеру сегмента, и число здесь обязано совпадать с ними.
//
// Возвращаемое значение:
//  Число
//
Функция НаборовНаЛисте() Экспорт
	Возврат 8;
КонецФункции

#КонецОбласти

#Область Признаки

// Признаки data-* сегментов — единственное место, где они названы. Их же перечисляет
// страница «Движение».
//
//   data-segment     панель набора полей сегмента; значение — значение его сегмента.
//                    Набор переключает лист (по номеру панели), а признак нужен своему
//                    CSS и скрипту страницы, чтобы найти набор по значению
//   data-autosubmit  у радиокнопок сегментов со словом СохранятьСразу — тот же признак,
//                    что у тумблера: выбор сам отправляет форму (раздел 6 скрипта кита)
//   data-segments-slot    у группы сегментов, на которую ссылаются панели вне набора, и у
//                    этих панелей: место группы среди групп формы с панелями (0.13, дев-сборка 7)
//   data-segments-number  у панели вне набора: номер сегмента с 1, при котором она видна;
//                    data-segment у неё — значение этого сегмента, как у панели набора

Функция ПризнакНабора()
	Возврат "data-segment";
КонецФункции

Функция ПризнакСохранения()
	Возврат "data-autosubmit";
КонецФункции

Функция ПризнакНомераСегмента()
	Возврат "data-segments-number";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Источник значения — ПЕРЕД группой, а не под ней: справка о значении стоит там, где глаз
// читает, что выбирают, — на строке подписи группы (лист прижимает его вправо и кладёт
// подпись группы влево). Под пилюлей он оторвался бы от неё: пилюля уже строки.
Функция СИсточником(Знач Сегменты_, Знач Источник, Знач ИдИсточника)

	Если НЕ ЗначениеЗаполнено(Источник) Тогда
		Возврат Сегменты_;
	КонецЕсли;

	Возврат СтрШаблон("<span class=""segments__origin""%1>%2</span>%3",
		Экран.Атрибут("id", ИдИсточника), Экран.Экранировать(Источник), Сегменты_);

КонецФункции

// Строка отказа — та же, что у поля (field__error, role="alert"): глаз и скринридер
// встречают отказ сегментов так же, как отказ поля рядом.
Функция СтрокаОтказа(Знач Ошибка, Знач ИдОшибки)

	Если НЕ ЗначениеЗаполнено(Ошибка) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон("<span class=""field__error segments__error"" role=""alert""%1>%2</span>",
		Экран.Атрибут("id", ИдОшибки), Экран.Экранировать(Ошибка));

КонецФункции

// Отмечен ровно один сегмент: группа радиокнопок без отмеченной не отправляет имени вовсе,
// и сервер не отличил бы «не выбрано» от «поле пропало». Побеждает сегмент со словом
// Выбран(), за ним — совпавший с Выбрано(Значение), без них — первый: так же браузер
// показывает выпадающий список, чьё значение не нашлось среди вариантов.
Функция НомерВыбранного(Знач Сегменты_, Знач Выбрано)

	Номер = 0;
	Для Каждого Сегмент Из Сегменты_ Цикл
		Если Сегмент.Выбран = Истина Тогда
			Возврат Номер;
		КонецЕсли;
		Номер = Номер + 1;
	КонецЦикла;

	Если Выбрано <> Неопределено Тогда
		Номер = 0;
		Для Каждого Сегмент Из Сегменты_ Цикл
			Если Сегмент.Значение = Строка(Выбрано) Тогда
				Возврат Номер;
			КонецЕсли;
			Номер = Номер + 1;
		КонецЦикла;
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция ЕстьНаборы(Знач Сегменты_)

	Для Каждого Сегмент Из Сегменты_ Цикл
		Если ЗначениеЗаполнено(Сегмент.Набор) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Два сегмента с одним значением сервер не различит: какой ни выбери, уйдёт одно и то же.
Процедура ПроверитьЗначения(Знач Сегменты_, Знач Имя)

	Встречены = Новый Соответствие();
	Для Каждого Сегмент Из Сегменты_ Цикл
		Если Встречены.Получить(Сегмент.Значение) <> Неопределено Тогда
			ВызватьИсключение СтрШаблон("Сегменты «%1»: значение «%2» у двух сегментов —"
				+ " сервер получит одно и то же, какой ни выбери. Дайте каждому сегменту"
				+ " своё значение.", Имя, Сегмент.Значение);
		КонецЕсли;
		Встречены.Вставить(Сегмент.Значение, Истина);
	КонецЦикла;

КонецПроцедуры

Функция Число_(Знач Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "НаборКомпонентов") _Набор) Экспорт

	Экран = _Экран;
	Набор = _Набор;

КонецПроцедуры
