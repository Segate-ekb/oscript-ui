// Элемент экрана — узел дерева разметки: у него есть родитель, дети и вид, и он кладётся
// ВНУТРЬ другого, а не приклеивается к нему плюсом. Желудём быть не может — у него есть
// состав, поэтому новый элемент выдаёт фабрика «Кит».
//
// Узел настраивается цепочкой слов: каждое слово возвращает тот же узел. У компонента
// (и у дома, секции, раздела настроек) слово пишет поле его модели; слово, которого этот
// носитель не знает, останавливает сборку с перечнем его слов.

Перем Печать;       // РазметкаЭлементов — чем узел становится в HTML
Перем РодУзла;      // Строка — что это за узел
Перем Поля;         // Структура — свойства узла (Вид, Текст, Адрес, Подпись, Роль…)
Перем ПризнакиУзла; // Соответствие — data-признаки для скриптов
Перем ДетиУзла;     // Массив из ЭлементЭкрана
Перем РодительУзла; // ЭлементЭкрана, Неопределено
Перем ОпораУзла;    // ЭлементЭкрана, Неопределено — у кого спросить адрес и токен, когда родителя нет
Перем ВторойУзла;   // ЭлементЭкрана, Неопределено — второй холст узла
Перем ИмяВторого;   // Строка — как этот второй холст называется
Перем Вложение;     // Булево — принимает ли узел вложенные; спрошено один раз, на рождении

#Область Состав

// Кладёт элемент внутрь этого. Порядок детей и есть порядок на экране. Строка на месте
// элемента — это текст: она становится узлом Кит.Текст и экранируется. Сырую разметку
// кладут только узлом Кит.Готовое().
//
// Параметры:
//  Ребёнок - ЭлементЭкрана, Строка - что положить.
//
// Возвращаемое значение:
//  ЭлементЭкрана - положенный элемент, чтобы наполнять его дальше; для строки — её текстовый узел.
//
Функция Добавить(Знач Ребёнок) Экспорт

	ПроверитьХолст();

	// тип сверяется с типом образца, а не поиском по имени: Тип("…") разрешает строку
	// на каждом вызове, а Добавить зовётся на каждый узел каждой страницы
	Если ТипЗнч(Ребёнок) = ТипЗнч("") Тогда
		Ребёнок = ТекстИзСтроки(Ребёнок);
	КонецЕсли;

	ПроверитьРебёнка(Ребёнок);

	ДетиУзла.Добавить(Ребёнок);
	Ребёнок.ПринятьРодителя(ЭтотОбъект);
	Возврат Ребёнок;

КонецФункции

// Кладёт внутрь до восьми элементов разом, по порядку. Неопределено пропускается: так
// условный ребёнок пишется прямо в списке, а девятый и дальше кладутся Добавить().
//
// Параметры:
//  Р1 - ЭлементЭкрана, Строка, Неопределено - (необязательный) первый ребёнок; строка — текст.
//  Р2 - ЭлементЭкрана, Строка, Неопределено - (необязательный) второй, и так до Р8.
//  Р3 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р4 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р5 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р6 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р7 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р8 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Наполнить(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Для Каждого Ребёнок Из СписокДетей(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8) Цикл
		Добавить(Ребёнок);
	КонецЦикла;
	Возврат ЭтотОбъект;

КонецФункции

// Шапка раскрывашки — отдельный холст, который печатается свёрнутой строкой.
// С аргументами наполняет шапку и возвращает саму раскрывашку.
//
// Параметры:
//  Р1 - ЭлементЭкрана, Строка, Неопределено - (необязательный) содержимое шапки, до Р8.
//  Р2 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р3 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р4 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р5 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р6 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р7 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р8 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//
// Возвращаемое значение:
//  ЭлементЭкрана - без аргументов холст шапки; с аргументами — эта раскрывашка.
//
Функция Шапка(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат НаполнитьВторой("шапка", СписокДетей(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8));

КонецФункции

// Разворот. У записи таблицы — отдельный холст, который печатается строкой под записью
// во всю ширину таблицы (пустой разворот не печатается вовсе); с аргументами наполняет его
// и возвращает саму запись. У таблицы из данных — имя колонки, чьё значение печатается
// разворотом под записью, а не ячейкой.
//
// Параметры:
//  Р1 - ЭлементЭкрана, Строка, Неопределено - (необязательный) у записи — содержимое
//       разворота (до Р8); у таблицы из данных — имя колонки разворота.
//  Р2 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р3 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р4 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р5 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р6 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р7 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р8 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//
// Возвращаемое значение:
//  ЭлементЭкрана - у записи без аргументов холст разворота, иначе этот же элемент.
//
Функция Разворот(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Если РодУзла = "таблица" Тогда
		ПроверитьДанныеТаблицы("Разворот");
		Поля.Вставить("Разворот", СокрЛП(Строка(?(Р1 = Неопределено, "", Р1))));
		Возврат ЭтотОбъект;
	КонецЕсли;

	Возврат НаполнитьВторой("разворот", СписокДетей(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8));

КонецФункции

// Холст, который таблица печатает ВМЕСТО себя, когда записей в ней нет. Строка одна —
// примечание вида «пусто»; узлы наполняют холст как есть. У реестра строка одна —
// пояснение его пустого состояния.
//
// Параметры:
//  Р1 - ЭлементЭкрана, Строка, Неопределено - (необязательный) текст или узлы пустой
//       выдачи, до Р8.
//  Р2 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р3 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р4 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р5 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р6 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р7 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р8 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//
// Возвращаемое значение:
//  ЭлементЭкрана - без аргументов холст пустой выдачи; с аргументами — эта таблица (реестр).
//
Функция Пусто(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Дети_ = СписокДетей(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

	// --- реестр (шаг 11): строка у реестра — пояснение его пустого состояния
	Если РодУзла = "реестр" И Дети_.Количество() = 1 И ТипЗнч(Дети_[0]) = ТипЗнч("") Тогда
		Поля.Модель.Вставить("Пояснение", Дети_[0]);
		Возврат ЭтотОбъект;
	КонецЕсли;

	Если Дети_.Количество() = 1 И ТипЗнч(Дети_[0]) = ТипЗнч("") Тогда
		Примечание = Новый ЭлементЭкрана(Печать, "примечание", "пусто");
		Примечание.Добавить(Дети_[0]);
		Дети_[0] = Примечание;
	КонецЕсли;

	Возврат НаполнитьВторой("пусто", Дети_);

КонецФункции

// Действия — второй холст: кнопки и формы. У карточки они печатаются под её телом,
// у секции настроек — справа от заголовка и лида (на узком экране — под лидом).
//
// Параметры:
//  Р1 - ЭлементЭкрана, Строка, Неопределено - (необязательный) действия, до Р8.
//  Р2 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р3 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р4 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р5 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р6 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р7 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//  Р8 - ЭлементЭкрана, Строка, Неопределено - (необязательный)
//
// Возвращаемое значение:
//  ЭлементЭкрана - без аргументов холст действий; с аргументами — эта карточка или секция.
//
Функция Действия(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат НаполнитьВторой("действия", СписокДетей(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8));

КонецФункции

// Колонка таблицы из данных. У таблицы значений колонка уже есть — слово находит её и даёт
// переопределить заголовок; у массива колонки объявляются этим словом в порядке вызовов.
//
// Параметры:
//  Ключ      - Строка - имя колонки таблицы значений либо ключ структуры записи.
//  Заголовок - Строка - (необязательный) заголовок столбца; у таблицы значений по умолчанию
//              её заголовок колонки, у массива — пусто.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел колонки: слова Вид(«узкая»), БезПодписиВЗаписи, Когда.
//
Функция Колонка(Знач Ключ, Знач Заголовок = Неопределено) Экспорт

	ПроверитьДанныеТаблицы("Колонка");
	Имя = СокрЛП(Строка(?(Ключ = Неопределено, "", Ключ)));
	ПоУмолчанию = Печать.ЗаголовокКолонкиДанных(ЭтотОбъект, Имя);

	Найденная = Неопределено;
	Для Каждого Ребёнок Из ДетиУзла Цикл
		Если Ребёнок.Род() = "колонка" И Ребёнок.Свойства().Ключ = Имя Тогда
			Найденная = Ребёнок;
		КонецЕсли;
	КонецЦикла;

	Если Найденная = Неопределено Тогда
		Найденная = Добавить(Новый ЭлементЭкрана(Печать, "колонка", "",
			Новый Структура("Ключ, Заголовок", Имя, ПоУмолчанию)));
	КонецЕсли;

	Если Заголовок <> Неопределено Тогда
		Найденная.Свойства().Вставить("Заголовок", Строка(Заголовок));
	КонецЕсли;

	Возврат Найденная;

КонецФункции

// Раздел дома настроек: строка в колонке разделов. Адрес раздела — адрес дома, косая черта
// и ключ; ключ с ведущей косой берётся адресом как есть, пустой — адрес самого дома.
// Раздел попадает под рубрику, объявленную словом Рубрика дома до него.
//
// Параметры:
//  Подпись - Строка - название раздела.
//  Ключ    - Строка - хвост адреса раздела.
//  Иконка  - Строка - (необязательный) имя иконки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - узел раздела: слова Текущий(), Опасный(), Счётчик(Число, Подпись).
//
Функция Раздел(Знач Подпись, Знач Ключ, Знач Иконка = "") Экспорт

	ПроверитьСлово("Раздел");
	Рубрика_ = "";
	Поля.Свойство("Рубрика", Рубрика_);
	Возврат Добавить(Новый ЭлементЭкрана(Печать, "раздел", "", Новый Структура("Модель",
		Новый Структура("Подпись, Ключ, Иконка, Активен, Рубрика, Опасный",
			Строка(?(Подпись = Неопределено, "", Подпись)),
			СокрЛП(Строка(?(Ключ = Неопределено, "", Ключ))),
			Строка(?(Иконка = Неопределено, "", Иконка)), Ложь,
			Строка(?(Рубрика_ = Неопределено, "", Рубрика_)), Ложь))));

КонецФункции

// Рубрика дома: все разделы, объявленные словом Раздел после неё, — до следующей
// рубрики — встают под эту подпись в колонке разделов и в группе разделов единого меню.
// Пустая подпись заканчивает рубрику: следующие разделы идут без неё.
//
// Параметры:
//  Подпись_ - Строка - подпись рубрики.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же дом.
//
Функция Рубрика(Знач Подпись_) Экспорт

	ПроверитьСлово("Рубрика");
	Поля.Вставить("Рубрика", СокрЛП(Строка(?(Подпись_ = Неопределено, "", Подпись_))));
	Возврат ЭтотОбъект;

КонецФункции

// Элемент, внутри которого лежит этот.
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - родитель; Неопределено у корня.
//
Функция Родитель() Экспорт
	Возврат РодительУзла;
КонецФункции

// Дети элемента в порядке добавления.
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана - копия состава: менять состав можно только через Добавить.
//
Функция Дети() Экспорт

	Результат = Новый Массив();
	Для Каждого Ребёнок Из ДетиУзла Цикл
		Результат.Добавить(Ребёнок);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Род узла: документ, голова, титул, мета, ресурс, стиль, скрипт, тело, шапка, основное,
// подвал, навигация, холст, область, ряд, раскрывашка, статья, список, пункт, свойства,
// свойство, группа, форма, таблица, колонка, запись, ячейка, заголовок, надпись,
// примечание, ссылка, текст, код, шаблон, картинка, компонент, готовое, дом, раздел, секция.
//
// Возвращаемое значение:
//  Строка
//
Функция Род() Экспорт
	Возврат РодУзла;
КонецФункции

// Может ли элемент быть холстом — принимать вложенные.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоХолст() Экспорт
	Возврат Вложение;
КонецФункции

#КонецОбласти

#Область Свойства

// Подпись элемента: доступное имя ряда, легенда группы, заголовок таблицы, имя реестра.
// У компонента, в модели которого есть поле Подпись, пишет его (у сводки и записи
// реестра — добавляет часть подписи).
//
// Параметры:
//  Текст - Строка - подпись (экранируется при печати).
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Подпись(Знач Текст) Экспорт

	Значение = Строка(?(Текст = Неопределено, "", Текст));
	Если НЕ Знает("Подпись") Тогда
		Поля.Вставить("Подпись", Значение);
		Возврат ЭтотОбъект;
	КонецЕсли;

	// --- реестр (шаг 11): подпись записи реестра — подпись её сводки
	Если Носитель() <> "сводка" И Носитель() <> "запись-реестра" Тогда
		Возврат Записать("Подпись", "Подпись", Значение);
	КонецЕсли;

	// повторная подпись сводки — ещё одна часть через « · », а не замена первой
	Было = Неопределено;
	Если НЕ Поля.Модель.Свойство("Подпись", Было) ИЛИ НЕ ЗначениеЗаполнено(Было) Тогда
		Возврат Записать("Подпись", "Подпись", Значение);
	КонецЕсли;

	Части = Новый Массив();
	Если ТипЗнч(Было) = Тип("Массив") Тогда
		Для Каждого Часть Из Было Цикл
			Части.Добавить(Часть);
		КонецЦикла;
	Иначе
		Части.Добавить(Было);
	КонецЕсли;
	Части.Добавить(Значение);
	Возврат Записать("Подпись", "Подпись", Части);

КонецФункции

// Вид узла — значение из закрытого набора его рода; проверяется так же, как при рождении.
// У компонента пишет поле Вид его модели.
//
// Параметры:
//  Значение - Строка - вид.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Вид(Знач Значение) Экспорт

	Текст = НРег(СокрЛП(Строка(?(Значение = Неопределено, "", Значение))));
	Если ЕстьМодель() ИЛИ РодУзла = "компонент" Тогда
		Возврат Записать("Вид", "Вид", Текст);
	КонецЕсли;

	Печать.ПроверитьВид(РодУзла, Текст);
	Поля.Вставить("Вид", Текст);
	Возврат ЭтотОбъект;

КонецФункции

// Печатает узел только при условии. Ложь печатает пустую строку, но узел остаётся
// в дереве (Дерево() показывает его пометкой [скрыт]); у колонки таблицы ложь снимает
// и заголовок, и ячейки под ним. Условие вычисляется всегда: там, где вычислять дорого,
// пишите Если и Кит.Ничего().
//
// Параметры:
//  Условие - Булево - печатать ли узел.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Когда(Знач Условие) Экспорт

	Если ТипЗнч(Условие) <> Тип("Булево") Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: условие Когда() у узла «%1» — «%2»,"
			+ " а не Булево. Передайте сравнение или ЗначениеЗаполнено(…): «почти истина»"
			+ " печатала бы узел там, где его не ждут.", РодУзла, Условие);
	КонецЕсли;

	Поля.Вставить("Показан", Условие);
	Возврат ЭтотОбъект;

КонецФункции

// CSRF-токен сессии для форм внутри узла: форма ищет его у себя и дальше вверх по предкам,
// поэтому на экране он задаётся один раз — у дома настроек или у корня экрана.
//
// Параметры:
//  Значение - Строка - токен.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Токен(Знач Значение) Экспорт

	Если НЕ Вложение Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: токен задаётся контейнеру — форме, дому,"
			+ " секции или холсту вокруг них, а этот узел — «%1» и детей не принимает.",
			Носитель());
	КонецЕсли;

	Поля.Вставить("Токен", Строка(?(Значение = Неопределено, "", Значение)));
	Возврат ЭтотОбъект;

КонецФункции

// Задаёт роль элемента для скринридера.
//
// Параметры:
//  Значение - Строка - роль ARIA («группа»).
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Роль(Знач Значение) Экспорт
	Поля.Вставить("Роль", Печать.РольARIA(Значение));
	Возврат ЭтотОбъект;
КонецФункции

// Вешает на элемент data-признак — то, за что его берёт скрипт страницы.
//
// Параметры:
//  Имя      - Строка - имя признака БЕЗ префикса data-, латиницей: буква, затем буквы,
//             цифры и дефисы («step», «row-id»). Другое имя браузер принял бы не везде,
//             поэтому оно останавливает сборку исключением, а не пропадает молча.
//  Значение - Строка - значение признака.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Признак(Знач Имя, Знач Значение) Экспорт

	ПроверитьИмяПризнака(СокрЛП(Строка(Имя)));

	Если ПризнакиУзла = Неопределено Тогда
		ПризнакиУзла = Новый Соответствие();
	КонецЕсли;

	ПризнакиУзла.Вставить(СокрЛП(Строка(Имя)), Строка(?(Значение = Неопределено, "", Значение)));
	Возврат ЭтотОбъект;

КонецФункции

// Форма уходит без перезагрузки страницы: скрипт кита отправляет её запросом в фоне
// и кладёт ответ сервера на страницу на место — прокрутка, фокус и раскрытые раскрывашки
// остаются как были. Сервер отвечает тем же, что и браузеру (обычно перенаправлением
// обратно на страницу), а без скрипта форма отправляется обычной навигацией.
//
// Не для формы, которая отдаёт файл или уводит на чужой сайт (вход через провайдера):
// такому ответу место во вкладке, а не на текущей странице.
//
// Выпуск 0.13: у пагинации тихо уходят ссылки страниц, у строки поиска и формы отбора —
// GET-форма (и сама, по изменению поля, с задержкой), у таблицы — ссылки сортировки в
// заголовках колонок. Адрес вкладки меняется в её истории, и «Назад» возвращает прежнее.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция БезПерезагрузки() Экспорт
	// --- страницы и отбор без перезагрузки (выпуск 0.13): компонент печатает признак
	// сам — на своих ссылках и форме, — а таблица отдаёт его ссылкам сортировки
	Если Знает("БезПерезагрузки") Тогда
		Возврат Записать("БезПерезагрузки", "БезПерезагрузки", Истина);
	ИначеЕсли РодУзла = "таблица" ИЛИ РодУзла = "колонка" Тогда
		Поля.Вставить("БезПерезагрузки", Истина);
		Возврат ЭтотОбъект;
	КонецЕсли;
	Возврат Признак("quiet", "");
КонецФункции

Процедура ПроверитьИмяПризнака(Знач Имя)

	Латиница = "abcdefghijklmnopqrstuvwxyz";
	Годно = ЗначениеЗаполнено(Имя) И СтрНайти(Латиница, НРег(Лев(Имя, 1))) > 0;
	Для Позиция = 2 По СтрДлина(Имя) Цикл
		Символ = НРег(Сред(Имя, Позиция, 1));
		Если СтрНайти(Латиница + "0123456789-", Символ) = 0 Тогда
			Годно = Ложь;
		КонецЕсли;
	КонецЦикла;

	Если НЕ Годно Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: имя признака «%1» не годится для атрибута"
			+ " data-%1. Имя пишется латиницей: буква, затем буквы, цифры и дефисы, например"
			+ " «step» или «row-id».", Имя);
	КонецЕсли;

КонецПроцедуры

// Якорь — идентификатор узла на странице (атрибут id): на него ссылаются адрес с решёткой
// и кнопка, отправляющая форму снаружи неё (Кнопка с полем Форма). У карточки и секции
// пишет поле Якорь их модели.
//
// Параметры:
//  Значение - Строка - идентификатор, уникальный на странице.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Якорь(Знач Значение) Экспорт

	Текст = СокрЛП(Строка(?(Значение = Неопределено, "", Значение)));
	Если Знает("Якорь") Тогда
		Возврат Записать("Якорь", "Якорь", Текст);
	КонецЕсли;

	Поля.Вставить("Якорь", Текст);
	Возврат ЭтотОбъект;

КонецФункции

// Подсказка, которую браузер показывает при наведении. У компонента пишет поле Подсказка
// его модели.
//
// Параметры:
//  Текст - Строка - текст подсказки (экранируется при печати).
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Подсказка(Знач Текст) Экспорт

	Значение = Строка(?(Текст = Неопределено, "", Текст));
	Если Знает("Подсказка") Тогда
		Возврат Записать("Подсказка", "Подсказка", Значение);
	КонецЕсли;

	Поля.Вставить("Подсказка", Значение);
	Возврат ЭтотОбъект;

КонецФункции

// Задаёт высоту картинки в пикселях: место под неё занято до того, как приедет лист
// стилей, и страница не прыгает.
//
// Параметры:
//  Пикселей - Число - высота.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Высота(Знач Пикселей) Экспорт

	Если РодУзла <> "картинка" Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: высота бывает только у картинки,"
			+ " а этот узел — «%1». На чужом теге атрибут height недопустим, и браузер"
			+ " его просто выбросит.", РодУзла);
	КонецЕсли;

	Поля.Вставить("Высота", Пикселей);
	Возврат ЭтотОбъект;

КонецФункции

// Задаёт ширину картинки в пикселях. Ставится только там, где пропорции известны
// заранее: у картинки произвольных пропорций ширину считает браузер, а заданная
// впрессовала бы её в чужую рамку.
//
// Параметры:
//  Пикселей - Число - ширина.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Ширина(Знач Пикселей) Экспорт

	Если РодУзла <> "картинка" Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: ширина бывает только у картинки,"
			+ " а этот узел — «%1». На чужом теге атрибут width недопустим, и браузер"
			+ " его просто выбросит.", РодУзла);
	КонецЕсли;

	Поля.Вставить("Ширина", Пикселей);
	Возврат ЭтотОбъект;

КонецФункции

// Объявляет, что форма несёт файлы: без этого браузер отправляет вместо файла его имя.
// У секции настроек — то же для её формы.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция СФайлами() Экспорт

	Если РодУзла = "секция" Тогда
		Возврат Записать("СФайлами", "СФайлами", Истина);
	КонецЕсли;

	Если НЕ Печать.ЭтоФорма(РодУзла) Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: файлы несёт только форма, а этот"
			+ " узел — «%1». Способ отправки объявляет тот, кто отправляет.", РодУзла);
	КонецЕсли;

	Поля.Вставить("Файлы", Истина);
	Возврат ЭтотОбъект;

КонецФункции

// Снимает подпись колонки с её ячеек в записи таблицы карточками: значения этой колонки
// называют себя сами, и подпись над ними на узком экране была бы дублем.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция БезПодписиВЗаписи() Экспорт

	Если РодУзла <> "колонка" Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: подписью ячеек в записи-карточке"
			+ " распоряжается колонка, а этот узел — «%1».", РодУзла);
	КонецЕсли;

	Поля.Вставить("БезПодписиВЗаписи", Истина);
	Возврат ЭтотОбъект;

КонецФункции

// Печатает раскрывашку (и запись реестра) сразу развёрнутой: содержимое видно, пока его
// не свернули.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Открыть() Экспорт

	// --- реестр (шаг 11): запись реестра раскрывается своей моделью — тег у неё <li>
	Если РодУзла = "запись-реестра" Тогда
		Возврат Записать("Открыть", "Открыта", Истина);
	КонецЕсли;

	Если РодУзла <> "раскрывашка" Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: раскрытой бывает только раскрывашка,"
			+ " а этот узел — «%1». На чужом теге атрибут open недопустим, и браузер"
			+ " его просто выбросит.", РодУзла);
	КонецЕсли;

	Поля.Вставить("Открыта", Истина);
	Возврат ЭтотОбъект;

КонецФункции

// Отключает элемент: браузер не отправляет его поля, не пускает в них фокус и не держит
// на них обязательность.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Отключить() Экспорт
	Поля.Вставить("Отключён", Истина);
	Возврат ЭтотОбъект;
КонецФункции

// Прячет элемент со страницы, не снимая его с неё.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Скрыть() Экспорт
	Поля.Вставить("Скрыт", Истина);
	Возврат ЭтотОбъект;
КонецФункции

// Свойства узла — для печати. Вид, Подпись, Подсказка, Якорь, Роль, Высота, Ширина, Файлы,
// Отключён, Скрыт, Открыта, БезПодписиВЗаписи и Показан есть у каждого узла; остальные —
// Текст, Разметка, Адрес, Действие, Уровень, Образец, Слот, Модель, Рисователь, Токен,
// Данные, Ключ, Язык, Тема, Имя, Свойство, Содержание, Кодировка, Отношение, Тип, Размеры,
// Правила — только у своего рода.
//
// Возвращаемое значение:
//  Структура
//
Функция Свойства() Экспорт
	Возврат Поля;
КонецФункции

// Data-признаки узла.
//
// Возвращаемое значение:
//  Соответствие, Неопределено - имя признака -> значение; Неопределено — признаков нет.
//
Функция Признаки() Экспорт
	Возврат ПризнакиУзла;
КонецФункции

#КонецОбласти

#Область СловаКнопки

// Основная кнопка — главное действие экрана (вариант «основная»).
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Основная() Экспорт
	Возврат Записать("Основная", "Вариант", "основная");
КонецФункции

// Вторичная кнопка — действие рядом с главным (вариант «вторичная»).
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Вторичная() Экспорт
	Возврат Записать("Вторичная", "Вариант", "вторичная");
КонецФункции

// Опасная кнопка — необратимое действие (вариант «опасная»). У секции настроек — опасная
// секция: красная рамка и кнопка «удалить» на панели.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина) у секции — опасна ли она.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Опасная(Знач Флаг = Истина) Экспорт

	Если РодУзла = "секция" Тогда
		Возврат Записать("Опасная", "Опасная", Флаг = Истина);
	КонецЕсли;
	Возврат Записать("Опасная", "Вариант", "опасная");

КонецФункции

// Кнопка-ссылка: выглядит ссылкой, а остаётся кнопкой (вариант «ссылка»).
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Ссылкой() Экспорт
	Возврат Записать("Ссылкой", "Вариант", "ссылка");
КонецФункции

// Малая кнопка — для строки таблицы и плотного ряда.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Малая() Экспорт
	Возврат Записать("Малая", "Размер", "малый");
КонецФункции

// Большая кнопка — единственное действие пустого экрана.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Большая() Экспорт
	Возврат Записать("Большая", "Размер", "большой");
КонецФункции

// Обычная кнопка: форму не отправляет (type="button"). Слово стоит вместо поля Тип
// модели — имя «Тип» в OneScript занято системой типов.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Обычная() Экспорт
	Возврат Записать("Обычная", "Тип", "обычная");
КонецФункции

// Кнопка-значок: подпись уходит в aria-label вместо видимого текста.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ТолькоИконка(Знач Флаг = Истина) Экспорт
	Возврат Записать("ТолькоИконка", "ТолькоИконка", Флаг = Истина);
КонецФункции

// Кнопка отправляет форму, не спрашивая обязательные поля (formnovalidate).
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция БезВалидации(Знач Флаг = Истина) Экспорт
	Возврат Записать("БезВалидации", "БезВалидации", Флаг = Истина);
КонецФункции

// Кнопка шлёт свою форму на этот адрес вместо адреса формы (formaction).
//
// Параметры:
//  Адрес - Строка - относительный адрес своего приложения.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция АдресОтправки(Знач Адрес) Экспорт
	Возврат Записать("АдресОтправки", "АдресОтправки", Строка(?(Адрес = Неопределено, "", Адрес)));
КонецФункции

// Ответ на отправку открывается в новой вкладке (formtarget="_blank").
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ВНовойВкладке(Знач Флаг = Истина) Экспорт
	Возврат Записать("ВНовойВкладке", "ВНовойВкладке", Флаг = Истина);
КонецФункции

// Кнопка стоит вне своей формы и отправляет форму с этим якорем (атрибут form).
//
// Параметры:
//  Якорь_ - Строка - якорь формы.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ВФорме(Знач Якорь_) Экспорт
	Возврат Записать("ВФорме", "Форма", Строка(?(Якорь_ = Неопределено, "", Якорь_)));
КонецФункции

// Кнопка (у панели и секции — кнопка панели) заблокирована.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Заблокирована(Знач Флаг = Истина) Экспорт
	Возврат Записать("Заблокирована", "Заблокирована", Флаг = Истина);
КонецФункции

// Кнопка занята: действие идёт (disabled и aria-busy).
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Занята(Знач Флаг = Истина) Экспорт
	Возврат Записать("Занята", "Занята", Флаг = Истина);
КонецФункции

// Кнопка во всю ширину своего контейнера.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ВоВсюШирину(Знач Флаг = Истина) Экспорт
	Возврат Записать("ВоВсюШирину", "ВоВсюШирину", Флаг = Истина);
КонецФункции

// Ссылка-кнопка выбрана в своей группе (aria-current).
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Текущая(Знач Флаг = Истина) Экспорт
	Возврат Записать("Текущая", "Текущая", Флаг = Истина);
КонецФункции

// У кнопки — команда движка браузера и её цель («показать-окно» | «закрыть»). У шапки
// объекта — главная команда, блок копируемой строки.
//
// Параметры:
//  Значение - Строка - команда кнопки либо текст команды шапки.
//  Цель     - Строка - (необязательный) идентификатор управляемого элемента — у кнопки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Команда(Знач Значение, Знач Цель = Неопределено) Экспорт

	Записать("Команда", "Команда", ?(Значение = Неопределено, "", Значение));
	Если Цель <> Неопределено Тогда
		Поля.Модель.Вставить("Цель", Строка(Цель));
	КонецЕсли;
	Возврат ЭтотОбъект;

КонецФункции

// Кнопка открывает окно (Кит.Окно, Кит.Подтверждение) — команда движка show-modal
// и commandfor — либо всплывающую панель (popovertarget). Узел окна даёт свой
// идентификатор; строка — идентификатор окна этой же страницы, а не нашлось такого
// окна в дереве — всплывающей панели.
//
// Параметры:
//  Ид_ - ЭлементЭкрана, Строка - узел окна либо идентификатор окна или панели.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Открывает(Знач Ид_) Экспорт

	Если ТипЗнч(Ид_) = ТипЗнч(ЭтотОбъект) Тогда
		ПроверитьСлово("Открывает");
		Если НЕ Печать.ЭтоОкно(Ид_.Род()) Тогда
			ВызватьИсключение СтрШаблон("Элемент экрана: кнопка открывает окно — узел"
				+ " Кит.Окно или Кит.Подтверждение, а пришёл «%1». Всплывающую панель"
				+ " называют идентификатором строкой.", Ид_.Род());
		КонецЕсли;
		Поля.Вставить("ОткрываетОкно", Ид_);
		Возврат ЭтотОбъект;
	КонецЕсли;

	Возврат Записать("Открывает", "Открывает", Строка(?(Ид_ = Неопределено, "", Ид_)));

КонецФункции

// Число на кнопке, меню или вкладке. Ноль и пусто не печатаются.
//
// Параметры:
//  Значение       - Число, Строка - число.
//  ПодписьЧисла   - Строка - (необязательный) чем число называется в речи; у кнопки
//                   и меню обязательна, когда бейдж печатается.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Счётчик(Знач Значение, Знач ПодписьЧисла = Неопределено) Экспорт

	Записать("Счётчик", "Счётчик", Значение);
	Если ПодписьЧисла <> Неопределено Тогда
		Поля.Модель.Вставить("ПодписьСчётчика", Строка(ПодписьЧисла));
	КонецЕсли;
	Возврат ЭтотОбъект;

КонецФункции

// Кнопка показывает шеврон: она открывает панель, а не выполняет действие.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ЗнакРаскрытия(Знач Флаг = Истина) Экспорт
	Возврат Записать("ЗнакРаскрытия", "ЗнакРаскрытия", Флаг = Истина);
КонецФункции

// Картинка вместо иконки набора — адрес изображения.
//
// Параметры:
//  Адрес_ - Строка - адрес изображения.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Картинка(Знач Адрес_) Экспорт
	Возврат Записать("Картинка", "Картинка", Строка(?(Адрес_ = Неопределено, "", Адрес_)));
КонецФункции

#КонецОбласти

#Область СловаКомпонентов

// Иконка компонента — имя глифа из набора иконок.
//
// Параметры:
//  Имя_ - Строка - имя иконки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Иконка(Знач Имя_) Экспорт
	Возврат Записать("Иконка", "Иконка", Строка(?(Имя_ = Неопределено, "", Имя_)));
КонецФункции

// Адрес компонента: кнопка и плашка становятся ссылкой, карточка — ссылкой-заголовком,
// плитка — ссылкой целиком.
//
// Параметры:
//  Значение - Строка - URL.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Адрес(Знач Значение) Экспорт
	Возврат Записать("Адрес", "Адрес", Строка(?(Значение = Неопределено, "", Значение)));
КонецФункции

// Имя компонента: у кнопки и панели — name (и value) кнопки, у строки поиска — имя
// GET-параметра поля.
//
// Параметры:
//  Значение_ - Строка - имя.
//  Значение2 - Строка - (необязательный) значение кнопки (value).
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Имя(Знач Значение_, Знач Значение2 = Неопределено) Экспорт

	Записать("Имя", "Имя", Строка(?(Значение_ = Неопределено, "", Значение_)));
	Если Значение2 <> Неопределено Тогда
		Поля.Модель.Вставить("Значение", Строка(Значение2));
	КонецЕсли;
	Возврат ЭтотОбъект;

КонецФункции

// Значение компонента. У поля — его значение, из которого выводится тип ввода, если тип
// не задан словом ТипЗначения: число печатается числовым полем, Булево — флажком
// (и отмечает его), дата — полем даты в формате ввода.
//
// Параметры:
//  Значение_ - Произвольный - значение.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Значение(Знач Значение_) Экспорт

	Если Носитель() <> "поле" Тогда
		Возврат Записать("Значение", "Значение", Значение_);
	КонецЕсли;

	ПроверитьСлово("Значение");
	Если НЕ (Поля.Свойство("ТипЗадан") И Поля.ТипЗадан = Истина) Тогда
		Выведенный = Печать.ТипыЗначений().ИзЗначения(Значение_);
		Если ЗначениеЗаполнено(Выведенный) Тогда
			Поля.Модель.Вставить("Тип", Выведенный);
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(Значение_) = Тип("Булево") Тогда
		Поля.Модель.Вставить("Отмечено", Значение_);
		Поля.Вставить("ЗначениеПоля", Неопределено);
	Иначе
		Поля.Вставить("ЗначениеПоля", Значение_);
	КонецЕсли;
	Возврат ЭтотОбъект;

КонецФункции

// Тип значения поля — системой типов OneScript: Тип("Число") печатается полем type=number,
// Тип("Булево") — флажком, Тип("Дата") — type=date, Тип("Строка") — текстом. ОписаниеТипов
// с квалификаторами даёт пределы: КвалификаторыЧисла — step и max, КвалификаторыСтроки —
// maxlength, КвалификаторыДаты — date, datetime-local или time. Строка («email», «url»,
// «пароль», «файл», «многострочное», «выбор», «флажок», «число», «текст») — прежний Тип
// модели. Явный тип старше выведенного из Значения. Слово называется ТипЗначения, потому
// что имя «Тип» в OneScript занято самой системой типов.
//
// Параметры:
//  Значение_ - Тип, ОписаниеТипов, Строка - тип значения.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ТипЗначения(Знач Значение_) Экспорт

	ПроверитьСлово("ТипЗначения");
	Разбор = Печать.ТипыЗначений().Разобрать(Значение_);
	Поля.Модель.Вставить("Тип", Разбор.Тип);
	Для Каждого Имя_ Из СтрРазделить("Шаг,Максимум,ДлинаМакс", ",") Цикл
		// проверка до отправки (выпуск 0.12): явные Пределы старше максимума типа
		Если Имя_ = "Максимум" И Поля.Свойство("ПределыЗаданы") Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Разбор[Имя_]) Тогда
			Поля.Модель.Вставить(Имя_, Разбор[Имя_]);
		Иначе
			Поля.Модель.Удалить(Имя_);
		КонецЕсли;
	КонецЦикла;
	Поля.Вставить("ТипЗадан", Истина);
	Возврат ЭтотОбъект;

КонецФункции

// Пример значения — серый текст в пустом поле (плейсхолдер).
//
// Параметры:
//  Текст - Строка - пример.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Пример(Знач Текст) Экспорт
	Возврат Записать("Пример", "Плейсхолдер", Строка(?(Текст = Неопределено, "", Текст)));
КонецФункции

// Подсказка менеджеру паролей и автозаполнению браузера (autocomplete).
//
// Параметры:
//  Значение_ - Строка - значение атрибута.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Автозаполнение(Знач Значение_) Экспорт
	Возврат Записать("Автозаполнение", "Автозаполнение", Строка(?(Значение_ = Неопределено, "", Значение_)));
КонецФункции

// Текст отказа под полем: поле помечается отбитым. У подтверждения — отказ под его
// эхо-полем (сервер вернул окно, потому что набранное не совпало с образцом).
//
// Параметры:
//  Текст - Строка - текст отказа.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Ошибка(Знач Текст) Экспорт

	Если РодУзла = "подтверждение" Тогда
		Поля.Вставить("ОшибкаЭха", Строка(?(Текст = Неопределено, "", Текст)));
		Возврат ЭтотОбъект;
	КонецЕсли;

	Возврат Записать("Ошибка", "Ошибка", Строка(?(Текст = Неопределено, "", Текст)));

КонецФункции

// Поле обязательно (required).
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Обязательное(Знач Флаг = Истина) Экспорт
	Возврат Записать("Обязательное", "Обязательное", Флаг = Истина);
КонецФункции

// Поле только на чтение (readonly).
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ТолькоЧтение(Знач Флаг = Истина) Экспорт
	Возврат Записать("ТолькоЧтение", "ТолькоЧтение", Флаг = Истина);
КонецФункции

// Поле или тумблер заблокированы: только показ, не отправляются.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Заблокировано(Знач Флаг = Истина) Экспорт
	Возврат Записать("Заблокировано", "Заблокировано", Флаг = Истина);
КонецФункции

// Флажок отмечен.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Отмечено(Знач Флаг = Истина) Экспорт
	Возврат Записать("Отмечено", "Отмечено", Флаг = Истина);
КонецФункции

// Вариант выбора. Первый вариант делает поле выбором.
//
// Параметры:
//  Значение_ - Строка - что вариант отправляет.
//  Подпись_  - Строка - (необязательный) что вариант показывает; по умолчанию значение.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Вариант(Знач Значение_, Знач Подпись_ = Неопределено) Экспорт

	ПроверитьСлово("Вариант");
	Вариант_ = Новый Структура("Значение", Строка(?(Значение_ = Неопределено, "", Значение_)));
	Если Подпись_ <> Неопределено Тогда
		Вариант_.Вставить("Подпись", Строка(Подпись_));
	КонецЕсли;
	Дописать("Вариант", "Варианты", Вариант_);
	Поля.Модель.Вставить("Тип", "выбор");
	Поля.Вставить("ТипЗадан", Истина);
	Возврат ЭтотОбъект;

КонецФункции

// Идентификатор управления поля: печатаются id, <label for> и aria-describedby отказа.
//
// Параметры:
//  Значение_ - Строка - идентификатор.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Ид(Знач Значение_) Экспорт
	Возврат Записать("Ид", "Ид", Строка(?(Значение_ = Неопределено, "", Значение_)));
КонецФункции

// Многострочное поле (textarea).
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Многострочное() Экспорт
	Поля.Вставить("ТипЗадан", Истина);
	Возврат Записать("Многострочное", "Тип", "многострочное");
КонецФункции

// Поле секрета у поля холста: пароль, набранное не видно (type=password). У поля
// из конфига — значение не показывается вовсе. У свойства (выпуск 0.13) — значение под
// точками и кнопка «Показать» рядом; показывает его лист, без скрипта.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина) у поля из конфига и у свойства.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Секрет(Знач Флаг = Истина) Экспорт

	// --- таблица карточками и свойства (выпуск 0.13): у свойства значение под точками
	Если РодУзла = "свойство" Тогда
		Поля.Вставить("Секрет", Флаг = Истина);
		Возврат ЭтотОбъект;
	КонецЕсли;

	Если Носитель() = "поле-конфига" Тогда
		Возврат Записать("Секрет", "Секрет", Флаг = Истина);
	КонецЕсли;
	Поля.Вставить("ТипЗадан", Истина);
	Возврат Записать("Секрет", "Тип", "пароль");

КонецФункции

// Поле файла (type=file). Форме вокруг нужно слово СФайлами().
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Файл() Экспорт
	Поля.Вставить("ТипЗадан", Истина);
	Возврат Записать("Файл", "Тип", "файл");
КонецФункции

// --- поля список и цвет (выпуск 0.12) ---

// Поле-список: значения плашками с крестиком и строка ввода в одной рамке; Enter или
// запятая добавляет плашку. Серверу уходит одна строка через запятую под именем поля;
// без скрипта это обычное текстовое поле с той же строкой. Значение — строкой через
// запятую или массивом строк.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Список() Экспорт
	Поля.Вставить("ТипЗадан", Истина);
	Возврат Записать("Список", "Тип", "список");
КонецФункции

// Поле цвета: образцы кружками-радиокнопками (слово Образец), «свой» — системный выбор
// цвета, рядом имя и код выбранного. Значение — код #rrggbb, формат проверяет pattern;
// пустое значит «по умолчанию».
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Цвет() Экспорт
	Поля.Вставить("ТипЗадан", Истина);
	Возврат Записать("Цвет", "Тип", "цвет");
КонецФункции

// Образец поля цвета — кружок в ряду. Первый образец делает поле цветом.
//
// Параметры:
//  Цвет_ - Строка - код цвета вида #rrggbb.
//  Имя_  - Строка - (необязательный) имя цвета для человека; по умолчанию код.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Образец(Знач Цвет_, Знач Имя_ = Неопределено) Экспорт

	ПроверитьСлово("Образец");
	Образец_ = Новый Структура("Цвет", Строка(?(Цвет_ = Неопределено, "", Цвет_)));
	Если Имя_ <> Неопределено Тогда
		Образец_.Вставить("Имя", Строка(Имя_));
	КонецЕсли;
	Дописать("Образец", "Образцы", Образец_);
	Поля.Модель.Вставить("Тип", "цвет");
	Поля.Вставить("ТипЗадан", Истина);
	Возврат ЭтотОбъект;

КонецФункции

// --- проверка до отправки и тост (выпуск 0.12) ---

// Пределы значения поля: атрибуты min и max. Число печатается с точкой, дата — в формате
// ввода (ГГГГ-ММ-ДД). Явные пределы старше тех, что дал тип словом ТипЗначения.
//
// Параметры:
//  Мин  - Число, Дата, Неопределено - нижний предел; Неопределено — без него.
//  Макс - Число, Дата, Неопределено - (необязательный) верхний предел.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Пределы(Знач Мин, Знач Макс = Неопределено) Экспорт

	ПроверитьСлово("Пределы");
	Тип_ = "";
	Поля.Модель.Свойство("Тип", Тип_);
	Типы_ = Печать.ТипыЗначений();
	Поля.Модель.Вставить("Минимум", Типы_.ТекстВвода(Мин, Строка(Тип_)));
	Поля.Модель.Вставить("Максимум", Типы_.ТекстВвода(Макс, Строка(Тип_)));
	Поля.Вставить("ПределыЗаданы", Истина);
	Возврат ЭтотОбъект;

КонецФункции

// Пределы длины строки: атрибуты minlength и maxlength. Включает проверку до отправки
// (см. ПроверкаДоОтправки).
//
// Параметры:
//  Мин  - Число, Неопределено - наименьшая длина; Неопределено или 0 — без нижнего предела.
//  Макс - Число, Неопределено - (необязательный) наибольшая длина; Неопределено или 0 — без верхнего.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Длина(Знач Мин, Знач Макс = Неопределено) Экспорт

	ПроверитьСлово("Длина");
	Поля.Модель.Вставить("ДлинаМин", ТекстДлины(Мин));
	Если ЗначениеЗаполнено(ТекстДлины(Макс)) Тогда
		Поля.Модель.Вставить("ДлинаМакс", ТекстДлины(Макс));
	КонецЕсли;
	Поля.Модель.Вставить("Проверка", Истина);
	Возврат ЭтотОбъект;

КонецФункции

// Шаблон значения — регулярное выражение, которому значение обязано совпасть целиком
// (атрибут pattern). Включает проверку до отправки.
//
// Параметры:
//  Образец - Строка - регулярное выражение без якорей ^ и $ по правилам атрибута pattern
//            (браузер читает его с флагом v: дефис внутри класса экранируется), например
//            "[a-z0-9\-]+".
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Шаблон(Знач Образец) Экспорт
	Записать("Шаблон", "Шаблон", Строка(?(Образец = Неопределено, "", Образец)));
	Поля.Модель.Вставить("Проверка", Истина);
	Возврат ЭтотОбъект;
КонецФункции

// Проверка значения сервером до отправки (признак data-check): скрипт кита, когда человек
// перестал набирать или ушёл из поля, спрашивает «Адрес?имя=значение»; 200 — свободно,
// 409 — занято, текст ответа печатается под полем. Без скрипта занятость проверяет
// обработчик формы. Включает проверку до отправки.
//
// Параметры:
//  Адрес_ - Строка - адрес проверки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ПроверкаНаСервере(Знач Адрес_) Экспорт
	Записать("ПроверкаНаСервере", "АдресПроверки", Строка(?(Адрес_ = Неопределено, "", Адрес_)));
	Поля.Модель.Вставить("Проверка", Истина);
	Возврат ЭтотОбъект;
КонецФункции

// Проверка до отправки: поле несёт тексты отказов словаря form.error.* для каждого своего
// ограничения (data-error-*), и скрипт кита пишет отказ под полем, когда браузер не пускает
// форму или человек уходит из поля. Слова Длина, Шаблон и ПроверкаНаСервере включают её
// сами; прежним ограничениям (Обязательное, Пределы, ТипЗначения("email" | "url")) она
// нужна словом — их поле печатается как раньше, пока его об этом не попросили.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ПроверкаДоОтправки() Экспорт
	Возврат Записать("ПроверкаДоОтправки", "Проверка", Истина);
КонецФункции

// Уведомление объявляется скринридеру сразу, прерывая чтение (role="alert"), каким бы ни
// был его вид. Скрипт кита такой тост из ответа тихой отправки сам не закрывает.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Тревога(Знач Флаг = Истина) Экспорт
	Возврат Записать("Тревога", "Тревога", Флаг = Истина);
КонецФункции

// Длина печатается целым числом; 0 и Неопределено значат «предела нет».
Функция ТекстДлины(Знач Значение)
	Если ТипЗнч(Значение) <> Тип("Число") ИЛИ Значение <= 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Формат(Значение, "ЧН=0; ЧГ=0; ЧДЦ=0");
КонецФункции

// Метка поля, тумблера, строки поиска, полосы заполнения — подпись для человека.
//
// Параметры:
//  Текст - Строка - метка.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Метка(Знач Текст) Экспорт
	Возврат Записать("Метка", "Метка", Строка(?(Текст = Неопределено, "", Текст)));
КонецФункции

// Тумблер включён.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Включено(Знач Флаг = Истина) Экспорт
	Возврат Записать("Включено", "Включено", Флаг = Истина);
КонецФункции

// Переключение тумблера (выбор сегмента) само отправляет его форму.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция СохранятьСразу(Знач Флаг = Истина) Экспорт
	// --- сегменты и подсказка (выпуск 0.12): у сегментов модели нет, флаг — их поле
	Если РодУзла = "сегменты" Тогда
		Поля.Вставить("СохранятьСразу", Флаг = Истина);
		Возврат ЭтотОбъект;
	КонецЕсли;
	Возврат Записать("СохранятьСразу", "СохранятьСразу", Флаг = Истина);
КонецФункции

// Что тумблер отправляет включённым и выключенным.
//
// Параметры:
//  Вкл  - Строка - значение включённого.
//  Выкл - Строка - значение выключенного.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Значения(Знач Вкл, Знач Выкл) Экспорт
	Записать("Значения", "ЗначениеВкл", Строка(Вкл));
	Поля.Модель.Вставить("ЗначениеВыкл", Строка(Выкл));
	Возврат ЭтотОбъект;
КонецФункции

// Что тумблер показывает включённым и выключенным.
//
// Параметры:
//  Вкл  - Строка - подпись включённого.
//  Выкл - Строка - подпись выключенного.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Подписи(Знач Вкл, Знач Выкл) Экспорт
	Записать("Подписи", "ПодписьВкл", Строка(Вкл));
	Поля.Модель.Вставить("ПодписьВыкл", Строка(Выкл));
	Возврат ЭтотОбъект;
КонецФункции

// Пояснение компонента: строка под заголовком, над блоком, слева от кнопок панели.
//
// Параметры:
//  Текст - Строка - пояснение.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Пояснение(Знач Текст) Экспорт
	Возврат Записать("Пояснение", "Пояснение", Строка(?(Текст = Неопределено, "", Текст)));
КонецФункции

// Описание карточки или шапки объекта.
//
// Параметры:
//  Текст - Строка - описание.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Описание(Знач Текст) Экспорт
	Возврат Записать("Описание", "Описание", Строка(?(Текст = Неопределено, "", Текст)));
КонецФункции

// Заголовок компонента: у пустого состояния и уведомления — видимый, у табов, сетки,
// пагинации и дерева разделов — доступное имя области.
//
// Параметры:
//  Текст - Строка - заголовок.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Заголовок(Знач Текст) Экспорт
	Возврат Записать("Заголовок", "Заголовок", Строка(?(Текст = Неопределено, "", Текст)));
КонецФункции

// Уровень заголовка карточки или заголовка страницы.
//
// Параметры:
//  Значение_ - Число - уровень.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Уровень(Знач Значение_) Экспорт
	Возврат Записать("Уровень", "Уровень", Значение_);
КонецФункции

// Опасная зона: поле подтверждения, значение которого сверяет сервер.
//
// Параметры:
//  Имя_       - Строка - имя поля.
//  Образец    - Строка - что человек обязан набрать.
//  Метка_     - Строка - (необязательный) подпись поля.
//  Подсказка_ - Строка - (необязательный) подсказка под полем.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Подтверждение(Знач Имя_, Знач Образец, Знач Метка_ = "", Знач Подсказка_ = "") Экспорт

	// пустая метка не пишется вовсе: иначе она перебила бы метку зоны по умолчанию,
	// и поле осталось бы без доступного имени
	Поле = Новый Структура("Имя, Образец", Имя_, Образец);
	Если ЗначениеЗаполнено(Метка_) Тогда
		Поле.Вставить("Метка", Метка_);
	КонецЕсли;
	Если ЗначениеЗаполнено(Подсказка_) Тогда
		Поле.Вставить("Подсказка", Подсказка_);
	КонецЕсли;
	Возврат Записать("Подтверждение", "Подтверждение", Поле);

КонецФункции

// Кнопка компонента. У опасной зоны — подпись (или узел кнопки) её кнопки действия;
// у строки поиска — подпись и иконка кнопки отправки; у секции — подпись кнопки панели;
// у шагов — подпись (или узел кнопки) кнопки отправки на последнем шаге.
// у подтверждения — подпись кнопки подтверждения.
//
// Параметры:
//  Значение_ - Строка, ЭлементЭкрана - подпись кнопки либо узел Кит.Кнопка.
//  Иконка_   - Строка - (необязательный) иконка кнопки — у строки поиска, секции и шагов.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Кнопка(Знач Значение_, Знач Иконка_ = Неопределено) Экспорт

	// --- шаги (выпуск 0.11, шаг 10): модели у узла шагов нет, кнопка — его поле ---
	Если РодУзла = "шаги" Тогда
		Возврат КнопкаШагов(Значение_, Иконка_);
	КонецЕсли;
	Если РодУзла = "подтверждение" Тогда
		Поля.Вставить("Кнопка", Строка(?(Значение_ = Неопределено, "", Значение_)));
		Возврат ЭтотОбъект;
	КонецЕсли;

	ПроверитьСлово("Кнопка");
	Носитель_ = Носитель();
	Если Носитель_ = "зона" Тогда
		Если ТипЗнч(Значение_) = ТипЗнч(ЭтотОбъект) Тогда
			Поля.Модель.Вставить("Кнопка", Печать.МодельКомпонента(Значение_));
		Иначе
			Поля.Модель.Вставить("Кнопка", Новый Структура("Подпись", Строка(Значение_)));
		КонецЕсли;
		Возврат ЭтотОбъект;
	КонецЕсли;

	Поля.Модель.Вставить("Кнопка", Строка(?(Значение_ = Неопределено, "", Значение_)));
	Если Иконка_ <> Неопределено Тогда
		Поля.Модель.Вставить(?(Носитель_ = "секция", "ИконкаКнопки", "Иконка"), Строка(Иконка_));
	КонецЕсли;
	Возврат ЭтотОбъект;

КонецФункции

// Знак: у шапки объекта — значок за именем (иконка и подпись), у сводки — плашка
// состояния у названия (узел плашки либо её текст).
//
// Параметры:
//  Первый - Строка, ЭлементЭкрана - у шапки — имя иконки; у сводки — плашка или текст.
//  Второй - Строка - (необязательный) у шапки — подпись значка.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Знак(Знач Первый, Знач Второй = Неопределено) Экспорт

	ПроверитьСлово("Знак");
	Если Носитель() = "шапка" Тогда
		Возврат Дописать("Знак", "Признаки", Новый Структура("Иконка, Подпись",
			Строка(Первый), Строка(?(Второй = Неопределено, "", Второй))));
	КонецЕсли;
	Возврат Дописать("Знак", "Знаки", МодельПлашки(Первый));

КонецФункции

// Пара ряда метаданных шапки объекта: значок и значение.
//
// Параметры:
//  Подпись_ - Строка - что за значение.
//  Значение_ - Строка - значение.
//  Значок   - Строка - (необязательный) имя иконки.
//  Адрес_   - Строка - (необязательный) значение становится ссылкой.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Мета(Знач Подпись_, Знач Значение_, Знач Значок = "", Знач Адрес_ = "") Экспорт
	Возврат Дописать("Мета", "Мета", Новый Структура("Подпись, Значение, Значок, Адрес",
		Подпись_, Значение_, Значок, Адрес_));
КонецФункции

// Плашка шапки объекта — узел Кит.Плашка либо её текст.
//
// Параметры:
//  Значение_ - ЭлементЭкрана, Строка - плашка.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Плашка(Знач Значение_) Экспорт
	Возврат Дописать("Плашка", "Плашки", МодельПлашки(Значение_));
КонецФункции

// Строка сводки «подпись — значение».
//
// Параметры:
//  Подпись_  - Строка - подпись строки.
//  Значение_ - Строка - значение; пустое не печатается.
//  Вид_      - Строка - (необязательный) "" | "warn".
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Сведение(Знач Подпись_, Знач Значение_, Знач Вид_ = "") Экспорт
	Возврат Дописать("Сведение", "Сведения", Новый Структура("Подпись, Значение, Вид",
		Подпись_, Значение_, Вид_));
КонецФункции

// Блок команды без кнопки копирования.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция БезКопирования(Знач Флаг = Истина) Экспорт
	Возврат Записать("БезКопирования", "БезКопирования", Флаг = Истина);
КонецФункции

// Пагинация списка, у которого число страниц неизвестно: есть ли следующая.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ЕстьСледующая(Знач Флаг = Истина) Экспорт
	Возврат Записать("ЕстьСледующая", "ЕстьСледующая", Флаг = Истина);
КонецФункции

// Имя параметра страницы в адресе пагинации («page»).
//
// Параметры:
//  Имя_ - Строка - имя параметра.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Параметр(Знач Имя_) Экспорт
	Возврат Записать("Параметр", "Параметр", Строка(Имя_));
КонецФункции

// Параметр адреса, который переживает переход пагинации; каждый вызов добавляет пару.
//
// Параметры:
//  Имя_      - Строка - имя параметра.
//  Значение_ - Строка - значение.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Параметры(Знач Имя_, Знач Значение_) Экспорт
	Возврат Дописать("Параметры", "Параметры", Новый Структура("Имя, Значение", Имя_, Значение_));
КонецФункции

// Подпись ссылки «назад» пагинации.
//
// Параметры:
//  Текст - Строка - подпись.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ПодписьНазад(Знач Текст) Экспорт
	Возврат Записать("ПодписьНазад", "ПодписьНазад", Строка(Текст));
КонецФункции

// Подпись ссылки «вперёд» пагинации.
//
// Параметры:
//  Текст - Строка - подпись.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ПодписьВперёд(Знач Текст) Экспорт
	Возврат Записать("ПодписьВперёд", "ПодписьВперёд", Строка(Текст));
КонецФункции

// Скрытое поле строки поиска: GET-параметр, который отправка обязана сохранить.
//
// Параметры:
//  Имя_      - Строка - имя параметра.
//  Значение_ - Строка - значение.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция СкрытоеПоле(Знач Имя_, Знач Значение_) Экспорт
	Возврат Дописать("СкрытоеПоле", "СкрытыеПоля", Новый Структура("Имя, Значение", Имя_, Значение_));
КонецФункции

// Поле строки поиска из нескольких полей — узел Кит.Поле; заданы поля — одиночное поле
// не печатается.
//
// Параметры:
//  Узел - ЭлементЭкрана - узел поля.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Поле(Знач Узел) Экспорт
	ПроверитьСлово("Поле");
	Возврат Дописать("Поле", "Поля", Печать.МодельКомпонента(Узел));
КонецФункции

// --- страницы и отбор без перезагрузки (выпуск 0.13) ---

// Сколько записей в списке пагинации. Вместе со словом НаСтранице печатает «41–60 из 137»
// и считает число страниц, если оно не задано позицией.
//
// Параметры:
//  Число_ - Число - число записей списка (после отбора).
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Всего(Знач Число_) Экспорт
	Возврат Записать("Всего", "Всего", Число_);
КонецФункции

// Сколько записей на одной странице пагинации — размер страницы.
//
// Параметры:
//  Число_ - Число - размер страницы.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция НаСтранице(Знач Число_) Экспорт
	Возврат Записать("НаСтранице", "НаСтранице", Число_);
КонецФункции

// Колонка сортирует список: заголовок становится ссылкой на адрес, а колонка, по которой
// список уже отсортирован, получает aria-sort. Адрес собирает вызывающий: только он знает,
// как его список называет порядок и что ещё в адресе сохранить. Обычно у отсортированной
// колонки ссылка ведёт на обратный порядок, у прочих — на прямой.
//
// Параметры:
//  Адрес_  - Строка - адрес списка, отсортированного по этой колонке.
//  Порядок - Строка - (необязательный) как список отсортирован сейчас: «возр», «убыв»
//            или "" — не по этой колонке.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Сортировка(Знач Адрес_, Знач Порядок = "") Экспорт

	Если РодУзла <> "колонка" Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: слово «Сортировка» бывает только у колонки"
			+ " таблицы, а это узел «%1». Возьмите Кит.Колонка(…) или Таблица.Колонка(Ключ).",
			Носитель());
	КонецЕсли;

	Порядок_ = НРег(СокрЛП(Строка(?(Порядок = Неопределено, "", Порядок))));
	Если Порядок_ <> "" И Порядок_ <> "возр" И Порядок_ <> "убыв" Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: порядок сортировки «%1» киту неизвестен."
			+ " Известные: «возр», «убыв» и пустой — список отсортирован не по этой колонке.",
			Порядок);
	КонецЕсли;

	Поля.Вставить("Сортировка", Строка(?(Адрес_ = Неопределено, "", Адрес_)));
	Поля.Вставить("Порядок", Порядок_);
	Возврат ЭтотОбъект;

КонецФункции

// Вкладка активна — страница, на которой человек стоит.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Активна(Знач Флаг = Истина) Экспорт
	Возврат Записать("Активна", "Активна", Флаг = Истина);
КонецФункции

// Имя вошедшего на открывашке меню: с ним меню печатается учёткой.
//
// Параметры:
//  Имя_ - Строка - имя.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Аккаунт(Знач Имя_) Экспорт
	Возврат Записать("Аккаунт", "Аккаунт", Строка(?(Имя_ = Неопределено, "", Имя_)));
КонецФункции

// Число колонок сетки: "авто" | 1 | 2 | 3 | 4.
//
// Параметры:
//  Значение_ - Число, Строка - колонки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Колонки(Знач Значение_) Экспорт
	Возврат Записать("Колонки", "Колонки", Значение_);
КонецФункции

// Сетка с уменьшенным зазором.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Плотная(Знач Флаг = Истина) Экспорт
	Возврат Записать("Плотная", "Плотная", Флаг = Истина);
КонецФункции

// Действие пустого состояния — узел Кит.Кнопка (или её подпись).
//
// Параметры:
//  Значение_ - ЭлементЭкрана, Строка - кнопка.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Действие(Знач Значение_) Экспорт

	ПроверитьСлово("Действие");
	Если ТипЗнч(Значение_) = ТипЗнч(ЭтотОбъект) Тогда
		Поля.Модель.Вставить("Действие", Печать.МодельКомпонента(Значение_));
	Иначе
		Поля.Модель.Вставить("Действие", Новый Структура("Подпись", Строка(Значение_)));
	КонецЕсли;
	Возврат ЭтотОбъект;

КонецФункции

// Пустое состояние вариантом для ячейки таблицы или узкой колонки.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Компактное(Знач Флаг = Истина) Экспорт
	Возврат Записать("Компактное", "Компактное", Флаг = Истина);
КонецФункции

// Полоса заполнения вариантом для ячейки таблицы, без текстовой строки.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Компактная(Знач Флаг = Истина) Экспорт
	Возврат Записать("Компактная", "Компактная", Флаг = Истина);
КонецФункции

// Уведомление с кнопкой закрытия.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Закрываемый(Знач Флаг = Истина) Экспорт
	Возврат Записать("Закрываемый", "Закрываемый", Флаг = Истина);
КонецФункции

// Адрес кнопки отмены панели сохранения; пусто — кнопки отмены нет.
//
// Параметры:
//  Адрес_ - Строка - адрес.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция АдресОтмены(Знач Адрес_) Экспорт
	Возврат Записать("АдресОтмены", "АдресОтмены", Строка(?(Адрес_ = Неопределено, "", Адрес_)));
КонецФункции

// Панель сохранения опасного действия: кнопка «удалить».
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Опасное(Знач Флаг = Истина) Экспорт
	Возврат Записать("Опасное", "Опасное", Флаг = Истина);
КонецФункции

#КонецОбласти

#Область СловаНастроек

// Ключ дома латиницей — атрибут data-house.
//
// Параметры:
//  Значение_ - Строка - ключ.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Ключ(Знач Значение_) Экспорт
	Возврат Записать("Ключ", "Ключ", Строка(?(Значение_ = Неопределено, "", Значение_)));
КонецФункции

// Имя настраиваемого объекта рядом с заголовком дома.
//
// Параметры:
//  Имя_ - Строка - имя объекта.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Объект(Знач Имя_) Экспорт
	Возврат Записать("Объект", "Объект", Строка(?(Имя_ = Неопределено, "", Имя_)));
КонецФункции

// Крошка над домом; каждый вызов добавляет одну.
//
// Параметры:
//  Подпись_ - Строка - подпись.
//  Адрес_   - Строка - (необязательный) адрес; пустой — крошка текстом.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Крошка(Знач Подпись_, Знач Адрес_ = "") Экспорт
	Возврат Дописать("Крошка", "Хлебные", Новый Структура("Подпись, Адрес", Подпись_, Адрес_));
КонецФункции

// Уведомление над секциями дома — узел Кит.Уведомление либо его текст.
//
// Параметры:
//  Значение_ - ЭлементЭкрана, Строка - уведомление.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Уведомление(Знач Значение_) Экспорт

	ПроверитьСлово("Уведомление");
	Если ТипЗнч(Значение_) = ТипЗнч(ЭтотОбъект) Тогда
		Возврат Дописать("Уведомление", "Уведомления", Печать.МодельКомпонента(Значение_));
	КонецЕсли;
	Возврат Дописать("Уведомление", "Уведомления", Новый Структура("Текст", Строка(Значение_)));

КонецФункции

// Раздел дома — тот, что открыт: он помечен в колонке разделов, и его адрес — адрес
// контекста для форм дома. Шаг формы (Кит.Шаг) — тот, с которого шаги начинаются: открыт
// без скрипта и текущий со скриптом, если ни у одного поля нет ошибки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Текущий() Экспорт

	// --- шаги (выпуск 0.11, шаг 10): шаг, с которого начать ---
	Если РодУзла = "шаг" Тогда
		Поля.Вставить("Текущий", Истина);
		Возврат ЭтотОбъект;
	КонецЕсли;

	Возврат Записать("Текущий", "Активен", Истина);

КонецФункции

// Раздел необратимого (удаление, передача): цветом ошибки, значок тоже, всегда последним
// и без рубрики — где бы его ни объявили.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же раздел.
//
Функция Опасный(Знач Флаг = Истина) Экспорт
	Возврат Записать("Опасный", "Опасный", Флаг = Истина);
КонецФункции

// Что настраивает секция — строка под её заголовком; у окна — строка под заголовком окна,
// его описание для скринридера.
//
// Параметры:
//  Текст - Строка - лид.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Лид(Знач Текст) Экспорт

	Если Печать.ЭтоОкно(РодУзла) Тогда
		Поля.Вставить("Лид", Строка(?(Текст = Неопределено, "", Текст)));
		Возврат ЭтотОбъект;
	КонецЕсли;

	Возврат Записать("Лид", "Пояснение", Строка(?(Текст = Неопределено, "", Текст)));

КонецФункции

// Секция становится формой со своей панелью сохранения; окно — формой целиком (кнопки
// действий отправляют её сами). Адрес — адрес контекста (раздел дома) с хвостом: пустой
// хвост — сам адрес, «x» — адрес/x, «/x» — абсолютный адрес. Токен берётся у предков.
//
// Параметры:
//  Хвост - Строка - (необязательный) хвост адреса.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Форма(Знач Хвост = "") Экспорт
	Если НЕ Печать.ЭтоОкно(РодУзла) Тогда
		ПроверитьСлово("Форма");
	КонецЕсли;
	Поля.Вставить("ХвостФормы", СокрЛП(Строка(?(Хвост = Неопределено, "", Хвост))));
	Возврат ЭтотОбъект;
КонецФункции

// Иконка кнопки панели секции; пусто — «сохранить».
//
// Параметры:
//  Имя_ - Строка - имя иконки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ИконкаКнопки(Знач Имя_) Экспорт
	Возврат Записать("ИконкаКнопки", "ИконкаКнопки", Строка(Имя_));
КонецФункции

// Имя и значение кнопки панели секции: форма с двумя кнопками отличает нажатую.
//
// Параметры:
//  Имя_      - Строка - name кнопки.
//  Значение_ - Строка - (необязательный) value кнопки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ИмяКнопки(Знач Имя_, Знач Значение_ = "") Экспорт
	Записать("ИмяКнопки", "ИмяКнопки", Строка(Имя_));
	Поля.Модель.Вставить("ЗначениеКнопки", Строка(Значение_));
	Возврат ЭтотОбъект;
КонецФункции

// Пояснение на панели сохранения секции.
//
// Параметры:
//  Текст - Строка - пояснение.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ПояснениеПанели(Знач Текст) Экспорт
	Возврат Записать("ПояснениеПанели", "ПояснениеПанели", Строка(Текст));
КонецФункции

// Секция без панели сохранения: кнопки живут в её теле.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция БезПанели(Знач Флаг = Истина) Экспорт
	Возврат Записать("БезПанели", "БезПанели", Флаг = Истина);
КонецФункции

// Секция уходит под кат целиком.
//
// Параметры:
//  ПодписьРаскрытия - Строка - подпись строки раскрытия.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Свёрнута(Знач ПодписьРаскрытия) Экспорт
	Записать("Свёрнута", "Свёрнута", Истина);
	Поля.Модель.Вставить("ПодписьРаскрытия", Строка(ПодписьРаскрытия));
	Возврат ЭтотОбъект;
КонецФункции

// Кат свёрнутой секции печатается открытым — так возвращается отбитая форма.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Раскрыта(Знач Флаг = Истина) Экспорт
	Возврат Записать("Раскрыта", "Раскрыта", Флаг = Истина);
КонецФункции

#КонецОбласти

#Область СловаРеестра

// --- реестр (шаг 11) ---

// Значок записи реестра — глиф кита перед её именем.
//
// Параметры:
//  Имя_ - Строка - имя иконки из набора кита.
//
// Возвращаемое значение:
//  ЭлементЭкрана - эта запись.
//
Функция Значок(Знач Имя_) Экспорт
	Возврат Записать("Значок", "Значок", Строка(?(Имя_ = Неопределено, "", Имя_)));
КонецФункции

// Факт записи реестра — подписанная строка «подпись — значение» в её сводке; каждый вызов
// добавляет одну. Пустое значение не печатается.
//
// Параметры:
//  Подпись_  - Строка - что за значение.
//  Значение_ - Строка - значение.
//  Вид_      - Строка - (необязательный) "" | "warn" — значение цветом предупреждения.
//
// Возвращаемое значение:
//  ЭлементЭкрана - эта запись.
//
Функция Факт(Знач Подпись_, Знач Значение_, Знач Вид_ = "") Экспорт
	Возврат Дописать("Факт", "Факты", Новый Структура("Подпись, Значение, Вид",
		Строка(?(Подпись_ = Неопределено, "", Подпись_)),
		Строка(?(Значение_ = Неопределено, "", Значение_)),
		Строка(?(Вид_ = Неопределено, "", Вид_))));
КонецФункции

// Номер записи реестра перед её значком. У нумерованного реестра номер по порядку
// ставится сам; слово задаёт свой — приоритет, место в очереди.
//
// Параметры:
//  Значение_ - Число, Строка - номер.
//
// Возвращаемое значение:
//  ЭлементЭкрана - эта запись.
//
Функция Номер(Знач Значение_) Экспорт
	Возврат Записать("Номер", "Номер", ?(ТипЗнч(Значение_) = Тип("Число"), Значение_,
		Строка(?(Значение_ = Неопределено, "", Значение_))));
КонецФункции

// Реестр нумерует записи по порядку и печатается нумерованным списком: порядок записей
// значим — порядок обхода, приоритет.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот реестр.
//
Функция Нумерованный() Экспорт
	Возврат Записать("Нумерованный", "Нумерованный", Истина);
КонецФункции

// Набор действий записи реестра — третий холст. Из него печатаются и меню ⚙ рядом
// со свёрнутой строкой, и кнопки внизу раскрытого тела: один список, а не два, которые
// пришлось бы держать одинаковыми. Кладут кнопки и формы из одной кнопки.
//
// Параметры:
//  Р1 - ЭлементЭкрана, Неопределено - (необязательный) действия, до Р8.
//  Р2 - ЭлементЭкрана, Неопределено - (необязательный)
//  Р3 - ЭлементЭкрана, Неопределено - (необязательный)
//  Р4 - ЭлементЭкрана, Неопределено - (необязательный)
//  Р5 - ЭлементЭкрана, Неопределено - (необязательный)
//  Р6 - ЭлементЭкрана, Неопределено - (необязательный)
//  Р7 - ЭлементЭкрана, Неопределено - (необязательный)
//  Р8 - ЭлементЭкрана, Неопределено - (необязательный)
//
// Возвращаемое значение:
//  ЭлементЭкрана - без аргументов холст действий; с аргументами — эта запись.
//
Функция Кнопки(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Холст_ = Неопределено;
	Если РодУзла <> "запись-реестра" ИЛИ НЕ Поля.Свойство("Кнопки", Холст_) Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: набор кнопок — у записи реестра"
			+ " (Кит.ЗаписьРеестра), а этот узел — «%1». Кнопки карточки кладут словом"
			+ " Действия(…), кнопки формы — её детьми.", Носитель());
	КонецЕсли;

	Дети_ = СписокДетей(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);
	Если Дети_.Количество() = 0 Тогда
		Возврат Холст_;
	КонецЕсли;

	Для Каждого Ребёнок Из Дети_ Цикл
		Холст_.Добавить(Ребёнок);
	КонецЦикла;
	Возврат ЭтотОбъект;

КонецФункции

#КонецОбласти

#Область СловаОкон

// Окно печатается открытым: так сервер отдаёт страницу с окном по адресу ?окно=… (кнопка
// окна по адресу без скрипта ведёт туда) и возвращает отбитую форму вместе с набранным.
// Скрипт кита поднимает такое окно модальным.
//
// Параметры:
//  Флаг - Булево - (необязательный, по умолчанию Истина)
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Открыто(Знач Флаг = Истина) Экспорт

	// --- картинка и образец (выпуск 0.12): у слота картинки открытым печатается окно сброса
	Если НЕ Печать.ЭтоОкно(РодУзла) И РодУзла <> "слот-картинки" Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: открытым печатается окно (Кит.Окно,"
			+ " Кит.Подтверждение, окно сброса Кит.СлотКартинки), а этот узел — «%1»."
			+ " Раскрывашку раскрывают словом Открыть().",
			Носитель());
	КонецЕсли;

	Поля.Вставить("Открыто", Флаг = Истина);
	Возврат ЭтотОбъект;

КонецФункции

// Эхо-поле подтверждения: человек набирает образец, и только тогда кнопка подтверждения
// становится доступной. Поле несёт pattern и required — без скрипта браузер не отправит
// форму с несовпавшим образцом; сервер сверяет значение поля сам.
//
// Параметры:
//  Имя_       - Строка - имя поля (его значение сверяет сервер).
//  Образец    - Строка - что человек обязан набрать.
//  Метка_     - Строка - (необязательный) подпись поля; по умолчанию из словаря «confirm.echo».
//  Подсказка_ - Строка - (необязательный) подсказка под полем.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Эхо(Знач Имя_, Знач Образец, Знач Метка_ = "", Знач Подсказка_ = "") Экспорт

	Если РодУзла <> "подтверждение" Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: эхо-поле бывает у подтверждения"
			+ " (Кит.Подтверждение), а этот узел — «%1».", Носитель());
	КонецЕсли;

	Имя_ = СокрЛП(Строка(?(Имя_ = Неопределено, "", Имя_)));
	Образец = Строка(?(Образец = Неопределено, "", Образец));
	Если НЕ ЗначениеЗаполнено(Имя_) ИЛИ НЕ ЗначениеЗаполнено(Образец) Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: эхо-полю подтверждения «%1» нужны имя"
			+ " и образец — что человек обязан набрать. Без образца поле ничего"
			+ " не подтверждает.", Поля.Заголовок);
	КонецЕсли;

	Поля.Вставить("Эхо", Новый Структура("Имя, Образец, Метка, Подсказка", Имя_, Образец,
		Строка(?(Метка_ = Неопределено, "", Метка_)), Строка(?(Подсказка_ = Неопределено, "", Подсказка_))));
	Возврат ЭтотОбъект;

КонецФункции

// Форма спрашивает подтверждение перед отправкой: признак data-confirm, скрипт перехватывает
// отправку и открывает окно, а кнопка окна отправляет эту форму (атрибут form). Без скрипта
// форма уходит как есть — без поля подтверждения (Подтверждение.ИмяПоляПодтверждения), и
// сервер отвечает страницей с этим же окном, напечатанным открытым.
//
// Параметры:
//  Окно_ - ЭлементЭкрана, Строка - узел Кит.Подтверждение (или Кит.Окно) либо его
//          идентификатор (якорь).
//
// Возвращаемое значение:
//  ЭлементЭкрана - эта же форма.
//
Функция СПодтверждением(Знач Окно_) Экспорт

	Если НЕ Печать.ЭтоФорма(РодУзла) Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: подтверждение спрашивает форма"
			+ " (Кит.Форма и сёстры), а этот узел — «%1».", Носитель());
	КонецЕсли;

	Если ТипЗнч(Окно_) = ТипЗнч(ЭтотОбъект) Тогда
		Если НЕ Печать.ЭтоОкно(Окно_.Род()) Тогда
			ВызватьИсключение СтрШаблон("Элемент экрана: форма спрашивает подтверждение"
				+ " окном — узлом Кит.Подтверждение, а пришёл «%1».", Окно_.Род());
		КонецЕсли;
		Окно_.Свойства().Вставить("ФормаСвязи", ЭтотОбъект);
		Поля.Вставить("Подтверждение", Окно_);
		Возврат ЭтотОбъект;
	КонецЕсли;

	Ид_ = СокрЛП(Строка(?(Окно_ = Неопределено, "", Окно_)));
	Если НЕ ЗначениеЗаполнено(Ид_) Тогда
		ВызватьИсключение "Элемент экрана: СПодтверждением без окна — передайте узел"
			+ " Кит.Подтверждение или его якорь.";
	КонецЕсли;
	Поля.Вставить("Подтверждение", Ид_);
	Возврат ЭтотОбъект;

КонецФункции

// Признак data-focus: элемент, на который скрипт ставит фокус, когда тихая отправка из окна
// удалась и окно закрылось, — сервер помечает им только что созданную запись. Скрипт
// делает элемент фокусируемым сам, если тот не был.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Фокус() Экспорт
	Возврат Признак("focus", "");
КонецФункции

#КонецОбласти

#Область СловаСегментовИПодсказки

// --- сегменты и подсказка (выпуск 0.12) ---

// Какой сегмент отмечен: тот, чьё значение совпало с этим. Значение, которого нет среди
// сегментов, отмечает первый — как выпадающий список, чьё значение не нашлось.
//
// Параметры:
//  Значение_ - Строка, Число - значение выбранного сегмента (обычно то, что лежит в базе).
//
// Возвращаемое значение:
//  ЭлементЭкрана - эти же сегменты.
//
Функция Выбрано(Знач Значение_) Экспорт

	ПроверитьСегменты("Выбрано");
	Поля.Вставить("Выбрано", ?(ТипЗнч(Значение_) = Тип("Число"), Формат(Значение_, "ЧН=0; ЧГ=0"),
		Строка(?(Значение_ = Неопределено, "", Значение_))));
	Возврат ЭтотОбъект;

КонецФункции

// Сегмент отмечен — главнее значения, названного словом Выбрано у сегментов.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же сегмент.
//
Функция Выбран() Экспорт

	Если РодУзла <> "сегмент" Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: слово Выбран() — у сегмента (Кит.Сегмент),"
			+ " а этот узел — «%1». Вариант выпадающего списка выбирают значением поля,"
			+ " сегменты — словом Выбрано(Значение).", Носитель());
	КонецЕсли;

	Поля.Вставить("Выбран", Истина);
	Возврат ЭтотОбъект;

КонецФункции

// Низкие сегменты — для строки списка и записи реестра, где обычные выше соседей.
//
// Возвращаемое значение:
//  ЭлементЭкрана - эти же сегменты.
//
Функция Малые() Экспорт
	ПроверитьСегменты("Малые");
	Возврат Вид("малые");
КонецФункции

// Справка поля — длинное пояснение, которое не помещается строкой под полем: значок «?»
// рядом с подписью открывает поповер с текстом, а поле называет текст своим описанием
// (aria-describedby) — скринридер прочтёт его, когда фокус придёт в поле. Короткое
// пояснение остаётся словом Подсказка: строкой под полем.
//
// Параметры:
//  Текст - Строка - пояснение (экранируется при печати).
//
// Возвращаемое значение:
//  ЭлементЭкрана - это же поле.
//
Функция Справка(Знач Текст) Экспорт
	Возврат Записать("Справка", "Справка", Строка(?(Текст = Неопределено, "", Текст)));
КонецФункции

Процедура ПроверитьСегменты(Знач Слово)

	Если РодУзла = "сегменты" Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Элемент экрана: слово %1 — у сегментов (Кит.Сегменты),"
		+ " а этот узел — «%2».", Слово, Носитель());

КонецПроцедуры

#КонецОбласти

#Область СловаКартинкиИОбразца

// --- картинка и образец (выпуск 0.12) ---

// Строка состояния слота картинки — что стоит сейчас: имя файла, размер, дата. Пусто —
// из словаря: «стандартная» у слота без сброса, «своя» у слота со сбросом.
//
// Параметры:
//  Текст - Строка - состояние (экранируется при печати).
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Состояние(Знач Текст) Экспорт
	Возврат Записать("Состояние", "Состояние", Строка(?(Текст = Неопределено, "", Текст)));
КонецФункции

// Какие файлы слот картинки предлагает выбрать — атрибут accept файлового поля
// («image/png,image/svg+xml»); по умолчанию «image/*». Это подсказка окну выбора файла,
// а не проверка: тип и размер присланного сверяет сервер.
//
// Параметры:
//  Типы - Строка - типы через запятую: MIME-типы или расширения (.ico).
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Принимает(Знач Типы) Экспорт
	Возврат Записать("Принимает", "Принимает", СокрЛП(Строка(?(Типы = Неопределено, "", Типы))));
КонецФункции

// Подпись кнопки выбора файла у слота картинки. По умолчанию из словаря: «Заменить», когда
// картинка стоит, «Загрузить», когда слот пуст.
//
// Параметры:
//  Подпись_ - Строка - подпись кнопки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция КнопкаЗагрузки(Знач Подпись_) Экспорт
	Возврат Записать("КнопкаЗагрузки", "КнопкаЗагрузки", Строка(?(Подпись_ = Неопределено, "", Подпись_)));
КонецФункции

// Сброс слота картинки к стандартной: в меню ⚙ слота встаёт пункт «Вернуть стандартную»,
// и его форма уходит на этот адрес только после подтверждения. Адрес — как у слова Форма:
// хвост к адресу контекста или путь от корня. Без скрипта форма уходит без поля
// подтверждения (Подтверждение.ИмяПоляПодтверждения), и сервер отвечает страницей со
// слотом, у которого окно сброса напечатано открытым (слово Открыто).
//
// Параметры:
//  Адрес_ - Строка - (необязательный) хвост адреса или путь от корня; пусто — адрес контекста.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Сброс(Знач Адрес_ = "") Экспорт
	Возврат Записать("Сброс", "Сброс", СокрЛП(Строка(?(Адрес_ = Неопределено, "", Адрес_))));
КонецФункции

// Тема рамки образца при печати. Без слова рамка показана в теме страницы; переключатель
// на рамке меняет тему скриптом.
//
// Параметры:
//  Значение - Строка - «светлая» | «тёмная».
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Тема(Знач Значение) Экспорт

	Если РодУзла <> "образец" Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: тему задают образцу (Кит.Образец), а этот"
			+ " узел — «%1». Тему страницы печатает документ: Кит.Документ(Язык, Тема, …).",
			Носитель());
	КонецЕсли;

	Поля.Вставить("Тема", Поля.Рисователь.ЗначениеТемы(Значение));
	Возврат ЭтотОбъект;

КонецФункции

// Зеркало значения: узел показывает текущее значение поля с этим именем, и скрипт кита
// переписывает его при каждом вводе — образец меняется без сервера. Узел печатает признак
// data-mirror; текст узла — то, что напечатал сервер, и он же возвращается, когда поле
// опустело. Для поля цвета (системный выбор цвета или образцы-кружки) скрипт пишет не текст,
// а пользовательское свойство CSS --mirror-<имя> на узле: его берёт лист приложения
// (background: var(--mirror-accent, …)). Цвет вторым аргументом печатает то же свойство
// сервером — сохранённое значение видно и без скрипта.
//
// Параметры:
//  ИмяПоля - Строка - имя поля формы (name): буквы, цифры, «-» и «_».
//  Цвет    - Строка - (необязательный) текущий цвет #rgb, #rrggbb или #rrggbbaa.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Зеркало(Знач ИмяПоля, Знач Цвет = "") Экспорт

	Если НЕ Печать.ПринимаетЗеркало(РодУзла) Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: зеркало вешается на узел со своим тегом"
			+ " — надпись, заголовок, примечание, область, рамку образца, — а этот узел —"
			+ " «%1»: %2", Носитель(), ?(РодУзла = "компонент", "компонент рисует себя сам,"
			+ " и текст, вписанный скриптом поверх, стёр бы его разметку. Положите рядом"
			+ " Кит.Надпись(…).Зеркало(…).", "признак на нём не печатается."));
	КонецЕсли;

	Имя_ = СокрЛП(Строка(?(ИмяПоля = Неопределено, "", ИмяПоля)));
	ПроверитьИмяЗеркала(Имя_);
	Признак("mirror", Имя_);

	Значение_ = НРег(СокрЛП(Строка(?(Цвет = Неопределено, "", Цвет))));
	Если ЗначениеЗаполнено(Значение_) Тогда
		ПроверитьЦветЗеркала(Имя_, Значение_);
		Поля.Вставить("ИмяЗеркала", Имя_);
		Поля.Вставить("ЦветЗеркала", Значение_);
	КонецЕсли;
	Возврат ЭтотОбъект;

КонецФункции

// Имя поля становится частью имени свойства CSS (--mirror-<имя>): пробел, кавычка или
// скобка сломали бы его, и зеркало молча не работало бы.
Процедура ПроверитьИмяЗеркала(Знач Имя_)

	Годно = ЗначениеЗаполнено(Имя_);
	Для Позиция = 1 По СтрДлина(Имя_) Цикл
		Символ = Сред(Имя_, Позиция, 1);
		Код = КодСимвола(Символ);
		Если НЕ (СтрНайти("-_0123456789", Символ) > 0 ИЛИ (Код >= 65 И Код <= 90)
			ИЛИ (Код >= 97 И Код <= 122) ИЛИ (Код >= 1024 И Код <= 1279)) Тогда
			Годно = Ложь;
		КонецЕсли;
	КонецЦикла;

	Если НЕ Годно Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: зеркало поля «%1» — имя поля пишется"
			+ " буквами, цифрами, «-» и «_»: оно становится признаком data-mirror и именем"
			+ " свойства CSS --mirror-<имя>.", Имя_);
	КонецЕсли;

КонецПроцедуры

// Цвет печатается в атрибут style — в CSS-контекст, где экранирование HTML не защищает:
// поэтому годится только шестнадцатеричная запись, всё прочее останавливает сборку.
Процедура ПроверитьЦветЗеркала(Знач Имя_, Знач Значение_)

	Цифры = Сред(Значение_, 2);
	Годно = Лев(Значение_, 1) = "#" И (СтрДлина(Цифры) = 3 ИЛИ СтрДлина(Цифры) = 4
		ИЛИ СтрДлина(Цифры) = 6 ИЛИ СтрДлина(Цифры) = 8);
	Для Позиция = 1 По СтрДлина(Цифры) Цикл
		Если СтрНайти("0123456789abcdef", Сред(Цифры, Позиция, 1)) = 0 Тогда
			Годно = Ложь;
		КонецЕсли;
	КонецЦикла;

	Если НЕ Годно Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: цвет зеркала поля «%1» — «%2», а нужен"
			+ " цвет #rgb, #rrggbb или #rrggbbaa. Пустой цвет — не передавайте второй аргумент.",
			Имя_, Значение_);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СловаТаблицыКарточкамиИСвойств

// --- таблица карточками и свойства (выпуск 0.13) ---

// Заглавная колонка таблицы карточками: её ячейка на узком экране стоит первой строкой
// записи-карточки, крупнее остальных и без подписи колонки — по ней запись узнают в лицо.
// Без этого слова заглавная — первая колонка. На широком экране слово ничего не меняет:
// там у таблицы шапка, и порядок колонок задаёт она.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Заглавная() Экспорт

	Если РодУзла <> "колонка" Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: заглавной бывает колонка таблицы, а этот"
			+ " узел — «%1». Колонку объявляют Кит.Колонка(…) или Таблица.Колонка(Ключ).",
			Носитель());
	КонецЕсли;

	Поля.Вставить("Заглавная", Истина);
	Возврат ЭтотОбъект;

КонецФункции

// Копируемое свойство: рядом со значением кнопка копирования — та же, что у блока команды
// (data-copy, её оживляет скрипт инсталляции). Без скрипта значение выделяют мышью.
//
// Параметры:
//  Текст - Строка - (необязательный) что положить в буфер обмена; по умолчанию — текст
//          значения (текстовые узлы свойства подряд, на любой глубине).
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Копируемое(Знач Текст = Неопределено) Экспорт

	ПроверитьСвойство("Копируемое");
	Поля.Вставить("Копируемое", Истина);
	Если Текст <> Неопределено Тогда
		Поля.Вставить("ТекстКопии", Строка(Текст));
	КонецЕсли;
	Возврат ЭтотОбъект;

КонецФункции

// Примечание свойства — приглушённая строка под значением: откуда оно, когда обновлено,
// чем грозит. Пустой текст снимает примечание.
//
// Параметры:
//  Текст - Строка - примечание (экранируется при печати).
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Примечание(Знач Текст) Экспорт

	ПроверитьСвойство("Примечание");
	Поля.Вставить("Примечание", Строка(?(Текст = Неопределено, "", Текст)));
	Возврат ЭтотОбъект;

КонецФункции

Процедура ПроверитьСвойство(Знач Слово)

	Если РодУзла = "свойство" Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Элемент экрана: слово %1 — у свойства (Кит.Свойство(Имя, …)),"
		+ " а этот узел — «%2».", Слово, Носитель());

КонецПроцедуры

#КонецОбласти

#Область СловаДереваГалок

// --- дерево галок (выпуск 0.13) ---
// Слова дерева галок пишут поля его модели: дерево на тысячу пунктов (адрес веток, поиск,
// режимы, только правки) и ответы его сервера (страница ветки, ответ поиска).

// Узел дерева галок: добавляет узел в корень дерева.
//
// Параметры:
//  Модель_ - Структура - модель узла: Имя, Подпись, Состояние, Дети и прочие поля узла
//            компонента «Дерево галок».
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Узел(Знач Модель_) Экспорт
	Возврат Дописать("Узел", "Узлы", Модель_);
КонецФункции

// Поиск над деревом галок: поле «найти» и кнопка «Найти». Скрипт берёт ответ по адресу
// Адрес?найти=<строка> и кладёт его на место веток; без скрипта кнопка отправляет форму
// на этот адрес.
//
// Параметры:
//  Адрес_ - Строка - адрес ответа поиска (относительный адрес своего приложения).
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Поиск(Знач Адрес_) Экспорт
	Возврат Записать("Поиск", "Поиск", Строка(?(Адрес_ = Неопределено, "", Адрес_)));
КонецФункции

// Режимы веток дерева галок: у каждой ветки вместо галки сегменты «все / выбранные /
// никакие» — радиокнопки «режим:<ключ ветки>».
//
// Параметры:
//  Флаг - Булево - (необязательный) ставить ли режимы.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Режимы(Знач Флаг = Истина) Экспорт
	Возврат Записать("Режимы", "Режимы", Флаг = Истина);
КонецФункции

// Форма дерева галок отдаёт только правки: со скриптом вместо галок уходят правки=1,
// включить=<ключ>, снять=<ключ>, режим=<ключ>:<режим>, а правки видны плашками под
// деревом. Без скрипта уходят галки, как обычно.
//
// Параметры:
//  Флаг - Булево - (необязательный) отдавать ли только правки.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция ТолькоПравки(Знач Флаг = Истина) Экспорт
	Возврат Записать("ТолькоПравки", "ТолькоПравки", Флаг = Истина);
КонецФункции

// Дерево галок — ответ поиска: узлы — совпадения, над ними число найденного и кнопки
// «Включить / Снять найденные».
//
// Параметры:
//  Запрос - Строка - что искали.
//  Всего_ - Число - (необязательный) сколько совпадений на сервере, если узлов передано
//           меньше.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Найдено(Знач Запрос, Знач Всего_ = 0) Экспорт

	Записать("Найдено", "Найдено", Строка(?(Запрос = Неопределено, "", Запрос)));
	Поля.Модель.Вставить("Всего", Всего_);
	Возврат ЭтотОбъект;

КонецФункции

// Дерево галок — страница ветки: ответ адреса веток. Узлы — дети ветки на этой странице.
//
// Параметры:
//  Ключ_      - Строка - ключ ветки из запроса («ветка=»); "" — корень дерева.
//  Страница_  - Число - (необязательный) номер страницы из запроса («страница=»), с 1.
//  Всего_     - Число - (необязательный) сколько детей у ветки на сервере.
//
// Возвращаемое значение:
//  ЭлементЭкрана - этот же элемент.
//
Функция Ветка(Знач Ключ_, Знач Страница_ = 1, Знач Всего_ = 0) Экспорт

	Записать("Ветка", "Ветка", Строка(?(Ключ_ = Неопределено, "", Ключ_)));
	Поля.Модель.Вставить("Страница", Страница_);
	Поля.Модель.Вставить("Всего", Всего_);
	Возврат ЭтотОбъект;

КонецФункции

#КонецОбласти

#Область Печать

// Печатает элемент и всё, что внутри него.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент.
//
Функция Рендер() Экспорт
	Возврат Печать.Узел(ЭтотОбъект);
КонецФункции

// Из чего собран этот кусок экрана — построчное дерево родов и видов. Отвечает объектом
// на вопрос «что здесь напечатано», не заставляя читать одиннадцать файлов.
//
// Возвращаемое значение:
//  Строка - строки вида «  ряд[выбор]», вложенность — отступом; узел, снятый словом
//           Когда(Ложь), помечен « [скрыт]».
//
Функция Дерево() Экспорт
	Возврат Печать.Ветка(ЭтотОбъект, 0);
КонецФункции

#КонецОбласти

#Область Внутреннее

// Живой состав узла — для печати. Копию отдаёт Дети(); печать копию не оплачивает,
// потому что зовётся на каждый узел каждой страницы.
//
// Возвращаемое значение:
//  Массив из ЭлементЭкрана
//
Функция Состав() Экспорт
	Возврат ДетиУзла;
КонецФункции

// Второй холст узла — для печати.
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено - второго холста у рода может не быть вовсе.
//
Функция ВторойХолст() Экспорт
	Возврат ВторойУзла;
КонецФункции

// Как называется второй холст этого узла.
//
// Возвращаемое значение:
//  Строка - «шапка» | «разворот» | «пусто» | «действия» | "".
//
Функция ИмяВторогоХолста() Экспорт
	Возврат ИмяВторого;
КонецФункции

// Ставит родителя. Зовёт только Добавить() — снаружи родителя не переписывают.
//
// Параметры:
//  Новый_ - ЭлементЭкрана - родитель.
//
Процедура ПринятьРодителя(Знач Новый_) Экспорт
	РодительУзла = Новый_;
КонецПроцедуры

// Опора — у кого узел без родителя спрашивает адрес и токен формы: значение ячейки
// таблицы из данных в дерево не кладётся, но печатается внутри таблицы. Ставит печать.
//
// Параметры:
//  Узел - ЭлементЭкрана - опора.
//
Процедура ПринятьОпору(Знач Узел) Экспорт
	ОпораУзла = Узел;
КонецПроцедуры

// Ближайший, у кого спросить контекст: родитель, а без него — опора.
//
// Возвращаемое значение:
//  ЭлементЭкрана, Неопределено
//
Функция Выше() Экспорт
	Возврат ?(РодительУзла <> Неопределено, РодительУзла, ОпораУзла);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстИзСтроки(Знач Значение)

	// CSRF-токен раньше шёл вторым позиционным аргументом формы; строкой-ребёнком он
	// напечатался бы на экране, поэтому в форме строка не принимается вовсе
	Если Печать.ЭтоФорма(РодУзла) Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: строка «%1» внутри формы — токен задаётся"
			+ " словом .Токен(…), текст в форму кладите узлом Кит.Текст().",
			Лев(Значение, 40));
	КонецЕсли;

	Возврат Новый ЭлементЭкрана(Печать, "текст", "", Новый Структура("Текст", Значение));

КонецФункции

Функция СписокДетей(Знач Р1, Знач Р2, Знач Р3, Знач Р4, Знач Р5, Знач Р6, Знач Р7, Знач Р8)

	Результат = Новый Массив();
	ДобавитьНеПустой(Результат, Р1);
	ДобавитьНеПустой(Результат, Р2);
	ДобавитьНеПустой(Результат, Р3);
	ДобавитьНеПустой(Результат, Р4);
	ДобавитьНеПустой(Результат, Р5);
	ДобавитьНеПустой(Результат, Р6);
	ДобавитьНеПустой(Результат, Р7);
	ДобавитьНеПустой(Результат, Р8);
	Возврат Результат;

КонецФункции

Процедура ДобавитьНеПустой(Знач Список, Знач Значение)
	Если Значение <> Неопределено Тогда
		Список.Добавить(Значение);
	КонецЕсли;
КонецПроцедуры

// Второй холст без аргументов отдаётся сам — его наполняют дальше; с аргументами
// наполняется, и цепочка возвращается к владельцу.
Функция НаполнитьВторой(Знач Имя, Знач Дети_)

	Второй = ВторойХолстПоИмени(Имя);
	Если Дети_.Количество() = 0 Тогда
		Возврат Второй;
	КонецЕсли;

	Для Каждого Ребёнок Из Дети_ Цикл
		Второй.Добавить(Ребёнок);
	КонецЦикла;
	Возврат ЭтотОбъект;

КонецФункции

Функция ВторойХолстПоИмени(Знач Имя)

	Если ИмяВторого = Имя Тогда
		Возврат ВторойУзла;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Элемент экрана: у узла «%1» нет холста «%2» — %3."
		+ " Содержимое, которому второй холст не нужен, кладите обычным Добавить().",
		Носитель(), Имя, ?(ЗначениеЗаполнено(ИмяВторого),
			СтрШаблон("второй холст у него называется «%1»", ИмяВторого),
			"второго холста у него нет вовсе"));

КонецФункции

Процедура ПроверитьДанныеТаблицы(Знач Слово)

	Если РодУзла = "таблица" И Поля.Свойство("Данные") И Поля.Данные <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Элемент экрана: слово «%1» — у таблицы из данных"
		+ " (Кит.Таблица(ТаблицаЗначений | Массив)), а этот узел — «%2»%3.", Слово, Носитель(),
		?(РодУзла = "таблица", " без данных: колонки и записи ручной таблицы кладут"
			+ " Кит.Колонка() и Кит.Запись()", ""));

КонецПроцедуры

// Модель есть у компонента, который рисуется на печати, и у узлов каркаса настроек:
// слова пишут её поля.
Функция ЕстьМодель()
	Возврат Поля.Свойство("Модель") И ТипЗнч(Поля.Модель) = Тип("Структура");
КонецФункции

// Чьи слова у узла: у компонента — его вид, у остальных — род.
Функция Носитель()
	Возврат ?(РодУзла = "компонент", Строка(Поля.Вид), РодУзла);
КонецФункции

Функция Знает(Знач Слово)
	Возврат ЕстьМодель() И Печать.ЗнаетСлово(Носитель(), Слово);
КонецФункции

Процедура ПроверитьСлово(Знач Слово)
	Печать.ПроверитьСлово(Носитель(), Слово, ЕстьМодель());
КонецПроцедуры

Функция Записать(Знач Слово, Знач Поле, Знач Значение)

	ПроверитьСлово(Слово);
	Поля.Модель.Вставить(Поле, Значение);
	Возврат ЭтотОбъект;

КонецФункции

// Список модели дописывается В КОПИЮ: массив мог прийти из структуры вызывающего, и
// элемент, дописанный в него, всплыл бы у того в следующей сборке.
Функция Дописать(Знач Слово, Знач Поле, Знач Элемент)

	ПроверитьСлово(Слово);

	Список = Новый Массив();
	Было = Неопределено;
	Если Поля.Модель.Свойство(Поле, Было) И ТипЗнч(Было) = Тип("Массив") Тогда
		Для Каждого Значение_ Из Было Цикл
			Список.Добавить(Значение_);
		КонецЦикла;
	КонецЕсли;
	Список.Добавить(Элемент);

	Поля.Модель.Вставить(Поле, Список);
	Возврат ЭтотОбъект;

КонецФункции

// --- шаги (выпуск 0.11, шаг 10) ---
// Кнопка отправки шагов: узел кнопки отдаёт свою модель, подпись строкой — основную кнопку.
Функция КнопкаШагов(Знач Значение_, Знач Иконка_)

	Если ТипЗнч(Значение_) = ТипЗнч(ЭтотОбъект) Тогда
		Модель_ = Печать.МодельКомпонента(Значение_);
	Иначе
		Модель_ = Новый Структура("Подпись, Вариант",
			Строка(?(Значение_ = Неопределено, "", Значение_)), "основная");
	КонецЕсли;
	Если Иконка_ <> Неопределено Тогда
		Модель_.Вставить("Иконка", Строка(Иконка_));
	КонецЕсли;

	Поля.Вставить("Кнопка", Модель_);
	Возврат ЭтотОбъект;

КонецФункции

Функция МодельПлашки(Знач Значение_)

	Если ТипЗнч(Значение_) = ТипЗнч(ЭтотОбъект) Тогда
		Возврат Печать.МодельКомпонента(Значение_);
	ИначеЕсли ТипЗнч(Значение_) = Тип("Структура") Тогда
		Возврат Значение_;
	КонецЕсли;
	Возврат Новый Структура("Текст", Строка(?(Значение_ = Неопределено, "", Значение_)));

КонецФункции

// Лежит ли элемент внутри этого на любой глубине: предок, положенный в потомка, дал бы
// печать без конца.
Функция Внутри(Знач Возможный)

	Узел = РодительУзла;
	Пока Узел <> Неопределено Цикл
		Если Узел = Возможный Тогда
			Возврат Истина;
		КонецЕсли;
		Узел = Узел.Родитель();
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Процедура ПроверитьХолст()

	Если ЭтоХолст() Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Элемент экрана: узел «%1» холстом быть не может — внутрь него"
		+ " не кладут. Лист дерева (текст, картинка, готовый фрагмент, компонент без слота)"
		+ " печатает себя целиком; вложенное кладите в ряд, группу или раскрывашку.", Носитель());

КонецПроцедуры

Процедура ПроверитьРебёнка(Знач Ребёнок)

	Если ТипЗнч(Ребёнок) <> ТипЗнч(ЭтотОбъект) Тогда
		ВызватьИсключение "Элемент экрана: внутрь кладут ЭЛЕМЕНТ или строку текста, а не «"
			+ ТипЗнч(Ребёнок) + "». Число и дату форматирует вызывающий; готовую разметку,"
			+ " которую пока некому собрать деревом, заворачивайте в Кит.Готовое() — этот узел"
			+ " на то и заведён, и он на виду у ревью.";
	КонецЕсли;

	Если Ребёнок = ЭтотОбъект ИЛИ Внутри(Ребёнок) Тогда
		ВызватьИсключение "Элемент экрана: элемент кладётся сам в себя — печать такого дерева"
			+ " не кончится никогда.";
	КонецЕсли;

	Если Ребёнок.Родитель() <> Неопределено Тогда
		ВызватьИсключение "Элемент экрана: элемент уже лежит внутри другого. Один элемент —"
			+ " одно место на экране; для второго места возьмите у кита новый.";
	КонецЕсли;

	Печать.ПроверитьВложение(РодУзла, Ребёнок.Род());
	Печать.ПроверитьВложениеКомпонента(ЭтотОбъект, Ребёнок);

КонецПроцедуры

Функция БазовыеСвойства(Знач Вид)

	Результат = Новый Структура();
	Результат.Вставить("Вид", НРег(СокрЛП(Строка(?(Вид = Неопределено, "", Вид)))));
	Результат.Вставить("Подпись", "");
	Результат.Вставить("Подсказка", "");
	Результат.Вставить("Якорь", "");
	Результат.Вставить("Роль", "");
	Результат.Вставить("Высота", 0);
	Результат.Вставить("Ширина", 0);
	Результат.Вставить("Файлы", Ложь);
	Результат.Вставить("Отключён", Ложь);
	Результат.Вставить("Скрыт", Ложь);
	Результат.Вставить("Открыта", Ложь);
	Результат.Вставить("БезПодписиВЗаписи", Ложь);
	Результат.Вставить("Показан", Истина);
	Возврат Результат;

КонецФункции


Процедура ДополнитьСвоими(Знач Свои)

	Если Свои = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого КиЗ Из Свои Цикл
		Поля.Вставить(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

// НЕ желудь сознательно: у элемента есть состав, поэтому новый выдаёт фабрика «Кит».
//
// Параметры:
//  _Печать - РазметкаЭлементов - чем узел становится в HTML.
//  _Род    - Строка            - род узла.
//  _Вид    - Строка            - вид узла из закрытого набора рода.
//  _Свои   - Структура, Неопределено - свойства, которые есть только у этого рода.
//
Процедура ПриСозданииОбъекта(Знач _Печать, Знач _Род, Знач _Вид = "", Знач _Свои = Неопределено) Экспорт

	Печать = _Печать;
	РодУзла = _Род;
	Поля = БазовыеСвойства(_Вид);
	ДополнитьСвоими(_Свои);

	// вид проверяется на рождении узла, а не на печати: иначе опечатка всплывает страницей
	// без оформления, и виноватым выглядит CSS
	Печать.ПроверитьВид(РодУзла, Поля.Вид);
	Вложение = Печать.Контейнер(РодУзла, Поля);

	ПризнакиУзла = Неопределено;
	ДетиУзла = Новый Массив();
	РодительУзла = Неопределено;
	ОпораУзла = Неопределено;

	ИмяВторого = Печать.ВторойХолстРода(РодУзла, Поля.Вид);
	Если ЗначениеЗаполнено(ИмяВторого) Тогда
		ВторойУзла = Новый ЭлементЭкрана(Печать, "холст");
		ВторойУзла.ПринятьРодителя(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры
