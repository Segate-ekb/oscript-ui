// Подтверждение — желудь UI-кита: окно необратимого действия. Вместо window.confirm браузера
// оно называет последствия, просит набрать образец (эхо-поле) и держит кнопку цвета ошибки.
// Рамка — та же, что у Кит.Окно (желудь «Окно»); здесь только тело и действия.
//
// Проверка на клиенте — удобство: эхо-поле несёт pattern и required, поэтому браузер
// не отправит форму с несовпавшим образцом и без скрипта, а скрипт ещё и держит кнопку
// заблокированной до совпадения. Гарантия — серверная: сервер сверяет поле сам.

Перем Набор;   // НаборКомпонентов
Перем Тексты;  // ТекстыИнтерфейса
Перем Окна;    // Окно — рамка модального окна

#Область ПубличныйИнтерфейс

// Печатает окно подтверждения. Последствия — описание окна (aria-describedby): скринридер
// читает их сразу за заголовком. Кнопка подтверждения отправляет форму с полем
// ИмяПоляПодтверждения() = "1", чтобы сервер отличил подтверждённую отправку от первой.
//
// Параметры:
//  Модель - Структура - поля рамки окна (см. Окно.Отрисовать) и Последствия (что
//           случится, необратимо), Дополнение (ДОВЕРЕННЫЙ HTML под последствиями), Эхо
//           (Структура: Имя, Образец, Метка, Подсказка; Неопределено — эхо-поля нет),
//           ОшибкаЭха (отказ под эхо-полем),
//           Кнопка (подпись кнопки подтверждения; пусто — из словаря «confirm.ok»),
//           ФормаИд (идентификатор формы вне окна, которую отправляет кнопка; пусто —
//           своя форма окна либо форма вокруг).
//
// Возвращаемое значение:
//  Строка - HTML <dialog>.
//
Функция Отрисовать(Знач Модель) Экспорт

	Последствия = Строка(Модель.Последствия);
	Если НЕ ЗначениеЗаполнено(Модель.Лид) Тогда
		Модель.Вставить("Лид", Последствия);
	КонецЕсли;

	Модель.Вставить("Тело", Строка(Модель.Дополнение) + ЭхоПоле(Модель));
	Модель.Вставить("Действия", Действия(Модель));
	Возврат Окна.Отрисовать(Модель);

КонецФункции

// Имя поля, которое кнопка подтверждения отправляет со значением "1": по нему сервер
// отличает подтверждённую отправку от первой (без скрипта форма с подтверждением приходит
// без него — и сервер отвечает страницей с этим окном, напечатанным открытым).
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяПоляПодтверждения() Экспорт
	Возврат "confirmed";
КонецФункции

// Образец эхо-поля регулярным выражением для атрибута pattern: совпадать должно всё поле
// и буквально, поэтому служебные знаки выражения экранируются.
//
// Параметры:
//  Образец - Строка - что человек обязан набрать.
//
// Возвращаемое значение:
//  Строка
//
Функция ШаблонОбразца(Знач Образец) Экспорт

	Служебные = "\^$.|?*+()[]{}/";
	Результат = "";
	Для Позиция = 1 По СтрДлина(Образец) Цикл
		Символ = Сред(Образец, Позиция, 1);
		Результат = Результат + ?(СтрНайти(Служебные, Символ) > 0, "\", "") + Символ;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Образец показывается в подписи и подсказкой поля, а не значением: иначе подтверждение —
// лишний щелчок. Автозаполнение выключено: браузер подставил бы прошлое подтверждение.
//
// Эхо-поле закрытого подтверждения без своей формы печатается заблокированным: оно приписано
// к форме страницы (атрибутом form или вложением), и обязательное пустое поле в закрытом окне
// не дало бы этой форме уйти вовсе. Заблокированное поле обязательность не держит; открывая
// окно, скрипт его открывает. Открытым (страница подтверждения без скрипта) оно печатается
// доступным.
Функция ЭхоПоле(Знач Модель)

	Эхо = Модель.Эхо;
	Если ТипЗнч(Эхо) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Образец = Строка(Эхо.Образец);
	Метка = Строка(Эхо.Метка);
	Заблокировано = Модель.Открыто <> Истина И НЕ Модель.Свойство("Форма");

	Возврат СтрШаблон("<div class=""modal__echo"">%1</div>", Набор.Поле().Отрисовать(Новый Структура(
		"Имя, Ид, Метка, Подсказка, Плейсхолдер, Обязательное, Автозаполнение, Шаблон, Форма,"
			+ " Заблокировано, Ошибка",
		Эхо.Имя, Модель.Ид + "-echo",
		?(ЗначениеЗаполнено(Метка), Метка, Тексты.Шаблон("confirm.echo", Образец)),
		Строка(Эхо.Подсказка), Образец, Истина, "off", ШаблонОбразца(Образец),
		Модель.ФормаИд, Заблокировано, Строка(Модель.ОшибкаЭха))));

КонецФункции

// Отмена — команда движка «закрыть» (type="button", форму не шлёт), подтверждение —
// кнопка отправки цвета ошибки; у формы вне окна — с атрибутом form.
Функция Действия(Знач Модель)

	Подпись = Строка(Модель.Кнопка);

	Возврат Набор.Кнопка().Отрисовать(Новый Структура("Подпись, Вариант, Команда, Цель",
			Тексты.Текст("confirm.cancel"), "вторичная", "закрыть", Модель.Ид))
		+ Набор.Кнопка().Отрисовать(Новый Структура("Подпись, Вариант, Имя, Значение, Форма",
			?(ЗначениеЗаполнено(Подпись), Подпись, Тексты.Текст("confirm.ok")), "опасная",
			ИмяПоляПодтверждения(), "1", Модель.ФормаИд));

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "НаборКомпонентов") _Набор,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "Окно") _Окна) Экспорт

	Набор = _Набор;
	Тексты = _Тексты;
	Окна = _Окна;

КонецПроцедуры
