// Подсказка — желудь UI-кита: печать узла Кит.Подсказка — значка «?», по нажатию на который
// рядом открывается поповер с пояснением. Длинное пояснение уходит из-под поля и из-под
// заголовка, но не теряется: оно в одном нажатии, а скринридер слышит его описанием поля.
//
// Скрипта нет: кнопка открывает поповер атрибутом popovertarget, Esc и щелчок мимо
// закрывают его движком браузера, фокус движок возвращает на кнопку. Поле со словом
// Справка печатает ту же пару «кнопка — поповер» само (ПолеФормы): разметку держите
// одинаковой в обоих местах.

Перем Экран;   // ЭкранированиеHTML
Перем Тексты;  // ТекстыИнтерфейса — имя кнопки «?» для скринридера

#Область ПубличныйИнтерфейс

// Печатает значок «?» и поповер с текстом. Без текста не печатает ничего: пустой поповер
// открылся бы пустым местом.
//
// Параметры:
//  Модель - Структура - Ид (идентификатор поповера: на него ссылается popovertarget),
//           Текст (пояснение; экранируется), Подпись (имя кнопки для скринридера; пусто —
//           текст словаря «help.open»).
//
// Возвращаемое значение:
//  Строка - <button class="help"> и <span class="help__pop" popover> подряд либо "".
//
Функция Отрисовать(Знач Модель) Экспорт

	Текст = Строка(Модель.Текст);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат "";
	КонецЕсли;

	Подпись = Строка(Модель.Подпись);
	Если НЕ ЗначениеЗаполнено(Подпись) Тогда
		Подпись = Тексты.Текст("help.open");
	КонецЕсли;

	Возврат СтрШаблон("<button type=""button"" class=""help"" popovertarget=""%1""%2>"
		+ "<span class=""help__mark"" aria-hidden=""true"">?</span></button>"
		+ "<span class=""help__pop"" id=""%1"" popover>%3</span>",
		Экран.Экранировать(Модель.Ид), Экран.Атрибут("aria-label", Подпись), Экран.Экранировать(Текст));

КонецФункции

// Имя кнопки «?» у поля для скринридера: «Справка: Ключ проекта». Без него кнопка
// называлась бы знаком вопроса, и рядом с тремя полями было бы три одинаковых «?».
//
// Параметры:
//  Метка - Строка - метка поля.
//
// Возвращаемое значение:
//  Строка - текст шаблона словаря «help.field» либо «help.open», если метки нет.
//
Функция ПодписьУПоля(Знач Метка) Экспорт

	Метка = Строка(?(Метка = Неопределено, "", Метка));
	Если НЕ ЗначениеЗаполнено(Метка) Тогда
		Возврат Тексты.Текст("help.open");
	КонецЕсли;
	Возврат Тексты.Шаблон("help.field", Метка);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Экран = _Экран;
	Тексты = _Тексты;

КонецПроцедуры
