// Свойства — желудь UI-кита: печать свойства (Кит.Свойство) со словами выпуска 0.13 —
// Копируемое, Секрет, Примечание. Свойство без этих слов печатает РазметкаЭлементов
// прежней парой <dt>/<dd>, и этот рисователь его не касается.
//
// Скрипта своего нет. Кнопка копирования — та же, что у блока команды (data-copy): её
// оживляет скрипт инсталляции, а без него значение выделяют мышью. Секрет показывает лист:
// галка «Показать» стоит в разметке ПЕРЕД значением, и правило «:checked ~» снимает точки
// и открывает значение — без скрипта и без :has.

Перем Экран;   // ЭкранированиеHTML
Перем Тексты;  // ТекстыИнтерфейса — «Копировать», «Показать», «Скрыть»
Перем Значки;  // Иконка — значок копирования

#Область ПубличныйИнтерфейс

// Точки на месте секрета. Их число постоянно: по длине точек длину секрета не угадать.
//
// Возвращаемое значение:
//  Строка
//
Функция Точки() Экспорт
	Возврат "••••••••";
КонецФункции

// Печатает пару «имя — значение» со словами свойства.
//
// Параметры:
//  Модель - Структура - Имя (экранируется), Атрибуты (готовая строка атрибутов <dd>
//           с классом значения — его вместе с прочими атрибутами узла печатает холст),
//           Значение (напечатанные дети свойства), Копия (что копировать; Неопределено —
//           кнопки нет), Секрет (Булево), ИдСекрета (идентификатор галки «Показать»),
//           Примечание (экранируется; пусто — нет).
//
// Возвращаемое значение:
//  Строка - <dt>…</dt><dd class="props__value…">…</dd>.
//
Функция Отрисовать(Знач Модель) Экспорт

	Части = Новый Массив();

	Если Модель.Секрет = Истина Тогда
		Части.Добавить(СтрШаблон("<input type=""checkbox"" class=""props__reveal-box"" id=""%1"">",
			Экран.Экранировать(Модель.ИдСекрета)));
		Части.Добавить(СтрШаблон("<span class=""props__mask"" aria-hidden=""true"">%1</span>",
			Точки()));
	КонецЕсли;

	Части.Добавить(СтрШаблон("<div class=""props__text"">%1</div>", Модель.Значение));

	Если Модель.Секрет = Истина Тогда
		Части.Добавить(СтрШаблон("<label class=""props__reveal"" for=""%1"">"
			+ "<span class=""props__reveal-show"">%2</span>"
			+ "<span class=""props__reveal-hide"">%3</span></label>",
			Экран.Экранировать(Модель.ИдСекрета),
			Экран.Экранировать(Тексты.Текст("props.reveal")),
			Экран.Экранировать(Тексты.Текст("props.hide"))));
	КонецЕсли;

	Если Модель.Копия <> Неопределено Тогда
		Подпись = Тексты.Текст("props.copy");
		Части.Добавить(СтрШаблон("<button class=""copy props__copy"" type=""button""%1%2>%3"
			+ "<span class=""visually-hidden"">%4</span></button>",
			Экран.Атрибут("data-copy", Модель.Копия), Экран.Атрибут("title", Подпись),
			Значки.Отрисовать("копировать"), Экран.Экранировать(Подпись)));
	КонецЕсли;

	Если ЗначениеЗаполнено(Модель.Примечание) Тогда
		Части.Добавить(СтрШаблон("<span class=""props__note"">%1</span>",
			Экран.Экранировать(Модель.Примечание)));
	КонецЕсли;

	Возврат СтрШаблон("<dt>%1</dt><dd%2>%3</dd>", Экран.Экранировать(Модель.Имя),
		Модель.Атрибуты, СтрСоединить(Части, ""));

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "Иконка") _Значки) Экспорт

	Экран = _Экран;
	Тексты = _Тексты;
	Значки = _Значки;

КонецПроцедуры
