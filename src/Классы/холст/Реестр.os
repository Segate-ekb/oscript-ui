// Реестр — желудь UI-кита: печать узлов Кит.Реестр и Кит.ЗаписьРеестра. Реестр — список
// немногих записей (их — единицы, а не страницы): у каждой свёрнутая строка-сводка,
// действия снаружи неё и тело с подробностями и кнопками внизу.
//
// Запись — нативная раскрывашка <details class="panel">: раскрытие работает без единой
// строки скрипта. Действия лежат ВНЕ <summary>: тумблер или кнопка внутри свёрнутой строки
// раскрывали бы запись тем же щелчком, а скринридер читал бы их частью её названия.
// Действия стоят в разметке ПЕРЕД раскрывашкой и прижаты вправо обтеканием: свёрнутая
// строка уступает им ровно их ширину, сколько бы их ни было, — без расчёта на сервере
// и без скрипта.
//
// Меню ⚙ в действиях и кнопки внизу тела печатаются из ОДНОГО набора действий: у свёрнутой
// записи действия под рукой в меню, у раскрытой — кнопками на виду, а меню прячет лист
// стилей. Два списка, которые надо держать одинаковыми руками, рано или поздно разошлись бы.
//
// Модель собирает РазметкаЭлементов из слов и детей узлов: тело, действия и кнопки
// приходят уже напечатанными.

Перем Экран;   // ЭкранированиеHTML
Перем Модели;  // ЧтениеМодели
Перем Набор;   // НаборКомпонентов — сводка, меню, иконка, пустое состояние
Перем Тексты;  // ТекстыИнтерфейса

// Отрисовывает реестр: список записей либо, когда записей нет, пустое состояние.
//
// Параметры:
//  Модель - Структура - Записи (Массив моделей записи, см. ОтрисоватьЗапись),
//           Нумерованный (Булево: записи без своего Номера нумеруются по порядку, список
//           печатается <ol>), Атрибуты (ДОВЕРЕННЫЙ фрагмент атрибутов списка: id,
//           aria-label, data-признаки — его печатает холст), Пусто (ДОВЕРЕННЫЙ HTML вместо
//           списка, когда записей нет), Пояснение (текст пустого состояния; по умолчанию
//           текст словаря «registry.empty»).
//
// Возвращаемое значение:
//  Строка - фрагмент <ul class="entries"> или <ol class="entries">;
//           без записей — пустое состояние.
//
Функция Отрисовать(Знач Модель) Экспорт

	Записи = Модели.Список(Модель, "Записи");
	Если Записи.Количество() = 0 Тогда
		Возврат Пусто(Модель);
	КонецЕсли;

	Нумерованный = Модели.Флаг(Модель, "Нумерованный");
	Части = Новый Массив();
	Порядковый = 0;
	Для Каждого Запись Из Записи Цикл
		Порядковый = Порядковый + 1;
		Части.Добавить(ОтрисоватьЗапись(Запись, ?(Нумерованный, Порядковый, Неопределено)));
	КонецЦикла;

	Тег = ?(Нумерованный, "ol", "ul");
	Возврат СтрШаблон("<%1 class=""entries""%2>%3</%1>", Тег,
		Модели.Текст(Модель, "Атрибуты"), СтрСоединить(Части, ""));

КонецФункции

// Отрисовывает одну запись реестра — пункт списка.
//
// Параметры:
//  Модель - Структура - Имя (обязательно: название в сводке и имя меню действий),
//           Значок (имя глифа кита перед именем), Картинка (адрес картинки инсталляции
//           вместо значка), Плашки (Массив моделей «Плашки» у имени), Подпись (Строка
//           либо Массив из Строка — части через « · »), Факты (Массив из Структура:
//           Подпись, Значение, Вид — "" | "warn"), Номер (Число или Строка — номер перед
//           значком), Открыта (Булево: тело раскрыто), Атрибуты (ДОВЕРЕННЫЙ фрагмент
//           атрибутов пункта), Тело (ДОВЕРЕННЫЙ HTML подробностей), Действия (ДОВЕРЕННЫЙ
//           HTML действий снаружи сводки), Кнопки (Массив из Строка — ДОВЕРЕННЫЙ HTML
//           каждого действия набора: им печатаются и меню ⚙, и кнопки внизу тела).
//  Номер  - Число, Неопределено - (необязательный) порядковый номер, если свой Номер
//           у записи не задан.
//
// Возвращаемое значение:
//  Строка - фрагмент <li class="entry">. Кидается исключением, если Имя пусто.
//
Функция ОтрисоватьЗапись(Знач Модель, Знач Номер = Неопределено) Экспорт

	Имя = Модели.Текст(Модель, "Имя");
	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		ВызватьИсключение "Реестр: у записи нет Имени. Имя — первое, что человек читает"
			+ " в свёрнутой строке, и им же названо меню её действий; назовите запись"
			+ " именем, адресом или номером.";
	КонецЕсли;

	Кнопки = Новый Массив();
	Для Каждого Кнопка Из Модели.Список(Модель, "Кнопки") Цикл
		Если ЗначениеЗаполнено(Кнопка) Тогда
			Кнопки.Добавить(Строка(Кнопка));
		КонецЕсли;
	КонецЦикла;

	Свой = Модели.Значение(Модель, "Номер");
	Если Свой <> Неопределено И Свой <> "" Тогда
		Номер = Свой;
	КонецЕсли;

	Возврат СтрШаблон("<li class=""entry""%1>%2%3</li>",
		Модели.Текст(Модель, "Атрибуты"),
		Действия(Модель, Имя, Кнопки),
		Панель(Модель, Имя, Номер, Кнопки));

КонецФункции

#Область Части

// Пустой реестр — не пустая рамка списка, а объяснение: что здесь появится. Свой холст
// «пусто» печатается как есть, иначе — пустое состояние с пояснением.
Функция Пусто(Знач Модель)

	Своё = Модели.Текст(Модель, "Пусто");
	Если ЗначениеЗаполнено(Своё) Тогда
		Возврат Своё;
	КонецЕсли;

	Пояснение = Модели.Текст(Модель, "Пояснение");
	Если НЕ ЗначениеЗаполнено(Пояснение) Тогда
		Пояснение = Тексты.Текст("registry.empty");
	КонецЕсли;

	Возврат Набор.ПустоеСостояние().Отрисовать(Новый Структура("Пояснение, Компактное",
		Пояснение, Истина));

КонецФункции

// Действия снаружи сводки и меню ⚙ из набора кнопок. Меню печатается всегда, когда набор
// не пуст: у раскрытой записи его прячет лист стилей, а без поддержки :has() оно просто
// остаётся видимым — дублем кнопок, а не дырой.
Функция Действия(Знач Модель, Знач Имя, Знач Кнопки)

	Свои = Модели.Текст(Модель, "Действия");
	Меню = "";
	Если Кнопки.Количество() > 0 Тогда
		Пункты = Новый Массив();
		Для Каждого Кнопка Из Кнопки Цикл
			Пункты.Добавить(Новый Структура("HTML", Кнопка));
		КонецЦикла;
		Меню = СтрШаблон("<div class=""entry__gear"">%1</div>",
			Набор.Меню().Отрисовать(Новый Структура("Подпись, Пункты",
				Тексты.Шаблон("registry.entry.actions", Имя), Пункты)));
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Свои) И НЕ ЗначениеЗаполнено(Меню) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон("<div class=""entry__actions"">%1%2</div>", Свои, Меню);

КонецФункции

// Запись без тела и без кнопок раскрывать нечем: свёрнутая строка печатается обычной
// строкой панели, без <details> — иначе щелчок открывал бы пустоту.
Функция Панель(Знач Модель, Знач Имя, Знач Номер, Знач Кнопки)

	Голова = СтрШаблон("%1%2%3", НомерHTML(Номер), Значок(Модель), Сводка(Модель, Имя));

	Тело = Модели.Текст(Модель, "Тело");
	Если НЕ ЗначениеЗаполнено(Тело) И Кнопки.Количество() = 0 Тогда
		Возврат СтрШаблон("<div class=""panel entry__panel""><div class=""panel__head entry__head"">%1</div></div>",
			Голова);
	КонецЕсли;

	Низ = "";
	Если Кнопки.Количество() > 0 Тогда
		Низ = СтрШаблон("<div class=""entry__buttons"">%1</div>", СтрСоединить(Кнопки, ""));
	КонецЕсли;

	Возврат СтрШаблон("<details class=""panel entry__panel""%1><summary class=""panel__head entry__head"">%2</summary>"
		+ "<div class=""panel__body"">%3%4</div></details>",
		Экран.БулевАтрибут("open", Модели.Флаг(Модель, "Открыта")), Голова, Тело, Низ);

КонецФункции

// Номер — часть названия записи: в реестре, где порядок значим (порядок обхода, приоритет),
// скринридер читает его вместе с именем.
Функция НомерHTML(Знач Номер)

	Если Номер = Неопределено ИЛИ Номер = "" Тогда
		Возврат "";
	КонецЕсли;

	Текст = ?(ТипЗнч(Номер) = Тип("Число"), Формат(Номер, "ЧН=0; ЧГ=0"), Строка(Номер));
	Возврат СтрШаблон("<span class=""entry__num"">%1</span>", Экран.Экранировать(Текст));

КонецФункции

// Картинка инсталляции старше глифа кита: она и есть знак этой записи (логотип сервиса).
// Обе декоративны — имя записи стоит рядом текстом.
Функция Значок(Знач Модель)

	Адрес = Модели.Текст(Модель, "Картинка");
	Если ЗначениеЗаполнено(Адрес) И Экран.URLБезопасенДляHref(Адрес) Тогда
		Возврат СтрШаблон("<img class=""entry__image"" src=""%1"" alt="""" width=""24"" height=""24"">",
			Экран.Экранировать(Адрес));
	КонецЕсли;

	Глиф = Модели.Текст(Модель, "Значок");
	Если НЕ ЗначениеЗаполнено(Глиф) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Набор.Иконка().Отрисовать(Новый Структура("Имя, Класс", Глиф, "entry__icon"));

КонецФункции

// Сводку печатает компонент «Сводка»: имя, плашки у него, подпись и факты — одна разметка
// с записью любого другого списка.
Функция Сводка(Знач Модель, Знач Имя)

	Возврат Набор.Сводка().Отрисовать(Новый Структура("Название, Знаки, Подпись, Сведения",
		Имя, Модели.Список(Модель, "Плашки"), Модели.Значение(Модель, "Подпись"),
		Модели.Список(Модель, "Факты")));

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ЧтениеМодели") _Модели,
	&Пластилин(Значение = "НаборКомпонентов") _Набор,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Экран = _Экран;
	Модели = _Модели;
	Набор = _Набор;
	Тексты = _Тексты;

КонецПроцедуры
