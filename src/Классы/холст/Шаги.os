// Шаги — желудь UI-кита: печать узла Кит.Шаги — длинной формы, которая идёт по одному
// экрану за раз. Дерево узлов собирает модель (РазметкаЭлементов), здесь она становится
// разметкой; признаки data-* для скрипта кита объявлены здесь, в одном месте.
//
// Без скрипта шаги — панели <details> подряд, открыт шаг, с которого начинать, кнопка
// отправки под ними: форма заполняется и уходит целиком, проверяет её сервер. Полоса
// номеров и «Назад / Дальше» печатаются с атрибутом hidden — их показывает скрипт кита
// вместе с одной панелью за раз.

Перем Экран;   // ЭкранированиеHTML
Перем Набор;   // НаборКомпонентов — кнопки и галка пройденного шага
Перем Тексты;  // ТекстыИнтерфейса — «Назад», «Дальше», «Отправить», «Шаг N из M»

#Область ПубличныйИнтерфейс

// Печатает шаги формы: полосу номеров (её показывает скрипт), панели шагов и ряд кнопок.
// Без шагов не печатает ничего.
//
// Параметры:
//  Модель - Структура - Атрибуты (ДОВЕРЕННАЯ строка атрибутов корня: класс, id, data-*),
//           Вид ("" — мастер: «Назад / Дальше», отправка на последнем шаге | "вкладки" —
//           правка: любой шаг открывается сразу, отправка видна всегда), Подпись (имя
//           полосы номеров для скринридера; пусто — без имени), Начало (номер шага с 1,
//           который открыт без скрипта и с которого скрипт начинает), Кнопка (модель
//           кнопки отправки; без неё — основная кнопка с текстом словаря «steps.submit»),
//           Шаги (массив структур: Подпись, Тело — ДОВЕРЕННЫЙ HTML панели, Атрибуты —
//           ДОВЕРЕННАЯ строка атрибутов панели).
//
// Возвращаемое значение:
//  Строка - <div class="steps"> с полосой, панелями и рядом кнопок либо "".
//
Функция Отрисовать(Знач Модель) Экспорт

	Шаги_ = Модель.Шаги;
	Всего = Шаги_.Количество();
	Если Всего = 0 Тогда
		Возврат "";
	КонецЕсли;

	Начало = Мин(Макс(1, Модель.Начало), Всего);
	Правка = (Модель.Вид = "вкладки");

	Части = Новый Массив();
	Части.Добавить(СтрШаблон("<div%1 %2=""%3"">", Модель.Атрибуты, ПризнакКорня(), Число_(Начало)));
	Части.Добавить(Полоса(Шаги_, Начало, Модель.Подпись));

	Номер = 0;
	Для Каждого Шаг Из Шаги_ Цикл
		Номер = Номер + 1;
		Части.Добавить(Панель(Шаг, Номер, Всего, Номер = Начало));
	КонецЦикла;

	Части.Добавить(Кнопки(Модель.Кнопка, Правка));
	Части.Добавить("</div>");

	Возврат СтрСоединить(Части, "");

КонецФункции

#КонецОбласти

#Область Признаки

// Признаки data-* шагов — единственное место, где они названы. Их же перечисляет страница
// «Движение» в списке «Что делает скрипт».
//
//   data-steps        корень; значение — номер шага, с которого начинать (печатает сервер)
//   data-steps-bar    полоса номеров (печатается hidden, показывает скрипт)
//   data-steps-go     кнопка шага в полосе; значение — его номер
//   data-steps-panel  панель шага
//   data-steps-back   «Назад» (hidden; у вида «вкладки» не печатается)
//   data-steps-next   «Дальше» (hidden; у вида «вкладки» не печатается)
//   data-steps-submit отправка
//   data-steps-live   корень, который ведёт скрипт (ставит скрипт)
//   data-steps-done   пройденный шаг в полосе (ставит скрипт)

Функция ПризнакКорня()
	Возврат "data-steps";
КонецФункции

Функция ПризнакПолосы()
	Возврат "data-steps-bar";
КонецФункции

Функция ПризнакПерехода()
	Возврат "data-steps-go";
КонецФункции

Функция ПризнакПанели()
	Возврат "data-steps-panel";
КонецФункции

Функция ПризнакНазад()
	Возврат "data-steps-back";
КонецФункции

Функция ПризнакДальше()
	Возврат "data-steps-next";
КонецФункции

Функция ПризнакОтправки()
	Возврат "data-steps-submit";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Полоса номеров — список, а не набор вкладок: шаги идут по порядку, и скринридер
// читает «список, 3 пункта». Номер скрыт от него (порядок называет сам список), текущий
// шаг помечен aria-current="step". Без скрипта полосы нет: панели называют себя сами.
Функция Полоса(Знач Шаги_, Знач Начало, Знач Подпись)

	Пункты = Новый Массив();
	Галка = Набор.Иконка().Отрисовать("галочка");
	Номер = 0;
	Для Каждого Шаг Из Шаги_ Цикл
		Номер = Номер + 1;
		Пункты.Добавить(СтрШаблон("<li class=""steps__item""%1><button type=""button"""
			+ " class=""steps__go"" %2=""%3""><span class=""steps__mark"" aria-hidden=""true"">"
			+ "<span class=""steps__num"">%3</span>%4</span><span class=""steps__label"">%5</span>"
			+ "</button></li>",
			?(Номер = Начало, " aria-current=""step""", ""), ПризнакПерехода(), Число_(Номер),
			Галка, Экран.Экранировать(Шаг.Подпись)));
	КонецЦикла;

	Возврат СтрШаблон("<ol class=""steps__bar""%1 %2 hidden>%3</ol>",
		Экран.Атрибут("aria-label", Подпись), ПризнакПолосы(), СтрСоединить(Пункты, ""));

КонецФункции

// Панель шага — нативная раскрывашка: без скрипта шаги открываются и закрываются сами,
// и форма видна целиком. Имя группы называет место шага («Шаг 2 из 3: Участники»): на него
// скрипт ставит фокус, когда меняет шаг, и скринридер слышит, куда человек пришёл.
Функция Панель(Знач Шаг, Знач Номер, Знач Всего, Знач Открыта)

	Имя = Тексты.Шаблон("steps.progress", Число_(Номер), Число_(Всего), Шаг.Подпись);

	Возврат СтрШаблон("<details%1 %2%3%4><summary class=""panel__head steps__head"">"
		+ "<span class=""steps__mark"" aria-hidden=""true""><span class=""steps__num"">%5</span></span>"
		+ "<span class=""steps__title"">%6</span></summary><div class=""panel__body"">%7</div></details>",
		Шаг.Атрибуты, ПризнакПанели(), Экран.Атрибут("aria-label", Имя),
		?(Открыта, " open", ""), Число_(Номер), Экран.Экранировать(Шаг.Подпись), Шаг.Тело);

КонецФункции

// Ряд кнопок под панелями. Отправка видна и без скрипта — форма уходит целиком; «Назад»
// и «Дальше» без скрипта не нужны и печатаются hidden. Обёртка несёт признак, потому что
// кнопка — компонент кита и своих data-* не печатает.
Функция Кнопки(Знач Отправка, Знач Правка)

	Части = Новый Массив();
	Части.Добавить("<div class=""steps__nav"">");

	Если НЕ Правка Тогда
		Части.Добавить(Обёртка("steps__act steps__act--back", ПризнакНазад(), Истина,
			Новый Структура("Подпись, Вариант, Тип, Иконка",
				Тексты.Текст("steps.back"), "ссылка", "обычная", "влево")));
		Части.Добавить(Обёртка("steps__act", ПризнакДальше(), Истина,
			Новый Структура("Подпись, Вариант, Тип", Тексты.Текст("steps.next"), "основная", "обычная")));
	КонецЕсли;

	Части.Добавить(Обёртка("steps__act", ПризнакОтправки(), Ложь, МодельОтправки(Отправка)));
	Части.Добавить("</div>");

	Возврат СтрСоединить(Части, "");

КонецФункции

Функция Обёртка(Знач Класс, Знач Признак, Знач Скрыта, Знач МодельКнопки)

	Возврат СтрШаблон("<span class=""%1"" %2%3>%4</span>", Класс, Признак,
		?(Скрыта, " hidden", ""), Набор.Кнопка().Отрисовать(МодельКнопки));

КонецФункции

// Отправка без своей модели — основная кнопка с текстом словаря; подпись строкой
// становится основной кнопкой, модель узла кнопки печатается как есть.
Функция МодельОтправки(Знач Отправка)

	Если ТипЗнч(Отправка) = Тип("Структура") Тогда
		Возврат Отправка;
	КонецЕсли;

	Подпись = Строка(?(Отправка = Неопределено, "", Отправка));
	Если НЕ ЗначениеЗаполнено(Подпись) Тогда
		Подпись = Тексты.Текст("steps.submit");
	КонецЕсли;
	Возврат Новый Структура("Подпись, Вариант", Подпись, "основная");

КонецФункции

Функция Число_(Знач Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "НаборКомпонентов") _Набор,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Экран = _Экран;
	Набор = _Набор;
	Тексты = _Тексты;

КонецПроцедуры
