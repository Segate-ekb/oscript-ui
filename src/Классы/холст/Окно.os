// Окно — желудь UI-кита: рамка модального окна <dialog>. Печатает узел Кит.Окно (заголовок,
// лид, тело, действия) и прежнее окно объявленной формы — одной рамкой, поэтому вид, движение
// и лист телефона у них общие. Дерева здесь нет: тело и действия приходят напечатанными
// из РазметкаЭлементов, как тело секции — в каркас настроек.
//
// Открытие, закрытие по Esc и крестиком, удержание фокуса и возврат его на открывашку —
// работа движка браузера (команды show-modal и close). Скрипт кита только доучивает
// движок постарше этим командам и закрывает окно по успеху тихой отправки.

Перем Экран;   // ЭкранированиеHTML
Перем Набор;   // НаборКомпонентов
Перем Тексты;  // ТекстыИнтерфейса

#Область ПубличныйИнтерфейс

// Печатает окно со слотами: шапка (заголовок и крестик), лид, тело, действия. Окно
// называет себя заголовком (aria-labelledby), лид — его описание (aria-describedby).
// Словом Форма окно целиком становится формой: кнопки действий отправляют её сами.
//
// Параметры:
//  Модель - Структура - Ид (обязателен: на него ссылается открывашка), Заголовок
//           (обязателен: им окно называет себя скринридеру), Класс (CSS-класс вида),
//           Лид, Открыто (печатать открытым — так сервер возвращает окно по адресу
//           с ?окно= и отбитую форму), Тело и Действия (ДОВЕРЕННЫЙ HTML), Признаки
//           (ДОВЕРЕННАЯ строка data-атрибутов окна), Форма (Структура: Действие, Поле
//           токена — ДОВЕРЕННЫЙ HTML, Файлы, Признаки — data-атрибуты формы; Неопределено —
//           окно без своей формы). Дев-сборка 8: АдресЗакрытия — адрес страницы без окна:
//           крестик — ссылка туда, а первым в действиях — «Отмена» (у окна-формы) или
//           «Закрыть» ссылкой; со скриптом они закрывают окно на месте (data-closes).
//           СвояОтмена (Булево) — отмену печатают действия сами (подтверждение, шаги).
//
// Возвращаемое значение:
//  Строка - HTML <dialog>; закрытое окно места на экране не занимает.
//
Функция Отрисовать(Знач Модель) Экспорт

	Ид = Строка(Модель.Ид);
	Заголовок = Строка(Модель.Заголовок);
	ПроверитьЗаголовок(Заголовок);

	Лид = ПолеМодели(Модель, "Лид");
	Тело = ПолеМодели(Модель, "Тело");
	Действия = ПолеМодели(Модель, "Действия");

	// --- адрес закрытия (дев-сборка 8): без скрипта окно закрывает переход на страницу без окна
	АдресЗакрытия = ПолеМодели(Модель, "АдресЗакрытия");
	Форма = Неопределено;
	Модель.Свойство("Форма", Форма);
	Если ЗначениеЗаполнено(АдресЗакрытия) И ПолеМодели(Модель, "СвояОтмена") <> Истина Тогда
		Действия = КнопкаЗакрытия(Ид, АдресЗакрытия,
			Тексты.Текст(?(Форма = Неопределено, "window.dismiss", "window.cancel"))) + Действия;
	КонецЕсли;

	Внутри = СтрШаблон("<div class=""modal__head""><h2 class=""modal__title"" id=""%1"">%2</h2>%3</div>",
			Экран.Экранировать(ИдЗаголовка(Ид)), Экран.Экранировать(Заголовок), Крестик(Ид, АдресЗакрытия))
		+ ?(ЗначениеЗаполнено(Лид), СтрШаблон("<p class=""modal__lead"" id=""%1"">%2</p>",
			Экран.Экранировать(ИдЛида(Ид)), Экран.Экранировать(Лид)), "")
		+ ?(ЗначениеЗаполнено(Тело), СтрШаблон("<div class=""modal__body"">%1</div>", Тело), "")
		+ ?(ЗначениеЗаполнено(Действия), СтрШаблон("<div class=""modal__actions"">%1</div>", Действия), "");

	Возврат СтрШаблон("<dialog%1%2%3%4%5%6>%7</dialog>",
		Экран.Атрибут("class", Строка(Модель.Класс)),
		Экран.Атрибут("id", Ид),
		Экран.Атрибут("aria-labelledby", ИдЗаголовка(Ид)),
		?(ЗначениеЗаполнено(Лид), Экран.Атрибут("aria-describedby", ИдЛида(Ид)), ""),
		Экран.БулевАтрибут("open", ПолеМодели(Модель, "Открыто") = Истина),
		ПолеМодели(Модель, "Признаки"),
		Коробка(Внутри, Форма));

КонецФункции

// Прежняя рамка окна объявленной формы — та, что печаталась до узла Кит.Окно, байт в байт:
// окно названо ярлыком (aria-label), заголовок и пояснение — компонентом «Заголовок
// страницы», форма с подвалом — внутри коробки.
//
// Параметры:
//  Ид        - Строка - идентификатор окна.
//  Внутри    - Строка - ДОВЕРЕННЫЙ HTML формы окна.
//  Заголовок - Строка - заголовок окна.
//  Лид       - Строка - пояснение под заголовком.
//  Открыто   - Булево - печатать открытым.
//
// Возвращаемое значение:
//  Строка - HTML <dialog>.
//
Функция ОтрисоватьПрежнее(Знач Ид, Знач Внутри, Знач Заголовок, Знач Лид, Знач Открыто) Экспорт

	Возврат СтрШаблон("<dialog class=""modal""%1%2%3><div class=""modal__box"">%4%5</div></dialog>",
		Экран.Атрибут("id", Ид),
		Экран.Атрибут("aria-label", Заголовок),
		Экран.БулевАтрибут("open", Открыто = Истина),
		Набор.ЗаголовокСтраницы().Отрисовать(
			Новый Структура("Заголовок, Уровень, Пояснение", Заголовок, 2, Лид)),
		Внутри);

КонецФункции

// Идентификатор заголовка окна — на него ссылается aria-labelledby. Считается одним местом:
// ссылка в пустоту оставила бы окно безымянным.
//
// Параметры:
//  Ид - Строка - идентификатор окна.
//
// Возвращаемое значение:
//  Строка
//
Функция ИдЗаголовка(Знач Ид) Экспорт
	Возврат Ид + "-title";
КонецФункции

// Ссылка-кнопка, которая закрывает окно (дев-сборка 8): без скрипта — переход на страницу
// без окна, со скриптом — закрытие на месте (data-closes). Ею же печатают отмену
// подтверждение и шаги в окне.
//
// Параметры:
//  Ид - Строка - идентификатор окна.
//  Адрес - Строка - адрес страницы без окна.
//  Подпись - Строка - (необязательный) «Отмена» или «Закрыть»; пусто — словарь window.cancel.
//
// Возвращаемое значение:
//  Строка - HTML ссылки-кнопки.
//
Функция КнопкаЗакрытия(Знач Ид, Знач Адрес, Знач Подпись = "") Экспорт
	Возврат Набор.Кнопка().Отрисовать(Новый Структура("Подпись, Вариант, Адрес, Закрывает",
		?(ЗначениеЗаполнено(Подпись), Подпись, Тексты.Текст("window.cancel")), "вторичная", Адрес, Ид));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИдЛида(Знач Ид)
	Возврат Ид + "-lead";
КонецФункции

// Крестик — команда движка «закрыть»: Esc и щелчок по нему закрывают окно без скрипта
// там, где движок команды знает; движку постарше их доучивает скрипт кита. С адресом
// закрытия (дев-сборка 8) крестик — ссылка на страницу без окна: без скрипта он закрывает
// окно и там, где движок команды не знает, а скрипт закрывает окно на месте.
Функция Крестик(Знач Ид, Знач Адрес = "")

	Если ЗначениеЗаполнено(Адрес) Тогда
		Возврат Набор.Кнопка().Отрисовать(Новый Структура(
			"Подпись, Вариант, Иконка, ТолькоИконка, Адрес, Закрывает",
			Тексты.Текст("window.close"), "ссылка", "закрыть", Истина, Адрес, Ид));
	КонецЕсли;
	Возврат Набор.Кнопка().Отрисовать(Новый Структура(
		"Подпись, Вариант, Иконка, ТолькоИконка, Команда, Цель",
		Тексты.Текст("window.close"), "ссылка", "закрыть", Истина, "закрыть", Ид));

КонецФункции

// Окно-форма — коробка становится <form>: шапка, тело и действия внутри неё, и кнопка
// действий отправляет форму, не зная её якоря. Крестик — type="button", он её не шлёт.
Функция Коробка(Знач Внутри, Знач Форма)

	Если Форма = Неопределено Тогда
		Возврат СтрШаблон("<div class=""modal__box"">%1</div>", Внутри);
	КонецЕсли;

	Возврат СтрШаблон("<form method=""post"" action=""%1"" class=""modal__box""%2%3>%4%5</form>",
		Экран.Экранировать(Форма.Действие),
		?(Форма.Файлы = Истина, " enctype=""multipart/form-data""", ""),
		Строка(Форма.Признаки), Строка(Форма.ПолеТокена), Внутри);

КонецФункции

Функция ПолеМодели(Знач Модель, Знач Имя)

	Значение = "";
	Если НЕ Модель.Свойство(Имя, Значение) ИЛИ Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Значение;

КонецФункции

Процедура ПроверитьЗаголовок(Знач Заголовок)

	Если ЗначениеЗаполнено(СокрЛП(Заголовок)) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение "Окно: не задан заголовок. Им окно называет себя скринридеру"
		+ " (aria-labelledby), и безымянный диалог читается как «диалог» без единого слова"
		+ " о том, что в нём. Задайте его первым аргументом: Кит.Окно(""Новый проект"", …).";

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "НаборКомпонентов") _Набор,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Экран = _Экран;
	Набор = _Набор;
	Тексты = _Тексты;

КонецПроцедуры
