// Окно по адресу — желудь UI-кита: кнопка окна, которое не печатается заранее. У таблицы
// на сотню строк сотню окон правки в страницу не кладут: кнопка — ссылка на страницу
// с ?окно=…, где сервер печатает это окно открытым. Скрипт кита по нажатию берёт ту же
// страницу запросом в фоне, вынимает из неё окно, кладёт его в одну на страницу пустую
// оболочку <dialog> и открывает; без скрипта ссылка просто ведёт на страницу с окном.

Перем Экран;   // ЭкранированиеHTML
Перем Набор;   // НаборКомпонентов
Перем Тексты;  // ТекстыИнтерфейса

#Область ПубличныйИнтерфейс

// Печатает кнопку окна по адресу — ссылку-кнопку с признаком data-window-link.
//
// Параметры:
//  Модель - Структура - Адрес (обязателен: адрес своего приложения — страница, на которой
//           сервер печатает окно открытым), Подпись (обязательна), Вариант (как у кнопки,
//           по умолчанию «вторичная»), Размер, Иконка, ТолькоИконка, Подсказка.
//
// Возвращаемое значение:
//  Строка - HTML <a>.
//
Функция Отрисовать(Знач Модель) Экспорт

	Подпись = ПолеМодели(Модель, "Подпись");
	Адрес = ПолеМодели(Модель, "Адрес");
	Проверить(Подпись, Адрес);

	ТолькоИконка = ПолеМодели(Модель, "ТолькоИконка") = Истина;
	Подсказка = ПолеМодели(Модель, "Подсказка");
	Если НЕ ЗначениеЗаполнено(ПолеМодели(Модель, "Вариант")) Тогда
		Модель.Вставить("Вариант", "вторичная");
	КонецЕсли;

	Возврат СтрШаблон("<a href=""%1""%2%3%4 %5>%6%7</a>",
		Экран.Экранировать(Адрес),
		Экран.Атрибут("class", Набор.Кнопка().Классы(Модель)),
		Экран.Атрибут("title", ?(ЗначениеЗаполнено(Подсказка), Подсказка, ?(ТолькоИконка, Подпись, ""))),
		?(ТолькоИконка, Экран.Атрибут("aria-label", Подпись), ""),
		ПризнакСсылки(),
		Набор.Иконка().Отрисовать(ПолеМодели(Модель, "Иконка")),
		?(ТолькоИконка, "", СтрШаблон("<span>%1</span>", Экран.Экранировать(Подпись))));

КонецФункции

// Оболочка — одна на страницу пустая <dialog>, куда скрипт кладёт загруженное окно,
// и скрытый тост ошибки загрузки рядом с ней: разметку печатает сервер, скрипт её только
// показывает. Печатает её каркас страницы, если на странице есть кнопка окна по адресу.
//
// Возвращаемое значение:
//  Строка - HTML оболочки и тоста.
//
Функция Оболочка() Экспорт

	Возврат СтрШаблон("<dialog class=""modal"" id=""%1"" data-window-shell></dialog>"
		+ "<div class=""window-error"" data-window-error hidden>%2</div>",
		ИдОболочки(),
		Набор.Тост().Отрисовать(Новый Структура("Текст, Вид",
			Тексты.Текст("window.load.error"), "err")));

КонецФункции

// Признак кнопки окна по адресу: по нему скрипт находит кнопку, а каркас страницы,
// которому содержимое пришло строкой, — узнаёт, что оболочка нужна.
//
// Возвращаемое значение:
//  Строка - имя атрибута.
//
Функция ПризнакСсылки() Экспорт
	Возврат "data-window-link";
КонецФункции

// Идентификатор оболочки ПОСТОЯНЕН: ответ страницы обязан повторяться байт в байт,
// а оболочка на странице одна.
//
// Возвращаемое значение:
//  Строка
//
Функция ИдОболочки() Экспорт
	Возврат "okno-po-adresu";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолеМодели(Знач Модель, Знач Имя)

	Значение = "";
	Если НЕ Модель.Свойство(Имя, Значение) ИЛИ Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Окно грузится запросом своего приложения со всеми куками сессии: чужой адрес и схема
// сюда не годятся, и ссылка в никуда не печатается молча.
Процедура Проверить(Знач Подпись, Знач Адрес)

	Если НЕ ЗначениеЗаполнено(Подпись) Тогда
		ВызватьИсключение "Окно по адресу: не задана Подпись — кнопка без надписи не читается"
			+ " ни глазом, ни скринридером. Кит.ОкноПоАдресу(Адрес, Подпись).";
	КонецЕсли;

	Если ЗначениеЗаполнено(Адрес) И Экран.URLБезопасенДляОтправкиФормы(Адрес) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Окно по адресу («%1»): адрес «%2» — не адрес своего"
		+ " приложения. Окно берётся запросом с куками сессии, поэтому годится путь от корня"
		+ " (/…) или запрос (?окно=…) — страница, на которой сервер печатает окно открытым.",
		Подпись, Адрес);

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "НаборКомпонентов") _Набор,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты) Экспорт

	Экран = _Экран;
	Набор = _Набор;
	Тексты = _Тексты;

КонецПроцедуры
