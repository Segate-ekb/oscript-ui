// Кит — желудь UI-кита: фабрика элементов экрана. Экран берёт у кита холст, наполняет его
// вложенными элементами и печатает целиком; тегов и имён классов за этой границей нет.
//
// Язык узлов: позицией — то, без чего узел бессмыслен (текст заголовка, адрес ссылки,
// имя поля, вид ряда), дальше — до восьми детей позиционно (строка — текст, Неопределено
// пропускается), всё остальное — слова-методы узла цепочкой (ЭлементЭкрана).

Перем Печать;   // РазметкаЭлементов
Перем Набор;    // НаборКомпонентов
Перем Каркас;   // РендерерНастроек — имя скрытого поля CSRF, печать дома и секции
// --- шаги (выпуск 0.11, шаг 10) ---
Перем РисовательШагов; // Шаги — печать узла Кит.Шаги
Перем Реестры;  // Реестр — печать реестра и его записей (шаг 11)
Перем Окна;           // Окно — рамка модального окна
Перем Подтверждения;  // Подтверждение — окно необратимого действия
Перем ОкнаПоАдресу;   // ОкноПоАдресу — кнопка окна, которое грузится по адресу, и его оболочка
// --- сегменты и подсказка (выпуск 0.12) ---
Перем РисовательСегментов; // Сегменты — печать узла Кит.Сегменты
Перем Подсказки;           // Подсказка — значок «?» с поповером; им же поле печатает справку
// --- картинка и образец (выпуск 0.12) ---
Перем СлотыКартинки;  // СлотКартинки — печать узла Кит.СлотКартинки (шаг 16)
Перем Образцы;        // Образец — печать узла Кит.Образец (шаг 17)

#Область Документ

// Документ — корень страницы: объявление типа, <html> и всё, что внутри. В него кладут
// голову и тело, больше ничего.
//
// Параметры:
//  Язык  - Строка - код языка страницы для атрибута lang.
//  Тема  - Строка - значение атрибута data-theme; ставится ДО листа стилей, иначе
//          страница мигнёт чужими цветами.
//  Р1…Р8 - ЭлементЭкрана - (необязательные) голова и тело.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Документ(Знач Язык, Знач Тема, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "документ", "",
		Новый Структура("Язык, Тема", Строка(?(Язык = Неопределено, "", Язык)),
			Строка(?(Тема = Неопределено, "", Тема)))).Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Голова документа — то, чего человек не видит: заглавие вкладки, объявления и ресурсы.
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана - (необязательные) титул, мета, ресурсы, стили, скрипты.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Голова(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Узел("голова", "Голова", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Заглавие вкладки браузера.
//
// Параметры:
//  Значение - Строка - текст заглавия (экранируется).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Титул(Знач Значение) Экспорт

	Результат = Новый ЭлементЭкрана(Печать, "титул");
	Результат.Добавить(Текст(Значение));
	Возврат Результат;

КонецФункции

// Объявление «имя — содержание» в голове документа.
//
// Параметры:
//  Имя        - Строка - имя объявления (viewport, referrer, color-scheme).
//  Содержание - Строка - его значение.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Мета(Знач Имя, Знач Содержание) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "мета", "",
		Новый Структура("Имя, Свойство, Содержание, Кодировка",
			Строка(?(Имя = Неопределено, "", Имя)), "",
			Строка(?(Содержание = Неопределено, "", Содержание)), ""));

КонецФункции

// Объявление «свойство — содержание» в голове документа: свойства карточки, которую
// чужой сервис строит по ссылке на страницу (og:title, og:image и подобные). Объявление
// без свойства не печатается.
//
// Параметры:
//  Свойство   - Строка - имя свойства (атрибут property).
//  Содержание - Строка - его значение.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция МетаСвойство(Знач Свойство, Знач Содержание) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "мета", "",
		Новый Структура("Имя, Свойство, Содержание, Кодировка", "",
			Строка(?(Свойство = Неопределено, "", Свойство)),
			Строка(?(Содержание = Неопределено, "", Содержание)), ""));

КонецФункции

// Объявление кодировки документа. Стоит первым в голове: до него браузер читает байты
// вслепую.
//
// Параметры:
//  Имя - Строка - имя кодировки.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Кодировка(Знач Имя) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "мета", "",
		Новый Структура("Имя, Свойство, Содержание, Кодировка", "", "", "",
			Строка(?(Имя = Неопределено, "", Имя))));

КонецФункции

// Ссылка на внешний ресурс: лист стилей, иконка сайта, иконка домашнего экрана.
// Ресурс без адреса не печатается вовсе.
//
// Параметры:
//  Отношение - Строка - чем ресурс приходится странице (stylesheet, icon).
//  Адрес     - Строка - адрес ресурса.
//  Тип       - Строка - (необязательный) тип содержимого ресурса.
//  Размеры   - Строка - (необязательный) размеры картинки, которые несёт ресурс.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Ресурс(Знач Отношение, Знач Адрес, Знач Тип = "", Знач Размеры = "") Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "ресурс", "",
		Новый Структура("Отношение, Адрес, Тип, Размеры",
			Строка(?(Отношение = Неопределено, "", Отношение)),
			Строка(?(Адрес = Неопределено, "", Адрес)),
			Строка(?(Тип = Неопределено, "", Тип)),
			Строка(?(Размеры = Неопределено, "", Размеры))));

КонецФункции

// Правила оформления прямо в голове документа — то, что обязано приехать вместе
// с разметкой, а не отдельным запросом.
//
// Параметры:
//  Имя     - Строка - имя блока правил (атрибут id).
//  Правила - Строка - ДОВЕРЕННЫЙ CSS: внутри <style> экранирование бесполезно,
//            значение обязан провалидировать тот, кто его собрал.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Стиль(Знач Имя, Знач Правила) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "стиль", "",
		Новый Структура("Имя, Правила", Строка(?(Имя = Неопределено, "", Имя)),
			Строка(?(Правила = Неопределено, "", Правила))));

КонецФункции

// Скрипт страницы. Всегда отложенный: разбор разметки он не останавливает.
//
// Параметры:
//  Адрес - Строка - адрес скрипта; пустой не печатается вовсе.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Скрипт(Знач Адрес) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "скрипт", "",
		Новый Структура("Адрес", Строка(?(Адрес = Неопределено, "", Адрес))));

КонецФункции

// Тело документа — всё, что человек видит.
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) дети узла; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Тело(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Узел("тело", "Тело", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Шапка — верхняя полоса страницы: знак, навигация, учётка. Вид словом: «страницы»
// (липкая полоса вверху) | «меню» (полоса с единым меню) | "" (без оформления).
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) дети узла; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Шапка(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Узел("шапка", "Шапка", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Основное — то, ради чего страницу открыли. На странице оно одно. Вид словом: «полоса»
// (колонка содержимого по центру) | "" (без оформления).
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) дети узла; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Основное(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Узел("основное", "Основное", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Подвал — нижняя полоса страницы. Вид словом: «страницы» | "" (без оформления).
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) дети узла; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Подвал(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Узел("подвал", "Подвал", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Навигация — набор ходов, который скринридер объявляет отдельным ориентиром. Вид словом:
// «верхняя» (ряд ходов в шапке страницы) | "" (без оформления).
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) дети узла; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Навигация(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Узел("навигация", "Навигация", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

#КонецОбласти

#Область Раскладка

// Холст — корень куска экрана: его наполняют и печатают целиком. Своего тега не печатает:
// обёртка, которой на экране никто не просил, ломает вертикальный ритм соседей. Место,
// где показывать нечего, — это Ничего(), а не холст, который забыли наполнить.
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) дети узла; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Холст(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "холст").Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Ничего — место экрана, где показывать нечего: всюду, где принимают холст, но не в обход
// правил вложения — внутрь записи по-прежнему кладут ячейку, внутрь таблицы запись,
// внутрь списка пункт. Узел тот же, что холст, и печатается он так же — пустой строкой;
// отличается тем, что читатель «Возврат Кит.Ничего();» видит отсутствие элемента сразу,
// а не ищет по функции, чем этот холст наполнили. Наполнять его незачем: собираете кусок
// экрана — берите Холст(). Именем «пусто» звать нельзя: у ПустоеСостояние, примечания
// вида «пусто» и Таблица.Пусто() смысл обратный — они человеку что-то ПОКАЗЫВАЮТ.
//
// Возвращаемое значение:
//  ЭлементЭкрана - печатается пустой строкой.
//
Функция Ничего() Экспорт
	Возврат Холст();
КонецФункции

// Область — коробка на экране: свой блок, свой вид, и на неё можно повесить признак
// и роль. Тем и отличается от холста, что у неё есть тег. Вид словом: «проза» (чужой
// документ, набранный типографски) | «карточки» (колонка карточек) | «шапка» | «плашки»
// | «действия» (части карточки объекта) | «отбор» (полоса применённых плашек над списком)
// | «вставка» (врезка пунктиром внутри формы: шаг, а не своя секция) | «студия» (работа
// слева, образец справа) | «работа» / «образец» (колонки студии) | «поле» (рамка поля
// с меткой и подсказкой вокруг своего управления) | «полоса» (колонка содержимого
// по центру страницы) | "" (просто блок).
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) дети узла; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Область(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Узел("область", "Область", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Ряд — элементы в строку с переносом. Вид ряда — его смысл, поэтому он первым аргументом.
//
// Параметры:
//  Вид   - Строка - «выбор» (ряд взаимоисключающих кнопок) | «признаки» (ряд плашек)
//          | «свёрнутые» (ряд плашек, у которого хвост убран под раскрывашку)
//          | «справа» (ряд, прижатый к правому краю) | «строкой» (значок и значение
//          в одну строку, без переноса) | «действия» (кнопки и формы-кнопки одним рядом
//          с переносом: действия записи в одном месте).
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) дети узла; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Ряд(Знач Вид, Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "ряд", Вид).Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Раскрывашка — свёрнутая строка отвечает «что это», развёрнутая отдаёт содержимое.
// Шапка наполняется словом Шапка(д…), тело — детьми. Вид словом: «простая» (без единого
// класса) | «врезка» (карточка в потоке списка) | «подробность» (мелкая строка «подробнее»
// в ячейке) | «хвост» (свёрнутый остаток ряда плашек) | "" (панель).
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) тело раскрывашки; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Раскрывашка(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Узел("раскрывашка", "Раскрывашка", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Статья — самостоятельный кусок страницы: его можно вынуть из списка и он останется
// понятным. Тем и отличается от области, что это лендмарк, а не просто блок. Вид словом:
// «карточка» (карточка объекта в списке) | "" (без оформления).
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) дети узла; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Статья(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Узел("статья", "Статья", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Список — перечисление равнозначного; в него кладут пункты. Вид словом: «сноска»
// (мелкий приглушённый список под полем) | "" (обычный).
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана - (необязательные) пункты.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Список(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Узел("список", "Список", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Пункт списка — холст: пункт бывает и со ссылкой, и с машинным значением внутри.
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) дети узла; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Пункт(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Узел("пункт", "Пункт", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Свойства объекта — перечисление пар «имя — значение»; в него кладут свойства.
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана - (необязательные) свойства.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Свойства(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Узел("свойства", "Свойства", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Свойство — пара «имя — значение»: имя приходит подписью, значение собирается детьми.
//
// Параметры:
//  Имя   - Строка - имя свойства (экранируется).
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) значение; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Свойство(Знач Имя, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "свойство").Подпись(Имя)
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Группа полей — то, что браузер и скринридер считают одним целым. Вид словом: «набор»
// (группа-переключатель, которую можно отключить и спрятать целиком) | «простая» (без
// оформления: группа существует, чтобы отключать и прятать поля вместе) | «раздел» (часть
// длинной формы: подпись заголовком, раздел от раздела — чертой, вложенные группы без
// рамок) | "" (обычная).
//
// Параметры:
//  Подпись - Строка - видимая подпись группы; пустая — группа без подписи.
//  Р1…Р8   - ЭлементЭкрана, Строка - (необязательные) поля группы; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Группа(Знач Подпись = "", Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	ОтвергнутьВидНаМестеРебёнка("группа", "Группа", Р1, Р2);
	Возврат Новый ЭлементЭкрана(Печать, "группа").Подпись(Подпись)
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

#КонецОбласти

#Область Формы

// Форма, которую отправляет вошедший: POST со скрытым полем CSRF первым. Токен задаётся
// словом Токен(…) у формы или у предка (дом настроек, холст экрана); без токена форма
// не печатается — она выглядит рабочей, а получает 403. Относительный адрес дописывается
// к адресу контекста: "" — адрес раздела дома вокруг, «revoke» — раздел/revoke, «/x» —
// абсолютный. Вид словом: «столбик» | «строкой» | «меню» (форма внутри пункта меню)
// | «переключатель» | "" (без раскладки).
//
// Параметры:
//  Действие - Строка - URL, куда уходит POST.
//  Р1…Р8    - ЭлементЭкрана - (необязательные) поля и кнопки формы. Строка в форме не
//             принимается: токен — словом Токен, текст — узлом Кит.Текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Форма(Знач Действие, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Результат = УзелФормы("форма", Действие, Новый Структура("РисовательТокена, ИмяТокена",
		Набор.СкрытоеПоле(), Каркас.ИмяПоляCSRF()));
	ОтвергнутьВидНаМестеРебёнка("форма", "Форма", Р1, Р2);
	Возврат Результат.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Форма посетителя, у которого сессии ещё нет: вход, регистрация, запрос ссылки на смену
// пароля, установка пароля по одноразовой ссылке. Токена не несёт, потому что его неоткуда
// взять: CSRF-токен живёт В СЕССИИ, и там, где сессии нет, сервер его и не спрашивает.
// Взятая по ошибке на форме вошедшего, она получит от сервера 403 на первой же отправке.
//
// Параметры:
//  Действие - Строка - URL, куда уходит POST.
//  Р1…Р8    - ЭлементЭкрана - (необязательные) поля и кнопки формы.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ФормаБезСессии(Знач Действие, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	ОтвергнутьВидНаМестеРебёнка("форма-без-сессии", "ФормаБезСессии", Р1, Р2);
	Возврат УзелФормы("форма-без-сессии", Действие).Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Форма отбора: GET, который на сервере ничего не меняет, а значит защищать в нём нечего.
// Отправленный отбор виден в адресе и повторяем ссылкой — это и есть его смысл.
//
// Параметры:
//  Действие - Строка - URL, куда уходит GET.
//  Р1…Р8    - ЭлементЭкрана - (необязательные) поля и кнопки формы.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ФормаОтбора(Знач Действие, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	ОтвергнутьВидНаМестеРебёнка("форма-отбора", "ФормаОтбора", Р1, Р2);
	Возврат УзелФормы("форма-отбора", Действие).Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Форма, у отправителя которой сессия ЕСТЬ, а сервер токена не спрашивает: цена подделки
// такого запроса — неудобство, а не ущерб (переключить оформление, выйти). Отличается
// от ФормаБезСессии тем, ПОЧЕМУ токена нет: там его неоткуда взять, здесь он не нужен.
// Взятая на форме, которая меняет что-то по-настоящему, она получит от сервера 403
// на первой же отправке: границей безопасности остаётся серверная проверка.
//
// Параметры:
//  Действие - Строка - URL, куда уходит POST.
//  Р1…Р8    - ЭлементЭкрана - (необязательные) поля и кнопки формы.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ФормаБезТокена(Знач Действие, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	ОтвергнутьВидНаМестеРебёнка("форма-без-токена", "ФормаБезТокена", Р1, Р2);
	Возврат УзелФормы("форма-без-токена", Действие).Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

#КонецОбласти

#Область Таблица

// Таблица — раскладка списка. Из данных, как в 1С: таблица значений даёт колонки
// (заголовок колонки, по умолчанию имя) и записи (её строки, ячейка — свойство строки
// по имени колонки); массив структур или соответствий даёт записи, а колонки объявляются
// словом Колонка(Ключ, Заголовок). Значение ячейки: строка — текст, узел — узел (несколько
// узлов кладут Кит.Холст), число — без разделителя групп, Неопределено и "" — пустая
// ячейка; дату и Булево форматирует вызывающий. Без данных таблица собирается руками
// из Кит.Колонка и Кит.Запись. Слова: Вид («карточками» — на узком экране запись
// становится карточкой, а ячейка несёт подпись своей колонки), Колонка, Пусто(д…),
// Разворот(ИмяКолонки).
//
// Параметры:
//  Р1    - ТаблицаЗначений, Массив, ЭлементЭкрана, Неопределено - данные таблицы либо
//          первый ребёнок ручной сборки.
//  Р2…Р8 - ЭлементЭкрана - (необязательные) колонки и записи ручной сборки.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Таблица(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Если ТипЗнч(Р1) = Тип("ТаблицаЗначений") ИЛИ ТипЗнч(Р1) = Тип("Массив") Тогда
		Если Р2 <> Неопределено Тогда
			ВызватьИсключение "Кит: таблица из данных собирает записи сама — второй аргумент"
				+ " ей не нужен. Колонки объявляйте словом .Колонка(Ключ, Заголовок).";
		КонецЕсли;
		Возврат Новый ЭлементЭкрана(Печать, "таблица", "",
			Новый Структура("Данные, Разворот", Р1, ""));
	КонецЕсли;

	Возврат Узел("таблица", "Таблица", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Колонка — заголовок столбца. Холст: заголовок бывает не только текстом. Вид словом:
// «узкая» (столбец сжимается по содержимому и не переносится) | "" (обычная).
//
// Параметры:
//  Подпись    - Строка - текст заголовка; пустой оставляет колонку без подписи.
//  Устаревший - Неопределено - не задаётся: вид колонки теперь словом Вид(…).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Колонка(Знач Подпись = "", Знач Устаревший = Неопределено) Экспорт

	ОтвергнутьВторойВид("Колонка", Устаревший);
	Результат = Новый ЭлементЭкрана(Печать, "колонка");
	Если ЗначениеЗаполнено(Подпись) Тогда
		Результат.Добавить(Текст(Подпись));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Запись — строка таблицы: в неё кладут ячейки. Развёрнутая подробность записи
// наполняется словом Разворот(д…) и печатается строкой под ней во всю ширину. Вид
// словом: «выделенная» (строка залита цветом: одна запись списка отвечает на вопрос,
// ради которого список открыли) | "" (обычная).
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана - (необязательные) ячейки.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Запись(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Узел("запись", "Запись", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Ячейка — холст внутри записи: в неё кладут любые элементы, а не готовую разметку. Вид
// словом: «величина» (число с единицей: не переносится, приглушено) | «столбиком»
// (двухэтажная ячейка: строка значения и приписка под ней) | «узкая» (ячейка сжимается
// по содержимому: значок, галочка, счётчик) | "" (обычная).
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) содержимое; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Ячейка(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Узел("ячейка", "Ячейка", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

#КонецОбласти

#Область Содержимое

// Заголовок первого-шестого уровня. Уровень — не оформление, а место в оглавлении
// страницы, поэтому он задаётся числом, а не видом. Вид словом: «имя» (имя объекта в его
// карточке) | "" (без оформления).
//
// Параметры:
//  Уровень - Число - от 1 до 6.
//  Р1…Р8   - ЭлементЭкрана, Строка - (необязательные) текст заголовка; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Заголовок(Знач Уровень, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	ОтвергнутьВидНаМестеРебёнка("заголовок", "Заголовок", Р1, Р2);
	Возврат Новый ЭлементЭкрана(Печать, "заголовок", "",
		Новый Структура("Уровень", ПроверенныйУровень(Уровень)))
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Надпись — кусок строки со своей ролью в ней. Вид словом: «название» | «пояснение»
// | «сноска» | «приглушённая» | «ключ» (имя настройки) | «приписка» (мелкая строка под
// значением) | «заголовок» и «лид» (две первые строки врезки) | «метка» (подпись поля,
// собранного вручную) | «учётка» (имя вошедшего в шапке страницы) | "" (без оформления).
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) содержимое; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Надпись(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Узел("надпись", "Надпись", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Текстовый узел. Экранируется по своей природе: чужой текст разметкой не станет,
// потому что этот узел иначе печатать не умеет.
//
// Параметры:
//  Значение - Произвольный - текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Текст(Знач Значение) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "текст", "",
		Новый Структура("Текст", Строка(?(Значение = Неопределено, "", Значение))));

КонецФункции

// Машинное значение моноширинным шрифтом: имя, адрес, ключ. Вид словом: «блочный»
// (образец в несколько строк, переносы сохраняются) | «приглушённый» (значение, которое
// не спорит с соседним текстом) | "" (значение внутри строки текста).
//
// Параметры:
//  Значение   - Произвольный - текст (экранируется).
//  Устаревший - Неопределено - не задаётся: вид кода теперь словом Вид(…).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Код(Знач Значение, Знач Устаревший = Неопределено) Экспорт

	ОтвергнутьВторойВид("Код", Устаревший);
	Результат = Новый ЭлементЭкрана(Печать, "код");
	Результат.Добавить(Текст(Значение));
	Возврат Результат;

КонецФункции

// Ссылка. Холст: внутрь кладут текст, машинное значение или картинку. Адрес недопустимой
// схемы ссылкой не станет — содержимое останется видимым, кликабельным оно не будет.
// Вид словом: «пилюля» (ссылка-пилюля в ряду взаимоисключающих) | «пилюля-текущая» (она
// же, выбранная) | «знак» (ход на главную со знаком инсталляции) | «шапка» (ход в ряду
// шапки страницы) | "" (обычная).
//
// Параметры:
//  Адрес - Строка - URL.
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) содержимое; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Ссылка(Знач Адрес, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	ОтвергнутьВидНаМестеРебёнка("ссылка", "Ссылка", Р1, Р2);
	Возврат Новый ЭлементЭкрана(Печать, "ссылка", "",
		Новый Структура("Адрес", Строка(?(Адрес = Неопределено, "", Адрес))))
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Картинка. Пустой адрес не даёт битого изображения — узел печатается пустой строкой.
// Подпись узла становится alt, подсказка — title: картинка без подписи декоративна.
// Вид словом: «значок» (внешняя картинка размером со значок) | «значок-малый» (тот же
// значок при строке текста) | «превью» (показ загруженного изображения) | «знак» (знак
// инсталляции в шапке) | "" (без оформления).
//
// Параметры:
//  Адрес      - Строка - адрес картинки.
//  Устаревший - Неопределено - не задаётся: вид картинки теперь словом Вид(…).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Картинка(Знач Адрес, Знач Устаревший = Неопределено) Экспорт

	ОтвергнутьВторойВид("Картинка", Устаревший);
	Возврат Новый ЭлементЭкрана(Печать, "картинка", "",
		Новый Структура("Адрес", Строка(?(Адрес = Неопределено, "", Адрес))));

КонецФункции

// Примечание мелким шрифтом. Холст: примечание бывает и со ссылкой, и с машинным
// значением внутри. Без содержимого не печатается вовсе. Вид словом: «описание»
// (описание в карточке объекта) | «источник» (откуда взято значение) | «пусто» (список
// ничего не нашёл) | "" (приглушённый абзац).
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) содержимое; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Примечание(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	// у прежнего Примечание(Текст, Вид) вид стоял вторым
	Если ТипЗнч(Р1) = Тип("Строка") И Р3 = Неопределено Тогда
		ОтвергнутьВидНаМестеРебёнка("примечание", "Примечание", Р2, Р3);
	КонецЕсли;
	Возврат Узел("примечание", "Примечание", Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Шаблон — текст с местами %1…%N, которые занимают дети узла в порядке добавления.
// Текст экранируется, дети печатаются разметкой: так фраза остаётся цельной строкой
// для перевода, а вставки в неё собираются деревом.
//
// Параметры:
//  Образец - Строка - текст с местами %1…%N.
//  Р1…Р8   - ЭлементЭкрана, Строка - (необязательные) вставки по порядку мест.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Шаблон(Знач Образец, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "шаблон", "",
		Новый Структура("Образец", Строка(?(Образец = Неопределено, "", Образец))))
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// ⚠ Костыль перехода: готовый кусок разметки, собранный не деревом. Существует ради того,
// чтобы переводить экраны по одному, и на виду у ревью: узел ничего не экранирует.
//
// Параметры:
//  Разметка - Строка - ДОВЕРЕННЫЙ HTML: экранированием занят тот, кто его собрал.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Готовое(Знач Разметка) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "готовое", "",
		Новый Структура("Разметка", Строка(?(Разметка = Неопределено, "", Разметка))));

КонецФункции

#КонецОбласти

#Область Компоненты

// Кнопка формы или ссылка-кнопка. Слова: Основная, Вторичная, Опасная, Ссылкой, Малая,
// Большая, Обычная, Иконка, ТолькоИконка, Адрес, Имя(Имя, Значение), БезВалидации,
// АдресОтправки, ВНовойВкладке, ВФорме(Якорь), Заблокирована, Занята, Подсказка,
// ВоВсюШирину, Текущая, Команда(Команда, Цель), Открывает(Ид), Счётчик(Число, Подпись),
// ЗнакРаскрытия, Картинка.
//
// Параметры:
//  Модель - Строка, Структура - подпись кнопки; Структура — прежний вид модели
//           компонента «Кнопка».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Кнопка(Знач Модель) Экспорт
	Возврат КомпонентСловами("кнопка", Набор.Кнопка(), МодельИз(Модель, "Подпись"));
КонецФункции

// Плашка — короткий признак: состояние, тип, источник. Содержимое можно собрать узлами:
// они печатаются ВМЕСТО значка и текста модели. Слова: Вид, Адрес, Иконка, Подсказка.
//
// Параметры:
//  Модель - Строка, ЭлементЭкрана, Структура, Неопределено - текст плашки либо первый
//           узел её содержимого; Структура — прежний вид модели; Неопределено — плашки
//           нет, узел печатается пустой строкой.
//  Р2…Р8  - ЭлементЭкрана, Строка - (необязательные) ещё узлы содержимого.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Плашка(Знач Модель = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	ЕстьДети = Р2 <> Неопределено ИЛИ ТипЗнч(Модель) = Тип("ЭлементЭкрана");

	// плашки нет вовсе — узел печатается пустой строкой и детей не ждёт
	Если Модель = Неопределено И НЕ ЕстьДети Тогда
		Возврат Компонент("плашка", "");
	КонецЕсли;

	Если ЕстьДети И ТипЗнч(Модель) <> Тип("Структура") Тогда
		Возврат КомпонентСловами("плашка", Набор.Тег(), Новый Структура(), "Внутри")
			.Наполнить(Модель, Р2, Р3, Р4, Р5, Р6, Р7, Р8);
	КонецЕсли;

	Возврат КомпонентСловами("плашка", Набор.Тег(), МодельИз(Модель, "Текст"), "Внутри")
		.Наполнить(Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Поле ввода со своей меткой, подсказкой и отказом. Тип ввода — словом ТипЗначения(Тип(…)
// | ОписаниеТипов | строка) либо выводится из Значения. Слова: Метка, ТипЗначения,
// Значение, Подсказка, Пример (плейсхолдер), Автозаполнение, Ошибка, Обязательное,
// ТолькоЧтение, Заблокировано, Отмечено, Вариант(Значение, Подпись), Ид, Многострочное,
// Секрет, Файл, Справка(Текст) — длинное пояснение значком «?» с поповером рядом с подписью
// (короткое остаётся словом Подсказка строкой под полем); поле-список — Список(), поле цвета —
// Цвет() и Образец(Цвет, Имя); проверка до отправки (выпуск 0.12) — Пределы(Мин, Макс),
// Длина(Мин, Макс), Шаблон(Образец), ПроверкаНаСервере(Адрес), ПроверкаДоОтправки.
//
// Параметры:
//  Имя   - Строка, Структура - имя поля (атрибут name); Структура — прежний вид модели
//          компонента «Поле».
//  Метка - Строка - (необязательный) подпись поля для человека.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Поле(Знач Имя, Знач Метка = "") Экспорт

	Если ТипЗнч(Имя) = Тип("Структура") Тогда
		Результат = КомпонентСловами("поле", Набор.Поле(), Имя);
		Результат.Свойства().Вставить("ТипЗадан", Имя.Свойство("Тип"));
		// --- сегменты и подсказка (выпуск 0.12): справке поля — имя кнопки «?» из словаря
		Результат.Свойства().Вставить("Справки", Подсказки);
		Возврат Результат;
	КонецЕсли;

	Результат = КомпонентСловами("поле", Набор.Поле(), Новый Структура("Имя, Метка",
		Строка(?(Имя = Неопределено, "", Имя)), Строка(?(Метка = Неопределено, "", Метка))));
	Результат.Свойства().Вставить("ТипЗадан", Ложь);
	// --- сегменты и подсказка (выпуск 0.12): справке поля — имя кнопки «?» из словаря
	Результат.Свойства().Вставить("Справки", Подсказки);
	Возврат Результат;

КонецФункции

// Скрытое поле формы.
//
// Параметры:
//  Имя      - Строка - имя поля.
//  Значение - Строка - значение.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция СкрытоеПоле(Знач Имя, Знач Значение) Экспорт

	Возврат Компонент("скрытое", Набор.СкрытоеПоле().Отрисовать(
		Новый Структура("Имя, Значение", Имя, Значение)));

КонецФункции

// Блок копируемой команды. Слова: Подпись (кнопки копирования), Пояснение, БезКопирования.
//
// Параметры:
//  Модель - Строка, Структура - текст команды; Структура — прежний вид модели.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция БлокКоманды(Знач Модель) Экспорт
	Возврат КомпонентСловами("команда", Набор.БлокКоманды(), МодельИз(Модель, "Команда"));
КонецФункции

// Карточка — рамка с заголовком; её тело — дети узла, действия — второй холст
// Действия(д…). Слова: Адрес, Описание, Иконка, Уровень, Якорь.
//
// Параметры:
//  Модель - Строка, Структура - заголовок карточки; Структура — прежний вид модели
//           без поля Тело.
//  Р1…Р8  - ЭлементЭкрана, Строка - (необязательные) тело карточки; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Карточка(Знач Модель, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат КомпонентСловами("карточка", Набор.Карточка(), МодельИз(Модель, "Заголовок"), "Тело")
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Опасная зона — необратимые действия; её тело — дети узла. Слова: Пояснение,
// Подтверждение(Имя, Образец, Метка, Подсказка), Кнопка(Подпись | узел кнопки).
//
// Параметры:
//  Модель - Строка, Структура - заголовок зоны; Структура — прежний вид модели без Тела.
//  Р1…Р8  - ЭлементЭкрана, Строка - (необязательные) тело над подтверждением.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ОпаснаяЗона(Знач Модель, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат КомпонентСловами("зона", Набор.ОпаснаяЗона(), МодельИз(Модель, "Заголовок"), "Тело")
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Сетка равнозначных блоков: КАЖДЫЙ ребёнок узла становится своей ячейкой. Слова:
// Колонки, Плотная, Заголовок.
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Структура - (необязательные) ячейки сетки; Структура первым
//          аргументом — прежний вид модели без поля Ячейки.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Сетка(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Если ТипЗнч(Р1) = Тип("Структура") Тогда
		Возврат КомпонентСловами("сетка", Набор.Сетка(), Р1, "Ячейки", Истина)
			.Наполнить(Р2, Р3, Р4, Р5, Р6, Р7, Р8);
	КонецЕсли;

	Возврат КомпонентСловами("сетка", Набор.Сетка(), Неопределено, "Ячейки", Истина)
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Шапка объекта — первый экран проекта, группы, участника; дети узла становятся её
// действиями. Слова: Иконка, Описание, Подпись, Вид (слаг для data-kind), Знак(Иконка,
// Подпись), Мета(Подпись, Значение, Значок, Адрес), Плашка(узел | текст), Команда(Текст).
//
// Параметры:
//  Модель - Строка, Структура - имя объекта; Структура — прежний вид модели без Действий.
//  Р1…Р8  - ЭлементЭкрана - (необязательные) действия.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ШапкаОбъекта(Знач Модель, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат КомпонентСловами("шапка", Набор.ШапкаОбъекта(), МодельИз(Модель, "Имя"), "Действия")
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Заголовок страницы с пояснением под ним. Слова: Пояснение, Уровень.
//
// Параметры:
//  Модель - Строка, Структура - заголовок; Структура — прежний вид модели.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ЗаголовокСтраницы(Знач Модель) Экспорт
	Возврат КомпонентСловами("заглавие", Набор.ЗаголовокСтраницы(), МодельИз(Модель, "Заголовок"));
КонецФункции

// Пустое состояние списка: значок, объяснение и призыв к действию. Слова: Заголовок,
// Пояснение, Иконка, Действие(узел кнопки), Компактное.
//
// Параметры:
//  Модель - Строка, Структура - пояснение; Структура — прежний вид модели.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ПустоеСостояние(Знач Модель) Экспорт
	Возврат КомпонентСловами("пустое", Набор.ПустоеСостояние(), МодельИз(Модель, "Пояснение"));
КонецФункции

// Полоса вкладок страницы объекта: каждая вкладка своим адресом. Вкладки — дети узла,
// узлы Кит.Вкладка. Слова: Заголовок (доступное имя полосы).
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Структура - (необязательные) вкладки; Структура первым
//          аргументом — прежний вид модели с полем Вкладки.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Табы(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Если ТипЗнч(Р1) = Тип("Структура") Тогда
		Возврат КомпонентСловами("вкладки", Набор.Табы(), Р1);
	КонецЕсли;

	Возврат КомпонентСловами("вкладки", Набор.Табы(), Неопределено, "Вкладки", Ложь, Истина)
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Вкладка полосы Кит.Табы. Печатается только внутри неё. Слова: Активна, Иконка, Счётчик.
//
// Параметры:
//  Подпись - Строка - название вкладки.
//  Адрес   - Строка - адрес её страницы (обязателен).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Вкладка(Знач Подпись, Знач Адрес) Экспорт
	Возврат КомпонентСловами("вкладка", Неопределено,
		Новый Структура("Подпись, Адрес", Строка(Подпись), Строка(Адрес)));
КонецФункции

// Крошки — путь от корня к текущей странице. Пункты — дети узла, узлы Кит.Крошка;
// последний из них — текущая страница: печатается текстом, без ссылки, с aria-current.
// Слова: Подпись (имя навигации, по умолчанию из словаря «chrome.crumbs»).
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана, Структура - (необязательные) крошки; Структура первым
//          аргументом — прежний вид модели с полем Пункты.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Крошки(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Если ТипЗнч(Р1) = Тип("Структура") Тогда
		Возврат КомпонентСловами("крошки", Набор.Крошки(), Р1);
	КонецЕсли;

	Возврат КомпонентСловами("крошки", Набор.Крошки(), Неопределено, "Пункты", Ложь, Истина)
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Крошка — пункт Кит.Крошки. Печатается только внутри них.
//
// Параметры:
//  Подпись - Строка - название страницы.
//  Адрес   - Строка - (необязательный) её адрес; пустой — пункт текстом. У последней
//            крошки адрес не печатается: это страница, на которой человек стоит.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Крошка(Знач Подпись, Знач Адрес = "") Экспорт
	Возврат КомпонентСловами("крошка", Неопределено, Новый Структура("Подпись, Адрес",
		Строка(?(Подпись = Неопределено, "", Подпись)), Строка(?(Адрес = Неопределено, "", Адрес))));
КонецФункции

// Строка поиска по списку: поле, кнопка и скрытые поля, сохраняющие остальной отбор.
// От рода «форма-отбора» отличается тем, что собрана целиком: род даёт пустую GET-форму,
// а этот компонент — готовую строку поиска. Слова: Имя (GET-параметр, «q»), Метка,
// Значение, Пример, Кнопка(Подпись, Иконка), СкрытоеПоле(Имя, Значение), Поле(узел поля).
//
// Параметры:
//  Модель - Строка, Структура - адрес отправки (Действие); Структура — прежний вид модели.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция СтрокаПоиска(Знач Модель) Экспорт
	Возврат КомпонентСловами("поиск", Набор.ФормаОтбора(), МодельИз(Модель, "Действие"));
КонецФункции

// Постраничная навигация длинного списка. Слова: ЕстьСледующая, Параметр, Параметры(Имя,
// Значение), ПодписьНазад, ПодписьВперёд, Заголовок.
//
// Параметры:
//  Модель       - Строка, Структура - базовый путь списка (Основа); Структура — прежний
//                 вид модели.
//  Страница     - Число - (необязательный) текущая страница, с 1.
//  ВсегоСтраниц - Число - (необязательный) сколько страниц; 0 — неизвестно.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Пагинация(Знач Модель, Знач Страница = Неопределено, Знач ВсегоСтраниц = Неопределено) Экспорт

	Результат = КомпонентСловами("страницы", Набор.Пагинация(), МодельИз(Модель, "Основа"));
	Если Страница <> Неопределено Тогда
		Результат.Свойства().Модель.Вставить("Страница", Страница);
	КонецЕсли;
	Если ВсегоСтраниц <> Неопределено Тогда
		Результат.Свойства().Модель.Вставить("ВсегоСтраниц", ВсегоСтраниц);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Тело страницы отказа: код состояния и пояснение.
//
// Параметры:
//  Модель - Структура, Число - модель компонента «Страница ошибки» либо код состояния.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция СтраницаОшибки(Знач Модель) Экспорт
	Возврат КомпонентСловами("отказ", Набор.СтраницаОшибки(), МодельИз(Модель, "Код"));
КонецФункции

// Список шагов многошаговой задачи.
//
// Параметры:
//  Модель - Структура - модель компонента «Проводник».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Проводник(Знач Модель) Экспорт
	Возврат КомпонентСловами("шаги", Набор.Проводник(), Модель);
КонецФункции

// Значок из набора иконок. Слова: Подпись (для скринридера; без неё значок декоративен).
//
// Параметры:
//  Модель - Строка, Структура - имя значка; Структура — прежний вид модели.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Иконка(Знач Модель) Экспорт
	Возврат КомпонентСловами("иконка", Набор.Иконка(), МодельИз(Модель, "Имя"));
КонецФункции

// Ряд плашек одним элементом: они стоят в строку и переносятся вместе.
//
// Параметры:
//  Список - Массив - модели компонента «Плашка».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция РядПлашек(Знач Список) Экспорт
	Возврат Компонент("плашки", Набор.Тег().Ряд(Список));
КонецФункции

// Ряд метаданных: пары «значок + значение» в строку.
//
// Параметры:
//  Элементы - Массив из Структура - Подпись, Значение, Значок, Адрес.
//  Вид      - Строка - «шапка» (ряд в шапке объекта) | «карточка» (ряд в карточке объекта).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция РядМеты(Знач Элементы, Знач Вид) Экспорт

	Классы = Печать.КлассыМеты(Вид);
	Возврат Компонент("мета",
		Набор.РядМеты().Отрисовать(Элементы, Классы.Ряд, Классы.Элемент));

КонецФункции

// Сводка — запись списка одним взглядом: название первым, знаки состояния у него, подпись
// под ним и подписанные строки «подпись — значение». Строчная разметка: ложится и в
// свёрнутую строку раскрывашки. Слова: Подпись (повторная — ещё часть через « · »),
// Знак(узел плашки | текст), Сведение(Подпись, Значение, Вид).
//
// Параметры:
//  Модель - Строка, Структура - название; Структура — прежний вид модели.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Сводка(Знач Модель) Экспорт
	Возврат КомпонентСловами("сводка", Набор.Сводка(), МодельИз(Модель, "Название"));
КонецФункции

// Дерево галок — выбор по дереву с трёхпозиционной галкой у ветки; кладётся в форму.
// Слова: Подпись (доступное имя дерева), Узел(Модель узла) — добавляет узел в корень;
// дерево на тысячу пунктов (выпуск 0.13): Адрес(Адрес веток) — ветка печатает первые 50
// детей, остальные приезжают по адресу страницами («Показать ещё»), Поиск(Адрес) — поле
// поиска над деревом и адрес ответа, Режимы() — сегменты «все / выбранные / никакие»
// у ветки, ТолькоПравки() — форма отдаёт правки, а не все галки; ответы сервера —
// Найдено(Запрос, Всего) (ответ поиска) и Ветка(Ключ, Страница, Всего) (страница ветки).
//
// Параметры:
//  Модель - Массив, Структура - (необязательный) узлы дерева либо модель компонента
//           «Дерево галок» (прежний вид модели).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ДеревоГалок(Знач Модель = Неопределено) Экспорт
	// --- дерево галок (выпуск 0.13): узлы — позицией
	Если ТипЗнч(Модель) = Тип("Массив") Тогда
		Модель = Новый Структура("Узлы", Модель);
	КонецЕсли;
	Возврат КомпонентСловами("дерево-галок", Набор.ДеревоГалок(), Модель);
КонецФункции

// Полоса заполнения — доля занятого от предела. Слова: Метка, Подпись, Вид, Компактная.
//
// Параметры:
//  Модель - Число, Структура - процент; Структура — прежний вид модели.
//  Метка  - Строка - (необязательный) доступное имя индикатора.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ПолосаЗаполнения(Знач Модель, Знач Метка = Неопределено) Экспорт

	Результат = КомпонентСловами("полоса", Набор.ПолосаЗаполнения(), МодельИз(Модель, "Процент"));
	Если Метка <> Неопределено Тогда
		Результат.Свойства().Модель.Вставить("Метка", Строка(Метка));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Тумблер — поле выбора из двух состояний. Слова: Метка, Включено, Подсказка,
// СохранятьСразу, Заблокировано, Значения(Вкл, Выкл), Подписи(Вкл, Выкл).
//
// Параметры:
//  Модель - Строка, Структура - имя поля; Структура — прежний вид модели.
//  Метка  - Строка - (необязательный) подпись тумблера.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Тумблер(Знач Модель, Знач Метка = Неопределено) Экспорт

	Результат = КомпонентСловами("тумблер", Набор.Тумблер(), МодельИз(Модель, "Имя"));
	Если Метка <> Неопределено Тогда
		Результат.Свойства().Модель.Вставить("Метка", Строка(Метка));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Меню — кнопка-открывашка и панель пунктов при ней. Пункты — дети узла: Кит.ПунктМеню
// становится пунктом-ссылкой, любой другой узел (форма, примечание) — пунктом как есть.
// Слова: Иконка, Аккаунт, Счётчик(Число, Подпись).
//
// Параметры:
//  Модель - Строка, Структура - подпись меню (имя кнопки для скринридера); Структура —
//           прежний вид модели с полем Пункты.
//  Р1…Р8  - ЭлементЭкрана - (необязательные) пункты.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Меню(Знач Модель, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Если ТипЗнч(Модель) = Тип("Структура") И Р1 = Неопределено Тогда
		Возврат КомпонентСловами("меню", Набор.Меню(), Модель);
	КонецЕсли;

	Возврат КомпонентСловами("меню", Набор.Меню(), МодельИз(Модель, "Подпись"), "Пункты",
		Ложь, Истина).Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Пункт меню — ссылка в панели Кит.Меню. Печатается только внутри неё. Слова: Иконка.
//
// Параметры:
//  Подпись - Строка - что пункт показывает.
//  Адрес   - Строка - куда ведёт.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ПунктМеню(Знач Подпись, Знач Адрес) Экспорт
	Возврат КомпонентСловами("пункт-меню", Неопределено,
		Новый Структура("Подпись, Адрес", Строка(Подпись), Строка(Адрес)));
КонецФункции

// Бургер единого меню — открывашка для шапки.
//
// Параметры:
//  Разметка - Строка - готовая разметка компонента «Меню хаба», поле Бургер.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция БургерМеню(Знач Разметка) Экспорт
	Возврат Компонент("меню-бургер", Разметка);
КонецФункции

// Открывашка единого меню для широкой шапки — кнопка с именем вошедшего.
//
// Параметры:
//  Разметка - Строка - готовая разметка компонента «Меню хаба», поле Учётка.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция УчёткаМеню(Знач Разметка) Экспорт
	Возврат Компонент("меню-учётка", Разметка);
КонецФункции

// Панель единого меню — единственное место, где живут его пункты.
//
// Параметры:
//  Разметка - Строка - готовая разметка компонента «Меню хаба», поле Панель.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ПанельМеню(Знач Разметка) Экспорт
	Возврат Компонент("меню-панель", Разметка);
КонецФункции

// Поле, значение которого задано конфигурацией: показывается, но не правится. Слова:
// Метка, Значение, Подсказка, Секрет.
//
// Параметры:
//  Модель - Структура - модель компонента «Поле из конфига».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ПолеИзКонфига(Знач Модель) Экспорт
	Возврат КомпонентСловами("поле-конфига", Набор.ПолеИзКонфига(), Модель);
КонецФункции

// Плитка — сводный показатель одним числом. Слова: Пояснение, Адрес, Иконка, Вид.
//
// Параметры:
//  Модель  - Строка, Структура - значение (форматирует вызывающий); Структура — прежний
//            вид модели.
//  Подпись - Строка - (необязательный) что за показатель.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Плитка(Знач Модель, Знач Подпись = Неопределено) Экспорт

	Результат = КомпонентСловами("плитка", Набор.Плитка(), МодельИз(Модель, "Значение"));
	Если Подпись <> Неопределено Тогда
		Результат.Свойства().Модель.Вставить("Подпись", Строка(Подпись));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Уведомление о результате действия; компонент называется «Тост». Слова: Вид, Заголовок,
// Закрываемый, Тревога (role="alert" при любом виде; выпуск 0.12). Тост в ответе тихой
// отправки скрипт кита показывает внизу экрана по очереди и закрывает через 5 с, кроме
// тоста с ролью alert; без скрипта тост стоит на странице, где его напечатал сервер.
//
// Параметры:
//  Модель - Строка, Структура - текст уведомления; Структура — прежний вид модели.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Уведомление(Знач Модель) Экспорт
	Возврат КомпонентСловами("уведомление", Набор.Тост(), МодельИз(Модель, "Текст"));
КонецФункции

// Дерево разделов — навигация по дому настроек. Слова: Заголовок.
//
// Параметры:
//  Модель - Структура - модель компонента «Дерево разделов».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ДеревоРазделов(Знач Модель) Экспорт
	Возврат КомпонентСловами("разделы", Набор.ДеревоРазделов(), Модель);
КонецФункции

// Панель сохранения — липкая полоса с кнопкой «Сохранить». Слова: Пояснение, АдресОтмены,
// Опасное, Иконка, Заблокирована, Имя(Имя, Значение).
//
// Параметры:
//  Модель - Строка, Структура - (необязательный) подпись кнопки; Структура — прежний вид
//           модели.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ПанельСохранения(Знач Модель = Неопределено) Экспорт

	Если Модель = Неопределено ИЛИ (ТипЗнч(Модель) = Тип("Строка") И НЕ ЗначениеЗаполнено(Модель)) Тогда
		Модель = Новый Структура();
	КонецЕсли;
	Возврат КомпонентСловами("панель", Набор.ПанельСохранения(), МодельИз(Модель, "Подпись"));

КонецФункции

#КонецОбласти

#Область Шаги

// Шаги — длинная форма по одному экрану за раз: полоса номеров сверху (текущий залит,
// пройденные с галкой), панель шага, «Назад / Дальше» и отправка на последнем шаге.
// «Дальше» пускает дальше, только когда поля текущего шага годны: скрипт кита зовёт
// у них reportValidity. Без скрипта шаги — панели подряд (раскрывашки), открыт первый,
// кнопка отправки под ними: форма уходит целиком, проверяет её сервер. Шаги кладут
// в форму. Открыт сначала шаг, где у поля есть Ошибка, иначе помеченный Текущий(), иначе
// первый. Вид словом: «вкладки» (правка: любой шаг открывается сразу, без «Назад /
// Дальше», отправка видна всегда) | "" (мастер). Слова: Кнопка(Подпись | узел кнопки)
// — кнопка отправки (по умолчанию — основная с текстом словаря «steps.submit»), Подпись
// — имя полосы номеров для скринридера.
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана - (необязательные) шаги, узлы Кит.Шаг.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Шаги(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	ОтвергнутьВидНаМестеРебёнка("шаги", "Шаги", Р1, Р2);
	Возврат Новый ЭлементЭкрана(Печать, "шаги", "", Новый Структура("Рисователь", РисовательШагов))
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Шаг — панель Кит.Шаги: подпись называет его в полосе номеров, дети — поля шага.
// Печатается только внутри Кит.Шаги. Слова: Текущий() — шаг, с которого начать (форма,
// вернувшаяся на второй шаг); Когда(Ложь) снимает шаг вместе с его номером.
//
// Параметры:
//  Подпись - Строка - название шага, коротко: «Проект», «Участники».
//  Р1…Р8   - ЭлементЭкрана, Строка - (необязательные) поля и текст шага; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Шаг(Знач Подпись, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Текст = СокрЛП(Строка(?(Подпись = Неопределено, "", Подпись)));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		ВызватьИсключение "Кит: шаг без подписи — в полосе номеров ему нечем назваться,"
			+ " и скринридер прочёл бы «шаг 2 из 3» без имени. Подпись — первым аргументом:"
			+ " Кит.Шаг(""Участники"", …).";
	КонецЕсли;

	Возврат Новый ЭлементЭкрана(Печать, "шаг", "", Новый Структура("Текущий", Ложь))
		.Подпись(Текст).Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

#КонецОбласти

#Область СегментыИПодсказка

// --- сегменты и подсказка (выпуск 0.12) ---

// Сегменты — выбор одного из немногих (пресет, тема, режим) рядом кнопок в одной пилюле:
// выбранный сегмент залит, на нём галка. Под капотом — радиокнопки одного имени: выбор
// уходит с формой без скрипта, стрелки меняют его движком браузера. Дети — сегменты
// (Кит.Сегмент); дети сегмента — его набор полей: под группой виден набор отмеченного
// сегмента, и переключает наборы лист (:has(:checked)), без скрипта. Отмечен ровно один:
// сегмент со словом Выбран(), иначе совпавший с Выбрано(Значение), иначе первый. Слова:
// Выбрано(Значение), Подпись (имя группы для скринридера), Малые (низкие — для строки
// списка), СохранятьСразу (выбор сам отправляет форму, как у тумблера), Якорь.
//
// Параметры:
//  Имя   - Строка - имя поля (атрибут name радиокнопок): под ним выбор уходит с формой.
//  Р1…Р8 - ЭлементЭкрана - (необязательные) сегменты, узлы Кит.Сегмент.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Сегменты(Знач Имя, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Имя_ = СокрЛП(Строка(?(Имя = Неопределено, "", Имя)));
	Если НЕ ЗначениеЗаполнено(Имя_) Тогда
		ВызватьИсключение "Кит: сегменты без имени — выбор не уйдёт с формой: браузер отправляет"
			+ " радиокнопку под её именем. Имя — первым аргументом: Кит.Сегменты(""theme"", …).";
	КонецЕсли;

	Возврат Новый ЭлементЭкрана(Печать, "сегменты", "", Новый Структура(
		"Рисователь, Имя, Выбрано, СохранятьСразу", РисовательСегментов, Имя_, Неопределено, Ложь))
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Сегмент — один вариант Кит.Сегменты: значение уходит с формой, подпись видна на сегменте.
// Дети — набор полей, который виден, пока сегмент выбран. Печатается только внутри
// Кит.Сегменты. Слова: Выбран() — этот сегмент отмечен; Когда(Ложь) снимает сегмент
// вместе с его набором.
//
// Параметры:
//  Значение - Строка - что уходит с формой, когда сегмент выбран.
//  Подпись  - Строка - надпись сегмента, одно-два слова.
//  Р1…Р7    - ЭлементЭкрана, Строка - (необязательные) набор полей сегмента; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Сегмент(Знач Значение, Знач Подпись, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено) Экспорт

	Текст = СокрЛП(Строка(?(Подпись = Неопределено, "", Подпись)));
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		ВызватьИсключение СтрШаблон("Кит: сегмент «%1» без подписи — на нём нечего показать,"
			+ " и скринридер прочёл бы пустую радиокнопку. Подпись — вторым аргументом:"
			+ " Кит.Сегмент(""dark"", ""Тёмная"").", Значение);
	КонецЕсли;

	Возврат Новый ЭлементЭкрана(Печать, "сегмент", "", Новый Структура("Значение, Выбран",
		Строка(?(Значение = Неопределено, "", Значение)), Ложь))
		.Подпись(Текст).Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7);

КонецФункции

// Подсказка — значок «?», по нажатию на который рядом открывается поповер с пояснением:
// длинный текст уходит с экрана, но остаётся в одном нажатии. Ставят рядом с заголовком
// секции, подписью группы, словом в тексте. Поповер открывает и закрывает движок браузера
// (атрибут popover): Esc и щелчок мимо закрывают его, фокус возвращается на значок, скрипта
// нет. У поля пояснение печатает слово Справка(Текст) самого поля — оно ещё и связывает
// текст с полем для скринридера. Слова: Подпись (имя значка для скринридера; по умолчанию
// текст словаря «help.open»), Якорь (идентификатор поповера; без него кит выдаёт свой,
// постоянный для того же дерева).
//
// Параметры:
//  Текст - Строка - пояснение (экранируется).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Подсказка(Знач Текст) Экспорт

	Текст_ = Строка(?(Текст = Неопределено, "", Текст));
	Если НЕ ЗначениеЗаполнено(СокрЛП(Текст_)) Тогда
		ВызватьИсключение "Кит: подсказка без текста — значок «?» открыл бы пустой поповер."
			+ " Текст — первым аргументом: Кит.Подсказка(""Ключ виден в адресе проекта."").";
	КонецЕсли;

	Возврат Новый ЭлементЭкрана(Печать, "подсказка", "", Новый Структура("Рисователь, Текст",
		Подсказки, Текст_));

КонецФункции

#КонецОбласти

#Область Настройки

// Дом настроек — объект, разделы колонкой слева и секции справа; печатается каркасом
// настроек (РендерерНастроек) — разметка та же, что у модели-структуры. Адрес и токен
// задаются один раз здесь: секции-формы и формы внутри берут их у дома. Дети — секции
// (Кит.Секция); разделы — словом Раздел(Подпись, Ключ, Иконка), рубрики над ними — словом
// Рубрика(Подпись). Слова: Ключ (латиницей, data-house), Объект, Пояснение,
// Крошка(Подпись, Адрес), Уведомление(узел | текст), Рубрика, Раздел.
//
// Параметры:
//  Заголовок - Строка - заголовок дома.
//  Адрес     - Строка - адрес дома; адрес раздела — Адрес/Ключ.
//  Токен     - Строка, ЭлементЭкрана - (необязательный) CSRF-токен сессии; узел на этом
//              месте — первая секция.
//  Р1…Р7     - ЭлементЭкрана - (необязательные) секции.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ДомНастроек(Знач Заголовок, Знач Адрес, Знач Токен = "", Знач Р1 = Неопределено,
	Знач Р2 = Неопределено, Знач Р3 = Неопределено, Знач Р4 = Неопределено,
	Знач Р5 = Неопределено, Знач Р6 = Неопределено, Знач Р7 = Неопределено) Экспорт

	Результат = Новый ЭлементЭкрана(Печать, "дом", "", Новый Структура("Рисователь, Модель, Адрес",
		Каркас, Новый Структура("Ключ, Заголовок", "", Строка(?(Заголовок = Неопределено, "", Заголовок))),
		СокрЛП(Строка(?(Адрес = Неопределено, "", Адрес)))));

	Если ТипЗнч(Токен) = Тип("ЭлементЭкрана") Тогда
		Возврат Результат.Наполнить(Токен, Р1, Р2, Р3, Р4, Р5, Р6, Р7);
	КонецЕсли;

	Если ЗначениеЗаполнено(Токен) Тогда
		Результат.Токен(Токен);
	КонецЕсли;
	Возврат Результат.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7);

КонецФункции

// Секция настроек — карточка с заголовком; её тело — дети узла, кнопки справа от
// заголовка — второй холст Действия(д…) (на узком экране он встаёт под лидом). Внутри
// дома и вне его печатается тем же каркасом. Словом Форма(Хвост) становится формой со
// своей панелью сохранения: адрес — у контекста, токен — у предков. Слова: Лид, Иконка,
// Форма, Кнопка, ИконкаКнопки, ИмяКнопки(Имя, Значение), ПояснениеПанели, АдресОтмены,
// Опасная, Заблокирована, БезПанели, СФайлами, Свёрнута(ПодписьРаскрытия), Раскрыта, Якорь.
//
// Параметры:
//  Заголовок - Строка - заголовок секции.
//  Р1…Р8     - ЭлементЭкрана, Строка - (необязательные) тело секции; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Секция(Знач Заголовок, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "секция", "", Новый Структура("Рисователь, Модель",
		Каркас, Каркас.Секция(Строка(?(Заголовок = Неопределено, "", Заголовок)))))
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Разделы дома для единого меню — та же форма, что у РендерерНастроек.Раздел: каркас
// страницы берёт их отсюда, когда содержимое страницы — дом.
//
// Параметры:
//  Дом - ЭлементЭкрана - узел Кит.ДомНастроек.
//
// Возвращаемое значение:
//  Массив из Структура - Подпись, Адрес, Иконка, Активен, Рубрика, Опасный, Счётчик,
//                        ПодписьСчётчика.
//
Функция РазделыДома(Знач Дом) Экспорт
	Возврат Печать.РазделыДома(Дом);
КонецФункции

// Заголовок дома — им каркас страницы подписывает группу разделов дома в едином меню.
//
// Параметры:
//  Дом - ЭлементЭкрана - узел Кит.ДомНастроек.
//
// Возвращаемое значение:
//  Строка
//
Функция ЗаголовокДома(Знач Дом) Экспорт
	Возврат Печать.ЗаголовокДома(Дом);
КонецФункции

#КонецОбласти

#Область Реестр

// --- реестр (шаг 11) ---

// Реестр — список немногих записей: провайдеров, подключений, подписок, ключей. Каждая
// запись — Кит.ЗаписьРеестра: свёрнутая строка-сводка, действия справа от неё и тело
// с подробностями. Без записей реестр печатает пустое состояние: текст — словом
// Пусто(Текст) (по умолчанию из словаря «registry.empty»), свои узлы — Пусто(д…).
// Слова: Нумерованный (номера по порядку, список <ol>), Пусто(д…), Подпись (имя списка
// для скринридера), Якорь.
//
// Параметры:
//  Р1…Р8 - ЭлементЭкрана - (необязательные) записи, узлы Кит.ЗаписьРеестра.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Реестр(Знач Р1 = Неопределено, Знач Р2 = Неопределено, Знач Р3 = Неопределено,
	Знач Р4 = Неопределено, Знач Р5 = Неопределено, Знач Р6 = Неопределено,
	Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "реестр", "", Новый Структура("Рисователь, Модель",
		Реестры, Новый Структура("Нумерованный", Ложь)))
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Запись реестра. Дети — тело под свёрнутой строкой (обычно Кит.Свойства); второй холст
// Действия(д…) — то, что стоит справа от свёрнутой строки, вне её: тумблер с
// СохранятьСразу, стрелки порядка; третий холст Кнопки(д…) — набор действий записи:
// из него печатаются и меню ⚙ у свёрнутой записи, и кнопки внизу раскрытого тела.
// Слова: Значок(ИмяГлифа), Картинка(Адрес), Плашка(узел | текст), Подпись (повторный
// вызов добавляет часть через « · »), Факт(Подпись, Значение, Вид), Номер(Число), Открыть,
// Действия(д…), Кнопки(д…), Якорь.
//
// Параметры:
//  Имя   - Строка - название записи: имя, адрес, номер.
//  Р1…Р8 - ЭлементЭкрана, Строка - (необязательные) тело записи; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ЗаписьРеестра(Знач Имя, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	// набор кнопок — третий холст: второй у записи уже занят действиями справа от сводки
	Кнопки = Новый ЭлементЭкрана(Печать, "холст");
	Результат = Новый ЭлементЭкрана(Печать, "запись-реестра", "", Новый Структура("Модель, Кнопки",
		Новый Структура("Имя", Строка(?(Имя = Неопределено, "", Имя))), Кнопки));
	Кнопки.ПринятьРодителя(Результат);
	Возврат Результат.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

#КонецОбласти

#Область ОбъявленныеФормы

// Объявленная форма: она знает свои поля и умеет разобрать пришедшее, поэтому входит
// в дерево узлом-компонентом, а не переписывается родами кита.
//
// Параметры:
//  Объявление  - ОбъявлениеФормы - объявленный состав формы.
//  Действующие - Структура, Соответствие - значения полей.
//  Действие    - Строка - URL, куда уходит POST.
//  Токен       - Строка - CSRF-токен сессии.
//  Вид         - Строка - «столбик» | «строкой» | «меню» | «переключатель» | "" (без раскладки).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ОбъявленнаяФорма(Знач Объявление, Знач Действующие, Знач Действие,
	Знач Токен = "", Знач Вид = "") Экспорт

	Возврат Компонент("объявление", Объявление.Отрисовать(Действующие, Действие, Токен,
		Печать.КлассВида("форма", Вид)));

КонецФункции

// Объявленная форма, показанная окном поверх экрана, — прежний вызов
// Кит.Окно(Объявление, Действующие, Действие, Токен, Свойства). Узел рода «окно» с готовой
// разметкой: рамка та же, что у окна со слотами, а HTML — прежний байт в байт. Кнопка
// открывает его словом Открывает(узел).
Функция ОкноОбъявления(Знач Объявление, Знач Действующие, Знач Действие, Знач Токен, Знач Свойства)

	Разметка = Объявление.ОтрисоватьВОкне(Действующие, Действие, Токен, Свойства);
	Ид = "";
	Попытка
		Ид = Объявление.ИдентификаторОкна();
	Исключение
		Ид = "";
	КонецПопытки;

	Заголовок = "";
	Если ТипЗнч(Свойства) = Тип("Структура") Тогда
		Свойства.Свойство("Заголовок", Заголовок);
	КонецЕсли;

	Результат = Новый ЭлементЭкрана(Печать, "окно", "", Новый Структура("Разметка, Заголовок, Лид, Открыто",
		Строка(Разметка), Строка(?(Заголовок = Неопределено, "", Заголовок)), "", Ложь));
	Результат.Якорь(Ид);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область Окна

// Модальное окно со слотами: заголовок и крестик сверху, лид под ними, тело — дети узла,
// действия — второй холст Действия(д…) внизу. Открывает его кнопка словом Открывает(узел)
// (команда движка show-modal, скрипта не нужно); Esc и крестик закрывают его движком.
// До 640 px окно — лист во весь экран: тело прокручивается, действия прилипают к низу.
// Слова: Лид, Действия(д…), Вид («обычное» | «опасное» | «широкое»), Открыто (сервер
// печатает окно открытым по ?окно=…), Якорь (идентификатор; без него кит выдаёт свой,
// постоянный для того же дерева), Форма(Адрес) (окно целиком — форма; токен у предков),
// БезПерезагрузки (форма окна уходит тихо: успех закрывает окно, отказ остаётся в нём),
// Токен, СФайлами.
//
// Прежний вызов Кит.Окно(Объявление, Действующие, Действие, Токен, Свойства) печатает
// объявленную форму окном, как раньше: первым аргументом пришло объявление, а не заголовок.
//
// Параметры:
//  Заголовок - Строка - заголовок окна: им окно называет себя скринридеру.
//  Р1…Р8     - ЭлементЭкрана, Строка - (необязательные) тело окна; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Окно(Знач Заголовок, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Если Заголовок <> Неопределено И ТипЗнч(Заголовок) <> Тип("Строка") Тогда
		Возврат ОкноОбъявления(Заголовок, Р1, Р2, Р3, Р4);
	КонецЕсли;

	ОтвергнутьВидНаМестеРебёнка("окно", "Окно", Р1, Р2);
	Возврат УзелОкна("окно", Окна, Заголовок).Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

// Подтверждение необратимого действия — окно вида «опасное» вместо window.confirm:
// заголовок, последствия (описание окна для скринридера), дети узла под ними, необязательное
// эхо-поле и кнопка цвета ошибки рядом с отменой. Отправляет свою форму (слово Форма),
// форму, которая назвала его словом СПодтверждением(узел), или форму вокруг. Слова:
// Эхо(Имя, Образец, Метка, Подсказка), Кнопка(Подпись), Форма(Адрес), Открыто, Якорь,
// БезПерезагрузки, Токен.
//
// Параметры:
//  Заголовок   - Строка - вопрос окна («Удалить проект?»).
//  Последствия - Строка - что случится и что нельзя будет вернуть.
//  Р1…Р7       - ЭлементЭкрана, Строка - (необязательные) дополнение под последствиями.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Подтверждение(Знач Заголовок, Знач Последствия = "", Знач Р1 = Неопределено,
	Знач Р2 = Неопределено, Знач Р3 = Неопределено, Знач Р4 = Неопределено,
	Знач Р5 = Неопределено, Знач Р6 = Неопределено, Знач Р7 = Неопределено) Экспорт

	Результат = УзелОкна("подтверждение", Подтверждения, Заголовок);
	Результат.Свойства().Вставить("Последствия", Строка(?(Последствия = Неопределено, "", Последствия)));
	Результат.Свойства().Вставить("Эхо", Неопределено);
	Результат.Свойства().Вставить("Кнопка", "");
	Возврат Результат.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7);

КонецФункции

// Кнопка окна, которое не печатается заранее (правка строки таблицы на сотню строк): ссылка
// на страницу с ?окно=…, где сервер печатает окно открытым. Скрипт берёт ту страницу
// запросом в фоне, кладёт её окно в оболочку и открывает; отправка формы окна закрывает
// его по успеху тихой отправки. Оболочку — одну на страницу — печатает каркас страницы.
// Слова: Основная, Вторичная, Опасная, Ссылкой, Малая, Большая, Иконка, ТолькоИконка,
// Подсказка, Подпись.
//
// Параметры:
//  Адрес   - Строка - адрес своего приложения: страница, где сервер печатает окно открытым.
//  Подпись - Строка - подпись кнопки.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ОкноПоАдресу(Знач Адрес, Знач Подпись) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "окно-по-адресу", "", Новый Структура("Рисователь, Модель",
		ОкнаПоАдресу, Новый Структура("Адрес, Подпись",
			СокрЛП(Строка(?(Адрес = Неопределено, "", Адрес))),
			Строка(?(Подпись = Неопределено, "", Подпись)))));

КонецФункции

// Оболочка окна по адресу — одна на страницу пустая <dialog> и тост ошибки загрузки.
// Каркас страницы ставит её в тело сам; руками она нужна тому, кто собирает документ без
// каркаса. Печатается, только если в том же дереве есть кнопка окна по адресу.
//
// Параметры:
//  Всегда - Булево - (необязательный, по умолчанию Ложь) печатать без кнопки в дереве:
//           содержимое пришло готовой строкой, и дерево его не видит.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ОболочкаОкна(Знач Всегда = Ложь) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "оболочка-окна", "", Новый Структура("Рисователь, Всегда",
		ОкнаПоАдресу, Всегда = Истина));

КонецФункции

// Есть ли в готовой разметке кнопка окна по адресу — для содержимого, пришедшего строкой.
//
// Параметры:
//  Разметка - Строка - HTML.
//
// Возвращаемое значение:
//  Булево
//
Функция ЕстьОкноПоАдресу(Знач Разметка) Экспорт
	Возврат ТипЗнч(Разметка) = Тип("Строка") И СтрНайти(Разметка, ОкнаПоАдресу.ПризнакСсылки()) > 0;
КонецФункции

// Узел окна: рамку рисует желудь окна, токен формы окна печатает тот же скрытый
// компонент, что у Кит.Форма.
Функция УзелОкна(Знач Род, Знач Рисователь, Знач Заголовок)

	Возврат Новый ЭлементЭкрана(Печать, Род, "", Новый Структура(
		"Рисователь, Заголовок, Лид, Открыто, РисовательТокена, ИмяТокена",
		Рисователь, Строка(?(Заголовок = Неопределено, "", Заголовок)), "", Ложь,
		Набор.СкрытоеПоле(), Каркас.ИмяПоляCSRF()));

КонецФункции

#КонецОбласти

#Область КартинкаИОбразец

// --- картинка и образец (выпуск 0.12) ---

// Слот картинки — загрузка одной картинки (логотип, значок, обложка): предпросмотр на
// шахматке, подпись и строка состояния, кнопка «Загрузить / Заменить» и меню ⚙
// с «Вернуть стандартную» через подтверждение. Слот — своя форма: выбор файла отправляет
// её сразу, тихо (multipart); без скрипта видно файловое поле и кнопку отправки. Поэтому
// внутрь другой формы слот не кладут. Адрес загрузки — слово Форма(Хвост) (адрес контекста
// с хвостом, как у секции; без слова — сам адрес контекста), токен — у предков.
// Имя Кит.Картинка занято картинкой-<img>, поэтому узел назван слотом.
// Слова: Адрес(ТекущаяКартинка), Состояние(Текст), Принимает(Типы), КнопкаЗагрузки(Подпись),
// Сброс(Адрес или хвост) (пункт ⚙ «Вернуть стандартную»), Открыто (окно подтверждения
// сброса напечатано открытым — так сервер спрашивает подтверждение без скрипта), Форма,
// Якорь, Токен.
//
// Параметры:
//  Имя     - Строка - имя файлового поля: под ним сервер получит файл.
//  Подпись - Строка - что это за картинка («Логотип»).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция СлотКартинки(Знач Имя, Знач Подпись) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "слот-картинки", "", Новый Структура(
		"Рисователь, Модель, РисовательТокена, ИмяТокена", СлотыКартинки,
		Новый Структура("Имя, Подпись", СокрЛП(Строка(?(Имя = Неопределено, "", Имя))),
			Строка(?(Подпись = Неопределено, "", Подпись))),
		Набор.СкрытоеПоле(), Каркас.ИмяПоляCSRF()));

КонецФункции

// Образец — рамка предпросмотра: подпись, переключатель темы (светлая, тёмная) и рамка,
// в которую кладут любое дерево. Что показывать, решает приложение; меняться по мере ввода
// образцу помогает слово Зеркало(ИмяПоля) у узлов внутри него. Без скрипта рамка показана
// в теме страницы, переключатель спрятан. Слова: Тема(«светлая» | «тёмная»), Якорь,
// Зеркало.
//
// Параметры:
//  Подпись - Строка - что показано: подпись фигуры для глаза и скринридера.
//  Р1…Р8   - ЭлементЭкрана, Строка - (необязательные) содержимое рамки; строка — текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Образец(Знач Подпись, Знач Р1 = Неопределено, Знач Р2 = Неопределено,
	Знач Р3 = Неопределено, Знач Р4 = Неопределено, Знач Р5 = Неопределено,
	Знач Р6 = Неопределено, Знач Р7 = Неопределено, Знач Р8 = Неопределено) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "образец", "", Новый Структура("Рисователь, Подпись, Тема",
		Образцы, Строка(?(Подпись = Неопределено, "", Подпись)), ""))
		.Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Узел рода с детьми позиционно. Единственная строка-ребёнок, совпавшая с видом рода, —
// почти наверняка прежний вызов «Кит.Область("полоса")»: она напечаталась бы видимым
// словом вместо оформления, поэтому сборка останавливается с подсказкой. Строка среди
// других детей прежним вызовом быть не может — её не трогают: данные вроде «узкая»
// в ячейке рядом с узлом остаются текстом.
Функция Узел(Знач Род, Знач Фабрика, Знач Р1, Знач Р2, Знач Р3, Знач Р4, Знач Р5, Знач Р6,
	Знач Р7, Знач Р8)

	ОтвергнутьВидНаМестеРебёнка(Род, Фабрика, Р1, Р2);
	Возврат Новый ЭлементЭкрана(Печать, Род).Наполнить(Р1, Р2, Р3, Р4, Р5, Р6, Р7, Р8);

КонецФункции

Процедура ОтвергнутьВидНаМестеРебёнка(Знач Род, Знач Фабрика, Знач Значение, Знач Следующий)

	Если ТипЗнч(Значение) <> Тип("Строка") ИЛИ Следующий <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Вид = НРег(СокрЛП(Значение));
	Если НЕ ЗначениеЗаполнено(Вид) ИЛИ Печать.ВидыРода(Род).Найти(Вид) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Кит: «%1» на месте ребёнка Кит.%2 — это вид узла, а вид"
		+ " теперь задаётся словом .Вид(…): строка на месте ребёнка печатается текстом."
		+ " Было Кит.%2(…, ""%1""), стало Кит.%2(…).Вид(""%1"").", Вид, Фабрика);

КонецПроцедуры

Процедура ОтвергнутьВторойВид(Знач Фабрика, Знач Значение)

	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Кит: второй аргумент Кит.%1 — прежний вид узла («%2»);"
		+ " вид теперь задаётся словом .Вид(…). Было Кит.%1(…, ""%2""), стало"
		+ " Кит.%1(…).Вид(""%2"").", Фабрика, Значение);

КонецПроцедуры

Функция УзелФормы(Знач Род, Знач Действие, Знач Свои = Неопределено)

	Поля = Новый Структура("Действие", Строка(?(Действие = Неопределено, "", Действие)));
	Если Свои <> Неопределено Тогда
		Для Каждого КиЗ Из Свои Цикл
			Поля.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Новый ЭлементЭкрана(Печать, Род, "", Поля);

КонецФункции

// Компонент с готовой разметкой печатает себя целиком и от места в дереве не зависит.
// От «готового» узла отличается тем, что назван: в дереве экрана видно
// «компонент[кнопка]», а не безымянный кусок HTML.
Функция Компонент(Знач Вид, Знач Разметка)

	Возврат Новый ЭлементЭкрана(Печать, "компонент", Вид,
		Новый Структура("Разметка", Строка(?(Разметка = Неопределено, "", Разметка))));

КонецФункции

// Компонент со словами рисуется не сейчас, а на печати: слова дописывают модель после
// рождения, а содержимое слота — это дети узла, которых к моменту создания ещё нет.
// Модель копируется: слова пишут в свою копию, а не в структуру вызывающего.
// Слот-список (ячейки сетки) получает детей по одному, слот моделей (вкладки, пункты
// меню) — их модели: склеенная строка стала бы одной ячейкой на всех.
Функция КомпонентСловами(Знач Вид, Знач Рисователь, Знач Модель, Знач Слот = "",
	Знач СлотСписком = Ложь, Знач СлотМоделями = Ложь)

	Свои = Новый Структура("Рисователь, Модель", Рисователь, КопияМодели(Модель));
	Если ЗначениеЗаполнено(Слот) Тогда
		Свои.Вставить("Слот", Слот);
		Свои.Вставить("СлотСписком", СлотСписком);
		Свои.Вставить("СлотМоделями", СлотМоделями);
	КонецЕсли;
	Возврат Новый ЭлементЭкрана(Печать, "компонент", Вид, Свои);

КонецФункции

// Модель из обязательного аргумента: структура — прежний вход, всё прочее — значение
// главного поля модели.
Функция МодельИз(Знач Значение, Знач Поле)

	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Возврат Значение;
	КонецЕсли;

	Результат = Новый Структура();
	Результат.Вставить(Поле, ?(ТипЗнч(Значение) = Тип("Число"), Значение,
		Строка(?(Значение = Неопределено, "", Значение))));
	Возврат Результат;

КонецФункции

Функция КопияМодели(Знач Модель)

	Результат = Новый Структура();
	Если ТипЗнч(Модель) = Тип("Структура") Тогда
		Для Каждого КиЗ Из Модель Цикл
			Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ПроверенныйУровень(Знач Уровень)

	Попытка
		Номер = Цел(Число(Уровень));
	Исключение
		Номер = 0;
	КонецПопытки;

	Если Номер < 1 ИЛИ Номер > 6 Тогда
		ВызватьИсключение СтрШаблон("Кит: заголовок уровня «%1» не бывает — уровень"
			+ " от 1 до 6. Уровень задаёт место заголовка в оглавлении страницы, и пропуск"
			+ " уровня ломает его для скринридера.", Уровень);
	КонецЕсли;

	Возврат Номер;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазметкаЭлементов") _Печать,
	&Пластилин(Значение = "НаборКомпонентов") _Набор,
	&Пластилин(Значение = "РендерерНастроек") _Каркас,
	&Пластилин(Значение = "Шаги") _Шаги,
	&Пластилин(Значение = "Окно") _Окна,
	&Пластилин(Значение = "Подтверждение") _Подтверждения,
	&Пластилин(Значение = "ОкноПоАдресу") _ОкнаПоАдресу,
	&Пластилин(Значение = "Сегменты") _Сегменты,
	&Пластилин(Значение = "Подсказка") _Подсказки,
	&Пластилин(Значение = "СлотКартинки") _СлотыКартинки,
	&Пластилин(Значение = "Образец") _Образцы,
	&Пластилин(Значение = "Реестр") _Реестры = Неопределено) Экспорт

	Печать = _Печать;
	Набор = _Набор;
	Каркас = _Каркас;
	РисовательШагов = _Шаги;
	Реестры = _Реестры;
	Окна = _Окна;
	Подтверждения = _Подтверждения;
	ОкнаПоАдресу = _ОкнаПоАдресу;
	// --- сегменты и подсказка (выпуск 0.12) ---
	РисовательСегментов = _Сегменты;
	Подсказки = _Подсказки;
	// --- картинка и образец (выпуск 0.12) ---
	СлотыКартинки = _СлотыКартинки;
	Образцы = _Образцы;

КонецПроцедуры
