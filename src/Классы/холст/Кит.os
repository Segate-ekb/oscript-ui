// Кит — желудь UI-кита: фабрика элементов экрана. Экран берёт у кита холст, наполняет его
// вложенными элементами и печатает целиком; тегов и имён классов за этой границей нет.

Перем Печать;   // РазметкаЭлементов
Перем Набор;    // НаборКомпонентов
Перем Каркас;   // РендерерНастроек — имя скрытого поля CSRF

#Область Документ

// Документ — корень страницы: объявление типа, <html> и всё, что внутри. В него кладут
// голову и тело, больше ничего.
//
// Параметры:
//  Язык - Строка - код языка страницы для атрибута lang.
//  Тема - Строка - значение атрибута data-theme; ставится ДО листа стилей, иначе
//         страница мигнёт чужими цветами.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Документ(Знач Язык, Знач Тема) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "документ", "",
		Новый Структура("Язык, Тема", Строка(?(Язык = Неопределено, "", Язык)),
			Строка(?(Тема = Неопределено, "", Тема))));

КонецФункции

// Голова документа — то, чего человек не видит: заглавие вкладки, объявления и ресурсы.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Голова() Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "голова");
КонецФункции

// Заглавие вкладки браузера.
//
// Параметры:
//  Значение - Строка - текст заглавия (экранируется).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Титул(Знач Значение) Экспорт

	Результат = Новый ЭлементЭкрана(Печать, "титул");
	Результат.Добавить(Текст(Значение));
	Возврат Результат;

КонецФункции

// Объявление «имя — содержание» в голове документа.
//
// Параметры:
//  Имя        - Строка - имя объявления (viewport, referrer, color-scheme).
//  Содержание - Строка - его значение.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Мета(Знач Имя, Знач Содержание) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "мета", "",
		Новый Структура("Имя, Содержание, Кодировка",
			Строка(?(Имя = Неопределено, "", Имя)),
			Строка(?(Содержание = Неопределено, "", Содержание)), ""));

КонецФункции

// Объявление кодировки документа. Стоит первым в голове: до него браузер читает байты
// вслепую.
//
// Параметры:
//  Имя - Строка - имя кодировки.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Кодировка(Знач Имя) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "мета", "",
		Новый Структура("Имя, Содержание, Кодировка", "", "",
			Строка(?(Имя = Неопределено, "", Имя))));

КонецФункции

// Ссылка на внешний ресурс: лист стилей, иконка сайта, иконка домашнего экрана.
// Ресурс без адреса не печатается вовсе.
//
// Параметры:
//  Отношение - Строка - чем ресурс приходится странице (stylesheet, icon).
//  Адрес     - Строка - адрес ресурса.
//  Тип       - Строка - (необязательный) тип содержимого ресурса.
//  Размеры   - Строка - (необязательный) размеры картинки, которые несёт ресурс.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Ресурс(Знач Отношение, Знач Адрес, Знач Тип = "", Знач Размеры = "") Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "ресурс", "",
		Новый Структура("Отношение, Адрес, Тип, Размеры",
			Строка(?(Отношение = Неопределено, "", Отношение)),
			Строка(?(Адрес = Неопределено, "", Адрес)),
			Строка(?(Тип = Неопределено, "", Тип)),
			Строка(?(Размеры = Неопределено, "", Размеры))));

КонецФункции

// Правила оформления прямо в голове документа — то, что обязано приехать вместе
// с разметкой, а не отдельным запросом.
//
// Параметры:
//  Имя     - Строка - имя блока правил (атрибут id).
//  Правила - Строка - ДОВЕРЕННЫЙ CSS: внутри <style> экранирование бесполезно,
//            значение обязан провалидировать тот, кто его собрал.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Стиль(Знач Имя, Знач Правила) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "стиль", "",
		Новый Структура("Имя, Правила", Строка(?(Имя = Неопределено, "", Имя)),
			Строка(?(Правила = Неопределено, "", Правила))));

КонецФункции

// Скрипт страницы. Всегда отложенный: разбор разметки он не останавливает.
//
// Параметры:
//  Адрес - Строка - адрес скрипта; пустой не печатается вовсе.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Скрипт(Знач Адрес) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "скрипт", "",
		Новый Структура("Адрес", Строка(?(Адрес = Неопределено, "", Адрес))));

КонецФункции

// Тело документа — всё, что человек видит.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Тело() Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "тело");
КонецФункции

// Шапка — верхняя полоса страницы: знак, навигация, учётка.
//
// Параметры:
//  Вид - Строка - «страницы» (липкая полоса вверху) | "" (без оформления).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Шапка(Знач Вид = "") Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "шапка", Вид);
КонецФункции

// Основное — то, ради чего страницу открыли. На странице оно одно.
//
// Параметры:
//  Вид - Строка - «полоса» (колонка содержимого по центру) | "" (без оформления).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Основное(Знач Вид = "") Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "основное", Вид);
КонецФункции

// Подвал — нижняя полоса страницы.
//
// Параметры:
//  Вид - Строка - «страницы» | "" (без оформления).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Подвал(Знач Вид = "") Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "подвал", Вид);
КонецФункции

// Навигация — набор ходов, который скринридер объявляет отдельным ориентиром.
//
// Параметры:
//  Вид - Строка - «верхняя» (ряд ходов в шапке страницы) | "" (без оформления).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Навигация(Знач Вид = "") Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "навигация", Вид);
КонецФункции

#КонецОбласти

#Область Раскладка

// Холст — корень куска экрана. Своего тега не печатает: обёртка, которой на экране никто
// не просил, ломает вертикальный ритм соседей. Пустой холст печатается пустой строкой.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Холст() Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "холст");
КонецФункции

// Область — коробка на экране: свой блок, свой вид, и на неё можно повесить признак
// и роль. Тем и отличается от холста, что у неё есть тег.
//
// Параметры:
//  Вид - Строка - «проза» (чужой документ, набранный типографски) | «карточки» (колонка
//        карточек) | «шапка» | «плашки» | «действия» (части карточки объекта)
//        | «отбор» (полоса применённых плашек над списком) | «вставка» (врезка пунктиром
//        внутри формы: шаг, а не своя секция) | «студия» (работа слева, образец справа)
//        | «работа» / «образец» (колонки студии) | «поле» (рамка поля с меткой
//        и подсказкой вокруг своего управления) | «полоса» (колонка содержимого
//        по центру страницы) | "" (просто блок).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Область(Знач Вид = "") Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "область", Вид);
КонецФункции

// Ряд — элементы в строку с переносом.
//
// Параметры:
//  Вид - Строка - «выбор» (ряд взаимоисключающих кнопок) | «признаки» (ряд плашек)
//        | «свёрнутые» (ряд плашек, у которого хвост убран под раскрывашку)
//        | «справа» (ряд, прижатый к правому краю) | «строкой» (значок и значение
//        в одну строку, без переноса).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Ряд(Знач Вид) Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "ряд", Вид);
КонецФункции

// Раскрывашка — свёрнутая строка отвечает «что это», развёрнутая отдаёт содержимое.
// Шапка наполняется через Шапка(), тело — обычным Добавить().
//
// Параметры:
//  Вид - Строка - «простая» (без единого класса) | «врезка» (карточка в потоке списка)
//        | «подробность» (мелкая строка «подробнее» в ячейке) | «хвост» (свёрнутый
//        остаток ряда плашек) | "" (панель).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Раскрывашка(Знач Вид = "") Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "раскрывашка", Вид);
КонецФункции

// Статья — самостоятельный кусок страницы: его можно вынуть из списка и он останется
// понятным. Тем и отличается от области, что это лендмарк, а не просто блок.
//
// Параметры:
//  Вид - Строка - «карточка» (карточка объекта в списке) | "" (без оформления).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Статья(Знач Вид = "") Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "статья", Вид);
КонецФункции

// Список — перечисление равнозначного; в него кладут пункты.
//
// Параметры:
//  Вид - Строка - «сноска» (мелкий приглушённый список под полем) | "" (обычный).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Список(Знач Вид = "") Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "список", Вид);
КонецФункции

// Пункт списка — холст: пункт бывает и со ссылкой, и с машинным значением внутри.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Пункт() Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "пункт");
КонецФункции

// Свойства объекта — перечисление пар «имя — значение»; в него кладут свойства.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Свойства() Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "свойства");
КонецФункции

// Свойство — пара «имя — значение»: имя приходит подписью, значение собирается детьми.
//
// Параметры:
//  Имя - Строка - имя свойства (экранируется).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Свойство(Знач Имя) Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "свойство").Подпись(Имя);
КонецФункции

// Группа полей — то, что браузер и скринридер считают одним целым.
//
// Параметры:
//  Подпись - Строка - видимая подпись группы; пустая — группа без подписи.
//  Вид     - Строка - вид группы: «набор» (группа-переключатель, которую можно отключить
//            и спрятать целиком) | «простая» (без оформления: группа существует, чтобы
//            отключать и прятать поля вместе) | "" (обычная).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Группа(Знач Подпись = "", Знач Вид = "") Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "группа", Вид).Подпись(Подпись);
КонецФункции

#КонецОбласти

#Область Формы

// Форма, которую отправляет вошедший: POST со скрытым полем CSRF первым ребёнком.
// Без токена не собирается — форма без него выглядит рабочей, а получает 403.
//
// Параметры:
//  Действие - Строка - URL, куда уходит POST.
//  Токен    - Строка - CSRF-токен сессии.
//  Вид      - Строка - «столбик» | «строкой» | «меню» (форма внутри пункта меню)
//             | «переключатель» | "" (без раскладки).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Форма(Знач Действие, Знач Токен, Знач Вид = "") Экспорт

	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		ВызватьИсключение СтрШаблон("Кит: форма на «%1» без CSRF-токена. Передайте токен"
			+ " текущей сессии — иначе форма гарантированно получит 403. Форме посетителя,"
			+ " у которого сессии ещё нет, возьмите ФормаБезСессии; форме, которая на сервере"
			+ " ничего не меняет, — ФормаОтбора; форме, у которой токена не спрашивает"
			+ " сам сервер, — ФормаБезТокена.", Действие);
	КонецЕсли;

	Результат = УзелФормы("форма", Действие, Вид);
	Результат.Добавить(СкрытоеПоле(Каркас.ИмяПоляCSRF(), Токен));
	Возврат Результат;

КонецФункции

// Форма посетителя, у которого сессии ещё нет: вход, регистрация, запрос ссылки на смену
// пароля, установка пароля по одноразовой ссылке. Токена не несёт, потому что его неоткуда
// взять: CSRF-токен живёт В СЕССИИ, и там, где сессии нет, сервер его и не спрашивает.
// Взятая по ошибке на форме вошедшего, она получит от сервера 403 на первой же отправке.
//
// Параметры:
//  Действие - Строка - URL, куда уходит POST.
//  Вид      - Строка - «столбик» | «строкой» | «меню» (форма внутри пункта меню)
//             | «переключатель» | "" (без раскладки).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ФормаБезСессии(Знач Действие, Знач Вид = "") Экспорт
	Возврат УзелФормы("форма-без-сессии", Действие, Вид);
КонецФункции

// Форма отбора: GET, который на сервере ничего не меняет, а значит защищать в нём нечего.
// Отправленный отбор виден в адресе и повторяем ссылкой — это и есть его смысл.
//
// Параметры:
//  Действие - Строка - URL, куда уходит GET.
//  Вид      - Строка - «столбик» | «строкой» | «меню» (форма внутри пункта меню)
//             | «переключатель» | "" (без раскладки).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ФормаОтбора(Знач Действие, Знач Вид = "") Экспорт
	Возврат УзелФормы("форма-отбора", Действие, Вид);
КонецФункции

// Форма, у отправителя которой сессия ЕСТЬ, а сервер токена не спрашивает: цена подделки
// такого запроса — неудобство, а не ущерб (переключить оформление, выйти). Отличается
// от ФормаБезСессии тем, ПОЧЕМУ токена нет: там его неоткуда взять, здесь он не нужен.
// Взятая на форме, которая меняет что-то по-настоящему, она получит от сервера 403
// на первой же отправке: границей безопасности остаётся серверная проверка.
//
// Параметры:
//  Действие - Строка - URL, куда уходит POST.
//  Вид      - Строка - «столбик» | «строкой» | «меню» | «переключатель» | "" (без раскладки).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ФормаБезТокена(Знач Действие, Знач Вид = "") Экспорт
	Возврат УзелФормы("форма-без-токена", Действие, Вид);
КонецФункции

#КонецОбласти

#Область Таблица

// Таблица — раскладка списка: колонки и записи кладутся в неё обычным Добавить().
// Что показать вместо таблицы, когда записей нет, наполняется через Пусто().
//
// Параметры:
//  Вид - Строка - «карточками» (на узком экране запись становится карточкой)
//        | "" (обычная).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Таблица(Знач Вид = "") Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "таблица", Вид);
КонецФункции

// Колонка — заголовок столбца. Холст: заголовок бывает не только текстом.
//
// Параметры:
//  Подпись - Строка - текст заголовка; пустой оставляет колонку без подписи.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Колонка(Знач Подпись = "") Экспорт

	Результат = Новый ЭлементЭкрана(Печать, "колонка");
	Если ЗначениеЗаполнено(Подпись) Тогда
		Результат.Добавить(Текст(Подпись));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Запись — строка таблицы: в неё кладут ячейки. Развёрнутая подробность записи
// наполняется через Разворот() и печатается строкой под ней во всю ширину.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Запись() Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "запись");
КонецФункции

// Ячейка — холст внутри записи: в неё кладут любые элементы, а не готовую разметку.
//
// Параметры:
//  Вид - Строка - «величина» (число с единицей: не переносится, приглушено)
//        | «столбиком» (двухэтажная ячейка: строка значения и приписка под ней)
//        | "" (обычная).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Ячейка(Знач Вид = "") Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "ячейка", Вид);
КонецФункции

#КонецОбласти

#Область Содержимое

// Заголовок первого-шестого уровня. Уровень — не оформление, а место в оглавлении
// страницы, поэтому он задаётся числом, а не видом.
//
// Параметры:
//  Уровень - Число - от 1 до 6.
//  Вид     - Строка - «имя» (имя объекта в его карточке) | "" (без оформления).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Заголовок(Знач Уровень, Знач Вид = "") Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "заголовок", Вид,
		Новый Структура("Уровень", ПроверенныйУровень(Уровень)));

КонецФункции

// Надпись — кусок строки со своей ролью в ней.
//
// Параметры:
//  Вид - Строка - «название» | «пояснение» | «сноска» | «приглушённая» | «ключ»
//        (имя настройки) | «приписка» (мелкая строка под значением) | «заголовок» и «лид»
//        (две первые строки врезки) | «метка» (подпись поля, собранного вручную)
//        | «учётка» (имя вошедшего в шапке страницы) | "" (без оформления).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Надпись(Знач Вид = "") Экспорт
	Возврат Новый ЭлементЭкрана(Печать, "надпись", Вид);
КонецФункции

// Текстовый узел. Экранируется по своей природе: чужой текст разметкой не станет,
// потому что этот узел иначе печатать не умеет.
//
// Параметры:
//  Значение - Произвольный - текст.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Текст(Знач Значение) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "текст", "",
		Новый Структура("Текст", Строка(?(Значение = Неопределено, "", Значение))));

КонецФункции

// Машинное значение моноширинным шрифтом: имя, адрес, ключ.
//
// Параметры:
//  Значение - Произвольный - текст (экранируется).
//  Вид      - Строка - «блочный» (образец в несколько строк, переносы сохраняются)
//             | «приглушённый» (значение, которое не спорит с соседним текстом)
//             | "" (значение внутри строки текста).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Код(Знач Значение, Знач Вид = "") Экспорт

	Результат = Новый ЭлементЭкрана(Печать, "код", Вид);
	Результат.Добавить(Текст(Значение));
	Возврат Результат;

КонецФункции

// Ссылка. Холст: внутрь кладут текст, машинное значение или картинку. Адрес недопустимой
// схемы ссылкой не станет — содержимое останется видимым, кликабельным оно не будет.
//
// Параметры:
//  Адрес - Строка - URL.
//  Вид   - Строка - «пилюля» (ссылка-пилюля в ряду взаимоисключающих)
//          | «пилюля-текущая» (она же, выбранная) | «знак» (ход на главную со знаком
//          инсталляции) | «шапка» (ход в ряду шапки страницы) | "" (обычная).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Ссылка(Знач Адрес, Знач Вид = "") Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "ссылка", Вид,
		Новый Структура("Адрес", Строка(?(Адрес = Неопределено, "", Адрес))));

КонецФункции

// Картинка. Пустой адрес не даёт битого изображения — узел печатается пустой строкой.
// Подпись узла становится alt, подсказка — title: картинка без подписи декоративна.
//
// Параметры:
//  Адрес - Строка - адрес картинки.
//  Вид   - Строка - «значок» (внешняя картинка размером со значок) | «значок-малый»
//          (тот же значок при строке текста) | «превью» (показ загруженного
//          изображения) | «знак» (знак инсталляции в шапке) | "" (без оформления).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Картинка(Знач Адрес, Знач Вид = "") Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "картинка", Вид,
		Новый Структура("Адрес", Строка(?(Адрес = Неопределено, "", Адрес))));

КонецФункции

// Примечание мелким шрифтом. Холст: примечание бывает и со ссылкой, и с машинным
// значением внутри. Без содержимого не печатается вовсе.
//
// Параметры:
//  Значение - Строка - (необязательный) текст примечания; экранируется.
//  Вид      - Строка - «описание» (описание в карточке объекта) | «источник» (откуда
//             взято значение) | «пусто» (список ничего не нашёл) | "" (приглушённый абзац).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Примечание(Знач Значение = "", Знач Вид = "") Экспорт

	Результат = Новый ЭлементЭкрана(Печать, "примечание", Вид);
	Если ЗначениеЗаполнено(Значение) Тогда
		Результат.Добавить(Текст(Значение));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Шаблон — текст с местами %1…%N, которые занимают дети узла в порядке добавления.
// Текст экранируется, дети печатаются разметкой: так фраза остаётся цельной строкой
// для перевода, а вставки в неё собираются деревом.
//
// Параметры:
//  Образец - Строка - текст с местами %1…%N.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Шаблон(Знач Образец) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "шаблон", "",
		Новый Структура("Образец", Строка(?(Образец = Неопределено, "", Образец))));

КонецФункции

// ⚠ Костыль перехода: готовый кусок разметки, собранный не деревом. Существует ради того,
// чтобы переводить экраны по одному, и на виду у ревью: узел ничего не экранирует.
//
// Параметры:
//  Разметка - Строка - ДОВЕРЕННЫЙ HTML: экранированием занят тот, кто его собрал.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Готовое(Знач Разметка) Экспорт

	Возврат Новый ЭлементЭкрана(Печать, "готовое", "",
		Новый Структура("Разметка", Строка(?(Разметка = Неопределено, "", Разметка))));

КонецФункции

#КонецОбласти

#Область Компоненты

// Кнопка формы или ссылка-кнопка.
//
// Параметры:
//  Модель - Структура - модель компонента «Кнопка».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Кнопка(Знач Модель) Экспорт
	Возврат Компонент("кнопка", Набор.Кнопка().Отрисовать(Модель));
КонецФункции

// Плашка — короткий признак: состояние, тип, источник. Содержимое можно собрать детьми:
// они печатаются ВМЕСТО значка и текста модели (слот «Внутри»).
//
// Параметры:
//  Модель - Структура, Строка, Неопределено - модель компонента «Плашка».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Плашка(Знач Модель) Экспорт

	// плашки нет вовсе — узел печатается пустой строкой и детей не ждёт
	Если Модель = Неопределено Тогда
		Возврат Компонент("плашка", "");
	КонецЕсли;

	Возврат КомпонентСоСлотом("плашка", Набор.Тег(),
		?(ТипЗнч(Модель) = Тип("Структура"), Модель, Новый Структура("Текст", Строка(Модель))),
		"Внутри");

КонецФункции

// Поле ввода со своей меткой, подсказкой и отказом.
//
// Параметры:
//  Модель - Структура - модель компонента «Поле».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Поле(Знач Модель) Экспорт
	Возврат Компонент("поле", Набор.Поле().Отрисовать(Модель));
КонецФункции

// Скрытое поле формы.
//
// Параметры:
//  Имя      - Строка - имя поля.
//  Значение - Строка - значение.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция СкрытоеПоле(Знач Имя, Знач Значение) Экспорт

	Возврат Компонент("скрытое", Набор.СкрытоеПоле().Отрисовать(
		Новый Структура("Имя, Значение", Имя, Значение)));

КонецФункции

// Блок копируемой команды.
//
// Параметры:
//  Модель - Структура - модель компонента «Блок команды».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция БлокКоманды(Знач Модель) Экспорт
	Возврат Компонент("команда", Набор.БлокКоманды().Отрисовать(Модель));
КонецФункции

// Карточка — рамка с заголовком; её тело наполняется вложенными элементами.
//
// Параметры:
//  Модель - Структура - модель компонента «Карточка» без поля Тело: тело собирается детьми.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Карточка(Знач Модель) Экспорт
	Возврат КомпонентСоСлотом("карточка", Набор.Карточка(), Модель, "Тело");
КонецФункции

// Опасная зона — необратимые действия; её тело наполняется вложенными элементами.
//
// Параметры:
//  Модель - Структура - модель компонента «Опасная зона» без поля Тело.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ОпаснаяЗона(Знач Модель) Экспорт
	Возврат КомпонентСоСлотом("зона", Набор.ОпаснаяЗона(), Модель, "Тело");
КонецФункции

// Сетка равнозначных блоков: КАЖДЫЙ ребёнок узла становится своей ячейкой.
//
// Параметры:
//  Модель - Структура - модель компонента «Сетка» без поля Ячейки: ячейки собираются детьми.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Сетка(Знач Модель) Экспорт
	Возврат КомпонентСоСписком("сетка", Набор.Сетка(), Модель, "Ячейки");
КонецФункции

// Шапка объекта — первый экран пула, пакета, группы; дети узла становятся её действиями.
//
// Параметры:
//  Модель - Структура - модель компонента «Шапка объекта» без поля Действия.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ШапкаОбъекта(Знач Модель) Экспорт
	Возврат КомпонентСоСлотом("шапка", Набор.ШапкаОбъекта(), Модель, "Действия");
КонецФункции

// Заголовок страницы с пояснением под ним.
//
// Параметры:
//  Модель - Структура, Строка - модель компонента «Заголовок страницы».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ЗаголовокСтраницы(Знач Модель) Экспорт
	Возврат Компонент("заглавие", Набор.ЗаголовокСтраницы().Отрисовать(Модель));
КонецФункции

// Пустое состояние списка: значок, объяснение и призыв к действию.
//
// Параметры:
//  Модель - Структура, Строка - модель компонента «Пустое состояние».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ПустоеСостояние(Знач Модель) Экспорт
	Возврат Компонент("пустое", Набор.ПустоеСостояние().Отрисовать(Модель));
КонецФункции

// Полоса вкладок страницы объекта: каждая вкладка своим адресом.
//
// Параметры:
//  Модель - Структура - модель компонента «Табы».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Табы(Знач Модель) Экспорт
	Возврат Компонент("вкладки", Набор.Табы().Отрисовать(Модель));
КонецФункции

// Строка поиска по списку: поле, кнопка и скрытые поля, сохраняющие остальной отбор.
// От рода «форма-отбора» отличается тем, что собрана целиком: род даёт пустую GET-форму,
// а этот компонент — готовую строку поиска.
//
// Параметры:
//  Модель - Структура - модель компонента «Форма отбора».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция СтрокаПоиска(Знач Модель) Экспорт
	Возврат Компонент("поиск", Набор.ФормаОтбора().Отрисовать(Модель));
КонецФункции

// Постраничная навигация длинного списка.
//
// Параметры:
//  Модель - Структура - модель компонента «Пагинация».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Пагинация(Знач Модель) Экспорт
	Возврат Компонент("страницы", Набор.Пагинация().Отрисовать(Модель));
КонецФункции

// Тело страницы отказа: код состояния и пояснение.
//
// Параметры:
//  Модель - Структура - модель компонента «Страница ошибки».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция СтраницаОшибки(Знач Модель) Экспорт
	Возврат Компонент("отказ", Набор.СтраницаОшибки().Отрисовать(Модель));
КонецФункции

// Список шагов многошаговой задачи.
//
// Параметры:
//  Модель - Структура - модель компонента «Проводник».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Проводник(Знач Модель) Экспорт
	Возврат Компонент("шаги", Набор.Проводник().Отрисовать(Модель));
КонецФункции

// Значок из набора иконок.
//
// Параметры:
//  Модель - Структура, Строка - имя значка либо модель компонента «Иконка».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Иконка(Знач Модель) Экспорт
	Возврат Компонент("иконка", Набор.Иконка().Отрисовать(Модель));
КонецФункции

// Ряд плашек одним элементом: они стоят в строку и переносятся вместе.
//
// Параметры:
//  Список - Массив - модели компонента «Плашка».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция РядПлашек(Знач Список) Экспорт
	Возврат Компонент("плашки", Набор.Тег().Ряд(Список));
КонецФункции

// Ряд метаданных: пары «значок + значение» в строку.
//
// Параметры:
//  Элементы - Массив из Структура - Подпись, Значение, Значок, Адрес.
//  Вид      - Строка - «шапка» (ряд в шапке объекта) | «карточка» (ряд в карточке объекта).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция РядМеты(Знач Элементы, Знач Вид) Экспорт

	Классы = Печать.КлассыМеты(Вид);
	Возврат Компонент("мета",
		Набор.РядМеты().Отрисовать(Элементы, Классы.Ряд, Классы.Элемент));

КонецФункции

// Полоса заполнения — доля занятого от предела.
//
// Параметры:
//  Модель - Структура - модель компонента «Полоса заполнения».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ПолосаЗаполнения(Знач Модель) Экспорт
	Возврат Компонент("полоса", Набор.ПолосаЗаполнения().Отрисовать(Модель));
КонецФункции

// Тумблер — поле выбора из двух состояний.
//
// Параметры:
//  Модель - Структура - модель компонента «Тумблер».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Тумблер(Знач Модель) Экспорт
	Возврат Компонент("тумблер", Набор.Тумблер().Отрисовать(Модель));
КонецФункции

// Меню — кнопка-открывашка и панель пунктов при ней.
//
// Параметры:
//  Модель - Структура - модель компонента «Меню».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Меню(Знач Модель) Экспорт
	Возврат Компонент("меню", Набор.Меню().Отрисовать(Модель));
КонецФункции

// Поле, значение которого задано конфигурацией: показывается, но не правится.
//
// Параметры:
//  Модель - Структура - модель компонента «Поле из конфига».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ПолеИзКонфига(Знач Модель) Экспорт
	Возврат Компонент("поле-конфига", Набор.ПолеИзКонфига().Отрисовать(Модель));
КонецФункции

// Плитка — сводный показатель одним числом.
//
// Параметры:
//  Модель - Структура - модель компонента «Плитка».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Плитка(Знач Модель) Экспорт
	Возврат Компонент("плитка", Набор.Плитка().Отрисовать(Модель));
КонецФункции

// Уведомление о результате действия; компонент называется «Тост».
//
// Параметры:
//  Модель - Структура, Строка - модель компонента «Тост».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Уведомление(Знач Модель) Экспорт
	Возврат Компонент("уведомление", Набор.Тост().Отрисовать(Модель));
КонецФункции

// Дерево разделов — навигация по дому настроек.
//
// Параметры:
//  Модель - Структура - модель компонента «Дерево разделов».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ДеревоРазделов(Знач Модель) Экспорт
	Возврат Компонент("разделы", Набор.ДеревоРазделов().Отрисовать(Модель));
КонецФункции

// Панель сохранения — липкая полоса с кнопкой «Сохранить».
//
// Параметры:
//  Модель - Структура - (необязательный) модель компонента «Панель сохранения».
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ПанельСохранения(Знач Модель = Неопределено) Экспорт
	Возврат Компонент("панель", Набор.ПанельСохранения().Отрисовать(Модель));
КонецФункции

#КонецОбласти

#Область ОбъявленныеФормы

// Объявленная форма: она знает свои поля и умеет разобрать пришедшее, поэтому входит
// в дерево узлом-компонентом, а не переписывается родами кита.
//
// Параметры:
//  Объявление  - ОбъявлениеФормы - объявленный состав формы.
//  Действующие - Структура, Соответствие - значения полей.
//  Действие    - Строка - URL, куда уходит POST.
//  Токен       - Строка - CSRF-токен сессии.
//  Вид         - Строка - «столбик» | «строкой» | "" (без раскладки).
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция ОбъявленнаяФорма(Знач Объявление, Знач Действующие, Знач Действие,
	Знач Токен = "", Знач Вид = "") Экспорт

	Возврат Компонент("объявление", Объявление.Отрисовать(Действующие, Действие, Токен,
		Печать.КлассВида("форма", Вид)));

КонецФункции

// Объявленная форма, показанная окном поверх экрана.
//
// Параметры:
//  Объявление  - ОбъявлениеФормы - объявленный состав формы.
//  Действующие - Структура, Соответствие - значения полей.
//  Действие    - Строка - URL, куда уходит POST.
//  Токен       - Строка - CSRF-токен сессии.
//  Свойства    - Структура - свойства окна: Заголовок, Открывашка, Кнопка, Отмена, Класс.
//
// Возвращаемое значение:
//  ЭлементЭкрана
//
Функция Окно(Знач Объявление, Знач Действующие, Знач Действие, Знач Токен, Знач Свойства) Экспорт

	Возврат Компонент("окно",
		Объявление.ОтрисоватьВОкне(Действующие, Действие, Токен, Свойства));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УзелФормы(Знач Род, Знач Действие, Знач Вид)

	Возврат Новый ЭлементЭкрана(Печать, Род, Вид,
		Новый Структура("Действие", Строка(?(Действие = Неопределено, "", Действие))));

КонецФункции

// Компонент печатает себя целиком и от места в дереве не зависит, поэтому его разметка
// собирается сразу. От «готового» узла отличается тем, что назван: в дереве экрана видно
// «компонент[кнопка]», а не безымянный кусок HTML.
Функция Компонент(Знач Вид, Знач Разметка)

	Возврат Новый ЭлементЭкрана(Печать, "компонент", Вид,
		Новый Структура("Разметка", Строка(?(Разметка = Неопределено, "", Разметка))));

КонецФункции

// Компонент со слотом рисуется не сейчас, а на печати: содержимое слота — это дети узла,
// а их к моменту создания ещё нет.
Функция КомпонентСоСлотом(Знач Вид, Знач Рисователь, Знач Модель, Знач Слот)

	Возврат Новый ЭлементЭкрана(Печать, "компонент", Вид,
		Новый Структура("Рисователь, Модель, Слот", Рисователь, Модель, Слот));

КонецФункции

// Слот-список: компонент раскладывает детей сам, поэтому получает их по одному, а не
// склеенной строкой — склеенная стала бы одной ячейкой на всех.
Функция КомпонентСоСписком(Знач Вид, Знач Рисователь, Знач Модель, Знач Слот)

	Возврат Новый ЭлементЭкрана(Печать, "компонент", Вид,
		Новый Структура("Рисователь, Модель, Слот, СлотСписком",
			Рисователь, Модель, Слот, Истина));

КонецФункции

Функция ПроверенныйУровень(Знач Уровень)

	Попытка
		Номер = Цел(Число(Уровень));
	Исключение
		Номер = 0;
	КонецПопытки;

	Если Номер < 1 ИЛИ Номер > 6 Тогда
		ВызватьИсключение СтрШаблон("Кит: заголовок уровня «%1» не бывает — уровень"
			+ " от 1 до 6. Уровень задаёт место заголовка в оглавлении страницы, и пропуск"
			+ " уровня ломает его для скринридера.", Уровень);
	КонецЕсли;

	Возврат Номер;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РазметкаЭлементов") _Печать,
	&Пластилин(Значение = "НаборКомпонентов") _Набор,
	&Пластилин(Значение = "РендерерНастроек") _Каркас) Экспорт

	Печать = _Печать;
	Набор = _Набор;
	Каркас = _Каркас;

КонецПроцедуры
