		+ " Подписи");
	ОбъявитьСлова("панель", "Подпись, Пояснение, АдресОтмены, Опасное, Иконка, Заблокирована, Имя");
	ОбъявитьСлова("полоса", "Метка, Подпись, Вид, Компактная");
	ОбъявитьСлова("поле-конфига", "Метка, Значение, Подсказка, Секрет");
	ОбъявитьСлова("дерево-галок", "Подпись");
	ОбъявитьСлова("крошки", "Подпись");
	ОбъявитьСлова("крошка", "Подпись, Адрес");
	ОбъявитьСлова("разделы", "Заголовок");
	ОбъявитьСлова("окно-по-адресу", "Подпись, Основная, Вторичная, Опасная, Ссылкой, Малая, Большая,"
		+ " Иконка, ТолькоИконка, Подсказка");
	ОбъявитьСлова("шаги", "");
	ОбъявитьСлова("отказ", "");
