	ОбъявитьСлова("секция", "Лид, Иконка, Форма, Кнопка, ИконкаКнопки, ИмяКнопки, ПояснениеПанели,"
		+ " АдресОтмены, Опасная, Заблокирована, БезПанели, СФайлами, Свёрнута, Раскрыта, Якорь");
