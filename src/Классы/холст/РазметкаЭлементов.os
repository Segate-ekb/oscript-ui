	ОбъявитьСлова("реестр", "Нумерованный");
	ОбъявитьСлова("запись-реестра", "Значок, Картинка, Плашка, Подпись, Факт, Номер, Открыть");

	ВторыеКомпонентов = Новый Соответствие();
	ПоляВторыхХолстов = Новый Соответствие();
	ВторыеКомпонентов.Вставить("карточка", "действия");
	ПоляВторыхХолстов.Вставить("карточка", "Действия");

	ДетиКомпонентов = Новый Соответствие();
	ДетиКомпонентов.Вставить("вкладки", "вкладка");
	ДетиКомпонентов.Вставить("крошки", "крошка");
	ФабрикиДетей = Новый Соответствие();
	ФабрикиДетей.Вставить("вкладка", "Кит.Вкладка");
	ФабрикиДетей.Вставить("крошка", "Кит.Крошка");

КонецПроцедуры

Процедура ОбъявитьСлова(Знач Носитель, Знач Слова)

	Известные = Новый Соответствие();
	Для Каждого Слово Из СтрРазделить(Слова, ",", Ложь) Цикл
		Известные.Вставить(СокрЛП(Слово), Истина);
	КонецЦикла;
	СловаНосителей.Вставить(Носитель, Известные);

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЭкранированиеHTML") _Экран) Экспорт

	Экран = _Экран;
	Типы = Новый ТипыПоля();
	СобратьНаборы();

КонецПроцедуры
