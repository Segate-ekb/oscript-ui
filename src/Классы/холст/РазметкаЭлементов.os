// Разметка элементов — желудь UI-кита: единственное место, где узел дерева становится
// тегом и классом. Вид узла — значение из закрытого набора; имя класса за пределы этого
// файла не выходит, поэтому снятый вид уносит своё правило вместе с собой.

Перем Экран;        // ЭкранированиеHTML
Перем Контейнеры;   // Соответствие: род -> Булево (можно ли внутрь)
Перем Теги;         // Соответствие: род -> имя тега ("" — узел печатает только детей)
Перем КлассыВида;   // Соответствие: род -> Соответствие: вид -> CSS-класс
Перем ВторыеХолсты; // Соответствие: род -> имя второго холста узла
Перем ДетиРодов;    // Соответствие: род -> Соответствие: род ребёнка -> Истина
Перем КлассыШапки;  // Соответствие: вид раскрывашки -> CSS-класс её свёрнутой строки
Перем КлассыТела;   // Соответствие: вид раскрывашки -> CSS-класс её тела
Перем КлассыМетыПоВиду; // Соответствие: вид ряда метаданных -> Структура(Ряд, Элемент)
Перем РолиARIA;     // Соответствие: имя роли на русском -> значение атрибута role

#Область ПубличныйИнтерфейс

// Роды узлов, которые кит умеет печатать.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Роды() Экспорт

	Результат = Новый Массив();
	Для Каждого КиЗ Из Теги Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Виды, известные роду узла.
//
// Параметры:
//  Род - Строка - род узла.
//
// Возвращаемое значение:
//  Массив из Строка - "" в списке означает «без вида»; пустой список — рода кит не знает.
//
Функция ВидыРода(Знач Род) Экспорт

	Результат = Новый Массив();
	Известные = КлассыВида.Получить(Род);
	Если Известные = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого КиЗ Из Известные Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имя тега, которым печатается род узла.
//
// Параметры:
//  Род - Строка - род узла.
//
// Возвращаемое значение:
//  Строка - имя тега; "" — узел печатает только детей.
//
Функция ТегРода(Знач Род) Экспорт
	Возврат Строка(Теги.Получить(Род));
КонецФункции

// Может ли узел принимать вложенные элементы.
//
// Параметры:
//  Род  - Строка - род узла.
//  Поля - Структура, Неопределено - (необязательный) свойства узла: компонент пускает
//         внутрь ровно тогда, когда у него объявлен слот.
//
// Возвращаемое значение:
//  Булево
//
Функция Контейнер(Знач Род, Знач Поля = Неопределено) Экспорт

	Если Контейнеры.Получить(Род) = Истина Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЗначениеЗаполнено(ИмяСлота(Поля));

КонецФункции

// Имя второго холста узла: раскрывашка печатает «шапку» перед телом, запись таблицы —
// «разворот» под собой, таблица — «пусто» вместо себя.
//
// Параметры:
//  Род - Строка - род узла.
//
// Возвращаемое значение:
//  Строка - имя второго холста либо "" — второго холста у рода нет.
//
Функция ВторойХолстРода(Знач Род) Экспорт
	Возврат Строка(ВторыеХолсты.Получить(Род));
КонецФункции

// Проверяет, что вид известен роду узла. Неизвестный вид не печатается пустым классом —
// он останавливает сборку: иначе опечатка в виде даёт молча неоформленный экран.
//
// Параметры:
//  Род - Строка - род узла.
//  Вид - Строка - вид узла.
//
Процедура ПроверитьВид(Знач Род, Знач Вид) Экспорт

	Известные = КлассыВида.Получить(Род);
	Если Известные <> Неопределено И Известные.Получить(Вид) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Разметка элементов: узел «%1» вида «%2» не знает."
		+ " Вид — значение из закрытого набора кита, а не имя CSS-класса; этот род знает"
		+ " виды: %3 (пусто — рода «%1» кит не знает вовсе, «—» значит «без вида»).",
		Род, Вид, ИзвестныеВиды(Род));

КонецПроцедуры

// Проверяет, что ребёнок такого рода в таком родителе бывает. Узел, которого родитель
// не печатает, исчез бы с экрана молча.
//
// Параметры:
//  Род        - Строка - род родителя.
//  РодРебёнка - Строка - род ребёнка.
//
Процедура ПроверитьВложение(Знач Род, Знач РодРебёнка) Экспорт

	Допустимые = ДетиРодов.Получить(Род);
	Если Допустимые = Неопределено ИЛИ Допустимые.Получить(РодРебёнка) = Истина Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Разметка элементов: внутрь узла «%1» кладут только %2,"
		+ " а не «%3»: узел чужого рода этот родитель не печатает, и содержимое молча"
		+ " исчезло бы с экрана.", Род, СтрСоединить(ПеречислитьКлючи(Допустимые), " и "),
		РодРебёнка);

КонецПроцедуры

// CSS-класс, которым печатается вид узла. Нужен там, где дерево передаёт оформление
// слою компонентов: имя класса не выходит за границу кита и здесь.
//
// Параметры:
//  Род - Строка - род узла.
//  Вид - Строка - вид узла.
//
// Возвращаемое значение:
//  Строка - имя класса; "" — вид без оформления.
//
Функция КлассВида(Знач Род, Знач Вид) Экспорт

	Значение = НРег(СокрЛП(Строка(?(Вид = Неопределено, "", Вид))));
	ПроверитьВид(Род, Значение);
	Возврат Строка(КлассыВида.Получить(Род).Получить(Значение));

КонецФункции

// Классы ряда метаданных: сам ряд и один его элемент оформляются вместе.
//
// Параметры:
//  Вид - Строка - «шапка» | «карточка».
//
// Возвращаемое значение:
//  Структура - Ряд, Элемент: имена CSS-классов.
//
Функция КлассыМеты(Знач Вид) Экспорт

	Значение = НРег(СокрЛП(Строка(?(Вид = Неопределено, "", Вид))));
	Классы = КлассыМетыПоВиду.Получить(Значение);
	Если Классы <> Неопределено Тогда
		Возврат Классы;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Разметка элементов: ряда метаданных вида «%1» не бывает."
		+ " Ряд метаданных стоит либо в шапке объекта, либо в его карточке, и оформление"
		+ " у этих двух мест разное; известные виды: %2.",
		Значение, СтрСоединить(ПеречислитьКлючи(КлассыМетыПоВиду), ", "));

КонецФункции

// Форма ли это. Три рода формы отличаются защитой отправленного запроса, но тег и
// свойства у них общие.
//
// Параметры:
//  Род - Строка - род узла.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоФорма(Знач Род) Экспорт
	Возврат Род = "форма" ИЛИ Род = "форма-без-сессии" ИЛИ Род = "форма-отбора"
		ИЛИ Род = "форма-без-токена";
КонецФункции

// Значение атрибута role по русскому имени роли.
//
// Параметры:
//  Значение - Строка - имя роли.
//
// Возвращаемое значение:
//  Строка - значение атрибута role.
//
Функция РольARIA(Знач Значение) Экспорт

	Ключ = НРег(СокрЛП(Строка(?(Значение = Неопределено, "", Значение))));
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат "";
	КонецЕсли;

	Роль = РолиARIA.Получить(Ключ);
	Если Роль = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Разметка элементов: роль «%1» киту неизвестна."
			+ " Роль скринридера — значение из набора кита, а не произвольная строка.", Ключ);
	КонецЕсли;

	Возврат Роль;

КонецФункции

// Печатает узел и всё, что внутри него.
//
// Параметры:
//  Элемент - ЭлементЭкрана - узел дерева.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент.
//
Функция Узел(Знач Элемент) Экспорт

	Род = Элемент.Род();

	Если Род = "текст" Тогда
		Возврат Экран.Экранировать(Элемент.Свойства().Текст);
	ИначеЕсли Род = "документ" Тогда
		Возврат Документ(Элемент);
	ИначеЕсли Род = "мета" Тогда
		Возврат Мета(Элемент);
	ИначеЕсли Род = "ресурс" Тогда
		Возврат Ресурс(Элемент);
	ИначеЕсли Род = "стиль" Тогда
		Возврат Стиль(Элемент);
	ИначеЕсли Род = "скрипт" Тогда
		Возврат Скрипт(Элемент);
	ИначеЕсли Род = "готовое" Тогда
		Возврат Строка(Элемент.Свойства().Разметка);
	ИначеЕсли Род = "компонент" Тогда
		Возврат Компонент(Элемент);
	ИначеЕсли Род = "картинка" Тогда
		Возврат Картинка(Элемент);
	ИначеЕсли Род = "раскрывашка" Тогда
		Возврат Раскрывашка(Элемент);
	ИначеЕсли Род = "группа" Тогда
		Возврат ГруппаПолей(Элемент);
	ИначеЕсли Род = "ссылка" Тогда
		Возврат Ссылка(Элемент);
	ИначеЕсли Род = "заголовок" Тогда
		Возврат Заголовок(Элемент);
	ИначеЕсли Род = "примечание" Тогда
		Возврат Примечание(Элемент);
	ИначеЕсли Род = "шаблон" Тогда
		Возврат Шаблон(Элемент);
	ИначеЕсли Род = "таблица" Тогда
		Возврат Таблица(Элемент);
	ИначеЕсли Род = "колонка" Тогда
		Возврат Колонка(Элемент);
	ИначеЕсли Род = "код" Тогда
		Возврат Код(Элемент);
	ИначеЕсли Род = "свойство" Тогда
		Возврат Свойство(Элемент);
	ИначеЕсли ЭтоФорма(Род) Тогда
		Возврат Форма(Элемент);
	КонецЕсли;

	Тег = Теги.Получить(Род);
	Если НЕ ЗначениеЗаполнено(Тег) Тогда
		Возврат Внутренности(Элемент);
	КонецЕсли;

	Возврат СтрШаблон("<%1%2>%3</%1>", Тег, Атрибуты(Элемент), Внутренности(Элемент));

КонецФункции

// Построчное дерево узла: из чего собран этот кусок экрана.
//
// Параметры:
//  Элемент - ЭлементЭкрана - узел дерева.
//  Отступ  - Число         - глубина вложенности.
//
// Возвращаемое значение:
//  Строка - строки вида «  ряд[выбор]».
//
Функция Ветка(Знач Элемент, Знач Отступ) Экспорт

	Вид = Строка(Элемент.Свойства().Вид);
	Результат = Отступы(Отступ) + Элемент.Род()
		+ ?(ЗначениеЗаполнено(Вид), "[" + Вид + "]", "") + Символы.ПС;

	Второй = Элемент.ВторойХолст();
	Если Второй <> Неопределено Тогда
		Результат = Результат + Отступы(Отступ + 1) + Элемент.ИмяВторогоХолста() + Символы.ПС;
		Для Каждого Ребёнок Из Второй.Дети() Цикл
			Результат = Результат + Ветка(Ребёнок, Отступ + 2);
		КонецЦикла;
	КонецЕсли;

	Для Каждого Ребёнок Из Элемент.Дети() Цикл
		Результат = Результат + Ветка(Ребёнок, Отступ + 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ОбщаяРазметка

Функция Отступы(Знач Глубина)

	Результат = "";
	Для Шаг = 1 По Глубина Цикл
		Результат = Результат + "  ";
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Дети склеиваются через массив, а не «строка = строка + кусок»: сложение в цикле
// переписывает всё накопленное на каждом шаге, и длинный список детей обходится квадратом.
// Замер на дереве из 20 000 узлов: печать 2361 мс сложением против 398 мс соединением.
Функция Внутренности(Знач Элемент)

	Части = Новый Массив();
	Для Каждого Ребёнок Из Элемент.Состав() Цикл
		Части.Добавить(Узел(Ребёнок));
	КонецЦикла;
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция Атрибуты(Знач Элемент, Знач ДобавочныйКласс = "")

	Поля = Элемент.Свойства();
	Результат = АтрибутКласса(СоединитьКлассы(Класс(Элемент), ДобавочныйКласс));

	Роль = Строка(Поля.Роль);
	Если ЗначениеЗаполнено(Роль) Тогда
		Результат = Результат + Экран.Атрибут("role", Роль);
	КонецЕсли;

	Имя = ДоступноеИмя(Элемент);
	Если ЗначениеЗаполнено(Имя) Тогда
		Результат = Результат + Экран.Атрибут("aria-label", Имя);
	КонецЕсли;

	Подсказка = Строка(Поля.Подсказка);
	Если ЗначениеЗаполнено(Подсказка) Тогда
		Результат = Результат + Экран.Атрибут("title", Подсказка);
	КонецЕсли;

	// признак печатается ДАЖЕ ПУСТЫМ: по нему скрипт находит элемент, и пропавший
	// `data-набор=""` тихо выключает переключение того набора, у которого ключ пуст
	Признаки = Элемент.Признаки();
	Если Признаки <> Неопределено Тогда
		Для Каждого КиЗ Из Признаки Цикл
			Результат = Результат + Экран.АтрибутВсегда("data-" + КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;

	Если Поля.Отключён = Истина Тогда
		Результат = Результат + " disabled";
	КонецЕсли;
	Если Поля.Скрыт = Истина Тогда
		Результат = Результат + " hidden";
	КонецЕсли;
	Если Поля.Открыта = Истина Тогда
		Результат = Результат + " open";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Класс печатается без санитайзера намеренно: его значение приходит НЕ из данных, а из
// закрытой таблицы видов этого же файла — там нет ни кавычки, ни пробела.
Функция АтрибутКласса(Знач Класс)
	Возврат ?(ЗначениеЗаполнено(Класс), СтрШаблон(" class=""%1""", Класс), "");
КонецФункции

Функция СоединитьКлассы(Знач Первый, Знач Второй)

	Имена = Новый Массив();
	Если ЗначениеЗаполнено(Первый) Тогда
		Имена.Добавить(Первый);
	КонецЕсли;
	Если ЗначениеЗаполнено(Второй) Тогда
		Имена.Добавить(Второй);
	КонецЕсли;
	Возврат СтрСоединить(Имена, " ");

КонецФункции

// Подпись ряда человеку не видна — она называет ряд скринридеру. У группы полей та же
// подпись видима и печатается легендой, у таблицы — заголовком, поэтому вторым именем
// они не дублируются.
Функция ДоступноеИмя(Знач Элемент)
	Возврат ?(Элемент.Род() = "ряд", Строка(Элемент.Свойства().Подпись), "");
КонецФункции

Функция Класс(Знач Элемент)
	Известные = КлассыВида.Получить(Элемент.Род());
	Возврат ?(Известные = Неопределено, "",
		Строка(Известные.Получить(Строка(Элемент.Свойства().Вид))));
КонецФункции

#КонецОбласти

#Область РазметкаРодов

// Раскрывашка — нативный <details>: свёрнутая строка отвечает «что это», развёрнутая
// отдаёт содержимое. Раскрытие работает без единой строки скрипта. Доступное имя вешается
// на свёрнутую строку: скринридер называет ею всю раскрывашку.
Функция Раскрывашка(Знач Элемент)

	Вид = Строка(Элемент.Свойства().Вид);
	Подпись = Строка(Элемент.Свойства().Подпись);

	Возврат СтрШаблон("<details%1><summary%2%3>%4</summary><div%5>%6</div></details>",
		Атрибуты(Элемент),
		АтрибутКласса(Строка(КлассыШапки.Получить(Вид))),
		?(ЗначениеЗаполнено(Подпись), Экран.Атрибут("aria-label", Подпись), ""),
		Внутренности(Элемент.Шапка()),
		АтрибутКласса(Строка(КлассыТела.Получить(Вид))),
		Внутренности(Элемент));

КонецФункции

// Свойство печатается ПАРОЙ тегов: имя и значение — соседи в списке определений, вложить
// одно в другое нельзя. Своего тега у пары нет, поэтому род объявлен без него.
Функция Свойство(Знач Элемент)

	Возврат СтрШаблон("<dt>%1</dt><dd%2>%3</dd>",
		Экран.Экранировать(Элемент.Свойства().Подпись),
		Атрибуты(Элемент), Внутренности(Элемент));

КонецФункции

// Блочный код сохраняет переносы и отступы образца, поэтому печатается внутри <pre>:
// у обычного <code> они схлопнутся в пробелы.
Функция Код(Знач Элемент)

	Внутри = Внутренности(Элемент);
	Если Строка(Элемент.Свойства().Вид) <> "блочный" Тогда
		Возврат СтрШаблон("<code%1>%2</code>", Атрибуты(Элемент), Внутри);
	КонецЕсли;

	Возврат СтрШаблон("<pre%1><code>%2</code></pre>", Атрибуты(Элемент), Внутри);

КонецФункции

// Легенда печатается ВНУТРИ группы первой строкой: подпись группы полей видима, и по
// спецификации HTML она обязана быть первым ребёнком fieldset.
Функция ГруппаПолей(Знач Элемент)

	Подпись = Строка(Элемент.Свойства().Подпись);
	Легенда = ?(ЗначениеЗаполнено(Подпись),
		СтрШаблон("<legend>%1</legend>", Экран.Экранировать(Подпись)), "");

	Возврат СтрШаблон("<fieldset%1>%2%3</fieldset>",
		Атрибуты(Элемент), Легенда, Внутренности(Элемент));

КонецФункции

// Форма без адреса действия отправляла бы запрос на текущую страницу — молча и не туда.
// Метод берётся у рода: отбор спрашивает и идёт GET, остальные меняют и идут POST.
Функция Форма(Знач Элемент)

	Действие = Строка(Элемент.Свойства().Действие);
	Если НЕ ЗначениеЗаполнено(Действие) Тогда
		ВызватьИсключение СтрШаблон("Разметка элементов: узел «%1» без Действия —"
			+ " запрос некуда отправлять.", Элемент.Род());
	КонецЕсли;

	// без enctype браузер отправляет вместо файла одно его имя — и сервер получает
	// пустую загрузку, ничего не сказав человеку
	Файлы = ?(Элемент.Свойства().Файлы = Истина,
		" enctype=""multipart/form-data""", "");

	Возврат СтрШаблон("<form method=""%1"" action=""%2""%3%4>%5</form>",
		МетодФормы(Элемент.Род()), Экран.Экранировать(Действие),
		Файлы, Атрибуты(Элемент), Внутренности(Элемент));

КонецФункции

// Пустой адрес картинки не даёт битого <img>: узел печатается пустой строкой. Размеры
// печатаются атрибутами, чтобы страница не прыгала, пока лист стилей ещё едет. Подпись
// узла становится alt: картинка без подписи декоративна, и скринридер её пропускает.
Функция Картинка(Знач Элемент)

	Адрес = Строка(Элемент.Свойства().Адрес);
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат "";
	КонецЕсли;

	Подсказка = Строка(Элемент.Свойства().Подсказка);
	Возврат СтрШаблон("<img%1 src=""%2"" alt=""%3""%4%5%6>",
		АтрибутКласса(Класс(Элемент)), Экран.Экранировать(Адрес),
		Экран.Экранировать(Элемент.Свойства().Подпись),
		?(ЗначениеЗаполнено(Подсказка), Экран.Атрибут("title", Подсказка), ""),
		Размер("width", Элемент.Свойства().Ширина),
		Размер("height", Элемент.Свойства().Высота));

КонецФункции

Функция Размер(Знач Имя, Знач Пикселей)

	Значение = Целое(Пикселей);
	Возврат ?(Значение > 0,
		СтрШаблон(" %1=""%2""", Имя, Формат(Значение, "ЧН=; ЧГ=0")), "");

КонецФункции

Функция Целое(Знач Значение)

	Попытка
		Возврат Цел(Число(Значение));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Ссылка без содержимого не печатается вовсе: пустой <a> кликабелен, но не назван — для
// скринридера это ссылка в никуда. Адрес недопустимой схемы снимает саму ссылку, оставляя
// содержимое видимым: `javascript:` не доедет до href ни при какой сборке дерева.
Функция Ссылка(Знач Элемент)

	Внутри = Внутренности(Элемент);
	Если НЕ ЗначениеЗаполнено(Внутри) Тогда
		Возврат "";
	КонецЕсли;

	Адрес = Строка(Элемент.Свойства().Адрес);
	Если НЕ Экран.URLБезопасенДляHref(Адрес) Тогда
		Возврат Внутри;
	КонецЕсли;

	Возврат СтрШаблон("<a href=""%1""%2>%3</a>",
		Экран.Экранировать(Адрес), Атрибуты(Элемент), Внутри);

КонецФункции

// Заголовок без содержимого не печатается: безымянный заголовок бессмыслен и для читателя,
// и для скринридера, а в оглавлении страницы он остаётся дырой.
Функция Заголовок(Знач Элемент)

	Внутри = Внутренности(Элемент);
	Если НЕ ЗначениеЗаполнено(Внутри) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("<h%1%2>%3</h%1>",
		Формат(Элемент.Свойства().Уровень, "ЧН=; ЧГ=0"), Атрибуты(Элемент), Внутри);

КонецФункции

// Примечание без содержимого не печатается: пустой абзац отбивает соседей друг от друга
// на пустом месте.
Функция Примечание(Знач Элемент)

	Внутри = Внутренности(Элемент);
	Возврат ?(ЗначениеЗаполнено(Внутри),
		СтрШаблон("<p%1>%2</p>", Атрибуты(Элемент), Внутри), "");

КонецФункции

// Компонент печатает себя целиком. Без слота его разметка собрана заранее; со слотом
// компонент рисуется здесь, потому что до печати детей содержимого слота ещё нет.
Функция Компонент(Знач Элемент)

	Поля = Элемент.Свойства();
	Слот = ИмяСлота(Поля);
	Если НЕ ЗначениеЗаполнено(Слот) Тогда
		Возврат Строка(Поля.Разметка);
	КонецЕсли;

	Модель = КопияМодели(Поля.Модель);
	Модель.Вставить(Слот, СодержимоеСлота(Элемент, Поля));
	Возврат Строка(Поля.Рисователь.Отрисовать(Модель));

КонецФункции

// Слот бывает одним куском разметки (тело карточки) и списком кусков по ребёнку на
// каждый (ячейки сетки): компонент, который раскладывает детей сам, из склеенной строки
// сделал бы одну ячейку на всех.
Функция СодержимоеСлота(Знач Элемент, Знач Поля)

	Список = Ложь;
	Если НЕ (Поля.Свойство("СлотСписком", Список) И Список = Истина) Тогда
		Возврат Внутренности(Элемент);
	КонецЕсли;

	Части = Новый Массив();
	Для Каждого Ребёнок Из Элемент.Состав() Цикл
		Части.Добавить(Узел(Ребёнок));
	КонецЦикла;
	Возврат Части;

КонецФункции

// Модель копируется, а не дополняется на месте: структура пришла от вызывающего,
// и слот, дописанный в неё, всплыл бы у него при следующей сборке.
Функция КопияМодели(Знач Модель)

	Результат = Новый Структура();
	Если ТипЗнч(Модель) = Тип("Структура") Тогда
		Для Каждого КиЗ Из Модель Цикл
			Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ИмяСлота(Знач Поля)

	Значение = "";
	Если Поля = Неопределено ИЛИ НЕ Поля.Свойство("Слот", Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(?(Значение = Неопределено, "", Значение));

КонецФункции

Функция МетодФормы(Знач Род)
	Возврат ?(Род = "форма-отбора", "get", "post");
КонецФункции


#КонецОбласти

#Область РазметкаДокумента

// Документ — единственный узел, у которого перед тегом стоит объявление типа. Язык
// и тема печатаются атрибутами <html>: язык читает скринридер и переносчик слов,
// а тема нужна ДО листа стилей, иначе страница мигнёт чужими цветами.
Функция Документ(Знач Элемент)

	Поля = Элемент.Свойства();
	// пустой язык не объявляется вовсе: lang="" для скринридера хуже, чем его отсутствие
	Возврат "<!DOCTYPE html>" + Символы.ПС
		+ СтрШаблон("<html%1%2>%3</html>",
			Экран.Атрибут("lang", Поля.Язык), Экран.Атрибут("data-theme", Поля.Тема),
			Внутренности(Элемент));

КонецФункции

// Мета печатается в одном из двух видов: объявление кодировки либо пара «имя —
// содержание». Третьего в <head> этой страницы не бывает.
Функция Мета(Знач Элемент)

	Поля = Элемент.Свойства();
	Кодировка = Строка(Поля.Кодировка);
	Если ЗначениеЗаполнено(Кодировка) Тогда
		Возврат СтрШаблон("<meta charset=""%1"">", Экран.Экранировать(Кодировка));
	КонецЕсли;

	Возврат СтрШаблон("<meta name=""%1"" content=""%2"">",
		Экран.Экранировать(Поля.Имя), Экран.Экранировать(Поля.Содержание));

КонецФункции

// Ресурс без адреса не печатается: <link> в никуда браузер всё равно запросит.
Функция Ресурс(Знач Элемент)

	Поля = Элемент.Свойства();
	Адрес = Строка(Поля.Адрес);
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("<link rel=""%1""%2%3 href=""%4"">",
		Экран.Экранировать(Поля.Отношение),
		Экран.Атрибут("type", Поля.Тип),
		Экран.Атрибут("sizes", Поля.Размеры),
		Экран.Экранировать(Адрес));

КонецФункции

// Правила печатаются как есть: внутри <style> живёт CSS, и HTML-экранирование там
// не защищает, а ломает. Значение обязан провалидировать тот, кто его собрал.
Функция Стиль(Знач Элемент)

	Поля = Элемент.Свойства();
	Возврат СтрШаблон("<style%1>%2</style>",
		Экран.Атрибут("id", Поля.Имя), Строка(Поля.Правила));

КонецФункции

// Скрипт страницы всегда отложенный: разбор разметки он не останавливает, а порядок
// исполнения сохраняет.
Функция Скрипт(Знач Элемент)

	Адрес = Строка(Элемент.Свойства().Адрес);
	Возврат ?(ЗначениеЗаполнено(Адрес),
		СтрШаблон("<script src=""%1"" defer></script>", Экран.Экранировать(Адрес)), "");

КонецФункции

#КонецОбласти

#Область РазметкаШаблона

// Дети занимают места %1…%N в тексте шаблона. Сам текст экранируется, дети — нет: текст
// пишет автор интерфейса, а разметку внутрь ставит кит. Проход ОДИН, поэтому «%2» внутри
// уже подставленного ребёнка местом не считается.
Функция Шаблон(Знач Элемент)

	Образец = Экран.Экранировать(Элемент.Свойства().Образец);

	Места = Новый Массив();
	Для Каждого Ребёнок Из Элемент.Состав() Цикл
		Места.Добавить(Узел(Ребёнок));
	КонецЦикла;

	Части = Новый Массив();
	Занятые = Новый Соответствие();
	Позиция = 1;

	Пока Позиция <= СтрДлина(Образец) Цикл

		Номер = НомерМеста(Сред(Образец, Позиция, 2));
		Если Номер = 0 Тогда
			Части.Добавить(Сред(Образец, Позиция, 1));
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Если Номер > Места.Количество() Тогда
			ВызватьИсключение СтрШаблон("Разметка элементов: шаблон просит место %%%1,"
				+ " а детей у него %2. Место в тексте и ребёнок узла — одно и то же:"
				+ " %%1 занимает первый добавленный, %%2 — второй.", Номер, Места.Количество());
		КонецЕсли;

		Части.Добавить(Места[Номер - 1]);
		Занятые.Вставить(Номер, Истина);
		Позиция = Позиция + 2;

	КонецЦикла;

	Если Занятые.Количество() <> Места.Количество() Тогда
		ВызватьИсключение СтрШаблон("Разметка элементов: детей у шаблона %1, а мест в тексте"
			+ " занято %2 — лишний ребёнок не напечатается вовсе.",
			Места.Количество(), Занятые.Количество());
	КонецЕсли;

	Возврат СтрСоединить(Части, "");

КонецФункции

// Номер места по паре символов «%N»; 0 — места здесь нет.
Функция НомерМеста(Знач Пара)

	Если Лев(Пара, 1) <> "%" Тогда
		Возврат 0;
	КонецЕсли;
	Возврат СтрНайти("123456789", Сред(Пара, 2, 1));

КонецФункции

#КонецОбласти

#Область РазметкаТаблицы

// Таблица без записей печатает свой холст «пусто» вместо себя: пустая шапка над пустым
// телом — это рамка, в которой человеку нечего прочесть.
Функция Таблица(Знач Элемент)

	Колонки = ДетиРода(Элемент, "колонка");
	Записи = ДетиРода(Элемент, "запись");

	Если Записи.Количество() = 0 Тогда
		Возврат Внутренности(Элемент.Пусто());
	КонецЕсли;

	Возврат СтрШаблон("<div class=""%1""><table%2>%3%4%5</table></div>",
		КлассПрокрутки(), Атрибуты(Элемент), ЗаголовокТаблицы(Элемент),
		ШапкаТаблицы(Колонки), ТелоТаблицы(Записи, ШиринаТаблицы(Колонки, Записи)));

КонецФункции

Функция ЗаголовокТаблицы(Знач Элемент)

	Подпись = Строка(Элемент.Свойства().Подпись);
	Возврат ?(ЗначениеЗаполнено(Подпись),
		СтрШаблон("<caption>%1</caption>", Экран.Экранировать(Подпись)), "");

КонецФункции

Функция ШапкаТаблицы(Знач Колонки)

	Если Колонки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив();
	Для Каждого Колонка Из Колонки Цикл
		Части.Добавить(Узел(Колонка));
	КонецЦикла;

	Возврат СтрШаблон("<thead><tr>%1</tr></thead>", СтрСоединить(Части, ""));

КонецФункции

Функция Колонка(Знач Элемент)
	Возврат СтрШаблон("<th scope=""col""%1>%2</th>",
		Атрибуты(Элемент), Внутренности(Элемент));
КонецФункции

Функция ТелоТаблицы(Знач Записи, Знач Ширина)

	Части = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Части.Добавить(ЗаписьТаблицы(Запись, Ширина));
	КонецЦикла;

	Возврат СтрШаблон("<tbody>%1</tbody>", СтрСоединить(Части, ""));

КонецФункции

// Разворот печатается ОТДЕЛЬНОЙ строкой под записью и во всю ширину таблицы: внутрь <tr>
// его не вложить, поэтому запись и её разворот — две строки, связанные классами.
Функция ЗаписьТаблицы(Знач Элемент, Знач Ширина)

	Разворот = Элемент.Разворот();
	Ячейки = Внутренности(Элемент);

	Если Разворот.Состав().Количество() = 0 Тогда
		Возврат СтрШаблон("<tr%1>%2</tr>", Атрибуты(Элемент), Ячейки);
	КонецЕсли;

	Возврат СтрШаблон("<tr%1>%2</tr><tr class=""%3""><td colspan=""%4"">%5</td></tr>",
		Атрибуты(Элемент, КлассЗаписиСРазворотом()), Ячейки, КлассРазворота(),
		Формат(Ширина, "ЧН=0; ЧГ=0"), Внутренности(Разворот));

КонецФункции

// Во столько колонок печатается разворот. Без шапки считать не по чему, кроме самих
// записей: colspan="0" браузер понимает как одну колонку, и разворот съёжился бы в неё.
Функция ШиринаТаблицы(Знач Колонки, Знач Записи)

	Если Колонки.Количество() > 0 Тогда
		Возврат Колонки.Количество();
	КонецЕсли;

	Результат = 1;
	Для Каждого Запись Из Записи Цикл
		Результат = Макс(Результат, Запись.Состав().Количество());
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДетиРода(Знач Элемент, Знач Род)

	Результат = Новый Массив();
	Для Каждого Ребёнок Из Элемент.Состав() Цикл
		Если Ребёнок.Род() = Род Тогда
			Результат.Добавить(Ребёнок);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КлассПрокрутки()
	Возврат "table-scroll";
КонецФункции

Функция КлассЗаписиСРазворотом()
	Возврат "table__record";
КонецФункции

Функция КлассРазворота()
	Возврат "table__expand";
КонецФункции

#КонецОбласти

#Область Наборы

Функция ИзвестныеВиды(Знач Род)

	Имена = Новый Массив();
	Для Каждого Вид Из ВидыРода(Род) Цикл
		Имена.Добавить(?(ЗначениеЗаполнено(Вид), Вид, "—"));
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");

КонецФункции

Функция ПеречислитьКлючи(Знач Известные)

	Имена = Новый Массив();
	Для Каждого КиЗ Из Известные Цикл
		Имена.Добавить("«" + КиЗ.Ключ + "»");
	КонецЦикла;
	Возврат Имена;

КонецФункции

Процедура ОбъявитьРод(Знач Род, Знач Тег, Знач Вложение)
	Теги.Вставить(Род, Тег);
	Контейнеры.Вставить(Род, Вложение);
	КлассыВида.Вставить(Род, Новый Соответствие());
КонецПроцедуры

Процедура ОбъявитьВид(Знач Род, Знач Вид, Знач Класс)
	КлассыВида.Получить(Род).Вставить(Вид, Класс);
КонецПроцедуры

Процедура ОбъявитьВторойХолст(Знач Род, Знач Имя)
	ВторыеХолсты.Вставить(Род, Имя);
КонецПроцедуры

// Раскрывашка печатает три тега сразу, и класс у каждого свой: у «простой» их нет вовсе,
// у панели — все три.
Процедура ОбъявитьРаскрывашку(Знач Вид, Знач Класс, Знач КлассШапки, Знач КлассТела)
	ОбъявитьВид("раскрывашка", Вид, Класс);
	КлассыШапки.Вставить(Вид, КлассШапки);
	КлассыТела.Вставить(Вид, КлассТела);
КонецПроцедуры

Процедура ОбъявитьМету(Знач Вид, Знач КлассРяда, Знач КлассЭлемента)
	КлассыМетыПоВиду.Вставить(Вид,
		Новый Структура("Ряд, Элемент", КлассРяда, КлассЭлемента));
КонецПроцедуры

Процедура ОбъявитьДетей(Знач Род, Знач Роды)

	Допустимые = Новый Соответствие();
	Для Каждого Имя Из СтрРазделить(Роды, ",") Цикл
		Допустимые.Вставить(СокрЛП(Имя), Истина);
	КонецЦикла;
	ДетиРодов.Вставить(Род, Допустимые);

КонецПроцедуры

// Три рода формы отличаются не оформлением, а тем, чем защищён отправленный запрос,
// поэтому раскладка у них общая.
Процедура ОбъявитьФорму(Знач Род)
	ОбъявитьРод(Род, "form", Истина);
	ОбъявитьВид(Род, "", "");
	ОбъявитьВид(Род, "столбик", "form-stack");
	ОбъявитьВид(Род, "строкой", "form-inline");
	ОбъявитьВид(Род, "меню", "menu__form");
	ОбъявитьВид(Род, "переключатель", "theme-toggle");
КонецПроцедуры

// Роды документа: то, из чего собирается страница целиком — от объявления типа
// до отложенного скрипта. Своих видов у них почти нет: документ один на страницу.
Процедура СобратьРодыДокумента()

	ОбъявитьРод("документ", "html", Истина);
	ОбъявитьВид("документ", "", "");
	ОбъявитьДетей("документ", "голова,тело");

	ОбъявитьРод("голова", "head", Истина);
	ОбъявитьВид("голова", "", "");
	ОбъявитьДетей("голова", "титул,мета,ресурс,стиль,скрипт");

	ОбъявитьРод("титул", "title", Истина);
	ОбъявитьВид("титул", "", "");
	ОбъявитьДетей("титул", "текст");

	ОбъявитьРод("мета", "meta", Ложь);
	ОбъявитьВид("мета", "", "");

	ОбъявитьРод("ресурс", "link", Ложь);
	ОбъявитьВид("ресурс", "", "");

	ОбъявитьРод("стиль", "style", Ложь);
	ОбъявитьВид("стиль", "", "");

	ОбъявитьРод("скрипт", "script", Ложь);
	ОбъявитьВид("скрипт", "", "");

	ОбъявитьРод("тело", "body", Истина);
	ОбъявитьВид("тело", "", "");

	ОбъявитьРод("шапка", "header", Истина);
	ОбъявитьВид("шапка", "", "");
	ОбъявитьВид("шапка", "страницы", "top");

	ОбъявитьРод("основное", "main", Истина);
	ОбъявитьВид("основное", "", "");
	ОбъявитьВид("основное", "полоса", "wrap");

	ОбъявитьРод("подвал", "footer", Истина);
	ОбъявитьВид("подвал", "", "");
	ОбъявитьВид("подвал", "страницы", "bottom");

	ОбъявитьРод("навигация", "nav", Истина);
	ОбъявитьВид("навигация", "", "");
	ОбъявитьВид("навигация", "верхняя", "top__nav");

КонецПроцедуры

Процедура СобратьНаборы()

	Контейнеры = Новый Соответствие();
	Теги = Новый Соответствие();
	КлассыВида = Новый Соответствие();
	ВторыеХолсты = Новый Соответствие();
	ДетиРодов = Новый Соответствие();
	КлассыШапки = Новый Соответствие();
	КлассыТела = Новый Соответствие();

	ОбъявитьРод("холст", "", Истина);
	ОбъявитьВид("холст", "", "");

	СобратьРодыДокумента();

	ОбъявитьРод("область", "div", Истина);
	ОбъявитьВид("область", "", "");
	ОбъявитьВид("область", "полоса", "wrap");
	ОбъявитьВид("область", "проза", "prose");
	ОбъявитьВид("область", "карточки", "objcard-list");
	ОбъявитьВид("область", "шапка", "objcard__head");
	ОбъявитьВид("область", "плашки", "objcard__chips");
	ОбъявитьВид("область", "действия", "objcard__actions");
	ОбъявитьВид("область", "отбор", "chips-bar");
	ОбъявитьВид("область", "вставка", "inset");
	ОбъявитьВид("область", "студия", "studio");
	ОбъявитьВид("область", "работа", "studio__work");
	ОбъявитьВид("область", "образец", "studio__sample");
	ОбъявитьВид("область", "поле", "field");

	ОбъявитьРод("ряд", "div", Истина);
	ОбъявитьВид("ряд", "выбор", "choice-row");
	ОбъявитьВид("ряд", "признаки", "chips");
	ОбъявитьВид("ряд", "свёрнутые", "tag-row tag-row--inline");
	ОбъявитьВид("ряд", "справа", "row-end");
	ОбъявитьВид("ряд", "строкой", "row-line");

	ОбъявитьРод("статья", "article", Истина);
	ОбъявитьВид("статья", "", "");
	ОбъявитьВид("статья", "карточка", "objcard");

	ОбъявитьРод("раскрывашка", "details", Истина);
	ОбъявитьРаскрывашку("", "panel", "panel__head", "panel__body");
	ОбъявитьРаскрывашку("простая", "", "", "");
	ОбъявитьРаскрывашку("врезка", "fold", "fold__head", "");
	ОбъявитьРаскрывашку("подробность", "fold-detail", "", "");
	ОбъявитьРаскрывашку("хвост", "tag-row__more", "tag-row__count", "tag-row__rest");
	ОбъявитьВторойХолст("раскрывашка", "шапка");

	ОбъявитьРод("группа", "fieldset", Истина);
	ОбъявитьВид("группа", "", "");
	ОбъявитьВид("группа", "набор", "choice-set");
	ОбъявитьВид("группа", "простая", "field-set");

	ОбъявитьФорму("форма");
	ОбъявитьФорму("форма-без-сессии");
	ОбъявитьФорму("форма-отбора");
	ОбъявитьФорму("форма-без-токена");

	ОбъявитьРод("таблица", "table", Истина);
	ОбъявитьВид("таблица", "", "table");
	ОбъявитьВид("таблица", "карточками", "table table-cards");
	ОбъявитьВторойХолст("таблица", "пусто");
	ОбъявитьДетей("таблица", "колонка,запись");

	ОбъявитьРод("колонка", "th", Истина);
	ОбъявитьВид("колонка", "", "");
	ОбъявитьВид("колонка", "узкая", "col-narrow");

	ОбъявитьРод("запись", "tr", Истина);
	ОбъявитьВид("запись", "", "");
	ОбъявитьВид("запись", "выделенная", "row-accent");
	ОбъявитьВторойХолст("запись", "разворот");
	ОбъявитьДетей("запись", "ячейка");

	ОбъявитьРод("ячейка", "td", Истина);
	ОбъявитьВид("ячейка", "", "");
	ОбъявитьВид("ячейка", "величина", "cell-value");
	ОбъявитьВид("ячейка", "столбиком", "cell-stack");
	ОбъявитьВид("ячейка", "узкая", "cell-narrow");

	ОбъявитьРод("заголовок", "h1…h6", Истина);
	ОбъявитьВид("заголовок", "", "");
	ОбъявитьВид("заголовок", "имя", "objcard__name");

	ОбъявитьРод("надпись", "span", Истина);
	ОбъявитьВид("надпись", "", "");
	ОбъявитьВид("надпись", "название", "text-name");
	ОбъявитьВид("надпись", "пояснение", "text-hint");
	ОбъявитьВид("надпись", "сноска", "text-note");
	ОбъявитьВид("надпись", "приглушённая", "muted");
	ОбъявитьВид("надпись", "приписка", "text-below");
	ОбъявитьВид("надпись", "ключ", "text-key");
	ОбъявитьВид("надпись", "заголовок", "inset__title");
	ОбъявитьВид("надпись", "лид", "inset__lead");
	ОбъявитьВид("надпись", "метка", "field__label");
	ОбъявитьВид("надпись", "учётка", "who");

	ОбъявитьРод("примечание", "p", Истина);
	ОбъявитьВид("примечание", "", "muted");
	ОбъявитьВид("примечание", "описание", "objcard__desc");
	ОбъявитьВид("примечание", "источник", "note-origin");
	ОбъявитьВид("примечание", "пусто", "note-empty");

	ОбъявитьРод("ссылка", "a", Истина);
	ОбъявитьВид("ссылка", "", "");
	ОбъявитьВид("ссылка", "пилюля", "chip");
	ОбъявитьВид("ссылка", "пилюля-текущая", "chip chip--active");
	ОбъявитьВид("ссылка", "знак", "brand");
	ОбъявитьВид("ссылка", "шапка", "top__link");

	ОбъявитьРод("список", "ul", Истина);
	ОбъявитьВид("список", "", "");
	ОбъявитьВид("список", "сноска", "list-note");
	ОбъявитьДетей("список", "пункт");

	ОбъявитьРод("пункт", "li", Истина);
	ОбъявитьВид("пункт", "", "");

	ОбъявитьРод("свойства", "dl", Истина);
	ОбъявитьВид("свойства", "", "props");
	ОбъявитьДетей("свойства", "свойство");

	// своего тега нет: свойство печатается ПАРОЙ <dt>/<dd>, а не одним тегом
	ОбъявитьРод("свойство", "", Истина);
	ОбъявитьВид("свойство", "", "");

	ОбъявитьРод("код", "code", Истина);
	ОбъявитьВид("код", "", "");
	ОбъявитьВид("код", "блочный", "code");
	ОбъявитьВид("код", "приглушённый", "muted");

	ОбъявитьРод("шаблон", "", Истина);
	ОбъявитьВид("шаблон", "", "");

	ОбъявитьРод("картинка", "img", Ложь);
	ОбъявитьВид("картинка", "", "");
	ОбъявитьВид("картинка", "значок", "image-icon");
	ОбъявитьВид("картинка", "значок-малый", "image-icon image-icon--small");
	ОбъявитьВид("картинка", "превью", "image-preview");
	ОбъявитьВид("картинка", "знак", "brand__mark");

	ОбъявитьРод("текст", "", Ложь);
	ОбъявитьВид("текст", "", "");

	ОбъявитьРод("готовое", "", Ложь);
	ОбъявитьВид("готовое", "", "");

	ОбъявитьРод("компонент", "", Ложь);
	Для Каждого Имя Из СтрРазделить("кнопка,плашка,плашки,поле,поле-конфига,скрытое,команда,"
		+ "карточка,зона,сетка,шапка,заглавие,пустое,вкладки,поиск,страницы,отказ,шаги,"
		+ "иконка,мета,полоса,тумблер,меню,плитка,уведомление,разделы,панель,"
		+ "объявление,окно", ",") Цикл
		ОбъявитьВид("компонент", Имя, "");
	КонецЦикла;

	// ряд метаданных оформляется парой классов — сам ряд и один его элемент, — поэтому
	// его виды живут отдельной таблицей, а не в общей «род -> вид -> класс»
	КлассыМетыПоВиду = Новый Соответствие();
	ОбъявитьМету("шапка", "objhead__meta", "objhead__meta-item");
	ОбъявитьМету("карточка", "objcard__meta", "objcard__meta-item");

	РолиARIA = Новый Соответствие();
	РолиARIA.Вставить("группа", "group");
	РолиARIA.Вставить("состояние", "status");
	РолиARIA.Вставить("тревога", "alert");

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "ЭкранированиеHTML") _Экран) Экспорт

	Экран = _Экран;
	СобратьНаборы();

КонецПроцедуры
