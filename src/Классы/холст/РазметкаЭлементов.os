// Разметка элементов — желудь UI-кита: единственное место, где узел дерева становится
// тегом и классом. Вид узла — значение из закрытого набора; имя класса за пределы этого
// файла не выходит, поэтому снятый вид уносит своё правило вместе с собой.

Перем Экран;        // ЭкранированиеHTML
Перем Контейнеры;   // Соответствие: род -> Булево (можно ли внутрь)
Перем Теги;         // Соответствие: род -> имя тега ("" — узел печатает только детей)
Перем КлассыВида;   // Соответствие: род -> Соответствие: вид -> CSS-класс
Перем ВторыеХолсты; // Соответствие: род -> имя второго холста узла
Перем ДетиРодов;    // Соответствие: род -> Соответствие: род ребёнка -> Истина
Перем КлассыШапки;  // Соответствие: вид раскрывашки -> CSS-класс её свёрнутой строки
Перем КлассыТела;   // Соответствие: вид раскрывашки -> CSS-класс её тела
Перем КлассыМетыПоВиду; // Соответствие: вид ряда метаданных -> Структура(Ряд, Элемент)
Перем РолиARIA;     // Соответствие: имя роли на русском -> значение атрибута role
Перем СловаНосителей; // Соответствие: вид компонента или род -> Соответствие: слово -> Истина
Перем ВторыеКомпонентов; // Соответствие: вид компонента -> имя второго холста
Перем ПоляВторыхХолстов; // Соответствие: вид компонента -> поле модели, куда печатается второй холст
Перем ДетиКомпонентов;   // Соответствие: вид компонента -> вид компонента-ребёнка
Перем ФабрикиДетей;      // Соответствие: вид компонента-ребёнка -> функция кита, что его рождает
Перем Типы;           // ТипыПоля — тип значения поля в тип ввода

#Область ПубличныйИнтерфейс

// Роды узлов, которые кит умеет печатать.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Роды() Экспорт

	Результат = Новый Массив();
	Для Каждого КиЗ Из Теги Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Виды, известные роду узла.
//
// Параметры:
//  Род - Строка - род узла.
//
// Возвращаемое значение:
//  Массив из Строка - "" в списке означает «без вида»; пустой список — рода кит не знает.
//
Функция ВидыРода(Знач Род) Экспорт

	Результат = Новый Массив();
	Известные = КлассыВида.Получить(Род);
	Если Известные = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого КиЗ Из Известные Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Имя тега, которым печатается род узла.
//
// Параметры:
//  Род - Строка - род узла.
//
// Возвращаемое значение:
//  Строка - имя тега; "" — узел печатает только детей.
//
Функция ТегРода(Знач Род) Экспорт
	Возврат Строка(Теги.Получить(Род));
КонецФункции

// Может ли узел принимать вложенные элементы.
//
// Параметры:
//  Род  - Строка - род узла.
//  Поля - Структура, Неопределено - (необязательный) свойства узла: компонент пускает
//         внутрь ровно тогда, когда у него объявлен слот.
//
// Возвращаемое значение:
//  Булево
//
Функция Контейнер(Знач Род, Знач Поля = Неопределено) Экспорт

	Если Контейнеры.Получить(Род) = Истина Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат ЗначениеЗаполнено(ИмяСлота(Поля));

КонецФункции

// Имя второго холста узла: раскрывашка печатает «шапку» перед телом, запись таблицы —
// «разворот» под собой, таблица — «пусто» вместо себя.
//
// Параметры:
//  Род - Строка - род узла.
//  Вид - Строка - (необязательный) вид узла: у компонента второй холст зависит от вида
//        (действия карточки).
//
// Возвращаемое значение:
//  Строка - имя второго холста либо "" — второго холста у рода нет.
//
Функция ВторойХолстРода(Знач Род, Знач Вид = "") Экспорт

	Если Род = "компонент" Тогда
		Возврат Строка(ВторыеКомпонентов.Получить(Вид));
	КонецЕсли;
	Возврат Строка(ВторыеХолсты.Получить(Род));

КонецФункции

// Знает ли носитель слово: у компонента носитель — его вид, у узла каркаса настроек — род.
//
// Параметры:
//  Носитель - Строка - вид компонента либо род узла.
//  Слово    - Строка - имя слова.
//
// Возвращаемое значение:
//  Булево
//
Функция ЗнаетСлово(Знач Носитель, Знач Слово) Экспорт

	Известные = СловаНосителей.Получить(Носитель);
	Возврат Известные <> Неопределено И Известные.Получить(Слово) = Истина;

КонецФункции

// Проверяет, что слово бывает у носителя. Слово, которого компонент не знает, не пропадает
// молча: опечатка в цепочке дала бы кнопку не того вида, и виноватым выглядел бы CSS.
//
// Параметры:
//  Носитель   - Строка - вид компонента либо род узла.
//  Слово      - Строка - имя слова.
//  ЕстьМодель - Булево - (необязательный) есть ли у узла модель, которую пишут слова.
//
Процедура ПроверитьСлово(Знач Носитель, Знач Слово, Знач ЕстьМодель = Истина) Экспорт

	Если ЕстьМодель И ЗнаетСлово(Носитель, Слово) Тогда
		Возврат;
	КонецЕсли;

	Известные = СловаНосителей.Получить(Носитель);
	Если НЕ ЕстьМодель ИЛИ Известные = Неопределено ИЛИ Известные.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон("Элемент экрана: у узла «%1» слова «%2» нет — слова"
			+ " компонентов пишут поля модели, а этот узел модели не держит. У узла есть общие"
			+ " слова: Вид, Подпись, Подсказка, Якорь, Признак, Роль, Когда, Токен.",
			Носитель, Слово);
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Элемент экрана: у компонента «%1» нет слова «%2». Его слова:"
		+ " %3; общие — Признак, Роль, Когда.", Носитель, Слово,
		СтрСоединить(ПеречислитьКлючи(Известные), ", "));

КонецПроцедуры

// Проверяет, что компонент принимает такого ребёнка: табы собираются из вкладок, и чужой
// узел в полосе вкладок не напечатался бы вовсе.
//
// Параметры:
//  Родитель - ЭлементЭкрана - куда кладут.
//  Ребёнок  - ЭлементЭкрана - что кладут.
//
Процедура ПроверитьВложениеКомпонента(Знач Родитель, Знач Ребёнок) Экспорт

	Если Родитель.Род() <> "компонент" Тогда
		Возврат;
	КонецЕсли;

	Ждём = ДетиКомпонентов.Получить(Родитель.Свойства().Вид);
	Если Ждём = Неопределено
		ИЛИ (Ребёнок.Род() = "компонент" И Ребёнок.Свойства().Вид = Ждём) Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Разметка элементов: внутрь компонента «%1» кладут только"
		+ " «%2» (%4), а не «%3».", Родитель.Свойства().Вид, Ждём,
		?(Ребёнок.Род() = "компонент", Ребёнок.Свойства().Вид, Ребёнок.Род()),
		ФабрикиДетей.Получить(Ждём));

КонецПроцедуры

// Заголовок колонки таблицы из данных и проверка, что колонка в данных есть. У таблицы
// значений колонка берётся из неё (заголовок колонки, по умолчанию имя), у массива её
// объявляют — заголовок пуст.
//
// Параметры:
//  Таблица - ЭлементЭкрана - узел таблицы из данных.
//  Ключ    - Строка - имя колонки.
//
// Возвращаемое значение:
//  Строка - заголовок по умолчанию.
//
Функция ЗаголовокКолонкиДанных(Знач Таблица, Знач Ключ) Экспорт

	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		ВызватьИсключение "Разметка элементов: колонка таблицы из данных без ключа — ячейке"
			+ " нечего взять из записи.";
	КонецЕсли;

	Данные = Таблица.Свойства().Данные;
	Если ТипЗнч(Данные) <> Тип("ТаблицаЗначений") Тогда
		Возврат "";
	КонецЕсли;

	Колонка = Данные.Колонки.Найти(Ключ);
	Если Колонка = Неопределено Тогда
		Имена = Новый Массив();
		Для Каждого Известная Из Данные.Колонки Цикл
			Имена.Добавить(Известная.Имя);
		КонецЦикла;
		ВызватьИсключение СтрШаблон("Разметка элементов: в таблице значений нет колонки «%1»;"
			+ " есть: %2.", Ключ, СтрСоединить(Имена, ", "));
	КонецЕсли;

	Возврат ?(ЗначениеЗаполнено(Колонка.Заголовок), Колонка.Заголовок, Колонка.Имя);

КонецФункции

// Модель компонента со словами — та, что уйдёт в его Отрисовать: копия модели узла со
// слотом, вторым холстом и значением поля в формате ввода. Нужна и там, где узел кладут
// словом в чужую модель (кнопку в пустое состояние, поле в строку поиска).
//
// Параметры:
//  Элемент - ЭлементЭкрана - узел компонента.
//
// Возвращаемое значение:
//  Структура
//
Функция МодельКомпонента(Знач Элемент) Экспорт

	Поля = Элемент.Свойства();
	Модель = Неопределено;
	Если Элемент.Род() <> "компонент" ИЛИ НЕ Поля.Свойство("Модель", Модель)
		ИЛИ ТипЗнч(Модель) <> Тип("Структура") Тогда
		ВызватьИсключение СтрШаблон("Разметка элементов: на месте модели ждут узел компонента"
			+ " (Кит.Кнопка, Кит.Плашка, Кит.Поле…), а пришёл «%1».",
			?(Элемент.Род() = "компонент", Поля.Вид, Элемент.Род()));
	КонецЕсли;

	Модель = КопияМодели(Модель);
	Вид = Поля.Вид;

	Слот = ИмяСлота(Поля);
	Если ЗначениеЗаполнено(Слот) Тогда
		Модель.Вставить(Слот, СодержимоеСлота(Элемент, Поля));
	КонецЕсли;

	Второй = Элемент.ВторойХолст();
	Если Второй <> Неопределено И Второй.Состав().Количество() > 0 Тогда
		Модель.Вставить(ПоляВторыхХолстов.Получить(Вид), Внутренности(Второй));
	КонецЕсли;

	Если Вид = "кнопка" Тогда
		ОткрывашкаОкна(Элемент, Модель);
	КонецЕсли;

	Сырое = Неопределено;
	Если Вид = "поле" И Поля.Свойство("ЗначениеПоля", Сырое) Тогда
		Тип_ = "";
		Модель.Свойство("Тип", Тип_);
		Модель.Вставить("Значение", Типы.ТекстВвода(Сырое, Строка(Тип_)));
	КонецЕсли;

	Возврат Модель;

КонецФункции

// Типы поля — перевод типа значения в тип ввода; общий у поля холста и печати узла.
//
// Возвращаемое значение:
//  ТипыПоля
//
Функция ТипыЗначений() Экспорт
	Возврат Типы;
КонецФункции

// Разделы дома для единого меню: подпись, адрес, иконка, пометка текущего, рубрика
// и опасность — та же форма, что у РендерерНастроек.Раздел, и число у пункта меню.
//
// Параметры:
//  Дом - ЭлементЭкрана - узел рода «дом».
//
// Возвращаемое значение:
//  Массив из Структура - Подпись, Адрес, Иконка, Активен, Рубрика, Опасный, Счётчик,
//                        ПодписьСчётчика.
//
Функция РазделыДома(Знач Дом) Экспорт

	Результат = Новый Массив();
	Для Каждого Ребёнок Из Дом.Состав() Цикл
		Если Ребёнок.Род() = "раздел" И Показан(Ребёнок) Тогда
			Модель = Ребёнок.Свойства().Модель;
			Счётчик_ = Неопределено;
			ПодписьСчётчика_ = "";
			Модель.Свойство("Счётчик", Счётчик_);
			Модель.Свойство("ПодписьСчётчика", ПодписьСчётчика_);
			Результат.Добавить(Новый Структура(
				"Подпись, Адрес, Иконка, Активен, Рубрика, Опасный, Счётчик, ПодписьСчётчика",
				Модель.Подпись, АдресРаздела(Дом, Ребёнок), Модель.Иконка, Модель.Активен,
				Модель.Рубрика, Модель.Опасный, Счётчик_, ПодписьСчётчика_));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Заголовок дома — имя группы его разделов в едином меню.
//
// Параметры:
//  Дом - ЭлементЭкрана - узел рода «дом».
//
// Возвращаемое значение:
//  Строка
//
Функция ЗаголовокДома(Знач Дом) Экспорт
	Возврат Строка(Дом.Свойства().Модель.Заголовок);
КонецФункции

// Проверяет, что вид известен роду узла. Неизвестный вид не печатается пустым классом —
// он останавливает сборку: иначе опечатка в виде даёт молча неоформленный экран.
//
// Параметры:
//  Род - Строка - род узла.
//  Вид - Строка - вид узла.
//
Процедура ПроверитьВид(Знач Род, Знач Вид) Экспорт

	Известные = КлассыВида.Получить(Род);
	Если Известные <> Неопределено И Известные.Получить(Вид) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Разметка элементов: узел «%1» вида «%2» не знает."
		+ " Вид — значение из закрытого набора кита, а не имя CSS-класса; этот род знает"
		+ " виды: %3 (пусто — рода «%1» кит не знает вовсе, «—» значит «без вида»).",
		Род, Вид, ИзвестныеВиды(Род));

КонецПроцедуры

// Проверяет, что ребёнок такого рода в таком родителе бывает. Узел, которого родитель
// не печатает, исчез бы с экрана молча.
//
// Параметры:
//  Род        - Строка - род родителя.
//  РодРебёнка - Строка - род ребёнка.
//
Процедура ПроверитьВложение(Знач Род, Знач РодРебёнка) Экспорт

	Допустимые = ДетиРодов.Получить(Род);
	Если Допустимые = Неопределено ИЛИ Допустимые.Получить(РодРебёнка) = Истина Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Разметка элементов: внутрь узла «%1» кладут только %2,"
		+ " а не «%3»: узел чужого рода этот родитель не печатает, и содержимое молча"
		+ " исчезло бы с экрана.", Род, СтрСоединить(ПеречислитьКлючи(Допустимые), " и "),
		РодРебёнка);

КонецПроцедуры

// CSS-класс, которым печатается вид узла. Нужен там, где дерево передаёт оформление
// слою компонентов: имя класса не выходит за границу кита и здесь.
//
// Параметры:
//  Род - Строка - род узла.
//  Вид - Строка - вид узла.
//
// Возвращаемое значение:
//  Строка - имя класса; "" — вид без оформления.
//
Функция КлассВида(Знач Род, Знач Вид) Экспорт

	Значение = НРег(СокрЛП(Строка(?(Вид = Неопределено, "", Вид))));
	ПроверитьВид(Род, Значение);
	Возврат Строка(КлассыВида.Получить(Род).Получить(Значение));

КонецФункции

// Классы ряда метаданных: сам ряд и один его элемент оформляются вместе.
//
// Параметры:
//  Вид - Строка - «шапка» | «карточка».
//
// Возвращаемое значение:
//  Структура - Ряд, Элемент: имена CSS-классов.
//
Функция КлассыМеты(Знач Вид) Экспорт

	Значение = НРег(СокрЛП(Строка(?(Вид = Неопределено, "", Вид))));
	Классы = КлассыМетыПоВиду.Получить(Значение);
	Если Классы <> Неопределено Тогда
		Возврат Классы;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Разметка элементов: ряда метаданных вида «%1» не бывает."
		+ " Ряд метаданных стоит либо в шапке объекта, либо в его карточке, и оформление"
		+ " у этих двух мест разное; известные виды: %2.",
		Значение, СтрСоединить(ПеречислитьКлючи(КлассыМетыПоВиду), ", "));

КонецФункции

// Форма ли это. Три рода формы отличаются защитой отправленного запроса, но тег и
// свойства у них общие.
//
// Параметры:
//  Род - Строка - род узла.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоФорма(Знач Род) Экспорт
	Возврат Род = "форма" ИЛИ Род = "форма-без-сессии" ИЛИ Род = "форма-отбора"
		ИЛИ Род = "форма-без-токена";
КонецФункции

// Значение атрибута role по русскому имени роли.
//
// Параметры:
//  Значение - Строка - имя роли.
//
// Возвращаемое значение:
//  Строка - значение атрибута role.
//
Функция РольARIA(Знач Значение) Экспорт

	Ключ = НРег(СокрЛП(Строка(?(Значение = Неопределено, "", Значение))));
	Если НЕ ЗначениеЗаполнено(Ключ) Тогда
		Возврат "";
	КонецЕсли;

	Роль = РолиARIA.Получить(Ключ);
	Если Роль = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Разметка элементов: роль «%1» киту неизвестна."
			+ " Роль скринридера — значение из набора кита, а не произвольная строка.", Ключ);
	КонецЕсли;

	Возврат Роль;

КонецФункции

// Печатает узел и всё, что внутри него.
//
// Параметры:
//  Элемент - ЭлементЭкрана - узел дерева.
//
// Возвращаемое значение:
//  Строка - HTML-фрагмент.
//
Функция Узел(Знач Элемент) Экспорт

	Если НЕ Показан(Элемент) Тогда
		Возврат "";
	КонецЕсли;

	Род = Элемент.Род();

	Если Род = "текст" Тогда
		Возврат Экран.Экранировать(Элемент.Свойства().Текст);
	ИначеЕсли Род = "документ" Тогда
		Возврат Документ(Элемент);
	ИначеЕсли Род = "мета" Тогда
		Возврат Мета(Элемент);
	ИначеЕсли Род = "ресурс" Тогда
		Возврат Ресурс(Элемент);
	ИначеЕсли Род = "стиль" Тогда
		Возврат Стиль(Элемент);
	ИначеЕсли Род = "скрипт" Тогда
		Возврат Скрипт(Элемент);
	ИначеЕсли Род = "готовое" Тогда
		Возврат Строка(Элемент.Свойства().Разметка);
	ИначеЕсли Род = "компонент" Тогда
		Возврат Компонент(Элемент);
	ИначеЕсли Род = "картинка" Тогда
		Возврат Картинка(Элемент);
	ИначеЕсли Род = "раскрывашка" Тогда
		Возврат Раскрывашка(Элемент);
	ИначеЕсли Род = "группа" Тогда
		Возврат ГруппаПолей(Элемент);
	ИначеЕсли Род = "ссылка" Тогда
		Возврат Ссылка(Элемент);
	ИначеЕсли Род = "заголовок" Тогда
		Возврат Заголовок(Элемент);
	ИначеЕсли Род = "примечание" Тогда
		Возврат Примечание(Элемент);
	ИначеЕсли Род = "шаблон" Тогда
		Возврат Шаблон(Элемент);
	ИначеЕсли Род = "таблица" Тогда
		Возврат Таблица(Элемент);
	ИначеЕсли Род = "колонка" Тогда
		Возврат Колонка(Элемент);
	ИначеЕсли Род = "код" Тогда
		Возврат Код(Элемент);
	ИначеЕсли Род = "свойство" Тогда
		Возврат Свойство(Элемент);
	ИначеЕсли ЭтоФорма(Род) Тогда
		Возврат Форма(Элемент);
	ИначеЕсли Род = "дом" Тогда
		Возврат Дом(Элемент);
	ИначеЕсли Род = "секция" Тогда
		Возврат Секция(Элемент);
	ИначеЕсли Род = "раздел" Тогда
		Возврат "";
	// --- шаги (выпуск 0.11, шаг 10) ---
	ИначеЕсли Род = "шаги" Тогда
		Возврат ШагиФормы(Элемент);
	ИначеЕсли Род = "шаг" Тогда
		ВызватьИсключение "Разметка элементов: шаг печатается только внутри своих шагов —"
			+ " кладите Кит.Шаг в Кит.Шаги: без них у шага нет ни номера, ни «Дальше».";
	// --- реестр (шаг 11) ---
	ИначеЕсли Род = "реестр" Тогда
		Возврат Реестр(Элемент);
	ИначеЕсли Род = "запись-реестра" Тогда
		ВызватьИсключение "Разметка элементов: запись реестра печатается только внутри"
			+ " Кит.Реестр — она пункт его списка, и одна на странице была бы <li> без списка.";
	ИначеЕсли Род = "окно" Тогда
		Возврат Окно(Элемент);
	ИначеЕсли Род = "подтверждение" Тогда
		Возврат ПодтверждениеОкна(Элемент);
	ИначеЕсли Род = "окно-по-адресу" Тогда
		Возврат ОкноПоАдресу(Элемент);
	ИначеЕсли Род = "оболочка-окна" Тогда
		Возврат ОболочкаОкна(Элемент);
	КонецЕсли;

	Тег = Теги.Получить(Род);
	Если НЕ ЗначениеЗаполнено(Тег) Тогда
		Возврат Внутренности(Элемент);
	КонецЕсли;

	Возврат СтрШаблон("<%1%2>%3</%1>", Тег, Атрибуты(Элемент), Внутренности(Элемент));

КонецФункции

// Построчное дерево узла: из чего собран этот кусок экрана.
//
// Параметры:
//  Элемент - ЭлементЭкрана - узел дерева.
//  Отступ  - Число         - глубина вложенности.
//
// Возвращаемое значение:
//  Строка - строки вида «  ряд[выбор]».
//
Функция Ветка(Знач Элемент, Знач Отступ) Экспорт

	Вид = Строка(Элемент.Свойства().Вид);
	Результат = Отступы(Отступ) + Элемент.Род()
		+ ?(ЗначениеЗаполнено(Вид), "[" + Вид + "]", "")
		+ ?(Показан(Элемент), "", " [скрыт]") + Символы.ПС;

	Второй = Элемент.ВторойХолст();
	Если Второй <> Неопределено Тогда
		Результат = Результат + Отступы(Отступ + 1) + Элемент.ИмяВторогоХолста() + Символы.ПС;
		Для Каждого Ребёнок Из Второй.Дети() Цикл
			Результат = Результат + Ветка(Ребёнок, Отступ + 2);
		КонецЦикла;
	КонецЕсли;

	// --- реестр (шаг 11): у записи реестра третий холст — набор действий
	Если Элемент.Род() = "запись-реестра" Тогда
		Результат = Результат + Отступы(Отступ + 1) + "кнопки" + Символы.ПС;
		Для Каждого Ребёнок Из Элемент.Свойства().Кнопки.Дети() Цикл
			Результат = Результат + Ветка(Ребёнок, Отступ + 2);
		КонецЦикла;
	КонецЕсли;

	Для Каждого Ребёнок Из Элемент.Дети() Цикл
		Результат = Результат + Ветка(Ребёнок, Отступ + 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область ОбщаяРазметка

Функция Отступы(Знач Глубина)

	Результат = "";
	Для Шаг = 1 По Глубина Цикл
		Результат = Результат + "  ";
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Дети склеиваются через массив, а не «строка = строка + кусок»: сложение в цикле
// переписывает всё накопленное на каждом шаге, и длинный список детей обходится квадратом.
// Замер на дереве из 20 000 узлов: печать 2361 мс сложением против 398 мс соединением.
Функция Внутренности(Знач Элемент)

	Части = Новый Массив();
	Для Каждого Ребёнок Из Элемент.Состав() Цикл
		Части.Добавить(Узел(Ребёнок));
	КонецЦикла;
	Возврат СтрСоединить(Части, "");

КонецФункции

Функция Атрибуты(Знач Элемент, Знач ДобавочныйКласс = "")

	Поля = Элемент.Свойства();
	Результат = Экран.Атрибут("id", Поля.Якорь)
		+ АтрибутКласса(СоединитьКлассы(Класс(Элемент), ДобавочныйКласс));

	Роль = Строка(Поля.Роль);
	Если ЗначениеЗаполнено(Роль) Тогда
		Результат = Результат + Экран.Атрибут("role", Роль);
	КонецЕсли;

	Имя = ДоступноеИмя(Элемент);
	Если ЗначениеЗаполнено(Имя) Тогда
		Результат = Результат + Экран.Атрибут("aria-label", Имя);
	КонецЕсли;

	Подсказка = Строка(Поля.Подсказка);
	Если ЗначениеЗаполнено(Подсказка) Тогда
		Результат = Результат + Экран.Атрибут("title", Подсказка);
	КонецЕсли;

	// признак печатается ДАЖЕ ПУСТЫМ: по нему скрипт находит элемент, и пропавший
	// `data-набор=""` тихо выключает переключение того набора, у которого ключ пуст
	Признаки = Элемент.Признаки();
	Если Признаки <> Неопределено Тогда
		Для Каждого КиЗ Из Признаки Цикл
			Результат = Результат + Экран.АтрибутВсегда("data-" + КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;

	Если Поля.Отключён = Истина Тогда
		Результат = Результат + " disabled";
	КонецЕсли;
	Если Поля.Скрыт = Истина Тогда
		Результат = Результат + " hidden";
	КонецЕсли;
	Если Поля.Открыта = Истина Тогда
		Результат = Результат + " open";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Класс печатается без санитайзера намеренно: его значение приходит НЕ из данных, а из
// закрытой таблицы видов этого же файла — там нет ни кавычки, ни пробела.
Функция АтрибутКласса(Знач Класс)
	Возврат ?(ЗначениеЗаполнено(Класс), СтрШаблон(" class=""%1""", Класс), "");
КонецФункции

Функция СоединитьКлассы(Знач Первый, Знач Второй)

	Имена = Новый Массив();
	Если ЗначениеЗаполнено(Первый) Тогда
		Имена.Добавить(Первый);
	КонецЕсли;
	Если ЗначениеЗаполнено(Второй) Тогда
		Имена.Добавить(Второй);
	КонецЕсли;
	Возврат СтрСоединить(Имена, " ");

КонецФункции

// Подпись ряда человеку не видна — она называет ряд скринридеру. У группы полей та же
// подпись видима и печатается легендой, у таблицы — заголовком, поэтому вторым именем
// они не дублируются.
// Подпись узла становится его доступным именем там, где скринридер его читает: у ряда
// и у ориентиров — навигации и статьи. Двум навигациям на странице подпись и нужна, чтобы
// их различить.
Функция ДоступноеИмя(Знач Элемент)
	Род = Элемент.Род();
	Возврат ?(Род = "ряд" ИЛИ Род = "навигация" ИЛИ Род = "статья" ИЛИ Род = "реестр",
		Строка(Элемент.Свойства().Подпись), "");
КонецФункции

Функция Класс(Знач Элемент)
	Известные = КлассыВида.Получить(Элемент.Род());
	Возврат ?(Известные = Неопределено, "",
		Строка(Известные.Получить(Строка(Элемент.Свойства().Вид))));
КонецФункции

#КонецОбласти

#Область РазметкаРодов

// Раскрывашка — нативный <details>: свёрнутая строка отвечает «что это», развёрнутая
// отдаёт содержимое. Раскрытие работает без единой строки скрипта. Доступное имя вешается
// на свёрнутую строку: скринридер называет ею всю раскрывашку.
Функция Раскрывашка(Знач Элемент)

	Вид = Строка(Элемент.Свойства().Вид);
	Подпись = Строка(Элемент.Свойства().Подпись);

	Возврат СтрШаблон("<details%1><summary%2%3>%4</summary><div%5>%6</div></details>",
		Атрибуты(Элемент),
		АтрибутКласса(Строка(КлассыШапки.Получить(Вид))),
		?(ЗначениеЗаполнено(Подпись), Экран.Атрибут("aria-label", Подпись), ""),
		Внутренности(Элемент.Шапка()),
		АтрибутКласса(Строка(КлассыТела.Получить(Вид))),
		Внутренности(Элемент));

КонецФункции

// Свойство печатается ПАРОЙ тегов: имя и значение — соседи в списке определений, вложить
// одно в другое нельзя. Своего тега у пары нет, поэтому род объявлен без него.
Функция Свойство(Знач Элемент)

	Возврат СтрШаблон("<dt>%1</dt><dd%2>%3</dd>",
		Экран.Экранировать(Элемент.Свойства().Подпись),
		Атрибуты(Элемент), Внутренности(Элемент));

КонецФункции

// Блочный код сохраняет переносы и отступы образца, поэтому печатается внутри <pre>:
// у обычного <code> они схлопнутся в пробелы.
Функция Код(Знач Элемент)

	Внутри = Внутренности(Элемент);
	Если Строка(Элемент.Свойства().Вид) <> "блочный" Тогда
		Возврат СтрШаблон("<code%1>%2</code>", Атрибуты(Элемент), Внутри);
	КонецЕсли;

	Возврат СтрШаблон("<pre%1><code>%2</code></pre>", Атрибуты(Элемент), Внутри);

КонецФункции

// Легенда печатается ВНУТРИ группы первой строкой: подпись группы полей видима, и по
// спецификации HTML она обязана быть первым ребёнком fieldset.
Функция ГруппаПолей(Знач Элемент)

	Подпись = Строка(Элемент.Свойства().Подпись);
	Легенда = ?(ЗначениеЗаполнено(Подпись),
		СтрШаблон("<legend>%1</legend>", Экран.Экранировать(Подпись)), "");

	Возврат СтрШаблон("<fieldset%1>%2%3</fieldset>",
		Атрибуты(Элемент), Легенда, Внутренности(Элемент));

КонецФункции

// Форма без адреса действия отправляла бы запрос на текущую страницу — молча и не туда:
// относительный адрес дописывается к адресу контекста (раздел дома вокруг), а без
// контекста форма не печатается. Метод берётся у рода: отбор спрашивает и идёт GET,
// остальные меняют и идут POST. Форма вошедшего несёт скрытое поле CSRF первым — токен
// она ищет у себя и дальше вверх по предкам.
Функция Форма(Знач Элемент)

	Действие = АдресВКонтексте(Элемент, Строка(Элемент.Свойства().Действие),
		СтрШаблон("узел «%1»", Элемент.Род()));

	ПолеТокена = "";
	Если Элемент.Род() = "форма" Тогда
		ПолеТокена = ПолеТокена(Элемент, Действие);
	КонецЕсли;

	// без enctype браузер отправляет вместо файла одно его имя — и сервер получает
	// пустую загрузку, ничего не сказав человеку
	Файлы = ?(Элемент.Свойства().Файлы = Истина,
		" enctype=""multipart/form-data""", "");

	Возврат СтрШаблон("<form method=""%1"" action=""%2""%3%4%5>%6%7</form>",
		МетодФормы(Элемент.Род()), Экран.Экранировать(Действие),
		Файлы, Атрибуты(Элемент), ПризнакПодтверждения(Элемент), ПолеТокена, Внутренности(Элемент));

КонецФункции

// Без токена форма выглядит рабочей, а получает 403: такая форма не печатается вовсе.
Функция ПолеТокена(Знач Элемент, Знач Действие)

	Токен = ТокенКонтекста(Элемент);
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		ВызватьИсключение СтрШаблон("Кит: форма на «%1» без CSRF-токена. Задайте токен текущей"
			+ " сессии словом .Токен(…) — у формы, у дома настроек или у холста вокруг, — иначе"
			+ " форма гарантированно получит 403. Форме посетителя, у которого сессии ещё нет,"
			+ " возьмите ФормаБезСессии; форме, которая на сервере ничего не меняет, —"
			+ " ФормаОтбора; форме, у которой токена не спрашивает сам сервер, — ФормаБезТокена.",
			Действие);
	КонецЕсли;

	Поля = Элемент.Свойства();
	Возврат Поля.РисовательТокена.Отрисовать(
		Новый Структура("Имя, Значение", Поля.ИмяТокена, Токен));

КонецФункции

// Пустой адрес картинки не даёт битого <img>: узел печатается пустой строкой. Размеры
// печатаются атрибутами, чтобы страница не прыгала, пока лист стилей ещё едет. Подпись
// узла становится alt: картинка без подписи декоративна, и скринридер её пропускает.
Функция Картинка(Знач Элемент)

	Адрес = Строка(Элемент.Свойства().Адрес);
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат "";
	КонецЕсли;

	Подсказка = Строка(Элемент.Свойства().Подсказка);
	Возврат СтрШаблон("<img%1 src=""%2"" alt=""%3""%4%5%6>",
		АтрибутКласса(Класс(Элемент)), Экран.Экранировать(Адрес),
		Экран.Экранировать(Элемент.Свойства().Подпись),
		?(ЗначениеЗаполнено(Подсказка), Экран.Атрибут("title", Подсказка), ""),
		Размер("width", Элемент.Свойства().Ширина),
		Размер("height", Элемент.Свойства().Высота));

КонецФункции

Функция Размер(Знач Имя, Знач Пикселей)

	Значение = Целое(Пикселей);
	Возврат ?(Значение > 0,
		СтрШаблон(" %1=""%2""", Имя, Формат(Значение, "ЧН=; ЧГ=0")), "");

КонецФункции

Функция Целое(Знач Значение)

	Попытка
		Возврат Цел(Число(Значение));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

// Ссылка без содержимого не печатается вовсе: пустой <a> кликабелен, но не назван — для
// скринридера это ссылка в никуда. Адрес недопустимой схемы снимает саму ссылку, оставляя
// содержимое видимым: `javascript:` не доедет до href ни при какой сборке дерева.
Функция Ссылка(Знач Элемент)

	Внутри = Внутренности(Элемент);
	Если НЕ ЗначениеЗаполнено(Внутри) Тогда
		Возврат "";
	КонецЕсли;

	Адрес = Строка(Элемент.Свойства().Адрес);
	Если НЕ Экран.URLБезопасенДляHref(Адрес) Тогда
		Возврат Внутри;
	КонецЕсли;

	Возврат СтрШаблон("<a href=""%1""%2>%3</a>",
		Экран.Экранировать(Адрес), Атрибуты(Элемент), Внутри);

КонецФункции

// Заголовок без содержимого не печатается: безымянный заголовок бессмыслен и для читателя,
// и для скринридера, а в оглавлении страницы он остаётся дырой.
Функция Заголовок(Знач Элемент)

	Внутри = Внутренности(Элемент);
	Если НЕ ЗначениеЗаполнено(Внутри) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("<h%1%2>%3</h%1>",
		Формат(Элемент.Свойства().Уровень, "ЧН=; ЧГ=0"), Атрибуты(Элемент), Внутри);

КонецФункции

// Примечание без содержимого не печатается: пустой абзац отбивает соседей друг от друга
// на пустом месте.
Функция Примечание(Знач Элемент)

	Внутри = Внутренности(Элемент);
	Возврат ?(ЗначениеЗаполнено(Внутри),
		СтрШаблон("<p%1>%2</p>", Атрибуты(Элемент), Внутри), "");

КонецФункции

// Компонент печатает себя целиком. Без модели его разметка собрана заранее; с моделью
// компонент рисуется здесь: слова дописывают модель до самой печати, а содержимого слота
// до печати детей ещё нет.
Функция Компонент(Знач Элемент)

	Поля = Элемент.Свойства();
	Рисователь = Неопределено;
	Если НЕ Поля.Свойство("Рисователь", Рисователь) Тогда
		Возврат Строка(Поля.Разметка);
	КонецЕсли;

	Если Рисователь = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Разметка элементов: «%1» печатается только внутри своего"
			+ " компонента — вкладка в Кит.Табы, пункт меню в Кит.Меню.", Поля.Вид);
	КонецЕсли;

	Возврат Строка(Рисователь.Отрисовать(МодельКомпонента(Элемент)));

КонецФункции

// Слот бывает одним куском разметки (тело карточки), списком кусков по ребёнку на
// каждый (ячейки сетки) и списком моделей (вкладки табов, пункты меню): компонент,
// который раскладывает детей сам, из склеенной строки сделал бы одну ячейку на всех.
Функция СодержимоеСлота(Знач Элемент, Знач Поля)

	Моделями = Ложь;
	Если Поля.Свойство("СлотМоделями", Моделями) И Моделями = Истина Тогда
		Возврат МоделиДетей(Элемент);
	КонецЕсли;

	Список = Ложь;
	Если НЕ (Поля.Свойство("СлотСписком", Список) И Список = Истина) Тогда
		Возврат Внутренности(Элемент);
	КонецЕсли;

	Части = Новый Массив();
	Для Каждого Ребёнок Из Элемент.Состав() Цикл
		Части.Добавить(Узел(Ребёнок));
	КонецЦикла;
	Возврат Части;

КонецФункции

// Ребёнок-компонент, который печатается только внутри своего (вкладка, пункт меню),
// отдаёт модель; любой другой узел — свою разметку полем HTML: так в меню встают
// и пункты-ссылки, и формы.
Функция МоделиДетей(Знач Элемент)

	Результат = Новый Массив();
	Для Каждого Ребёнок Из Элемент.Состав() Цикл
		Если НЕ Показан(Ребёнок) Тогда
			Продолжить;
		КонецЕсли;
		Рисователь = Ложь;
		Если Ребёнок.Род() = "компонент" И Ребёнок.Свойства().Свойство("Рисователь", Рисователь)
			И Рисователь = Неопределено Тогда
			Результат.Добавить(МодельКомпонента(Ребёнок));
		Иначе
			Результат.Добавить(Новый Структура("HTML", Узел(Ребёнок)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Модель копируется, а не дополняется на месте: структура пришла от вызывающего,
// и слот, дописанный в неё, всплыл бы у него при следующей сборке.
Функция КопияМодели(Знач Модель)

	Результат = Новый Структура();
	Если ТипЗнч(Модель) = Тип("Структура") Тогда
		Для Каждого КиЗ Из Модель Цикл
			Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ИмяСлота(Знач Поля)

	Значение = "";
	Если Поля = Неопределено ИЛИ НЕ Поля.Свойство("Слот", Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Строка(?(Значение = Неопределено, "", Значение));

КонецФункции

Функция МетодФормы(Знач Род)
	Возврат ?(Род = "форма-отбора", "get", "post");
КонецФункции

Функция Показан(Знач Элемент)
	Возврат Элемент.Свойства().Показан <> Ложь;
КонецФункции

#КонецОбласти

#Область Контекст

// Адрес и токен форм задаются на экране один раз — у дома настроек и словом Токен
// у любого контейнера; форма берёт их у ближайшего предка. Значение ячейки таблицы из
// данных предков в дереве не имеет и спрашивает таблицу, внутри которой печатается.

Функция ТокенКонтекста(Знач Элемент)

	Узел_ = Элемент;
	Пока Узел_ <> Неопределено Цикл
		Токен = "";
		Если Узел_.Свойства().Свойство("Токен", Токен) И ЗначениеЗаполнено(Токен) Тогда
			Возврат Токен;
		КонецЕсли;
		Узел_ = Узел_.Выше();
	КонецЦикла;
	Возврат "";

КонецФункции

Функция АдресКонтекста(Знач Элемент)

	Узел_ = Элемент.Выше();
	Пока Узел_ <> Неопределено Цикл
		Если Узел_.Род() = "дом" Тогда
			Возврат АдресДома(Узел_);
		КонецЕсли;
		Узел_ = Узел_.Выше();
	КонецЦикла;
	Возврат "";

КонецФункции

// Адрес, который начинается с косой, вопроса или решётки, — свой; относительный
// дописывается к адресу контекста: пустой — сам адрес контекста, «revoke» — контекст/revoke.
Функция АдресВКонтексте(Знач Элемент, Знач Адрес, Знач Кто)

	Адрес = СокрЛП(Адрес);
	Если СтрНачинаетсяС(Адрес, "/") ИЛИ СтрНачинаетсяС(Адрес, "?") ИЛИ СтрНачинаетсяС(Адрес, "#")
		ИЛИ СтрНайти(Адрес, "://") > 0 Тогда
		Возврат Адрес;
	КонецЕсли;

	Контекст = АдресКонтекста(Элемент);
	Если НЕ ЗначениеЗаполнено(Контекст) Тогда
		ВызватьИсключение СтрШаблон("Разметка элементов: %1 с относительным адресом «%2» —"
			+ " форме нужен абсолютный адрес или дом/секция вокруг. Адрес без ведущей косой"
			+ " дописывается к адресу раздела дома настроек; вне дома задайте его от корня (/…).",
			Кто, Адрес);
	КонецЕсли;

	Возврат СклеитьАдрес(Контекст, Адрес);

КонецФункции

Функция СклеитьАдрес(Знач Основа, Знач Хвост)

	Если НЕ ЗначениеЗаполнено(Хвост) Тогда
		Возврат Основа;
	КонецЕсли;
	Возврат ?(СтрЗаканчиваетсяНа(Основа, "/"), Основа, Основа + "/") + Хвост;

КонецФункции

// Адрес дома для форм — адрес текущего раздела, а без текущего — самого дома.
Функция АдресДома(Знач Дом)

	Для Каждого Ребёнок Из Дом.Состав() Цикл
		Если Ребёнок.Род() = "раздел" И Ребёнок.Свойства().Модель.Активен = Истина Тогда
			Возврат АдресРаздела(Дом, Ребёнок);
		КонецЕсли;
	КонецЦикла;
	Возврат Строка(Дом.Свойства().Адрес);

КонецФункции

Функция АдресРаздела(Знач Дом, Знач Раздел)

	Ключ = Строка(Раздел.Свойства().Модель.Ключ);
	Если СтрНачинаетсяС(Ключ, "/") Тогда
		Возврат Ключ;
	КонецЕсли;
	Возврат СклеитьАдрес(Строка(Дом.Свойства().Адрес), Ключ);

КонецФункции

#КонецОбласти

#Область РазметкаНастроек

// Дом печатается тем же каркасом настроек, что и модель-структура: модель собирается
// из слов и детей — разделы из узлов «раздел», секции из узлов «секция», — поэтому
// разметка та же, что у прежнего вызова РендерерНастроек.Отрисовать.
Функция Дом(Знач Элемент)

	Модель = КопияМодели(Элемент.Свойства().Модель);
	Секции = Новый Массив();
	Для Каждого Ребёнок Из Элемент.Состав() Цикл
		Если Ребёнок.Род() = "секция" И Показан(Ребёнок) Тогда
			Секции.Добавить(МодельСекции(Ребёнок));
		КонецЕсли;
	КонецЦикла;

	Модель.Вставить("Разделы", РазделыДома(Элемент));
	Модель.Вставить("Секции", Секции);
	Возврат Строка(Элемент.Свойства().Рисователь.Отрисовать(Модель));

КонецФункции

Функция Секция(Знач Элемент)
	Возврат Строка(Элемент.Свойства().Рисователь.ОтрисоватьСекцию(МодельСекции(Элемент)));
КонецФункции

// Тело секции — её дети; секция-форма берёт адрес у контекста и токен у предков.
Функция МодельСекции(Знач Элемент)

	Поля = Элемент.Свойства();
	Модель = КопияМодели(Поля.Модель);
	Модель.Вставить("Тело", Внутренности(Элемент));

	Действия = Элемент.ВторойХолст();
	Если Действия.Состав().Количество() > 0 Тогда
		Модель.Вставить("Действия", Внутренности(Действия));
	КонецЕсли;

	Хвост = Неопределено;
	Если Поля.Свойство("ХвостФормы", Хвост) И Хвост <> Неопределено Тогда

		Заголовок = Строка(Модель.Заголовок);
		Действие = АдресВКонтексте(Элемент, Хвост, СтрШаблон("секция «%1»", Заголовок));
		Токен = ТокенКонтекста(Элемент);
		Если НЕ ЗначениеЗаполнено(Токен) Тогда
			ВызватьИсключение СтрШаблон("Разметка элементов: секция «%1» — форма на «%2» без"
				+ " CSRF-токена. Задайте токен словом .Токен(…) — у дома настроек, у секции или"
				+ " у холста вокруг, — иначе форма гарантированно получит 403.",
				Заголовок, Действие);
		КонецЕсли;

		Модель.Вставить("Действие", Действие);
		Модель.Вставить("Токен", Токен);

	КонецЕсли;

	Возврат Модель;

КонецФункции


#КонецОбласти

#Область РазметкаШагов

// --- шаги (выпуск 0.11, шаг 10) ---
// Шаги печатает свой рисователь (холст/Шаги.os): здесь собирается его модель — панели
// из видимых шагов (снятый словом Когда уносит с собой и номер) и шаг, с которого начать.
// Сервер, вернувший форму с отказом, открывает шаг с ошибкой сам: первый шаг, где у поля
// есть Ошибка; без ошибок — помеченный Текущий(), без него — первый.
Функция ШагиФормы(Знач Элемент)

	Поля = Элемент.Свойства();
	Шаги_ = Новый Массив();
	Текущий = 0;
	СОшибкой = 0;
	Для Каждого Шаг Из ДетиРода(Элемент, "шаг") Цикл
		Если НЕ Показан(Шаг) Тогда
			Продолжить;
		КонецЕсли;
		Шаги_.Добавить(Новый Структура("Подпись, Тело, Атрибуты",
			Строка(Шаг.Свойства().Подпись), Внутренности(Шаг), Атрибуты(Шаг)));
		Если Текущий = 0 И Шаг.Свойства().Текущий = Истина Тогда
			Текущий = Шаги_.Количество();
		КонецЕсли;
		Если СОшибкой = 0 И ЕстьОшибкаПоля(Шаг) Тогда
			СОшибкой = Шаги_.Количество();
		КонецЕсли;
	КонецЦикла;

	Кнопка_ = Неопределено;
	Поля.Свойство("Кнопка", Кнопка_);

	Модель = Новый Структура("Атрибуты, Вид, Подпись, Начало, Кнопка, Шаги",
		Атрибуты(Элемент), Строка(Поля.Вид), Строка(Поля.Подпись),
		?(СОшибкой > 0, СОшибкой, Макс(Текущий, 1)), Кнопка_, Шаги_);
	Возврат Строка(Поля.Рисователь.Отрисовать(Модель));

КонецФункции

// Поле с отказом сервера — на любой глубине шага: поле кладут и в группу, и в ряд.
Функция ЕстьОшибкаПоля(Знач Элемент)

	Для Каждого Ребёнок Из Элемент.Состав() Цикл
		Если НЕ Показан(Ребёнок) Тогда
			Продолжить;
		КонецЕсли;
		Модель = Неопределено;
		Если Ребёнок.Род() = "компонент" И Ребёнок.Свойства().Вид = "поле"
			И Ребёнок.Свойства().Свойство("Модель", Модель) И ТипЗнч(Модель) = Тип("Структура") Тогда
			Ошибка_ = "";
			Если Модель.Свойство("Ошибка", Ошибка_) И ЗначениеЗаполнено(Ошибка_) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
		Если ЕстьОшибкаПоля(Ребёнок) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

#КонецОбласти

#Область РазметкаРеестра

// --- реестр (шаг 11) ---
// Реестр печатается рисователем Реестр: модель собирается здесь из слов и детей — тело,
// действия и каждая кнопка набора уже напечатаны, потому что печать узлов живёт только
// в этом классе. Свой холст «пусто» печатается вместо списка, когда записей нет.
Функция Реестр(Знач Элемент)

	Поля = Элемент.Свойства();
	Модель = КопияМодели(Поля.Модель);
	Модель.Вставить("Атрибуты", Атрибуты(Элемент));

	Записи = Новый Массив();
	Для Каждого Ребёнок Из Элемент.Состав() Цикл
		Если Ребёнок.Род() = "запись-реестра" И Показан(Ребёнок) Тогда
			Записи.Добавить(МодельЗаписиРеестра(Ребёнок));
		КонецЕсли;
	КонецЦикла;
	Модель.Вставить("Записи", Записи);

	Пусто = Элемент.ВторойХолст();
	Если Пусто.Состав().Количество() > 0 Тогда
		Модель.Вставить("Пусто", Внутренности(Пусто));
	КонецЕсли;

	Возврат Строка(Поля.Рисователь.Отрисовать(Модель));

КонецФункции

// Каждое действие набора печатается отдельно: рисователь кладёт их и пунктами меню ⚙,
// и кнопками внизу тела — склеенная строка стала бы одним пунктом на всех.
Функция МодельЗаписиРеестра(Знач Элемент)

	Поля = Элемент.Свойства();
	Модель = КопияМодели(Поля.Модель);
	Модель.Вставить("Атрибуты", Атрибуты(Элемент));
	Модель.Вставить("Тело", Внутренности(Элемент));
	Модель.Вставить("Действия", Внутренности(Элемент.ВторойХолст()));

	Кнопки = Новый Массив();
	Для Каждого Ребёнок Из Поля.Кнопки.Состав() Цикл
		Кнопка = Узел(Ребёнок);
		Если ЗначениеЗаполнено(Кнопка) Тогда
			Кнопки.Добавить(Кнопка);
		КонецЕсли;
	КонецЦикла;
	Модель.Вставить("Кнопки", Кнопки);

	Возврат Модель;

КонецФункции

#КонецОбласти

#Область РазметкаДокумента

// Документ — единственный узел, у которого перед тегом стоит объявление типа. Язык
// и тема печатаются атрибутами <html>: язык читает скринридер и переносчик слов,
// а тема нужна ДО листа стилей, иначе страница мигнёт чужими цветами.
Функция Документ(Знач Элемент)

	Поля = Элемент.Свойства();
	// пустой язык не объявляется вовсе: lang="" для скринридера хуже, чем его отсутствие
	Возврат "<!DOCTYPE html>" + Символы.ПС
		+ СтрШаблон("<html%1%2>%3</html>",
			Экран.Атрибут("lang", Поля.Язык), Экран.Атрибут("data-theme", Поля.Тема),
			Внутренности(Элемент));

КонецФункции

// Мета печатается в одном из трёх видов: объявление кодировки, пара «свойство —
// содержание» карточки ссылки либо пара «имя — содержание». Объявление без имени
// и без свойства ничего не объявляет и не печатается.
Функция Мета(Знач Элемент)

	Поля = Элемент.Свойства();
	Кодировка = Строка(Поля.Кодировка);
	Если ЗначениеЗаполнено(Кодировка) Тогда
		Возврат СтрШаблон("<meta charset=""%1"">", Экран.Экранировать(Кодировка));
	КонецЕсли;

	Если ЗначениеЗаполнено(Поля.Свойство) Тогда
		Возврат СтрШаблон("<meta property=""%1"" content=""%2"">",
			Экран.Экранировать(Поля.Свойство), Экран.Экранировать(Поля.Содержание));
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Поля.Имя) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("<meta name=""%1"" content=""%2"">",
		Экран.Экранировать(Поля.Имя), Экран.Экранировать(Поля.Содержание));

КонецФункции

// Ресурс без адреса не печатается: <link> в никуда браузер всё равно запросит.
Функция Ресурс(Знач Элемент)

	Поля = Элемент.Свойства();
	Адрес = Строка(Поля.Адрес);
	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("<link rel=""%1""%2%3 href=""%4"">",
		Экран.Экранировать(Поля.Отношение),
		Экран.Атрибут("type", Поля.Тип),
		Экран.Атрибут("sizes", Поля.Размеры),
		Экран.Экранировать(Адрес));

КонецФункции

// Правила печатаются как есть: внутри <style> живёт CSS, и HTML-экранирование там
// не защищает, а ломает. Значение обязан провалидировать тот, кто его собрал.
Функция Стиль(Знач Элемент)

	Поля = Элемент.Свойства();
	Возврат СтрШаблон("<style%1>%2</style>",
		Экран.Атрибут("id", Поля.Имя), Строка(Поля.Правила));

КонецФункции

// Скрипт страницы всегда отложенный: разбор разметки он не останавливает, а порядок
// исполнения сохраняет.
Функция Скрипт(Знач Элемент)

	Адрес = Строка(Элемент.Свойства().Адрес);
	Возврат ?(ЗначениеЗаполнено(Адрес),
		СтрШаблон("<script src=""%1"" defer></script>", Экран.Экранировать(Адрес)), "");

КонецФункции

#КонецОбласти

#Область РазметкаШаблона

// Дети занимают места %1…%N в тексте шаблона. Сам текст экранируется, дети — нет: текст
// пишет автор интерфейса, а разметку внутрь ставит кит. Проход ОДИН, поэтому «%2» внутри
// уже подставленного ребёнка местом не считается.
Функция Шаблон(Знач Элемент)

	Образец = Экран.Экранировать(Элемент.Свойства().Образец);

	Места = Новый Массив();
	Для Каждого Ребёнок Из Элемент.Состав() Цикл
		Места.Добавить(Узел(Ребёнок));
	КонецЦикла;

	Части = Новый Массив();
	Занятые = Новый Соответствие();
	Позиция = 1;

	Пока Позиция <= СтрДлина(Образец) Цикл

		Номер = НомерМеста(Сред(Образец, Позиция, 2));
		Если Номер = 0 Тогда
			Части.Добавить(Сред(Образец, Позиция, 1));
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;

		Если Номер > Места.Количество() Тогда
			ВызватьИсключение СтрШаблон("Разметка элементов: шаблон просит место %%%1,"
				+ " а детей у него %2. Место в тексте и ребёнок узла — одно и то же:"
				+ " %%1 занимает первый добавленный, %%2 — второй.", Номер, Места.Количество());
		КонецЕсли;

		Части.Добавить(Места[Номер - 1]);
		Занятые.Вставить(Номер, Истина);
		Позиция = Позиция + 2;

	КонецЦикла;

	Если Занятые.Количество() <> Места.Количество() Тогда
		ВызватьИсключение СтрШаблон("Разметка элементов: детей у шаблона %1, а мест в тексте"
			+ " занято %2 — лишний ребёнок не напечатается вовсе.",
			Места.Количество(), Занятые.Количество());
	КонецЕсли;

	Возврат СтрСоединить(Части, "");

КонецФункции

// Номер места по паре символов «%N»; 0 — места здесь нет.
Функция НомерМеста(Знач Пара)

	Если Лев(Пара, 1) <> "%" Тогда
		Возврат 0;
	КонецЕсли;
	Возврат СтрНайти("123456789", Сред(Пара, 2, 1));

КонецФункции

#КонецОбласти

#Область РазметкаТаблицы

// Таблица без записей печатает свой холст «пусто» вместо себя: пустая шапка над пустым
// телом — это рамка, в которой человеку нечего прочесть. Колонка, снятая словом Когда,
// уносит с собой и ячейки под ней.
Функция Таблица(Знач Элемент)

	Данные = Неопределено;
	Если Элемент.Свойства().Свойство("Данные", Данные) И Данные <> Неопределено Тогда
		Возврат ТаблицаИзДанных(Элемент, Данные);
	КонецЕсли;

	Колонки = Новый Массив();
	Скрытые = Новый Соответствие();
	Для Каждого Колонка Из ДетиРода(Элемент, "колонка") Цикл
		Если Показан(Колонка) Тогда
			Колонки.Добавить(Колонка);
		Иначе
			Скрытые.Вставить(Колонки.Количество() + Скрытые.Количество(), Истина);
		КонецЕсли;
	КонецЦикла;

	Записи = Новый Массив();
	Для Каждого Запись Из ДетиРода(Элемент, "запись") Цикл
		Если Показан(Запись) Тогда
			Записи.Добавить(Запись);
		КонецЕсли;
	КонецЦикла;

	Возврат ПечатьТаблицы(Элемент, Колонки, Записи, Скрытые);

КонецФункции

Функция ПечатьТаблицы(Знач Элемент, Знач Колонки, Знач Записи, Знач Скрытые)

	Если Записи.Количество() = 0 Тогда
		Возврат Внутренности(Элемент.Пусто());
	КонецЕсли;

	Возврат СтрШаблон("<div class=""%1""><table%2>%3%4%5</table></div>",
		КлассПрокрутки(), Атрибуты(Элемент), ЗаголовокТаблицы(Элемент),
		ШапкаТаблицы(Колонки),
		ТелоТаблицы(Записи, ШиринаТаблицы(Колонки, Записи, Скрытые),
			ПодписиЯчеек(Элемент, Колонки), Скрытые));

КонецФункции

// Таблица из данных печатается тем же кодом, что и ручная: по строкам данных собираются
// узлы записи и ячейки, поэтому разметка совпадает с ручной сборкой байт в байт. Узел
// из ячейки кладётся в ячейку на время печати и возвращается без родителя: данные можно
// напечатать ещё раз.
Функция ТаблицаИзДанных(Знач Элемент, Знач Данные)

	Колонки = КолонкиДанных(Элемент, Данные);
	Разворот = "";
	Элемент.Свойства().Свойство("Разворот", Разворот);
	Разворот = Строка(?(Разворот = Неопределено, "", Разворот));

	Записи = Новый Массив();
	Положенные = Новый Массив();
	Попытка

		Для Каждого СтрокаДанных Из Данные Цикл

			Запись = Новый ЭлементЭкрана(ЭтотОбъект, "запись");
			Запись.ПринятьОпору(Элемент);
			Для Каждого Колонка Из Колонки Цикл
				Ячейка = Запись.Добавить(Новый ЭлементЭкрана(ЭтотОбъект, "ячейка",
					Строка(Колонка.Свойства().ВидЯчейки)));
				Положить(Ячейка, ЗначениеЯчейки(СтрокаДанных, Колонка.Свойства().Ключ),
					Колонка.Свойства().Ключ, Положенные);
			КонецЦикла;

			Если ЗначениеЗаполнено(Разворот) Тогда
				Положить(Запись.Разворот(), ЗначениеЯчейки(СтрокаДанных, Разворот), Разворот,
					Положенные);
			КонецЕсли;

			Записи.Добавить(Запись);

		КонецЦикла;

		Результат = ПечатьТаблицы(Элемент, Колонки, Записи, Новый Соответствие());

	Исключение
		Отпустить(Положенные);
		ВызватьИсключение;
	КонецПопытки;

	Отпустить(Положенные);
	Возврат Результат;

КонецФункции

// Колонки таблицы из данных в порядке печати: у таблицы значений — её колонки (объявленная
// словом Колонка переопределяет заголовок и вид), у массива — объявленные. Колонка
// разворота и снятая словом Когда в шапку не идут.
Функция КолонкиДанных(Знач Элемент, Знач Данные)

	Объявленные = Новый Соответствие();
	Порядок = Новый Массив();
	Для Каждого Колонка Из ДетиРода(Элемент, "колонка") Цикл
		Объявленные.Вставить(Колонка.Свойства().Ключ, Колонка);
		Порядок.Добавить(Колонка.Свойства().Ключ);
	КонецЦикла;

	Если ТипЗнч(Данные) = Тип("ТаблицаЗначений") Тогда
		Порядок = Новый Массив();
		Для Каждого Колонка Из Данные.Колонки Цикл
			Порядок.Добавить(Колонка.Имя);
		КонецЦикла;
	ИначеЕсли Порядок.Количество() = 0 Тогда
		ВызватьИсключение "Разметка элементов: таблица из массива без колонок — у записи-структуры"
			+ " нет порядка полей. Объявите колонки словом .Колонка(Ключ, Заголовок) в том"
			+ " порядке, в каком они стоят на экране.";
	КонецЕсли;

	Разворот = "";
	Элемент.Свойства().Свойство("Разворот", Разворот);

	Результат = Новый Массив();
	Для Каждого Ключ Из Порядок Цикл

		Если Ключ = Разворот Тогда
			Продолжить;
		КонецЕсли;

		Колонка = Объявленные.Получить(Ключ);
		Если Колонка = Неопределено Тогда
			Колонка = Новый ЭлементЭкрана(ЭтотОбъект, "колонка", "",
				Новый Структура("Ключ, Заголовок", Ключ, ЗаголовокКолонкиДанных(Элемент, Ключ)));
		КонецЕсли;

		Если Показан(Колонка) Тогда
			Колонка.Свойства().Вставить("ВидЯчейки",
				?(Колонка.Свойства().Вид = "узкая", "узкая", ""));
			Результат.Добавить(Колонка);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗначениеЯчейки(Знач СтрокаДанных, Знач Ключ)

	Если ТипЗнч(СтрокаДанных) = Тип("Соответствие") Тогда
		Возврат СтрокаДанных.Получить(Ключ);
	ИначеЕсли ТипЗнч(СтрокаДанных) = Тип("Структура") Тогда
		Значение = Неопределено;
		СтрокаДанных.Свойство(Ключ, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(СтрокаДанных) = Тип("СтрокаТаблицыЗначений") Тогда
		Возврат СтрокаДанных[Ключ];
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Разметка элементов: запись таблицы из данных — «%1»; запись"
		+ " бывает строкой таблицы значений, структурой или соответствием.", ТипЗнч(СтрокаДанных));

КонецФункции

// Значение ячейки: строка — текст, узел — узел, число — без разделителя групп, пусто —
// пустая ячейка. Дату и Булево кит не форматирует: формат даты и слова «да/нет» выбирает
// экран, а молча напечатанное «Истина» уехало бы человеку как есть.
Процедура Положить(Знач Холст, Знач Значение, Знач Ключ, Знач Положенные)

	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Если ЗначениеЗаполнено(Значение) Тогда
			Холст.Добавить(Значение);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Холст.Добавить(Формат(Значение, "ЧН=0; ЧГ=0"));
		Возврат;
	КонецЕсли;

	Если ТипЗнч(Значение) = Тип("ЭлементЭкрана") Тогда
		Холст.Добавить(Значение);
		Положенные.Добавить(Значение);
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Разметка элементов: в колонке «%1» значение типа «%2» — кит"
		+ " печатает в ячейке строку, число и узел. Дату и Булево отформатируйте сами"
		+ " (Формат(…, ""ДЛФ=D""), «да»/«нет»): какими словами их показать, решает экран.",
		Ключ, ТипЗнч(Значение));

КонецПроцедуры

Процедура Отпустить(Знач Положенные)
	Для Каждого Узел_ Из Положенные Цикл
		Узел_.ПринятьРодителя(Неопределено);
	КонецЦикла;
КонецПроцедуры

// Подписи ячеек по колонкам — только у таблицы карточками: на узком экране у записи нет
// шапки, и ячейка называет свою колонку сама. Заглавная (первая) колонка, колонка без
// заголовка и колонка, чьи значения называют себя сами, подписи не дают.
//
// Неопределено — таблица не карточками: её ячейки печатаются как есть.
Функция ПодписиЯчеек(Знач Элемент, Знач Колонки)

	Если Элемент.Свойства().Вид <> "карточками" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Массив();

	Для Каждого Колонка Из Колонки Цикл
		Заглавная = (Результат.Количество() = 0);
		Результат.Добавить(?(Заглавная ИЛИ Колонка.Свойства().БезПодписиВЗаписи = Истина,
			"", ЗаголовокСловами(Колонка)));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Заголовок колонки словами — её текстовые узлы подряд: подпись ячейки печатается
// атрибутом, разметка в него не годится.
Функция ЗаголовокСловами(Знач Колонка)

	Заголовок = Неопределено;
	Если Колонка.Состав().Количество() = 0 И Колонка.Свойства().Свойство("Заголовок", Заголовок)
		И Заголовок <> Неопределено Тогда
		Возврат СокрЛП(Заголовок);
	КонецЕсли;

	Части = Новый Массив();
	Для Каждого Текст Из ДетиРода(Колонка, "текст") Цикл
		Части.Добавить(Строка(Текст.Свойства().Текст));
	КонецЦикла;
	Возврат СокрЛП(СтрСоединить(Части, " "));

КонецФункции

Функция ЗаголовокТаблицы(Знач Элемент)

	Подпись = Строка(Элемент.Свойства().Подпись);
	Возврат ?(ЗначениеЗаполнено(Подпись),
		СтрШаблон("<caption>%1</caption>", Экран.Экранировать(Подпись)), "");

КонецФункции

Функция ШапкаТаблицы(Знач Колонки)

	Если Колонки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив();
	Для Каждого Колонка Из Колонки Цикл
		Части.Добавить(Узел(Колонка));
	КонецЦикла;

	Возврат СтрШаблон("<thead><tr>%1</tr></thead>", СтрСоединить(Части, ""));

КонецФункции

// Колонка таблицы из данных несёт заголовок полем, а не текстовым ребёнком: таблица
// значений отдаёт его на печати, и узел колонки при этом не меняется.
Функция Колонка(Знач Элемент)
	Возврат СтрШаблон("<th scope=""col""%1>%2</th>",
		Атрибуты(Элемент), ЗаголовокКолонки(Элемент));
КонецФункции

Функция ЗаголовокКолонки(Знач Элемент)

	Заголовок = Неопределено;
	Если Элемент.Состав().Количество() = 0 И Элемент.Свойства().Свойство("Заголовок", Заголовок)
		И Заголовок <> Неопределено Тогда
		Возврат Экран.Экранировать(Заголовок);
	КонецЕсли;
	Возврат Внутренности(Элемент);

КонецФункции

Функция ТелоТаблицы(Знач Записи, Знач Ширина, Знач Подписи, Знач Скрытые)

	Части = Новый Массив();
	Для Каждого Запись Из Записи Цикл
		Части.Добавить(ЗаписьТаблицы(Запись, Ширина, Подписи, Скрытые));
	КонецЦикла;

	Возврат СтрШаблон("<tbody>%1</tbody>", СтрСоединить(Части, ""));

КонецФункции

// Разворот печатается ОТДЕЛЬНОЙ строкой под записью и во всю ширину таблицы: внутрь <tr>
// его не вложить, поэтому запись и её разворот — две строки, связанные классами.
Функция ЗаписьТаблицы(Знач Элемент, Знач Ширина, Знач Подписи, Знач Скрытые)

	Разворот = Элемент.Разворот();
	Ячейки = ЯчейкиЗаписи(Элемент, Подписи, Скрытые);

	Если Разворот.Состав().Количество() = 0 Тогда
		Возврат СтрШаблон("<tr%1>%2</tr>", Атрибуты(Элемент), Ячейки);
	КонецЕсли;

	Возврат СтрШаблон("<tr%1>%2</tr><tr class=""%3""><td colspan=""%4"">%5</td></tr>",
		Атрибуты(Элемент, КлассЗаписиСРазворотом()), Ячейки, КлассРазворота(),
		Формат(Ширина, "ЧН=0; ЧГ=0"), Внутренности(Разворот));

КонецФункции

// Ячейки записи. В таблице карточками ячейка несёт подпись своей колонки — кроме пустой
// и ячейки с меню строки (там действия, а не значение). Пустая ячейка помечается классом:
// по нему лист прячет её на узком экране, и «пустая» здесь и там — одно и то же. Помечается
// она и тогда, когда колонок у таблицы нет вовсе.
Функция ЯчейкиЗаписи(Знач Элемент, Знач Подписи, Знач Скрытые)

	Если Подписи = Неопределено И Скрытые.Количество() = 0 Тогда
		Возврат Внутренности(Элемент);
	КонецЕсли;

	Части = Новый Массив();
	Место = -1;
	Для Каждого Ячейка Из Элемент.Состав() Цикл

		// ячейка под снятой колонкой уходит вместе с колонкой
		Место = Место + 1;
		Если Скрытые.Получить(Место) = Истина ИЛИ НЕ Показан(Ячейка) Тогда
			Продолжить;
		КонецЕсли;

		Если Подписи = Неопределено Тогда
			Части.Добавить(Узел(Ячейка));
			Продолжить;
		КонецЕсли;

		Номер = Части.Количество();
		Содержимое = Внутренности(Ячейка);
		Пустая = ПустоеСодержимое(Содержимое);

		Подпись = ?(Номер < Подписи.Количество(), Подписи[Номер], "");
		Если Пустая ИЛИ ЕстьМенюСтроки(Ячейка) Тогда
			Подпись = "";
		КонецЕсли;

		Части.Добавить(СтрШаблон("<%1%2%3>%4</%1>", Теги.Получить(Ячейка.Род()),
			Атрибуты(Ячейка, ?(Пустая, КлассПустойЯчейки(), "")),
			Экран.Атрибут("data-label", Подпись), Содержимое));

	КонецЦикла;

	Возврат СтрСоединить(Части, "");

КонецФункции

// Пустая ячейка — та, в которой человеку нечего прочесть: напечаталось ничего либо одни
// пробелы (Кит.Ничего(), Кит.Текст(" ") и их соседство).
Функция ПустоеСодержимое(Знач Содержимое)
	Возврат СокрЛП(Содержимое) = "";
КонецФункции

Функция КлассПустойЯчейки()
	Возврат "cell-empty";
КонецФункции

// Меню строки ищется на любой глубине: шестерёнку кладут и в ряд рядом с кнопкой.
Функция ЕстьМенюСтроки(Знач Элемент)

	Для Каждого Ребёнок Из Элемент.Состав() Цикл
		Если (Ребёнок.Род() = "компонент" И Ребёнок.Свойства().Вид = "меню")
			ИЛИ ЕстьМенюСтроки(Ребёнок) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Во столько колонок печатается разворот. Без шапки считать не по чему, кроме самих
// записей: colspan="0" браузер понимает как одну колонку, и разворот съёжился бы в неё.
Функция ШиринаТаблицы(Знач Колонки, Знач Записи, Знач Скрытые)

	Если Колонки.Количество() > 0 Тогда
		Возврат Колонки.Количество();
	КонецЕсли;

	Результат = 1;
	Для Каждого Запись Из Записи Цикл
		Результат = Макс(Результат, Запись.Состав().Количество() - Скрытые.Количество());
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ДетиРода(Знач Элемент, Знач Род)

	Результат = Новый Массив();
	Для Каждого Ребёнок Из Элемент.Состав() Цикл
		Если Ребёнок.Род() = Род Тогда
			Результат.Добавить(Ребёнок);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция КлассПрокрутки()
	Возврат "table-scroll";
КонецФункции

Функция КлассЗаписиСРазворотом()
	Возврат "table__record";
КонецФункции

Функция КлассРазворота()
	Возврат "table__expand";
КонецФункции

#КонецОбласти

#Область РазметкаОкон

// Окна (выпуск 0.11): окно со слотами, подтверждение, окно по адресу и его оболочка.
// Дерево окна печатается здесь — тело, действия, адрес и токен формы из контекста, —
// а рамку рисует желудь «Окно»: та же, что у прежнего окна объявленной формы.

// Идентификатор окна — на него ссылаются открывашка (commandfor), aria-labelledby
// и форма с подтверждением (data-confirm). Якорь узла главнее; без якоря кит выдаёт
// идентификатор сам — из заголовка и места узла в дереве, а не счётчиком: ответ на тот же
// запрос обязан повторяться байт в байт, а два окна с одним заголовком в разных местах
// страницы получают разные идентификаторы.
//
// Параметры:
//  Элемент - ЭлементЭкрана - узел рода «окно» или «подтверждение».
//
// Возвращаемое значение:
//  Строка
//
Функция ИдОкна(Знач Элемент) Экспорт

	Якорь = Строка(Элемент.Свойства().Якорь);
	Если ЗначениеЗаполнено(Якорь) Тогда
		Возврат Якорь;
	КонецЕсли;

	Хеш = Новый ХешированиеДанных(ХешФункция.SHA1);
	Хеш.Добавить(Строка(Элемент.Свойства().Заголовок) + "|" + МестоВДереве(Элемент));
	Возврат "okno-" + НРег(Лев(Хеш.ХешСуммаСтрокой, 8));

КонецФункции

// Окно ли этот род — то, что открывает кнопка словом Открывает.
//
// Параметры:
//  Род - Строка - род узла.
//
// Возвращаемое значение:
//  Булево
//
Функция ЭтоОкно(Знач Род) Экспорт
	Возврат Род = "окно" ИЛИ Род = "подтверждение";
КонецФункции

// Место узла в дереве — номера детей от корня. Второй холст и опора (значение ячейки
// таблицы из данных) названы буквой: у владельца в составе их нет.
Функция МестоВДереве(Знач Элемент)

	Части = Новый Массив();
	Узел_ = Элемент;
	Выше_ = Узел_.Выше();
	Пока Выше_ <> Неопределено Цикл
		Номер = Выше_.Состав().Найти(Узел_);
		Если Номер <> Неопределено Тогда
			Части.Вставить(0, Формат(Номер, "ЧН=0; ЧГ=0"));
		ИначеЕсли Выше_.ВторойХолст() = Узел_ Тогда
			Части.Вставить(0, "в");
		Иначе
			Части.Вставить(0, "о");
		КонецЕсли;
		Узел_ = Выше_;
		Выше_ = Узел_.Выше();
	КонецЦикла;
	Возврат СтрСоединить(Части, ".");

КонецФункции

Функция Корень(Знач Элемент)

	Узел_ = Элемент;
	Пока Узел_.Выше() <> Неопределено Цикл
		Узел_ = Узел_.Выше();
	КонецЦикла;
	Возврат Узел_;

КонецФункции

// Окно по идентификатору в дереве того же корня: кнопка, которой дали идентификатор
// строкой, открывает окно, если оно на этой странице.
Функция НайтиОкно(Знач Узел_, Знач Ид)

	Если ЭтоОкно(Узел_.Род()) И ИдОкна(Узел_) = Ид Тогда
		Возврат Узел_;
	КонецЕсли;

	Второй = Узел_.ВторойХолст();
	Если Второй <> Неопределено Тогда
		Найденное = НайтиОкно(Второй, Ид);
		Если Найденное <> Неопределено Тогда
			Возврат Найденное;
		КонецЕсли;
	КонецЕсли;

	Для Каждого Ребёнок Из Узел_.Состав() Цикл
		Найденное = НайтиОкно(Ребёнок, Ид);
		Если Найденное <> Неопределено Тогда
			Возврат Найденное;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Кнопка, которая открывает окно, — команда движка show-modal и commandfor. Узел окна
// даёт свой идентификатор; строка, совпавшая с окном этой страницы, — тоже окно, иначе
// это прежний смысл слова: всплывающая панель (popovertarget).
Процедура ОткрывашкаОкна(Знач Элемент, Знач Модель)

	Поля = Элемент.Свойства();
	Окно_ = Неопределено;
	Если НЕ Поля.Свойство("ОткрываетОкно", Окно_) Тогда
		Ид = "";
		Если НЕ Модель.Свойство("Открывает", Ид) ИЛИ НЕ ЗначениеЗаполнено(Ид) Тогда
			Возврат;
		КонецЕсли;
		Окно_ = НайтиОкно(Корень(Элемент), Строка(Ид));
		Если Окно_ = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если Модель.Свойство("Открывает") Тогда
		Модель.Удалить("Открывает");
	КонецЕсли;
	Модель.Вставить("Команда", "показать-окно");
	Модель.Вставить("Цель", ИдОкна(Окно_));

КонецПроцедуры

Функция Окно(Знач Элемент)

	// прежнее окно объявленной формы приходит напечатанным той же рамкой
	Готовое = Неопределено;
	Если Элемент.Свойства().Свойство("Разметка", Готовое) Тогда
		Возврат Строка(Готовое);
	КонецЕсли;

	Модель = МодельОкна(Элемент);
	Модель.Вставить("Тело", Внутренности(Элемент));
	Действия = Элемент.ВторойХолст();
	Модель.Вставить("Действия", ?(Действия = Неопределено, "", Внутренности(Действия)));
	Возврат Строка(Элемент.Свойства().Рисователь.Отрисовать(Модель));

КонецФункции

// Модель рамки окна: идентификатор, заголовок, класс вида, лид, открытость, признаки
// и форма окна. Тихая отправка (признак quiet) у окна-формы уходит на форму: окну её
// признак ни к чему, а форма без него ушла бы навигацией.
Функция МодельОкна(Знач Элемент)

	Поля = Элемент.Свойства();
	Модель = Новый Структура();
	Модель.Вставить("Ид", ИдОкна(Элемент));
	Модель.Вставить("Заголовок", Строка(Поля.Заголовок));
	Модель.Вставить("Класс", Класс(Элемент));
	Модель.Вставить("Лид", Строка(Поля.Лид));
	Модель.Вставить("Открыто", Поля.Открыто = Истина);

	Хвост = Неопределено;
	ЕстьФорма = Поля.Свойство("ХвостФормы", Хвост) И Хвост <> Неопределено;
	Модель.Вставить("Признаки", СтрокаПризнаков(Элемент.Признаки(), ?(ЕстьФорма, "quiet", "")));

	Если ЕстьФорма Тогда
		Модель.Вставить("Форма", ФормаОкна(Элемент, Хвост));
	КонецЕсли;

	Возврат Модель;

КонецФункции

Функция ФормаОкна(Знач Элемент, Знач Хвост)

	Поля = Элемент.Свойства();
	Действие = АдресВКонтексте(Элемент, Хвост, СтрШаблон("окно «%1»", Поля.Заголовок));
	Токен = ТокенКонтекста(Элемент);
	Если НЕ ЗначениеЗаполнено(Токен) Тогда
		ВызватьИсключение СтрШаблон("Разметка элементов: окно «%1» — форма на «%2» без"
			+ " CSRF-токена. Задайте токен словом .Токен(…) — у окна или у холста вокруг, —"
			+ " иначе форма гарантированно получит 403.", Поля.Заголовок, Действие);
	КонецЕсли;

	Тихо = "";
	Признаки = Элемент.Признаки();
	Если Признаки <> Неопределено И Признаки.Получить("quiet") <> Неопределено Тогда
		Тихо = Экран.АтрибутВсегда("data-quiet", Признаки.Получить("quiet"));
	КонецЕсли;

	Возврат Новый Структура("Действие, ПолеТокена, Файлы, Признаки", Действие,
		Поля.РисовательТокена.Отрисовать(Новый Структура("Имя, Значение", Поля.ИмяТокена, Токен)),
		Поля.Файлы = Истина, Тихо);

КонецФункции

// Признаки печатаются ДАЖЕ ПУСТЫМИ — по ним скрипт находит элемент (см. Атрибуты).
Функция СтрокаПризнаков(Знач Признаки, Знач Кроме = "")

	Если Признаки = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Результат = "";
	Для Каждого КиЗ Из Признаки Цикл
		Если КиЗ.Ключ <> Кроме Тогда
			Результат = Результат + Экран.АтрибутВсегда("data-" + КиЗ.Ключ, КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Подтверждение — окно вида «опасное»: последствия, дети узла, эхо-поле и кнопка цвета
// ошибки. Отправляет оно свою форму (слово Форма), форму, которая назвала его словом
// СПодтверждением, или форму, внутри которой лежит; без формы кнопке нечего подтверждать.
Функция ПодтверждениеОкна(Знач Элемент)

	Поля = Элемент.Свойства();
	Модель = МодельОкна(Элемент);
	Модель.Вставить("Последствия", Строка(Поля.Последствия));
	Модель.Вставить("Дополнение", Внутренности(Элемент));
	Модель.Вставить("Эхо", Поля.Эхо);
	Ошибка = "";
	Поля.Свойство("ОшибкаЭха", Ошибка);
	Модель.Вставить("ОшибкаЭха", Строка(?(Ошибка = Неопределено, "", Ошибка)));
	Модель.Вставить("Кнопка", Строка(Поля.Кнопка));
	Модель.Вставить("ФормаИд", "");

	Если НЕ Модель.Свойство("Форма") Тогда
		Связанная = ФормаСПодтверждением(Элемент, Модель.Ид);
		Если Связанная <> Неопределено Тогда
			Модель.Вставить("ФормаИд", ИдФормыСПодтверждением(Связанная, Модель.Ид));
		ИначеЕсли НЕ ВнутриФормы(Элемент) Тогда
			ВызватьИсключение СтрШаблон("Разметка элементов: подтверждению «%1» нечего"
				+ " отправлять. Дайте ему свою форму словом .Форма(Адрес), назовите его у формы"
				+ " словом .СПодтверждением(…) или положите внутрь формы.", Поля.Заголовок);
		КонецЕсли;
	КонецЕсли;

	Возврат Строка(Поля.Рисователь.Отрисовать(Модель));

КонецФункции

// Форма, которая открывает это подтверждение: та, что назвала его узлом (обратная ссылка),
// а для имени строкой — форма этого же дерева с таким идентификатором подтверждения.
Функция ФормаСПодтверждением(Знач Подтверждение, Знач Ид)

	Связанная = Неопределено;
	Если Подтверждение.Свойства().Свойство("ФормаСвязи", Связанная) И Связанная <> Неопределено Тогда
		Возврат Связанная;
	КонецЕсли;
	Возврат НайтиФормуСПодтверждением(Корень(Подтверждение), Ид);

КонецФункции

Функция НайтиФормуСПодтверждением(Знач Узел_, Знач Ид)

	Цель = Неопределено;
	Если ЭтоФорма(Узел_.Род()) И Узел_.Свойства().Свойство("Подтверждение", Цель) Тогда
		Если ИдПодтверждения(Цель) = Ид Тогда
			Возврат Узел_;
		КонецЕсли;
	КонецЕсли;

	Второй = Узел_.ВторойХолст();
	Если Второй <> Неопределено Тогда
		Найденная = НайтиФормуСПодтверждением(Второй, Ид);
		Если Найденная <> Неопределено Тогда
			Возврат Найденная;
		КонецЕсли;
	КонецЕсли;

	Для Каждого Ребёнок Из Узел_.Состав() Цикл
		Найденная = НайтиФормуСПодтверждением(Ребёнок, Ид);
		Если Найденная <> Неопределено Тогда
			Возврат Найденная;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ВнутриФормы(Знач Элемент)

	Узел_ = Элемент.Выше();
	Пока Узел_ <> Неопределено Цикл
		Если ЭтоФорма(Узел_.Род()) ИЛИ (Узел_.Род() = "секция"
			И Узел_.Свойства().Свойство("ХвостФормы")) Тогда
			Возврат Истина;
		КонецЕсли;
		Узел_ = Узел_.Выше();
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ИдПодтверждения(Знач Цель)
	Возврат ?(ТипЗнч(Цель) = Тип("Строка"), Цель, ИдОкна(Цель));
КонецФункции

// Форма с подтверждением отправляется кнопкой подтверждения, которая стоит в окне, вне
// её: кнопка и эхо-поле ссылаются на форму атрибутом form, поэтому у формы есть id —
// якорь, а без него выданный от идентификатора подтверждения.
Функция ИдФормыСПодтверждением(Знач Форма_, Знач ИдОкна_)
	Якорь = Строка(Форма_.Свойства().Якорь);
	Возврат ?(ЗначениеЗаполнено(Якорь), Якорь, ИдОкна_ + "-form");
КонецФункции

// Признак data-confirm формы: скрипт перехватывает её отправку и открывает подтверждение
// с этим идентификатором. Без скрипта форма уходит как есть, и подтверждение спрашивает
// сервер — страницей с тем же окном, напечатанным открытым.
Функция ПризнакПодтверждения(Знач Элемент)

	Цель = Неопределено;
	Если НЕ Элемент.Свойства().Свойство("Подтверждение", Цель) Тогда
		Возврат "";
	КонецЕсли;

	Ид = ИдПодтверждения(Цель);
	Возврат ?(ЗначениеЗаполнено(Элемент.Свойства().Якорь), "",
			Экран.Атрибут("id", ИдФормыСПодтверждением(Элемент, Ид)))
		+ Экран.АтрибутВсегда("data-confirm", Ид);

КонецФункции

// Окно по адресу — ссылка-кнопка; на печати узел отмечает корень своего дерева, и оболочка
// окна, которая печатается в теле страницы ПОСЛЕ содержимого, видит отметку без второго
// прохода по дереву.
Функция ОкноПоАдресу(Знач Элемент)

	Корень(Элемент).Свойства().Вставить("ЕстьОкноПоАдресу", Истина);
	Возврат Строка(Элемент.Свойства().Рисователь.Отрисовать(КопияМодели(Элемент.Свойства().Модель)));

КонецФункции

// Одна оболочка на страницу: печатается, если на странице есть хоть одно окно по адресу
// (отметка корня), либо безусловно — тому, кто знает это сам (содержимое строкой).
Функция ОболочкаОкна(Знач Элемент)

	Поля = Элемент.Свойства();
	Есть = Поля.Всегда = Истина ИЛИ Корень(Элемент).Свойства().Свойство("ЕстьОкноПоАдресу");
	Возврат ?(Есть, Строка(Поля.Рисователь.Оболочка()), "");

КонецФункции

// Роды окон: окно со слотами (действия — второй холст), подтверждение (всегда опасное),
// ссылка-кнопка окна по адресу и одна на страницу оболочка для него.
Процедура СобратьРодыОкон()

	ОбъявитьРод("окно", "dialog", Истина);
	ОбъявитьВид("окно", "", "modal");
	ОбъявитьВид("окно", "обычное", "modal");
	ОбъявитьВид("окно", "опасное", "modal modal--danger");
	ОбъявитьВид("окно", "широкое", "modal modal--wide");
	ОбъявитьВторойХолст("окно", "действия");

	ОбъявитьРод("подтверждение", "dialog", Истина);
	ОбъявитьВид("подтверждение", "", "modal modal--danger modal--confirm");

	ОбъявитьРод("окно-по-адресу", "a", Ложь);
	ОбъявитьВид("окно-по-адресу", "", "");

	ОбъявитьРод("оболочка-окна", "dialog", Ложь);
	ОбъявитьВид("оболочка-окна", "", "");

КонецПроцедуры

#КонецОбласти

#Область Наборы

Функция ИзвестныеВиды(Знач Род)

	Имена = Новый Массив();
	Для Каждого Вид Из ВидыРода(Род) Цикл
		Имена.Добавить(?(ЗначениеЗаполнено(Вид), Вид, "—"));
	КонецЦикла;
	Возврат СтрСоединить(Имена, ", ");

КонецФункции

Функция ПеречислитьКлючи(Знач Известные)

	Имена = Новый Массив();
	Для Каждого КиЗ Из Известные Цикл
		Имена.Добавить("«" + КиЗ.Ключ + "»");
	КонецЦикла;
	Возврат Имена;

КонецФункции

Процедура ОбъявитьРод(Знач Род, Знач Тег, Знач Вложение)
	Теги.Вставить(Род, Тег);
	Контейнеры.Вставить(Род, Вложение);
	КлассыВида.Вставить(Род, Новый Соответствие());
КонецПроцедуры

Процедура ОбъявитьВид(Знач Род, Знач Вид, Знач Класс)
	КлассыВида.Получить(Род).Вставить(Вид, Класс);
КонецПроцедуры

Процедура ОбъявитьВторойХолст(Знач Род, Знач Имя)
	ВторыеХолсты.Вставить(Род, Имя);
КонецПроцедуры

// Раскрывашка печатает три тега сразу, и класс у каждого свой: у «простой» их нет вовсе,
// у панели — все три.
Процедура ОбъявитьРаскрывашку(Знач Вид, Знач Класс, Знач КлассШапки, Знач КлассТела)
	ОбъявитьВид("раскрывашка", Вид, Класс);
	КлассыШапки.Вставить(Вид, КлассШапки);
	КлассыТела.Вставить(Вид, КлассТела);
КонецПроцедуры

Процедура ОбъявитьМету(Знач Вид, Знач КлассРяда, Знач КлассЭлемента)
	КлассыМетыПоВиду.Вставить(Вид,
		Новый Структура("Ряд, Элемент", КлассРяда, КлассЭлемента));
КонецПроцедуры

Процедура ОбъявитьДетей(Знач Род, Знач Роды)

	Допустимые = Новый Соответствие();
	Для Каждого Имя Из СтрРазделить(Роды, ",") Цикл
		Допустимые.Вставить(СокрЛП(Имя), Истина);
	КонецЦикла;
	ДетиРодов.Вставить(Род, Допустимые);

КонецПроцедуры

// Три рода формы отличаются не оформлением, а тем, чем защищён отправленный запрос,
// поэтому раскладка у них общая.
Процедура ОбъявитьФорму(Знач Род)
	ОбъявитьРод(Род, "form", Истина);
	ОбъявитьВид(Род, "", "");
	ОбъявитьВид(Род, "столбик", "form-stack");
	ОбъявитьВид(Род, "строкой", "form-inline");
	ОбъявитьВид(Род, "меню", "menu__form");
	ОбъявитьВид(Род, "переключатель", "theme-toggle");
КонецПроцедуры

// Роды документа: то, из чего собирается страница целиком — от объявления типа
// до отложенного скрипта. Своих видов у них почти нет: документ один на страницу.
Процедура СобратьРодыДокумента()

	ОбъявитьРод("документ", "html", Истина);
	ОбъявитьВид("документ", "", "");
	ОбъявитьДетей("документ", "голова,тело");

	ОбъявитьРод("голова", "head", Истина);
	ОбъявитьВид("голова", "", "");
	ОбъявитьДетей("голова", "титул,мета,ресурс,стиль,скрипт");

	ОбъявитьРод("титул", "title", Истина);
	ОбъявитьВид("титул", "", "");
	ОбъявитьДетей("титул", "текст");

	ОбъявитьРод("мета", "meta", Ложь);
	ОбъявитьВид("мета", "", "");

	ОбъявитьРод("ресурс", "link", Ложь);
	ОбъявитьВид("ресурс", "", "");

	ОбъявитьРод("стиль", "style", Ложь);
	ОбъявитьВид("стиль", "", "");

	ОбъявитьРод("скрипт", "script", Ложь);
	ОбъявитьВид("скрипт", "", "");

	ОбъявитьРод("тело", "body", Истина);
	ОбъявитьВид("тело", "", "");

	ОбъявитьРод("шапка", "header", Истина);
	ОбъявитьВид("шапка", "", "");
	ОбъявитьВид("шапка", "страницы", "top");
	ОбъявитьВид("шапка", "меню", "top top--menu");

	ОбъявитьРод("основное", "main", Истина);
	ОбъявитьВид("основное", "", "");
	ОбъявитьВид("основное", "полоса", "wrap");

	ОбъявитьРод("подвал", "footer", Истина);
	ОбъявитьВид("подвал", "", "");
	ОбъявитьВид("подвал", "страницы", "bottom");

	ОбъявитьРод("навигация", "nav", Истина);
	ОбъявитьВид("навигация", "", "");
	ОбъявитьВид("навигация", "верхняя", "top__nav");

КонецПроцедуры

Процедура СобратьНаборы()

	Контейнеры = Новый Соответствие();
	Теги = Новый Соответствие();
	КлассыВида = Новый Соответствие();
	ВторыеХолсты = Новый Соответствие();
	ДетиРодов = Новый Соответствие();
	КлассыШапки = Новый Соответствие();
	КлассыТела = Новый Соответствие();

	ОбъявитьРод("холст", "", Истина);
	ОбъявитьВид("холст", "", "");

	СобратьРодыДокумента();

	ОбъявитьРод("область", "div", Истина);
	ОбъявитьВид("область", "", "");
	ОбъявитьВид("область", "полоса", "wrap");
	ОбъявитьВид("область", "проза", "prose");
	ОбъявитьВид("область", "карточки", "objcard-list");
	ОбъявитьВид("область", "шапка", "objcard__head");
	ОбъявитьВид("область", "плашки", "objcard__chips");
	ОбъявитьВид("область", "действия", "objcard__actions");
	ОбъявитьВид("область", "отбор", "chips-bar");
	ОбъявитьВид("область", "вставка", "inset");
	ОбъявитьВид("область", "студия", "studio");
	ОбъявитьВид("область", "работа", "studio__work");
	ОбъявитьВид("область", "образец", "studio__sample");
	ОбъявитьВид("область", "поле", "field");

	ОбъявитьРод("ряд", "div", Истина);
	ОбъявитьВид("ряд", "выбор", "choice-row");
	ОбъявитьВид("ряд", "признаки", "chips");
	ОбъявитьВид("ряд", "свёрнутые", "tag-row tag-row--inline");
	ОбъявитьВид("ряд", "справа", "row-end");
	ОбъявитьВид("ряд", "строкой", "row-line");
	ОбъявитьВид("ряд", "действия", "actions-row");

	ОбъявитьРод("статья", "article", Истина);
	ОбъявитьВид("статья", "", "");
	ОбъявитьВид("статья", "карточка", "objcard");

	ОбъявитьРод("раскрывашка", "details", Истина);
	ОбъявитьРаскрывашку("", "panel", "panel__head", "panel__body");
	ОбъявитьРаскрывашку("простая", "", "", "");
	ОбъявитьРаскрывашку("врезка", "fold", "fold__head", "");
	ОбъявитьРаскрывашку("подробность", "fold-detail", "", "");
	ОбъявитьРаскрывашку("хвост", "tag-row__more", "tag-row__count", "tag-row__rest");
	ОбъявитьВторойХолст("раскрывашка", "шапка");

	ОбъявитьРод("группа", "fieldset", Истина);
	ОбъявитьВид("группа", "", "");
	ОбъявитьВид("группа", "набор", "choice-set");
	ОбъявитьВид("группа", "простая", "field-set");
	ОбъявитьВид("группа", "раздел", "form-section");

	ОбъявитьФорму("форма");
	ОбъявитьФорму("форма-без-сессии");
	ОбъявитьФорму("форма-отбора");
	ОбъявитьФорму("форма-без-токена");

	ОбъявитьРод("таблица", "table", Истина);
	ОбъявитьВид("таблица", "", "table");
	ОбъявитьВид("таблица", "карточками", "table table-cards");
	ОбъявитьВторойХолст("таблица", "пусто");
	ОбъявитьДетей("таблица", "колонка,запись");

	ОбъявитьРод("колонка", "th", Истина);
	ОбъявитьВид("колонка", "", "");
	ОбъявитьВид("колонка", "узкая", "col-narrow");

	ОбъявитьРод("запись", "tr", Истина);
	ОбъявитьВид("запись", "", "");
	ОбъявитьВид("запись", "выделенная", "row-accent");
	ОбъявитьВторойХолст("запись", "разворот");
	ОбъявитьДетей("запись", "ячейка");

	ОбъявитьРод("ячейка", "td", Истина);
	ОбъявитьВид("ячейка", "", "");
	ОбъявитьВид("ячейка", "величина", "cell-value");
	ОбъявитьВид("ячейка", "столбиком", "cell-stack");
	ОбъявитьВид("ячейка", "узкая", "cell-narrow");

	ОбъявитьРод("заголовок", "h1…h6", Истина);
	ОбъявитьВид("заголовок", "", "");
	ОбъявитьВид("заголовок", "имя", "objcard__name");

	ОбъявитьРод("надпись", "span", Истина);
	ОбъявитьВид("надпись", "", "");
	ОбъявитьВид("надпись", "название", "text-name");
	ОбъявитьВид("надпись", "пояснение", "text-hint");
	ОбъявитьВид("надпись", "сноска", "text-note");
	ОбъявитьВид("надпись", "приглушённая", "muted");
	ОбъявитьВид("надпись", "приписка", "text-below");
	ОбъявитьВид("надпись", "ключ", "text-key");
	ОбъявитьВид("надпись", "заголовок", "inset__title");
	ОбъявитьВид("надпись", "лид", "inset__lead");
	ОбъявитьВид("надпись", "метка", "field__label");
	ОбъявитьВид("надпись", "учётка", "who");

	ОбъявитьРод("примечание", "p", Истина);
	ОбъявитьВид("примечание", "", "muted");
	ОбъявитьВид("примечание", "описание", "objcard__desc");
	ОбъявитьВид("примечание", "источник", "note-origin");
	ОбъявитьВид("примечание", "пусто", "note-empty");

	ОбъявитьРод("ссылка", "a", Истина);
	ОбъявитьВид("ссылка", "", "");
	ОбъявитьВид("ссылка", "пилюля", "chip");
	ОбъявитьВид("ссылка", "пилюля-текущая", "chip chip--active");
	ОбъявитьВид("ссылка", "знак", "brand");
	ОбъявитьВид("ссылка", "шапка", "top__link");

	ОбъявитьРод("список", "ul", Истина);
	ОбъявитьВид("список", "", "");
	ОбъявитьВид("список", "сноска", "list-note");
	ОбъявитьДетей("список", "пункт");

	ОбъявитьРод("пункт", "li", Истина);
	ОбъявитьВид("пункт", "", "");

	ОбъявитьРод("свойства", "dl", Истина);
	ОбъявитьВид("свойства", "", "props");
	ОбъявитьДетей("свойства", "свойство");

	// своего тега нет: свойство печатается ПАРОЙ <dt>/<dd>, а не одним тегом
	ОбъявитьРод("свойство", "", Истина);
	ОбъявитьВид("свойство", "", "");

	ОбъявитьРод("код", "code", Истина);
	ОбъявитьВид("код", "", "");
	ОбъявитьВид("код", "блочный", "code");
	ОбъявитьВид("код", "приглушённый", "muted");

	ОбъявитьРод("шаблон", "", Истина);
	ОбъявитьВид("шаблон", "", "");

	ОбъявитьРод("картинка", "img", Ложь);
	ОбъявитьВид("картинка", "", "");
	ОбъявитьВид("картинка", "значок", "image-icon");
	ОбъявитьВид("картинка", "значок-малый", "image-icon image-icon--small");
	ОбъявитьВид("картинка", "превью", "image-preview");
	ОбъявитьВид("картинка", "знак", "brand__mark");

	ОбъявитьРод("текст", "", Ложь);
	ОбъявитьВид("текст", "", "");

	ОбъявитьРод("готовое", "", Ложь);
	ОбъявитьВид("готовое", "", "");

	ОбъявитьРод("компонент", "", Ложь);
	Для Каждого Имя Из СтрРазделить("кнопка,плашка,плашки,поле,поле-конфига,скрытое,команда,"
		+ "карточка,зона,сетка,шапка,заглавие,пустое,вкладки,вкладка,поиск,страницы,отказ,шаги,"
		+ "иконка,мета,полоса,тумблер,меню,пункт-меню,меню-бургер,меню-учётка,меню-панель,"
		+ "плитка,уведомление,разделы,панель,сводка,дерево-галок,крошки,крошка,"
		+ "объявление,окно", ",") Цикл
		ОбъявитьВид("компонент", Имя, "");
	КонецЦикла;

	// каркас настроек: дом печатает разделы и секции каркасом, раздел — лист без своей
	// разметки (он строка колонки разделов), секция — карточка-<section>
	ОбъявитьРод("дом", "div", Истина);
	ОбъявитьВид("дом", "", "");
	ОбъявитьДетей("дом", "секция,раздел");

	ОбъявитьРод("раздел", "", Ложь);
	ОбъявитьВид("раздел", "", "");

	ОбъявитьРод("секция", "section", Истина);
	ОбъявитьВид("секция", "", "");
	// действия секции — кнопки справа от её заголовка: второй холст, а не дети, потому что
	// дети секции — её тело
	ОбъявитьВторойХолст("секция", "действия");

	// --- шаги (выпуск 0.11, шаг 10) ---
	// шаги печатает свой рисователь: корень — блок, шаг — панель-раскрывашка; внутрь шагов
	// кладут только шаги, шаг вне шагов не печатается
	ОбъявитьРод("шаги", "div", Истина);
	ОбъявитьВид("шаги", "", "steps");
	ОбъявитьВид("шаги", "вкладки", "steps steps--tabs");
	ОбъявитьДетей("шаги", "шаг");

	ОбъявитьРод("шаг", "details", Истина);
	ОбъявитьВид("шаг", "", "panel steps__panel");
	// --- реестр (шаг 11): немногие записи — сводка, действия снаружи неё, тело с кнопками.
	// Тег реестра — ul, нумерованного — ol; запись — li с раскрывашкой внутри. Действия
	// записи — второй холст (вне сводки), набор кнопок — её третий холст (слово Кнопки)
	ОбъявитьРод("реестр", "ul", Истина);
	ОбъявитьВид("реестр", "", "");
	ОбъявитьВторойХолст("реестр", "пусто");
	ОбъявитьДетей("реестр", "запись-реестра");

	ОбъявитьРод("запись-реестра", "li", Истина);
	ОбъявитьВид("запись-реестра", "", "");
	ОбъявитьВторойХолст("запись-реестра", "действия");
	СобратьРодыОкон();

	СобратьСлова();

	// ряд метаданных оформляется парой классов — сам ряд и один его элемент, — поэтому
	// его виды живут отдельной таблицей, а не в общей «род -> вид -> класс»
	КлассыМетыПоВиду = Новый Соответствие();
	ОбъявитьМету("шапка", "objhead__meta", "objhead__meta-item");
	ОбъявитьМету("карточка", "objcard__meta", "objcard__meta-item");

	РолиARIA = Новый Соответствие();
	РолиARIA.Вставить("группа", "group");
	РолиARIA.Вставить("состояние", "status");
	РолиARIA.Вставить("тревога", "alert");

КонецПроцедуры

// Слова компонентов и узлов каркаса настроек: слово пишет поле модели, и закрытый список
// у каждого носителя свой. Общие слова узла (Признак, Роль, Когда, Токен) здесь не
// перечислены — они есть у всех.
Процедура СобратьСлова()

	СловаНосителей = Новый Соответствие();
	ОбъявитьСлова("кнопка", "Подпись, Основная, Вторичная, Опасная, Ссылкой, Малая, Большая,"
		+ " Обычная, Иконка, ТолькоИконка, Адрес, Имя, БезВалидации, АдресОтправки, ВНовойВкладке,"
		+ " ВФорме, Заблокирована, Занята, Подсказка, ВоВсюШирину, Текущая, Команда, Открывает,"
		+ " Счётчик, ЗнакРаскрытия, Картинка");
	ОбъявитьСлова("плашка", "Вид, Адрес, Иконка, Подсказка");
	ОбъявитьСлова("карточка", "Адрес, Описание, Иконка, Уровень, Якорь");
	ОбъявитьСлова("зона", "Пояснение, Подтверждение, Кнопка");
	ОбъявитьСлова("шапка", "Иконка, Описание, Подпись, Вид, Знак, Мета, Плашка, Команда");
	ОбъявитьСлова("заглавие", "Пояснение, Уровень");
	ОбъявитьСлова("команда", "Подпись, Пояснение, БезКопирования");
	ОбъявитьСлова("страницы", "ЕстьСледующая, Параметр, Параметры, ПодписьНазад, ПодписьВперёд,"
		+ " Заголовок");
	ОбъявитьСлова("поиск", "Имя, Метка, Значение, Пример, Кнопка, СкрытоеПоле, Поле");
	ОбъявитьСлова("вкладки", "Заголовок");
	ОбъявитьСлова("вкладка", "Подпись, Активна, Иконка, Счётчик");
	ОбъявитьСлова("меню", "Подпись, Иконка, Аккаунт, Счётчик");
	ОбъявитьСлова("пункт-меню", "Подпись, Иконка");
	ОбъявитьСлова("сводка", "Подпись, Знак, Сведение");
	ОбъявитьСлова("сетка", "Колонки, Плотная, Заголовок");
	ОбъявитьСлова("пустое", "Заголовок, Пояснение, Иконка, Действие, Компактное");
	ОбъявитьСлова("плитка", "Подпись, Пояснение, Адрес, Иконка, Вид");
