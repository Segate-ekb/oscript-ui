// Слот картинки — желудь UI-кита: печать узла Кит.СлотКартинки (выпуск 0.12, шаг 16).
// Вместо системного файлового поля, таблицы «что сейчас» и отдельной кнопки — один слот:
// предпросмотр того, что стоит, подпись, строка состояния и одна кнопка, чтобы заменить.
//
// Слот — своя форма: выбор файла отправляет её сразу (признак data-autosubmit на файловом
// поле, отправку делает скрипт кита — тихо, multipart). Без скрипта видно системное
// файловое поле и кнопка отправки рядом — та же форма уходит обычной навигацией.
//
// «Вернуть стандартную» — пункт меню ⚙ в ОТДЕЛЬНОЙ форме сброса с признаком data-confirm:
// скрипт ловит её отправку и открывает подтверждение (то же окно, что Кит.Подтверждение),
// а без скрипта форма уходит без поля подтверждения, и сервер отвечает страницей, где это
// окно напечатано открытым. Форм две, а не одна с formaction: кнопка подтверждения
// стоит в окне и ссылается на форму сброса атрибутом form, а форма в форме браузером
// не собирается.

Перем Экран;          // ЭкранированиеHTML
Перем Набор;          // НаборКомпонентов — кнопка, меню
Перем Тексты;         // ТекстыИнтерфейса
Перем Подтверждения;  // Подтверждение — окно сброса

#Область ПубличныйИнтерфейс

// Печатает слот картинки.
//
// Параметры:
//  Модель - Структура - Ид (обязателен: от него идентификаторы подписи, состояния, окна
//           сброса), Имя (обязательно: имя файлового поля), Подпись (обязательна: что это
//           за картинка — «Логотип»), Адрес (адрес текущей картинки; пусто — пустая
//           шахматка), Состояние (строка под подписью: имя файла, размер, дата; пусто — из
//           словаря: «imgslot.default» без сброса, «imgslot.custom» со сбросом), Принимает
//           (атрибут accept, по умолчанию «image/*»), КнопкаЗагрузки (подпись кнопки; пусто —
//           «imgslot.replace» при картинке, «imgslot.upload» без неё), Загрузка (Структура:
//           Действие — адрес формы загрузки, ПолеТокена — ДОВЕРЕННЫЙ HTML скрытого поля
//           токена), Сброс (та же Структура для формы сброса и Открыто — окно подтверждения
//           напечатано открытым; Неопределено — сбрасывать нечего, меню ⚙ нет), КлассОкна
//           (классы окна подтверждения; их знает холст).
//
// Возвращаемое значение:
//  Строка - HTML <div class="imgslot">.
//
Функция Отрисовать(Знач Модель) Экспорт

	Ид = Поле(Модель, "Ид");
	Имя = Поле(Модель, "Имя");
	Подпись = Поле(Модель, "Подпись");
	Адрес = Поле(Модель, "Адрес");
	Проверить(Имя, Подпись, Адрес);

	Сброс = Неопределено;
	Модель.Свойство("Сброс", Сброс);

	Возврат СтрШаблон("<div class=""imgslot""%1>%2%3</div>",
		Экран.Атрибут("id", Ид),
		ФормаЗагрузки(Модель, Ид, Имя, Подпись, Адрес, Сброс <> Неопределено),
		?(Сброс = Неопределено, "", ФормаСброса(Модель, Ид, Подпись, Сброс)));

КонецФункции

// Идентификатор окна подтверждения сброса — на него ссылается признак data-confirm формы
// сброса. Сервер, который печатает окно открытым без скрипта, его не трогает: оно
// печатается тем же слотом со словом Открыто.
//
// Параметры:
//  Ид - Строка - идентификатор слота.
//
// Возвращаемое значение:
//  Строка
//
Функция ИдОкнаСброса(Знач Ид) Экспорт
	Возврат Ид + "-reset";
КонецФункции

// Признак файлового поля, по которому скрипт кита отправляет форму сразу по выбору файла.
// Тот же признак, что у тумблера с СохранятьСразу: отправка по изменению в скрипте одна.
//
// Возвращаемое значение:
//  Строка - имя атрибута.
//
Функция ПризнакАвтоотправки() Экспорт
	Возврат "data-autosubmit";
КонецФункции

#КонецОбласти

#Область Части

// Форма загрузки: предпросмотр, подпись и состояние, кнопка выбора над файловым полем
// и кнопка отправки. Кнопка выбора — <label> вокруг поля: щелчок по ней открывает выбор
// файла движком, без скрипта; поле со скриптом уходит из вида, но остаётся в порядке
// обхода — фокус с клавиатуры встаёт на него, а обводку рисует его кнопка-подпись.
// Без скрипта лист прячет кнопку-подпись и показывает само поле и кнопку отправки.
Функция ФормаЗагрузки(Знач Модель, Знач Ид, Знач Имя, Знач Подпись, Знач Адрес, Знач ЕстьСброс)

	Загрузка = Модель.Загрузка;

	Состояние = Поле(Модель, "Состояние");
	Если НЕ ЗначениеЗаполнено(Состояние) Тогда
		Состояние = Тексты.Текст(?(ЕстьСброс, "imgslot.custom", "imgslot.default"));
	КонецЕсли;

	Кнопка = Поле(Модель, "КнопкаЗагрузки");
	Если НЕ ЗначениеЗаполнено(Кнопка) Тогда
		Кнопка = Тексты.Текст(?(ЗначениеЗаполнено(Адрес), "imgslot.replace", "imgslot.upload"));
	КонецЕсли;

	Принимает = Поле(Модель, "Принимает");
	Если НЕ ЗначениеЗаполнено(Принимает) Тогда
		Принимает = "image/*";
	КонецЕсли;

	Выбор = СтрШаблон("<label class=""imgslot__pick""><span%1%2><span>%3</span></span>"
			+ "<input type=""file""%4%5 class=""imgslot__file""%6%7 %8></label>",
		Экран.Атрибут("class", Набор.Кнопка().Классы(Новый Структура("Вариант, Размер",
			"вторичная", "малый")) + " imgslot__face"),
		Экран.Атрибут("id", Ид + "-face"),
		Экран.Экранировать(Кнопка),
		Экран.Атрибут("name", Имя),
		Экран.Атрибут("accept", Принимает),
		Экран.Атрибут("aria-labelledby", Ид + "-face " + Ид + "-label"),
		Экран.Атрибут("aria-describedby", Ид + "-state"),
		ПризнакАвтоотправки());

	Отправка = Набор.Кнопка().Отрисовать(Новый Структура("Подпись, Вариант, Размер",
		Тексты.Текст("imgslot.send"), "вторичная", "малый"));

	Возврат СтрШаблон("<form method=""post"" action=""%1"" enctype=""multipart/form-data"""
			+ " class=""imgslot__upload"" data-quiet="""">%2"
			+ "<div class=""imgslot__preview"">%3</div>"
			+ "<div class=""imgslot__text""><p class=""imgslot__label""%4>%5</p>"
			+ "<p class=""imgslot__state""%6>%7</p></div>"
			+ "<div class=""imgslot__actions"">%8%9</div></form>",
		Экран.Экранировать(Загрузка.Действие),
		Загрузка.ПолеТокена,
		Предпросмотр(Адрес),
		Экран.Атрибут("id", Ид + "-label"), Экран.Экранировать(Подпись),
		Экран.Атрибут("id", Ид + "-state"), Экран.Экранировать(Состояние),
		Выбор, Отправка);

КонецФункции

// Картинка декоративна: что это, говорит подпись рядом, а что внутри логотипа, словами
// не пересказать. Пустой слот — одна шахматка: «пусто» читается и глазом.
Функция Предпросмотр(Знач Адрес)

	Если НЕ ЗначениеЗаполнено(Адрес) Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон("<img class=""imgslot__image"" src=""%1"" alt="""">", Экран.Экранировать(Адрес));

КонецФункции

// Меню ⚙ с одним пунктом стоит в своей форме: пункт — кнопка её отправки. Отправку
// перехватывает подтверждение (data-confirm), кнопка окна шлёт ту же форму с полем
// подтверждения. Окно печатается после формы, вне её: кнопка в нём ссылается на форму
// атрибутом form.
Функция ФормаСброса(Знач Модель, Знач Ид, Знач Подпись, Знач Сброс)

	ИдФормы = Ид + "-reset-form";
	ИдОкна = ИдОкнаСброса(Ид);

	Пункт = Набор.Кнопка().Отрисовать(Новый Структура("Подпись, Вариант, Размер, Иконка",
		Тексты.Текст("imgslot.reset"), "вторичная", "малый", "история"));
	Меню = Набор.Меню().Отрисовать(Новый Структура("Подпись, Пункты",
		Тексты.Шаблон("imgslot.actions", Подпись),
		ОдинПункт(Пункт)));

	Окно = Подтверждения.Отрисовать(Новый Структура(
		"Ид, Заголовок, Класс, Лид, Открыто, Признаки, Последствия, Дополнение, Эхо,"
			+ " ОшибкаЭха, Кнопка, ФормаИд",
		ИдОкна, Тексты.Шаблон("imgslot.reset.title", Подпись), Поле(Модель, "КлассОкна"), "",
		Сброс.Открыто = Истина, "", Тексты.Текст("imgslot.reset.lead"), "", Неопределено,
		"", Тексты.Текст("imgslot.reset.ok"), ИдФормы));

	Возврат СтрШаблон("<form method=""post"" action=""%1"" class=""imgslot__reset""%2%3"
			+ " data-quiet="""">%4<div class=""imgslot__gear"">%5</div></form>%6",
		Экран.Экранировать(Сброс.Действие),
		Экран.Атрибут("id", ИдФормы),
		Экран.АтрибутВсегда("data-confirm", ИдОкна),
		Сброс.ПолеТокена, Меню, Окно);

КонецФункции

Функция ОдинПункт(Знач Разметка)
	Пункты = Новый Массив();
	Пункты.Добавить(Новый Структура("HTML", Разметка));
	Возврат Пункты;
КонецФункции

Функция Поле(Знач Модель, Знач Имя)

	Значение = "";
	Если НЕ Модель.Свойство(Имя, Значение) ИЛИ Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Без имени файл уходит без поля — сервер получает пустую форму; без подписи кнопка
// «Заменить» не говорит, что заменяет. Адрес картинки — тот, что безопасен в ссылке,
// или встроенная картинка (data:image/…): в <img> она скрипта не исполняет.
Процедура Проверить(Знач Имя, Знач Подпись, Знач Адрес)

	Если НЕ ЗначениеЗаполнено(СокрЛП(Имя)) Тогда
		ВызватьИсключение СтрШаблон("Слот картинки «%1»: не задано Имя — имя файлового поля,"
			+ " под которым сервер получит файл. Кит.СлотКартинки(""logo"", ""Логотип"").",
			Подпись);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(СокрЛП(Подпись)) Тогда
		ВызватьИсключение СтрШаблон("Слот картинки «%1»: не задана Подпись. Ею названы"
			+ " и картинка, и кнопка «Заменить» для скринридера; без неё на странице с двумя"
			+ " слотами не понять, какой что меняет.", Имя);
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Адрес) ИЛИ Экран.URLБезопасенДляHref(Адрес)
		ИЛИ СтрНачинаетсяС(НРег(СокрЛП(Адрес)), "data:image/") Тогда
		Возврат;
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Слот картинки «%1»: адрес картинки «%2» не годится — нужен"
		+ " адрес http(s), путь своего приложения или встроенная картинка data:image/….",
		Подпись, Адрес);

КонецПроцедуры

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "НаборКомпонентов") _Набор,
	&Пластилин(Значение = "ТекстыИнтерфейса") _Тексты,
	&Пластилин(Значение = "Подтверждение") _Подтверждения) Экспорт

	Экран = _Экран;
	Набор = _Набор;
	Тексты = _Тексты;
	Подтверждения = _Подтверждения;

КонецПроцедуры
