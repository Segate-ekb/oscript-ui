// Токены темы — желудь UI-кита: единственное место в коде, где встречаются цвета.
// Обе палитры печатаются инлайном в <head>: тёмная в :root, светлая в
// html[data-theme="light"], поэтому переключение мгновенно и без запроса к серверу.
//
// БЕЗОПАСНОСТЬ: значения из профиля/cookie попадают внутрь <style>, где HTML-экранирование
// бесполезно — это CSS-контекст. Поэтому они не экранируются, а ВАЛИДИРУЮТСЯ по формату,
// и всё непрошедшее отбрасывается к значению по умолчанию.

// Оформление по умолчанию.
//
// Возвращаемое значение:
//  Структура - Тема, Акцент, Плотность, Радиус.
//
Функция ПоУмолчанию() Экспорт
	Возврат Новый Структура("Тема, Акцент, Плотность, Радиус", "тёмная", "", 1, 1);
КонецФункции

// Значение атрибута data-theme для <html>.
//
// Параметры:
//  Оформление - Структура, Неопределено - (необязательный, по умолчанию Неопределено)
//               оформление, см. ПоУмолчанию.
//
// Возвращаемое значение:
//  Строка - "dark" либо "light".
//
Функция АтрибутТемы(Знач Оформление = Неопределено) Экспорт
	Возврат ?(ЭтоСветлая(Оформление), "light", "dark");
КонецФункции

// Инлайновый блок <style> с переменными обеих тем.
//
// Параметры:
//  Оформление - Структура, Неопределено - (необязательный, по умолчанию Неопределено)
//               оформление, см. ПоУмолчанию.
//
// Возвращаемое значение:
//  Строка - фрагмент <style>…</style>.
//
Функция БлокСтилей(Знач Оформление = Неопределено) Экспорт
	Возврат "<style id=""токены-темы"">" + Переменные(Оформление) + "</style>";
КонецФункции

// CSS-текст переменных обеих палитр без тега <style>.
//
// Параметры:
//  Оформление - Структура, Неопределено - (необязательный, по умолчанию Неопределено)
//               оформление, см. ПоУмолчанию.
//
// Возвращаемое значение:
//  Строка - CSS-объявления переменных.
//
Функция Переменные(Знач Оформление = Неопределено) Экспорт

	Настройки = Нормализованное(Оформление);

	Тёмная = ":root{"
		+ ОбщиеПеременные(Настройки)
		+ ТёмнаяПалитра()
		+ ПереопределениеАкцента(Настройки)
		+ "}";

	Светлая = "html[data-theme=""light""]{"
		+ СветлаяПалитра()
		+ ПереопределениеАкцента(Настройки)
		+ "}";

	Возврат Тёмная + Светлая;

КонецФункции

// Базовый акцент — единственный источник этого цвета. Экспортирован, чтобы дом настроек
// аккаунта показывал его плейсхолдером поля «Акцент», а не держал вторую копию литерала.
//
// Возвращаемое значение:
//  Строка - цвет вида #rrggbb.
//
Функция АкцентПоУмолчанию() Экспорт
	Возврат "#9184d9";
КонецФункции

Функция ОбщиеПеременные(Знач Настройки)

	Плотность = Настройки.Плотность;
	Радиус = Настройки.Радиус;

	Возврат ""
		+ "--font-heading:Inter,'Segoe UI',system-ui,-apple-system,sans-serif;"
		+ "--font-body:Inter,'Segoe UI',system-ui,-apple-system,sans-serif;"
		+ "--font-mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;"
		+ "--font-weight-heading:500;"
		+ "--font-size-body:15px;"
		+ "--font-size-small:13px;"
		+ "--font-size-h1:26px;"
		+ "--font-size-h2:19px;"
		+ ШагСетки(1, 2.8, Плотность)
		+ ШагСетки(2, 5.6, Плотность)
		+ ШагСетки(3, 8.4, Плотность)
		+ ШагСетки(4, 11.2, Плотность)
		+ ШагСетки(5, 16.8, Плотность)
		+ ШагСетки(6, 22.4, Плотность)
		+ ШагСетки(7, 33.6, Плотность)
		+ ШагСетки(8, 44.8, Плотность)
		+ Радиусы(Радиус)
		+ "--shadow-sm:0 0 0 1px var(--color-divider);"
		+ "--shadow-md:0 0 0 1px var(--color-divider),0 2px 8px var(--color-ambient);"
		+ "--shadow-lg:0 0 0 1px var(--color-divider),0 12px 32px var(--color-ambient);"
		+ "--motion-fast:120ms;"    // наведение, фокус, переключатель
		+ "--motion-medium:160ms;"  // раскрытие секции и диалог
		+ "--motion-slow:180ms;"    // смена раздела настроек и тост
		// потребителя нет: класс .pulse убран как мёртвый, а период — решение концепции
		+ "--motion-pulse:1600ms;"
		+ "--motion-ease:cubic-bezier(.2,.6,.3,1);"
		+ "--layout-width:1080px;";

КонецФункции

Функция ШагСетки(Знач Номер, Знач Базовое, Знач Плотность)
	Возврат СтрШаблон("--space-%1:%2px;", Формат(Номер, "ЧН=; ЧГ=0"), ЧислоCSS(Базовое * Плотность));
КонецФункции

Функция Радиусы(Знач Множитель)
	Возврат СтрШаблон("--radius-sm:%1px;--radius-md:%2px;--radius-lg:%3px;",
		ЧислоCSS(4 * Множитель), ЧислоCSS(8 * Множитель), ЧислоCSS(14 * Множитель));
КонецФункции

// Представление числа для CSS. Разделитель дробной части — точка: локаль ru дала бы
// запятую и сломала объявление.
//
// Параметры:
//  Значение - Число - число.
//
// Возвращаемое значение:
//  Строка - число без разделителей групп и без хвостовых нулей.
//
Функция ЧислоCSS(Знач Значение) Экспорт

	Текст = Формат(Значение, "ЧРД=.; ЧГ=0; ЧН=0");

	Если СтрНайти(Текст, ".") > 0 Тогда
		Пока СтрЗаканчиваетсяНа(Текст, "0") Цикл
			Текст = Лев(Текст, СтрДлина(Текст) - 1);
		КонецЦикла;
		Если СтрЗаканчиваетсяНа(Текст, ".") Тогда
			Текст = Лев(Текст, СтрДлина(Текст) - 1);
		КонецЕсли;
	КонецЕсли;

	Возврат Текст;

КонецФункции

Функция ТёмнаяПалитра()
	Возврат ""
		+ "--color-bg:#161826;"
		+ "--color-surface:#232532;"
		+ "--color-surface-alt:#1d1f2c;"
		+ "--color-text:#e9e9ed;"
		+ "--color-text-muted:#a5a8b4;"
		+ "--color-accent:" + АкцентПоУмолчанию() + ";"
		+ "--color-accent-contrast:#161826;"
		+ "--color-divider:rgba(233,233,237,.16);"
		+ "--color-ambient:rgba(0,0,0,.45);"
		+ НейтральнаяРампа(Ложь)
		+ АкцентнаяРампа(Ложь)
		+ СемантическиеЦвета();
КонецФункции

// Рампы инвертируются: шаг 100 всегда «ближе к тексту», 900 — «ближе к фону», поэтому
// компонент читается в обеих темах без ветвлений.
Функция СветлаяПалитра()
	Возврат ""
		+ "--color-bg:#f4f4f8;"
		+ "--color-surface:#ffffff;"
		+ "--color-surface-alt:#ececf3;"
		+ "--color-text:#1c1d26;"
		+ "--color-text-muted:#5a5d6b;"
		+ "--color-accent:#5b4bbd;"
		+ "--color-accent-contrast:#ffffff;"
		+ "--color-divider:rgba(28,29,38,.16);"
		+ "--color-ambient:rgba(28,29,38,.12);"
		+ НейтральнаяРампа(Истина)
		+ АкцентнаяРампа(Истина)
		+ СемантическиеЦветаСветлой();
КонецФункции

Функция НейтральнаяРампа(Знач Инвертировать)
	Шаги = Новый Массив();
	Шаги.Добавить("#f3f5fe");
	Шаги.Добавить("#dcdfe8");
	Шаги.Добавить("#c3c6d0");
	Шаги.Добавить("#a5a8b4");
	Шаги.Добавить("#868a97");
	Шаги.Добавить("#6a6e7b");
	Шаги.Добавить("#4f525d");
	Шаги.Добавить("#3a3d46");
	Шаги.Добавить("#292b31");
	Возврат Рампа("neutral", Шаги, Инвертировать);
КонецФункции

Функция АкцентнаяРампа(Знач Инвертировать)
	Шаги = Новый Массив();
	Шаги.Добавить("#f5f4ff");
	Шаги.Добавить("#e4e0ff");
	Шаги.Добавить("#cdc6f7");
	Шаги.Добавить("#b3a9ec");
	Шаги.Добавить(АкцентПоУмолчанию()); // ступень 500 = базовый акцент темы
	Шаги.Добавить("#7a6cc4");
	Шаги.Добавить("#6355a5");
	Шаги.Добавить("#493d7d");
	Шаги.Добавить("#2b2741");
	Возврат Рампа("accent", Шаги, Инвертировать);
КонецФункции

Функция Рампа(Знач Имя, Знач Шаги, Знач Инвертировать)
	Результат = "";
	Для Индекс = 0 По Шаги.ВГраница() Цикл
		Ступень = (Индекс + 1) * 100;
		Значение = ?(Инвертировать, Шаги[Шаги.ВГраница() - Индекс], Шаги[Индекс]);
		Результат = Результат + СтрШаблон("--color-%1-%2:%3;", Имя, Формат(Ступень, "ЧН=; ЧГ=0"), Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Цвета статусов — вне рамп, только для состояний.
Функция СемантическиеЦвета()
	Возврат ""
		+ "--color-success:#7fd096;"
		+ "--color-warning:#e8c56a;"
		+ "--color-danger:#e08c96;"
		+ "--color-success-bg:rgba(127,208,150,.14);"
		+ "--color-warning-bg:rgba(232,197,106,.14);"
		+ "--color-danger-bg:rgba(224,140,150,.14);";
КонецФункции

Функция СемантическиеЦветаСветлой()
	Возврат ""
		+ "--color-success:#2f7d4c;"
		+ "--color-warning:#8a6a12;"
		+ "--color-danger:#a83a48;"
		+ "--color-success-bg:rgba(47,125,76,.12);"
		+ "--color-warning-bg:rgba(138,106,18,.12);"
		+ "--color-danger-bg:rgba(168,58,72,.12);";
КонецФункции

// Пользовательский акцент переопределяет связку из трёх переменных: сам цвет,
// ступень 500 акцентной рампы (иначе компоненты рисовали бы рядом базовый цвет темы)
// и контраст текста на заливке. Контраст выводится из яркости выбранного цвета, а не
// берётся у темы: иначе акцент #111111 давал бы почти чёрный текст на почти чёрном фоне.
Функция ПереопределениеАкцента(Знач Настройки)

	Если НЕ ЗначениеЗаполнено(Настройки.Акцент) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("--color-accent:%1;--color-accent-500:%1;--color-accent-contrast:%2;",
		Настройки.Акцент, КонтрастныйЦвет(Настройки.Акцент));

КонецФункции

// Читаемый цвет текста на заливке указанным цветом. Яркость — по формуле восприятия
// YIQ (веса 299/587/114), порог 140 из 255: на нём #808080 получает тёмный текст.
//
// Параметры:
//  Цвет - Строка - валидный #rgb/#rrggbb, уже прошедший БезопасныйЦвет.
//
// Возвращаемое значение:
//  Строка - "#ffffff" либо "#16181f".
//
Функция КонтрастныйЦвет(Знач Цвет) Экспорт

	Компоненты = КомпонентыЦвета(Цвет);
	Если Компоненты = Неопределено Тогда
		Возврат "#ffffff";
	КонецЕсли;

	Яркость = (Компоненты.Красный * 299 + Компоненты.Зелёный * 587 + Компоненты.Синий * 114) / 1000;
	Возврат ?(Яркость >= 140, "#16181f", "#ffffff");

КонецФункции

// Возвращает поверхность, на которой лежит плашка (--color-surface-alt) в запрошенной
// теме. Нужна тем, кто СЧИТАЕТ читаемость цвета: тема выбирается смотрящим, а не автором
// тега, поэтому обе поверхности обязаны быть доступны серверу одновременно.
//
// Параметры:
//  Светлая - Булево - Истина для светлой темы.
//
// Возвращаемое значение:
//  Строка - цвет поверхности в записи #rrggbb.
//
Функция ПоверхностьПлашки(Знач Светлая) Экспорт
	Возврат ?(Светлая, "#ececf3", "#1d1f2c");
КонецФункции

// Коэффициент контраста двух цветов по WCAG 2.1 (относительная яркость sRGB).
//
// Параметры:
//  Первый - Строка - цвет #rgb либо #rrggbb.
//  Второй - Строка - цвет #rgb либо #rrggbb.
//
// Возвращаемое значение:
//  Число - от 1 (цвета совпали) до 21; 0, если хотя бы один цвет не разобран.
//
Функция КоэффициентКонтраста(Знач Первый, Знач Второй) Экспорт

	ЯркостьПервого = ОтносительнаяЯркость(Первый);
	ЯркостьВторого = ОтносительнаяЯркость(Второй);
	Если ЯркостьПервого < 0 ИЛИ ЯркостьВторого < 0 Тогда
		Возврат 0;
	КонецЕсли;

	Светлее = Макс(ЯркостьПервого, ЯркостьВторого);
	Темнее = Мин(ЯркостьПервого, ЯркостьВторого);
	Возврат (Светлее + 0.05) / (Темнее + 0.05);

КонецФункции

// Относительная яркость sRGB; -1 для неразобранного цвета.
Функция ОтносительнаяЯркость(Знач Цвет)

	Компоненты = КомпонентыЦвета(Цвет);
	Если Компоненты = Неопределено Тогда
		Возврат -1;
	КонецЕсли;

	Возврат 0.2126 * ЛинейныйКанал(Компоненты.Красный)
		+ 0.7152 * ЛинейныйКанал(Компоненты.Зелёный)
		+ 0.0722 * ЛинейныйКанал(Компоненты.Синий);

КонецФункции

// Гамма-коррекция канала sRGB: та самая формула WCAG, а не «просто делим на 255».
Функция ЛинейныйКанал(Знач Значение)

	Доля = Значение / 255;
	Если Доля <= 0.04045 Тогда
		Возврат Доля / 12.92;
	КонецЕсли;

	Возврат Pow((Доля + 0.055) / 1.055, 2.4);

КонецФункции

// Разбирает цвет на составляющие.
//
// Параметры:
//  Цвет - Произвольный - цвет в записи #rgb либо #rrggbb.
//
// Возвращаемое значение:
//  Структура, Неопределено - Красный, Зелёный, Синий (0..255) либо Неопределено,
//                            если запись цвета недопустима.
//
Функция КомпонентыЦвета(Знач Цвет) Экспорт

	Текст = БезопасныйЦвет(Цвет);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Хвост = Сред(Текст, 2);
	Если СтрДлина(Хвост) = 3 Тогда
		// сокращённая запись: каждый разряд удваивается (#abc = #aabbcc)
		Развёрнутый = "";
		Для Поз = 1 По 3 Цикл
			Символ = Сред(Хвост, Поз, 1);
			Развёрнутый = Развёрнутый + Символ + Символ;
		КонецЦикла;
		Хвост = Развёрнутый;
	КонецЕсли;

	Возврат Новый Структура("Красный, Зелёный, Синий",
		ШестнадцатеричноеЧисло(Сред(Хвост, 1, 2)),
		ШестнадцатеричноеЧисло(Сред(Хвост, 3, 2)),
		ШестнадцатеричноеЧисло(Сред(Хвост, 5, 2)));

КонецФункции

Функция ШестнадцатеричноеЧисло(Знач Пара)

	Цифры = "0123456789abcdef";
	Результат = 0;
	Для Поз = 1 По СтрДлина(Пара) Цикл
		Результат = Результат * 16 + (СтрНайти(Цифры, НРег(Сред(Пара, Поз, 1))) - 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Нормализованное(Знач Оформление)

	Результат = ПоУмолчанию();

	Если ТипЗнч(Оформление) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;

	Если Оформление.Свойство("Тема") И ЗначениеЗаполнено(Оформление.Тема) Тогда
		Результат.Тема = ?(ЭтоСветлая(Оформление), "светлая", "тёмная");
	КонецЕсли;

	Если Оформление.Свойство("Акцент") Тогда
		Результат.Акцент = БезопасныйЦвет(Оформление.Акцент);
	КонецЕсли;

	Если Оформление.Свойство("Плотность") Тогда
		Результат.Плотность = БезопасныйМножитель(Оформление.Плотность);
	КонецЕсли;

	Если Оформление.Свойство("Радиус") Тогда
		Результат.Радиус = БезопасныйМножитель(Оформление.Радиус);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Пропускает цвет только в виде #rgb/#rrggbb — это и есть защита от CSS-инъекции
// вида «#fff;}html{display:none».
//
// Параметры:
//  Значение - Произвольный - цвет из профиля или cookie.
//
// Возвращаемое значение:
//  Строка - валидный цвет либо "", и тогда останется цвет темы.
//
Функция БезопасныйЦвет(Знач Значение) Экспорт

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Текст = СокрЛП(Строка(Значение));
	Если Лев(Текст, 1) <> "#" Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, 2);
	Если СтрДлина(Хвост) <> 3 И СтрДлина(Хвост) <> 6 Тогда
		Возврат "";
	КонецЕсли;

	Допустимые = "0123456789abcdefABCDEF";
	Для Поз = 1 По СтрДлина(Хвост) Цикл
		Если СтрНайти(Допустимые, Сред(Хвост, Поз, 1)) = 0 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	Возврат Текст;

КонецФункции

// Пропускает множитель плотности или радиуса в диапазоне [0.5; 2].
//
// Параметры:
//  Значение - Произвольный - множитель из профиля или cookie.
//
// Возвращаемое значение:
//  Число - множитель либо 1 для значения вне диапазона.
//
Функция БезопасныйМножитель(Знач Значение) Экспорт

	Попытка
		Множитель = Число(Значение);
	Исключение
		Возврат 1;
	КонецПопытки;

	Если Множитель < 0.5 ИЛИ Множитель > 2 Тогда
		Возврат 1;
	КонецЕсли;

	Возврат Множитель;

КонецФункции

Функция ЭтоСветлая(Знач Оформление)

	Если ТипЗнч(Оформление) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ Оформление.Свойство("Тема") Тогда
		Возврат Ложь;
	КонецЕсли;

	Тема = НРег(СокрЛП(Строка(Оформление.Тема)));
	Возврат Тема = "светлая" ИЛИ Тема = "light";

КонецФункции

&Желудь
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры
