// Токены темы — желудь UI-кита: единственное место в коде, где встречаются цвета, размеры
// шрифта, радиусы, тени и кривые движения. Словарь — токены Material Design 3
// (--md-sys-color-*, --md-sys-typescale-*, --md-sys-shape-*, --md-sys-elevation-*,
// --md-sys-state-*, --md-sys-motion-*), имена и значения по спецификации системы.
// Обе палитры печатаются инлайном в <head>: тёмная в :root, светлая в
// html[data-theme="light"], поэтому переключение мгновенно и без запроса к серверу.
//
// Цвета не записаны здесь литералами: роли выводит ЦветоваяСхема из одного цвета-затравки —
// акцента инсталляции или посетителя. Сменил акцент — сменилась вся схема, контраст пар
// ролей при этом держится таблицей тонов.
//
// Прежние имена (--color-*, --space-*, --radius-*, --shadow-*, --font-*, --motion-*) остаются
// ПСЕВДОНИМАМИ ролей Material: лист инсталляции, написанный под них, продолжает работать.
//
// БЕЗОПАСНОСТЬ: значения из профиля/cookie попадают внутрь <style>, где HTML-экранирование
// бесполезно — это CSS-контекст. Поэтому они не экранируются, а ВАЛИДИРУЮТСЯ по формату,
// и всё непрошедшее отбрасывается к значению по умолчанию.

Перем Схема; // ЦветоваяСхема

// Оформление по умолчанию.
//
// Возвращаемое значение:
//  Структура - Тема, Акцент, Плотность, Радиус.
//
Функция ПоУмолчанию() Экспорт
	Возврат Новый Структура("Тема, Акцент, Плотность, Радиус", "тёмная", "", 1, 1);
КонецФункции

// Значение атрибута data-theme для <html>.
//
// Параметры:
//  Оформление - Структура, Неопределено - (необязательный, по умолчанию Неопределено)
//               оформление, см. ПоУмолчанию.
//
// Возвращаемое значение:
//  Строка - "dark" либо "light".
//
Функция АтрибутТемы(Знач Оформление = Неопределено) Экспорт
	Возврат ?(ЭтоСветлая(Оформление), "light", "dark");
КонецФункции

// Инлайновый блок <style> с переменными обеих тем.
//
// Параметры:
//  Оформление - Структура, Неопределено - (необязательный, по умолчанию Неопределено)
//               оформление, см. ПоУмолчанию.
//
// Возвращаемое значение:
//  Строка - фрагмент <style>…</style>.
//
Функция БлокСтилей(Знач Оформление = Неопределено) Экспорт
	Возврат "<style id=""токены-темы"">" + Переменные(Оформление) + "</style>";
КонецФункции

// CSS-текст обеих палитр без тега <style>: переменные и схема цветов, по которой браузер
// рисует свои элементы и выбирает цвет в light-dark().
//
// Параметры:
//  Оформление - Структура, Неопределено - (необязательный, по умолчанию Неопределено)
//               оформление, см. ПоУмолчанию.
//
// Возвращаемое значение:
//  Строка - CSS-объявления переменных и color-scheme.
//
Функция Переменные(Знач Оформление = Неопределено) Экспорт

	Настройки = Нормализованное(Оформление);
	Затравка = ?(ЗначениеЗаполнено(Настройки.Акцент), Настройки.Акцент, АкцентПоУмолчанию());

	Тёмная = ":root{"
		+ "color-scheme:dark;"
		+ ОбщиеПеременные(Настройки)
		+ ЦветаСхемы(Затравка, Истина)
		+ Псевдонимы()
		+ "}";

	Светлая = "html[data-theme=""light""]{"
		+ "color-scheme:light;"
		+ ЦветаСхемы(Затравка, Ложь)
		+ "}";

	Возврат Тёмная + Светлая;

КонецФункции

// Базовый акцент — затравка схемы по умолчанию, базовый цвет Material 3. Экспортирован,
// чтобы дом настроек аккаунта показывал его плейсхолдером поля «Акцент», а не держал вторую
// копию литерала.
//
// Возвращаемое значение:
//  Строка - цвет вида #rrggbb.
//
Функция АкцентПоУмолчанию() Экспорт
	Возврат "#6750a4";
КонецФункции

// Шрифт интерфейса. Roboto — шрифт Material; кит его не везёт, как не везёт и MUI:
// где он установлен (Android, ChromeOS, подключён инсталляцией), страница говорит им,
// остальные получают системный гротеск той же метрики.
//
// Возвращаемое значение:
//  Строка - значение font-family.
//
Функция Гарнитура() Экспорт
	Возврат "Roboto,'Roboto Flex',system-ui,-apple-system,'Segoe UI','Helvetica Neue',Arial,sans-serif";
КонецФункции

#Область НецветовыеТокены

Функция ОбщиеПеременные(Знач Настройки)

	Возврат ""
		+ "--md-ref-typeface-brand:" + Гарнитура() + ";"
		+ "--md-ref-typeface-plain:" + Гарнитура() + ";"
		+ "--md-ref-typeface-mono:'Roboto Mono','JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;"
		+ ШкалаШрифта()
		+ Формы(Настройки.Радиус)
		+ Возвышения()
		+ Состояния()
		+ Движение()
		+ ШагСетки(1, 4, Настройки.Плотность)
		+ ШагСетки(2, 8, Настройки.Плотность)
		+ ШагСетки(3, 12, Настройки.Плотность)
		+ ШагСетки(4, 16, Настройки.Плотность)
		+ ШагСетки(5, 24, Настройки.Плотность)
		+ ШагСетки(6, 32, Настройки.Плотность)
		+ ШагСетки(7, 48, Настройки.Плотность)
		+ ШагСетки(8, 64, Настройки.Плотность)
		+ "--layout-width:1200px;";

КонецФункции

// Типографическая шкала Material 3: пятнадцать стилей, у каждого гарнитура, начертание,
// кегль, интерлиньяж и трекинг — токенами системы. Шестой токен, --type-<стиль>, —
// сокращение кита: вся запись font одним значением, чтобы правило листа не собирало её
// из пяти переменных.
Функция ШкалаШрифта()

	Результат = "";
	Для Каждого Стиль Из СтилиШрифта() Цикл
		Части = СтрРазделить(Стиль, " ");
		Имя = Части[0];
		Гарнитура = ?(СтрНачинаетсяС(Имя, "display") ИЛИ СтрНачинаетсяС(Имя, "headline")
			ИЛИ Имя = "title-large", "brand", "plain");
		Префикс = "--md-sys-typescale-" + Имя;
		Результат = Результат
			+ СтрШаблон("%1-font:var(--md-ref-typeface-%2);", Префикс, Гарнитура)
			+ СтрШаблон("%1-weight:%2;", Префикс, Части[3])
			+ СтрШаблон("%1-size:%2px;", Префикс, Части[1])
			+ СтрШаблон("%1-line-height:%2px;", Префикс, Части[2])
			+ СтрШаблон("%1-tracking:%2px;", Префикс, Части[4])
			+ СтрШаблон("--type-%1:%2 %3px/%4px var(--md-ref-typeface-%5);",
				Имя, Части[3], Части[1], Части[2], Гарнитура);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Стиль: имя, кегль, интерлиньяж, начертание, трекинг — значения спецификации M3.
Функция СтилиШрифта()

	Результат = Новый Массив();
	Результат.Добавить("display-large 57 64 400 -0.25");
	Результат.Добавить("display-medium 45 52 400 0");
	Результат.Добавить("display-small 36 44 400 0");
	Результат.Добавить("headline-large 32 40 400 0");
	Результат.Добавить("headline-medium 28 36 400 0");
	Результат.Добавить("headline-small 24 32 400 0");
	Результат.Добавить("title-large 22 28 400 0");
	Результат.Добавить("title-medium 16 24 500 0.15");
	Результат.Добавить("title-small 14 20 500 0.1");
	Результат.Добавить("body-large 16 24 400 0.5");
	Результат.Добавить("body-medium 14 20 400 0.25");
	Результат.Добавить("body-small 12 16 400 0.4");
	Результат.Добавить("label-large 14 20 500 0.1");
	Результат.Добавить("label-medium 12 16 500 0.5");
	Результат.Добавить("label-small 11 16 500 0.5");
	Возврат Результат;

КонецФункции

// Шкала скруглений Material 3. Множитель радиуса из оформления умножает всё, кроме «нет»
// и «полностью»: пилюля остаётся пилюлей при любом множителе.
Функция Формы(Знач Множитель)

	Результат = "--md-sys-shape-corner-none:0px;";
	Ступени = Новый Структура("extra_small, small, medium, large, large_increased, extra_large, extra_large_increased",
		4, 8, 12, 16, 20, 28, 32);
	Для Каждого Ступень Из Ступени Цикл
		Результат = Результат + СтрШаблон("--md-sys-shape-corner-%1:%2px;",
			СтрЗаменить(Ступень.Ключ, "_", "-"), ЧислоCSS(Ступень.Значение * Множитель));
	КонецЦикла;

	Возврат Результат
		+ "--md-sys-shape-corner-full:9999px;"
		+ "--radius-sm:var(--md-sys-shape-corner-extra-small);"
		+ "--radius-md:var(--md-sys-shape-corner-small);"
		+ "--radius-lg:var(--md-sys-shape-corner-medium);";

КонецФункции

// Уровни возвышения Material 3: тень из двух слоёв — ключевой и рассеянной.
Функция Возвышения()

	Возврат ""
		+ "--md-sys-elevation-level0:none;"
		+ "--md-sys-elevation-level1:0 1px 2px 0 rgba(0,0,0,.3),0 1px 3px 1px rgba(0,0,0,.15);"
		+ "--md-sys-elevation-level2:0 1px 2px 0 rgba(0,0,0,.3),0 2px 6px 2px rgba(0,0,0,.15);"
		+ "--md-sys-elevation-level3:0 1px 3px 0 rgba(0,0,0,.3),0 4px 8px 3px rgba(0,0,0,.15);"
		+ "--md-sys-elevation-level4:0 2px 3px 0 rgba(0,0,0,.3),0 6px 10px 4px rgba(0,0,0,.15);"
		+ "--md-sys-elevation-level5:0 4px 4px 0 rgba(0,0,0,.3),0 8px 12px 6px rgba(0,0,0,.15);"
		+ "--shadow-sm:var(--md-sys-elevation-level1);"
		+ "--shadow-md:var(--md-sys-elevation-level2);"
		+ "--shadow-lg:var(--md-sys-elevation-level3);";

КонецФункции

// Слои состояний: наведение, фокус, нажатие и перетаскивание кладут поверх элемента его же
// цвет содержимого с этой прозрачностью. Токены Material — доли; --state-* — те же
// величины процентами, в которых их принимает color-mix().
Функция Состояния()

	Возврат ""
		+ "--md-sys-state-hover-state-layer-opacity:0.08;"
		+ "--md-sys-state-focus-state-layer-opacity:0.1;"
		+ "--md-sys-state-pressed-state-layer-opacity:0.1;"
		+ "--md-sys-state-dragged-state-layer-opacity:0.16;"
		+ "--state-hover:8%;"
		+ "--state-focus:10%;"
		+ "--state-pressed:10%;"
		+ "--state-dragged:16%;"
		+ "--state-disabled-container:12%;"
		+ "--state-disabled-content:38%;";

КонецФункции

// Движение Material 3: кривые и длительности. Прежние --motion-* — псевдонимы длительностей
// и стандартной кривой.
Функция Движение()

	Результат = ""
		+ "--md-sys-motion-easing-standard:cubic-bezier(.2,0,0,1);"
		+ "--md-sys-motion-easing-standard-accelerate:cubic-bezier(.3,0,1,1);"
		+ "--md-sys-motion-easing-standard-decelerate:cubic-bezier(0,0,0,1);"
		+ "--md-sys-motion-easing-emphasized:cubic-bezier(.2,0,0,1);"
		+ "--md-sys-motion-easing-emphasized-accelerate:cubic-bezier(.3,0,.8,.15);"
		+ "--md-sys-motion-easing-emphasized-decelerate:cubic-bezier(.05,.7,.1,1);"
		+ "--md-sys-motion-easing-legacy:cubic-bezier(.4,0,.2,1);"
		+ "--md-sys-motion-easing-linear:cubic-bezier(0,0,1,1);";

	Ступени = Новый Структура("short, medium, long, extra_long", 50, 250, 450, 700);
	Шаг = Новый Структура("short, medium, long, extra_long", 50, 50, 50, 100);
	Для Каждого Ступень Из Ступени Цикл
		Для Номер = 1 По 4 Цикл
			Результат = Результат + СтрШаблон("--md-sys-motion-duration-%1%2:%3ms;",
				СтрЗаменить(Ступень.Ключ, "_", "-"), Номер,
				Формат(Ступень.Значение + Шаг[Ступень.Ключ] * (Номер - 1), "ЧГ=0"));
		КонецЦикла;
	КонецЦикла;

	Возврат Результат
		+ "--motion-fast:var(--md-sys-motion-duration-short3);"     // наведение, фокус, переключатель
		+ "--motion-medium:var(--md-sys-motion-duration-medium1);"  // раскрытие секции и диалог
		+ "--motion-slow:var(--md-sys-motion-duration-medium2);"    // смена раздела настроек и тост
		+ "--motion-pulse:1600ms;"
		+ "--motion-ease:var(--md-sys-motion-easing-standard);";

КонецФункции

Функция ШагСетки(Знач Номер, Знач Базовое, Знач Плотность)
	Возврат СтрШаблон("--space-%1:%2px;", Формат(Номер, "ЧН=; ЧГ=0"), ЧислоCSS(Базовое * Плотность));
КонецФункции

#КонецОбласти

// Представление числа для CSS. Разделитель дробной части — точка: локаль ru дала бы
// запятую и сломала объявление.
//
// Параметры:
//  Значение - Число - число.
//
// Возвращаемое значение:
//  Строка - число без разделителей групп и без хвостовых нулей.
//
Функция ЧислоCSS(Знач Значение) Экспорт

	Текст = Формат(Значение, "ЧРД=.; ЧГ=0; ЧН=0");

	Если СтрНайти(Текст, ".") > 0 Тогда
		Пока СтрЗаканчиваетсяНа(Текст, "0") Цикл
			Текст = Лев(Текст, СтрДлина(Текст) - 1);
		КонецЦикла;
		Если СтрЗаканчиваетсяНа(Текст, ".") Тогда
			Текст = Лев(Текст, СтрДлина(Текст) - 1);
		КонецЕсли;
	КонецЕсли;

	Возврат Текст;

КонецФункции

#Область Цвета

// Роли схемы токенами --md-sys-color-* и прежние рампы кита — тоже от затравки.
Функция ЦветаСхемы(Знач Затравка, Знач Тёмная)

	Результат = "";
	Для Каждого Роль Из Схема.Роли(Затравка, Тёмная) Цикл
		Результат = Результат + СтрШаблон("--md-sys-color-%1:%2;", Роль.Роль, Роль.Цвет);
	КонецЦикла;

	Возврат Результат
		+ Рампа("accent", Схема.Рампа(Затравка, "primary", Тёмная))
		+ Рампа("neutral", Схема.Рампа(Затравка, "neutral", Тёмная));

КонецФункции

// Рампы инвертируются: шаг 100 всегда «ближе к тексту», 900 — «ближе к фону», поэтому
// компонент читается в обеих темах без ветвлений.
Функция Рампа(Знач Имя, Знач Шаги)
	Результат = "";
	Для Индекс = 0 По Шаги.ВГраница() Цикл
		Результат = Результат + СтрШаблон("--color-%1-%2:%3;", Имя,
			Формат((Индекс + 1) * 100, "ЧН=; ЧГ=0"), Шаги[Индекс]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Прежние имена — ссылки на роли. Объявлены один раз, в :root: тот же элемент <html>
// подхватывает светлые роли из html[data-theme="light"], и ссылка разрешается в них.
Функция Псевдонимы()

	Возврат ""
		+ "--font-heading:var(--md-ref-typeface-brand);"
		+ "--font-body:var(--md-ref-typeface-plain);"
		+ "--font-mono:var(--md-ref-typeface-mono);"
		+ "--font-weight-heading:400;"
		+ "--font-size-body:var(--md-sys-typescale-body-large-size);"
		+ "--font-size-small:var(--md-sys-typescale-body-medium-size);"
		+ "--font-size-h1:var(--md-sys-typescale-headline-medium-size);"
		+ "--font-size-h2:var(--md-sys-typescale-title-large-size);"
		+ "--color-bg:var(--md-sys-color-surface);"
		+ "--color-surface:var(--md-sys-color-surface-container-low);"
		+ "--color-surface-alt:var(--md-sys-color-surface-container-highest);"
		+ "--color-text:var(--md-sys-color-on-surface);"
		+ "--color-text-muted:var(--md-sys-color-on-surface-variant);"
		+ "--color-accent:var(--md-sys-color-primary);"
		+ "--color-accent-contrast:var(--md-sys-color-on-primary);"
		+ "--color-divider:var(--md-sys-color-outline-variant);"
		+ "--color-ambient:color-mix(in srgb,var(--md-sys-color-shadow) 30%,transparent);"
		+ "--color-scrim:color-mix(in srgb,var(--md-sys-color-scrim) 32%,transparent);"
		+ "--color-success:var(--md-sys-color-success);"
		+ "--color-warning:var(--md-sys-color-warning);"
		+ "--color-danger:var(--md-sys-color-error);"
		+ "--color-success-bg:var(--md-sys-color-success-container);"
		+ "--color-warning-bg:var(--md-sys-color-warning-container);"
		+ "--color-danger-bg:var(--md-sys-color-error-container);";

КонецФункции

#КонецОбласти


// Читаемый цвет текста на заливке указанным цветом. Яркость — по формуле восприятия
// YIQ (веса 299/587/114), порог 140 из 255: на нём #808080 получает тёмный текст.
//
// Параметры:
//  Цвет - Строка - валидный #rgb/#rrggbb, уже прошедший БезопасныйЦвет.
//
// Возвращаемое значение:
//  Строка - "#ffffff" либо "#16181f".
//
Функция КонтрастныйЦвет(Знач Цвет) Экспорт

	Компоненты = КомпонентыЦвета(Цвет);
	Если Компоненты = Неопределено Тогда
		Возврат "#ffffff";
	КонецЕсли;

	Яркость = (Компоненты.Красный * 299 + Компоненты.Зелёный * 587 + Компоненты.Синий * 114) / 1000;
	Возврат ?(Яркость >= 140, "#16181f", "#ffffff");

КонецФункции

// Возвращает поверхность, на которой лежит плашка (--color-surface-alt, роль
// surface-container-highest) в запрошенной теме при акценте по умолчанию. Нужна тем, кто
// СЧИТАЕТ читаемость цвета: тема выбирается смотрящим, а не автором тега, поэтому обе
// поверхности обязаны быть доступны серверу одновременно.
//
// Параметры:
//  Светлая - Булево - Истина для светлой темы.
//
// Возвращаемое значение:
//  Строка - цвет поверхности в записи #rrggbb.
//
Функция ПоверхностьПлашки(Знач Светлая) Экспорт

	Для Каждого Роль Из Схема.Роли(АкцентПоУмолчанию(), НЕ Светлая) Цикл
		Если Роль.Роль = "surface-container-highest" Тогда
			Возврат Роль.Цвет;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции


// Коэффициент контраста двух цветов по WCAG 2.1 (относительная яркость sRGB).
//
// Параметры:
//  Первый - Строка - цвет #rgb либо #rrggbb.
//  Второй - Строка - цвет #rgb либо #rrggbb.
//
// Возвращаемое значение:
//  Число - от 1 (цвета совпали) до 21; 0, если хотя бы один цвет не разобран.
//
Функция КоэффициентКонтраста(Знач Первый, Знач Второй) Экспорт

	ЯркостьПервого = ОтносительнаяЯркость(Первый);
	ЯркостьВторого = ОтносительнаяЯркость(Второй);
	Если ЯркостьПервого < 0 ИЛИ ЯркостьВторого < 0 Тогда
		Возврат 0;
	КонецЕсли;

	Светлее = Макс(ЯркостьПервого, ЯркостьВторого);
	Темнее = Мин(ЯркостьПервого, ЯркостьВторого);
	Возврат (Светлее + 0.05) / (Темнее + 0.05);

КонецФункции

// Относительная яркость sRGB; -1 для неразобранного цвета.
Функция ОтносительнаяЯркость(Знач Цвет)

	Компоненты = КомпонентыЦвета(Цвет);
	Если Компоненты = Неопределено Тогда
		Возврат -1;
	КонецЕсли;

	Возврат 0.2126 * ЛинейныйКанал(Компоненты.Красный)
		+ 0.7152 * ЛинейныйКанал(Компоненты.Зелёный)
		+ 0.0722 * ЛинейныйКанал(Компоненты.Синий);

КонецФункции

// Гамма-коррекция канала sRGB: та самая формула WCAG, а не «просто делим на 255».
Функция ЛинейныйКанал(Знач Значение)

	Доля = Значение / 255;
	Если Доля <= 0.04045 Тогда
		Возврат Доля / 12.92;
	КонецЕсли;

	Возврат Pow((Доля + 0.055) / 1.055, 2.4);

КонецФункции

// Разбирает цвет на составляющие.
//
// Параметры:
//  Цвет - Произвольный - цвет в записи #rgb либо #rrggbb.
//
// Возвращаемое значение:
//  Структура, Неопределено - Красный, Зелёный, Синий (0..255) либо Неопределено,
//                            если запись цвета недопустима.
//
Функция КомпонентыЦвета(Знач Цвет) Экспорт

	Текст = БезопасныйЦвет(Цвет);
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Хвост = Сред(Текст, 2);
	Если СтрДлина(Хвост) = 3 Тогда
		// сокращённая запись: каждый разряд удваивается (#abc = #aabbcc)
		Развёрнутый = "";
		Для Поз = 1 По 3 Цикл
			Символ = Сред(Хвост, Поз, 1);
			Развёрнутый = Развёрнутый + Символ + Символ;
		КонецЦикла;
		Хвост = Развёрнутый;
	КонецЕсли;

	Возврат Новый Структура("Красный, Зелёный, Синий",
		ШестнадцатеричноеЧисло(Сред(Хвост, 1, 2)),
		ШестнадцатеричноеЧисло(Сред(Хвост, 3, 2)),
		ШестнадцатеричноеЧисло(Сред(Хвост, 5, 2)));

КонецФункции

Функция ШестнадцатеричноеЧисло(Знач Пара)

	Цифры = "0123456789abcdef";
	Результат = 0;
	Для Поз = 1 По СтрДлина(Пара) Цикл
		Результат = Результат * 16 + (СтрНайти(Цифры, НРег(Сред(Пара, Поз, 1))) - 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Нормализованное(Знач Оформление)

	Результат = ПоУмолчанию();

	Если ТипЗнч(Оформление) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;

	Если Оформление.Свойство("Тема") И ЗначениеЗаполнено(Оформление.Тема) Тогда
		Результат.Тема = ?(ЭтоСветлая(Оформление), "светлая", "тёмная");
	КонецЕсли;

	Если Оформление.Свойство("Акцент") Тогда
		Результат.Акцент = БезопасныйЦвет(Оформление.Акцент);
	КонецЕсли;

	Если Оформление.Свойство("Плотность") Тогда
		Результат.Плотность = БезопасныйМножитель(Оформление.Плотность);
	КонецЕсли;

	Если Оформление.Свойство("Радиус") Тогда
		Результат.Радиус = БезопасныйМножитель(Оформление.Радиус);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Пропускает цвет только в виде #rgb/#rrggbb — это и есть защита от CSS-инъекции
// вида «#fff;}html{display:none».
//
// Параметры:
//  Значение - Произвольный - цвет из профиля или cookie.
//
// Возвращаемое значение:
//  Строка - валидный цвет либо "", и тогда останется цвет темы.
//
Функция БезопасныйЦвет(Знач Значение) Экспорт

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;

	Текст = СокрЛП(Строка(Значение));
	Если Лев(Текст, 1) <> "#" Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, 2);
	Если СтрДлина(Хвост) <> 3 И СтрДлина(Хвост) <> 6 Тогда
		Возврат "";
	КонецЕсли;

	Допустимые = "0123456789abcdefABCDEF";
	Для Поз = 1 По СтрДлина(Хвост) Цикл
		Если СтрНайти(Допустимые, Сред(Хвост, Поз, 1)) = 0 Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;

	Возврат Текст;

КонецФункции

// Пропускает множитель плотности или радиуса в диапазоне [0.5; 2].
//
// Параметры:
//  Значение - Произвольный - множитель из профиля или cookie.
//
// Возвращаемое значение:
//  Число - множитель либо 1 для значения вне диапазона.
//
Функция БезопасныйМножитель(Знач Значение) Экспорт

	Попытка
		Множитель = Число(Значение);
	Исключение
		Возврат 1;
	КонецПопытки;

	Если Множитель < 0.5 ИЛИ Множитель > 2 Тогда
		Возврат 1;
	КонецЕсли;

	Возврат Множитель;

КонецФункции

Функция ЭтоСветлая(Знач Оформление)

	Если ТипЗнч(Оформление) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если НЕ Оформление.Свойство("Тема") Тогда
		Возврат Ложь;
	КонецЕсли;

	Тема = НРег(СокрЛП(Строка(Оформление.Тема)));
	Возврат Тема = "светлая" ИЛИ Тема = "light";

КонецФункции


&Желудь
Процедура ПриСозданииОбъекта() Экспорт
	Схема = Новый ЦветоваяСхема();
КонецПроцедуры
