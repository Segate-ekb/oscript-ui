// Отпечатки статики — желудь UI-кита: SHA-256 СОДЕРЖИМОГО файла интерфейса и публичное
// имя с префиксом отпечатка. Под каким адресом файл отдаётся, знает АктивыСтатики.
//
// Отпечатки считаются один раз НА СТАРТЕ и лежат в поле только на чтение: адрес статики
// фиксируется на старте процесса, правку файла на живом сервере экземпляр не заметит.

Перем Место;      // РаскладкаСтатики
Перем Отпечатки;  // Соответствие - имя файла на диске -> SHA-256 hex (считается на старте)

#Область ПубличныйИнтерфейс

// Имя, под которым файл виден снаружи: базовое имя плюс префикс отпечатка содержимого.
//
// Параметры:
//  ИмяНаДиске - Строка - имя файла в каталоге статики.
//
// Возвращаемое значение:
//  Строка - имя для URL, например "стили-1f2e3d4c5b6a7988.css"; для файла без
//           отпечатка (нет на диске) — имя как есть.
//
Функция ПубличноеИмя(Знач ИмяНаДиске) Экспорт
	Возврат ИмяСОтпечатком(ИмяНаДиске, Отпечаток(ИмяНаДиске));
КонецФункции

// Собирает публичное имя из базового имени и отпечатка. Чистая функция, диска не
// касается: инвариант «разное содержимое → разный адрес» проверяется на ней напрямую.
//
// Параметры:
//  ИмяНаДиске - Строка - имя вида "стили.css".
//  Отпечаток  - Строка - SHA-256 hex либо "", тогда имя возвращается как есть.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяСОтпечатком(Знач ИмяНаДиске, Знач Отпечаток) Экспорт

	Имя = Строка(ИмяНаДиске);
	Если НЕ ЗначениеЗаполнено(Отпечаток) Тогда
		Возврат Имя;
	КонецЕсли;

	Префикс = Лев(НРег(Строка(Отпечаток)), ДлинаПрефиксаХеша());
	Точка = ПоследняяТочка(Имя);
	Если Точка = 0 Тогда
		Возврат Имя + "-" + Префикс;
	КонецЕсли;

	Возврат Лев(Имя, Точка - 1) + "-" + Префикс + Сред(Имя, Точка);

КонецФункции

// Сколько символов отпечатка попадает в адрес. 64 бит достаточно: единственный
// возможный отказ — коллизия двух версий одного файла, адрес не секрет.
//
// Возвращаемое значение:
//  Число
//
Функция ДлинаПрефиксаХеша() Экспорт
	Возврат 16;
КонецФункции

// Полный отпечаток файла статики: SHA-256 hex в нижнем регистре. Все отпечатки
// посчитаны на старте; имя вне закрытого набора считается на месте и не кэшируется.
//
// Параметры:
//  ИмяНаДиске - Строка - имя файла в каталоге статики.
//
// Возвращаемое значение:
//  Строка - отпечаток либо "", если файла нет на диске.
//
Функция Отпечаток(Знач ИмяНаДиске) Экспорт

	Имя = Строка(ИмяНаДиске);
	Готовый = Отпечатки.Получить(Имя);
	Возврат ?(Готовый = Неопределено, ПосчитатьОтпечаток(Имя), Готовый);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПосчитатьОтпечаток(Знач ИмяНаДиске)

	Полный = Место.ПолныйПуть(ИмяНаДиске);
	Если НЕ ЗначениеЗаполнено(Полный) Тогда
		Возврат "";
	КонецЕсли;

	Файл = Новый Файл(Полный);
	Если НЕ Файл.Существует() Тогда
		Возврат "";
	КонецЕсли;

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Новый ДвоичныеДанные(Файл.ПолноеИмя));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма));

КонецФункции

Функция ПоследняяТочка(Знач Имя)
	Для Сдвиг = 0 По СтрДлина(Имя) - 1 Цикл
		Индекс = СтрДлина(Имя) - Сдвиг;
		Если Сред(Имя, Индекс, 1) = "." Тогда
			Возврат Индекс;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "РаскладкаСтатики") _Место) Экспорт

	Место = _Место;
	Отпечатки = ПосчитатьВсеОтпечатки();

КонецПроцедуры

// Отпечатки считаются НА СТАРТЕ, все сразу: набор файлов закрыт, а ленивый досчёт писал
// в общее Соответствие из потоков сервера — параллельные запросы страницы (стили, скрипт,
// значок) рвали его состояние, и статика отвечала 500 до перезапуска процесса.
Функция ПосчитатьВсеОтпечатки()

	Результат = Новый Соответствие();

	Для Каждого КиЗ Из Место.Раскладка() Цикл
		Результат.Вставить(КиЗ.Ключ, ПосчитатьОтпечаток(КиЗ.Ключ));
	КонецЦикла;

	Возврат Результат;

КонецФункции
