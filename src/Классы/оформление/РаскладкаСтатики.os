// Раскладка статики — желудь UI-кита: КАКИЕ файлы есть у интерфейса и ГДЕ они лежат.
// Корней два и они разной природы: собственный каталог кита (базовый лист, глифы, значки
// и разрешение на рисунки) кит находит сам, а каталог инсталляции вместе со списком её
// файлов приходит контрактом «СтатикаИнсталляции» — знак сайта принадлежит ей, а не
// библиотеке. Под каким адресом файл отдаётся, знает АктивыСтатики.
//
// ИНСТАЛЛЯЦИЯ КЛАДЁТСЯ ПОВЕРХ: файл, объявленный ею под именем китового, вытесняет
// китовый целиком. Так проект подменяет любой файл библиотеки своим, не трогая её.

Перем КореньКита;    // Строка - абсолютный путь к каталогу статики библиотеки
Перем Инсталляция;   // СтатикаИнсталляции

#Область ПубличныйИнтерфейс

// Имя каталога статики относительно src/.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяКаталога() Экспорт
	Возврат "статика";
КонецФункции

// Абсолютный путь к каталогу статики библиотеки.
//
// Возвращаемое значение:
//  Строка
//
Функция КаталогКита() Экспорт
	Возврат КореньКита;
КонецФункции

// Абсолютный путь к каталогу статики инсталляции.
//
// Возвращаемое значение:
//  Строка - "" — своей статики у инсталляции нет.
//
Функция КаталогИнсталляции() Экспорт
	Возврат Строка(Инсталляция.Каталог());
КонецФункции

// Подкаталог глифов интерфейса: по .svg на иконку, там же текст разрешения на их
// использование.
//
// Возвращаемое значение:
//  Строка
//
Функция ПодкаталогГлифов() Экспорт
	Возврат "иконки";
КонецФункции

// Абсолютный путь к каталогу глифов.
//
// Возвращаемое значение:
//  Строка
//
Функция КаталогГлифов() Экспорт
	Возврат ОбъединитьПути(КореньКита, ПодкаталогГлифов());
КонецФункции

// Имя файла с текстом разрешения на набор рисунков: авторство указывается в отдаваемом
// файле, а не только в комментарии.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлЛицензииИконок() Экспорт
	Возврат "phosphor-LICENSE.txt";
КонецФункции

// Имя базового листа стилей библиотеки на диске — без версии и хеша.
//
// Возвращаемое значение:
//  Строка
//
Функция ФайлБазовогоЛиста() Экспорт
	Возврат "oscript-ui.css";
КонецФункции

// Подкаталог значков: чужие фирменные знаки, которые отдаются файлами, а не вставляются
// в разметку как глифы.
//
// Возвращаемое значение:
//  Строка
//
Функция ПодкаталогЗначков() Экспорт
	Возврат "провайдеры";
КонецФункции

// Ключи значков, которые везёт библиотека. Ключ попадает в разметку и в чужую базу,
// поэтому список закрытый: всё, чего здесь нет, значка не получает.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция КлючиЗначков() Экспорт

	Результат = Новый Массив();
	Результат.Добавить("github");
	Результат.Добавить("gitlab");
	Результат.Добавить("google");
	Результат.Добавить("key");
	Возврат Результат;

КонецФункции

// Имя файла значка.
//
// Параметры:
//  Ключ - Строка - ключ значка.
//
// Возвращаемое значение:
//  Строка - имя файла либо "" для ключа вне списка.
//
Функция ФайлЗначка(Знач Ключ) Экспорт

	Норм = НРег(СокрЛП(Строка(Ключ)));
	Если КлючиЗначков().Найти(Норм) = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Норм + ".svg";

КонецФункции

// Раскладка каталога: имя файла -> где он лежит и чем отдаётся. Своё библиотека кладёт
// первой, файлы инсталляции — поверх: совпавшее имя достаётся инсталляции.
//
// Возвращаемое значение:
//  Соответствие - имя файла (Строка) -> Структура("Корень, Подкаталог, ТипКонтента").
//
Функция Раскладка() Экспорт

	Результат = СвояРаскладка();

	Корень = КаталогИнсталляции();
	Для Каждого КиЗ Из Инсталляция.Файлы() Цикл
		Результат.Вставить(Строка(КиЗ.Ключ),
			Место(Корень, КиЗ.Значение.Подкаталог, КиЗ.Значение.ТипКонтента));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Файлы, которые везёт сама библиотека: базовый лист, значки и разрешение на рисунки.
//
// Возвращаемое значение:
//  Соответствие - имя файла (Строка) -> Структура("Корень, Подкаталог, ТипКонтента").
//
Функция СвояРаскладка() Экспорт

	Результат = Новый Соответствие();

	Результат.Вставить(ФайлБазовогоЛиста(),
		Место(КореньКита, "", "text/css; charset=utf-8"));
	Результат.Вставить(ФайлЛицензииИконок(),
		Место(КореньКита, ПодкаталогГлифов(), "text/plain; charset=utf-8"));

	Для Каждого Ключ Из КлючиЗначков() Цикл
		Результат.Вставить(ФайлЗначка(Ключ),
			Место(КореньКита, ПодкаталогЗначков(), "image/svg+xml"));
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Путь файла внутри каталога статики: подкаталог по назначению плюс имя. Значения
// собираются из собственных таблиц, присланное из запроса сюда не попадает.
//
// Параметры:
//  ИмяФайла - Строка - имя файла без подкаталога.
//
// Возвращаемое значение:
//  Строка - относительный путь на диске, разделитель платформенный; для файла вне
//           раскладки — имя как есть.
//
Функция ОтносительныйПуть(Знач ИмяФайла) Экспорт

	Имя = Строка(ИмяФайла);
	Найденное = Раскладка().Получить(Имя);
	Возврат ?(Найденное = Неопределено, Имя, Путь(Найденное.Подкаталог, Имя));

КонецФункции

// Полный путь файла на диске.
//
// Параметры:
//  ИмяФайла - Строка - имя файла без подкаталога.
//
// Возвращаемое значение:
//  Строка - абсолютный путь; "" для файла вне раскладки.
//
Функция ПолныйПуть(Знач ИмяФайла) Экспорт

	Найденное = Раскладка().Получить(Строка(ИмяФайла));
	Если Найденное = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Найденное.Корень) Тогда
		Возврат "";
	КонецЕсли;

	Возврат ОбъединитьПути(Найденное.Корень, Путь(Найденное.Подкаталог, Строка(ИмяФайла)));

КонецФункции

// Склейка подкаталога с именем — для того, кто уже держит раскладку в руках и не хочет
// строить её заново на каждый файл. Это путь НА ДИСКЕ, поэтому звенья соединяет платформа,
// а не литерал "/": на Windows иначе получается "C:\статика\бренд/mark.svg" — открыть его
// система откроет, но совпадать с путём, собранным по-человечески, он перестаёт. Адреса
// статики односегментны и здесь не строятся, путать эти две склейки не с чем.
//
// Параметры:
//  Подкаталог - Строка, Неопределено - подкаталог по назначению; пусто — корень каталога.
//  ИмяФайла   - Строка - имя файла.
//
// Возвращаемое значение:
//  Строка - относительный путь с платформенным разделителем.
//
Функция Путь(Знач Подкаталог, Знач ИмяФайла) Экспорт
	Возврат ОбъединитьПути(Строка(Подкаталог), Строка(ИмяФайла));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Место(Знач Корень, Знач Подкаталог, Знач ТипКонтента)
	Возврат Новый Структура("Корень, Подкаталог, ТипКонтента",
		Строка(Корень), Строка(Подкаталог), Строка(ТипКонтента));
КонецФункции

// Каталог кита ищется ВВЕРХ по имени, а не отсчётом уровней: жёсткий отсчёт ломается при
// перекладке классов, и графика «пропадает» молча. Искать от собственного файла — верно
// и после переезда в oscript_modules: ТекущийСценарий() внутри класса библиотеки отдаёт
// файл самого класса.
Функция НайтиКаталогКита()

	Текущий = Новый Файл(ТекущийСценарий().Источник).Путь;

	// предел страхует от зацикливания на корне файловой системы
	Для Шаг = 1 По 12 Цикл

		Кандидат = ОбъединитьПути(Текущий, ИмяКаталога());
		Если Новый Файл(Кандидат).Существует() Тогда
			Возврат Кандидат;
		КонецЕсли;

		Родитель = Новый Файл(Текущий).Путь;
		Если НЕ ЗначениеЗаполнено(Родитель) ИЛИ Родитель = Текущий Тогда
			Прервать;
		КонецЕсли;
		Текущий = Родитель;

	КонецЦикла;

	ВызватьИсключение СтрШаблон(
		"Каталог статики ""%1"" не найден ни в одном родительском каталоге %2."
			+ " Без него интерфейсу нечем рисовать иконки.",
		ИмяКаталога(), Новый Файл(ТекущийСценарий().Источник).Путь);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "СтатикаИнсталляции") _Инсталляция) Экспорт

	Инсталляция = _Инсталляция;
	КореньКита = НайтиКаталогКита();

КонецПроцедуры
