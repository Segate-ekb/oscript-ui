// Активы статики — желудь UI-кита: под каким адресом отдаётся каждый файл интерфейса
// и каков его тип. КАКИЕ файлы есть и ГДЕ они лежат, знает РаскладкаСтатики; отпечаток
// содержимого считает ОтпечаткиСтатики. Имён конкретных файлов здесь нет: как называется
// таблица стилей и знак, знает инсталляция, а не библиотека. Адрес при этом остаётся
// односегментным, как бы глубоко ни лежал файл.
//
// Адрес несёт префикс SHA-256 СОДЕРЖИМОГО, а не версию: «правка файла без смены адреса»
// невозможна как класс, потому что адрес — функция содержимого.

Перем Место;  // РаскладкаСтатики
Перем Хеши;   // ОтпечаткиСтатики

#Область ПубличныйИнтерфейс

// Префикс, под которым отдаётся каталог статики.
//
// Возвращаемое значение:
//  Строка
//
Функция БазовыйПуть() Экспорт
	Возврат "/static";
КонецФункции

// Раскладка каталога статики: имя файла -> где он лежит и чем отдаётся.
//
// Возвращаемое значение:
//  Соответствие - имя файла (Строка) -> Структура("Корень, Подкаталог, ТипКонтента").
//
Функция Раскладка() Экспорт
	Возврат Место.Раскладка();
КонецФункции

// Путь файла ВНУТРИ каталога статики: подкаталог по назначению плюс имя.
//
// Параметры:
//  ИмяНаДиске - Строка - имя файла без подкаталога.
//
// Возвращаемое значение:
//  Строка - относительный путь на диске, разделитель платформенный; для файла вне
//           раскладки — имя как есть.
//
Функция ОтносительныйПуть(Знач ИмяНаДиске) Экспорт
	Возврат Место.ОтносительныйПуть(ИмяНаДиске);
КонецФункции

// Имя, под которым файл виден снаружи: базовое имя плюс префикс отпечатка содержимого.
//
// Параметры:
//  ИмяНаДиске - Строка - имя файла в каталоге статики.
//
// Возвращаемое значение:
//  Строка - имя для URL, например "стили-1f2e3d4c5b6a7988.css"; для файла без
//           отпечатка (нет на диске) — имя как есть.
//
Функция ПубличноеИмя(Знач ИмяНаДиске) Экспорт
	Возврат Хеши.ПубличноеИмя(ИмяНаДиске);
КонецФункции

// Адрес файла статики.
//
// Параметры:
//  ИмяНаДиске - Строка - имя файла в каталоге статики.
//
// Возвращаемое значение:
//  Строка - адрес с отпечатком содержимого; "" для имени вне раскладки.
//
Функция Адрес(Знач ИмяНаДиске) Экспорт

	Имя = Строка(ИмяНаДиске);
	Если НЕ ЗначениеЗаполнено(Имя) ИЛИ Раскладка().Получить(Имя) = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат БазовыйПуть() + "/" + ПубличноеИмя(Имя);

КонецФункции

// Адрес базового листа стилей библиотеки — того, что каркас страницы ставит ПЕРВЫМ,
// чтобы лист инсталляции перебивал его каскадом.
//
// Возвращаемое значение:
//  Строка - адрес с отпечатком содержимого.
//
Функция АдресБазовогоЛиста() Экспорт
	Возврат Адрес(Место.ФайлБазовогоЛиста());
КонецФункции

// Полный отпечаток файла статики: SHA-256 hex в нижнем регистре.
//
// Параметры:
//  ИмяНаДиске - Строка - имя файла в каталоге статики.
//
// Возвращаемое значение:
//  Строка - отпечаток либо "", если файла нет на диске.
//
Функция Отпечаток(Знач ИмяНаДиске) Экспорт
	Возврат Хеши.Отпечаток(ИмяНаДиске);
КонецФункции

// Тип контента файла, лежащего на диске.
//
// Параметры:
//  ИмяНаДиске - Строка - имя файла в каталоге статики.
//
// Возвращаемое значение:
//  Строка - Content-Type; "" для имени вне раскладки.
//
Функция ТипФайла(Знач ИмяНаДиске) Экспорт

	Найденное = Раскладка().Получить(Строка(ИмяНаДиске));
	Возврат ?(Найденное = Неопределено, "", Найденное.ТипКонтента);

КонецФункции

// Белый список отдаваемых файлов. Имя из URL сравнивается с ключами ЦЕЛИКОМ и никогда
// не разбирается на части, поэтому «../../etc/passwd», чужое имя и верное имя с чужим
// хешем неотличимы: все три отсутствуют в списке, и ответ — 404 до обращения к диску.
//
// Возвращаемое значение:
//  Соответствие - публичное имя файла (Строка) -> Content-Type (Строка).
//
Функция Файлы() Экспорт

	Результат = Новый Соответствие();
	Для Каждого КиЗ Из ИменаНаДиске() Цикл
		Результат.Вставить(КиЗ.Ключ, ТипФайла(КиЗ.Значение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Тип контента для публичного имени файла.
//
// Параметры:
//  ИмяФайла - Строка - имя файла из URL.
//
// Возвращаемое значение:
//  Строка, Неопределено - Content-Type либо Неопределено, если файл не отдаётся.
//
Функция ТипКонтента(Знач ИмяФайла) Экспорт

	НаДиске = ИменаНаДиске().Получить(Строка(ИмяФайла));
	Возврат ?(НаДиске = Неопределено, Неопределено, ТипФайла(НаДиске));

КонецФункции

// Путь файла на диске для публичного имени из URL. Единственный переход «URL → диск»,
// и он табличный: значение целиком собрано из раскладки, присланная строка в него
// не попадает ни одним символом, поэтому подставить в неё путь невозможно.
//
// Параметры:
//  ИмяФайла - Строка - имя файла из URL.
//
// Возвращаемое значение:
//  Строка, Неопределено - абсолютный путь либо Неопределено, если такого адреса нет.
//
Функция ПутьНаДиске(Знач ИмяФайла) Экспорт

	НаДиске = ИменаНаДиске().Получить(Строка(ИмяФайла));
	Если НаДиске = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Полный = Место.ПолныйПуть(НаДиске);
	Возврат ?(ЗначениеЗаполнено(Полный), Полный, Неопределено);

КонецФункции

// ETag файла: полный отпечаток содержимого в кавычках — сильный валидатор для 304.
//
// Параметры:
//  ИмяФайла - Строка - публичное имя файла из URL.
//
// Возвращаемое значение:
//  Строка - значение заголовка ETag либо "" для файла без отпечатка.
//
Функция ETag(Знач ИмяФайла) Экспорт

	НаДиске = ИменаНаДиске().Получить(Строка(ИмяФайла));
	Если НаДиске = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Значение = Отпечаток(НаДиске);
	Возврат ?(ЗначениеЗаполнено(Значение), """" + Значение + """", "");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Единственный перевод «имя из URL → имя в раскладке»; на нём стоят и белый список,
// и путь к диску, и ETag. Раскладка при этом строится ОДИН раз на вызов: на каждый
// запрос /static таблица собирается заново, и обход по ключу строил бы её ещё по разу
// на файл.
Функция ИменаНаДиске()

	Результат = Новый Соответствие();
	Для Каждого КиЗ Из Раскладка() Цикл
		Результат.Вставить(ПубличноеИмя(КиЗ.Ключ), КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "РаскладкаСтатики") _Место,
	&Пластилин(Значение = "ОтпечаткиСтатики") _Хеши) Экспорт

	Место = _Место;
	Хеши = _Хеши;

КонецПроцедуры
