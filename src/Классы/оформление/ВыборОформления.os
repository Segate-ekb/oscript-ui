// Выбор оформления — желудь UI-кита: какое оформление печатать серверу —
// из cookie посетителя либо из оформления инсталляции. Значение cookie недоверенное,
// валидацию делает ТокеныТемы; здесь только чтение источника.
//
// Формат значения cookie: тема=светлая&акцент=%239184d9&плотность=1; имя куки даёт
// инсталляция.

Перем Инсталляция; // ОформлениеИнсталляции — контракт кита, реализацию даёт инсталляция

// Имя cookie с оформлением. Задаёт его ИНСТАЛЛЯЦИЯ: кука живёт в её домене рядом
// с чужими, и как назвать своё, библиотека решать не вправе.
//
// Возвращаемое значение:
//  Строка
//
Функция ИмяCookie() Экспорт

	Своё = СокрЛП(Строка(Инсталляция.ИмяCookieОформления()));
	Возврат ?(ЗначениеЗаполнено(Своё), Своё, "ui");

КонецФункции

// Записывает cookie оформления в ответ — единственное место записи на сервере.
//
// Три условия контракта с браузерным скриптом, которые здесь и держатся:
//  1. значение НЕ кодируется — нативный веб-сервер winow кодирует его сам, а
//     document.cookie декодируется браузером ровно один раз;
//  2. ТолькоХттп = Ложь — у winow по умолчанию Истина, и кука была бы недоступна
//     скрипту, хотя секрета в ней нет;
//  3. срок жизни задан — иначе кука сессионная и выбор темы не переживает браузер.
//
// Параметры:
//  Ответ    - ОтветСервера - ответ winow.
//  Значение - Строка       - значение вида "тема=светлая&акцент=%23aabbcc",
//             см. ЗначениеCookieСТемой; БЕЗ url-кодирования.
//
Процедура ЗаписатьКуку(Ответ, Знач Значение) Экспорт

	Кука = Ответ.Куки.Добавить(ИмяCookie(), Значение);
	Кука.ТолькоХттп = Ложь;
	Кука.Путь = "/";
	Кука.СрокЖизни = СрокЖизниCookie();
	Кука.ТотжеСайт = "Lax";

КонецПроцедуры

// Срок жизни cookie оформления, секунд. То же значение печатает браузерный скрипт.
//
// Возвращаемое значение:
//  Число
//
Функция СрокЖизниCookie() Экспорт
	Возврат 31536000;
КонецФункции

// Оформление по умолчанию для инсталляции. Спрашивается на КАЖДОМ запросе: значения
// живут снаружи кита, и их правка обязана быть видна без перезапуска.
//
// Возвращаемое значение:
//  Структура - Тема, Акцент, Плотность, Радиус.
//
Функция ПоУмолчанию() Экспорт

	Значения = Инсталляция.Оформление();

	Возврат Новый Структура("Тема, Акцент, Плотность, Радиус",
		Поле(Значения, "Тема"), Поле(Значения, "Акцент"), 1, 1);

КонецФункции

// Оформление посетителя: cookie поверх значений инсталляции.
//
// Параметры:
//  КукиЗапроса - Куки, Неопределено - куки запроса winow.
//
// Возвращаемое значение:
//  Структура - Тема, Акцент, Плотность, Радиус.
//
Функция ПоКукам(Знач КукиЗапроса) Экспорт

	Результат = ПоУмолчанию();

	Если КукиЗапроса = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Значение = КукиЗапроса.ПолучитьЗначениеПоИмени(ИмяCookie());
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Результат;
	КонецЕсли;

	Возврат Слить(Результат, РазобратьЗначение(Значение));

КонецФункции

// Разбирает значение cookie в структуру оформления. Валидации нет — она в ТокеныТемы.
//
// Параметры:
//  Значение - Строка - значение cookie вида "тема=светлая&акцент=%23aabbcc".
//
// Возвращаемое значение:
//  Структура - только те поля, что реально пришли.
//
Функция РазобратьЗначение(Знач Значение) Экспорт

	Результат = Новый Структура();

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Результат;
	КонецЕсли;

	// значение приходит целиком url-кодированным: раскодируем один раз, потом делим.
	// Попытка защитная: поведение РаскодироватьСтроку на мусоре контрактом не зафиксировано,
	// а кука приходит от кого угодно — не разобралось, считаем куку отсутствующей
	Попытка
		Развёрнутое = РаскодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);
	Исключение
		Возврат Результат;
	КонецПопытки;

	Для Каждого Пара Из СтрРазделить(Развёрнутое, "&", Ложь) Цикл
		Позиция = СтрНайти(Пара, "=");
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = НРег(СокрЛП(Лев(Пара, Позиция - 1)));
		Содержимое = СокрЛП(Сред(Пара, Позиция + 1));
		Если Ключ = "тема" Тогда
			Результат.Вставить("Тема", Содержимое);
		ИначеЕсли Ключ = "акцент" Тогда
			Результат.Вставить("Акцент", Содержимое);
		ИначеЕсли Ключ = "плотность" Тогда
			Результат.Вставить("Плотность", Содержимое);
		ИначеЕсли Ключ = "радиус" Тогда
			Результат.Вставить("Радиус", Содержимое);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Собирает значение cookie с переключённой темой, сохраняя остальные поля: акцент,
// плотность и радиус, выбранные пользователем, стирать нельзя. Значения инсталляции
// не подмешиваются — иначе смена акцента инсталляции перестала бы касаться посетителя.
// Значение СЫРОЕ, без кодирования: кодирует транспорт, см. ЗаписатьКуку.
//
// Параметры:
//  ЗначениеCookie - Строка - текущее url-кодированное значение cookie либо "".
//  НоваяТема      - Строка - "светлая" | "тёмная".
//
// Возвращаемое значение:
//  Строка - значение для Set-Cookie.
//
Функция ЗначениеCookieСТемой(Знач ЗначениеCookie, Знач НоваяТема) Экспорт

	Поля = РазобратьЗначение(ЗначениеCookie);
	Поля.Вставить("Тема", НоваяТема);

	Пары = Новый Массив();
	Для Каждого Ключ Из ПорядокПолей() Цикл
		Значение = Неопределено;
		Если Поля.Свойство(Ключ.Свойство, Значение) И ЗначениеЗаполнено(Значение) Тогда
			Пары.Добавить(Ключ.Ключ + "=" + Строка(Значение));
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Пары, "&");

КонецФункции

// Порядок стабилен: кука должна быть воспроизводимой, иначе её не сравнить в тесте.
Функция ПорядокПолей()
	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Свойство, Ключ", "Тема", "тема"));
	Результат.Добавить(Новый Структура("Свойство, Ключ", "Акцент", "акцент"));
	Результат.Добавить(Новый Структура("Свойство, Ключ", "Плотность", "плотность"));
	Результат.Добавить(Новый Структура("Свойство, Ключ", "Радиус", "радиус"));
	Возврат Результат;
КонецФункции

// Имя темы, противоположной текущей.
//
// Параметры:
//  АтрибутТемы - Строка - "light" | "dark", как печатает ТокеныТемы.
//
// Возвращаемое значение:
//  Строка - "светлая" | "тёмная".
//
Функция ПротивоположнаяТема(Знач АтрибутТемы) Экспорт
	Возврат ?(НРег(СокрЛП(Строка(АтрибутТемы))) = "light", "тёмная", "светлая");
КонецФункции

Функция Поле(Знач Значения, Знач Имя)
	Значение = Неопределено;
	Если ТипЗнч(Значения) = Тип("Структура") И Значения.Свойство(Имя, Значение)
		И Значение <> Неопределено Тогда
		Возврат СокрЛП(Строка(Значение));
	КонецЕсли;
	Возврат "";
КонецФункции

Функция Слить(Знач Основа, Знач Поверх)
	Для Каждого КиЗ Из Поверх Цикл
		Если ЗначениеЗаполнено(КиЗ.Значение) Тогда
			Основа.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Основа;
КонецФункции

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ОформлениеИнсталляции") _Инсталляция) Экспорт

	Инсталляция = _Инсталляция;

КонецПроцедуры
