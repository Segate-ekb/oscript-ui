// Документация oscript-ui — мини-приложение на winow: сайт, который рассказывает о ките,
// собран самим китом. Это не часть пакета oscript-ui (в его сборку каталог не входит),
// а отдельный проект рядом с библиотекой: кит подключается из рабочего дерева,
// остальное ставится локально.
//
//   cd документация
//   opm install -l
//   oscript main.os            — сайт на http://localhost:3333

Описание.Имя("oscript-ui-docs")
	.Версия("0.9.0")
	.Автор("Egor Ivanov")
	.Описание("Документация UI-кита oscript-ui: разделы, живые образцы с кодом, гайдлайны.")
	.ВерсияСреды("2.0.0")
	.ЗависитОт("autumn", "5.0.2")
	.ЗависитОт("winow", "0.14.1")
	.ЗависитОт("oscript-md", "0.2.1")
	.ЗависитОт("html-sanitizer", "0.2.0")
	// Телеметрия, которую везёт ОСень 5 (opentelemetry, autumn-opentelemetry), зовёт эти
	// библиотеки #Использовать, но в своих зависимостях их не объявляет. Без них сайт
	// не стартует там, где их нет в системном каталоге OneScript, — например, в образе.
	.ЗависитОт("cpuinfo")
	.ЗависитОт("async")
	.ЗависитОт("compressor")
	.ЗависитОт("extends")
	.ЗависитОт("prometheus")
	.ЗависитОт("resilience")
	.ЗависитОт("opentelemetry-instrumentation-entity")
	.ЗависитОт("oint");
