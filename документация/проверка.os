// Проверка страниц документации без сервера: каждая страница оглавления есть на диске,
// каждый образец на ней собирается, у страницы есть заголовок и пояснение.
//
//   oscript проверка.os                 — все страницы
//   oscript проверка.os кнопка таблица  — только эти
//
// Код выхода 1, если хоть что-то не так.

#Использовать oscript-md
#Использовать ".."

Каталог = Новый Файл(ТекущийСценарий().Источник).Путь;
Движок = ОбъединитьПути(Каталог, "src", "Классы", "движок");
Для Каждого Имя Из СтрРазделить("СловарьДокументации,ИсполнениеОбразца,СправкаКомпонента,ДирективыДокументации,"
		+ "ПечатьДокументации,ОглавлениеДокументации,СборкаДокументации", ",") Цикл
	ПодключитьСценарий(ОбъединитьПути(Движок, Имя + ".os"), Имя);
КонецЦикла;

Сборка = Новый СборкаДокументации();
Ключи = Новый Массив();
Для Каждого Аргумент Из АргументыКоманднойСтроки Цикл
	Ключи.Добавить(НРег(Аргумент));
КонецЦикла;
Если Ключи.Количество() = 0 Тогда
	Ключи = Сборка.Оглавление().Ключи();
КонецЕсли;

Беды = 0;
Образцов = 0;
Для Каждого Ключ Из Ключи Цикл

	Путь = ОбъединитьПути(Каталог, "страницы", Ключ + ".md");
	Если НЕ Новый Файл(Путь).Существует() Тогда
		Сообщить("НЕТ ФАЙЛА  " + Ключ);
		Беды = Беды + 1;
		Продолжить;
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Попытка
		Страница = Сборка.Печать().Напечатать(Текст);
	Исключение
		Сообщить("ПАДАЕТ     " + Ключ + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Беды = Беды + 1;
		Продолжить;
	КонецПопытки;

	Замечания = Новый Массив();
	Если НЕ ЗначениеЗаполнено(Страница.Заголовок) Тогда
		Замечания.Добавить("нет заголовка");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Страница.Пояснение) Тогда
		Замечания.Добавить("нет пояснения под заголовком");
	КонецЕсли;
	// справка, не нашедшая описания в исходнике, печатает ошибку на месте, а не падает
	Если СтрНайти(Страница.Тело, "class=""docs-error""") > 0 И СтрНайти(Страница.Тело, "Образец не собрался: в исходнике кита нет") > 0 Тогда
		Замечания.Добавить("справка не нашла описания в исходнике кита");
	КонецЕсли;
	Для Каждого Образец Из Страница.Образцы Цикл
		Образцов = Образцов + 1;
		Если НЕ Образец.Успех Тогда
			Замечания.Добавить(СтрШаблон("образец «%1»: %2", Образец.Подпись, Образец.Ошибка));
		КонецЕсли;
	КонецЦикла;

	Если Замечания.Количество() > 0 Тогда
		Беды = Беды + Замечания.Количество();
		Сообщить("ОШИБКИ     " + Ключ + Символы.ПС + "  - " + СтрСоединить(Замечания, Символы.ПС + "  - "));
	Иначе
		Сообщить(СтрШаблон("ок         %1 — разделов %2, образцов %3", Ключ,
			Страница.Разделы.Количество(), Страница.Образцы.Количество()));
	КонецЕсли;

КонецЦикла;

Сообщить(СтрШаблон("Страниц: %1, образцов: %2, бед: %3", Ключи.Количество(), Образцов, Беды));
Если Беды > 0 Тогда
	ЗавершитьРаботу(1);
КонецЕсли;
