// Исполнение образца документации: код из блока «живой» выполняется, и страница рисует
// ровно то, что он вернул. Показанный код — не подпись к картинке, а её источник, поэтому
// разойтись им негде: сломанный пример ломает свою картинку, а не врёт рядом с ней.
//
// В коде образца доступны четыре имени — те же, под которыми экран приложения держит
// желуди кита: Набор, Кит, Формы, Настройки. Образец кончается присваиванием HTML.

Перем Набор;      // НаборКомпонентов
Перем Кит;        // Кит
Перем Формы;      // Формы
Перем Настройки;  // РендерерНастроек

// Выполняет код образца.
//
// Параметры:
//  Исходник - Строка - код на OneScript, присваивающий результат переменной HTML.
//
// Возвращаемое значение:
//  Структура - Успех (Булево), HTML (Строка), Ошибка (Строка — текст исключения).
//
Функция Запустить(Знач Исходник) Экспорт

	Попытка
		Возврат Новый Структура("Успех, HTML, Ошибка", Истина, Строка(Исполнить(Исходник)), "");
	Исключение
		Возврат Новый Структура("Успех, HTML, Ошибка", Ложь, "",
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

// Здесь код и выполняется: локальная HTML и переменные модуля — его контекст.
Функция Исполнить(Знач Исходник)

	HTML = "";
	Выполнить(Исходник);
	Возврат HTML;

КонецФункции

// Параметры:
//  _Набор     - НаборКомпонентов - фасад компонентов.
//  _Кит       - Кит              - холст: экран деревом узлов.
//  _Формы     - Формы            - фабрика объявлений формы.
//  _Настройки - РендерерНастроек - каркас дома настроек.
//
Процедура ПриСозданииОбъекта(Знач _Набор, Знач _Кит, Знач _Формы, Знач _Настройки) Экспорт

	Набор = _Набор;
	Кит = _Кит;
	Формы = _Формы;
	Настройки = _Настройки;

КонецПроцедуры
