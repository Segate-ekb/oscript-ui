// Директивы документации: блоки, которые страница не пишет текстом, а печатает из самого
// кита. Блок кода с пометкой «директива имя» заменяется живым содержимым: роли цвета —
// из ЦветоваяСхема для текущего акцента, иконки — из каталога глифов, роды холста —
// из РазметкаЭлементов. Описание и кит не могут разойтись: описывать нечего, кит
// показывает себя сам.

Перем Экран;      // ЭкранированиеHTML
Перем Схема;      // ЦветоваяСхема
Перем Токены;     // ТокеныТемы
Перем Глифы;      // НаборИконок
Перем Значки;     // Иконка
Перем Печать;     // РазметкаЭлементов
Перем Состав;     // ОглавлениеДокументации; Неопределено — карты разделов нет
Перем Набор;      // НаборКомпонентов

// Имена директив, которые знает документация.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Имена() Экспорт
	Возврат СтрРазделить("роли-цвета,шкала-шрифта,формы,возвышение,движение,иконки,роды,карта,выбор-акцента", ",");
КонецФункции

// Печатает директиву.
//
// Параметры:
//  Имя        - Строка - имя директивы, см. Имена().
//  Оформление - Структура, Неопределено - оформление смотрящего (акцент для ролей цвета).
//
// Возвращаемое значение:
//  Строка - HTML. Неизвестная директива — исключение: опечатка в странице не должна
//           молча оставить дыру.
//
Функция Напечатать(Знач Имя, Знач Оформление = Неопределено) Экспорт

	Ключ = НРег(СокрЛП(Имя));
	Если Ключ = "роли-цвета" Тогда
		Возврат РолиЦвета(Оформление);
	ИначеЕсли Ключ = "шкала-шрифта" Тогда
		Возврат ШкалаШрифта();
	ИначеЕсли Ключ = "формы" Тогда
		Возврат Формы();
	ИначеЕсли Ключ = "возвышение" Тогда
		Возврат Возвышение();
	ИначеЕсли Ключ = "движение" Тогда
		Возврат Движение();
	ИначеЕсли Ключ = "иконки" Тогда
		Возврат Иконки();
	ИначеЕсли Ключ = "роды" Тогда
		Возврат Роды();
	ИначеЕсли Ключ = "карта" Тогда
		Возврат Карта();
	ИначеЕсли Ключ = "выбор-акцента" Тогда
		Возврат ВыборАкцента(Оформление);
	КонецЕсли;

	ВызватьИсключение СтрШаблон("Документация: директивы «%1» нет. Известны: %2.",
		Имя, СтрСоединить(Имена(), ", "));

КонецФункции

#Область Цвет

// Роли цвета парами «заливка и текст на ней»: образец рисуется переменными темы, поэтому
// переключатель темы и выбор акцента перекрашивают его на месте. Подписи — значения
// обеих тем для текущего акцента.
Функция РолиЦвета(Знач Оформление)

	Затравка = Токены.АкцентПоУмолчанию();
	Если ТипЗнч(Оформление) = Тип("Структура") И Оформление.Свойство("Акцент")
		И ЗначениеЗаполнено(Токены.БезопасныйЦвет(Оформление.Акцент)) Тогда
		Затравка = Токены.БезопасныйЦвет(Оформление.Акцент);
	КонецЕсли;

	Светлые = ЦветаРолей(Затравка, Ложь);
	Тёмные = ЦветаРолей(Затравка, Истина);

	Результат = "";
	Для Каждого Группа Из ГруппыРолей() Цикл
		Плитки = "";
		Для Каждого Пара Из Группа.Пары Цикл
			Плитки = Плитки + Плитка(Пара.Фон, Пара.Текст, Светлые, Тёмные);
		КонецЦикла;
		Результат = Результат + СтрШаблон(
			"<div class=""docs-swatches""><h3 class=""docs-swatches__title"">%1</h3>"
				+ "<div class=""docs-swatches__grid"">%2</div></div>",
			Экран.Экранировать(Группа.Заголовок), Плитки);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Плитка(Знач Фон, Знач Текст, Знач Светлые, Знач Тёмные)

	Возврат СтрШаблон("<div class=""docs-swatch"" style=""background:var(--md-sys-color-%1);"
		+ "color:var(--md-sys-color-%2)""><span class=""docs-swatch__name"">%1</span>"
		+ "<span class=""docs-swatch__on"">%2</span>"
		+ "<span class=""docs-swatch__hex"">светлая %3 · тёмная %4</span></div>",
		Фон, Текст, Светлые.Получить(Фон), Тёмные.Получить(Фон));

КонецФункции

Функция ЦветаРолей(Знач Затравка, Знач Тёмная)

	Результат = Новый Соответствие();
	Для Каждого Роль Из Схема.Роли(Затравка, Тёмная) Цикл
		Результат.Вставить(Роль.Роль, Роль.Цвет);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ГруппыРолей()

	Результат = Новый Массив();

	Акцент = Новый Массив();
	Для Каждого Семья Из СтрРазделить("primary,secondary,tertiary", ",") Цикл
		Акцент.Добавить(Пара(Семья, "on-" + Семья));
		Акцент.Добавить(Пара(Семья + "-container", "on-" + Семья + "-container"));
	КонецЦикла;
	Результат.Добавить(Новый Структура("Заголовок, Пары", "Акцент", Акцент));

	Статусы = Новый Массив();
	Для Каждого Семья Из СтрРазделить("error,success,warning,info", ",") Цикл
		Статусы.Добавить(Пара(Семья, "on-" + Семья));
		Статусы.Добавить(Пара(Семья + "-container", "on-" + Семья + "-container"));
	КонецЦикла;
	Результат.Добавить(Новый Структура("Заголовок, Пары", "Статусы", Статусы));

	Поверхности = Новый Массив();
	Для Каждого Роль Из СтрРазделить("surface,surface-container-lowest,surface-container-low,"
			+ "surface-container,surface-container-high,surface-container-highest", ",") Цикл
		Поверхности.Добавить(Пара(Роль, "on-surface"));
	КонецЦикла;
	Поверхности.Добавить(Пара("surface-variant", "on-surface-variant"));
	Поверхности.Добавить(Пара("inverse-surface", "inverse-on-surface"));
	Результат.Добавить(Новый Структура("Заголовок, Пары", "Поверхности", Поверхности));

	Линии = Новый Массив();
	Линии.Добавить(Пара("outline", "surface"));
	Линии.Добавить(Пара("outline-variant", "on-surface"));
	Результат.Добавить(Новый Структура("Заголовок, Пары", "Обводки", Линии));

	Возврат Результат;

КонецФункции

Функция Пара(Знач Фон, Знач Текст)
	Возврат Новый Структура("Фон, Текст", Фон, Текст);
КонецФункции

#КонецОбласти

#Область Шрифт

Функция ШкалаШрифта()

	Строки = "";
	Для Каждого Стиль Из СтрРазделить("display-large,display-medium,display-small,"
			+ "headline-large,headline-medium,headline-small,title-large,title-medium,title-small,"
			+ "body-large,body-medium,body-small,label-large,label-medium,label-small", ",") Цикл
		Строки = Строки + СтрШаблон("<div class=""docs-type""><div class=""docs-type__sample"" "
			+ "style=""font:var(--type-%1);letter-spacing:var(--md-sys-typescale-%1-tracking)"">"
			+ "Съешь же ещё этих мягких булок</div><code class=""docs-type__name"">--type-%1</code></div>",
			Стиль);
	КонецЦикла;
	Возврат "<div class=""docs-types"">" + Строки + "</div>";

КонецФункции

#КонецОбласти

#Область ФормыИВозвышение

Функция Формы()

	Плитки = "";
	Для Каждого Ступень Из СтрРазделить("none,extra-small,small,medium,large,extra-large,full", ",") Цикл
		Плитки = Плитки + СтрШаблон("<div class=""docs-shape"">"
			+ "<div class=""docs-shape__box"" style=""border-radius:var(--md-sys-shape-corner-%1)""></div>"
			+ "<code>%1</code></div>", Ступень);
	КонецЦикла;
	Возврат "<div class=""docs-shapes"">" + Плитки + "</div>";

КонецФункции

Функция Возвышение()

	Плитки = "";
	Для Уровень = 0 По 5 Цикл
		Плитки = Плитки + СтрШаблон("<div class=""docs-shape"">"
			+ "<div class=""docs-shape__box docs-shape__box--surface"" "
			+ "style=""box-shadow:var(--md-sys-elevation-level%1)""></div>"
			+ "<code>level%1</code></div>", Уровень);
	КонецЦикла;
	Возврат "<div class=""docs-shapes"">" + Плитки + "</div>";

КонецФункции

// Кривые движения: точка на дорожке едет с этой кривой и длительностью, пока на строку
// наведён указатель, — разница между «стандартной» и «выразительной» видна глазом.
Функция Движение()

	Строки = "";
	Для Каждого Кривая Из СтрРазделить("standard,standard-decelerate,standard-accelerate,"
			+ "emphasized,emphasized-decelerate,emphasized-accelerate,legacy,linear", ",") Цикл
		Строки = Строки + СтрШаблон("<li class=""docs-motion"" tabindex=""0"">"
			+ "<code>--md-sys-motion-easing-%1</code>"
			+ "<span class=""docs-motion__track""><span class=""docs-motion__dot"" "
			+ "style=""transition-timing-function:var(--md-sys-motion-easing-%1)""></span></span></li>",
			Кривая);
	КонецЦикла;
	Возврат "<ul class=""docs-motions"">" + Строки + "</ul>";

КонецФункции

#КонецОбласти

#Область Словари

Функция Иконки()

	Имена = Глифы.Имена();
	Упорядоченные = Новый СписокЗначений();
	Упорядоченные.ЗагрузитьЗначения(Имена);
	Упорядоченные.СортироватьПоЗначению();

	Плитки = "";
	Для Каждого Элемент Из Упорядоченные Цикл
		Плитки = Плитки + СтрШаблон("<li class=""docs-icon"">%1<code>%2</code></li>",
			Значки.Отрисовать(Элемент.Значение), Экран.Экранировать(Элемент.Значение));
	КонецЦикла;
	Возврат "<ul class=""docs-icons"">" + Плитки + "</ul>";

КонецФункции

// Роды узлов холста: каким тегом печатается, принимает ли детей, какие виды знает.
Функция Роды()

	Упорядоченные = Новый СписокЗначений();
	Упорядоченные.ЗагрузитьЗначения(Печать.Роды());
	Упорядоченные.СортироватьПоЗначению();

	Строки = "";
	Для Каждого Элемент Из Упорядоченные Цикл
		Род = Элемент.Значение;
		Виды = Новый Массив();
		Для Каждого Вид Из Печать.ВидыРода(Род) Цикл
			Виды.Добавить(?(ЗначениеЗаполнено(Вид), "«" + Вид + "»", "—"));
		КонецЦикла;
		Тег = Печать.ТегРода(Род);
		Строки = Строки + СтрШаблон("<tr><td><code>%1</code></td><td>%2</td><td>%3</td><td>%4</td></tr>",
			Экран.Экранировать(Род),
			?(ЗначениеЗаполнено(Тег), "<code>&lt;" + Экран.Экранировать(Тег) + "&gt;</code>", "только дети"),
			?(Печать.Контейнер(Род), "да", "нет"),
			Экран.Экранировать(СтрСоединить(Виды, ", ")));
	КонецЦикла;

	Возврат "<div class=""table-scroll""><table class=""table""><thead><tr><th>Род</th><th>Тег</th>"
		+ "<th>Принимает детей</th><th>Виды</th></tr></thead><tbody>" + Строки
		+ "</tbody></table></div>";

КонецФункции

#КонецОбласти

#Область Сайт

// Карта документации: раздел за разделом, страница — карточкой со ссылкой и строкой
// «о чём она».
Функция Карта()

	Если Состав = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Результат = "";
	Для Каждого Раздел Из Состав.Разделы() Цикл
		Если Раздел.Ключ = "начало" Тогда
			Продолжить;
		КонецЕсли;
		Карточки = "";
		Для Каждого Лист Из Раздел.Страницы Цикл
			Карточки = Карточки + СтрШаблон("<a class=""docs-map__card"" href=""%1"">"
				+ "<span class=""docs-map__title"">%2</span><span class=""docs-map__text"">%3</span></a>",
				Экран.Экранировать(Состав.Адрес(Лист.Ключ)), Экран.Экранировать(Лист.Заголовок),
				Экран.Экранировать(Лист.Кратко));
		КонецЦикла;
		Результат = Результат + СтрШаблон("<h3>%1</h3><div class=""docs-map"">%2</div>",
			Экран.Экранировать(Раздел.Заголовок), Карточки);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Форма выбора акцента: цвет уходит в cookie оформления, и вся схема — этот сайт
// в том числе — пересчитывается из него на сервере.
Функция ВыборАкцента(Знач Оформление)

	Текущий = Токены.АкцентПоУмолчанию();
	Если ТипЗнч(Оформление) = Тип("Структура") И Оформление.Свойство("Акцент")
		И ЗначениеЗаполнено(Токены.БезопасныйЦвет(Оформление.Акцент)) Тогда
		Текущий = Токены.БезопасныйЦвет(Оформление.Акцент);
	КонецЕсли;

	Возврат СтрШаблон("<form class=""docs-accent"" method=""post"" action=""/вид/акцент"" data-quiet>%1%2%3</form>",
		Набор.Поле().Отрисовать(Новый Структура("Имя, Метка, Тип, Значение", "акцент", "Акцент", "color", Текущий)),
		Набор.Кнопка().Отрисовать(Новый Структура("Подпись, Иконка", "Перекрасить", "палочка")),
		Набор.Кнопка().Отрисовать(Новый Структура("Подпись, Вариант, Имя, Значение", "Базовый акцент",
			"вторичная", "сброс", "1")));

КонецФункции

#КонецОбласти

// Параметры:
//  _Экран  - ЭкранированиеHTML
//  _Токены - ТокеныТемы
//  _Глифы  - НаборИконок
//  _Значки - Иконка
//  _Печать - РазметкаЭлементов
//  _Набор  - НаборКомпонентов, Неопределено - для формы выбора акцента.
//  _Состав - ОглавлениеДокументации, Неопределено - для карты разделов.
//
Процедура ПриСозданииОбъекта(Знач _Экран, Знач _Токены, Знач _Глифы, Знач _Значки, Знач _Печать,
	Знач _Набор = Неопределено, Знач _Состав = Неопределено) Экспорт

	Набор = _Набор;
	Состав = _Состав;

	Экран = _Экран;
	Токены = _Токены;
	Глифы = _Глифы;
	Значки = _Значки;
	Печать = _Печать;
	Схема = Новый ЦветоваяСхема();

КонецПроцедуры
