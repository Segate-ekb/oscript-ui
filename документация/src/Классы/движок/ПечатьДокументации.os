#Использовать oscript-md

// Печать страницы документации: markdown в HTML страницы сайта. Обычный markdown —
// текст, списки, таблицы, ссылки — печатает oscript-md. Блоки кода с особой пометкой
// печатает сама документация:
//
//   ```живой Подпись образца          — код исполняется: сверху картинка, снизу код
//   ```разметкой Подпись              — то же, но вместо картинки — напечатанная разметка
//   ```делайте Пояснение               — картинка с зелёной пометкой «Делайте»
//   ```не-делайте Пояснение            — картинка с красной пометкой «Не делайте»
//   ```справка Класс[.Функция]         — описание модели из исходника кита
//   ```директива имя                   — живой блок кита: роли цвета, иконки, роды…
//   ```словарь род:таблица, компонент:кнопка — что из словаря кита показывает страница;
//                                        не печатается, его читает тест полноты документации
//
// Первый заголовок — заголовок страницы, первый абзац под ним — пояснение. Заголовки
// второго уровня получают якорь и попадают в оглавление «На этой странице».

Перем Экран;       // ЭкранированиеHTML
Перем Набор;       // НаборКомпонентов
Перем Исполнение;  // ИсполнениеОбразца
Перем Справка;     // СправкаКомпонента
Перем Директивы;   // ДирективыДокументации
Перем Рендерер;    // MarkdownHTMLРендерер
Перем Простой;     // MarkdownТекстовыйРендерер

// Печатает страницу.
//
// Параметры:
//  Текст      - Строка - markdown страницы.
//  Оформление - Структура, Неопределено - оформление смотрящего (для директив цвета).
//
// Возвращаемое значение:
//  Структура - Заголовок, Пояснение (Строка, текст), Тело (HTML), Разделы (Массив из
//              Структура(Ид, Подпись) — заголовки второго уровня), Образцы (Массив из
//              Структура(Вид, Подпись, Исходник, Успех, Ошибка, HTML) — всё исполненное
//              на странице), Словарь (Массив из Строка — объявленное блоками «словарь»).
//
Функция Напечатать(Знач Текст, Знач Оформление = Неопределено) Экспорт

	Итог = Новый Структура("Заголовок, Пояснение, Тело, Разделы, Образцы, Словарь",
		"", "", "", Новый Массив(), Новый Массив(), Новый Массив());

	Документ = Markdown.Разобрать(Текст, Markdown.НастройкиGitHubLike());
	Якоря = Новый Соответствие();
	Правила = Новый Массив();
	Части = Новый Массив();
	ЖдёмПояснение = Ложь;

	Для Каждого Узел Из Документ.Дети Цикл

		Тип = Узел.ТипУзла();

		Если Тип = "code_block" И ЭтоПравило(Узел.ЯзыкИнфо) Тогда
			Правила.Добавить(Узел);
			Продолжить;
		КонецЕсли;
		СброситьПравила(Части, Правила, Итог);

		Если Тип = "heading" И Узел.Уровень = 1 И НЕ ЗначениеЗаполнено(Итог.Заголовок) Тогда
			Итог.Заголовок = ТекстУзла(Узел);
			ЖдёмПояснение = Истина;
			Продолжить;
		КонецЕсли;

		Если ЖдёмПояснение И Тип = "paragraph" Тогда
			Итог.Пояснение = ТекстУзла(Узел);
			ЖдёмПояснение = Ложь;
			Продолжить;
		КонецЕсли;
		ЖдёмПояснение = Ложь;

		Если Тип = "heading" Тогда
			Части.Добавить(Заголовок(Узел, Якоря, Итог));
		ИначеЕсли Тип = "code_block" Тогда
			Части.Добавить(БлокКода(Узел, Итог, Оформление));
		ИначеЕсли Тип = "blockquote" Тогда
			Части.Добавить(Врезка(Узел));
		ИначеЕсли Тип = "table" Тогда
			Части.Добавить("<div class=""table-scroll"">" + Рендерер.Отрендерить(Узел) + "</div>");
		Иначе
			Части.Добавить(Рендерер.Отрендерить(Узел));
		КонецЕсли;

	КонецЦикла;
	СброситьПравила(Части, Правила, Итог);

	Итог.Тело = СтрСоединить(Части, Символы.ПС);
	Возврат Итог;

КонецФункции

#Область Заголовки

Функция Заголовок(Знач Узел, Якоря, Итог)

	Подпись = ТекстУзла(Узел);
	Ид = Якорь(Подпись, Якоря);
	Если Узел.Уровень = 2 Тогда
		Итог.Разделы.Добавить(Новый Структура("Ид, Подпись", Ид, Подпись));
	КонецЕсли;

	Уровень = Макс(2, Мин(4, Узел.Уровень));
	Возврат СтрШаблон("<h%1 id=""%2"" class=""docs-heading"">%3"
		+ "<a class=""docs-heading__anchor"" href=""#%2"" aria-label=""Ссылка на раздел"">#</a></h%1>",
		Уровень, Экран.Экранировать(Ид), ВнутреннийHTML(Рендерер.Отрендерить(Узел)));

КонецФункции

// Якорь из текста заголовка: строчные буквы, цифры и дефисы. Повтор получает номер.
Функция Якорь(Знач Текст, Якоря)

	Основа = "";
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = НРег(Сред(Текст, Позиция, 1));
		Если ЭтоБуква(Символ) ИЛИ СтрНайти("0123456789", Символ) > 0 Тогда
			Основа = Основа + Символ;
		ИначеЕсли НЕ СтрЗаканчиваетсяНа(Основа, "-") И ЗначениеЗаполнено(Основа) Тогда
			Основа = Основа + "-";
		КонецЕсли;
	КонецЦикла;
	Пока СтрЗаканчиваетсяНа(Основа, "-") Цикл
		Основа = Лев(Основа, СтрДлина(Основа) - 1);
	КонецЦикла;
	Если НЕ ЗначениеЗаполнено(Основа) Тогда
		Основа = "раздел";
	КонецЕсли;

	Номер = Якоря.Получить(Основа);
	Якоря.Вставить(Основа, ?(Номер = Неопределено, 1, Номер + 1));
	Возврат ?(Номер = Неопределено, Основа, Основа + "-" + Формат(Номер + 1, "ЧГ=0"));

КонецФункции

Функция ЭтоБуква(Знач Символ)
	Возврат ВРег(Символ) <> НРег(Символ);
КонецФункции

#КонецОбласти

#Область БлокиКода

Функция БлокКода(Знач Узел, Итог, Знач Оформление)

	Пометка = РазобратьПометку(Узел.ЯзыкИнфо);

	Если Пометка.Вид = "живой" ИЛИ Пометка.Вид = "разметкой" Тогда
		Возврат Образец(Пометка, УбратьХвост(Узел.Значение), Итог);
	ИначеЕсли Пометка.Вид = "справка" Тогда
		Возврат БлокСправки(Пометка.Текст);
	ИначеЕсли Пометка.Вид = "директива" Тогда
		Возврат Директивы.Напечатать(Пометка.Текст, Оформление);
	ИначеЕсли Пометка.Вид = "словарь" Тогда
		Для Каждого Имя Из СтрРазделить(Пометка.Текст + "," + Узел.Значение, "," + Символы.ПС, Ложь) Цикл
			Если ЗначениеЗаполнено(СокрЛП(Имя)) Тогда
				Итог.Словарь.Добавить(СокрЛП(Имя));
			КонецЕсли;
		КонецЦикла;
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон("<pre class=""code""><code>%1</code></pre>",
		Экран.Экранировать(УбратьХвост(Узел.Значение)));

КонецФункции

// Образец: картинка, под ней код с кнопкой копирования. Сломанный образец печатает
// ошибку на месте картинки — страница остаётся живой, а тест документации краснеет.
Функция Образец(Знач Пометка, Знач Исходник, Итог)

	Итог_ = Исполнение.Запустить(Исходник);
	Итог.Образцы.Добавить(Новый Структура("Вид, Подпись, Исходник, Успех, Ошибка, HTML",
		Пометка.Вид, Пометка.Текст, Исходник, Итог_.Успех, Итог_.Ошибка, Итог_.HTML));

	Если НЕ Итог_.Успех Тогда
		Показ = Ошибка(Итог_.Ошибка);
	ИначеЕсли Пометка.Вид = "разметкой" Тогда
		Показ = СтрШаблон("<pre class=""code docs-sample__markup""><code>%1</code></pre>",
			Экран.Экранировать(Итог_.HTML));
	ИначеЕсли НЕ ЗначениеЗаполнено(Итог_.HTML) Тогда
		Показ = "<p class=""docs-sample__nothing"">этот вызов не печатает ничего</p>";
	Иначе
		Показ = Итог_.HTML;
	КонецЕсли;

	Подпись = ?(ЗначениеЗаполнено(Пометка.Текст),
		СтрШаблон("<p class=""docs-sample__title"">%1</p>", Экран.Экранировать(Пометка.Текст)), "");

	Возврат СтрШаблон("<figure class=""docs-sample"">%1<div class=""docs-sample__preview"">%2</div>"
		+ "<div class=""docs-sample__code"">%3</div></figure>",
		Подпись, Показ,
		Набор.БлокКоманды().Отрисовать(Новый Структура("Команда", Исходник)));

КонецФункции

// Правила «делайте / не делайте» идут парами и стоят рядом: соседние такие блоки
// собираются в одну сетку.
Процедура СброситьПравила(Части, Правила, Итог)

	Если Правила.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Карточки = "";
	Для Каждого Узел Из Правила Цикл
		Пометка = РазобратьПометку(Узел.ЯзыкИнфо);
		Исходник = УбратьХвост(Узел.Значение);
		Итог_ = Исполнение.Запустить(Исходник);
		Итог.Образцы.Добавить(Новый Структура("Вид, Подпись, Исходник, Успех, Ошибка, HTML",
			Пометка.Вид, Пометка.Текст, Исходник, Итог_.Успех, Итог_.Ошибка, Итог_.HTML));

		Делайте = (Пометка.Вид = "делайте");
		Карточки = Карточки + СтрШаблон("<figure class=""docs-rule docs-rule--%1"">"
			+ "<div class=""docs-rule__preview"">%2</div><figcaption class=""docs-rule__caption"">"
			+ "<span class=""docs-rule__verdict"">%3</span>%4</figcaption>"
			+ "<details class=""docs-rule__code""><summary>Код</summary>%5</details></figure>",
			?(Делайте, "do", "dont"),
			?(Итог_.Успех, Итог_.HTML, Ошибка(Итог_.Ошибка)),
			?(Делайте, "Делайте", "Не делайте"),
			Экран.Экранировать(Пометка.Текст),
			СтрШаблон("<pre class=""code""><code>%1</code></pre>", Экран.Экранировать(Исходник)));
	КонецЦикла;

	Части.Добавить("<div class=""docs-rules"">" + Карточки + "</div>");
	Правила.Очистить();

КонецПроцедуры

Функция ЭтоПравило(Знач Инфо)
	Вид = РазобратьПометку(Инфо).Вид;
	Возврат Вид = "делайте" ИЛИ Вид = "не-делайте";
КонецФункции

Функция БлокСправки(Знач Цель)

	Части = СтрРазделить(СокрЛП(Цель), ".");
	Класс = Части[0];
	Функция_ = ?(Части.Количество() > 1, Части[1], "Отрисовать");
	Найдено = Справка.Справка(Класс, Функция_);

	Если НЕ Найдено.Найдено Тогда
		Возврат Ошибка(СтрШаблон("в исходнике кита нет описания %1.%2", Класс, Функция_));
	КонецЕсли;

	Возврат СтрШаблон("<div class=""docs-api""><p class=""docs-api__head""><code>%1</code>"
		+ "<span class=""docs-api__file"">%2</span></p><pre class=""docs-api__text"">%3</pre></div>",
		Экран.Экранировать(Класс + "." + Функция_ + "()"), Экран.Экранировать(Найдено.Файл),
		Экран.Экранировать(Найдено.Текст));

КонецФункции

Функция Ошибка(Знач Текст)
	Возврат СтрШаблон("<p class=""docs-error"" role=""alert"">Образец не собрался: %1</p>",
		Экран.Экранировать(Текст));
КонецФункции

// Пометка блока: первое слово — вид, остальное — подпись. «не делайте» пишется и через
// пробел, и через дефис.
Функция РазобратьПометку(Знач Инфо)

	Текст = СокрЛП(Строка(Инфо));
	Если СтрНачинаетсяС(НРег(Текст), "не делайте") Тогда
		Текст = "не-делайте" + Сред(Текст, СтрДлина("не делайте") + 1);
	КонецЕсли;

	Пробел = СтрНайти(Текст, " ");
	Если Пробел = 0 Тогда
		Возврат Новый Структура("Вид, Текст", НРег(Текст), "");
	КонецЕсли;
	Возврат Новый Структура("Вид, Текст", НРег(Лев(Текст, Пробел - 1)), СокрЛП(Сред(Текст, Пробел + 1)));

КонецФункции

#КонецОбласти

#Область Прочее

// Цитата markdown — врезка-совет. Первое жирное слово становится её меткой.
Функция Врезка(Знач Узел)
	Возврат "<aside class=""docs-note"">" + ВнутреннийHTML(Рендерер.Отрендерить(Узел)) + "</aside>";
КонецФункции

Функция ТекстУзла(Знач Узел)
	Возврат СокрЛП(Простой.Отрендерить(Узел));
КонецФункции

// Содержимое между первым «>» и последним «</»: тег-обёртку печатает вызывающий.
Функция ВнутреннийHTML(Знач HTML)

	Текст = СокрЛП(HTML);
	Начало = СтрНайти(Текст, ">");
	Конец = СтрНайти(Текст, "</", НаправлениеПоиска.СКонца);
	Если Начало = 0 ИЛИ Конец <= Начало Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат СокрЛП(Сред(Текст, Начало + 1, Конец - Начало - 1));

КонецФункции

Функция УбратьХвост(Знач Текст)
	Результат = Строка(Текст);
	Пока СтрЗаканчиваетсяНа(Результат, Символы.ПС) Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

// Параметры:
//  _Экран      - ЭкранированиеHTML
//  _Набор      - НаборКомпонентов
//  _Исполнение - ИсполнениеОбразца
//  _Справка    - СправкаКомпонента
//  _Директивы  - ДирективыДокументации
//
Процедура ПриСозданииОбъекта(Знач _Экран, Знач _Набор, Знач _Исполнение, Знач _Справка, Знач _Директивы) Экспорт

	Экран = _Экран;
	Набор = _Набор;
	Исполнение = _Исполнение;
	Справка = _Справка;
	Директивы = _Директивы;
	Рендерер = Новый MarkdownHTMLРендерер();
	Простой = Новый MarkdownТекстовыйРендерер();

КонецПроцедуры
