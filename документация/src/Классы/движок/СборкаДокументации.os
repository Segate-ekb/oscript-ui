// Сборка документации без контейнера: граф кита собирается руками, как в тестах кита.
// Ею пользуются скрипт проверки страниц (документация/проверка.os) и тест документации
// в тестах кита — им не нужен веб-сервер, нужна только печать страниц.

Перем Печатник;  // ПечатьДокументации
Перем Состав;    // ОглавлениеДокументации
Перем Желуди;    // Структура — Набор, Кит, Формы, Настройки, Разметка, Экран этой сборки

// Печать страниц.
//
// Возвращаемое значение:
//  ПечатьДокументации
//
Функция Печать() Экспорт
	Возврат Печатник;
КонецФункции

// Желуди кита этой сборки — те, что видит код образца, и словарь родов.
//
// Возвращаемое значение:
//  Структура - Набор, Кит, Формы, Настройки, Разметка, Экран.
//
Функция Желуди() Экспорт
	Возврат Желуди;
КонецФункции

// Оглавление сайта.
//
// Возвращаемое значение:
//  ОглавлениеДокументации
//
Функция Оглавление() Экспорт
	Возврат Состав;
КонецФункции

Функция СобратьНабор(Знач Экран, Знач Модели, Знач Значки, Знач Тексты)

	Кнопки = Новый Кнопка(Экран, Модели, Значки);
	Плашки = Новый Плашка(Экран, Модели, Значки);
	// тексты и значки — поля список и цвет, тексты отказов — проверка до отправки (выпуск 0.12)
	Поля = Новый ПолеФормы(Экран, Модели, Тексты, Значки);
	ПоляСкрытые = Новый СкрытоеПоле(Экран, Модели);
	Заглавия = Новый ЗаголовокСтраницы(Экран, Модели);
	Команды = Новый БлокКоманды(Экран, Модели, Значки);
	РядыМеты = Новый РядМеты(Экран, Модели, Значки);
	Деревья = Новый ДеревоРазделов(Экран, Модели, Значки);

	Возврат Новый НаборКомпонентов(
		Новый Карточка(Экран, Модели, Значки),
		Поля,
		Новый ПолеИзКонфига(Экран, Модели, Поля, Значки),
		Новый Таблица(Экран, Модели),
		Новый Тост(Экран, Модели, Значки),
		Плашки,
		Деревья,
		Новый ПанельСохранения(Экран, Модели, Кнопки),
		Значки,
		Новый Тумблер(Экран, Модели),
		Новый Проводник(Экран, Модели, Значки),
		Кнопки,
		Новый Табы(Экран, Модели, Значки),
		Новый ПустоеСостояние(Экран, Модели, Значки, Кнопки),
		Новый ОпаснаяЗона(Экран, Модели, Значки, Поля, Кнопки),
		Команды,
		Новый ШапкаОбъекта(Экран, Модели, Значки, Плашки, Команды, РядыМеты),
		Новый Пагинация(Экран, Модели, Значки),
		Новый Плитка(Экран, Модели, Значки),
		Новый Сетка(Экран, Модели),
		ПоляСкрытые,
		Заглавия,
		Новый СтраницаОшибки(Модели, Заглавия),
		Новый ФормаОтбора(Экран, Модели, Поля, Кнопки, ПоляСкрытые),
		Новый ПолосаЗаполнения(Экран, Модели),
		Новый Меню(Экран, Модели, Кнопки),
		Новый МенюХаба(Экран, Модели, Кнопки, Тексты, Деревья),
		РядыМеты,
		Новый КраткаяСводка(Экран, Модели, Плашки),
		// дерево галок (выпуск 0.13): словарь, значки, кнопка и поле — поиск, режимы, правки
		Новый ДеревоГалок(Экран, Модели, Плашки, Тексты, Значки, Кнопки, Поля),
		Новый Крошки(Экран, Модели, Тексты));

КонецФункции

Процедура ПриСозданииОбъекта() Экспорт

	Экран = Новый ЭкранированиеHTML();
	Модели = Новый ЧтениеМодели();
	Место = Новый РаскладкаСтатики(Новый СтатикаИнсталляцииПоУмолчанию());
	Глифы = Новый НаборИконок(Место, Новый ЧтениеГлифа());
	Значки = Новый Иконка(Экран, Глифы, Модели);
	// словарь сайта, а не пустой словарь кита: отказы формы в образцах читаются словами
	Тексты = Новый ТекстыИнтерфейса(Новый СловарьДокументации());

	Набор = СобратьНабор(Экран, Модели, Значки, Тексты);
	Разметка = Новый РазметкаЭлементов(Экран);
	Настройки = Новый РендерерНастроек(Экран, Модели, Набор, Тексты);
	// окна (выпуск 0.11): рамка общая у окна, подтверждения и прежнего окна формы
	Окна = Новый Окно(Экран, Набор, Тексты);
	Подтверждения = Новый Подтверждение(Набор, Тексты, Окна);
	ОкнаПоАдресу = Новый ОкноПоАдресу(Экран, Набор, Тексты);
	// шаги (шаг 10) и реестр (шаг 11): рисователи узлов, порядок как у конструктора Кит
	// сегменты и подсказка, картинка и образец (выпуск 0.12): рисователи узлов — перед реестром,
	// как у конструктора; слот картинки печатает окно сброса подтверждением
	Кит = Новый Кит(Разметка, Набор, Настройки, Новый Шаги(Экран, Набор, Тексты),
		Окна, Подтверждения, ОкнаПоАдресу, Новый Сегменты(Экран, Набор), Новый Подсказка(Экран, Тексты),
		Новый СлотКартинки(Экран, Набор, Тексты, Подтверждения), Новый Образец(Экран, Тексты),
		Новый Реестр(Экран, Модели, Набор, Тексты));
	Формы = Новый Формы(Модели, Новый ПроверкаПоля(Тексты), Новый ЗначенияФормы(),
		Новый ПечатьФормы(Экран, Набор, Модели, Разметка, Окна), Настройки);

	Желуди = Новый Структура("Набор, Кит, Формы, Настройки, Разметка, Экран",
		Набор, Кит, Формы, Настройки, Разметка, Экран);

	Состав = Новый ОглавлениеДокументации();
	Печатник = Новый ПечатьДокументации(Экран, Набор,
		Новый ИсполнениеОбразца(Набор, Кит, Формы, Настройки),
		Новый СправкаКомпонента(Место),
		Новый ДирективыДокументации(Экран, Новый ТокеныТемы(), Глифы, Значки, Разметка, Набор, Состав));

КонецПроцедуры
