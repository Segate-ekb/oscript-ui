// Справка компонента: описание модели берётся из ИСХОДНИКА кита — из комментария над
// экспортной функцией. Документация не держит второй копии списка полей, поэтому
// отставать от кода ей нечем: поле, добавленное в компонент вместе с комментарием,
// появляется в справке само.

Перем КаталогКлассов; // Строка — src/Классы кита
Перем Файлы;          // Соответствие: имя класса -> полный путь к .os

// Комментарий над функцией класса кита.
//
// Параметры:
//  Класс   - Строка - имя класса кита («Кнопка», «Кит», «Таблица»).
//  Функция_ - Строка - имя экспортной функции; по умолчанию «Отрисовать».
//
// Возвращаемое значение:
//  Структура - Найдено (Булево), Текст (комментарий без «//»), Файл (путь от корня
//              репозитория, например «src/Классы/компоненты/Кнопка.os»), Сигнатура.
//
Функция Справка(Знач Класс, Знач Функция_ = "Отрисовать") Экспорт

	Результат = Новый Структура("Найдено, Текст, Файл, Сигнатура", Ложь, "", "", "");

	Путь = Файлы.Получить(НРег(Класс));
	Если Путь = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Файл = "src/Классы/" + СтрЗаменить(Сред(Путь, СтрДлина(КаталогКлассов) + 2), "\", "/");

	Строки = СтрРазделить(ПрочитатьТекст(Путь), Символы.ПС, Истина);
	Для Номер = 0 По Строки.ВГраница() Цикл

		Строка_ = СокрЛП(Строки[Номер]);
		Если НЕ СтрНачинаетсяС(НРег(Строка_), НРег("Функция " + Функция_ + "("))
			И НЕ СтрНачинаетсяС(НРег(Строка_), НРег("Процедура " + Функция_ + "(")) Тогда
			Продолжить;
		КонецЕсли;

		Результат.Сигнатура = СтрЗаменить(Строка_, " Экспорт", "");
		Комментарий = Новый Массив();
		Выше = Номер - 1;
		Пока Выше >= 0 И СтрНачинаетсяС(СокрЛ(Строки[Выше]), "//") Цикл
			Комментарий.Вставить(0, БезКосых(Строки[Выше]));
			Выше = Выше - 1;
		КонецЦикла;

		Результат.Найдено = Комментарий.Количество() > 0;
		Результат.Текст = СокрП(СтрСоединить(Комментарий, Символы.ПС));
		Прервать;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Классы кита, которые справка видит.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Классы() Экспорт

	Результат = Новый Массив();
	Для Каждого КиЗ Из Файлы Цикл
		Результат.Добавить(Новый Файл(КиЗ.Значение).ИмяБезРасширения);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция БезКосых(Знач Строка_)

	Текст = СокрЛ(Строка_);
	Текст = Сред(Текст, 3);
	Если СтрНачинаетсяС(Текст, " ") Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	Возврат СокрП(Текст);

КонецФункции

Функция ПрочитатьТекст(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

// Параметры:
//  Раскладка - РаскладкаСтатики - знает каталог статики кита; классы лежат рядом с ним.
//
Процедура ПриСозданииОбъекта(Знач Раскладка) Экспорт

	КаталогКлассов = ОбъединитьПути(Новый Файл(Раскладка.КаталогКита()).Путь, "Классы");
	Если СтрЗаканчиваетсяНа(КаталогКлассов, ПолучитьРазделительПути()) Тогда
		КаталогКлассов = Лев(КаталогКлассов, СтрДлина(КаталогКлассов) - 1);
	КонецЕсли;

	Файлы = Новый Соответствие();
	Для Каждого Файл Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Файлы.Вставить(НРег(Файл.ИмяБезРасширения), Файл.ПолноеИмя);
	КонецЦикла;

КонецПроцедуры
