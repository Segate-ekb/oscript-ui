	Лист("страница-ошибки", "Страница ошибки", "отказ и «не найдено»");

	Раздел("холст", "Холст");
	Лист("холст", "Холст и узлы", "экран деревом узлов");
	Лист("язык-узлов", "Язык узлов", "шесть правил и словарь узлов");
	Лист("каркас-документа", "Каркас документа", "голова, тело, лендмарки");
	Лист("раскладка", "Раскладка", "группы, ряды, сетка");
	Лист("списки", "Списки и пары", "перечни и «подпись — значение»");
	Лист("таблица-деревом", "Таблица деревом", "таблица из узлов");
	Лист("формы-деревом", "Формы деревом", "форма из узлов");
	Лист("текст", "Текст и значения", "заголовки, абзацы, код, ссылки");
	Лист("компонент-в-дереве", "Компонент в дереве", "компоненты узлами холста");
	Лист("словарь-родов", "Словарь родов", "все роды узлов");

	Раздел("приложение", "Приложение");
	Лист("каркас-страницы", "Каркас страницы", "шапка, меню, подвал вокруг экрана");
	Лист("дом-настроек", "Дом настроек", "разделы, секции, сохранение");
	Лист("оформление", "Своё оформление", "лист, статика и тема инсталляции");
	Лист("приложение-на-winow", "Приложение на winow", "этот сайт как пример");

КонецПроцедуры

Процедура Раздел(Знач Ключ, Знач Заголовок)
	Разделы_.Добавить(Новый Структура("Ключ, Заголовок, Страницы", Ключ, Заголовок, Новый Массив()));
КонецПроцедуры

Процедура Лист(Знач Ключ, Знач Заголовок, Знач Кратко)

	Текущий = Разделы_[Разделы_.ВГраница()];
	Запись = Новый Структура("Ключ, Заголовок, Раздел, Кратко", Ключ, Заголовок, Текущий.Ключ, Кратко);
	Текущий.Страницы.Добавить(Запись);
	Страницы_.Вставить(Ключ, Запись);
	Порядок.Добавить(Ключ);

КонецПроцедуры

#КонецОбласти

Процедура ПриСозданииОбъекта() Экспорт

	Разделы_ = Новый Массив();
	Страницы_ = Новый Соответствие();
	Порядок = Новый Массив();
	Собрать();

КонецПроцедуры
