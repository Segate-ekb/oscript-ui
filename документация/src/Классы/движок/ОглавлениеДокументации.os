// Оглавление документации: разделы сайта и страницы в них. Страница — файл markdown
// в каталоге «страницы» с тем же именем, что и её адрес; порядок здесь — порядок
// в навигации и в ходах «назад» и «дальше».

Перем Разделы_;  // Массив из Структура(Ключ, Заголовок, Страницы)
Перем Страницы_; // Соответствие: ключ страницы -> Структура(Ключ, Заголовок, Раздел, Кратко)
Перем Порядок;   // Массив ключей страниц по порядку

// Разделы сайта.
//
// Возвращаемое значение:
//  Массив из Структура - Ключ, Заголовок, Страницы (Массив из Структура: Ключ, Заголовок,
//                        Раздел, Кратко).
//
Функция Разделы() Экспорт
	Возврат Разделы_;
КонецФункции

// Страница по ключу.
//
// Параметры:
//  Ключ - Строка - адрес страницы без «/».
//
// Возвращаемое значение:
//  Структура, Неопределено - Ключ, Заголовок, Раздел, Кратко.
//
Функция Страница(Знач Ключ) Экспорт
	Возврат Страницы_.Получить(НРег(СокрЛП(Ключ)));
КонецФункции

// Ключи всех страниц по порядку.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция Ключи() Экспорт
	Возврат Порядок;
КонецФункции

// Соседи страницы в порядке чтения.
//
// Параметры:
//  Ключ - Строка - ключ страницы.
//
// Возвращаемое значение:
//  Структура - Назад, Дальше (Структура страницы либо Неопределено).
//
Функция Соседи(Знач Ключ) Экспорт

	Номер = Порядок.Найти(НРег(Ключ));
	Результат = Новый Структура("Назад, Дальше");
	Если Номер = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если Номер > 0 Тогда
		Результат.Назад = Страницы_.Получить(Порядок[Номер - 1]);
	КонецЕсли;
	Если Номер < Порядок.ВГраница() Тогда
		Результат.Дальше = Страницы_.Получить(Порядок[Номер + 1]);
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Адрес страницы на сайте.
//
// Параметры:
//  Ключ - Строка - ключ страницы.
//
// Возвращаемое значение:
//  Строка - «/» для обзора, «/ключ» для остальных.
//
Функция Адрес(Знач Ключ) Экспорт
	Возврат ?(Ключ = "обзор", "/", "/" + Ключ);
КонецФункции

#Область Состав

Процедура Собрать()

	Раздел("начало", "Начало");
	Лист("обзор", "Обзор", "что такое кит и как выглядит экран на нём");
	Лист("установка", "Установка и первый экран", "подключить кит и нарисовать страницу");
	Лист("принципы", "Принципы", "Material 3, сервер решает, скрипт только улучшает");

	Раздел("основы", "Основы");
	Лист("цвет", "Цвет и тема", "роли цвета, акцент и тёмная тема");
	Лист("типографика", "Типографика", "шкала шрифта Material 3");
	Лист("формы", "Формы и возвышение", "скругления, тени, слои состояний");
	Лист("движение", "Движение", "кривые, длительности, рябь");
	Лист("иконки", "Иконки", "глифы Material Symbols");
	Лист("сетка", "Сетка и интервалы", "колонки, шаг 4dp, плотность");

	Раздел("действия", "Действия");
	Лист("кнопка", "Кнопка", "запускает действие или ведёт по ссылке");
	Лист("меню", "Меню", "действия строки и учётки в выпадающей панели");
	Лист("блок-команды", "Блок команды", "команда для терминала с копированием");

	Раздел("ввод", "Ввод");
	Лист("поле", "Поле формы", "текст, число, выбор, флажок");
	Лист("тумблер", "Тумблер", "включено или выключено");
	Лист("форма-отбора", "Форма отбора", "поиск и фильтр списка");
	Лист("дерево-галок", "Дерево галок", "выбор в иерархии");
	Лист("поле-из-конфига", "Поле из конфига", "значение, заданное снаружи");
	Лист("скрытое-поле", "Скрытое поле", "значение, которое форма везёт молча");

	Раздел("показ", "Показ данных");
	Лист("таблица", "Таблица", "записи строками, на телефоне карточками");
	Лист("плашка", "Плашка", "короткая метка состояния");
	Лист("карточка", "Карточка", "законченный кусок содержимого");
	Лист("плитка", "Плитка показателя", "одно число крупно");
	Лист("сводка", "Сводка", "запись одним взглядом");
	Лист("полоса-заполнения", "Полоса заполнения", "доля от целого");
	Лист("ряд-меты", "Ряд меты", "сведения об объекте строкой");
	Лист("шапка-объекта", "Шапка объекта", "имя, состояние и действия объекта");
	Лист("заголовок-страницы", "Заголовок страницы", "о чём экран");
	Лист("пустое-состояние", "Пустое состояние", "когда показать нечего");

	Раздел("навигация", "Навигация");
	Лист("табы", "Вкладки", "соседние виды одного объекта");
	Лист("дерево-разделов", "Дерево разделов", "разделы внутри объекта");
	Лист("крошки", "Крошки", "путь к текущей странице");
	Лист("пагинация", "Пагинация", "длинный список страницами");
	Лист("проводник", "Проводник", "шаги первой настройки");
	Лист("единое-меню", "Единое меню", "навигация инсталляции на любой ширине");

	Раздел("отклик", "Обратная связь");
	Лист("тост", "Тост", "итог действия");
	// окна (выпуск 0.11)
	Лист("окно", "Окно", "короткая задача поверх экрана");
	Лист("подтверждение", "Подтверждение", "окно перед необратимым действием");
	Лист("опасная-зона", "Опасная зона", "необратимое действие с подтверждением");
