// Словарь интерфейса сайта — тексты шапки, меню и переключателя темы, которые кит
// спрашивает у инсталляции по ключу.

Перем Тексты; // Соответствие: ключ -> текст

Функция НайтиТекст(Знач Ключ) Экспорт
	Возврат Тексты.Получить(Ключ);
КонецФункции

Функция Ключи() Экспорт
	Результат = Новый Массив();
	Для Каждого КиЗ Из Тексты Цикл
		Результат.Добавить(КиЗ.Ключ);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&Верховный
&Прозвище("СловарьИнтерфейса")
&Желудь
Процедура ПриСозданииОбъекта() Экспорт

	Тексты = Новый Соответствие();
	Тексты.Вставить("chrome.top.nav.title", "Части документации");
	Тексты.Вставить("chrome.top.theme.toggle", "Переключить тему");
	Тексты.Вставить("chrome.top.theme.to-dark", "Включить тёмную тему");
	Тексты.Вставить("chrome.top.theme.to-light", "Включить светлую тему");
	Тексты.Вставить("chrome.office.nav.title", "Разделы личного");
	Тексты.Вставить("chrome.menu.open", "Меню");
	Тексты.Вставить("chrome.menu.close", "Закрыть меню");
	Тексты.Вставить("chrome.menu.rail.title", "Части документации");
	Тексты.Вставить("chrome.menu.section.deeds", "Дела");
	Тексты.Вставить("chrome.menu.section.nav", "Документация");
	Тексты.Вставить("chrome.menu.section.screen", "Страницы раздела");
	Тексты.Вставить("chrome.menu.count", "ждёт внимания: %1");
	Тексты.Вставить("settings.frame.nav.title", "Разделы настроек");
	Тексты.Вставить("settings.frame.crumbs.label", "Путь к настройкам");
	Тексты.Вставить("chrome.crumbs", "Путь к странице");
	// шаги (выпуск 0.11, шаг 10)
	Тексты.Вставить("steps.back", "Назад");
	Тексты.Вставить("steps.next", "Дальше");
	Тексты.Вставить("steps.submit", "Отправить");
	Тексты.Вставить("steps.progress", "Шаг %1 из %2: %3");
	Тексты.Вставить("registry.empty", "Записей пока нет");
	Тексты.Вставить("registry.entry.actions", "Действия: %1");
	// окна (выпуск 0.11)
	Тексты.Вставить("window.close", "Закрыть окно");
	Тексты.Вставить("window.load.error", "Не удалось открыть окно. Попробуйте ещё раз.");
	Тексты.Вставить("confirm.ok", "Подтвердить");
	Тексты.Вставить("confirm.cancel", "Отмена");
	Тексты.Вставить("confirm.echo", "Чтобы подтвердить, введите «%1»");
	Тексты.Вставить("form.error.required", "Заполните поле");
	Тексты.Вставить("form.error.number", "Нужно число");
	Тексты.Вставить("form.error.date", "Нужна дата");
	Тексты.Вставить("form.error.min", "Не меньше %1");
	Тексты.Вставить("form.error.max", "Не больше %1");
	Тексты.Вставить("form.error.choice", "Выберите вариант из списка");
	// сегменты и подсказка (выпуск 0.12)
	Тексты.Вставить("help.open", "Справка");
	Тексты.Вставить("help.field", "Справка: %1");

КонецПроцедуры
