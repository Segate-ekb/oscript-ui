// Образец страницы входа (дев-сборка 9, слово владельца: «экран логина сделать нормально —
// посмотри, как на GitHub; убери всё лишнее»): узкая колонка по центру — знак и заголовок,
// логин и пароль со ссылкой «Забыли пароль?», кнопка во всю ширину, разделитель «или»,
// кнопки провайдеров со значками брендов и рамочная строка регистрации. Каркас вокруг узкой
// страницы печатает только знак и переключатель темы. Учётных записей у образца нет: вход
// отвечает тостом и возвращает на страницу (PRG), как ответило бы приложение на неверный
// пароль.
//
// На этой странице гоняется шаг «страница входа» браузерного сценария слова-дев-9.js.

Перем Каркас;  // КаркасСтраницы
Перем Кит;     // Кит
Перем Активы;  // АктивыСтатики — адрес знака сайта

#Область Маршруты

&ТочкаМаршрута("образец-входа")
Процедура Вход(Ответ, МетодЗапроса, КукиЗапроса, ПутьЗапроса, ПараметрыЗапросаИменные) Экспорт

	Если ВРег(Строка(МетодЗапроса)) = "POST" Тогда
		Ответ.Перенаправить("/" + КодироватьСтроку("образец-входа", СпособКодированияСтроки.КодировкаURL) + "?пришло=1");
		Ответ.УстановитьСостояние(303);
		Возврат;
	КонецЕсли;

	Пришло = ПараметрыЗапросаИменные <> Неопределено И ПараметрыЗапросаИменные.Получить("пришло") <> Неопределено;
	Ответ.УстановитьТипКонтента("html");
	Ответ.УстановитьСостояние(200);
	Ответ.ТелоТекст = Каркас.Страница("Вход", Содержимое(Пришло),
		Каркас.КонтекстСтраницы(Неопределено, КукиЗапроса, Ложь, Ложь, ПутьЗапроса));

КонецПроцедуры

#КонецОбласти

#Область Страница

Функция Содержимое(Знач Пришло)

	Отказ = ?(Пришло, Кит.Уведомление("Это образец: учётных записей у него нет.").Вид("err"), Неопределено);

	Возврат Кит.УзкаяСтраница(
		Отказ,
		Кит.Форма("/образец-входа",
			Кит.Поле("логин", "Логин или почта").Автозаполнение("username").Обязательное(),
			Кит.Поле("пароль", "Пароль").Секрет().Автозаполнение("current-password").Обязательное()
				.СсылкаРядом("/образец-входа", "Забыли пароль?"),
			Кит.Кнопка("Войти").Основная().ВоВсюШирину()).Вид("столбик").Токен("т0кен-образца"),
		Кит.Разделитель("или"),
		Кит.Область(
			Кит.Кнопка("Войти через GitHub").Вторичная().Иконка("бренд:github").ВоВсюШирину()
				.Адрес("/образец-входа"),
			Кит.Кнопка("Войти через Keycloak").Вторичная().Иконка("бренд:keycloak").ВоВсюШирину()
				.Адрес("/образец-входа")).Вид("столбик"),
		Кит.Примечание("Нет аккаунта? ", Кит.Ссылка("/образец-входа", "Зарегистрироваться")).Вид("рамка"))
		.Шапка(Активы.Адрес("знак.svg"), "Вход в oscript-ui", "Образец страницы входа");

КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "АктивыСтатики") _Активы) Экспорт

	Каркас = _Каркас;
	Кит = _Кит;
	Активы = _Активы;

КонецПроцедуры
