// Образец списка со страницами, отбором и сортировкой (выпуск 0.13): строка поиска,
// таблица проектов с сортируемыми колонками и пагинация «41–60 из 137» — все три со словом
// БезПерезагрузки. Сервер отвечает так, как ответило бы приложение: страница списка целиком
// по адресу ?q=…&sort=…&order=…&page=…; тихий переход скрипт кладёт на место, а без скрипта
// это обычные ссылки и GET-форма. Состояния у образца нет: список постоянен, отбор несёт
// адрес.
//
// На этой странице гоняются браузерные прогоны tests/браузер/страницы-и-отбор.js.

Перем Каркас;  // КаркасСтраницы
Перем Кит;     // Кит

Перем НаСтранице; // Число — записей на странице

#Область Маршруты

&ТочкаМаршрута("образец-списка")
Процедура Список(Ответ, МетодЗапроса, КукиЗапроса, ПутьЗапроса, ПараметрыЗапросаИменные,
	ТелоЗапросаСоответствие) Экспорт

	Отбор = Новый Структура();
	Отбор.Вставить("Подстрока", Значение(ПараметрыЗапросаИменные, "q"));
	Отбор.Вставить("Поле", ?(Значение(ПараметрыЗапросаИменные, "sort") = "members", "members", "name"));
	Отбор.Вставить("Порядок", ?(Значение(ПараметрыЗапросаИменные, "order") = "desc", "desc", "asc"));
	Отбор.Вставить("Страница", Номер(Значение(ПараметрыЗапросаИменные, "page")));

	Ответ.УстановитьТипКонтента("html");
	Ответ.УстановитьСостояние(200);
	Ответ.ТелоТекст = Каркас.Страница("Образец списка", Содержимое(Отбор),
		Каркас.КонтекстСтраницы(Неопределено, КукиЗапроса, Ложь, Ложь, ПутьЗапроса));

КонецПроцедуры

#КонецОбласти

#Область Страница

Функция Содержимое(Знач Отбор)

	Найдено = Отобрать(Отбор);
	Всего = Найдено.Количество();
	Последняя = Макс(1, Цел((Всего + НаСтранице - 1) / НаСтранице));
	Страница = Мин(Отбор.Страница, Последняя);

	Записи = Новый Массив();
	Для Индекс = (Страница - 1) * НаСтранице По Мин(Страница * НаСтранице, Всего) - 1 Цикл
		Записи.Добавить(Найдено[Индекс]);
	КонецЦикла;

	Таблица = Кит.Таблица(Записи).Пусто("Ничего не нашлось — уберите часть слова").БезПерезагрузки();
	Колонка(Таблица, Отбор, "name", "Проект");
	Таблица.Колонка("lead", "Ведущий");
	Колонка(Таблица, Отбор, "members", "Участников").Вид("узкая");

	Возврат Кит.Холст(
		Кит.Заголовок(2, "Проекты"),
		Кит.Примечание("Образец к страницам «Пагинация», «Форма отбора» и «Таблица деревом»:"
			+ " страницы, поиск и сортировка уходят без перезагрузки, а «Назад» браузера"
			+ " возвращает прежнее."),
		Кит.СтрокаПоиска("/образец-списка").Метка("Имя проекта").Значение(Отбор.Подстрока)
			.Пример("например, бета").Кнопка("Найти", "поиск")
			.СкрытоеПоле("sort", Отбор.Поле).СкрытоеПоле("order", Отбор.Порядок)
			.БезПерезагрузки(),
		Таблица,
		Кит.Пагинация("/образец-списка", Страница).Всего(Всего).НаСтранице(НаСтранице)
			.Параметры("q", Отбор.Подстрока).Параметры("sort", Отбор.Поле)
			.Параметры("order", Отбор.Порядок).БезПерезагрузки());

КонецФункции

// Колонка сортирует: у текущей ссылка ведёт на обратный порядок, у прочих — на прямой.
// Подстрока переживает сортировку, номер страницы — нет: в новом порядке «третья страница»
// значит другое.
Функция Колонка(Знач Таблица, Знач Отбор, Знач Ключ, Знач Заголовок)

	Текущая = (Отбор.Поле = Ключ);
	Порядок = ?(Текущая И Отбор.Порядок = "asc", "desc", "asc");
	Адрес = "/образец-списка?" + Пара("q", Отбор.Подстрока) + Пара("sort", Ключ)
		+ "order=" + Порядок;

	Возврат Таблица.Колонка(Ключ, Заголовок).Сортировка(Адрес,
		?(Текущая, ?(Отбор.Порядок = "asc", "возр", "убыв"), ""));

КонецФункции

#КонецОбласти

#Область Данные

// Список постоянен: двенадцать имён на четыре вида проектов, ведущие и число участников
// считаются от номера — у каждого посетителя одни и те же 48 записей.
Функция Проекты()

	Имена = СтрРазделить("Альфа,Бета,Гамма,Дельта,Эпсилон,Дзета,Эта,Тета,Йота,Каппа,Лямбда,Мю", ",");
	Виды = СтрРазделить("сайт,бот,склад,отчёты", ",");
	Ведущие = СтрРазделить("Анна,Борис,Вера,Глеб,Дина,Егор,Жанна", ",");

	Результат = Новый Массив();
	Номер_ = 0;
	Для Каждого Вид Из Виды Цикл
		Для Каждого Имя Из Имена Цикл
			Результат.Добавить(Новый Структура("name, lead, members", Имя + "-" + Вид,
				Ведущие[Номер_ % Ведущие.Количество()], (Номер_ * 7) % 23 + 1));
			Номер_ = Номер_ + 1;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Отобрать(Знач Отбор)

	Подстрока = НРег(Отбор.Подстрока);
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("name");
	Таблица.Колонки.Добавить("members");
	Таблица.Колонки.Добавить("Запись");
	Для Каждого Проект Из Проекты() Цикл
		Если ПустаяСтрока(Подстрока) ИЛИ СтрНайти(НРег(Проект.name), Подстрока) > 0 Тогда
			Строка_ = Таблица.Добавить();
			Строка_.name = Проект.name;
			Строка_.members = Проект.members;
			Строка_.Запись = Проект;
		КонецЕсли;
	КонецЦикла;

	// второй ключ — имя: при равном числе участников порядок не прыгает между страницами
	Таблица.Сортировать(?(Отбор.Поле = "members", "members " + Направление(Отбор) + ", name",
		"name " + Направление(Отбор)));

	Результат = Новый Массив();
	Для Каждого Строка_ Из Таблица Цикл
		Результат.Добавить(Строка_.Запись);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Направление(Знач Отбор)
	Возврат ?(Отбор.Порядок = "desc", "убыв", "возр");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Пара(Знач Имя, Знач Значение)
	Если ПустаяСтрока(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Имя + "=" + КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL) + "&";
КонецФункции

Функция Номер(Знач Текст)
	Попытка
		Возврат Макс(1, Цел(Число(Текст)));
	Исключение
		Возврат 1;
	КонецПопытки;
КонецФункции

// Пробел GET-форма шлёт плюсом, а отбор ждёт строку как есть.
Функция Значение(Знач Откуда, Знач Имя)

	Если Откуда = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение_ = Откуда.Получить(Имя);
	Возврат ?(Значение_ = Неопределено, "", СокрЛП(СтрЗаменить(Строка(Значение_), "+", " ")));

КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "Кит") _Кит) Экспорт

	Каркас = _Каркас;
	Кит = _Кит;
	НаСтранице = 10;

КонецПроцедуры
