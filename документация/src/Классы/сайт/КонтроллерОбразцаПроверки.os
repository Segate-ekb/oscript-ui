// Образец проверки до отправки и тоста из ответа (выпуск 0.12): форма нового проекта,
// объявленная словами Длина, Шаблон, ТипЗначения("url" | "email"), Пределы,
// ПроверкаНаСервере. Сервер отвечает так, как ответило бы приложение: удача —
// перенаправлением обратно со строкой «сохранено» (страница печатает тост успеха), отказ —
// 400 и та же форма с отказами у полей и тостом ошибки (role="alert"). Адрес проверки имени
// отвечает 200 — свободно, 409 с текстом — занято. Состояния у образца нет: занятые имена
// постоянны, сохранённое несёт адрес, поэтому посетители публичного сайта друг другу
// ничего не оставляют.
//
// На этой странице гоняются браузерные прогоны tests/браузер/проверка-и-тост.js.

Перем Каркас;  // КаркасСтраницы
Перем Кит;     // Кит
Перем Формы;   // Формы

#Область Маршруты

&ТочкаМаршрута("образец-проверки")
Процедура Форма(Ответ, МетодЗапроса, КукиЗапроса, ПутьЗапроса, ПараметрыЗапросаИменные,
	ТелоЗапросаСоответствие) Экспорт

	Объявление = Объявление();

	Если ВРег(МетодЗапроса) <> "POST" Тогда
		Показать(Ответ, Объявление, Значение(ПараметрыЗапросаИменные, "сохранено"), Ложь,
			КукиЗапроса, ПутьЗапроса);
		Возврат;
	КонецЕсли;

	Итог = Объявление.Разобрать(Присланное(ТелоЗапросаСоответствие));
	Имя = Итог.Значения.Получить("name");
	// занятость видит только домен: без скрипта (и раньше ответа проверки) она приходит
	// отказом тем же путём, что и отказ формата
	Если Итог.Принято И ЗначениеЗаполнено(Занято(Имя)) Тогда
		Объявление.Отбить("name", Занято(Имя));
	ИначеЕсли Итог.Принято Тогда
		Перенаправить(Ответ, Имя);
		Возврат;
	КонецЕсли;

	Показать(Ответ, Объявление, "", Истина, КукиЗапроса, ПутьЗапроса, 400);

КонецПроцедуры

// Проверка имени до отправки: 200 — свободно, 409 и текст отказа — занято.
&ТочкаМаршрута("образец-проверки/имя")
Процедура Имя(Ответ, МетодЗапроса, КукиЗапроса, ПутьЗапроса, ПараметрыЗапросаИменные,
	ТелоЗапросаСоответствие) Экспорт

	Отказ = Занято(Значение(ПараметрыЗапросаИменные, "name"));
	Ответ.УстановитьТипКонтента("txt");
	Ответ.УстановитьСостояние(?(ЗначениеЗаполнено(Отказ), 409, 200));
	Ответ.ТелоТекст = Отказ;

КонецПроцедуры

#КонецОбласти

#Область Страница

// Объявление формы: одно на печать и на разбор, поэтому браузер, скрипт и сервер судят
// поле одними ограничениями и одними словами словаря.
Функция Объявление()

	Результат = Формы.Новая();
	Результат.Поле("name", "Имя проекта").Обязательное().Длина(2, 30).Шаблон("[a-z0-9\-]+")
			.ПроверкаНаСервере("/образец-проверки/имя").Подсказка("латиница, цифры и дефис; alpha и beta заняты")
		.Поле("site", "Сайт проекта").ТипЗначения("url").ПроверкаДоОтправки()
			.Пример("https://пример.рф")
		.Поле("mail", "Почта для писем").ТипЗначения("email").ПроверкаДоОтправки()
		.Поле("limit", "Участников, не больше").ТипЗначения(Тип("Число")).Пределы(1, 50)
			.ПроверкаДоОтправки();
	Возврат Результат;

КонецФункции

Процедура Показать(Ответ, Знач Объявление, Знач Сохранено, Знач Отбито, Знач КукиЗапроса,
	Знач ПутьЗапроса, Знач Код = 200)

	Ответ.УстановитьТипКонтента("html");
	Ответ.УстановитьСостояние(Код);
	Ответ.ТелоТекст = Каркас.Страница("Образец проверки", Содержимое(Объявление, Сохранено, Отбито),
		Каркас.КонтекстСтраницы(Неопределено, КукиЗапроса, Ложь, Ложь, ПутьЗапроса));

КонецПроцедуры

Функция Содержимое(Знач Объявление, Знач Сохранено, Знач Отбито)

	Форма = Кит.Форма("/образец-проверки",
			Кит.Готовое(Объявление.Тело()),
			Кит.Ряд("действия", Кит.Кнопка("Создать проект").Основная()))
		.Вид("столбик").БезПерезагрузки().Якорь("novyi-proekt");

	Возврат Кит.Холст(
		Кит.Заголовок(2, "Новый проект"),
		Кит.Примечание("Образец к страницам «Поле» и «Тост»: сервер этого сайта проверяет"
			+ " форму так же, как проверило бы приложение, и отвечает тостом."),
		Кит.Уведомление(СтрШаблон("Проект «%1» создан", Сохранено)).Когда(ЗначениеЗаполнено(Сохранено)),
		Кит.Уведомление("Проект не создан: поправьте поля, отмеченные ниже").Вид("err").Когда(Отбито),
		Форма).Токен("образец");

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Занятые имена постоянны: образцу нечего помнить между запросами.
Функция Занято(Знач Имя)

	Имя_ = СокрЛП(Строка(?(Имя = Неопределено, "", Имя)));
	Если Имя_ = "alpha" ИЛИ Имя_ = "beta" Тогда
		Возврат СтрШаблон("Имя «%1» уже занято — выберите другое", Имя_);
	КонецЕсли;
	Возврат "";

КонецФункции

// Тело формы: пробел форма шлёт плюсом, а разбор ждёт строки как есть.
Функция Присланное(Знач Тело)

	Результат = Новый Соответствие();
	Если Тело = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого КиЗ Из Тело Цикл
		Результат.Вставить(КиЗ.Ключ, СтрЗаменить(Строка(КиЗ.Значение), "+", " "));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Значение(Знач Откуда, Знач Имя)

	Если Откуда = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение_ = Откуда.Получить(Имя);
	Возврат ?(Значение_ = Неопределено, "", СокрЛП(СтрЗаменить(Строка(Значение_), "+", " ")));

КонецФункции

// Перенаправление после POST — 303: браузер идёт за ответом GET-ом и не повторяет отправку.
Процедура Перенаправить(Ответ, Знач Имя)

	Ответ.Перенаправить("/" + КодироватьСтроку("образец-проверки", СпособКодированияСтроки.КодировкаURL)
		+ "?" + КодироватьСтроку("сохранено", СпособКодированияСтроки.КодировкаURL)
		+ "=" + КодироватьСтроку(Имя, СпособКодированияСтроки.КодировкаURL));
	Ответ.УстановитьСостояние(303);

КонецПроцедуры

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "Формы") _Формы) Экспорт

	Каркас = _Каркас;
	Кит = _Кит;
	Формы = _Формы;

КонецПроцедуры
