// Страницы документации: «/» — обзор, «/ключ» — любая страница оглавления. Страница
// собирается каркасом кита — той же шапкой, меню и подвалом, что у любой инсталляции.

Перем Сайт;       // Документация
Перем Каркас;     // КаркасСтраницы
Перем ВыборВида;  // ВыборОформления
Перем Набор;      // НаборКомпонентов

&ТочкаМаршрута("/")
Процедура Обзор(Ответ, КукиЗапроса, ПутьЗапроса) Экспорт
	Показать(Ответ, "обзор", КукиЗапроса, ПутьЗапроса);
КонецПроцедуры

&ТочкаМаршрута("{страница}")
Процедура Страница(Ответ, страница, КукиЗапроса, ПутьЗапроса) Экспорт
	Показать(Ответ, Раскодированный(страница), КукиЗапроса, ПутьЗапроса);
КонецПроцедуры

Процедура Показать(Ответ, Знач Ключ, Знач КукиЗапроса, Знач ПутьЗапроса)

	Контекст = Каркас.КонтекстСтраницы(Неопределено, КукиЗапроса, Ложь, Ложь, ПутьЗапроса);
	Готовая = Сайт.Страница(Ключ, ВыборВида.ПоКукам(КукиЗапроса));

	Ответ.УстановитьТипКонтента("html");
	Если Готовая = Неопределено Тогда
		Ответ.УстановитьСостояниеНеНайдено();
		Ответ.ТелоТекст = Каркас.Страница("Не найдено", Набор.СтраницаОшибки().Отрисовать(
			Новый Структура("Код, Сообщение", 404,
				"Такой страницы нет. Раздел мог переехать — загляните на обзор.")), Контекст);
		Возврат;
	КонецЕсли;

	Ответ.ТелоТекст = Каркас.Страница(Готовая.Заголовок, Готовая.Содержимое, Контекст,
		Готовая.РазделыЭкрана);

КонецПроцедуры

Функция Раскодированный(Знач Значение)
	Попытка
		Возврат РаскодироватьСтроку(Строка(Значение), СпособКодированияСтроки.КодировкаURL);
	Исключение
		Возврат Строка(Значение);
	КонецПопытки;
КонецФункции

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "Документация") _Сайт,
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "ВыборОформления") _ВыборВида,
	&Пластилин(Значение = "НаборКомпонентов") _Набор) Экспорт

	Сайт = _Сайт;
	Каркас = _Каркас;
	ВыборВида = _ВыборВида;
	Набор = _Набор;

КонецПроцедуры
