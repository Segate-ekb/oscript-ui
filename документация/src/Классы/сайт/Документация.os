// Документация — желудь сайта: собирает движок из желудей кита и раскладывает страницу.
// Слева — разделы сайта, в середине — статья, справа — «На этой странице». На телефоне
// колонки уходят: разделы — в единое меню кита (РазделыЭкрана), оглавление прячется.

&Деталька(Значение = "документация.КаталогСтраниц", ЗначениеПоУмолчанию = "./страницы")
Перем КаталогСтраниц Экспорт;

Перем Набор;       // НаборКомпонентов
Перем Экран;       // ЭкранированиеHTML
Перем Состав;      // ОглавлениеДокументации
Перем Печатник;    // ПечатьДокументации

// Оглавление сайта.
//
// Возвращаемое значение:
//  ОглавлениеДокументации
//
Функция Оглавление() Экспорт
	Возврат Состав;
КонецФункции

// Страница сайта целиком: содержимое для каркаса и разделы экрана для единого меню.
//
// Параметры:
//  Ключ       - Строка - ключ страницы.
//  Оформление - Структура - оформление смотрящего.
//
// Возвращаемое значение:
//  Структура, Неопределено - Заголовок, Содержимое (HTML), РазделыЭкрана (Структура
//                            Заголовок, Разделы — см. КаркасСтраницы.Страница);
//                            Неопределено — такой страницы нет.
//
Функция Страница(Знач Ключ, Знач Оформление) Экспорт

	Лист = Состав.Страница(Ключ);
	Если Лист = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Напечатанная = Печатник.Напечатать(ТекстСтраницы(Лист.Ключ), Оформление);
	Заголовок = ?(ЗначениеЗаполнено(Напечатанная.Заголовок), Напечатанная.Заголовок, Лист.Заголовок);

	Содержимое = "<div class=""docs"">"
		+ Навигация(Лист)
		+ "<article class=""docs__main"">"
		+ Набор.ЗаголовокСтраницы().Отрисовать(Новый Структура("Заголовок, Пояснение",
			Заголовок, Напечатанная.Пояснение))
		+ "<div class=""docs__body prose"">" + Напечатанная.Тело + "</div>"
		+ Соседи(Лист)
		+ "</article>"
		+ НаЭтойСтранице(Напечатанная.Разделы)
		+ "</div>";

	Возврат Новый Структура("Заголовок, Содержимое, РазделыЭкрана",
		Заголовок, Содержимое, РазделыЭкрана(Лист));

КонецФункции

// Текст страницы из каталога страниц.
//
// Параметры:
//  Ключ - Строка - ключ страницы.
//
// Возвращаемое значение:
//  Строка - markdown; страница, которой ещё нет на диске, — заглушка с заголовком.
//
Функция ТекстСтраницы(Знач Ключ) Экспорт

	Путь = ОбъединитьПути(КаталогСтраниц, Ключ + ".md");
	Если НЕ Новый Файл(Путь).Существует() Тогда
		Лист = Состав.Страница(Ключ);
		Возврат "# " + ?(Лист = Неопределено, Ключ, Лист.Заголовок) + Символы.ПС + Символы.ПС
			+ "Страница ещё пишется.";
	КонецЕсли;

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

// Печать markdown документации — для тех, кому нужна страница без раскладки сайта.
//
// Возвращаемое значение:
//  ПечатьДокументации
//
Функция Печать() Экспорт
	Возврат Печатник;
КонецФункции

#Область Раскладка

Функция Навигация(Знач Текущий)

	Части = "";
	Для Каждого Раздел Из Состав.Разделы() Цикл
		Пункты = Новый Массив();
		Для Каждого Лист Из Раздел.Страницы Цикл
			Пункты.Добавить(Новый Структура("Подпись, Адрес, Активен",
				Лист.Заголовок, Состав.Адрес(Лист.Ключ), Лист.Ключ = Текущий.Ключ));
		КонецЦикла;
		Части = Части + СтрШаблон("<p class=""docs__group"">%1</p>", Экран.Экранировать(Раздел.Заголовок))
			+ Набор.ДеревоРазделов().Отрисовать(Новый Структура("Заголовок, Разделы, Ориентация",
				Раздел.Заголовок, Пункты, "вертикаль"));
	КонецЦикла;

	Возврат "<nav class=""docs__nav"" aria-label=""Разделы документации"">" + Части + "</nav>";

КонецФункции

Функция НаЭтойСтранице(Знач Разделы)

	Если Разделы.Количество() < 2 Тогда
		Возврат "<aside class=""docs__toc""></aside>";
	КонецЕсли;

	Пункты = "";
	Для Каждого Раздел Из Разделы Цикл
		Пункты = Пункты + СтрШаблон("<li><a href=""#%1"">%2</a></li>",
			Экран.Экранировать(Раздел.Ид), Экран.Экранировать(Раздел.Подпись));
	КонецЦикла;

	Возврат "<aside class=""docs__toc"" aria-label=""На этой странице"">"
		+ "<p class=""docs__toc-title"">На этой странице</p><ul>" + Пункты + "</ul></aside>";

КонецФункции

Функция Соседи(Знач Лист)

	Пара = Состав.Соседи(Лист.Ключ);
	Возврат "<nav class=""docs__pager"" aria-label=""Соседние страницы"">"
		+ Сосед(Пара.Назад, "Назад", "docs__pager-link--prev")
		+ Сосед(Пара.Дальше, "Дальше", "docs__pager-link--next")
		+ "</nav>";

КонецФункции

Функция Сосед(Знач Лист, Знач Направление, Знач Класс)

	Если Лист = Неопределено Тогда
		Возврат "<span></span>";
	КонецЕсли;
	Возврат СтрШаблон("<a class=""docs__pager-link %1"" href=""%2""><span class=""docs__pager-dir"">%3</span>"
		+ "<span class=""docs__pager-title"">%4</span></a>",
		Класс, Экран.Экранировать(Состав.Адрес(Лист.Ключ)), Направление,
		Экран.Экранировать(Лист.Заголовок));

КонецФункции

// Разделы экрана для единого меню на телефоне: страницы текущего раздела под его именем —
// первой группой шторки.
Функция РазделыЭкрана(Знач Текущий)

	Результат = Новый Массив();
	Заголовок = "";
	Для Каждого Раздел Из Состав.Разделы() Цикл
		Если Раздел.Ключ <> Текущий.Раздел Тогда
			Продолжить;
		КонецЕсли;
		Заголовок = Раздел.Заголовок;
		Для Каждого Лист Из Раздел.Страницы Цикл
			Результат.Добавить(Новый Структура("Подпись, Адрес, Активен",
				Лист.Заголовок, Состав.Адрес(Лист.Ключ), Лист.Ключ = Текущий.Ключ));
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("Заголовок, Разделы", Заголовок, Результат);

КонецФункции

#КонецОбласти

&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "НаборКомпонентов") _Набор,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "Формы") _Формы,
	&Пластилин(Значение = "РендерерНастроек") _Настройки,
	&Пластилин(Значение = "ЭкранированиеHTML") _Экран,
	&Пластилин(Значение = "ТокеныТемы") _Токены,
	&Пластилин(Значение = "НаборИконок") _Глифы,
	&Пластилин(Значение = "Иконка") _Значки,
	&Пластилин(Значение = "РазметкаЭлементов") _Разметка,
	&Пластилин(Значение = "РаскладкаСтатики") _Раскладка) Экспорт

	Набор = _Набор;
	Экран = _Экран;
	Состав = Новый ОглавлениеДокументации();
	Печатник = Новый ПечатьДокументации(_Экран, _Набор,
		Новый ИсполнениеОбразца(_Набор, _Кит, _Формы, _Настройки),
		Новый СправкаКомпонента(_Раскладка),
		Новый ДирективыДокументации(_Экран, _Токены, _Глифы, _Значки, _Разметка, _Набор, Состав));

КонецПроцедуры
