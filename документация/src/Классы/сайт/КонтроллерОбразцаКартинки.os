// Образец слота картинки и образца с сервером (выпуск 0.12): логотип, который загружают
// и возвращают к стандартному, и шапка сайта, которая меняется по мере ввода. Сервер
// отвечает так, как ответило бы приложение: загрузка и сохранение — перенаправлением
// обратно, сброс без подтверждения — страницей с окном подтверждения, напечатанным
// открытым. Файл сервер не хранит: в адресе остаются только имя и размер (?файл=…,
// ?размер=…), поэтому посетители публичного сайта друг другу ничего не оставляют.
//
// На этой странице гоняются браузерные прогоны tests/браузер/картинка-и-образец.js.

Перем Каркас;  // КаркасСтраницы
Перем Кит;     // Кит
Перем Токены;  // ТокеныТемы — проверка цвета акцента

#Область Маршруты

&ТочкаМаршрута("образец-картинки")
Процедура Страница(Ответ, МетодЗапроса, КукиЗапроса, ПутьЗапроса, ПараметрыЗапросаИменные,
	ДанныеФормы) Экспорт

	Состояние = СостояниеИзАдреса(ПараметрыЗапросаИменные);

	Если ВРег(МетодЗапроса) = "POST" Тогда
		Состояние.Итог = "";
		Состояние.Сброс = "";
		Файл = Неопределено;
		Если ДанныеФормы <> Неопределено И ДанныеФормы.Количество() > 0 Тогда
			Файл = ДанныеФормы.НайтиДанныеПоМетаданным(Новый Структура("name", "logo"));
		КонецЕсли;
		Имя = ИмяФайла(Файл);
		Если ЗначениеЗаполнено(Имя) Тогда
			Состояние.Файл = Имя;
			Состояние.Размер = Формат(?(Файл.Значение = Неопределено, 0, Файл.Значение.Размер()), "ЧН=0; ЧГ=0");
			Состояние.Итог = "загружено";
		КонецЕсли;
		Перенаправить(Ответ, Состояние);
		Возврат;
	КонецЕсли;

	Показать(Ответ, Состояние, КукиЗапроса, ПутьЗапроса);

КонецПроцедуры

// Сброс спрашивает подтверждение. Без скрипта форма приходит без поля подтверждения —
// сервер отвечает перенаправлением на страницу, где окно сброса напечатано открытым.
&ТочкаМаршрута("образец-картинки/сброс")
Процедура Сброс(Ответ, МетодЗапроса, ПараметрыЗапросаИменные, ТелоЗапросаСоответствие) Экспорт

	Состояние = СостояниеИзАдреса(ПараметрыЗапросаИменные);
	Состояние.Итог = "";
	Состояние.Сброс = "";
	Если ВРег(МетодЗапроса) = "POST" Тогда
		Если ЗначениеЗаполнено(Значение(ТелоЗапросаСоответствие, "confirmed")) Тогда
			Состояние.Файл = "";
			Состояние.Размер = "";
			Состояние.Итог = "сброшено";
		Иначе
			Состояние.Сброс = "1";
		КонецЕсли;
	КонецЕсли;
	Перенаправить(Ответ, Состояние);

КонецПроцедуры

&ТочкаМаршрута("образец-картинки/шапка")
Процедура Шапка(Ответ, МетодЗапроса, ПараметрыЗапросаИменные, ТелоЗапросаСоответствие) Экспорт

	Состояние = СостояниеИзАдреса(ПараметрыЗапросаИменные);
	Состояние.Итог = "";
	Состояние.Сброс = "";
	Если ВРег(МетодЗапроса) = "POST" Тогда
		Состояние.Название = Значение(ТелоЗапросаСоответствие, "title");
		Состояние.Акцент = Значение(ТелоЗапросаСоответствие, "accent");
		Состояние.Итог = "сохранено";
	КонецЕсли;
	Перенаправить(Ответ, Состояние);

КонецПроцедуры

#КонецОбласти

#Область Страница

Процедура Показать(Ответ, Знач Состояние, Знач КукиЗапроса, Знач ПутьЗапроса)

	Ответ.УстановитьТипКонтента("html");
	Ответ.УстановитьСостояние(200);
	Ответ.ТелоТекст = Каркас.Страница("Образец картинки", Содержимое(Состояние),
		Каркас.КонтекстСтраницы(Неопределено, КукиЗапроса, Ложь, Ложь, ПутьЗапроса));

КонецПроцедуры

Функция Содержимое(Знач Состояние)

	Название = ?(ЗначениеЗаполнено(Состояние.Название), Состояние.Название, "Ромашка");
	Акцент = Токены.БезопасныйЦвет(Состояние.Акцент);

	Шапка = Кит.Образец("Шапка сайта",
			Кит.Область(
				Кит.Заголовок(3, Название).Зеркало("title"),
				Кит.Примечание("Проекты, участники, сборки")).Зеркало("accent", Акцент))
		.Якорь("obrazec-shapki");

	Форма = Кит.Форма(Адрес("/образец-картинки/шапка", Состояние, "Название, Акцент"),
			Кит.Поле("title", "Название сайта").Значение(Название).Ид("shapka-title"),
			// поле вида «цвет» (выпуск 0.12): пустое значение — «по умолчанию», и зеркало
			// снимает свойство --mirror-accent: лист берёт свой акцент
			Кит.Поле("accent", "Акцент").Ид("shapka-accent").Значение(Акцент)
				.Образец(Токены.АкцентПоУмолчанию(), "Фиолетовый").Образец("#1a73e8", "Синий")
				.Образец("#188038", "Зелёный").Образец("#b3261e", "Красный"),
			Кит.Кнопка("Сохранить").Основная())
		.Вид("столбик").БезПерезагрузки().Якорь("forma-shapki");

	Возврат Кит.Холст(
		Кит.Заголовок(2, "Картинка и образец"),
		Кит.Примечание("Образец к страницам «Слот картинки» и «Образец»: сервер этого сайта"
			+ " отвечает на формы так же, как ответило бы приложение, но файл не хранит —"
			+ " в адресе остаются только его имя и размер."),
		Уведомление(Состояние),
		Кит.Заголовок(3, "Логотип"),
		Слот(Состояние),
		Кит.Заголовок(3, "Шапка"),
		Кит.Область(Кит.Область(Форма).Вид("работа"), Шапка).Вид("студия")).Токен("образец");

КонецФункции

// Загруженная картинка — заглушка той же формы (файл сервер не хранит), стандартная —
// знак образца. Обе — встроенные SVG, в <img> они скрипта не исполняют.
Функция Слот(Знач Состояние)

	Слот = Кит.СлотКартинки("logo", "Логотип").Принимает("image/png,image/svg+xml,image/webp")
		.Форма(Адрес("/образец-картинки", Состояние, "Файл, Размер")).Якорь("slot-logo");

	Если НЕ ЗначениеЗаполнено(Состояние.Файл) Тогда
		Возврат Слот.Адрес(Картинка("#79747e", "?"));
	КонецЕсли;

	Возврат Слот.Адрес(Картинка("#6750a4", ВРег(Лев(Состояние.Файл, 1))))
		.Состояние(СтрШаблон("%1 · %2", Состояние.Файл, Размер(Состояние.Размер)))
		.Сброс(Адрес("/образец-картинки/сброс", Состояние, ""))
		.Открыто(Состояние.Сброс = "1");

КонецФункции

Функция Уведомление(Знач Состояние)

	Если Состояние.Итог = "загружено" Тогда
		Возврат Кит.Уведомление(СтрШаблон("Логотип «%1» загружен", Состояние.Файл));
	ИначеЕсли Состояние.Итог = "сброшено" Тогда
		Возврат Кит.Уведомление("Вернулся стандартный логотип");
	ИначеЕсли Состояние.Итог = "сохранено" Тогда
		Возврат Кит.Уведомление("Шапка сохранена");
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция Картинка(Знач Цвет, Знач Буква)

	Svg = СтрШаблон("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'>"
		+ "<rect x='8' y='8' width='48' height='48' rx='12' fill='%1'/>"
		+ "<text x='32' y='42' font-family='sans-serif' font-size='26' text-anchor='middle'"
		+ " fill='white'>%2</text></svg>", Цвет, ?(СтрНайти("<>&'""", Буква) > 0, "?", Буква));
	Возврат "data:image/svg+xml," + КодироватьСтроку(Svg, СпособКодированияСтроки.КодировкаURL);

КонецФункции

Функция Размер(Знач Байт)

	Число_ = 0;
	Попытка
		Число_ = Число(Байт);
	Исключение
		Число_ = 0;
	КонецПопытки;
	Если Число_ < 1024 Тогда
		Возврат Формат(Число_, "ЧН=0; ЧГ=0") + " Б";
	КонецЕсли;
	Возврат Формат(Окр(Число_ / 1024), "ЧН=0; ЧГ=0") + " КБ";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СостояниеИзАдреса(Знач Параметры)

	Возврат Новый Структура("Файл, Размер, Название, Акцент, Сброс, Итог",
		Значение(Параметры, "файл"), Значение(Параметры, "размер"),
		Значение(Параметры, "название"), Значение(Параметры, "акцент"),
		Значение(Параметры, "сброс"), Значение(Параметры, "итог"));

КонецФункции

// Имя загруженного файла — из заголовка части формы; путь, который присылают старые
// браузеры, отрезается.
Функция ИмяФайла(Знач Файл)

	Если Файл = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	// разбор заголовков части формы у серверов winow разный: имя файла ищется в любом из них
	Имя = "";
	Для Каждого КиЗ Из Файл.Метаданные Цикл
		Если ТипЗнч(КиЗ.Значение) = Тип("Соответствие") И КиЗ.Значение.Получить("filename") <> Неопределено Тогда
			Имя = Строка(КиЗ.Значение.Получить("filename"));
		КонецЕсли;
	КонецЦикла;
	Имя = СтрЗаменить(Имя, "\", "/");
	Части = СтрРазделить(Имя, "/", Ложь);
	Возврат ?(Части.Количество() = 0, "", Лев(Части[Части.ВГраница()], 80));

КонецФункции

// Значение поля формы или параметра адреса: пробел форма шлёт плюсом.
Функция Значение(Знач Откуда, Знач Имя)

	Если Откуда = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение_ = Откуда.Получить(Имя);
	Возврат ?(Значение_ = Неопределено, "", СокрЛП(СтрЗаменить(Строка(Значение_), "+", " ")));

КонецФункции

// Адрес формы несёт состояние страницы, кроме полей, которые форма меняет сама.
Функция Адрес(Знач Путь, Знач Состояние, Знач Кроме)

	Пропустить = СтрРазделить(СтрЗаменить(Кроме, " ", ""), ",", Ложь);
	Пары = Новый Массив();
	Для Каждого Поле Из СтрРазделить("Файл,Размер,Название,Акцент", ",") Цикл
		Если Пропустить.Найти(Поле) = Неопределено И ЗначениеЗаполнено(Состояние[Поле]) Тогда
			Пары.Добавить(Закодировать(НРег(Поле)) + "=" + Закодировать(Состояние[Поле]));
		КонецЕсли;
	КонецЦикла;
	Возврат Путь + ?(Пары.Количество() > 0, "?" + СтрСоединить(Пары, "&"), "");

КонецФункции

// Перенаправление после POST — 303: браузер идёт за ответом GET-ом и не повторяет отправку.
Процедура Перенаправить(Ответ, Знач Состояние)

	Адрес = Адрес("/образец-картинки", Состояние, "");
	Если ЗначениеЗаполнено(Состояние.Сброс) Тогда
		Адрес = Адрес + ?(СтрНайти(Адрес, "?") > 0, "&", "?") + Закодировать("сброс") + "=1";
	КонецЕсли;
	Если ЗначениеЗаполнено(Состояние.Итог) Тогда
		Адрес = Адрес + ?(СтрНайти(Адрес, "?") > 0, "&", "?") + Закодировать("итог") + "="
			+ Закодировать(Состояние.Итог);
	КонецЕсли;
	Ответ.Перенаправить(СтрЗаменить(Адрес, "/образец-картинки", "/" + Закодировать("образец-картинки")));
	Ответ.УстановитьСостояние(303);

КонецПроцедуры

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "ТокеныТемы") _Токены) Экспорт

	Каркас = _Каркас;
	Кит = _Кит;
	Токены = _Токены;

КонецПроцедуры
