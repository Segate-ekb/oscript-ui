// Образец окон с сервером: список проектов, окно «Новый проект», окно правки по адресу
// и подтверждение удаления. Сервер отвечает так, как ответило бы приложение: удача —
// перенаправлением обратно на список (новая запись помечена фокусом), отказ — 400 и та же
// страница с окном, напечатанным открытым, и подсказкой у поля. Состояния у образца нет:
// что добавлено и удалено, несёт адрес (?добавлено=…, ?удалено=…), поэтому посетители
// публичного сайта друг другу ничего не оставляют.
//
// На этой странице гоняются браузерные прогоны tests/браузер/окна.js.

Перем Каркас;  // КаркасСтраницы
Перем Кит;     // Кит

#Область Маршруты

&ТочкаМаршрута("образец-окон")
Процедура Список(Ответ, МетодЗапроса, КукиЗапроса, ПутьЗапроса, ПараметрыЗапросаИменные,
	ТелоЗапросаСоответствие) Экспорт

	Состояние = СостояниеИзАдреса(ПараметрыЗапросаИменные);

	Если ВРег(МетодЗапроса) = "POST" Тогда
		Имя = Значение(ТелоЗапросаСоответствие, "name");
		Если СтрДлина(Имя) < 2 Тогда
			Состояние.Окно = "новый";
			Состояние.Введено = Имя;
			Состояние.Отказ = "Название — от двух букв";
			Показать(Ответ, Состояние, КукиЗапроса, ПутьЗапроса, 400);
			Возврат;
		КонецЕсли;
		Перенаправить(Ответ, "/образец-окон", "добавлено", Имя);
		Возврат;
	КонецЕсли;

	Показать(Ответ, Состояние, КукиЗапроса, ПутьЗапроса);

КонецПроцедуры

&ТочкаМаршрута("образец-окон/правка")
Процедура Правка(Ответ, МетодЗапроса, КукиЗапроса, ПутьЗапроса, ПараметрыЗапросаИменные,
	ТелоЗапросаСоответствие) Экспорт

	Если ВРег(МетодЗапроса) <> "POST" Тогда
		Перенаправить(Ответ, "/образец-окон");
		Возврат;
	КонецЕсли;

	Было = Значение(ТелоЗапросаСоответствие, "project");
	Стало = Значение(ТелоЗапросаСоответствие, "name");
	Если СтрДлина(Стало) < 2 Тогда
		Состояние = СостояниеИзАдреса(Неопределено);
		Состояние.Окно = "правка";
		Состояние.Проект = Было;
		Состояние.Введено = Стало;
		Состояние.Отказ = "Название — от двух букв";
		Показать(Ответ, Состояние, КукиЗапроса, ПутьЗапроса, 400);
		Возврат;
	КонецЕсли;

	Перенаправить(Ответ, "/образец-окон", "добавлено", Стало, "удалено", Было);

КонецПроцедуры

// Удаление спрашивает подтверждение. Без скрипта форма приходит без поля подтверждения —
// сервер отправляет на GET того же адреса, и там страница печатает подтверждение открытым.
&ТочкаМаршрута("образец-окон/удалить")
Процедура Удалить(Ответ, МетодЗапроса, КукиЗапроса, ПутьЗапроса, ПараметрыЗапросаИменные,
	ТелоЗапросаСоответствие) Экспорт

	Состояние = СостояниеИзАдреса(ПараметрыЗапросаИменные);

	Если ВРег(МетодЗапроса) <> "POST" Тогда
		Состояние.Удаление = Значение(ПараметрыЗапросаИменные, "project");
		Показать(Ответ, Состояние, КукиЗапроса, ПутьЗапроса);
		Возврат;
	КонецЕсли;

	Проект = Значение(ТелоЗапросаСоответствие, "project");
	Если НЕ ЗначениеЗаполнено(Значение(ТелоЗапросаСоответствие, "confirmed")) Тогда
		Перенаправить(Ответ, "/образец-окон/удалить", "project", Проект);
		Возврат;
	КонецЕсли;

	Если Значение(ТелоЗапросаСоответствие, "name") <> Проект Тогда
		Состояние.Удаление = Проект;
		Состояние.Отказ = "Название не совпало — проект не удалён";
		Показать(Ответ, Состояние, КукиЗапроса, ПутьЗапроса, 400);
		Возврат;
	КонецЕсли;

	Перенаправить(Ответ, "/образец-окон", "удалено", Проект);

КонецПроцедуры

#КонецОбласти

#Область Страница

Процедура Показать(Ответ, Знач Состояние, Знач КукиЗапроса, Знач ПутьЗапроса, Знач Код = 200)

	Ответ.УстановитьТипКонтента("html");
	Ответ.УстановитьСостояние(Код);
	Ответ.ТелоТекст = Каркас.Страница("Образец окон", Содержимое(Состояние),
		Каркас.КонтекстСтраницы(Неопределено, КукиЗапроса, Ложь, Ложь, ПутьЗапроса));

КонецПроцедуры

Функция Содержимое(Знач Состояние)

	Новый_ = Кит.Окно("Новый проект",
			Кит.Поле("name", "Название").Обязательное().Значение(Состояние.Введено)
				.Ошибка(?(Состояние.Окно = "новый", Состояние.Отказ, "")).Ид("novyi-proekt-name"))
		.Лид("Проект появится в списке сразу.")
		.Форма("/образец-окон").БезПерезагрузки().Якорь("novyi-proekt")
		.Открыто(Состояние.Окно = "новый")
		.Действия(Кит.Кнопка("Создать").Основная());

	Таблица = Кит.Таблица(Кит.Колонка("Проект"), Кит.Колонка("Действия").Вид("узкая"));
	Номер = 0;
	Для Каждого Имя Из Проекты(Состояние) Цикл
		Номер = Номер + 1;
		Таблица.Добавить(Запись(Имя, Номер, Состояние));
	КонецЦикла;

	Холст = Кит.Холст(
		Кит.Заголовок(2, "Проекты"),
		Кит.Примечание("Образец к страницам «Окно» и «Подтверждение»: сервер этого сайта"
			+ " отвечает на формы так же, как ответило бы приложение."),
		Уведомление(Состояние),
		Кит.Ряд("справа", Кит.Кнопка("Новый проект").Основная().Иконка("плюс").Открывает(Новый_)),
		Таблица,
		Новый_,
		ОкноПравки(Состояние)).Токен("образец");

	Возврат Холст;

КонецФункции

Функция Запись(Знач Имя, Знач Номер, Знач Состояние)

	Подтверждение = Кит.Подтверждение(СтрШаблон("Удалить проект «%1»?", Имя),
			"Проект и его ключи пропадут навсегда. Вернуть их будет нельзя.")
		.Эхо("name", Имя).Кнопка("Удалить").Якорь("udalit-" + Формат(Номер, "ЧГ=0"))
		.Открыто(Состояние.Удаление = Имя)
		.Ошибка(?(Состояние.Удаление = Имя, Состояние.Отказ, ""));

	Удаление = Кит.Форма("/образец-окон/удалить", Кит.СкрытоеПоле("project", Имя),
			Кит.Кнопка("Удалить").Опасная().Малая())
		.БезПерезагрузки().СПодтверждением(Подтверждение);

	Результат = Кит.Запись(
		Кит.Ячейка(Имя),
		Кит.Ячейка(Кит.Ряд("действия",
			Кит.ОкноПоАдресу("/образец-окон?окно=правка&project=" + Закодировать(Имя), "Переименовать")
				.Малая().Иконка("карандаш"),
			Удаление, Подтверждение)));

	Если Имя = Состояние.Добавлено Тогда
		Результат.Фокус();
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ОкноПравки(Знач Состояние)

	Если Состояние.Окно <> "правка" ИЛИ НЕ ЗначениеЗаполнено(Состояние.Проект) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Кит.Окно(СтрШаблон("Переименовать «%1»", Состояние.Проект),
			Кит.СкрытоеПоле("project", Состояние.Проект),
			Кит.Поле("name", "Новое название").Обязательное().Ид("pravka-name")
				.Значение(?(ЗначениеЗаполнено(Состояние.Отказ), Состояние.Введено, Состояние.Проект))
				.Ошибка(Состояние.Отказ))
		.Форма("/образец-окон/правка").БезПерезагрузки().Якорь("pravka").Открыто()
		.Действия(Кит.Кнопка("Сохранить").Основная());

КонецФункции

Функция Уведомление(Знач Состояние)

	Если ЗначениеЗаполнено(Состояние.Добавлено) Тогда
		Возврат Кит.Уведомление(СтрШаблон("Проект «%1» в списке", Состояние.Добавлено));
	ИначеЕсли ЗначениеЗаполнено(Состояние.Удалено) Тогда
		Возврат Кит.Уведомление(СтрШаблон("Проект «%1» удалён", Состояние.Удалено));
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Список — три проекта образца без удалённого и с добавленным; проект, который удаляют
// или правят, в списке остаётся, даже если его добавили только что.
Функция Проекты(Знач Состояние)

	Результат = Новый Массив();
	Для Каждого Имя Из СтрРазделить("Альфа,Бета,Гамма", ",") Цикл
		Если Имя <> Состояние.Удалено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Имя Из СтрРазделить(Состояние.Добавлено + "|" + Состояние.Удаление + "|"
		+ Состояние.Проект, "|", Ложь) Цикл
		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СостояниеИзАдреса(Знач Параметры)

	Возврат Новый Структура("Добавлено, Удалено, Окно, Проект, Удаление, Введено, Отказ",
		Значение(Параметры, "добавлено"), Значение(Параметры, "удалено"),
		Значение(Параметры, "окно"), Значение(Параметры, "project"), "", "", "");

КонецФункции

// Значение поля формы или параметра адреса: пробел форма шлёт плюсом.
Функция Значение(Знач Откуда, Знач Имя)

	Если Откуда = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение_ = Откуда.Получить(Имя);
	Возврат ?(Значение_ = Неопределено, "", СокрЛП(СтрЗаменить(Строка(Значение_), "+", " ")));

КонецФункции

// Перенаправление после POST — 303: браузер идёт за ответом GET-ом и не повторяет отправку.
Процедура Перенаправить(Ответ, Знач Путь, Знач Имя1 = "", Знач Значение1 = "",
	Знач Имя2 = "", Знач Значение2 = "")

	Пары = Новый Массив();
	Если ЗначениеЗаполнено(Значение1) Тогда
		Пары.Добавить(Закодировать(Имя1) + "=" + Закодировать(Значение1));
	КонецЕсли;
	Если ЗначениеЗаполнено(Значение2) Тогда
		Пары.Добавить(Закодировать(Имя2) + "=" + Закодировать(Значение2));
	КонецЕсли;

	Адрес = "/" + Закодировать(Сред(Путь, 2));
	Адрес = СтрЗаменить(Адрес, "%2F", "/");
	Ответ.Перенаправить(Адрес + ?(Пары.Количество() > 0, "?" + СтрСоединить(Пары, "&"), ""));
	Ответ.УстановитьСостояние(303);

КонецПроцедуры

Функция Закодировать(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "Кит") _Кит) Экспорт

	Каркас = _Каркас;
	Кит = _Кит;

КонецПроцедуры
