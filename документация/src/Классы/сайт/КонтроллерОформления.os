// Оформление посетителя: тема и акцент живут в cookie кита. Форма переключателя темы
// в шапке и форма выбора акцента на странице «Цвет и тема» отправляются сюда; после
// записи cookie посетитель возвращается туда, откуда пришёл.

Перем ВыборВида;  // ВыборОформления
Перем Токены;     // ТокеныТемы

&ТочкаМаршрута("тема")
Процедура Тема(Ответ, МетодЗапроса, КукиЗапроса, ЗаголовкиЗапроса) Экспорт

	Если ВРег(МетодЗапроса) = "POST" Тогда
		Оформление = ВыборВида.ПоКукам(КукиЗапроса);
		Новая = ВыборВида.ПротивоположнаяТема(Токены.АтрибутТемы(Оформление));
		Текущее = КукиЗапроса.ПолучитьЗначениеПоИмени(ВыборВида.ИмяCookie());
		ВыборВида.ЗаписатьКуку(Ответ, ВыборВида.ЗначениеCookieСТемой(Текущее, Новая));
	КонецЕсли;
	Ответ.Перенаправить(АдресВозврата(ЗаголовкиЗапроса));

КонецПроцедуры

&ТочкаМаршрута("акцент")
Процедура Акцент(Ответ, МетодЗапроса, КукиЗапроса, ЗаголовкиЗапроса, ТелоЗапросаСоответствие) Экспорт

	Если ВРег(МетодЗапроса) = "POST" Тогда
		Оформление = ВыборВида.ПоКукам(КукиЗапроса);
		Цвет = "";
		Если ТелоЗапросаСоответствие <> Неопределено Тогда
			Цвет = Токены.БезопасныйЦвет(ТелоЗапросаСоответствие.Получить("акцент"));
			Если ТелоЗапросаСоответствие.Получить("сброс") <> Неопределено Тогда
				Цвет = "";
			КонецЕсли;
		КонецЕсли;
		Пары = Новый Массив();
		Пары.Добавить("тема=" + ?(Токены.АтрибутТемы(Оформление) = "light", "светлая", "тёмная"));
		Если ЗначениеЗаполнено(Цвет) Тогда
			Пары.Добавить("акцент=" + Цвет);
		КонецЕсли;
		ВыборВида.ЗаписатьКуку(Ответ, СтрСоединить(Пары, "&"));
	КонецЕсли;
	Ответ.Перенаправить(АдресВозврата(ЗаголовкиЗапроса));

КонецПроцедуры

// Возврат — путь из Referer своего же сайта; чужой адрес или его отсутствие ведут на обзор.
Функция АдресВозврата(Знач ЗаголовкиЗапроса)

	Если ЗаголовкиЗапроса = Неопределено Тогда
		Возврат "/";
	КонецЕсли;
	Откуда = Заголовок(ЗаголовкиЗапроса, "Referer");
	Хост = Заголовок(ЗаголовкиЗапроса, "Host");
	Если НЕ ЗначениеЗаполнено(Откуда) ИЛИ НЕ ЗначениеЗаполнено(Хост) Тогда
		Возврат "/";
	КонецЕсли;

	Начало = СтрНайти(Откуда, "://");
	Если Начало = 0 Тогда
		Возврат "/";
	КонецЕсли;
	Остаток = Сред(Откуда, Начало + 3);
	Косая = СтрНайти(Остаток, "/");
	Если Косая = 0 ИЛИ Лев(Остаток, Косая - 1) <> Хост Тогда
		Возврат "/";
	КонецЕсли;
	Возврат Сред(Остаток, Косая);

КонецФункции

// Имя заголовка HTTP регистра не различает, а HTTP/2 за прокси приносит его строчными:
// «referer», а не «Referer».
Функция Заголовок(Знач Заголовки, Знач Имя)
	Для Каждого КиЗ Из Заголовки Цикл
		Если НРег(КиЗ.Ключ) = НРег(Имя) Тогда
			Возврат Строка(КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&Контроллер("/оформление")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "ВыборОформления") _ВыборВида,
	&Пластилин(Значение = "ТокеныТемы") _Токены) Экспорт

	ВыборВида = _ВыборВида;
	Токены = _Токены;

КонецПроцедуры
