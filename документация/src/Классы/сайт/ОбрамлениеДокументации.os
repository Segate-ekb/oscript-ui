// Обрамление сайта документации — своя реализация контракта кита «ОбрамлениеИнсталляции».
// Так поступает любое приложение на ките: знак, верхние дороги, подпись подвала, свой лист
// и скрипт, адрес переключателя темы. Единое меню (МенюХаба) заполнено: на телефоне
// дороги, разделы текущего экрана и тема уезжают в шторку.

Перем Активы;  // АктивыСтатики
Перем Сайт;    // Документация

Функция Обрамление(Знач Контекст) Экспорт

	Текущий = ТекущийРаздел(Контекст);
	Дороги = Дороги(Текущий);

	Результат = Новый Структура();
	Результат.Вставить("Язык", "ru");
	Результат.Вставить("Знак", "oscript-ui");
	Результат.Вставить("Подпись", "oscript-ui · UI-кит на OneScript в облике Material Design 3 · MIT."
		+ " Этот сайт собран самим китом.");
	Результат.Вставить("ПолитикаПерехода", "strict-origin-when-cross-origin");
	Результат.Вставить("АдресСтилей", Активы.Адрес("документация.css"));
	Результат.Вставить("АдресСкрипта", Активы.Адрес("документация.js"));
	Знак = Активы.Адрес("знак.svg");
	Иконки = Новый Массив();
	Иконки.Добавить(Новый Структура("Отношение, Тип, Размеры, Адрес", "icon", "image/svg+xml", "any", Знак));
	Результат.Вставить("Иконки", Иконки);
	Результат.Вставить("Знамя", Новый Структура("Адрес, Ширина, Название", Знак, 28, Истина));
	Результат.Вставить("Разделы", Дороги);
	Результат.Вставить("Приватные", Новый Массив());
	Результат.Вставить("Аккаунт", "");
	Результат.Вставить("МенюУчётки", Неопределено);
	Результат.Вставить("МенюХаба", Новый Структура("Навигация", Дороги));
	Результат.Вставить("Адреса", Новый Структура("Корень, Вход, Кабинет, Выход, Оформление",
		"/", "", "", "", "/оформление/тема"));
	Возврат Результат;

КонецФункции

// Верхние дороги — крупные части документации; активна та, к которой относится страница.
Функция Дороги(Знач Текущий)

	Результат = Новый Массив();
	Для Каждого Дорога Из ОписаниеДорог() Цикл
		Результат.Добавить(Новый Структура("Подпись, Адрес, Иконка, Активен",
			Дорога.Подпись, Дорога.Адрес, Дорога.Иконка,
			СтрРазделить(Дорога.Разделы, ",").Найти(Текущий) <> Неопределено));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОписаниеДорог()

	Результат = Новый Массив();
	Результат.Добавить(Дорога("Начало", "/", "куб", "начало"));
	Результат.Добавить(Дорога("Основы", "/цвет", "палочка", "основы"));
	Результат.Добавить(Дорога("Компоненты", "/кнопка", "стопка", "действия,ввод,показ,навигация,отклик"));
	Результат.Добавить(Дорога("Холст", "/холст", "пакет", "холст"));
	Результат.Добавить(Дорога("Приложение", "/каркас-страницы", "шестерёнка", "приложение"));
	Возврат Результат;

КонецФункции

Функция Дорога(Знач Подпись, Знач Адрес, Знач Иконка, Знач Разделы)
	Возврат Новый Структура("Подпись, Адрес, Иконка, Разделы", Подпись, Адрес, Иконка, Разделы);
КонецФункции

Функция ТекущийРаздел(Знач Контекст)

	Путь = "";
	Если ТипЗнч(Контекст) = Тип("Структура") И Контекст.Свойство("Путь") Тогда
		Путь = Контекст.Путь;
	КонецЕсли;
	Попытка
		Путь = РаскодироватьСтроку(Строка(Путь), СпособКодированияСтроки.КодировкаURL);
	Исключение
		Путь = Строка(Путь);
	КонецПопытки;

	Ключ = СокрЛП(СтрЗаменить(Путь, "/", ""));
	Лист = Сайт.Оглавление().Страница(?(ЗначениеЗаполнено(Ключ), Ключ, "обзор"));
	Возврат ?(Лист = Неопределено, "", Лист.Раздел);

КонецФункции

&Верховный
&Прозвище("ОбрамлениеИнсталляции")
&Желудь
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "АктивыСтатики") _Активы,
	&Пластилин(Значение = "Документация") _Сайт) Экспорт

	Активы = _Активы;
	Сайт = _Сайт;

КонецПроцедуры
