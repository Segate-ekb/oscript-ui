// Образец дерева галок на тысячу пунктов (выпуск 0.13, шаг 23): шесть проектов и 440
// участников. Сервер отвечает так, как ответило бы приложение: адрес веток — страницей
// участников проекта (по 50), адрес поиска — страницей с ответом поиска, форма — разбором
// правок (со скриптом) или галок (без него) и перенаправлением обратно со сводкой того,
// что пришло. Состояния у образца нет: что пришло, несёт адрес (?пришло=…), поэтому
// посетители публичного сайта друг другу ничего не оставляют.
//
// На этой странице гоняются браузерные прогоны tests/браузер/дерево-галок.js.

Перем Каркас;  // КаркасСтраницы
Перем Кит;     // Кит
Перем Набор;   // НаборКомпонентов — разбор правок дерева

#Область Маршруты

&ТочкаМаршрута("образец-дерева")
Процедура Выбор(Ответ, МетодЗапроса, КукиЗапроса, ПутьЗапроса, ПараметрыЗапросаИменные,
	ТелоЗапроса) Экспорт

	Если ВРег(МетодЗапроса) = "POST" Тогда
		Перенаправить(Ответ, "образец-дерева", "пришло", Пришло(Строка(ТелоЗапроса)));
		Возврат;
	КонецЕсли;

	Показать(Ответ, "Образец дерева галок", Экран(Дерево(), Значение(ПараметрыЗапросаИменные, "пришло")),
		КукиЗапроса, ПутьЗапроса);

КонецПроцедуры

// Адрес веток: страница участников проекта. Скрипт берёт из неё список ветки, а без
// скрипта человек видит её страницей — со ссылкой на следующую.
&ТочкаМаршрута("образец-дерева/ветка")
Процедура Ветка(Ответ, МетодЗапроса, КукиЗапроса, ПутьЗапроса, ПараметрыЗапросаИменные) Экспорт

	Проект = Проект(Значение(ПараметрыЗапросаИменные, "ветка"));
	Если Проект = Неопределено Тогда
		Показать(Ответ, "Нет такого проекта", Кит.Холст(Кит.Заголовок(2, "Нет такого проекта"),
			Кит.Ссылка("/образец-дерева", "Вернуться к выбору")), КукиЗапроса, ПутьЗапроса, 404);
		Возврат;
	КонецЕсли;

	Номер = Макс(1, ЧислоИз(Значение(ПараметрыЗапросаИменные, "страница")));
	Размер = Набор.ДеревоГалок().РазмерСтраницы();
	Страница = Кит.ДеревоГалок(Участники(Проект, (Номер - 1) * Размер + 1, Номер * Размер))
		.Подпись(Проект.Подпись).Адрес(АдресВеток()).Ветка(Проект.Ключ, Номер, Проект.Всего);

	Показать(Ответ, "Участники проекта " + Проект.Подпись, Кит.Холст(
			Кит.Заголовок(2, СтрШаблон("Участники проекта «%1»", Проект.Подпись)),
			Страница,
			Кит.Ссылка("/образец-дерева", "Вернуться к выбору")),
		КукиЗапроса, ПутьЗапроса);

КонецПроцедуры

// Адрес поиска: со скриптом — GET ?найти=…, без него — отправка формы кнопкой «Найти»
// (POST, строка поиска в теле). Отвечает тем же экраном, где на месте веток — ответ поиска.
&ТочкаМаршрута("образец-дерева/поиск")
Процедура Поиск(Ответ, МетодЗапроса, КукиЗапроса, ПутьЗапроса, ПараметрыЗапросаИменные,
	ТелоЗапросаСоответствие) Экспорт

	Запрос = Значение(ПараметрыЗапросаИменные, "найти");
	Если НЕ ЗначениеЗаполнено(Запрос) Тогда
		Запрос = Значение(ТелоЗапросаСоответствие, "найти");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Запрос) Тогда
		Перенаправить(Ответ, "образец-дерева");
		Возврат;
	КонецЕсли;

	Совпадения = Совпадения(Запрос);
	Ответ_ = Кит.ДеревоГалок(Совпадения).Подпись("Найденные участники").Поиск(АдресПоиска())
		.ТолькоПравки().Найдено(Запрос, Совпадения.Количество());
	Показать(Ответ, "Образец дерева галок: поиск", Экран(Ответ_, ""), КукиЗапроса, ПутьЗапроса);

КонецПроцедуры

#КонецОбласти

#Область Страница

Процедура Показать(Ответ, Знач Заголовок, Знач Содержимое, Знач КукиЗапроса, Знач ПутьЗапроса,
	Знач Код = 200)

	Ответ.УстановитьТипКонтента("html");
	Ответ.УстановитьСостояние(Код);
	Ответ.ТелоТекст = Каркас.Страница(Заголовок, Содержимое,
		Каркас.КонтекстСтраницы(Неопределено, КукиЗапроса, Ложь, Ложь, ПутьЗапроса));

КонецПроцедуры

Функция Экран(Знач Дерево, Знач Пришло)

	Форма = Кит.Форма("/образец-дерева", Дерево,
			Кит.Ряд("действия", Кит.Кнопка("Сохранить выбор").Основная()))
		.Вид("столбик").БезПерезагрузки().Якорь("vybor-uchastnikov");

	Возврат Кит.Холст(
		Кит.Заголовок(2, "Кто работает в проектах"),
		Кит.Примечание("Образец к странице «Дерево галок»: шесть проектов, 440 участников."
			+ " Ветка показывает первые 50, остальные приезжают по «Показать ещё»; поиск"
			+ " спрашивает сервер; форма отдаёт только правки."),
		Кит.Уведомление("Пришло: " + Пришло).Когда(ЗначениеЗаполнено(Пришло)),
		Форма).Токен("образец");

КонецФункции

Функция Дерево()

	Узлы = Новый Массив();
	Для Каждого Проект Из Проекты() Цикл
		Узел = Новый Структура("Имя, Подпись, Пояснение, Состояние, Всего", Проект.Ключ, Проект.Подпись,
			СтрШаблон("%1 участников", Число_(Проект.Всего)), Проект.Состояние, Проект.Всего);
		// одна ветка приезжает без детей: они придут, когда её раскроют
		Если Проект.Ключ <> "gamma" Тогда
			Узел.Вставить("Дети", Участники(Проект, 1, Проект.Всего));
		КонецЕсли;
		Узлы.Добавить(Узел);
	КонецЦикла;

	Возврат Кит.ДеревоГалок(Узлы).Подпись("Участники проектов")
		.Адрес(АдресВеток()).Поиск(АдресПоиска()).Режимы().ТолькоПравки();

КонецФункции

#КонецОбласти

#Область Данные

// Проекты образца: ключ латиницей — по нему сервер узнаёт ветку в адресе и в правках.
Функция Проекты()

	Результат = Новый Массив();
	Результат.Добавить(НовыйПроект("alpha", "Альфа", 140, "частично"));
	Результат.Добавить(НовыйПроект("beta", "Бета", 90, "частично"));
	Результат.Добавить(НовыйПроект("gamma", "Гамма", 75, "частично"));
	Результат.Добавить(НовыйПроект("delta", "Дельта", 60, "частично"));
	Результат.Добавить(НовыйПроект("epsilon", "Эпсилон", 45, "выкл"));
	Результат.Добавить(НовыйПроект("zeta", "Зета", 30, "вкл"));
	Возврат Результат;

КонецФункции

Функция НовыйПроект(Знач Ключ, Знач Подпись, Знач Всего, Знач Состояние)
	Возврат Новый Структура("Ключ, Подпись, Всего, Состояние", Ключ, Подпись, Всего, Состояние);
КонецФункции

Функция Проект(Знач Ключ)

	Для Каждого Проект Из Проекты() Цикл
		Если Проект.Ключ = Ключ Тогда
			Возврат Проект;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Участники проекта с номерами Первый…Последний. Имена постоянны: имя и фамилия
// берутся по номеру, отмечен каждый, чей номер не делится на три (в ветках «все»
// и «никакие» — все или никто).
Функция Участники(Знач Проект, Знач Первый, Знач Последний)

	Имена = СтрРазделить("Анна,Борис,Вера,Глеб,Дарья,Егор,Жанна,Захар,Ирина,Кирилл,Лидия,Матвей,"
		+ "Нина,Олег,Полина,Роман,Софья,Тимур,Ульяна,Фёдор", ",");
	Фамилии = СтрРазделить("Белых,Черных,Седых,Шевчук,Ковальчук,Петренко,Бондаренко,Гордиенко,"
		+ "Мельник,Кравец,Лысенко,Руденко,Ткаченко,Савчук,Левченко,Павлюк,Марченко,Гуменюк,"
		+ "Остапчук,Яковенко,Дорош,Шульга,Коваль", ",");
	Сдвиг = СтрДлина(Проект.Ключ) * 11;

	Результат = Новый Массив();
	Для Номер = Первый По Мин(Последний, Проект.Всего) Цикл
		Состояние = ?(Проект.Состояние = "частично", ?(Номер % 3 = 0, "выкл", "вкл"), Проект.Состояние);
		Результат.Добавить(Новый Структура("Имя, Подпись, Состояние",
			Проект.Ключ + "-" + Формат(Номер, "ЧЦ=3; ЧВН=; ЧГ=0"),
			Имена[(Номер + Сдвиг) % Имена.Количество()] + " " + Фамилии[(Номер * 7 + Сдвиг) % Фамилии.Количество()],
			Состояние));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Совпадения(Знач Запрос)

	Искомое = НРег(СокрЛП(Запрос));
	Результат = Новый Массив();
	Для Каждого Проект Из Проекты() Цикл
		Для Каждого Участник Из Участники(Проект, 1, Проект.Всего) Цикл
			Если СтрНайти(НРег(Участник.Подпись), Искомое) > 0 Тогда
				// в ответе поиска участник стоит вне своей ветки — проект говорит приписка
				Участник.Вставить("Пояснение", Проект.Подпись);
				Результат.Добавить(Участник);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сводка того, что пришло с формой: правки (со скриптом) или галки (без него).
Функция Пришло(Знач Тело)

	Итог = Набор.ДеревоГалок().РазобратьПравки(Тело);
	Режимы = Новый Массив();
	Для Каждого КиЗ Из Итог.Режимы Цикл
		Режимы.Добавить(КиЗ.Ключ + " — " + КиЗ.Значение);
	КонецЦикла;

	Если Итог.Правки Тогда
		Части = Новый Массив();
		Если Итог.Включить.Количество() > 0 Тогда
			Части.Добавить("включить " + СтрСоединить(Итог.Включить, ", "));
		КонецЕсли;
		Если Итог.Снять.Количество() > 0 Тогда
			Части.Добавить("снять " + СтрСоединить(Итог.Снять, ", "));
		КонецЕсли;
		Если Режимы.Количество() > 0 Тогда
			Части.Добавить("режим " + СтрСоединить(Режимы, ", "));
		КонецЕсли;
		Возврат "правки: " + ?(Части.Количество() = 0, "ничего не изменилось", СтрСоединить(Части, "; "));
	КонецЕсли;

	// без скрипта пришли галки показанных узлов: имя участника — «проект-номер»
	Отмечено = 0;
	Найденные = "";
	Для Каждого Пара Из СтрРазделить(Тело, "&", Ложь) Цикл
		Имя = РаскодироватьСтроку(Лев(Пара, СтрНайти(Пара + "=", "=") - 1), СпособКодированияСтроки.КодировкаURL);
		Если СтрНайти(Имя, "-") > 0 И СтрНайти(Имя, ":") = 0 Тогда
			Отмечено = Отмечено + 1;
		ИначеЕсли Имя = "найденные" Тогда
			Найденные = РаскодироватьСтроку(Сред(Пара, СтрНайти(Пара, "=") + 1), СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрШаблон("галки: отмечено %1%2%3", Число_(Отмечено),
		?(Режимы.Количество() = 0, "", "; режимы " + СтрСоединить(Режимы, ", ")),
		?(ЗначениеЗаполнено(Найденные), "; найденные — " + Найденные, ""));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АдресВеток()
	Возврат "/образец-дерева/ветка";
КонецФункции

Функция АдресПоиска()
	Возврат "/образец-дерева/поиск";
КонецФункции

Функция Значение(Знач Откуда, Знач Имя)

	Если Откуда = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Значение_ = Откуда.Получить(Имя);
	Возврат ?(Значение_ = Неопределено, "", СокрЛП(СтрЗаменить(Строка(Значение_), "+", " ")));

КонецФункции

Функция ЧислоИз(Знач Текст)

	Попытка
		Возврат Цел(Число(Текст));
	Исключение
		Возврат 0;
	КонецПопытки;

КонецФункции

Функция Число_(Знач Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

// Перенаправление после POST — 303: браузер идёт за ответом GET-ом и не повторяет отправку.
// Адрес — путь без ведущей косой черты.
Процедура Перенаправить(Ответ, Знач Адрес, Знач Имя = "", Знач Значение_ = "")

	Хвост = ?(ЗначениеЗаполнено(Имя), "?" + КодироватьСтроку(Имя, СпособКодированияСтроки.КодировкаURL)
		+ "=" + КодироватьСтроку(Значение_, СпособКодированияСтроки.КодировкаURL), "");
	Ответ.Перенаправить("/" + КодироватьСтроку(Адрес, СпособКодированияСтроки.КодировкаURL) + Хвост);
	Ответ.УстановитьСостояние(303);

КонецПроцедуры

#КонецОбласти

&Контроллер("/")
Процедура ПриСозданииОбъекта(
	&Пластилин(Значение = "КаркасСтраницы") _Каркас,
	&Пластилин(Значение = "Кит") _Кит,
	&Пластилин(Значение = "НаборКомпонентов") _Набор) Экспорт

	Каркас = _Каркас;
	Кит = _Кит;
	Набор = _Набор;

КонецПроцедуры
