// Статика: базовый лист и скрипт кита, глифы, лист и скрипт документации — по адресам
// с отпечатком содержимого. Белый список ведёт АктивыСтатики: имя не из списка — 404 до
// обращения к диску.

Перем Активы; // АктивыСтатики

&ТочкаМаршрута("{файл}")
Процедура Отдать(Ответ, файл, ЗаголовкиЗапроса) Экспорт

	ТипКонтента = Активы.ТипКонтента(файл);
	Если ТипКонтента = Неопределено Тогда
		// Образцы страниц пишут адрес знака без отпечатка («/static/знак.svg»): код под
		// образцом должен читаться, а отпечаток меняется с содержимым. Имя из раскладки
		// уводит на адрес с отпечатком временно — навсегда кэшируется только он.
		Если ЗначениеЗаполнено(Активы.Адрес(файл)) Тогда
			Ответ.Перенаправить(Активы.БазовыйПуть() + "/"
				+ КодироватьСтроку(Активы.ПубличноеИмя(файл), СпособКодированияСтроки.КодировкаURL));
			Ответ.УстановитьСостояние(302);
			Возврат;
		КонецЕсли;
		Ответ.УстановитьСостояниеНеНайдено();
		Возврат;
	КонецЕсли;

	// адрес — функция содержимого, поэтому файл кэшируется навсегда
	Ответ.Заголовки["Cache-Control"] = "public, max-age=31536000, immutable";
	Метка = Активы.ETag(файл);
	Если ЗначениеЗаполнено(Метка) Тогда
		Ответ.Заголовки["ETag"] = Метка;
		Если ЗаголовкиЗапроса <> Неопределено И ЗаголовокБезРегистра(ЗаголовкиЗапроса, "If-None-Match") = Метка Тогда
			Ответ.УстановитьСостояние(304);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Ответ.УстановитьСостояниеОК();
	Ответ.Заголовки["Content-Type"] = ТипКонтента;
	Ответ.УстановитьТелоИзФайла(Активы.ПутьНаДиске(файл));

КонецПроцедуры

// Имя заголовка HTTP регистра не различает, а HTTP/2 за прокси приносит его строчными.
Функция ЗаголовокБезРегистра(Знач Заголовки, Знач Имя)
	Для Каждого КиЗ Из Заголовки Цикл
		Если НРег(КиЗ.Ключ) = НРег(Имя) Тогда
			Возврат Строка(КиЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&Контроллер("/static")
Процедура ПриСозданииОбъекта(&Пластилин(Значение = "АктивыСтатики") _Активы) Экспорт
	Активы = _Активы;
КонецПроцедуры
