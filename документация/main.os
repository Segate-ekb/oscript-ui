// Документация oscript-ui — точка входа мини-приложения на winow.
//
//   cd документация
//   opm install -l              — winow, ОСень, oscript-md в ./oscript_modules
//   oscript main.os             — сайт на http://localhost:3333
//   oscript main.os --порт 8080
//
// Кит подключается из рабочего дерева репозитория: правка компонента видна в документации
// после перезапуска, без сборки пакета.

#Использовать autumn
#Использовать winow
#Использовать oscript-md
// кит — до Новый Поделка: желудём становится только тип, известный к сборке контейнера
#Использовать ".."

Функция Ключ(Знач Имя, Знач ПоУмолчанию)

	Аргументы = АргументыКоманднойСтроки;
	Для Индекс = 0 По Аргументы.Количество() - 2 Цикл
		Если НРег(Аргументы[Индекс]) = Имя Тогда
			Возврат Аргументы[Индекс + 1];
		КонецЕсли;
	КонецЦикла;
	Возврат ПоУмолчанию;

КонецФункции

КаталогПроекта = Новый Файл(ТекущийСценарий().Источник).Путь;

Детальки = Новый Соответствие();
Детальки.Вставить("winow.Порт", Число(Ключ("--порт", "3333")));
// классы сайта и движка лежат в src рядом с точкой входа: winow подключает их сам
Детальки.Вставить("winow.КаталогСПриложениями", ОбъединитьПути(КаталогПроекта, "src"));
Детальки.Вставить("winow.ИспользоватьПрикладнойСервер", Ложь);
Детальки.Вставить("winow.АвтоСтарт", Ложь);
// каталог страниц документации — для желудя «Документация»
Детальки.Вставить("документация.КаталогСтраниц", ОбъединитьПути(КаталогПроекта, "страницы"));
Детальки.Вставить("документация.КаталогСтатики", ОбъединитьПути(КаталогПроекта, "статика"));

Совет = Новый СоветДругогоМастера();
Совет.ПолучитьСтроительМенеджераПараметров().ДобавитьПровайдерСоответствие(Детальки, 3, "документация");

Поделка = Новый Поделка(Совет);
Поделка.ЗапуститьПриложение();

Сообщить(СтрШаблон("Документация oscript-ui: http://localhost:%1/", Детальки.Получить("winow.Порт")));

// блокирующий вызов: сервер работает, пока процесс не остановят
Поделка.НайтиЖелудь("ВебСервер").Старт();
