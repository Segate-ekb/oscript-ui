// Слова дев-сборки 0.13.0-dev.7: пробелы кита, которые записали треки волны 3 (окно
// подписки, замечания к превью 2). Проверяется то, что ломается для человека: подпись
// сегмента рвётся посреди слова, окно по адресу без скрипта лежит под соседней секцией,
// образец не меняет вид по выбору, а узлы без новых слов печатаются иначе, чем до сборки.

#Использовать "../"
#Использовать asserts

Перем Кит;    // Кит
Перем Набор;  // НаборКомпонентов
Перем Разбор; // РазборЛиста — сканер, читающий КОД листа
Перем ПравилаЛиста; // правила базового листа, разобранные однажды

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "РазборЛиста.os"), "РазборЛиста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Кит = Слой.Кит;
	Набор = Слой.Набор;
	Разбор = Новый РазборЛиста();

КонецПроцедуры

#Область СекцияСоСпискомКарточекНаТелефоне

// Слово владельца к превью 3: на телефоне карточки объектов сетки внутри секции стали плоскими
// полосами с чертами. Плоской становится внешняя карточка или секция со сеткой (списком)
// карточек объектов, а карточки внутри — карточками, как на широком экране. Только там, где
// движок понимает :has(): без него — прежний вид dev.5.
&Тест
Процедура СекцияСоСпискомКарточекПлоскаяАКарточкиВНейКарточки() Экспорт

	Условия = "@media (max-width: 600px) @supports selector(:has(*))";

	Внешние = СтрРазделить(".card:has(> .card__body > .grid .objcard);"
		+ ".card:has(> .card__body > .objcard-list > .objcard);"
		+ ".section:has(> .section__body > .grid .objcard);"
		+ ".section:has(> .section__body > .objcard-list > .objcard)", ";");
	Для Каждого Селектор Из Внешние Цикл
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "box-shadow", Условия), Селектор + ": без кольца и тени").Равно("none");
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "background", Условия), Селектор + ": без заливки").Равно("transparent");
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "padding-left", Условия), Селектор + ": без левого поля").Равно("0");
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "padding-right", Условия), Селектор + ": без правого поля").Равно("0");
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "box-shadow", "@media (max-width: 600px)"),
			Селектор + ": без :has() правила нет").Равно(Неопределено);
	КонецЦикла;

	Внутренние = СтрРазделить(".card .grid > .grid__cell > .objcard;.section .grid > .grid__cell > .objcard;"
		+ ".card .objcard-list > .objcard;.section .objcard-list > .objcard", ";");
	Для Каждого Селектор Из Внутренние Цикл
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "box-shadow", Условия), Селектор + ": кольцо карточки")
			.Равно(ОбъявлениеЛиста(".objcard", "box-shadow"));
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "background", Условия), Селектор + ": заливка карточки")
			.Равно(ОбъявлениеЛиста(".objcard", "background"));
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "border-radius", Условия), Селектор + ": скругление 16")
			.Равно("var(--md-sys-shape-corner-large)");
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "padding", Условия), Селектор + ": поля карточки")
			.Равно(ОбъявлениеЛиста(".objcard", "padding"));
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "border-top", Условия), Селектор + ": без черты").Равно("0");
	КонецЦикла;
	Ожидаем.Что(ОбъявлениеЛиста(".objcard", "box-shadow"), "кольцо карточки объекта — кольцо уровня 1")
		.Равно("var(--elevation-ring-level1)");
	Ожидаем.Что(ОбъявлениеЛиста(".objcard", "background"), "заливка — поверхность карточки").Равно("var(--surface-card)");

	// внутренние правила сильнее правила dev.5, которое делает вложенное плоским
	Ожидаем.Что(ОбъявлениеЛиста(".section .objcard", "box-shadow", "@media (max-width: 600px)"),
		"одиночная вложенная карточка объекта — по-прежнему часть родителя").Равно("none");
	Ожидаем.Что(ОбъявлениеЛиста(".section .card", "box-shadow", "@media (max-width: 600px)"),
		"вложенная карточка — по-прежнему часть родителя").Равно("none");

	// разметка карточки с сеткой та же: правила держатся за .card > .card__body > .grid
	Ячейка = Кит.Статья(Кит.Примечание("отчёты").Вид("описание")).Вид("карточка");
	HTML = Кит.Карточка("Недавно обновлённые", Кит.Сетка(Ячейка).Колонки(3)).Рендер();
	Ожидаем.Что(СтрНайти(HTML, "<div class=""card__body""><div class=""grid") > 0, HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<div class=""grid__cell""><article class=""objcard"">") > 0, HTML).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПодписьСегментаНаТелефоне

// Регрессия dev.5: на телефоне колонка сегмента была равной долей пилюли, и однословная
// подпись, которой доли не хватало, рвалась посреди слова (overflow-wrap: break-word).
// Теперь нижний предел колонки — самое длинное слово, остаток — поровну, и перенос только
// между словами.
&Тест
Процедура ПодписьСегментаНаТелефонеНеРвётсяПосредиСлова() Экспорт

	// у самой группы есть правило с соседним комбинатором (источник перед группой), его
	// каскад разбора не оценивает — объявления группы берутся по точному селектору
	Телефон = "@media (max-width: 600px)";
	Ожидаем.Что(ОбъявлениеЛиста(".segments", "display", Телефон), "на телефоне — сетка").Равно("grid");
	Ожидаем.Что(ОбъявлениеЛиста(".segments", "grid-auto-columns", Телефон),
		"колонка не уже самого длинного слова, остаток поровну").Равно("minmax(min-content, 1fr)");
	Ожидаем.Что(ОбъявлениеЛиста(".segments", "width", Телефон), "во всю ширину").Равно("100%");

	Цепочка = Новый Массив();
	Цепочка.Добавить(Разбор.Узел("div", "segments"));
	Цепочка.Добавить(Разбор.Узел("label", "segments__item"));
	Цепочка.Добавить(Разбор.Узел("span", "segments__label"));
	Цепочка.Добавить(Разбор.Узел("span", "segments__text"));
	Итог = Разбор.Каскад(Цепочка, 390, "white-space,overflow-wrap,word-break,hyphens");
	Ожидаем.Что(Итог.Получить("white-space"), "подпись переносится между словами").Равно("normal");
	Ожидаем.Что(Итог.Получить("overflow-wrap"), "слово не рвётся").Равно("normal");
	Ожидаем.Что(Итог.Получить("word-break"), "word-break не рвёт слово").Равно(Неопределено);
	Ожидаем.Что(Итог.Получить("hyphens"), "без переносов по слогам").Равно(Неопределено);

	// на широком экране — прежняя пилюля по содержимому с многоточием
	Итог = Разбор.Каскад(Цепочка, 1280, "white-space,text-overflow");
	Ожидаем.Что(Итог.Получить("white-space"), "1280: в одну строку").Равно("nowrap");
	Ожидаем.Что(Итог.Получить("text-overflow"), "1280: многоточие").Равно("ellipsis");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Значение свойства у правила базового листа с ровно этим селектором под ровно этими
// условиями; из нескольких побеждает последнее, как в каскаде. Нет — Неопределено.
Функция ОбъявлениеЛиста(Знач Селектор, Знач Свойство, Знач Условия = "")

	Результат = Неопределено;
	Если ПравилаЛиста = Неопределено Тогда
		ПравилаЛиста = Разбор.Правила(Разбор.ТекстБазовогоЛиста());
	КонецЕсли;
	Для Каждого Правило Из ПравилаЛиста Цикл
		Если Правило.Селектор = Селектор И Правило.Условия = Условия Тогда
			Значение = Правило.Объявления.Получить(Свойство);
			Если Значение <> Неопределено Тогда
				Результат = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
