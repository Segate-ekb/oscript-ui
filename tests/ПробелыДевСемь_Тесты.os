// Слова дев-сборки 0.13.0-dev.7: пробелы кита, которые записали треки волны 3 (окно
// подписки, замечания к превью 2). Проверяется то, что ломается для человека: подпись
// сегмента рвётся посреди слова, окно по адресу без скрипта лежит под соседней секцией,
// образец не меняет вид по выбору, а узлы без новых слов печатаются иначе, чем до сборки.

#Использовать "../"
#Использовать asserts

Перем Кит;    // Кит
Перем Набор;  // НаборКомпонентов
Перем Разбор; // РазборЛиста — сканер, читающий КОД листа
Перем ПравилаЛиста; // правила базового листа, разобранные однажды

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "РазборЛиста.os"), "РазборЛиста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Кит = Слой.Кит;
	Набор = Слой.Набор;
	Разбор = Новый РазборЛиста();

КонецПроцедуры

#Область СекцияСоСпискомКарточекНаТелефоне

// Слово владельца к превью 3: на телефоне карточки объектов сетки внутри секции стали плоскими
// полосами с чертами. Плоской становится внешняя карточка или секция со сеткой (списком)
// карточек объектов, а карточки внутри — карточками, как на широком экране. Только там, где
// движок понимает :has(): без него — прежний вид dev.5.
&Тест
Процедура СекцияСоСпискомКарточекПлоскаяАКарточкиВНейКарточки() Экспорт

	Условия = "@media (max-width: 600px) @supports selector(:has(*))";

	Внешние = СтрРазделить(".card:has(> .card__body > .grid .objcard);"
		+ ".card:has(> .card__body > .objcard-list > .objcard);"
		+ ".section:has(> .section__body > .grid .objcard);"
		+ ".section:has(> .section__body > .objcard-list > .objcard)", ";");
	Для Каждого Селектор Из Внешние Цикл
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "box-shadow", Условия), Селектор + ": без кольца и тени").Равно("none");
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "background", Условия), Селектор + ": без заливки").Равно("transparent");
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "padding-left", Условия), Селектор + ": без левого поля").Равно("0");
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "padding-right", Условия), Селектор + ": без правого поля").Равно("0");
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "box-shadow", "@media (max-width: 600px)"),
			Селектор + ": без :has() правила нет").Равно(Неопределено);
	КонецЦикла;

	Внутренние = СтрРазделить(".card .grid > .grid__cell > .objcard;.section .grid > .grid__cell > .objcard;"
		+ ".card .objcard-list > .objcard;.section .objcard-list > .objcard", ";");
	Для Каждого Селектор Из Внутренние Цикл
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "box-shadow", Условия), Селектор + ": кольцо карточки")
			.Равно(ОбъявлениеЛиста(".objcard", "box-shadow"));
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "background", Условия), Селектор + ": заливка карточки")
			.Равно(ОбъявлениеЛиста(".objcard", "background"));
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "border-radius", Условия), Селектор + ": скругление 16")
			.Равно("var(--md-sys-shape-corner-large)");
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "padding", Условия), Селектор + ": поля карточки")
			.Равно(ОбъявлениеЛиста(".objcard", "padding"));
		Ожидаем.Что(ОбъявлениеЛиста(Селектор, "border-top", Условия), Селектор + ": без черты").Равно("0");
	КонецЦикла;
	Ожидаем.Что(ОбъявлениеЛиста(".objcard", "box-shadow"), "кольцо карточки объекта — кольцо уровня 1")
		.Равно("var(--elevation-ring-level1)");
	Ожидаем.Что(ОбъявлениеЛиста(".objcard", "background"), "заливка — поверхность карточки").Равно("var(--surface-card)");

	// внутренние правила сильнее правила dev.5, которое делает вложенное плоским
	Ожидаем.Что(ОбъявлениеЛиста(".section .objcard", "box-shadow", "@media (max-width: 600px)"),
		"одиночная вложенная карточка объекта — по-прежнему часть родителя").Равно("none");
	Ожидаем.Что(ОбъявлениеЛиста(".section .card", "box-shadow", "@media (max-width: 600px)"),
		"вложенная карточка — по-прежнему часть родителя").Равно("none");

	// разметка карточки с сеткой та же: правила держатся за .card > .card__body > .grid
	Ячейка = Кит.Статья(Кит.Примечание("отчёты").Вид("описание")).Вид("карточка");
	HTML = Кит.Карточка("Недавно обновлённые", Кит.Сетка(Ячейка).Колонки(3)).Рендер();
	Ожидаем.Что(СтрНайти(HTML, "<div class=""card__body""><div class=""grid") > 0, HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<div class=""grid__cell""><article class=""objcard"">") > 0, HTML).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ОкноБезСкрипта

// Окно, напечатанное открытым без скрипта, не модальное. Было: position: absolute и
// z-index: auto — секция или запись ниже рисовалась поверх и забирала щелчок в поле. Теперь
// оно закреплено по центру экрана выше шапки, с подложкой и ловушкой щелчка мимо окна, а
// замка прокрутки нет: страница под окном прокручивается.
&Тест
Процедура ОкноБезСкриптаВВерхнемСлоеСтраницы() Экспорт

	Окно = ".modal[open]:not(:modal)";
	Ожидаем.Что(ОбъявлениеЛиста(Окно, "position"), "окно закреплено на экране").Равно("fixed");
	Ожидаем.Что(ОбъявлениеЛиста(Окно, "inset"), "растянуто на экран для центрирования").Равно("0");
	Ожидаем.Что(ОбъявлениеЛиста(Окно, "margin"), "по центру, как модальное").Равно(ОбъявлениеЛиста(".modal:modal", "margin"));
	Слой = Число(ОбъявлениеЛиста(Окно, "z-index"));
	Ожидаем.Что(Слой > Число(ОбъявлениеЛиста(".top", "z-index")), "выше шапки").ЭтоИстина();
	Ожидаем.Что(Слой < Число(ОбъявлениеЛиста(".window-error", "z-index")), "ниже тоста ошибки окна").ЭтоИстина();
	Ожидаем.Что(ОбъявлениеЛиста(Окно, "overflow"), "длинное окно прокручивается само").Равно("auto");
	Ожидаем.Что(СтрНайти(ОбъявлениеЛиста(Окно, "box-shadow"), "0 0 0 100vmax") > 0,
		"подложка — тень со спредом во весь экран").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОбъявлениеЛиста(Окно, "box-shadow"), "var(--md-sys-color-scrim) 32%") > 0,
		"подложка — скрим Material, как ::backdrop").ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОбъявлениеЛиста(".modal::backdrop", "background"), "var(--md-sys-color-scrim) 32%") > 0,
		"тот же скрим у модального").ЭтоИстина();

	Ловушка = Окно + "::before";
	Ожидаем.Что(ОбъявлениеЛиста(Ловушка, "content"), "ловушка щелчка мимо окна").Равно("""""");
	Ожидаем.Что(ОбъявлениеЛиста(Ловушка, "position"), "ловушка — во весь экран").Равно("fixed");
	Ожидаем.Что(ОбъявлениеЛиста(Ловушка, "inset"), "ловушка — во весь экран").Равно("0");
	Ожидаем.Что(ОбъявлениеЛиста(Ловушка, "z-index"), "ловушка — под содержимым окна").Равно("-1");
	Ожидаем.Что(ОбъявлениеЛиста(Ловушка, "background"), "ловушка прозрачная: окно не перекрашивает").Равно(Неопределено);

	// конечное состояние появления не зависит от :modal
	Ожидаем.Что(ОбъявлениеЛиста(".modal[open]", "opacity"), "появление доходит до конца").Равно("1");
	Ожидаем.Что(ОбъявлениеЛиста(".modal[open]", "transform"), "без уменьшения в конце").Равно("none");

	// замка прокрутки без скрипта нет: ни одно правило про открытое окно не трогает overflow страницы
	Для Каждого Правило Из Правила() Цикл
		Если СтрНайти(Правило.Селектор, "modal") > 0
			И (СтрНачинаетсяС(Правило.Селектор, "html") ИЛИ СтрНачинаетсяС(Правило.Селектор, "body")
				ИЛИ СтрНачинаетсяС(Правило.Селектор, ":root")) Тогда
			Ожидаем.Что(Правило.Объявления.Получить("overflow"), "замок прокрутки: " + Правило.Селектор).Равно(Неопределено);
		КонецЕсли;
	КонецЦикла;

	// разметка окна не меняется: открытое окно печатается тем же <dialog open>
	HTML = Кит.Холст(Кит.Окно("Переименовать", Кит.Поле("name", "Название")).Открыто().Якорь("w")).Рендер();
	Ожидаем.Что(СтрНачинаетсяС(HTML, "<dialog class=""modal"" id=""w"" aria-labelledby=""w-title"" open>"), HTML).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ЗеркалоПризнаком

// Значение поля — в признак data-mirror-<имя> узла: сервер печатает текущее, список имён —
// data-mirrors. Узел со своим тегом несёт их среди своих атрибутов, текст его прежний.
&Тест
Процедура ЗеркалоПризнакомПечатаетЗначениеВПризнак() Экспорт

	Прежняя = Кит.Надпись("тег").Рендер();
	HTML = Кит.Надпись("тег").ЗеркалоПризнаком("Стиль", "deprecated").ЗеркалоПризнаком("значок", "ключ").Рендер();
	Ожидаем.Что(HTML, "признаки на узле, имя строчными, текст прежний").Равно(
		СтрЗаменить(Прежняя, ">тег<", " data-mirrors=""стиль значок"" data-mirror-стиль=""deprecated"""
			+ " data-mirror-значок=""ключ"">тег<"));

	// повтор слова с тем же полем меняет значение, а не дублирует признак
	HTML = Кит.Надпись("тег").ЗеркалоПризнаком("стиль", "plain").ЗеркалоПризнаком("стиль", "<x>").Рендер();
	Ожидаем.Что(СтрНайти(HTML, " data-mirrors=""стиль"" data-mirror-стиль=""&lt;x&gt;""") > 0, "значение экранировано: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "data-mirror-стиль"), "один признак на поле").Равно(1);

	// пустое значение печатается: по признаку лист выбирает вид «по умолчанию»
	HTML = Кит.Надпись("тег").ЗеркалоПризнаком("стиль").Рендер();
	Ожидаем.Что(СтрНайти(HTML, "data-mirror-стиль=""""") > 0, HTML).ЭтоИстина();

	// текстовое зеркало рядом — своим признаком, они не мешают друг другу
	HTML = Кит.Надпись("Ромашка").Зеркало("title").ЗеркалоПризнаком("стиль", "plain").Рендер();
	Ожидаем.Что(СтрНайти(HTML, "data-mirror=""title""") > 0 И СтрНайти(HTML, "data-mirror-стиль=""plain""") > 0, HTML).ЭтоИстина();

КонецПроцедуры

// На компоненте (плашка, значок) признаки встают на первый тег — разметка компонента та же.
// Текстовое зеркало на компоненте по-прежнему отвергается.
&Тест
Процедура ЗеркалоПризнакомНаКомпонентеАТекстовоеЗапрещено() Экспорт

	Прежняя = Кит.Плашка("v2.4").Вид("ok").Рендер();
	HTML = Кит.Плашка("v2.4").Вид("ok").ЗеркалоПризнаком("стиль", "stable").Рендер();
	Ожидаем.Что(HTML, "плашка с признаком на первом теге").Равно(
		СтрЗаменить(Прежняя, "<span class=", "<span data-mirrors=""стиль"" data-mirror-стиль=""stable"" class="));

	Значок = Кит.Иконка("ключ").ЗеркалоПризнаком("значок", "ключ").Рендер();
	Ожидаем.Что(СтрНачинаетсяС(Значок, "<svg data-mirrors=""значок"" data-mirror-значок=""ключ"" class=""icon"""), Значок).ЭтоИстина();

	Ссылкой = Кит.Плашка("v2.4").Адрес("/теги/v2.4").ЗеркалоПризнаком("стиль", "plain").Рендер();
	Ожидаем.Что(СтрНачинаетсяС(Ссылкой, "<a data-mirrors=""стиль"" data-mirror-стиль=""plain"" "), Ссылкой).ЭтоИстина();

	Текст = "";
	Попытка
		Кит.Плашка("v2.4").Зеркало("стиль");
	Исключение
		Текст = ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Текст, "компонент рисует себя сам") > 0, "текстовое зеркало на компоненте отвергнуто: " + Текст).ЭтоИстина();

	Текст = "";
	Попытка
		Кит.Плашка("v2.4").ЗеркалоПризнаком("ui.style");
	Исключение
		Текст = ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Текст, "буквами, цифрами") > 0, "имя с точкой отвергнуто: " + Текст).ЭтоИстина();

	// скрипт кита находит узел по data-mirrors и пишет признак data-mirror-<имя>
	Скрипт = ТекстСкрипта();
	Ожидаем.Что(СтрНайти(Скрипт, "querySelectorAll('[data-mirrors]')") > 0, "скрипт ищет узлы по списку").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Скрипт, "setAttribute('data-mirror-' + name.toLowerCase(), value)") > 0, "скрипт пишет признак").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПанельСегмента

// Панель вне набора печатается с местом группы и номером сегмента; группа, на которую
// ссылаются панели, получает то же место. Номер-значение превращается в номер. Без панелей
// разметка сегментов прежняя байт в байт.
&Тест
Процедура ПанельСегментаВДругомШагеСвязанаСГруппой() Экспорт

	Прежние = Кит.Форма("/п", Кит.Сегменты("channel", Кит.Сегмент("chat", "Чат"),
		Кит.Сегмент("mail", "Почта"))).Токен("т").Рендер();

	Канал = Кит.Сегменты("channel", Кит.Сегмент("chat", "Чат"), Кит.Сегмент("mail", "Почта"));
	HTML = Кит.Форма("/п",
		Кит.Шаги(
			Кит.Шаг("Куда", Канал),
			Кит.Шаг("Текст",
				Канал.Панель(1, Кит.Поле("chat_text", "Текст")),
				Кит.ПанельСегмента("channel", "mail", Кит.Поле("mail_text", "Письмо")))))
		.Токен("т").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<div class=""segments"" data-segments-slot=""1"" role=""radiogroup"">") > 0,
		"группа с панелями несёт место: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<div class=""segments-panel"" data-segments-slot=""1"" data-segments-number=""1"""
		+ " data-segment=""chat"">") > 0, "панель номером").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<div class=""segments-panel"" data-segments-slot=""1"" data-segments-number=""2"""
		+ " data-segment=""mail"">") > 0, "панель значением — номер 2").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Прежние, "data-segments"), "без панелей разметка прежняя").Равно(0);

	// две группы с панелями в одной форме — два места, по порядку первой панели
	Вторая = Кит.Форма("/п",
		Кит.Сегменты("a", Кит.Сегмент("1", "Один"), Кит.Сегмент("2", "Два")),
		Кит.Сегменты("b", Кит.Сегмент("x", "Икс"), Кит.Сегмент("y", "Игрек")),
		Кит.ПанельСегмента("b", 2, "игрек"),
		Кит.ПанельСегмента("a", 1, "один")).Токен("т").Рендер();
	Ожидаем.Что(СтрНайти(Вторая, "data-segments-slot=""2"" data-segments-number=""1"" data-segment=""1"">один") > 0,
		"вторая по порядку группа — место 2: " + Вторая).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Вторая, "data-segments-slot=""1"" data-segments-number=""2"" data-segment=""y"">игрек") > 0,
		"первая по порядку панелей — место 1").ЭтоИстина();

	// лист: правило для каждого места и номера, панель спрятана, пока движок понимает :has()
	Условия = "@supports selector(:has(*))";
	Лист = Разбор.ТекстБазовогоЛиста();
	Ожидаем.Что(ОбъявлениеЛиста(".segments-panel", "display", Условия), "панель спрятана").Равно("none");
	Ожидаем.Что(ОбъявлениеЛиста(".segments-panel", "display"), "без :has() — видна").Равно("flex");
	Для Место = 1 По 4 Цикл
		Для Номер = 1 По 8 Цикл
			Селектор = СтрШаблон("form:has(.segments[data-segments-slot=""%1""] > :nth-child(%2) > :checked)"
				+ " .segments-panel[data-segments-slot=""%1""][data-segments-number=""%2""]:not(:empty)",
				Формат(Место, "ЧГ=0"), Формат(Номер, "ЧГ=0"));
			Ожидаем.Что(СтрНайти(Лист, Селектор) > 0, "в листе: " + Селектор).ЭтоИстина();
		КонецЦикла;
	КонецЦикла;
	// разбор снимает содержимое кавычек: правило каждого номера — по одному на место, и все
	// показывают панель под тем же условием
	Для Номер = 1 По 8 Цикл
		Селектор = СтрШаблон("form:has(.segments[data-segments-slot=""""] > :nth-child(%1) > :checked)"
			+ " .segments-panel[data-segments-slot=""""][data-segments-number=""""]:not(:empty)", Формат(Номер, "ЧГ=0"));
		Правил = 0;
		Для Каждого Правило Из Правила() Цикл
			Если Правило.Селектор = Селектор И Правило.Условия = Условия
				И Правило.Объявления.Получить("display") = "flex" Тогда
				Правил = Правил + 1;
			КонецЕсли;
		КонецЦикла;
		Ожидаем.Что(Правил, Селектор).Равно(4);
	КонецЦикла;

КонецПроцедуры

// Панель без формы, без своих сегментов в форме и с номером больше числа сегментов —
// сборка останавливается: молча спрятанная навсегда панель хуже исключения.
&Тест
Процедура ПанельСегментаБезСвоихСегментовНеПечатается() Экспорт

	Тексты = Новый Массив();
	Попытки = Новый Массив();
	Попытки.Добавить(Кит.Холст(Кит.Сегменты("a", Кит.Сегмент("1", "Один")), Кит.ПанельСегмента("a", 1, "x")));
	Попытки.Добавить(Кит.Форма("/п", Кит.ПанельСегмента("a", 1, "x")).Токен("т"));
	Попытки.Добавить(Кит.Форма("/п", Кит.Сегменты("a", Кит.Сегмент("1", "Один")),
		Кит.ПанельСегмента("a", 2, "x")).Токен("т"));
	Попытки.Добавить(Кит.Форма("/п", Кит.Сегменты("a", Кит.Сегмент("1", "Один")),
		Кит.ПанельСегмента("a", "zzz", "x")).Токен("т"));
	Для Каждого Узел Из Попытки Цикл
		Текст = "";
		Попытка
			Узел.Рендер();
		Исключение
			Текст = ИнформацияОбОшибке().Описание;
		КонецПопытки;
		Тексты.Добавить(Текст);
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Тексты[0], "вне формы") > 0, "вне формы: " + Тексты[0]).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тексты[1], "сегментов с этим именем в её форме нет") > 0, "без сегментов: " + Тексты[1]).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тексты[2], "номер 2, а сегментов у них 1") > 0, "номер: " + Тексты[2]).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Тексты[3], "сегмента со значением «zzz» у них нет") > 0, "значение: " + Тексты[3]).ЭтоИстина();

	Текст = "";
	Попытка
		Кит.Надпись("x").Панель(1);
	Исключение
		Текст = ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Текст, "панель по номеру сегмента дают сегменты") > 0, Текст).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СохранятьСразуБезСкрипта

// Тумблер «сохранять сразу» в форме без своей кнопки: кит печатает рядом запасную малую
// кнопку-значок отправки с именем из словаря; при работающем скрипте лист её прячет.
&Тест
Процедура ТумблерСохранятьСразуПечатаетЗапаснуюКнопку() Экспорт

	Тумблер = Кит.Тумблер("mail", "Письма").Включено().СохранятьСразу();
	Один = Кит.Тумблер("mail", "Письма").Включено().СохранятьСразу().Рендер();
	HTML = Кит.Форма("/п", Тумблер).Токен("т").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<div class=""toggle-save"">" + Один + "<button type=""submit"" class=""toggle__save button") > 0,
		"тумблер и кнопка в обёртке, тумблер прежний: " + HTML).ЭтоИстина();
	Кнопка = Сред(HTML, СтрНайти(HTML, "<button"));
	Ожидаем.Что(СтрНайти(Кнопка, "button--icon") > 0 И СтрНайти(Кнопка, "button--sm") > 0, "малая кнопка-значок: " + Кнопка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кнопка, "aria-label=""Сохранить""") > 0, "имя — словарь toggle.save: " + Кнопка).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "<button"), "одна кнопка").Равно(1);

	// два тумблера — одна запасная кнопка, у первого
	Два = Кит.Форма("/п", Кит.Тумблер("a", "А").СохранятьСразу(), Кит.Тумблер("b", "Б").СохранятьСразу())
		.Токен("т").Рендер();
	Ожидаем.Что(СтрЧислоВхождений(Два, "toggle__save"), "одна запасная кнопка на форму").Равно(1);

	// лист прячет её при работающем скрипте
	Ожидаем.Что(ОбъявлениеЛиста(".toggle__save", "display", "@media (scripting: enabled)"), "скрипт есть — кнопки нет").Равно("none");
	Ожидаем.Что(ОбъявлениеЛиста(".toggle-save", "display"), "тумблер и кнопка в строку").Равно("flex");

КонецПроцедуры

// Своя кнопка у формы — запасной нет, разметка прежняя байт в байт; тумблер без слова и вне
// формы — тоже прежний.
&Тест
Процедура ЗапаснойКнопкиНетУФормыСоСвоейКнопкой() Экспорт

	СоСвоей = Кит.Форма("/п", Кит.Тумблер("mail", "Письма").СохранятьСразу(),
		Кит.Кнопка("Сохранить").Иконка("сохранить").ТолькоИконка().Малая()).Токен("т").Рендер();
	Ожидаем.Что(СтрНайти(СоСвоей, "toggle-save"), "своя кнопка — запасной нет").Равно(0);
	Ожидаем.Что(СоСвоей, "разметка прежняя").Равно(Кит.Форма("/п",
		Кит.Тумблер("mail", "Письма").СохранятьСразу(),
		Кит.Кнопка("Сохранить").Иконка("сохранить").ТолькоИконка().Малая()).Токен("т").Рендер());

	Без = Кит.Форма("/п", Кит.Тумблер("mail", "Письма")).Токен("т").Рендер();
	Ожидаем.Что(СтрНайти(Без, "<button"), "без СохранятьСразу — без кнопки").Равно(0);

	Вне = Кит.Тумблер("mail", "Письма").СохранятьСразу().Рендер();
	Ожидаем.Что(СтрНайти(Вне, "<button"), "вне формы — без кнопки").Равно(0);

	// ссылка-кнопка и кнопка без отправки — не своя отправка: запасная нужна
	СоСсылкой = Кит.Форма("/п", Кит.Тумблер("mail", "Письма").СохранятьСразу(),
		Кит.Кнопка("Справка").Адрес("/справка"), Кит.Кнопка("Образец").БезОтправки()).Токен("т").Рендер();
	Ожидаем.Что(СтрНайти(СоСсылкой, "toggle__save") > 0, "ссылка и кнопка без отправки форму не шлют").ЭтоИстина();

	// в записи реестра — действия формой: запасная кнопка там же
	Реестр = Кит.Реестр(Кит.ЗаписьРеестра("Почта").Действия(
		Кит.Форма("/почта", Кит.Тумблер("on", "Почта включена").СохранятьСразу()))).Токен("т").Рендер();
	Ожидаем.Что(СтрНайти(Реестр, "toggle__save") > 0, "в действиях записи — запасная кнопка: " + Реестр).ЭтоИстина();

	// строковый вход компонента (Набор) — прежний
	Строкой = Набор.Тумблер().Отрисовать(Новый Структура("Имя, Метка, СохранятьСразу", "mail", "Письма", Истина));
	Ожидаем.Что(Строкой, "компонент строкой — прежний").Равно(Вне);

КонецПроцедуры

#КонецОбласти

#Область ДобавитьНеопределено

// Добавить(Неопределено) пропускается, как позиционный ребёнок: необязательная часть экрана
// кладётся без обёртки в Кит.Холст. Строгий род тоже не возражает — класть нечего.
&Тест
Процедура ДобавитьНеопределеноПропускается() Экспорт

	Область = Кит.Область(Кит.Надпись("а"));
	Ожидаем.Что(Область.Добавить(Неопределено), "возвращает Неопределено").Равно(Неопределено);
	Область.Добавить(Кит.Надпись("б"));
	Ожидаем.Что(Область.Дети().Количество(), "пропущено, не положено").Равно(2);
	Ожидаем.Что(Область.Рендер(), "печать та же, что без него").Равно(
		Кит.Область(Кит.Надпись("а"), Неопределено, Кит.Надпись("б")).Рендер());

	Таблица = Кит.Таблица(Кит.Колонка("Имя"));
	Ожидаем.Что(Таблица.Добавить(Неопределено), "строгий род — тоже пропуск").Равно(Неопределено);

	// лист дерева детей не принимает и с Неопределено говорит то же, что прежде
	Текст = "";
	Попытка
		Кит.Текст("x").Добавить(Неопределено);
	Исключение
		Текст = ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Ожидаем.Что(ЗначениеЗаполнено(Текст), "лист не холст — по-прежнему исключение").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПодписьСегментаНаТелефоне

// Регрессия dev.5: на телефоне колонка сегмента была равной долей пилюли, и однословная
// подпись, которой доли не хватало, рвалась посреди слова (overflow-wrap: break-word).
// Теперь нижний предел колонки — самое длинное слово, остаток — поровну, и перенос только
// между словами.
&Тест
Процедура ПодписьСегментаНаТелефонеНеРвётсяПосредиСлова() Экспорт

	// у самой группы есть правило с соседним комбинатором (источник перед группой), его
	// каскад разбора не оценивает — объявления группы берутся по точному селектору
	Телефон = "@media (max-width: 600px)";
	Ожидаем.Что(ОбъявлениеЛиста(".segments", "display", Телефон), "на телефоне — сетка").Равно("grid");
	Ожидаем.Что(ОбъявлениеЛиста(".segments", "grid-auto-columns", Телефон),
		"колонка не уже самого длинного слова, остаток поровну").Равно("minmax(min-content, 1fr)");
	Ожидаем.Что(ОбъявлениеЛиста(".segments", "width", Телефон), "во всю ширину").Равно("100%");

	Цепочка = Новый Массив();
	Цепочка.Добавить(Разбор.Узел("div", "segments"));
	Цепочка.Добавить(Разбор.Узел("label", "segments__item"));
	Цепочка.Добавить(Разбор.Узел("span", "segments__label"));
	Цепочка.Добавить(Разбор.Узел("span", "segments__text"));
	Итог = Разбор.Каскад(Цепочка, 390, "white-space,overflow-wrap,word-break,hyphens");
	Ожидаем.Что(Итог.Получить("white-space"), "подпись переносится между словами").Равно("normal");
	Ожидаем.Что(Итог.Получить("overflow-wrap"), "слово не рвётся").Равно("normal");
	Ожидаем.Что(Итог.Получить("word-break"), "word-break не рвёт слово").Равно(Неопределено);
	Ожидаем.Что(Итог.Получить("hyphens"), "без переносов по слогам").Равно(Неопределено);

	// на широком экране — прежняя пилюля по содержимому с многоточием
	Итог = Разбор.Каскад(Цепочка, 1280, "white-space,text-overflow");
	Ожидаем.Что(Итог.Получить("white-space"), "1280: в одну строку").Равно("nowrap");
	Ожидаем.Что(Итог.Получить("text-overflow"), "1280: многоточие").Равно("ellipsis");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстСкрипта()

	Корень = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..");
	Текст = Новый ТекстовыйДокумент();
	Текст.Прочитать(ОбъединитьПути(Корень, "src", "статика", "oscript-ui.js"), КодировкаТекста.UTF8);
	Возврат Текст.ПолучитьТекст();

КонецФункции

Функция Правила()

	Если ПравилаЛиста = Неопределено Тогда
		ПравилаЛиста = Разбор.Правила(Разбор.ТекстБазовогоЛиста());
	КонецЕсли;
	Возврат ПравилаЛиста;

КонецФункции

// Значение свойства у правила базового листа с ровно этим селектором под ровно этими
// условиями; из нескольких побеждает последнее, как в каскаде. Нет — Неопределено.
Функция ОбъявлениеЛиста(Знач Селектор, Знач Свойство, Знач Условия = "")

	Результат = Неопределено;
	Для Каждого Правило Из Правила() Цикл
		Если Правило.Селектор = Селектор И Правило.Условия = Условия Тогда
			Значение = Правило.Объявления.Получить(Свойство);
			Если Значение <> Неопределено Тогда
				Результат = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
