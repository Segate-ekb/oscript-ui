// Статика кита: собственный каталог библиотеки (базовый лист, глифы, значки) плюс каталог
// инсталляции, который приходит контрактом «СтатикаИнсталляции». Проверяется то, что
// видит пользователь: объявленный инсталляцией файл получает адрес с отпечатком, ведёт
// на свой файл на диске и меняет адрес вместе с содержимым, чужое имя не получает
// ни адреса, ни пути, а имя, совпавшее с китовым, достаётся инсталляции.

#Использовать "../"
#Использовать asserts

Перем Каталог;
Перем Инсталляция;
Перем Место;
Перем Активы;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередКаждым
Процедура ПоднятьИнсталляцию() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	ПодключитьСценарий(ОбъединитьПути(КаталогТестов, "фикстуры", "СтатикаПробы.os"), "СтатикаПробы");

	Каталог = ВременныйКаталог();
	Инсталляция = Новый СтатикаПробы(Каталог);

КонецПроцедуры

&ПослеКаждого
Процедура УбратьИнсталляцию() Экспорт
	УдалитьВременный(Каталог);
КонецПроцедуры

// Библиотека самодостаточна: базовый лист, значки и разрешение на рисунки она раздаёт
// без инсталляции. Знака сайта среди них нет — его придумывать за приложение нельзя.
&Тест
Процедура БезИнсталляцииКитРаздаётСвойЛистЗначкиИРазрешение() Экспорт

	Собрать(Новый СтатикаИнсталляцииПоУмолчанию());
	Раскладка = Активы.Раскладка();

	Ожидаем.Что(Раскладка.Количество(),
		"базовый лист, разрешение на рисунки и по значку на ключ")
		.Равно(2 + Место.КлючиЗначков().Количество());
	Ожидаем.Что(Раскладка.Получить(Место.ФайлЛицензииИконок()) <> Неопределено,
		"разрешение на рисунки раздаётся").ЭтоИстина();
	Ожидаем.Что(Раскладка.Получить(Место.ФайлЗначка("github")) <> Неопределено,
		"значок раздаётся").ЭтоИстина();
	Ожидаем.Что(Активы.ТипФайла(Место.ФайлЗначка("github")),
		"и с типом картинки").Равно("image/svg+xml");
	Ожидаем.Что(Место.ФайлЗначка("подделка"), "ключа вне списка не существует").Равно("");

КонецПроцедуры

// Лист без правил — библиотека без лица: чужой проект, поставивший её, увидел бы голую
// разметку и решил, что кит ничего не оформляет.
&Тест
Процедура БазовыйЛистОтдаётсяИНеПуст() Экспорт

	Собрать(Новый СтатикаИнсталляцииПоУмолчанию());
	Имя = Место.ФайлБазовогоЛиста();

	Ожидаем.Что(Активы.АдресБазовогоЛиста(), "адрес базового листа — адрес его файла")
		.Равно(Активы.Адрес(Имя));
	Ожидаем.Что(СтрНачинаетсяС(Активы.АдресБазовогоЛиста(), "/static/oscript-ui-"),
		"адрес несёт отпечаток содержимого: " + Активы.АдресБазовогоЛиста()).ЭтоИстина();
	Ожидаем.Что(Активы.ТипФайла(Имя), "отдаётся таблицей стилей")
		.Равно("text/css; charset=utf-8");

	Правил = СтрЧислоВхождений(ПрочитатьЦеликом(Место.ПолныйПуть(Имя)), "{");
	Ожидаем.Что(Правил > 100,
		СтрШаблон("правил в базовом листе: %1 — лист не пуст", Правил)).ЭтоИстина();

КонецПроцедуры

// Проект подменяет файл библиотеки, объявив своё под тем же именем: раскладка кладёт
// инсталляцию ПОВЕРХ. Без этого свой значок или свой базовый лист поставить было бы
// нечем, кроме правки самой библиотеки.
&Тест
Процедура ФайлИнсталляцииВытесняетОдноимённыйФайлКита() Экспорт

	Своё = Новый РаскладкаСтатики(Новый СтатикаИнсталляцииПоУмолчанию()).ФайлБазовогоЛиста();

	ЗаписатьФайл(ОбъединитьПути(Каталог, Своё), ".свой{color:red}");
	Инсталляция.Объявить(Своё, "", "text/css; charset=utf-8");
	Собрать(Инсталляция);

	Ожидаем.Что(Активы.ПутьНаДиске(Активы.ПубличноеИмя(Своё)),
		"базовый лист берётся из каталога инсталляции, а не из библиотеки")
		.Равно(ОбъединитьПути(Каталог, Своё));
	Ожидаем.Что(Активы.Раскладка().Количество(),
		"подмена не добавила файла, а заменила существующий")
		.Равно(2 + Место.КлючиЗначков().Количество());

КонецПроцедуры

// Объявленный инсталляцией файл доезжает до адреса, типа и диска. Адрес односегментный,
// как бы глубоко ни лежал файл, и несёт префикс отпечатка СОДЕРЖИМОГО.
&Тест
Процедура ФайлИнсталляцииПолучаетАдресТипИПутьНаДиске() Экспорт

	СоздатьКаталог(ОбъединитьПути(Каталог, "бренд"));
	ЗаписатьФайл(ОбъединитьПути(Каталог, "бренд", "mark.svg"), "<svg/>");
	Инсталляция.Объявить("mark.svg", "бренд", "image/svg+xml");
	Собрать(Инсталляция);

	Адрес = Активы.Адрес("mark.svg");
	Публичное = Активы.ПубличноеИмя("mark.svg");

	Ожидаем.Что(Адрес, "адрес односегментный и с отпечатком").Равно("/static/" + Публичное);
	Ожидаем.Что(СтрДлина(Публичное), "имя = mark- + 16 символов отпечатка + .svg")
		.Равно(СтрДлина("mark-") + 16 + СтрДлина(".svg"));
	Ожидаем.Что(Активы.ТипКонтента(Публичное), "тип объявлен инсталляцией").Равно("image/svg+xml");
	Ожидаем.Что(Активы.ПутьНаДиске(Публичное), "путь ведёт в подкаталог инсталляции")
		.Равно(ОбъединитьПути(Каталог, "бренд", "mark.svg"));
	Ожидаем.Что(Активы.ETag(Публичное), "ETag — полный отпечаток в кавычках")
		.Равно("""" + Активы.Отпечаток("mark.svg") + """");

КонецПроцедуры

// Адрес есть функция содержимого: правка файла без смены адреса невозможна как класс.
&Тест
Процедура АдресМеняетсяВместеССодержимым() Экспорт

	ЗаписатьФайл(ОбъединитьПути(Каталог, "app.css"), ".a{color:red}");
	Инсталляция.Объявить("app.css", "", "text/css; charset=utf-8");
	Собрать(Инсталляция);
	Прежний = Активы.Адрес("app.css");

	ЗаписатьФайл(ОбъединитьПути(Каталог, "app.css"), ".a{color:blue}");
	Собрать(Инсталляция);

	Ожидаем.Что(Активы.Адрес("app.css") = Прежний,
		"после правки файла адрес обязан стать другим").ЭтоЛожь();

КонецПроцедуры

// Имя из URL сравнивается с белым списком ЦЕЛИКОМ и никогда не разбирается на части:
// чужое имя, верное имя с чужим хешем и «../../etc/passwd» одинаково не существуют.
&Тест
Процедура ИмяВнеРаскладкиНеПолучаетНиАдресаНиПути() Экспорт

	ЗаписатьФайл(ОбъединитьПути(Каталог, "app.css"), ".a{}");
	Инсталляция.Объявить("app.css", "", "text/css; charset=utf-8");
	Собрать(Инсталляция);

	Ожидаем.Что(Активы.Адрес("чужой.css"), "адреса у незаявленного имени нет").Равно("");
	Ожидаем.Что(Активы.ТипКонтента("app-0000000000000000.css"),
		"верное имя с чужим отпечатком не отдаётся").Равно(Неопределено);
	Ожидаем.Что(Активы.ПутьНаДиске("../../etc/passwd"),
		"обхода каталогов не существует как класса").Равно(Неопределено);
	Ожидаем.Что(Активы.ТипФайла("чужой.css"), "и типа у него тоже нет").Равно("");

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Процедура Собрать(Знач Статика)
	Место = Новый РаскладкаСтатики(Статика);
	Активы = Новый АктивыСтатики(Место, Новый ОтпечаткиСтатики(Место));
КонецПроцедуры

Функция ВременныйКаталог()
	Путь = ОбъединитьПути(КаталогВременныхФайлов(),
		"кит-статика-" + Строка(Новый УникальныйИдентификатор()));
	СоздатьКаталог(Путь);
	Возврат Путь;
КонецФункции

Процедура УдалитьВременный(Знач Путь)
	Попытка
		УдалитьФайлы(Путь);
	Исключение
	КонецПопытки;
КонецПроцедуры

Процедура ЗаписатьФайл(Знач Путь, Знач Текст)
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

Функция ПрочитатьЦеликом(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);
КонецФункции

#КонецОбласти
