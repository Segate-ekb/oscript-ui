// Поля «список» и «цвет» (выпуск 0.12). Проверяется то, что ломается для человека: без
// скрипта поле не отправляет набранное или отправляет его дважды, плашки расходятся со
// строкой, которая уходит на сервер, выбранный образец не отмечен, код цвета не того вида
// принимается, а прежние поля печатаются иначе, чем до выпуска.

#Использовать "../"
#Использовать asserts

Перем Кит;   // Кит
Перем Набор; // НаборКомпонентов
Перем Формы; // Формы

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Кит = Слой.Кит;
	Набор = Слой.Набор;
	Формы = Слой.Формы;

КонецПроцедуры

#Область Список

// Строка через запятую печатается плашками в том же порядке, без пустых и повторов, а
// скрытое поле несёт ту же строку под именем поля.
&Тест
Процедура СтрокаСпискаПечатаетсяПлашкамиИСкрытымПолем() Экспорт

	HTML = Кит.Поле("masks", "Маски файлов").Список().Значение("*.os, *.bsl ,, *.os").Рендер();

	Ожидаем.Что(СтрНачинаетсяС(HTML, "<div class=""field field--chips"" data-chips><div class=""chips-in"">"),
		"корень: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "<span class=""chips-in__chip"" role=""listitem"">"), "плашек (и одна в шаблоне)")
		.Равно(3);
	Первая = СтрНайти(HTML, "<span class=""chips-in__text"">*.os</span>");
	Вторая = СтрНайти(HTML, "<span class=""chips-in__text"">*.bsl</span>");
	Ожидаем.Что(Первая > 0 И Первая < Вторая, "порядок плашек: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "aria-label=""Убрать «*.os»""") > 0, "крестик называет значение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""chips-in__list"" role=""list"" aria-label=""Маски файлов"" hidden>") > 0,
		"список плашек назван и спрятан до скрипта").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<input type=""hidden"" name=""masks"" value=""*.os, *.bsl"" disabled data-chips-value>") > 0,
		"скрытое поле со строкой: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<template data-chips-chip><span class=""chips-in__chip"" role=""listitem"">"
		+ "<span class=""chips-in__text""></span><button type=""button"" class=""chips-in__remove"""
		+ " aria-label=""Убрать «%1»"" data-chips-remove>") > 0, "шаблон новой плашки: " + HTML).ЭтоИстина();

КонецПроцедуры

// Без скрипта это обычное текстовое поле с той же строкой: только оно уходит с формой
// (скрытое выключено), подпись связана с ним вложением.
&Тест
Процедура БезСкриптаСписокОбычноеТекстовоеПоле() Экспорт

	HTML = Кит.Поле("masks", "Маски файлов").Список().Значение("*.os, *.bsl").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<label class=""chips-in__entry""><span class=""field__label"">Маски файлов</span>"
		+ "<input class=""field__control chips-in__input"" type=""text"" name=""masks"" value=""*.os, *.bsl"">"
		+ "</label>") > 0, "текстовое поле со строкой: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "name=""masks"""), "имя у текстового и у скрытого").Равно(2);
	Ожидаем.Что(СтрНайти(HTML, "value=""*.os, *.bsl"" disabled data-chips-value"), "скрытое выключено")
		.Больше(0);
	// крестик — кнопка вне подписи: подпись поля не достаётся кнопке
	Ожидаем.Что(СтрНайти(HTML, "<button") > СтрНайти(HTML, "</label>"), "кнопки после подписи").ЭтоИстина();

КонецПроцедуры

// Значение массивом — то же поле, что строкой: тип выводится из значения, слово Список не нужно.
&Тест
Процедура МассивЗначенийДаётТотЖеСписок() Экспорт

	Значения = Новый Массив();
	Значения.Добавить("*.os");
	Значения.Добавить(" *.bsl ");
	Значения.Добавить("*.os");

	Ожидаем.Что(Кит.Поле("masks", "Маски файлов").Значение(Значения).Рендер(), "массив = строка")
		.Равно(Кит.Поле("masks", "Маски файлов").Список().Значение("*.os, *.bsl").Рендер());
	Ожидаем.Что(Набор.Поле().Отрисовать(Новый Структура("Имя, Метка, Тип, Значение", "masks", "Маски файлов",
		"список", Значения)), "компонент строкой — то же")
		.Равно(Кит.Поле("masks", "Маски файлов").Список().Значение("*.os, *.bsl").Рендер());

КонецПроцедуры

// Текст значения экранируется и в плашке, и в подписи крестика, и в строке поля.
&Тест
Процедура ЗначенияСпискаЭкранируются() Экспорт

	HTML = Кит.Поле("tags", "Метки").Список().Значение("<b>, ""x""").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<b>"), "сырой разметки нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<span class=""chips-in__text"">&lt;b&gt;</span>") > 0, "плашка: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "aria-label=""Убрать «&quot;x&quot;»""") > 0, "крестик: " + HTML).ЭтоИстина();

КонецПроцедуры

// Пустой список: плашек нет, строка пустая, обязательность и отказ — у текстового поля.
&Тест
Процедура ПустойСписокСОтказом() Экспорт

	HTML = Кит.Поле("tags", "Метки").Список().Ид("tags").Обязательное().Ошибка("Добавьте метку").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "class=""field field--chips field--error"""), "отбитое поле").Больше(0);
	Ожидаем.Что(СтрНайти(HTML, "<label class=""chips-in__entry"" for=""tags"">") > 0, "for у подписи").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "id=""tags"" name=""tags"" required aria-invalid=""true"" aria-describedby=""tags-err""") > 0,
		"текстовое поле обязательно и отбито: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""field__error"" role=""alert"" id=""tags-err"">Добавьте метку</span>") > 0,
		"отказ под полем").ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "role=""listitem"""), "одна — в шаблоне").Равно(1);

КонецПроцедуры

// Заблокированное или только для чтения поле плашки не снимает: крестики выключены.
&Тест
Процедура ЗаблокированныйСписокНеСнимаетПлашки() Экспорт

	HTML = Кит.Поле("tags", "Метки").Список().Значение("а, б").ТолькоЧтение().Рендер();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "class=""chips-in__remove"" aria-label=""Убрать «а»"" disabled"), "крестик выключен")
		.Равно(1);
	Ожидаем.Что(СтрНайти(HTML, " readonly"), "поле только для чтения").Больше(0);

КонецПроцедуры

#КонецОбласти

#Область Цвет

// Образцы печатаются радиокнопками-кружками, выбранный отмечен, рядом имя и код; код
// несёт одно текстовое поле с pattern, а радиокнопки и выбор цвета в отправку не входят.
&Тест
Процедура ЦветПечатаетОбразцыИКод() Экспорт

	HTML = Синий().Значение("#1A73E8").Рендер();

	Ожидаем.Что(СтрНачинаетсяС(HTML, "<fieldset class=""field field--color"" data-swatches>"
		+ "<legend class=""field__label"">Акцент</legend><div class=""swatches"" data-swatches-row hidden>"),
		"корень: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<label class=""swatches__item"" title=""Синий""><input type=""radio"""
		+ " class=""swatches__radio"" name=""accent"" value=""#1a73e8"" form="""" style=""--swatch: #1a73e8"" checked>"
		+ "<span class=""visually-hidden"">Синий</span></label>") > 0, "образец: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, " checked"), "отмечен один").Равно(1);
	Ожидаем.Что(СтрНайти(HTML, "value=""#188038"" form="""" style=""--swatch: #188038"">") > 0, "второй образец")
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<input class=""field__control swatches__code"" type=""text"" name=""accent"""
		+ " value=""#1A73E8"" pattern=""#[0-9A-Fa-f]{6}"" maxlength=""7"" placeholder=""По умолчанию"""
		+ " aria-label=""Код цвета"" spellcheck=""false""><span class=""swatches__name"" data-swatches-name>Синий</span>") > 0,
		"код и имя выбранного: " + HTML).ЭтоИстина();
	// имя поля без формы-владельца — только у кода
	Ожидаем.Что(СтрЧислоВхождений(HTML, "name=""accent"""), "имя у кода и радиокнопок").Равно(4);
	Ожидаем.Что(СтрЧислоВхождений(HTML, "form="""""), "радиокнопки и выбор цвета без формы").Равно(4);
	Ожидаем.Что(СтрНайти(HTML, "<input type=""color"" class=""swatches__picker"" value=""#1a73e8"" form="""""
		+ " data-swatches-own>") > 0, "свой цвет — системный выбор: " + HTML).ЭтоИстина();

КонецПроцедуры

// Пусто — «по умолчанию»: отмечен его кружок, рядом его имя, код пуст с примером.
&Тест
Процедура ПустойЦветЗначитПоУмолчанию() Экспорт

	HTML = Синий().Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<label class=""swatches__item swatches__item--default"" title=""По умолчанию"">"
		+ "<input type=""radio"" class=""swatches__radio"" name=""accent"" value="""" form="""" checked>") > 0,
		"«по умолчанию» отмечен: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-swatches-name>По умолчанию</span>") > 0, "имя выбранного").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""accent"" pattern="), "код пуст").Больше(0);

КонецПроцедуры

// Свой цвет: ни один образец не отмечен, кружок «свой» показывает код, имя — «Свой».
&Тест
Процедура СвойЦветНеОтмечаетОбразцов() Экспорт

	HTML = Синий().Значение("#123456").Рендер();

	Ожидаем.Что(СтрНайти(HTML, " checked"), "образцы не отмечены").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<span class=""swatches__dot"" style=""--swatch: #123456""></span>") > 0,
		"кружок своего цвета: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-swatches-name>Свой</span>") > 0, "имя — «Свой»").ЭтоИстина();

КонецПроцедуры

// Обязательное поле пустым не бывает — «по умолчанию» ему не предлагается.
&Тест
Процедура ОбязательныйЦветБезПоУмолчанию() Экспорт

	HTML = Синий().Обязательное().Значение("#188038").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "swatches__item--default"), "без «по умолчанию»").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "name=""accent"" required value=""#188038""") > 0, "код обязателен: " + HTML)
		.ЭтоИстина();

КонецПроцедуры

// Образец не того вида — ошибка сборки, а не серый кружок; строка стиля — только из кода.
&Тест
Процедура ОбразецНеКодомОстанавливаетСборку() Экспорт

	Текст = "";
	Попытка
		Кит.Поле("accent", "Акцент").Образец("red;background:url(x)", "Красный").Рендер();
	Исключение
		Текст = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(Текст, "#rrggbb"), "исключение называет формат: " + Текст).Больше(0);

КонецПроцедуры

#КонецОбласти

#Область Совместимость

// Прежние типы поля печатаются как до выпуска, байт в байт.
&Тест
Процедура ПрежниеПоляНеМеняются() Экспорт

	Ожидаем.Что(Кит.Поле("a", "А").Значение("x").Рендер(), "текст")
		.Равно("<label class=""field""><span class=""field__label"">А</span><input class=""field__control"""
			+ " type=""text"" name=""a"" value=""x""></label>");
	Ожидаем.Что(Кит.Поле("a", "А").ТипЗначения("color").Значение("#ffffff").Рендер(), "прежний type=color")
		.Равно("<label class=""field""><span class=""field__label"">А</span><input class=""field__control"""
			+ " type=""color"" name=""a"" value=""#ffffff""></label>");

КонецПроцедуры

#КонецОбласти

#Область ОбъявленнаяФорма

// Объявленная форма: список разбирается в массив строк без пустых и повторов, цвет —
// в код строчными; код не того вида отбивается, набранное возвращается в поле.
&Тест
Процедура ОбъявленнаяФормаРазбираетСписокИЦвет() Экспорт

	Объявление = Формы.Новая();
	Объявление.Поле("маски", "Маски").Список()
		.Поле("акцент", "Акцент").Образец("#1a73e8", "Синий").Образец("#188038", "Зелёный");

	Присланное = Новый Соответствие();
	Присланное.Вставить("маски", " *.os, ,*.bsl, *.os ");
	Присланное.Вставить("акцент", "#1A73E8");
	Итог = Объявление.Разобрать(Присланное);

	Ожидаем.Что(Итог.Принято, "принято: " + Итог.Отказ).ЭтоИстина();
	Маски = Итог.Значения.Получить("маски");
	Ожидаем.Что(ТипЗнч(Маски), "список — массив").Равно(Тип("Массив"));
	Ожидаем.Что(СтрСоединить(Маски, "|"), "без пустых и повторов").Равно("*.os|*.bsl");
	Ожидаем.Что(Итог.Значения.Получить("акцент"), "код строчными").Равно("#1a73e8");

	Присланное.Вставить("акцент", "синий");
	Отбитое = Объявление.Разобрать(Присланное);
	Ожидаем.Что(Отбитое.Отказы.Получить("акцент"), "код не того вида")
		.Равно("Код цвета — # и шесть цифр, например #1a73e8");
	HTML = Объявление.Отрисовать(Неопределено, "/x", "т");
	Ожидаем.Что(СтрНайти(HTML, "value=""синий"" pattern=") > 0, "набранное вернулось в поле: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""chips-in__text"">*.bsl</span>") > 0, "плашки из набранного").ЭтоИстина();

	// пустой цвет — «по умолчанию», значения нет
	Присланное.Вставить("акцент", "");
	Ожидаем.Что(Объявление.Разобрать(Присланное).Значения.Получить("акцент"), "по умолчанию").Равно(Неопределено);

КонецПроцедуры

// Действующее значение списка — массивом: форма печатает его плашками и строкой.
&Тест
Процедура ДействующийСписокМассивом() Экспорт

	Объявление = Формы.Новая();
	Объявление.Поле("маски", "Маски").Список();
	Значения = Новый Массив();
	Значения.Добавить("*.os");
	Значения.Добавить("*.bsl");

	HTML = Объявление.Тело(Новый Структура("маски", Значения));
	Ожидаем.Что(СтрНайти(HTML, "value=""*.os, *.bsl"" disabled data-chips-value") > 0, "строкой: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "<span class=""chips-in__text"">*."), "плашками").Равно(2);

КонецПроцедуры

#КонецОбласти

Функция Синий()
	Возврат Кит.Поле("accent", "Акцент").Цвет().Образец("#1A73E8", "Синий").Образец("#188038", "Зелёный");
КонецФункции
