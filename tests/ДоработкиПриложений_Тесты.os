// Мелкие универсальные возможности 0.13.1, которых не хватило макетам приложений: источник
// значения у поля. Проверяется то, что ломается для человека: источник теряется или
// печатается вместо подсказки, на телефоне он наезжает на подсказку, а поле без нового
// слова печатается иначе, чем до выпуска.

#Использовать "../"
#Использовать asserts

Перем Кит;    // Кит
Перем Набор;  // НаборКомпонентов
Перем Формы;  // Формы
Перем Разбор; // РазборЛиста — сканер, читающий КОД листа

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "РазборЛиста.os"), "РазборЛиста");

	Слой = Новый СборкаХолста().Собрать();
	Кит = Слой.Кит;
	Набор = Слой.Набор;
	Формы = Слой.Формы;
	Разбор = Новый РазборЛиста();

КонецПроцедуры

#Область ИсточникЗначения

// Источник стоит в строке подсказки справа от неё: та же строка, тот же span подсказки,
// только с модификатором — и экранируется, как любой текст из данных.
&Тест
Процедура ИсточникСтоитСправаВСтрокеПодсказки() Экспорт

	HTML = Кит.Поле("host", "Почтовый сервер").Значение("smtp.example.org")
		.Подсказка("Адрес SMTP").Источник("по умолчанию · mail.host").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<span class=""field__hint field__hint--origin"">Адрес SMTP"
			+ "<span class=""field__origin"">по умолчанию · mail.host</span></span>") > 0,
		"подсказка слева, источник справа в той же строке: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "class=""field__hint"), "строка подсказки одна: " + HTML).Равно(1);

	Опасный = Кит.Поле("host", "Сервер").Источник("<b>env</b>").Рендер();
	Ожидаем.Что(СтрНайти(Опасный, "&lt;b&gt;env&lt;/b&gt;") > 0,
		"источник экранируется: " + Опасный).ЭтоИстина();

КонецПроцедуры

// Без подсказки строка под полем всё равно печатается — с одним источником справа: иначе
// откуда взялось значение, было бы не узнать.
&Тест
Процедура БезПодсказкиСтрокаПечатаетсяСОднимИсточником() Экспорт

	HTML = Кит.Поле("port", "Порт").Значение(587).Источник("из окружения").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<span class=""field__hint field__hint--origin"">"
			+ "<span class=""field__origin"">из окружения</span></span>") > 0,
		"строка из одного источника: " + HTML).ЭтоИстина();

	С_Ошибкой = Кит.Поле("port", "Порт").Источник("из окружения").Ошибка("Не число").Рендер();
	Ожидаем.Что(СтрНайти(С_Ошибкой, "field__origin") < СтрНайти(С_Ошибкой, "field__error"),
		"отказ — под строкой подсказки, как прежде: " + С_Ошибкой).ЭтоИстина();

КонецПроцедуры

// Поле без слова печатается байт в байт прежним — и с пустым источником тоже.
&Тест
Процедура ПолеБезИсточникаПечатаетсяПрежним() Экспорт

	Прежнее = Набор.Поле().Отрисовать(Новый Структура("Имя, Метка, Значение, Подсказка",
		"имя", "Имя проекта", "main", "латиница и дефис"));
	Ожидаем.Что(Прежнее, "поле с подсказкой — прежняя разметка").Равно(
		"<label class=""field""><span class=""field__label"">Имя проекта</span>"
		+ "<input class=""field__control"" type=""text"" name=""имя"" value=""main"">"
		+ "<span class=""field__hint"">латиница и дефис</span></label>");

	Ожидаем.Что(Кит.Поле("имя", "Имя проекта").Значение("main").Подсказка("латиница и дефис")
			.Источник("").Рендер(), "пустой источник — то же поле").Равно(Прежнее);

	Для Каждого Тип_ Из СтрРазделить("флажок,список,цвет", ",") Цикл
		Модель = Новый Структура("Имя, Метка, Тип, Подсказка", "п", "Поле", Тип_, "пояснение");
		Без = Набор.Поле().Отрисовать(Модель);
		Модель.Вставить("Источник", "");
		Ожидаем.Что(Набор.Поле().Отрисовать(Модель), Тип_ + ": пустой источник не меняет поле")
			.Равно(Без);
		Модель.Вставить("Источник", "по умолчанию");
		Ожидаем.Что(СтрНайти(Набор.Поле().Отрисовать(Модель),
				"<span class=""field__origin"">по умолчанию</span>") > 0,
			Тип_ + ": источник печатается и у этого вида поля").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// В объявленной форме слово то же: описание поля несёт источник до печати.
&Тест
Процедура ОбъявленноеПолеНесётИсточник() Экспорт

	Объявление = Формы.Новая();
	Объявление.Поле("host", "Почтовый сервер").Подсказка("Адрес SMTP")
		.Источник("по умолчанию · mail.host")
		.Поле("port", "Порт");
	HTML = Объявление.Отрисовать(Новый Структура("host", "smtp.example.org"), "/x", "т");

	Ожидаем.Что(СтрНайти(HTML, "Адрес SMTP<span class=""field__origin"">по умолчанию · mail.host</span>") > 0,
		"источник объявленного поля в строке подсказки: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "field__origin"), "и только у него").Равно(1);

КонецПроцедуры

// На телефоне источник уходит под подсказку: в узкой строке справа ему места нет, и он
// наезжал бы на текст подсказки или сжимал её в столбик из слов.
&Тест
Процедура НаТелефонеИсточникПереноситсяПодПодсказку() Экспорт

	Широкое = "";
	Узкое = "";
	Для Каждого Правило Из Разбор.ПравилаКласса("field__hint--origin") Цикл
		Значение = Правило.Объявления.Получить("flex-direction");
		Если Правило.Условия = "" Тогда
			Ожидаем.Что(НРег(Правило.Объявления.Получить("display")),
				"строка с источником — flex: подсказка и источник в один ряд").Равно("flex");
			Широкое = ?(Значение = Неопределено, "row", Значение);
		ИначеЕсли Разбор.ДействуетНаШирине(Правило.Условия, 390) И Значение <> Неопределено Тогда
			Узкое = Значение;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Широкое, "на широком — в ряд").Равно("row");
	Ожидаем.Что(Узкое, "на 390 px — столбиком: источник под подсказкой").Равно("column");

	Прижат = Ложь;
	Для Каждого Правило Из Разбор.ПравилаКласса("field__origin") Цикл
		Если Правило.Условия = "" И Правило.Объявления.Получить("margin-left") = "auto" Тогда
			Прижат = Истина;
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Прижат, "источник прижат к правому краю строки").ЭтоИстина();

КонецПроцедуры

#КонецОбласти
