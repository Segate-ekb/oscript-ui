// Графика кита лежит файлами: каталог глифов src/статика/иконки, по .svg на иконку.
// Проверяется то, что видит пользователь: каждая иконка каталога доезжает до разметки
// целой, чужой набор встаёт без правки кода, а огрызок вместо файла роняет чтение
// с внятным сообщением.

#Использовать "../"
#Использовать asserts

Перем Место;
Перем Набор;
Перем Значки;
Перем Чтение;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьГрафику() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	ПодключитьСценарий(ОбъединитьПути(КаталогТестов, "фикстуры", "СтатикаГлифов.os"), "СтатикаГлифов");

	Место = Новый РаскладкаСтатики(Новый СтатикаИнсталляцииПоУмолчанию());
	Чтение = Новый ЧтениеГлифа();
	Набор = Новый НаборИконок(Место, Чтение);
	Значки = Новый Иконка(Новый ЭкранированиеHTML(), Набор, Новый ЧтениеМодели());

КонецПроцедуры

#Область СверкаКаталогаИНабора

// Двусторонне: осиротевший файл и повисшее в наборе имя одинаково краснят. Односторонняя
// сверка пропускает ровно ту поломку, ради которой заведена, — файл лежит, а набор его
// не видит (маска, регистр, разбор), и значок молча исчезает со страницы.
&Тест
Процедура КаталогГлифовИНаборСверяютсяДвусторонне() Экспорт

	НаДиске = ИменаФайловКаталога();
	ВНаборе = Новый Соответствие();
	Для Каждого Имя Из Набор.Имена() Цикл
		ВНаборе.Вставить(Имя, Истина);
	КонецЦикла;

	Расхождения = Новый Массив();

	Для Каждого КиЗ Из НаДиске Цикл
		Если ВНаборе.Получить(КиЗ.Ключ) = Неопределено Тогда
			Расхождения.Добавить(КиЗ.Ключ + ".svg — файл есть, а набор его не видит");
		КонецЕсли;
	КонецЦикла;

	Для Каждого КиЗ Из ВНаборе Цикл
		Если НаДиске.Получить(КиЗ.Ключ) = Неопределено Тогда
			Расхождения.Добавить(КиЗ.Ключ + " — имя в наборе есть, а файла нет");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, Символы.ПС),
		"каталог глифов и набор разошлись").Равно("");

	Ожидаем.Что(НаДиске.Количество() >= 30,
		СтрШаблон("глифов в каталоге: %1 — скан ослеп", НаДиске.Количество())).ЭтоИстина();
	Ожидаем.Что(ВНаборе.Количество()).Равно(НаДиске.Количество());

КонецПроцедуры

// Файл может лежать и разбираться, но быть пустым огрызком. Холст и рисунок проверяются
// у КАЖДОГО глифа: без холста иконку некуда вписать, без рисунка нечего показывать.
&Тест
Процедура УКаждогоГлифаЕстьХолстИРисунок() Экспорт

	Пустые = Новый Массив();

	Для Каждого Имя Из Набор.Имена() Цикл

		Холст = Набор.Холст(Имя);
		Если СтрРазделить(Холст, " ", Ложь).Количество() <> 4 Тогда
			Пустые.Добавить(Имя + " — холст «" + Холст + "» не четыре числа");
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(Набор.Содержимое(Имя)) Тогда
			Пустые.Добавить(Имя + " — рисунка нет вовсе");
		ИначеЕсли СтрНайти(Набор.Содержимое(Имя), "<") = 0 Тогда
			Пустые.Добавить(Имя + " — в рисунке нет ни одного элемента");
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пустые, Символы.ПС), "глифы без холста или без рисунка").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ИконкаДоезжаетДоРазметки

// Сторож на ВЫДАЧЕ, а не на тексте исходника: в проекте уже был случай, когда значки
// пропали с экрана при зелёном наборе. Каждая иконка каталога рисуется, и в разметке
// оказывается холст и рисунок ЕЁ файла.
&Тест
Процедура КаждаяИконкаДоезжаетДоРазметки() Экспорт

	Поломанные = Новый Массив();

	Для Каждого Имя Из Набор.Имена() Цикл

		HTML = Значки.Отрисовать(Новый Структура("Имя, Подпись", Имя, "подпись " + Имя));

		Если СтрНайти(HTML, "<svg") = 0 ИЛИ СтрНайти(HTML, "</svg>") = 0 Тогда
			Поломанные.Добавить(Имя + " — до разметки не доехала: " + Лев(HTML, 40));
			Продолжить;
		КонецЕсли;

		Если СтрНайти(HTML, "viewBox=""" + Набор.Холст(Имя) + """") = 0 Тогда
			Поломанные.Добавить(Имя + " — в разметке не холст её файла");
		КонецЕсли;

		Если СтрНайти(HTML, Набор.Содержимое(Имя)) = 0 Тогда
			Поломанные.Добавить(Имя + " — рисунок файла в разметку не попал");
		КонецЕсли;

		Если СтрНайти(HTML, "fill=""currentColor""") = 0 Тогда
			Поломанные.Добавить(Имя + " — цвет не наследуется");
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Поломанные, Символы.ПС),
		"иконки, не доехавшие до разметки целыми").Равно("");

КонецПроцедуры

// Холст берётся ИЗ ФАЙЛА: иконка чужого набора со своим viewBox обязана вставать без
// правки кода — ради этого вынос и делался. Случай «нарисована не контуром» проверяется
// отдельно, ниже: отрисовка больше не гейтится наличием <path>.
&Тест
Процедура ЧужойНаборВстаётБезПравкиКода() Экспорт

	Каталог = ВременныйКаталог();
	Попытка

		ЗаписатьФайл(ОбъединитьПути(Каталог, "звезда.svg"),
			"<svg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 24 24"">"
			+ "<circle cx=""12"" cy=""12"" r=""9""></circle>"
			+ "<path d=""M12 3v18""></path></svg>");

		Чужой = Новый НаборИконок(Новый СтатикаГлифов(Каталог), Чтение);
		Рисование = Новый Иконка(Новый ЭкранированиеHTML(), Чужой, Новый ЧтениеМодели());

		Ожидаем.Что(Чужой.Холст("звезда"), "холст взят из файла").Равно("0 0 24 24");
		Ожидаем.Что(Чужой.Контур("звезда"), "контур первого <path>").Равно("M12 3v18");

		HTML = Рисование.Отрисовать("звезда");
		Ожидаем.Что(СтрНайти(HTML, "viewBox=""0 0 24 24""") > 0, "чужой холст в разметке").ЭтоИстина();
		Ожидаем.Что(СтрНайти(HTML, "0 0 256 256"), "прежний холст константой не подставлен").Равно(0);
		Ожидаем.Что(СтрНайти(HTML, "<circle") > 0, "не-контурный элемент нарисован").ЭтоИстина();
		Ожидаем.Что(СтрНайти(HTML, "<path d=""M12 3v18""") > 0, "и контур рядом с ним").ЭтоИстина();

	Исключение
		УдалитьВременный(Каталог);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьВременный(Каталог);

КонецПроцедуры

// Глиф без единого <path>: Контур у него Неопределено, и раньше ровно это возвращало
// пустую строку вместо иконки. Отрисовка гейтится наличием ГЛИФА, а не контура.
&Тест
Процедура ГлифБезКонтураВсёРавноРисуется() Экспорт

	Каталог = ВременныйКаталог();
	Попытка

		ЗаписатьФайл(ОбъединитьПути(Каталог, "кольцо.svg"),
			"<svg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 20 20"">"
			+ "<circle cx=""10"" cy=""10"" r=""8""></circle></svg>");

		Чужой = Новый НаборИконок(Новый СтатикаГлифов(Каталог), Чтение);
		Рисование = Новый Иконка(Новый ЭкранированиеHTML(), Чужой, Новый ЧтениеМодели());

		Ожидаем.Что(Чужой.Содержит("кольцо"), "глиф без контура в наборе есть").ЭтоИстина();
		Ожидаем.Что(Чужой.Контур("кольцо"), "контура у него нет").Равно(Неопределено);

		HTML = Рисование.Отрисовать("кольцо");
		Ожидаем.Что(ЗначениеЗаполнено(HTML), "и он всё равно нарисован").ЭтоИстина();
		Ожидаем.Что(СтрНайти(HTML, "<circle cx=""10""") > 0, "рисунком, а не пустотой").ЭтоИстина();
		Ожидаем.Что(СтрНайти(HTML, "viewBox=""0 0 20 20""") > 0, "на своём холсте").ЭтоИстина();

	Исключение
		УдалитьВременный(Каталог);
		ВызватьИсключение;
	КонецПопытки;

	УдалитьВременный(Каталог);

КонецПроцедуры

#КонецОбласти

#Область ЧтениеГлифа

// Служебные элементы редакторов рисунка не несут: их снимают, а не роняют ими старт хаба.
// Экспорт из Figma или Inkscape содержит <title>/<desc>/<metadata> почти всегда.
&Тест
Процедура СлужебныеЭлементыРедактораСнимаются() Экспорт

	Разбор = Чтение.Прочитать(ВокругSVG(
		"<title>Иконка</title><desc>Нарисовано в редакторе</desc>"
		+ "<metadata><rdf/></metadata><path d=""M0 0h24""></path>"), "изредактора.svg");

	Ожидаем.Что(СтрНайти(НРег(Разбор.Содержимое), "<title"), "подпись файла снята").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Разбор.Содержимое), "<desc"), "описание снято").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Разбор.Содержимое), "<metadata"), "и метаданные тоже").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(Разбор.Содержимое), "<rdf"), "вместе с их содержимым").Равно(0);
	Ожидаем.Что(Разбор.Контур, "рисунок при этом цел").Равно("M0 0h24");

	// имя сверяется целиком: «<title» не должно резать чужой элемент
	Похожий = Чтение.Прочитать(ВокругSVG("<path d=""M0 0"" title-like=""1""></path>"), "похожий.svg");
	Ожидаем.Что(Похожий.Контур, "элемент с похожим именем цел").Равно("M0 0");

КонецПроцедуры

// Огрызок вместо файла — тоже поломка: без viewBox иконку некуда вписать, без рисунка
// нечего показывать, и обе беды обязаны быть громкими, а не пустой строкой на странице.
&Тест
Процедура ОгрызокВместоГлифаРоняетЧтение() Экспорт

	Ожидаем.Что(ЧтениеУпало("<svg xmlns=""http://www.w3.org/2000/svg"">"
		+ "<path d=""M0 0""></path></svg>", "безхолста.svg"), "нет viewBox").ЭтоИстина();
	Ожидаем.Что(ЧтениеУпало(ВокругSVG(""), "пустой.svg"), "нет рисунка").ЭтоИстина();
	Ожидаем.Что(ЧтениеУпало("<html><body>не картинка</body></html>", "чужой.svg"),
		"это вообще не SVG").ЭтоИстина();
	Ожидаем.Что(ЧтениеУпало("<svg viewBox=""0 0 24 24""><path d=""M0 0""></path>", "обрубок.svg"),
		"нет закрывающего тега").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область РазрешениеНаГлифы

// Разрешение на использование чужого набора рисунков лежит В КАТАЛОГЕ ГЛИФОВ: тот, кто
// открыл каталог, видит его сразу, а не ищет по дереву. Отдаётся оно вместе с китом —
// авторство указывается в файле, а не только в комментарии.
&Тест
Процедура РазрешениеНаРисункиЛежитРядомСГлифами() Экспорт

	Активы = Новый АктивыСтатики(Место, Новый ОтпечаткиСтатики(Место));
	Имя = Место.ФайлЛицензииИконок();
	Файл = Новый Файл(ОбъединитьПути(Место.КаталогГлифов(), Имя));

	Ожидаем.Что(Файл.Существует(), "текст разрешения в каталоге глифов: " + Имя).ЭтоИстина();
	Ожидаем.Что(Файл.Размер() > 500, "и он не пустой").ЭтоИстина();
	Ожидаем.Что(Активы.ОтносительныйПуть(Имя), "путь ведёт в каталог глифов")
		.Равно(Место.ПодкаталогГлифов() + "/" + Имя);
	Ожидаем.Что(Активы.ТипКонтента(Активы.ПубличноеИмя(Имя)) <> Неопределено,
		"и кит его отдаёт").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИменаФайловКаталога()

	Результат = Новый Соответствие();
	Для Каждого Файл Из НайтиФайлы(Место.КаталогГлифов(), "*.svg") Цикл
		Если Файл.ЭтоФайл() Тогда
			Результат.Вставить(НРег(Файл.ИмяБезРасширения), Файл.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ВокругSVG(Знач Разметка)
	Возврат "<svg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 24 24"">"
		+ Разметка + "</svg>";
КонецФункции

Функция ЧтениеУпало(Знач Текст, Знач Источник)
	Попытка
		Разбор = Чтение.Прочитать(Текст, Источник);
		Разбор = Разбор;
		Возврат Ложь;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

Функция ВременныйКаталог()
	Путь = ОбъединитьПути(КаталогВременныхФайлов(),
		"кит-глифы-" + Строка(Новый УникальныйИдентификатор()));
	СоздатьКаталог(Путь);
	Возврат Путь;
КонецФункции

Процедура УдалитьВременный(Знач Путь)
	Попытка
		УдалитьФайлы(Путь);
	Исключение
	КонецПопытки;
КонецПроцедуры

Процедура ЗаписатьФайл(Знач Путь, Знач Текст)
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

#КонецОбласти
