// Граница кита после выноса в библиотеку держится ПОСТАВКОЙ, а не графом имён: класс,
// не объявленный в lib.config, у потребителя не зарегистрируется и желудём не станет —
// падение приедет не в «Новый», а в чужой НайтиЖелудь. Здесь же белый список библиотек,
// которые киту разрешено подключать, и правило пустышек перебиваемых контрактов.

#Использовать asserts

Перем КореньРепозитория;
Перем КаталогКлассов;

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	КореньРепозитория = Новый Файл(ОбъединитьПути(КаталогТестов, "..")).ПолноеИмя;
	КаталогКлассов = ОбъединитьПути(КореньРепозитория, "src", "Классы");

КонецПроцедуры

// Класс, которого нет в lib.config, приезжает потребителю невидимым: #Использовать его
// не зарегистрирует, желудём он не станет, и зависимый желудь упадёт при сборке — то есть
// в рантайме и в другом месте. Сверка ДВУСТОРОННЯЯ: висячая строка манифеста роняет
// установку пакета целиком.
&Тест
Процедура КаждыйКлассКитаОбъявленВПоставке() Экспорт

	ВМанифесте = КлассыМанифеста();
	Расхождения = Новый Массив();
	Файлов = 0;

	Для Каждого Файл Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл

		Если НЕ Файл.ЭтоФайл() Тогда
			Продолжить;
		КонецЕсли;

		Файлов = Файлов + 1;
		Путь = ВМанифесте.Получить(Файл.ИмяБезРасширения);
		Если Путь = Неопределено Тогда
			Расхождения.Добавить(Файл.ИмяБезРасширения
				+ " — файл есть, в lib.config его нет: потребителю класс не приедет");
		ИначеЕсли Новый Файл(ОбъединитьПути(КореньРепозитория, Путь)).ПолноеИмя <> Файл.ПолноеИмя Тогда
			Расхождения.Добавить(Файл.ИмяБезРасширения
				+ " — манифест ведёт на " + Путь);
		КонецЕсли;

	КонецЦикла;

	Для Каждого КиЗ Из ВМанифесте Цикл
		Если НЕ Новый Файл(ОбъединитьПути(КореньРепозитория, КиЗ.Значение)).Существует() Тогда
			Расхождения.Добавить(КиЗ.Ключ + " — объявлен в lib.config, а файла нет");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, Символы.ПС),
		"классы кита и поставка разошлись").Равно("");

	Ожидаем.Что(Файлов >= 50,
		СтрШаблон("классов в ките: %1 — скан ослеп", Файлов)).ЭтоИстина();
	Ожидаем.Что(ВМанифесте.Количество()).Равно(Файлов);

КонецПроцедуры

// Кит самодостаточен: единственная библиотека, которую он подключает директивой, —
// html-sanitizer, и она объявлена зависимостью в packagedef. Любая другая означает,
// что вместе с китом потребитель тянет то, о чём не просил.
&Тест
Процедура КитНеОбъявляетБиблиотекВнеБелогоСписка() Экспорт

	Разрешённые = Новый Массив();
	Разрешённые.Добавить("html-sanitizer");

	Лишние = Новый Массив();
	Найдено = 0;

	Для Каждого Файл Из НайтиФайлы(КаталогКлассов, "*.os", Истина) Цикл
		Для Каждого Библиотека Из БиблиотекиИзТекста(ПрочитатьТекст(Файл.ПолноеИмя)) Цикл
			Найдено = Найдено + 1;
			Если Разрешённые.Найти(Библиотека) = Неопределено Тогда
				Лишние.Добавить(Файл.Имя + " -> " + Библиотека);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Лишние, ", "),
		"директивы #Использовать кита вне белого списка").Равно("");
	Ожидаем.Что(Найдено > 0, "детектор директив ослеп: ни одной не нашлось").ЭтоИстина();

	Для Каждого Имя Из Разрешённые Цикл
		Ожидаем.Что(СтрНайти(ПрочитатьТекст(ОбъединитьПути(КореньРепозитория, "packagedef")),
			".ЗависитОт(""" + Имя + """") > 0,
			"библиотека из белого списка объявлена зависимостью: " + Имя).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Пустышка перебиваемого контракта обязана объявлять ПРОЗВИЩЕ и не быть &Верховной:
// имя класса контрактом быть не может (ОСень ищет желудь сперва по имени), а верховная
// пустышка не перебивается реализацией инсталляции — приложение молча остаётся на пустом
// словаре и рисует экраны в маркерах «[?ключ]».
&Тест
Процедура ПустышкиКонтрактовОбъявленыПрозвищемИНеВерховны() Экспорт

	Нарушения = Новый Массив();
	Пустышек = 0;

	Для Каждого Файл Из НайтиФайлы(КаталогКлассов, "*ПоУмолчанию.os", Истина) Цикл

		Пустышек = Пустышек + 1;
		Текст = БезКомментариев(ПрочитатьТекст(Файл.ПолноеИмя));

		Если СтрНайти(Текст, "&Прозвище(") = 0 Тогда
			Нарушения.Добавить(Файл.ИмяБезРасширения + " — без прозвища контракт не перебить");
		КонецЕсли;
		Если СтрНайти(Текст, "&Верховный") > 0 Тогда
			Нарушения.Добавить(Файл.ИмяБезРасширения + " — &Верховная пустышка не перебивается");
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушения, Символы.ПС),
		"пустышки перебиваемых контрактов кита").Равно("");
	Ожидаем.Что(Пустышек >= 3,
		СтрШаблон("пустышек найдено %1 — скан ослеп", Пустышек)).ЭтоИстина();

КонецПроцедуры

// Самотест детекторов: закомментированная директива и имя библиотеки в литерале —
// не подключение. Обе стороны ошибки стоили проекту волны: сканер, читающий литерал
// как код, даёт и ложную защиту, и ложный отказ.
&Тест
Процедура ДетекторДирективНеВидитИхВКомментарииИЛитерале() Экспорт

	Живая = БиблиотекиИзТекста("#Использовать html-sanitizer" + Символы.ПС + "Перем Х;");
	Ожидаем.Что(Живая.Количество(), "живая директива видна").Равно(1);

	Закомментированная = БиблиотекиИзТекста("// #Использовать чужая" + Символы.ПС
		+ "Текст = ""#Использовать другая"";");
	Ожидаем.Что(Закомментированная.Количество(),
		"директива в комментарии и в литерале подключением не является").Равно(0);

КонецПроцедуры

#Область Детекторы

// Директива читается ТОЛЬКО как первый значимый токен строки: строковый литерал первым
// токеном строки быть не может, поэтому текст внутри кавычек детектор не подхватывает.
Функция БиблиотекиИзТекста(Знач Текст)

	Результат = Новый Массив();

	Для Каждого Строка_ Из СтрРазделить(БезКомментариев(Текст), Символы.ПС, Истина) Цикл

		Очищенная = СокрЛП(Строка_);
		Если НЕ СтрНачинаетсяС(Очищенная, "#Использовать") Тогда
			Продолжить;
		КонецЕсли;

		Имя = СокрЛП(Сред(Очищенная, СтрДлина("#Использовать") + 1));
		Если ЗначениеЗаполнено(Имя) И Лев(Имя, 1) <> """" Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Комментарии снимаются построчно с учётом литералов: «//» внутри кавычек комментария
// не открывает.
Функция БезКомментариев(Знач Текст)

	Строки = Новый Массив();
	Для Каждого Строка_ Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Строки.Добавить(БезХвостовогоКомментария(Строка_));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция БезХвостовогоКомментария(Знач Строка_)

	ВЛитерале = Ложь;
	Для Позиция = 1 По СтрДлина(Строка_) Цикл

		Символ = Сред(Строка_, Позиция, 1);
		Если Символ = """" Тогда
			ВЛитерале = НЕ ВЛитерале;
		ИначеЕсли НЕ ВЛитерале И Символ = "/" И Сред(Строка_, Позиция + 1, 1) = "/" Тогда
			Возврат Лев(Строка_, Позиция - 1);
		КонецЕсли;

	КонецЦикла;

	Возврат Строка_;

КонецФункции

Функция КлассыМанифеста()

	Результат = Новый Соответствие();
	Текст = ПрочитатьТекст(ОбъединитьПути(КореньРепозитория, "lib.config"));

	Позиция = 1;
	Пока Истина Цикл

		Начало = СтрНайти(Текст, "<class ", , Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		Конец = СтрНайти(Текст, "/>", , Начало);
		Объявление = Сред(Текст, Начало, Конец - Начало);
		Результат.Вставить(Атрибут(Объявление, "name"), Атрибут(Объявление, "file"));
		Позиция = Конец + 1;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Атрибут(Знач Объявление, Знач Имя)

	Начало = СтрНайти(Объявление, Имя + "=""");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Объявление, Начало + СтрДлина(Имя) + 2);
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

Функция ПрочитатьТекст(Знач ПолныйПуть)

	Поток = Новый ЧтениеТекста(ПолныйПуть, КодировкаТекста.UTF8);
	Результат = Поток.Прочитать();
	Поток.Закрыть();
	Возврат ?(Результат = Неопределено, "", Результат);

КонецФункции

#КонецОбласти
