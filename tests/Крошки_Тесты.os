// Крошки: путь от корня к текущей странице. Проверяется то, что ломается для человека:
// последняя крошка ведёт на ту же страницу, скринридер не слышит «текущая страница»,
// навигация безымянна, узел печатает не то, что компонент строкой.

#Использовать "../"
#Использовать asserts

Перем Кит;   // Кит
Перем Набор; // НаборКомпонентов

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Кит = Слой.Кит;
	Набор = Слой.Набор;

КонецПроцедуры

// Последняя крошка — страница, на которой человек стоит: ссылки на неё нет, адрес из
// модели не печатается, а пункт помечен aria-current.
&Тест
Процедура ПоследнийПунктТекущийИБезСсылки() Экспорт

	HTML = Набор.Крошки().Отрисовать(Пункты());

	Ожидаем.Что(СтрНайти(HTML, "href=""/проекты/альфа/ключи"""),
		"ссылки на текущую страницу нет: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<li class=""crumbs__item"" aria-current=""page"">Ключи</li></ul>") > 0,
		"последний пункт — текущий, текстом: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "aria-current"), "текущий пункт один").Равно(1);
	Ожидаем.Что(СтрНайти(HTML,
			"<li class=""crumbs__item""><a href=""/проекты"" class=""crumbs__link"">Проекты</a></li>") > 0,
		"остальные — ссылки: " + HTML).ЭтоИстина();

КонецПроцедуры

// Навигацию на странице бывает несколько, и безымянная читается как «навигация» — одна
// из многих. Имя по умолчанию берётся из словаря инсталляции, своё задаёт Подпись.
&Тест
Процедура ИмяНавигацииИзСловаря() Экспорт

	HTML = Набор.Крошки().Отрисовать(Пункты());
	Ожидаем.Что(СтрНайти(HTML, "<nav class=""crumbs"" aria-label=""Путь к странице"">") > 0,
		"слово словаря chrome.crumbs: " + HTML).ЭтоИстина();

	Своё = Набор.Крошки().Отрисовать(Новый Структура("Пункты, Подпись", Пункты(), "Где вы"));
	Ожидаем.Что(СтрНайти(Своё, "aria-label=""Где вы""") > 0, "своё имя: " + Своё).ЭтоИстина();

КонецПроцедуры

// Пустой путь не печатается: рамка без пунктов ни о чём не говорит.
&Тест
Процедура ПустыеКрошкиНеПечатаются() Экспорт

	Ожидаем.Что(Набор.Крошки().Отрисовать(Новый Массив()), "пустой массив").Равно("");
	Ожидаем.Что(Набор.Крошки().Отрисовать(Новый Структура()), "модель без пунктов").Равно("");
	Ожидаем.Что(Кит.Крошки().Рендер(), "узел без крошек").Равно("");

КонецПроцедуры

// Подпись крошки — данные, а не разметка.
&Тест
Процедура ПодписьКрошкиЭкранируется() Экспорт

	Пункты = Новый Массив();
	Пункты.Добавить(Новый Структура("Подпись, Адрес", "<b>Проекты</b>", "/проекты"));
	Пункты.Добавить(Новый Структура("Подпись", "<i>альфа</i>"));
	HTML = Набор.Крошки().Отрисовать(Пункты);

	Ожидаем.Что(СтрНайти(HTML, "<b>") + СтрНайти(HTML, "<i>"), "тегов из данных нет: " + HTML)
		.Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;i&gt;альфа&lt;/i&gt;") > 0, "текст экранирован").ЭтоИстина();

КонецПроцедуры

// Узел печатает байт в байт то же, что компонент строкой: крошки — дети узла, имя
// навигации — слово Подпись.
&Тест
Процедура УзелКрошекРавенКомпонентуСтрокой() Экспорт

	Узлом = Кит.Крошки(
		Кит.Крошка("Проекты", "/проекты"),
		Кит.Крошка("альфа", "/проекты/альфа"),
		Кит.Крошка("Ключи", "/проекты/альфа/ключи")).Подпись("Где вы").Рендер();

	Ожидаем.Что(Узлом, "байт в байт").Равно(Набор.Крошки().Отрисовать(
		Новый Структура("Пункты, Подпись", Пункты(), "Где вы")));
	Ожидаем.Что(Кит.Крошки(Новый Структура("Пункты", Пункты())).Рендер(),
		"прежний вид модели — та же разметка").Равно(Набор.Крошки().Отрисовать(Пункты()));

КонецПроцедуры

// В крошки кладут крошки: кнопка в строке пути не напечаталась бы вовсе, а крошка вне
// крошек — пункт без списка.
&Тест
Процедура ВКрошкиКладутТолькоКрошку() Экспорт

	Отказ = "";
	Попытка
		Кит.Крошки(Кит.Кнопка("Назад"));
	Исключение
		Отказ = ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Отказ, "Кит.Крошка") > 0, "отказ называет лекарство: " + Отказ).ЭтоИстина();

	Отказ = "";
	Попытка
		Кит.Холст(Кит.Крошка("Проекты", "/проекты")).Рендер();
	Исключение
		Отказ = ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Ожидаем.Что(Отказ, "крошка вне крошек не печатается").Заполнено();

КонецПроцедуры

// Неизвестное слово крошек останавливает сборку с перечнем известных.
&Тест
Процедура НеизвестноеСловоКрошекОтвергается() Экспорт

	Отказ = "";
	Попытка
		Кит.Крошки(Кит.Крошка("Проекты")).Иконка("дом");
	Исключение
		Отказ = ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Отказ, "Подпись") > 0, "отказ перечисляет слова: " + Отказ).ЭтоИстина();

КонецПроцедуры

Функция Пункты()

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Подпись, Адрес", "Проекты", "/проекты"));
	Результат.Добавить(Новый Структура("Подпись, Адрес", "альфа", "/проекты/альфа"));
	Результат.Добавить(Новый Структура("Подпись, Адрес", "Ключи", "/проекты/альфа/ключи"));
	Возврат Результат;

КонецФункции
