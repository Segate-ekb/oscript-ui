// Реестр и запись реестра: немногие записи со сводкой, действиями снаружи и телом.
// Проверяется то, что ломается для человека: меню ⚙ и кнопки внизу расходятся, потому что
// печатаются из разных списков; тумблер оказывается внутри <summary> и раскрывает запись;
// без скрипта тумблер нечем отправить; номер и значок пропадают; пустой реестр печатает
// пустую рамку вместо объяснения.

#Использовать "../"
#Использовать asserts

Перем Кит;   // Кит

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");

	Кит = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы()).Кит;

КонецПроцедуры

#Область НаборДействий

// Меню ⚙ и кнопки внизу тела — один набор: каждое действие печатается дважды одной и той
// же разметкой, и добавленное в набор появляется в обоих местах сразу.
&Тест
Процедура МенюИКнопкиПечатаютсяИзОдногоНабора() Экспорт

	HTML = Кит.Реестр(Почта()).Токен("т0кен").Рендер();

	Изменить = "<a href=""/почта"" class=""button button--ghost"">";
	Удалить = "<form method=""post"" action=""/почта/удалить""><input type=""hidden"" name=""_csrf"" value=""т0кен"">"
		+ "<button type=""submit"" class=""button button--danger""";
	Ожидаем.Что(СтрЧислоВхождений(HTML, Изменить), "ссылка набора — в меню и внизу: " + HTML).Равно(2);
	Ожидаем.Что(СтрЧислоВхождений(HTML, Удалить), "форма набора — в меню и внизу: " + HTML).Равно(2);

	Меню = Между(HTML, "<div class=""entry__gear"">", "</div></div></div>");
	Низ = Между(HTML, "<div class=""entry__buttons"">", "</div></div></details>");
	Ожидаем.Что(СтрНайти(Меню, Изменить) > 0 И СтрНайти(Меню, Удалить) > 0,
		"меню ⚙ из набора: " + Меню).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Низ, Изменить) > 0 И СтрНайти(Низ, Удалить) > 0,
		"кнопки внизу из набора: " + Низ).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Низ, Изменить) < СтрНайти(Низ, Удалить), "порядок набора сохранён").ЭтоИстина();

	Ожидаем.Что(СтрНайти(Меню, "aria-label=""Действия: Почта""") > 0,
		"имя меню — из словаря с именем записи: " + Меню).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Меню, "<p class=""menu__title"">Действия: Почта</p>") > 0,
		"заголовок листа меню на телефоне").ЭтоИстина();

КонецПроцедуры

// Без набора нет ни меню, ни черты с кнопками внизу: кнопка, открывающая пустоту, —
// сломанный экран.
&Тест
Процедура БезНабораНетНиМенюНиКнопок() Экспорт

	HTML = Кит.Реестр(Кит.ЗаписьРеестра("Чат", Кит.Свойства(Кит.Свойство("канал", "#сборки"))))
		.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "entry__gear"), "меню нет: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "entry__buttons"), "кнопок внизу нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "entry__actions"), "пустого ряда действий нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Разметка

// Запись — пункт списка: действия стоят перед раскрывашкой и вне <summary> (тумблер в
// свёрнутой строке раскрывал бы запись), тело — подробности, раскрытие — нативный <details>.
&Тест
Процедура ДействияВнеСводкиПередРаскрывашкой() Экспорт

	HTML = Кит.Реестр(Почта()).Токен("т0кен").Рендер();

	Ожидаем.Что(СтрНачинаетсяС(HTML, "<ul class=""entries""><li class=""entry""><div class=""entry__actions"">"
		+ "<form method=""post"" action=""/почта/вкл"">"), "действия первыми в пункте: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "</div><details class=""panel entry__panel""><summary class=""panel__head entry__head"">") > 0,
		"раскрывашка-панель за действиями").ЭтоИстина();

	Сводка = Между(HTML, "<summary", "</summary>");
	Ожидаем.Что(СтрНайти(Сводка, "<input"), "в сводке нет полей: " + Сводка).Равно(0);
	Ожидаем.Что(СтрНайти(Сводка, "<button"), "в сводке нет кнопок").Равно(0);
	Ожидаем.Что(СтрНайти(Сводка, "<span class=""brief""><span class=""brief__head""><span class=""brief__name"">Почта</span>"
		+ "<span class=""tag tag--ok"">работает</span></span><span class=""brief__sub"">SMTP · TLS</span>"
		+ "<span class=""brief__facts""><span class=""brief__fact""><span class=""brief__label"">отправлено</span>"
		+ "<span class=""brief__value"">12 писем</span></span></span></span>") > 0,
		"сводка — компонентом «Сводка»: " + Сводка).ЭтоИстина();

	Ожидаем.Что(СтрНайти(HTML, "<div class=""panel__body""><dl class=""props""><dt>сервер</dt>") > 0,
		"тело — дети записи").ЭтоИстина();
	Ожидаем.Что(СтрЗаканчиваетсяНа(HTML, "</div></div></details></li></ul>"), "кнопки внизу тела").ЭтоИстина();

КонецПроцедуры

// Без скрипта тумблер с СохранятьСразу отправляет только кнопка его формы: она печатается
// всегда, прячет её лист стилей там, где скрипт есть.
&Тест
Процедура ТумблерОтправляетсяБезСкрипта() Экспорт

	Действия = Между(Кит.Реестр(Почта()).Токен("т0кен").Рендер(), "<div class=""entry__actions"">", "<div class=""entry__gear"">");

	Ожидаем.Что(СтрНайти(Действия, "data-autosubmit") > 0, "тумблер отправляет по изменению: " + Действия).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Действия, "<button type=""submit"" class=""button") > 0, "кнопка формы на месте").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Действия, "<span class=""toggle__label"">Почта включена</span>") > 0,
		"у тумблера есть имя для скринридера").ЭтоИстина();

КонецПроцедуры

// Раскрытость — у <details>, а не у пункта списка: open на <li> браузер выбросил бы.
&Тест
Процедура ОткрытьРаскрываетПанель() Экспорт

	HTML = Кит.Реестр(Почта().Открыть()).Токен("т0кен").Рендер();
	Ожидаем.Что(СтрНайти(HTML, "<details class=""panel entry__panel"" open>") > 0, "раскрыта: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<li class=""entry"" open"), "у пункта open нет").Равно(0);

	Свёрнутая = Кит.Реестр(Почта()).Токен("т0кен").Рендер();
	Ожидаем.Что(СтрНайти(Свёрнутая, " open"), "по умолчанию свёрнута").Равно(0);

КонецПроцедуры

// Запись без тела и без набора раскрывать нечем: строка печатается без <details>.
&Тест
Процедура ЗаписьБезПодробностейНеРаскрывается() Экспорт

	HTML = Кит.Реестр(Кит.ЗаписьРеестра("Анна").Подпись("anna@example.org")).Рендер();

	Ожидаем.Что(HTML, "строка панели без раскрывашки").Равно("<ul class=""entries""><li class=""entry"">"
		+ "<div class=""panel entry__panel""><div class=""panel__head entry__head""><span class=""brief"">"
		+ "<span class=""brief__head""><span class=""brief__name"">Анна</span></span>"
		+ "<span class=""brief__sub"">anna@example.org</span></span></div></div></li></ul>");

КонецПроцедуры

// Имя записи — данные: оно экранируется и в сводке, и в имени меню.
&Тест
Процедура ИмяЗаписиЭкранируется() Экспорт

	HTML = Кит.Реестр(Кит.ЗаписьРеестра("<b>&")
		.Кнопки(Кит.Кнопка("Изменить").Адрес("/x"))).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<b>"), "сырой разметки нет: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<span class=""brief__name"">&lt;b&gt;&amp;</span>") > 0, "в сводке").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "aria-label=""Действия: &lt;b&gt;&amp;""") > 0, "в имени меню").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область НомерИЗначок

// Нумерованный реестр — <ol>, номера по порядку перед значком; свой Номер старше
// порядкового. Значок — глиф кита в свёрнутой строке, декоративный.
&Тест
Процедура НомерИЗначокНаМесте() Экспорт

	HTML = Кит.Реестр(
		Кит.ЗаписьРеестра("первый").Значок("ключ"),
		Кит.ЗаписьРеестра("второй"),
		Кит.ЗаписьРеестра("особый").Номер(7))
		.Нумерованный().Подпись("Источники").Рендер();

	Ожидаем.Что(СтрНачинаетсяС(HTML, "<ol class=""entries"" aria-label=""Источники"">"),
		"нумерованный — <ol> с именем: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<div class=""panel__head entry__head""><span class=""entry__num"">1</span>"
		+ "<svg class=""icon entry__icon"" ") > 0, "номер, за ним значок: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "aria-hidden=""true""") > 0, "значок декоративен").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""entry__num"">2</span><span class=""brief"">") > 0,
		"без значка номер прямо перед сводкой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""entry__num"">7</span>") > 0, "свой номер").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""entry__num"">3</span>"), "порядковый уступил своему").Равно(0);

	Простой = Кит.Реестр(Кит.ЗаписьРеестра("первый")).Рендер();
	Ожидаем.Что(СтрНачинаетсяС(Простой, "<ul class=""entries"">"), "без нумерации — <ul>").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Простой, "entry__num"), "и номеров нет").Равно(0);

КонецПроцедуры

// Картинка инсталляции старше глифа; декоративна, с размерами, без опасной схемы.
&Тест
Процедура КартинкаВместоЗначка() Экспорт

	HTML = Кит.Реестр(Кит.ЗаписьРеестра("каталог").Значок("ключ").Картинка("/знак.svg")).Рендер();
	Ожидаем.Что(СтрНайти(HTML, "<img class=""entry__image"" src=""/знак.svg"" alt="""" width=""24"" height=""24"">") > 0,
		"картинка: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "entry__icon"), "глиф уступил картинке").Равно(0);

	Опасная = Кит.Реестр(Кит.ЗаписьРеестра("каталог").Картинка("javascript:alert(1)")).Рендер();
	Ожидаем.Что(СтрНайти(Опасная, "<img"), "опасная схема не печатается: " + Опасная).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Пусто

// Пустой реестр — объяснение, а не пустая рамка списка: пустое состояние с текстом словаря,
// своим текстом или своими узлами.
&Тест
Процедура ПустойРеестрДаётПустоеСостояние() Экспорт

	HTML = Кит.Реестр().Рендер();
	Ожидаем.Что(СтрНачинаетсяС(HTML, "<div class=""empty empty--compact"">"), "пустое состояние: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<p class=""empty__text"">Записей пока нет</p>") > 0, "текст словаря").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "entries"), "рамки списка нет").Равно(0);

	Свой = Кит.Реестр().Пусто("Подключений пока нет").Рендер();
	Ожидаем.Что(СтрНайти(Свой, "<p class=""empty__text"">Подключений пока нет</p>") > 0, "свой текст: " + Свой).ЭтоИстина();

	Узлы = Кит.Реестр().Пусто(Кит.Примечание("Ничего"), Кит.Кнопка("Добавить").Адрес("/новый")).Рендер();
	Ожидаем.Что(СтрНачинаетсяС(Узлы, "<p class=""muted"">Ничего</p><a href=""/новый"""), "свои узлы: " + Узлы).ЭтоИстина();

	Скрытые = Кит.Реестр(Кит.ЗаписьРеестра("скрытая").Когда(Ложь)).Рендер();
	Ожидаем.Что(СтрНайти(Скрытые, "empty__text") > 0, "все записи сняты — тоже пусто: " + Скрытые).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Ошибки

// Запись печатается только в реестре: одна на странице она была бы <li> без списка.
&Тест
Процедура ЗаписьВнеРеестраОстанавливаетПечать() Экспорт

	Отказ = "";
	Попытка
		Кит.Область(Кит.ЗаписьРеестра("одна")).Рендер();
	Исключение
		Отказ = ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Отказ, "только внутри Кит.Реестр") > 0, "отказ называет место: " + Отказ).ЭтоИстина();

КонецПроцедуры

// В реестр кладут только записи: чужой узел реестр не печатает.
&Тест
Процедура ВРеестрКладутТолькоЗаписи() Экспорт

	Отказ = "";
	Попытка
		Кит.Реестр(Кит.Примечание("чужой"));
	Исключение
		Отказ = ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Отказ, "запись-реестра") > 0, "отказ называет, что кладут: " + Отказ).ЭтоИстина();

КонецПроцедуры

// Набор кнопок — только у записи реестра: у других узлов есть свои холсты.
&Тест
Процедура КнопкиТолькоУЗаписиРеестра() Экспорт

	Отказ = "";
	Попытка
		Кит.Область().Кнопки();
	Исключение
		Отказ = ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Отказ, "у записи реестра") > 0, "набор кнопок у чужого узла: " + Отказ).ЭтоИстина();

КонецПроцедуры

// Без имени запись не называет себя ни в сводке, ни в меню.
&Тест
Процедура ЗаписьБезИмениНеПечатается() Экспорт

	Отказ = "";
	Попытка
		Кит.Реестр(Кит.ЗаписьРеестра("")).Рендер();
	Исключение
		Отказ = ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Отказ, "нет Имени") > 0, "запись без имени: " + Отказ).ЭтоИстина();

КонецПроцедуры

// Неизвестное слово записи останавливает сборку с перечнем её слов.
&Тест
Процедура НеизвестноеСловоЗаписиОтвергается() Экспорт

	Отказ = "";
	Попытка
		Кит.ЗаписьРеестра("x").Знак("ok");
	Исключение
		Отказ = ИнформацияОбОшибке().Описание;
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Отказ, "Значок") > 0, "отказ перечисляет слова: " + Отказ).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Дерево

// Дерево показывает все три холста записи: тело, действия и набор кнопок.
&Тест
Процедура ДеревоПоказываетНаборКнопок() Экспорт

	Дерево = Кит.Реестр(Почта()).Дерево();
	Ожидаем.Что(СтрНайти(Дерево, "  запись-реестра" + Символы.ПС + "    действия" + Символы.ПС) > 0,
		"действия: " + Дерево).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Дерево, "    кнопки" + Символы.ПС + "      компонент[кнопка]" + Символы.ПС
		+ "      форма") > 0, "набор кнопок: " + Дерево).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Образцы

Функция Почта()

	Возврат Кит.ЗаписьРеестра("Почта",
			Кит.Свойства(Кит.Свойство("сервер", Кит.Код("smtp.example.org"))))
		.Плашка(Кит.Плашка("работает").Вид("ok")).Подпись("SMTP").Подпись("TLS")
		.Факт("отправлено", "12 писем")
		.Действия(Кит.Форма("/почта/вкл",
			Кит.Тумблер("вкл", "Почта включена").Включено().СохранятьСразу(),
			Кит.Кнопка("Сохранить").Малая()))
		.Кнопки(
			Кит.Кнопка("Изменить").Вторичная().Адрес("/почта"),
			Кит.Форма("/почта/удалить", Кит.Кнопка("Удалить").Опасная()));

КонецФункции

Функция Между(Знач Текст, Знач Начало, Знач Конец)

	Откуда = СтрНайти(Текст, Начало);
	Если Откуда = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Откуда);
	Докуда = СтрНайти(Хвост, Конец);
	Возврат ?(Докуда = 0, Хвост, Лев(Хвост, Докуда + СтрДлина(Конец) - 1));

КонецФункции

#КонецОбласти
