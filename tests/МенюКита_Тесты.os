// Меню открывается двумя разными кнопками: значком в строке таблицы и учёткой в шапке —
// значок, имя и шеврон раскрытия. Проверяется то, что ломается для человека: имя вошедшего
// не видно, кнопка не выглядит раскрывающейся, счётчик врёт нулём или прорастает разметкой,
// прежнее меню-значок меняет вид от чужой правки, а открытая панель встаёт не у своей
// кнопки, уезжает за край экрана или на телефоне не попадает под палец.

#Использовать "../"
#Использовать asserts

Перем Меню;    // Меню — компонент кита
Перем Значки;  // Иконка — чем сверяется значок кнопки
Перем Экран;   // ЭкранированиеHTML — им же сверяется экранирование
Перем Разбор;  // РазборЛиста — сканер, читающий КОД листа, а не его текст

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьСлой() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	ПодключитьСценарий(ОбъединитьПути(КаталогТестов, "фикстуры", "СборкаХолста.os"), "СборкаХолста");
	ПодключитьСценарий(ОбъединитьПути(КаталогТестов, "фикстуры", "РазборЛиста.os"), "РазборЛиста");

	Слой = Новый СборкаХолста().Собрать();
	Меню = Слой.Набор.Меню();
	Значки = Слой.Набор.Иконка();
	Экран = Слой.Экран;

	Разбор = Новый РазборЛиста();

КонецПроцедуры

// Учётка в шапке — та же всплывающая панель, но открывает её кнопка с именем вошедшего:
// значок, имя ТЕКСТОМ и шеврон. Без шеврона кнопка неотличима от хода по ссылке, и человек
// не знает, что она раскроется, а не уведёт со страницы.
&Тест
Процедура УчёткаОткрываетМенюКнопкойСИменемИШевроном() Экспорт

	HTML = Меню.Отрисовать(Новый Структура("Подпись, Аккаунт, Пункты",
		"Меню учётки", "а.иванова", ПунктыОбразец()));

	Кнопка = РазметкаОткрывашки(HTML);
	Ид = ИдентификаторПанели(HTML);

	Ожидаем.Что(Ид, "панель всплывающая и у неё свой идентификатор: " + HTML).Заполнено();
	Ожидаем.Что(СтрНайти(Кнопка, "popovertarget=""" + Ид + """") > 0,
		"кнопка учётки открывает ИМЕННО свою панель: " + Кнопка).ЭтоИстина();

	Ожидаем.Что(СтрНайти(Кнопка, "<span>а.иванова</span>") > 0,
		"имя вошедшего видно глазом, а не спрятано в aria-label: " + Кнопка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кнопка, "button__chevron") > 0,
		"у кнопки есть видимый признак раскрытия: " + Кнопка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кнопка, Значки.Отрисовать("аккаунт")) > 0,
		"значок учётки — аккаунт, а не шестерёнка строки: " + Кнопка).ЭтоИстина();

	Ожидаем.Что(СтрНайти(Кнопка, "title=""Меню учётки""") > 0,
		"подпись меню объясняет кнопку подсказкой: " + Кнопка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кнопка, "type=""button"""),
		"кнопка учётки ничего не отправляет: в шапке она стоит рядом с формой выхода")
		.Больше(0);

КонецПроцедуры

// Счётчик — то, ради чего на кнопку смотрят не открывая её. Значит, он стоит НА КНОПКЕ,
// а не в панели, и его вид не зависит от того, чем меню открывается.
&Тест
Процедура СчётчикПечатаетсяБейджемНаЛюбойОткрывашке() Экспорт

	Учётка = Меню.Отрисовать(Новый Структура(
		"Подпись, Аккаунт, Счётчик, ПодписьСчётчика, Пункты",
		"Меню учётки", "а.иванова", 3, "3 непрочитанных", ПунктыОбразец()));
	Значок = Меню.Отрисовать(Новый Структура("Подпись, Счётчик, ПодписьСчётчика, Пункты",
		"Меню строки", 12, "12 задач в очереди", ПунктыОбразец()));

	Ожидаем.Что(СтрНайти(РазметкаОткрывашки(Учётка), ">3</span>") > 0,
		"бейдж с числом на кнопке учётки: " + Учётка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(РазметкаОткрывашки(Значок), ">12</span>") > 0,
		"и на кнопке-значке — счётчик от вида открывашки не зависит: " + Значок).ЭтоИстина();

КонецПроцедуры

// Проверяется ИМЯ кнопки — то, что скринридер прочитает вслух, — а не место, где текст
// лежит в разметке. У кнопки-значка имя объявлено ярлыком, и ярлык останавливает расчёт:
// спрятанный текст внутри кнопки в имя не войдёт, поэтому счётчик обязан звучать в самом
// ярлыке. У кнопки с именем вошедшего ярлыка нет, и имя собирается из содержимого.
// Цифра в имя не входит ни там, ни там: в речи «12» не значит ничего.
&Тест
Процедура ИмяКнопкиСоСчётчикомНазываетЧисло() Экспорт

	ПроверитьСканИмени();

	Значок = РазметкаОткрывашки(Меню.Отрисовать(Новый Структура(
		"Подпись, Счётчик, ПодписьСчётчика, Пункты",
		"Меню строки", 12, "двенадцать задач в очереди", ПунктыОбразец())));

	ИмяЗначка = ИмяДоступности(Значок);
	Ожидаем.Что(СтрНайти(ИмяЗначка, "Меню строки") > 0,
		"кнопка-значок названа: " + ИмяЗначка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ИмяЗначка, "двенадцать задач в очереди") > 0,
		"и её имя называет счётчик — иначе скринридер о нём не узнает: " + ИмяЗначка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ИмяЗначка, "12"), "цифрой имя не говорит: " + ИмяЗначка).Равно(0);

	Учётка = РазметкаОткрывашки(Меню.Отрисовать(Новый Структура(
		"Подпись, Аккаунт, Счётчик, ПодписьСчётчика, Пункты",
		"Меню учётки", "а.иванова", 3, "есть непрочитанные", ПунктыОбразец())));

	Ожидаем.Что(ЗначениеАтрибута(Учётка, "aria-label"),
		"у кнопки с видимым именем ярлыка нет: имя собирается из содержимого").Равно("");

	ИмяУчётки = ИмяДоступности(Учётка);
	Ожидаем.Что(СтрНайти(ИмяУчётки, "а.иванова") > 0,
		"в имя входит имя вошедшего: " + ИмяУчётки).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ИмяУчётки, "есть непрочитанные") > 0,
		"и подпись счётчика: " + ИмяУчётки).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ИмяУчётки, "3"), "цифра спрятана от скринридера: " + ИмяУчётки).Равно(0);

КонецПроцедуры

// Счётчик без подписи — бейдж, которого для скринридера не существует. Кит своих слов
// не сочиняет, поэтому отказывается печатать, и отказ называет поле модели.
&Тест
Процедура СчётчикБезПодписиОтвергаетсяСУказаниемПоля() Экспорт

	Отказ = "";
	Попытка
		Меню.Отрисовать(Новый Структура("Подпись, Счётчик, Пункты",
			"Меню строки", 12, ПунктыОбразец()));
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Отказ, "счётчик без подписи — исключение").Заполнено();
	Ожидаем.Что(СтрНайти(Отказ, "ПодписьСчётчика") > 0,
		"отказ называет поле, которое надо заполнить: " + Отказ).ЭтоИстина();

КонецПроцедуры

// Ноль на кнопке — враньё: бейдж означает «есть непустое», и пустая пилюля зовёт открыть
// меню, за которым ничего нет. Ноль бывает любой формы — 0, 0.0, «0», — и пробелы вместо
// числа значат ровно то же, что и его отсутствие.
&Тест
Процедура НуляИПустогоСчётчикаНаКнопкеНеБывает() Экспорт

	Ожидаем.Что(СтрНайти(СчётчикомКнопка(0), "button__count"),
		"ноль числом бейджа не печатает").Равно(0);
	Ожидаем.Что(СтрНайти(СчётчикомКнопка(0.0), "button__count"),
		"дробный ноль — тот же ноль, хотя пишется «0.0»").Равно(0);
	Ожидаем.Что(СтрНайти(СчётчикомКнопка("0"), "button__count"),
		"ноль строкой — тот же ноль").Равно(0);
	Ожидаем.Что(СтрНайти(СчётчикомКнопка("   "), "button__count"),
		"пробелы вместо числа бейджа не печатают").Равно(0);
	Ожидаем.Что(СтрНайти(СчётчикомКнопка(""), "button__count"),
		"пустое значение бейджа не печатает").Равно(0);
	Ожидаем.Что(СтрНайти(СчётчикомКнопка(Неопределено), "button__count"),
		"и незаполненное поле тоже").Равно(0);

	HTML = Меню.Отрисовать(Новый Структура("Подпись, Пункты", "Меню строки", ПунктыОбразец()));
	Ожидаем.Что(СтрНайти(HTML, "button__count"),
		"меню, которое о счётчике не просило, его не получает: " + HTML).Равно(0);

КонецПроцедуры

// Имя вошедшего, счётчик и его подпись приходят из данных, значит разметкой они
// не становятся — и в идентификатор связи не протекают: два похожих имени дали бы один
// идентификатор, и кнопка одной строки открыла бы панель другой.
&Тест
Процедура ИмяУчёткиИСчётчикЭкранируются() Экспорт

	HTML = Меню.Отрисовать(Новый Структура(
		"Подпись, Аккаунт, Счётчик, ПодписьСчётчика, Пункты",
		"Меню учётки", """><script>alert(1)</script>", "<b>7</b>", "<i>семь</i> писем",
		ПунктыОбразец()));

	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "разметка из имени не проросла: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<b>7</b>"), "разметка из счётчика не проросла: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<i>семь</i>"),
		"и разметка из подписи счётчика тоже: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, Экран.Экранировать("<b>7</b>")) > 0,
		"счётчик виден текстом: " + HTML).ЭтоИстина();

	Ожидаем.Что(ИдентификаторБезДанных(ИдентификаторПанели(HTML)),
		"идентификатор панели собран не из имени: " + HTML).ЭтоИстина();

КонецПроцедуры

// Меню без учётки — прежняя кнопка-значок из строки таблицы: там нет места под текст,
// поэтому подпись живёт в aria-label, а не в <span>, и раскрытие показывать нечем.
&Тест
Процедура ОткрывашкаБезУчёткиОсталасьКнопкойЗначком() Экспорт

	HTML = Меню.Отрисовать(Новый Структура("Подпись, Пункты", "Меню строки", ПунктыОбразец()));
	Кнопка = РазметкаОткрывашки(HTML);

	Ожидаем.Что(СтрНайти(Кнопка, "button--icon") > 0,
		"кнопка-значок квадратная: " + Кнопка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кнопка, "aria-label=""Меню строки""") > 0,
		"имя кнопки читает скринридер: " + Кнопка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кнопка, Значки.Отрисовать("шестерёнка")) > 0,
		"значок — шестерёнка: " + Кнопка).ЭтоИстина();

	Ожидаем.Что(СтрНайти(Кнопка, "<span>"), "видимого текста у неё нет: " + Кнопка).Равно(0);
	Ожидаем.Что(СтрНайти(Кнопка, "button__chevron"),
		"и шеврона тоже: показывать раскрытие ей нечем: " + Кнопка).Равно(0);

КонецПроцедуры

#Область МестоПанели

// На телефоне панель встаёт листом у нижнего края окна, вдали от строки, откуда её открыли.
// Без подписи в листе не видно, чьи это действия: у трёх одинаковых шестерёнок подряд
// лист выглядит одинаково. Подпись — первая строка панели, чужой текст в ней экранирован.
&Тест
Процедура ЛистПодписанСвоейСтрокой() Экспорт

	HTML = Меню.Отрисовать(Новый Структура("Подпись, Пункты",
		"Действия над «<b>ядро</b>»", ПунктыОбразец()));
	Панель = Сред(HTML, СтрНайти(HTML, " popover class=""menu__panel"">"));

	Ожидаем.Что(СтрНайти(Панель, "<p class=""menu__title"">"),
		"подпись стоит первой строкой панели: " + Панель)
		.Равно(СтрДлина(" popover class=""menu__panel"">") + 1);
	Ожидаем.Что(СтрНайти(Панель, Экран.Экранировать("Действия над «<b>ядро</b>»")) > 0,
		"подпись та же, что у кнопки, и экранирована: " + Панель).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<b>"), "чужой текст разметкой не стал: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(РазметкаОткрывашки(HTML), "menu__title"),
		"кнопка-значок видимого текста по-прежнему не несёт").Равно(0);

КонецПроцедуры

// Подпись нужна листу, а не выпадающей панели: на широком та висит у самой кнопки, и
// заголовок был бы дублем строки. Спрячь его на обеих ширинах — лист на телефоне потеряет,
// чьи в нём действия.
&Тест
Процедура ПодписьМенюВиднаТолькоВЛисте() Экспорт

	Ожидаем.Что(ПоказПодписи(ШиринаШирокая()),
		"на широком подпись спрятана: панель стоит у кнопки").Равно("none");
	Ожидаем.Что(ПоказПодписи(ШиринаТелефона()), "на телефоне подпись объявлена видимой")
		.Заполнено();
	Ожидаем.Что(ПоказПодписи(ШиринаТелефона()), "и это не «спрятана»").ЭтоНе().Равно("none");

КонецПроцедуры

// Панель выпадает у шестерёнки, которая её открыла. Значения anchor() без якоря по
// умолчанию кнопку не находят, и панель ложится в левый верхний угол ДОКУМЕНТА: на
// прокрученной странице меню открывается за краем экрана, а на непрокрученной — в другом
// его конце от кнопки. Якорь по умолчанию — неявный, кнопка из popovertarget: auto.
&Тест
Процедура НаШирокомПанельВыпадаетУСвоейКнопки() Экспорт

	ПроверитьРазборУсловий();

	Расклад = МестоПанели(ШиринаШирокая());

	Ожидаем.Что(СтороныСЯкорем(Расклад).Количество() > 0,
		"панель на широком привязана к кнопке: " + ОписаниеМеста(Расклад)).ЭтоИстина();
	Ожидаем.Что(Расклад.Получить("position-anchor"),
		"якорь, от которого считаются anchor(), — кнопка, открывшая панель: "
			+ ОписаниеМеста(Расклад)).Равно("auto");

КонецПроцедуры

// Движок, не нашедший якоря, берёт запасное значение anchor(…, запас). От окна оно
// считается только у фиксированной панели; у абсолютной — от начала документа, и на
// прокрученной странице меню снова открылось бы за краем. Длинная панель прокручивается
// сама и выше окна не растёт.
&Тест
Процедура БезЯкоряПанельОстаётсяВОкне() Экспорт

	ПроверитьРазборЗапаса();

	Расклад = МестоПанели(ШиринаШирокая());

	Ожидаем.Что(Расклад.Получить("position"),
		"запасное место панели считается от окна: " + ОписаниеМеста(Расклад)).Равно("fixed");

	Для Каждого Сторона Из СтороныСЯкорем(Расклад) Цикл
		Ожидаем.Что(ЕстьЗапас(Расклад.Получить(Сторона)),
			Сторона + ": " + Расклад.Получить(Сторона) + " — без запасного значения движок"
				+ " без якоря положит панель в начало документа").ЭтоИстина();
	КонецЦикла;

	ПроверитьВысотуВОкне(Расклад, "выпадающая панель");

КонецПроцедуры

// Кнопка у нижнего края окна: ниже неё места нет, и панель обязана встать НАД кнопкой.
// Кнопка у левого края: левее места нет, и панель растёт вправо. Без запасных положений
// браузер оставляет панель там, где задано, — за краем окна.
&Тест
Процедура НаШирокомПанельУКраяОкнаОтзеркаливается() Экспорт

	Запасные = ЗапасныеПоложения(МестоПанели(ШиринаШирокая()));

	Ожидаем.Что(Запасные.Найти("flip-block") <> Неопределено,
		"у нижнего края панель встаёт над кнопкой: " + СтрСоединить(Запасные, ", ")).ЭтоИстина();
	Ожидаем.Что(Запасные.Найти("flip-inline") <> Неопределено,
		"у левого края панель растёт вправо: " + СтрСоединить(Запасные, ", ")).ЭтоИстина();

КонецПроцедуры

// На телефоне шестерёнка стоит у края экрана и внутри прокручиваемой обёртки таблицы:
// привязанная к ней панель уезжала за край. Лист у нижнего края окна виден целиком
// на любой строке и любой прокрутке, и держится он за края окна, а не за кнопку.
&Тест
Процедура НаУзкомПанельВстаётЛистомУНижнегоКрая() Экспорт

	Расклад = МестоПанели(ШиринаТелефона());
	Описание = ОписаниеМеста(Расклад);

	Ожидаем.Что(Расклад.Получить("position"), "лист прибит к окну: " + Описание).Равно("fixed");
	Ожидаем.Что(СтороныСЯкорем(Расклад).Количество(),
		"лист не держится за кнопку: " + Описание).Равно(0);
	Ожидаем.Что(Разбор.Пиксели(Расклад.Получить("bottom")),
		"лист стоит у нижнего края окна: " + Описание).Равно(0);
	Ожидаем.Что(Расклад.Получить("top"), "и сверху ни к чему не прибит: " + Описание).Равно("auto");
	Ожидаем.Что(Разбор.Пиксели(Расклад.Получить("left")) = 0
			И Разбор.Пиксели(Расклад.Получить("right")) = 0,
		"по горизонтали лист в пределах окна: " + Описание).ЭтоИстина();
	Ожидаем.Что(СдвигНулевой(Расклад.Получить("translate")),
		"открытый лист стоит на месте, а не за нижним краем: " + Описание).ЭтоИстина();
	Ожидаем.Что(ЗапасныеПоложения(Расклад).Количество(),
		"лист не отзеркаливается: у края окна он и так на своём месте: " + Описание).Равно(0);

	ПроверитьВысотуВОкне(Расклад, "лист");

КонецПроцедуры

// Палец в цель высотой в 27 px не попадает: пункт листа не мельче 44 px — и ссылка,
// и форма из одной кнопки, и кнопка формы с полями.
&Тест
Процедура ПунктыЛистаНеМельчеПальца() Экспорт

	Для Каждого Семейство Из СтрРазделить(".menu__panel > .button|.menu__panel > form", "|") Цикл
		Ожидаем.Что(Разбор.ПальцеваяВысота(ПравилаСемейства(Семейство)),
			"последнее слово каскада о высоте «" + Семейство + "» на телефоне")
			.БольшеИлиРавно(44);
	КонецЦикла;

КонецПроцедуры

// Вид пункта задаёт меню, а не вызывающий: иначе одно меню показывает несколько видов
// кнопок разом — залитые, контурные, крупные и мелкие. Ссылка и форма из одной кнопки
// выглядят одинаково на обеих ширинах, а правило пункта перебивает каждый вариант кнопки
// специфичностью: заливка, рамка и цвет варианта сквозь пункт не проступают.
&Тест
Процедура ПунктыМенюОдногоВидаПриЛюбомВариантеКнопки() Экспорт

	ПроверитьСчётСпецифичности();

	Пункты = СтрРазделить(СсылкаПункт() + "|" + ФормаПункт(), "|");
	Свойства = СтрРазделить("width,background,border-color,color,font-size,padding,min-height", ",");

	Для Каждого Ширина Из ОбеШирины() Цикл

		ВидСсылки = ВидПункта(СсылкаПункт(), Ширина);
		ВидФормы = ВидПункта(ФормаПункт(), Ширина);
		Где = СтрШаблон("при ширине %1 px", Формат(Ширина, "ЧГ=0"));

		Для Каждого Свойство Из Свойства Цикл
			Ожидаем.Что(ВидФормы.Получить(Свойство),
				СтрШаблон("%1 у формы из одной кнопки — как у ссылки (%2)", Свойство, Где))
				.Равно(ВидСсылки.Получить(Свойство));
		КонецЦикла;

		Ожидаем.Что(ВидСсылки.Получить("background"),
			"заливка пункта своя, а не варианта кнопки (" + Где + ")").Равно("transparent");
		Ожидаем.Что(ВидСсылки.Получить("width"),
			"пункт — строка во всю ширину панели (" + Где + ")").Равно("100%");

	КонецЦикла;

	Варианты = ВариантыКнопки();
	Ожидаем.Что(Варианты.Количество() >= 3,
		"вариантов кнопки с заливкой или цветом в листе: " + Варианты.Количество()
			+ " — скан ослеп").ЭтоИстина();

	Для Каждого Пункт Из Пункты Цикл
		Для Каждого Вариант Из Варианты Цикл
			Ожидаем.Что(Разбор.Специфичность(Пункт) > Разбор.Специфичность(Вариант),
				СтрШаблон("«%1» не перебивает «%2»: вариант кнопки проступит сквозь пункт",
					Пункт, Вариант)).ЭтоИстина();
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

// Затемнение — признак «страница за этим сейчас не работает», и оно верно для листа,
// который накрывает низ телефона, как и для шторки единого меню. Выпадающая панель
// страницу не отнимает — под ней ничего не темнеет.
&Тест
Процедура ПодЛистомСтраницаЗатемненаАПодВыпадающимНет() Экспорт

	Узкое = ФонПодПанелью(ШиринаТелефона());
	Широкое = ФонПодПанелью(ШиринаШирокая());

	Ожидаем.Что(Узкое, "под листом страница затемнена").Заполнено();
	Ожидаем.Что(Узкое, "и это настоящий цвет, а не пустота").ЭтоНе().Равно("transparent");
	Ожидаем.Что(Широкое = "" ИЛИ Широкое = "transparent" ИЛИ Широкое = "none",
		"под выпадающей панелью страница не затемняется, а сейчас «" + Широкое + "»")
		.ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПунктыОбразец()

	Результат = Новый Массив();
	Результат.Добавить(Новый Структура("Подпись, Адрес, Иконка", "Кабинет", "/кабинет", "аккаунт"));
	Возврат Результат;

КонецФункции

Функция СчётчикомКнопка(Знач Значение)

	Возврат РазметкаОткрывашки(Меню.Отрисовать(Новый Структура("Подпись, Счётчик, Пункты",
		"Меню строки", Значение, ПунктыОбразец())));

КонецФункции

// Имя кнопки для скринридера, посчитанное по тем же правилам, что и в браузере: объявленный
// ярлык побеждает содержимое и обрывает расчёт, иначе имя собирается из содержимого — без
// того, что спрятано атрибутом aria-hidden.
Функция ИмяДоступности(Знач Кнопка)

	Ярлык = ЗначениеАтрибута(Кнопка, "aria-label");
	Если ЗначениеЗаполнено(Ярлык) Тогда
		Возврат Ярлык;
	КонецЕсли;

	Возврат СокрЛП(ТекстБезТегов(БезСпрятанного(Кнопка)));

КонецФункции

// Самотест расчёта имени: сканер, который не видит ни ярлыка, ни спрятанного куска,
// оставался бы зелёным на сломанной кнопке.
Процедура ПроверитьСканИмени()

	Ожидаем.Что(ИмяДоступности("<button aria-label=""Ярлык"">видимый текст</button>"),
		"ярлык побеждает содержимое и обрывает расчёт").Равно("Ярлык");
	Ожидаем.Что(ИмяДоступности("<button><span aria-hidden=""true"">7</span>слышно</button>"),
		"спрятанный кусок в имя не входит").Равно("слышно");
	Ожидаем.Что(ИмяДоступности("<button><svg aria-hidden=""true""><path/></svg>слышно</button>"),
		"вместе со всем своим содержимым, каким бы тегом он ни был").Равно("слышно");

КонецПроцедуры

// Убирает куски, спрятанные от скринридера, вместе с их содержимым: тег ищется по своему
// атрибуту, а закрывающий — по имени этого тега, поэтому вырезается именно спрятанное.
Функция БезСпрятанного(Знач HTML)

	Результат = HTML;
	Позиция = СтрНайти(Результат, "aria-hidden=""true""");

	Пока Позиция > 0 Цикл

		Начало = НачалоТега(Результат, Позиция);
		Закрывающий = "</" + ИмяТега(Сред(Результат, Начало)) + ">";

		Конец = СтрНайти(Сред(Результат, Начало), Закрывающий);
		Если Конец = 0 Тогда
			Возврат Результат;
		КонецЕсли;

		Результат = Лев(Результат, Начало - 1)
			+ Сред(Результат, Начало + Конец - 1 + СтрДлина(Закрывающий));
		Позиция = СтрНайти(Результат, "aria-hidden=""true""");

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция НачалоТега(Знач HTML, Знач Позиция)

	Индекс = Позиция;
	Пока Индекс > 1 И Сред(HTML, Индекс, 1) <> "<" Цикл
		Индекс = Индекс - 1;
	КонецЦикла;

	Возврат Индекс;

КонецФункции

Функция ИмяТега(Знач Фрагмент)

	Имя = "";
	Для Индекс = 2 По СтрДлина(Фрагмент) Цикл
		Символ = Сред(Фрагмент, Индекс, 1);
		Если Символ = " " ИЛИ Символ = ">" ИЛИ Символ = "/" Тогда
			Прервать;
		КонецЕсли;
		Имя = Имя + Символ;
	КонецЦикла;

	Возврат Имя;

КонецФункции

Функция ТекстБезТегов(Знач HTML)

	Результат = "";
	ВнутриТега = Ложь;

	Для Индекс = 1 По СтрДлина(HTML) Цикл
		Символ = Сред(HTML, Индекс, 1);
		Если Символ = "<" Тогда
			ВнутриТега = Истина;
		ИначеЕсли Символ = ">" Тогда
			ВнутриТега = Ложь;
		ИначеЕсли НЕ ВнутриТега Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗначениеАтрибута(Знач HTML, Знач Имя)

	Маркер = Имя + "=""";
	Начало = СтрНайти(HTML, Маркер);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(HTML, Начало + СтрДлина(Маркер));
	Конец = СтрНайти(Хвост, """");
	Возврат ?(Конец = 0, "", Лев(Хвост, Конец - 1));

КонецФункции

// Разметка одной только открывашки: в панели стоят такие же кнопки, и сторож, читающий
// меню целиком, принял бы пункт панели за содержимое кнопки.
Функция РазметкаОткрывашки(Знач HTML)

	Конец = СтрНайти(HTML, "</button>");
	Возврат ?(Конец = 0, "", Лев(HTML, Конец));

КонецФункции

// Идентификатор панели: значение id у элемента, за которым стоит атрибут popover.
// Ищется признак верхнего слоя, а не префикс имени: сторожу важно, что панель всплывает.
Функция ИдентификаторПанели(Знач HTML)

	Начало = СтрНайти(HTML, "id=""");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(HTML, Начало + 4);
	Конец = СтрНайти(Хвост, """");
	Если Конец = 0 ИЛИ НЕ СтрНачинаетсяС(Сред(Хвост, Конец + 1), " popover") Тогда
		Возврат "";
	КонецЕсли;

	Возврат Лев(Хвост, Конец - 1);

КонецФункции

// Идентификатор, собранный китом: строчная латиница, цифры и дефис. Кириллица, пробел
// или кавычка в нём означают, что в связь протекло значение из данных.
Функция ИдентификаторБезДанных(Знач Идентификатор)

	Допустимые = "abcdefghijklmnopqrstuvwxyz0123456789-";

	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Позиция = 1 По СтрДлина(Идентификатор) Цикл
		Если СтрНайти(Допустимые, Сред(Идентификатор, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Ширины, на которых сверяется лист: телефон и широкий экран.
Функция ШиринаТелефона()
	Возврат 390;
КонецФункции

Функция ШиринаШирокая()
	Возврат 1280;
КонецФункции

Функция ОбеШирины()

	Результат = Новый Массив();
	Результат.Добавить(ШиринаШирокая());
	Результат.Добавить(ШиринаТелефона());
	Возврат Результат;

КонецФункции

Функция СсылкаПункт()
	Возврат ".menu__panel > .button";
КонецФункции

Функция ФормаПункт()
	Возврат ".menu__panel > form:is(:not(:has(.field))) > .button";
КонецФункции

// Последнее слово каскада о месте САМОЙ панели, открытой, на экране этой ширины. Место
// задаётся только там, где движок знает верхний слой; запасной путь движка без якорей
// (@supports not (…anchor()…)) и стартовый кадр выезда в каскад не входят. Правила
// открытого состояния специфичнее и потому идут вторым проходом. Сокращённая запись inset
// в правиле раскладывается ДО его длинных записей: так она и стоит в листе.
Функция МестоПанели(Знач Ширина)

	Итог = Новый Соответствие();

	Для Каждого Открытое Из ЛожьИИстина() Цикл

		Для Каждого Правило Из Разбор.ПравилаКласса("menu__panel") Цикл

			Если НЕ Разбор.СтилизуетСамЭлемент(Правило.Селектор, "menu__panel")
				ИЛИ НЕ Разбор.ТребуетВерхнегоСлоя(Правило.Условия)
				ИЛИ Разбор.ТолькоБезПоддержки(Правило, "anchor")
				ИЛИ СтартовыйКадр(Правило)
				ИЛИ (СтрНайти(Правило.Селектор, ":popover-open") > 0) <> Открытое
				ИЛИ НЕ Разбор.ДействуетНаШирине(Правило.Условия, Ширина) Тогда
				Продолжить;
			КонецЕсли;

			Сокращение = Правило.Объявления.Получить("inset");
			Если Сокращение <> Неопределено Тогда
				Стороны = СтрРазделить("top,right,bottom,left", ",");
				Для Номер = 1 По 4 Цикл
					Итог.Вставить(Стороны[Номер - 1], Разбор.СторонаИзInset(Сокращение, Номер));
				КонецЦикла;
			КонецЕсли;

			Для Каждого Объявление Из Правило.Объявления Цикл
				Если Объявление.Ключ <> "inset" Тогда
					Итог.Вставить(Объявление.Ключ, НРег(СокрЛП(Объявление.Значение)));
				КонецЕсли;
			КонецЦикла;

		КонецЦикла;

	КонецЦикла;

	Возврат Итог;

КонецФункции

// Правило описывает кадр, С КОТОРОГО панель выезжает, а не то, где она стоит.
Функция СтартовыйКадр(Знач Правило)

	Для Каждого Прелюдия Из Правило.Прелюдии Цикл
		Если СтрНачинаетсяС(НРег(Прелюдия), "@starting-style") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Самотест разбора условий: запасной путь движка без якорей узнаётся по условию
// @supports, а не по тексту; ширина читается из @media.
Процедура ПроверитьРазборУсловий()

	Лист = "@supports selector(:popover-open) { .п { top: 1px; }"
		+ " @supports not (top: anchor(bottom)) { .п { top: 30vh; } } }"
		+ " @supports (top: anchor(bottom)) { .п { top: 2px; } }"
		+ " @media (max-width: 900px) { .п { top: 3px; } }"
		+ " @media (min-width: 901px) { .п { top: 4px; } }";
	Правила = Разбор.Правила(Лист);

	Ожидаем.Что(Правила.Количество(), "в приманке пять правил").Равно(5);
	Ожидаем.Что(Разбор.ТолькоБезПоддержки(Правила[1], "anchor"),
		"«not (top: anchor())» — путь движка без якорей").ЭтоИстина();
	Ожидаем.Что(Разбор.ТолькоБезПоддержки(Правила[2], "anchor"),
		"проверка БЕЗ отрицания запасным путём не является").ЭтоЛожь();
	Ожидаем.Что(Разбор.ТолькоБезПоддержки(Правила[0], "anchor"),
		"внешнее условие про верхний слой — не про якоря").ЭтоЛожь();
	Ожидаем.Что(Разбор.УсловиеПоддержки(Правила[0].Прелюдии[0]).Вид,
		"selector() разобран как проверка селектора").Равно("селектор");

	Ожидаем.Что(Разбор.ДействуетНаШирине(Правила[3].Условия, 390), "узкое на телефоне").ЭтоИстина();
	Ожидаем.Что(Разбор.ДействуетНаШирине(Правила[3].Условия, 1280), "узкое на широком").ЭтоЛожь();
	Ожидаем.Что(Разбор.ДействуетНаШирине(Правила[4].Условия, 1280), "широкое на широком").ЭтоИстина();
	Ожидаем.Что(Разбор.ДействуетНаШирине(Правила[4].Условия, 390), "широкое на телефоне").ЭтоЛожь();
	Ожидаем.Что(Разбор.ДействуетНаШирине(Правила[0].Условия, 390), "без @media — везде").ЭтоИстина();

КонецПроцедуры

// Самотест счёта специфичности: сторож сравнивает пункт меню с вариантами кнопки,
// и счёт, путающий псевдоклассы с аргументами, дал бы ложную победу.
Процедура ПроверитьСчётСпецифичности()

	Ожидаем.Что(Разбор.Специфичность(".a"), "класс").Равно(1000);
	Ожидаем.Что(Разбор.Специфичность("form.a"), "элемент с классом").Равно(1001);
	Ожидаем.Что(Разбор.Специфичность(".a > .b:hover"), "псевдокласс — как класс").Равно(3000);
	Ожидаем.Что(Разбор.Специфичность(".a::backdrop"), "псевдоэлемент — как элемент").Равно(1001);
	Ожидаем.Что(Разбор.Специфичность("#я .a"), "идентификатор").Равно(1001000);
	Ожидаем.Что(Разбор.Специфичность(".a > form:is(:not(:has(.f))) > .b"),
		":is/:not/:has весят аргументом").Равно(3001);
	Ожидаем.Что(Разбор.Специфичность(":is(.a, #б) .в"), "самый тяжёлый аргумент").Равно(1001000);
	Ожидаем.Что(Разбор.Специфичность(":where(.a) .б"), ":where — ноль").Равно(1000);
	Ожидаем.Что(Разбор.Специфичность("td[data-label]::before"), "атрибут — как класс").Равно(1002);

КонецПроцедуры

// Стороны, чьё место считается от якоря.
Функция СтороныСЯкорем(Знач Расклад)

	Результат = Новый Массив();
	Для Каждого Сторона Из СтрРазделить("top,right,bottom,left", ",") Цикл
		Если СтрНайти(Строка(Расклад.Получить(Сторона)), "anchor(") > 0 Тогда
			Результат.Добавить(Сторона);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Запасные положения панели по одному: «flip-block», «flip-inline», «flip-block flip-inline».
// none — запасных нет.
Функция ЗапасныеПоложения(Знач Расклад)

	Результат = Новый Массив();
	Значение = СокрЛП(Строка(Расклад.Получить("position-try-fallbacks")));
	Если Значение = "" ИЛИ Значение = "none" Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Положение Из СтрРазделить(Значение, ",", Ложь) Цикл
		Результат.Добавить(СтрСоединить(СтрРазделить(СокрЛП(Положение), " ", Ложь), " "));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// У каждого anchor() в значении есть запасное значение — второй аргумент через запятую
// на верхнем уровне скобок. Запятая внутри вложенной функции запасом не считается.
Функция ЕстьЗапас(Знач Значение)

	Позиция = СтрНайти(Значение, "anchor(");
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Пока Позиция > 0 Цикл

		Глубина = 0;
		Запас = Ложь;
		Для Индекс = Позиция + СтрДлина("anchor(") По СтрДлина(Значение) Цикл
			Символ = Сред(Значение, Индекс, 1);
			Если Символ = "(" Тогда
				Глубина = Глубина + 1;
			ИначеЕсли Символ = ")" И Глубина = 0 Тогда
				Прервать;
			ИначеЕсли Символ = ")" Тогда
				Глубина = Глубина - 1;
			ИначеЕсли Символ = "," И Глубина = 0 Тогда
				Запас = Истина;
			КонецЕсли;
		КонецЦикла;

		Если НЕ Запас Тогда
			Возврат Ложь;
		КонецЕсли;

		Позиция = СтрНайти(Значение, "anchor(", НаправлениеПоиска.СНачала, Позиция + 1);

	КонецЦикла;

	Возврат Истина;

КонецФункции

// Самотест разбора запаса: разбор, который видит запятую где попало, оставался бы
// зелёным на панели, у которой запаса нет.
Процедура ПроверитьРазборЗапаса()

	Ожидаем.Что(ЕстьЗапас("anchor(bottom)"), "без второго аргумента запаса нет").ЭтоЛожь();
	Ожидаем.Что(ЕстьЗапас("anchor(bottom, 30vh)"), "второй аргумент — запас").ЭтоИстина();
	Ожидаем.Что(ЕстьЗапас("anchor(--кнопка bottom, calc(1px + 2px))"),
		"запас бывает и вычислением").ЭтоИстина();
	Ожидаем.Что(ЕстьЗапас("calc(anchor(bottom) + max(1px, 2px))"),
		"запятая соседней функции запасом anchor() не считается").ЭтоЛожь();
	Ожидаем.Что(ЕстьЗапас("anchor(top, 1px) anchor(bottom)"),
		"запас нужен каждому anchor() в значении").ЭтоЛожь();

КонецПроцедуры

// Панель выше окна не растёт: потолок высоты в долях окна, не больше него, и лишнее
// прокручивается внутри панели — иначе нижние пункты недостижимы ни пальцем, ни клавишей.
Процедура ПроверитьВысотуВОкне(Знач Расклад, Знач Что)

	Потолок = Строка(Расклад.Получить("max-height"));
	Ожидаем.Что(ДолиОкна(Потолок) > 0 И ДолиОкна(Потолок) <= 100,
		Что + ": потолок высоты в долях окна и не выше него — «" + Потолок + "»").ЭтоИстина();
	Ожидаем.Что(СтрНайти("auto scroll", Строка(Расклад.Получить("overflow-y"))) > 0
			И ЗначениеЗаполнено(Расклад.Получить("overflow-y")),
		Что + ": лишнее прокручивается внутри — «" + Расклад.Получить("overflow-y") + "»")
		.ЭтоИстина();

КонецПроцедуры

// Наименьшая доля окна, названная в значении: «min(70vh, 32rem)» — 70, «80dvh» — 80.
// Ноль — доли окна в значении нет.
Функция ДолиОкна(Знач Значение)

	Результат = 0;
	Для Каждого Единица Из СтрРазделить("dvh,svh,lvh,vh", ",") Цикл
		Позиция = СтрНайти(Значение, Единица);
		Если Позиция = 0 Тогда
			Продолжить;
		КонецЕсли;
		Начало = Позиция - 1;
		Пока Начало > 0 И СтрНайти("0123456789.", Сред(Значение, Начало, 1)) > 0 Цикл
			Начало = Начало - 1;
		КонецЦикла;
		Цифры = Сред(Значение, Начало + 1, Позиция - Начало - 1);
		Если ЗначениеЗаполнено(Цифры) Тогда
			Доля = Число(Цифры);
			Результат = ?(Результат = 0, Доля, Мин(Результат, Доля));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сдвиг «никуда»: none либо нули по обеим осям.
Функция СдвигНулевой(Знач Значение)

	Если Значение = Неопределено ИЛИ Значение = "none" Тогда
		Возврат Истина;
	КонецЕсли;

	Для Каждого Часть Из СтрРазделить(Значение, " ", Ложь) Цикл
		Если СтрНайти("0 0px 0%", Часть) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Показ подписи меню на экране этой ширины: последнее слово каскада.
Функция ПоказПодписи(Знач Ширина)

	Значение = "";
	Для Каждого Правило Из Разбор.ПравилаКласса("menu__title") Цикл
		Если Разбор.СтилизуетСамЭлемент(Правило.Селектор, "menu__title")
			И Разбор.ДействуетНаШирине(Правило.Условия, Ширина)
			И Правило.Объявления.Получить("display") <> Неопределено Тогда
			Значение = НРег(Правило.Объявления.Получить("display"));
		КонецЕсли;
	КонецЦикла;
	Возврат Значение;

КонецФункции

// Фон под открытой панелью на экране этой ширины: последнее слово каскада о ::backdrop.
Функция ФонПодПанелью(Знач Ширина)

	Значение = "";
	Для Каждого Правило Из Разбор.ПравилаКласса("menu__panel") Цикл
		Если СтрНайти(Правило.Селектор, "::backdrop") > 0
			И Разбор.ДействуетНаШирине(Правило.Условия, Ширина)
			И Правило.Объявления.Получить("background") <> Неопределено Тогда
			Значение = НРег(Правило.Объявления.Получить("background"));
		КонецЕсли;
	КонецЦикла;
	Возврат Значение;

КонецФункции

// Правила пунктов одного семейства: селектор начинается с общего для них пути.
Функция ПравилаСемейства(Знач Семейство)

	Результат = Новый Массив();
	Для Каждого Правило Из Разбор.ПравилаКласса("menu__panel") Цикл
		Если СтрНачинаетсяС(Правило.Селектор, Семейство) Тогда
			Результат.Добавить(Правило);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Вид пункта ровно этого селектора на экране этой ширины: последнее слово каскада.
Функция ВидПункта(Знач Селектор, Знач Ширина)

	Итог = Новый Соответствие();

	Для Каждого Правило Из Разбор.ПравилаКласса("menu__panel") Цикл

		Если Правило.Селектор <> Селектор
			ИЛИ НЕ Разбор.ДействуетНаШирине(Правило.Условия, Ширина) Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Объявление Из Правило.Объявления Цикл
			Итог.Вставить(Объявление.Ключ, НРег(СокрЛП(Объявление.Значение)));
		КонецЦикла;

	КонецЦикла;

	Возврат Итог;

КонецФункции

// Варианты кнопки, которые красят её: безусловное правило одного класса-варианта,
// задающее заливку, рамку или цвет.
Функция ВариантыКнопки()

	Результат = Новый Массив();
	Для Каждого Правило Из Разбор.Правила(Разбор.ТекстБазовогоЛиста()) Цикл

		Селектор = Правило.Селектор;
		Если Правило.Условия <> "" ИЛИ НЕ СтрНачинаетсяС(Селектор, ".button--")
			ИЛИ СтрНайти(Селектор, " ") > 0 ИЛИ СтрНайти(Селектор, ":") > 0 Тогда
			Продолжить;
		КонецЕсли;

		Объявления = Правило.Объявления;
		Если Объявления.Получить("background") <> Неопределено
			ИЛИ Объявления.Получить("border-color") <> Неопределено
			ИЛИ Объявления.Получить("color") <> Неопределено Тогда
			Результат.Добавить(Селектор);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОписаниеМеста(Знач Расклад)

	Части = Новый Массив();
	Для Каждого Свойство Из СтрРазделить("position,position-anchor,top,right,bottom,left,"
			+ "translate,max-height,overflow-y,position-try-fallbacks", ",") Цикл
		Части.Добавить(Свойство + ": " + Строка(Расклад.Получить(Свойство)));
	КонецЦикла;
	Возврат СтрСоединить(Части, "; ");

КонецФункции

Функция ЛожьИИстина()

	Результат = Новый Массив();
	Результат.Добавить(Ложь);
	Результат.Добавить(Истина);
	Возврат Результат;

КонецФункции

#КонецОбласти
