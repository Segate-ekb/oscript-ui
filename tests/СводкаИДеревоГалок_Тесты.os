// Сводка записи и дерево галок: что видит человек — название первым, знак состояния у него,
// подписанные строки; три состояния ветки дерева без скрипта; действия формы одним рядом.

#Использовать "../"
#Использовать asserts

Перем Кит;      // Кит — фабрика элементов экрана
Перем Набор;    // НаборКомпонентов

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	ПодключитьСценарий(ОбъединитьПути(КаталогТестов, "фикстуры", "СборкаХолста.os"), "СборкаХолста");

	Слой = Новый СборкаХолста().Собрать();
	Кит = Слой.Кит;
	Набор = Слой.Набор;

КонецПроцедуры

#Область Сводка

&Тест
Процедура НазваниеИдётПервымАПодписьИСведенияПодНим() Экспорт

	HTML = Набор.Сводка().Отрисовать(МодельСводки());

	Название = СтрНайти(HTML, "Вечерний отчёт");
	Знак = СтрНайти(HTML, "выключена");
	Подпись = СтрНайти(HTML, "почта · отдел продаж");
	Темы = СтрНайти(HTML, "Темы");

	Ожидаем.Что(Название > 0 И Название < Знак, "знак состояния — после названия: " + HTML).ЭтоИстина();
	Ожидаем.Что(Знак < Подпись, "подпись — под названием и его знаком: " + HTML).ЭтоИстина();
	Ожидаем.Что(Подпись < Темы, "сведения — под подписью: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "class=""tag tag--warn""") > 0, "знак — плашка своего вида: " + HTML).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура СведенияПодписаныИПустыеНеПечатаются() Экспорт

	HTML = Набор.Сводка().Отрисовать(МодельСводки());

	Ожидаем.Что(HTML, "подпись строки и её значение — соседи")
		.Содержит("<span class=""brief__label"">Темы</span><span class=""brief__value"">Заказы, Отмены, Возвраты</span>");
	Ожидаем.Что(HTML, "строка-предупреждение отличается видом")
		.Содержит("<span class=""brief__value brief__value--warn"">Опросы</span>");
	Ожидаем.Что(СтрНайти(HTML, "Пусто"), "строка без значения не печатается").Равно(0);

КонецПроцедуры

// Сводка ложится в свёрнутую строку раскрывашки: блочный тег внутри <summary> браузер
// вынес бы из неё, и сводка развалилась бы на части.
&Тест
Процедура СводкаСтрочнаяИЛожитсяВСвёрнутуюСтроку() Экспорт

	Раскрывашка = Кит.Раскрывашка();
	Раскрывашка.Шапка().Добавить(Кит.Сводка(МодельСводки()));
	HTML = Раскрывашка.Рендер();

	Шапка = МеждуМаркеров(HTML, "<summary", "</summary>");
	Для Каждого Тег Из СтрРазделить("<div,<p,<p>,<dl,<ul,<section", ",") Цикл
		Ожидаем.Что(СтрНайти(Шапка, Тег), "в свёрнутой строке нет блочного " + Тег + ": " + Шапка).Равно(0);
	КонецЦикла;
	Ожидаем.Что(Шапка, "сводка целиком в свёрнутой строке").Содержит("Опросы");

КонецПроцедуры

&Тест
Процедура ЗначенияСводкиЭкранируются() Экспорт

	Сведения = Новый Массив();
	Сведения.Добавить(Новый Структура("Подпись, Значение", "<b>", "<script>x</script>"));
	HTML = Набор.Сводка().Отрисовать(Новый Структура("Название, Подпись, Сведения",
		"<i>имя</i>", "<u>", Сведения));

	Ожидаем.Что(СтрНайти(HTML, "<script>"), "значение не исполняется: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<i>"), "название не исполняется: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<u>"), "подпись не исполняется: " + HTML).Равно(0);

КонецПроцедуры

&Тест
Процедура СводкаБезНазванияОтбиваетсяИсключением() Экспорт

	Ожидаем.Что(Ошибка(Набор.Сводка(), Новый Структура("Подпись", "x")), "сводка без названия")
		.Содержит("без Названия");

КонецПроцедуры

#КонецОбласти

#Область ДеревоГалок

&Тест
Процедура ВеткаПечатаетТриСостоянияБезСкрипта() Экспорт

	HTML = Набор.ДеревоГалок().Отрисовать(МодельДерева());

	Ожидаем.Что(Галка(HTML, "край_1"), "включённая ветка отмечена").Содержит(" checked");
	Ожидаем.Что(СтрНайти(Галка(HTML, "край_1"), "mixed"), "и не «частично»").Равно(0);

	Частично = Галка(HTML, "край_2");
	Ожидаем.Что(Частично, "«частично» уходит в форму отмеченной").Содержит(" checked");
	Ожидаем.Что(Частично, "и называет себя скринридеру").Содержит("aria-checked=""mixed""");
	Ожидаем.Что(Частично, "и скрипту").Содержит("data-checktree-state=""mixed""");

	Снята = Галка(HTML, "край_3");
	Ожидаем.Что(СтрНайти(Снята, " checked"), "снятая ветка не отмечена").Равно(0);
	Ожидаем.Что(Снята, "состояние для скрипта").Содержит("data-checktree-state=""off""");

КонецПроцедуры

&Тест
Процедура ДетиВеткиВнутриСворачиваемойВеткиАЕёГалкаСнаружи() Экспорт

	HTML = Набор.ДеревоГалок().Отрисовать(МодельДерева());

	Ветка = МеждуМаркеров(HTML, "<details class=""checktree__branch"" open>", "</details>");
	Ожидаем.Что(Ветка, "раскрытая ветка несёт детей").Содержит("name=""город_1""");
	Ожидаем.Что(СтрНайти(Ветка, "name=""край_2"""), "галка ветки не спрятана в свёрнутое").Равно(0);
	Ожидаем.Что(СтрНайти(МеждуМаркеров(HTML, "<summary", "</summary>"), "<input"),
		"в кнопке раскрытия галок нет").Равно(0);
	Ожидаем.Что(СтрЧислоВхождений(HTML, "<details class=""checktree__branch"">"),
		"ветки без Открыт приезжают свёрнутыми").Равно(2);
	Ожидаем.Что(HTML, "примечание в конце ветки").Содержит("Показан 1 из 40");

КонецПроцедуры

&Тест
Процедура ОтключённыйУзелНеОтправляетсяИДанныеИдутСкрипту() Экспорт

	HTML = Набор.ДеревоГалок().Отрисовать(МодельДерева());

	Ожидаем.Что(Галка(HTML, "город_4"), "отключённая галка").Содержит(" disabled");
	Ожидаем.Что(Галка(HTML, "город_1"), "данные для скрипта").Содержит("data-key=""город_1""");
	Ожидаем.Что(СтрНайти(HTML, "onclick"), "недопустимое имя данных не печатается").Равно(0);
	Ожидаем.Что(Галка(HTML, "город_3"), "значение галки — своё").Содержит("value=""весь""");

КонецПроцедуры

&Тест
Процедура НеизвестноеСостояниеИУзелБезИмениОтбиваются() Экспорт

	Узлы = Новый Массив();
	Узлы.Добавить(Новый Структура("Имя, Подпись, Состояние", "x", "икс", "наполовину"));
	Ожидаем.Что(Ошибка(Набор.ДеревоГалок(), Новый Структура("Узлы", Узлы)), "чужое состояние")
		.Содержит("состояния «наполовину»");

	Безымянные = Новый Массив();
	Безымянные.Добавить(Новый Структура("Подпись", "икс"));
	Ожидаем.Что(Ошибка(Набор.ДеревоГалок(), Новый Структура("Узлы", Безымянные)), "узел без имени")
		.Содержит("нет Имени");

КонецПроцедуры

&Тест
Процедура ПустоеДеревоНеПечатаетсяАБесконечнаяВложенностьОбрезается() Экспорт

	Ожидаем.Что(Набор.ДеревоГалок().Отрисовать(Новый Структура("Узлы", Новый Массив())), "пусто").Равно("");

	Узел = Новый Структура("Имя, Подпись, Дети", "петля", "петля", Новый Массив());
	Узел.Дети.Добавить(Узел);
	Узлы = Новый Массив();
	Узлы.Добавить(Узел);
	HTML = Набор.ДеревоГалок().Отрисовать(Новый Структура("Узлы", Узлы));
	Ожидаем.Что(СтрЧислоВхождений(HTML, "name=""петля"""), "глубина ограничена")
		.Равно(Набор.ДеревоГалок().ПредельнаяГлубина());

КонецПроцедуры

#КонецОбласти

#Область ДействияФормы

&Тест
Процедура КнопкаВнеФормыОтправляетФормуПоЯкорю() Экспорт

	Форма = Кит.ФормаБезТокена("/рассылки", "столбик").Якорь("рассылка-правка");
	Ожидаем.Что(Форма.Рендер(), "у формы якорь").Содержит("id=""рассылка-правка""");

	Кнопка = Кит.Кнопка(Новый Структура("Подпись, Форма", "Сохранить", "рассылка-правка")).Рендер();
	Ожидаем.Что(Кнопка, "кнопка отправляет форму по якорю").Содержит("form=""рассылка-правка""");

	Обычная = Кит.Кнопка(Новый Структура("Подпись, Форма, Тип", "Свернуть", "рассылка-правка", "обычная")).Рендер();
	Ожидаем.Что(СтрНайти(Обычная, "form="), "кнопка без отправки формой не владеет").Равно(0);

КонецПроцедуры

&Тест
Процедура РазделФормыПечатаетсяГруппойСЛегендой() Экспорт

	HTML = Кит.Группа("Куда отправлять", "раздел").Рендер();
	Ожидаем.Что(HTML, "раздел — группа полей с подписью")
		.Содержит("<fieldset class=""form-section""><legend>Куда отправлять</legend>");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МодельСводки()

	Знаки = Новый Массив();
	Знаки.Добавить(Новый Структура("Текст, Вид", "выключена", "warn"));

	Подпись = Новый Массив();
	Подпись.Добавить("почта");
	Подпись.Добавить("");
	Подпись.Добавить("отдел продаж");

	Сведения = Новый Массив();
	Сведения.Добавить(Новый Структура("Подпись, Значение", "Темы", "Заказы, Отмены, Возвраты"));
	Сведения.Добавить(Новый Структура("Подпись, Значение", "Пусто", ""));
	Сведения.Добавить(Новый Структура("Подпись, Значение, Вид", "Пропало", "Опросы", "warn"));

	Возврат Новый Структура("Название, Знаки, Подпись, Сведения", "Вечерний отчёт", Знаки, Подпись, Сведения);

КонецФункции

Функция МодельДерева()

	Данные = Новый Соответствие();
	Данные.Вставить("key", "город_1");
	Данные.Вставить("x onclick", "плохо");

	Север = Новый Массив();
	Север.Добавить(Новый Структура("Имя, Подпись, Данные", "город_1", "Архангельск", Данные));
	Север.Добавить(Новый Структура("Имя, Подпись, Состояние", "город_2", "Мурманск", "выкл"));

	Восток = Новый Массив();
	Восток.Добавить(Новый Структура("Имя, Подпись, Состояние, Отключён", "город_4", "Владивосток", "выкл", Истина));

	Юг = Новый Массив();
	Юг.Добавить(Новый Структура("Имя, Подпись, Значение", "город_3", "Краснодар", "весь"));

	Узлы = Новый Массив();
	Узлы.Добавить(Новый Структура("Имя, Подпись, Дети", "край_1", "Юг", Юг));
	Узлы.Добавить(Новый Структура("Имя, Подпись, Состояние, Дети, Открыт", "край_2", "Север", "частично", Север, Истина));
	Узлы.Добавить(Новый Структура("Имя, Подпись, Состояние, Дети, Примечание", "край_3", "Восток", "выкл", Восток,
		"Показан 1 из 40"));
	Возврат Новый Структура("Подпись, Узлы", "Где работаем", Узлы);

КонецФункции

// Тег галки по её имени.
Функция Галка(Знач HTML, Знач Имя)

	Позиция = СтрНайти(HTML, "name=""" + Имя + """");
	Ожидаем.Что(Позиция > 0, "галка " + Имя + " напечатана: " + HTML).ЭтоИстина();
	Начало = Позиция;
	Пока Начало > 1 И Сред(HTML, Начало, 1) <> "<" Цикл
		Начало = Начало - 1;
	КонецЦикла;
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));

КонецФункции

Функция Ошибка(Знач Компонент, Знач Модель)

	Попытка
		Компонент.Отрисовать(Модель);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция МеждуМаркеров(Знач Текст, Знач Начало, Знач Конец)

	Открытие = СтрНайти(Текст, Начало);
	Если Открытие = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Открытие + СтрДлина(Начало));
	Закрытие = СтрНайти(Хвост, Конец);
	Возврат ?(Закрытие = 0, Хвост, Лев(Хвост, Закрытие - 1));

КонецФункции

#КонецОбласти
