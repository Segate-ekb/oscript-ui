// Слой элементов экрана: экран собирается деревом узлов, а разметку печатает кит.
// Проверяется то, что ломается для человека: содержимое исчезает со страницы, ячейка
// не принимает элемент, ссылка уводит не туда, форма получает 403, заголовок пропадает
// из оглавления.

#Использовать "../"
#Использовать asserts

Перем Кит;      // Кит — фабрика элементов экрана
Перем Разметка; // РазметкаЭлементов
Перем Формы;    // Формы — фабрика объявлений форм
Перем Экран;    // ЭкранированиеHTML — им же сверяется экранирование
Перем Разбор;   // РазборЛиста — сканер, читающий КОД листа, а не его текст

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	ПодключитьСценарий(ОбъединитьПути(КаталогТестов, "фикстуры", "СборкаХолста.os"), "СборкаХолста");
	ПодключитьСценарий(ОбъединитьПути(КаталогТестов, "фикстуры", "РазборЛиста.os"), "РазборЛиста");

	Слой = Новый СборкаХолста().Собрать();
	Кит = Слой.Кит;
	Разметка = Слой.Разметка;
	Формы = Слой.Формы;
	Экран = Слой.Экран;
	Разбор = Новый РазборЛиста();

КонецПроцедуры

#Область Таблица

// Ячейка — нормальный холст, а не место для готового HTML: элементы кладутся внутрь
// и печатаются внутри <td>. Пока ячейка принимала строку, каждый список собирал
// разметку руками — ровно та протечка, ради которой заведён слой элементов.
&Тест
Процедура ЯчейкаПринимаетЭлементыИПечатаетИхВнутриСебя() Экспорт

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка("Имя"));

	Запись = Таблица.Добавить(Кит.Запись());
	Ячейка = Запись.Добавить(Кит.Ячейка());
	Ячейка.Добавить(Кит.Код("имя-пакета"));
	Ячейка.Добавить(Кит.Ссылка("/x").Добавить(Кит.Текст("подробнее")).Родитель());

	HTML = Таблица.Рендер();
	Внутри = МеждуМаркеров(HTML, "<td", "</td>");

	Ожидаем.Что(СтрНайти(Внутри, "<code>имя-пакета</code>") > 0,
		"машинное значение напечатано ВНУТРИ ячейки: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Внутри, "<a href=""/x"">подробнее</a>") > 0,
		"и ссылка тоже: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<th scope=""col"">Имя</th>") > 0,
		"колонка печатается заголовком столбца: " + HTML).ЭтоИстина();

КонецПроцедуры

// Пустой список отвечает человеку словами, а не пустой рамкой из шапки без строк.
&Тест
Процедура ТаблицаБезЗаписейПечатаетСвойХолстПустоты() Экспорт

	Пустая = Кит.Таблица();
	Пустая.Добавить(Кит.Колонка("Имя"));
	Пустая.Пусто().Добавить(Кит.Примечание("Ничего не найдено"));

	HTML = Пустая.Рендер();
	Ожидаем.Что(СтрНайти(HTML, "Ничего не найдено") > 0,
		"человеку сказано, что список пуст: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<table"), "рамки без строк нет: " + HTML).Равно(0);

	// КОНТРОЛЬ: с записью печатается сама таблица, а не текст пустоты
	Полная = Кит.Таблица();
	Полная.Добавить(Кит.Колонка("Имя"));
	Полная.Пусто().Добавить(Кит.Примечание("Ничего не найдено"));
	Полная.Добавить(Кит.Запись()).Добавить(Кит.Ячейка()).Добавить(Кит.Текст("строка"));

	СЗаписью = Полная.Рендер();
	Ожидаем.Что(СтрНайти(СЗаписью, "<table") > 0, "таблица на месте: " + СЗаписью).ЭтоИстина();
	Ожидаем.Что(СтрНайти(СЗаписью, "Ничего не найдено"), "а текста пустоты нет").Равно(0);

КонецПроцедуры

// Разворот — строка ПОД записью во всю ширину таблицы: вложить его внутрь <tr> нельзя,
// а съёжившийся в одну колонку разворот обрезает содержимое.
&Тест
Процедура РазворотПечатаетсяСтрокойПодЗаписьюВоВсюШирину() Экспорт

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка("Имя"));
	Таблица.Добавить(Кит.Колонка("Состояние"));
	Таблица.Добавить(Кит.Колонка("Действия"));

	Запись = Таблица.Добавить(Кит.Запись());
	Запись.Добавить(Кит.Ячейка()).Добавить(Кит.Текст("пакет"));
	Запись.Разворот().Добавить(Кит.Примечание("подробности"));

	HTML = Таблица.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "colspan=""3""") > 0,
		"разворот занимает все три колонки: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "table__record") > 0,
		"запись помечена как несущая разворот: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "подробности") > СтрНайти(HTML, "пакет"),
		"разворот напечатан ПОСЛЕ записи: " + HTML).ЭтоИстина();

	// КОНТРОЛЬ: незаполненный разворот не печатает ни лишней строки, ни пометки
	Простая = Кит.Таблица();
	Простая.Добавить(Кит.Колонка("Имя"));
	Простая.Добавить(Кит.Запись()).Добавить(Кит.Ячейка()).Добавить(Кит.Текст("пакет"));

	Голая = Простая.Рендер();
	Ожидаем.Что(СтрНайти(Голая, "table__expand"), "пустой строки нет").Равно(0);
	Ожидаем.Что(СтрНайти(Голая, "table__record"), "и пометки на записи тоже").Равно(0);

КонецПроцедуры

// Одна запись списка бывает ответом на вопрос, ради которого список открыли. Такую строку
// красит вид записи, а не ячейка внутри неё: заливка обязана забрать строку целиком,
// иначе выделенным окажется один столбец из пяти.
&Тест
Процедура ВыделеннаяЗаписьКраситВсюСтрокуИТолькоСвою() Экспорт

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка("Имя"));

	Своя = Таблица.Добавить(Кит.Запись("выделенная"));
	Своя.Добавить(Кит.Ячейка()).Добавить(Кит.Текст("основная"));

	Чужая = Таблица.Добавить(Кит.Запись());
	Чужая.Добавить(Кит.Ячейка()).Добавить(Кит.Текст("обычная"));

	HTML = Таблица.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<tr class=""row-accent"">") > 0,
		"выделение стоит НА СТРОКЕ, а не внутри ячейки: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "row-accent"),
		"и ровно у одной строки из двух: " + HTML).Равно(1);
	Ожидаем.Что(СтрНайти(МеждуМаркеров(HTML, "<tr class=""row-accent"">", "</tr>"), "основная") > 0,
		"выделена именно та запись, которой вид задали: " + HTML).ЭтоИстина();

КонецПроцедуры

// Столбец под значок сжимается по содержимому: без этого колонка на один глиф забирает
// у соседей пятую часть таблицы. Ширину даёт вид узла, а не стиль в разметке.
&Тест
Процедура УзкийСтолбецСжимаетИЗаголовокИЯчейку() Экспорт

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Колонка("", "узкая"));
	Таблица.Добавить(Кит.Колонка("Имя"));

	Запись = Таблица.Добавить(Кит.Запись());
	Запись.Добавить(Кит.Ячейка("узкая")).Добавить(Кит.Текст("!"));
	Запись.Добавить(Кит.Ячейка()).Добавить(Кит.Текст("значение"));

	HTML = Таблица.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<th scope=""col"" class=""col-narrow""></th>") > 0,
		"узкий столбец объявлен в шапке и подписи не требует: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<td class=""cell-narrow"">") > 0,
		"и ячейка под ним тоже узкая: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<th scope=""col"">Имя</th>") > 0,
		"а соседний столбец остался обычным: " + HTML).ЭтоИстина();

КонецПроцедуры

// Узел, которого родитель не печатает, исчез бы со страницы молча — и автор увидел бы
// это только в браузере.
&Тест
Процедура ЧужойРодВнутрьТаблицыИЗаписиНеЛожится() Экспорт

	Ожидаем.Что(ОшибкаДобавления(Кит.Таблица(), Кит.Надпись("")),
		"надпись в таблице не печатается — её кладут в ячейку").Заполнено();
	Ожидаем.Что(ОшибкаДобавления(Кит.Запись(), Кит.Текст("значение")),
		"текст в записи не печатается — его кладут в ячейку").Заполнено();

	// КОНТРОЛЬ: свои роды ложатся
	Ожидаем.Что(ОшибкаДобавления(Кит.Таблица(), Кит.Запись()), "запись в таблицу").Равно("");
	Ожидаем.Что(ОшибкаДобавления(Кит.Запись(), Кит.Ячейка()), "ячейка в запись").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СлотКомпонента

// Контейнерный компонент берёт содержимое ДЕТЬМИ, а не полем модели: пока тело карточки
// приходило готовым HTML, каждый экран собирал его конкатенацией.
&Тест
Процедура КомпонентСоСлотомПечатаетДетейВнутриСебя() Экспорт

	Карточка = Кит.Карточка(Новый Структура("Заголовок", "Пулы"));
	Карточка.Добавить(Кит.Примечание("две штуки"));

	HTML = Карточка.Рендер();
	Тело = МеждуМаркеров(HTML, "card__body", "</div>");

	Ожидаем.Что(СтрНайти(Тело, "две штуки") > 0,
		"ребёнок напечатан ВНУТРИ тела компонента: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "Пулы") > 0, "и заголовок на месте: " + HTML).ЭтоИстина();

	// КОНТРОЛЬ: компонент без слота остаётся листом и внутрь себя не пускает
	Ожидаем.Что(ОшибкаДобавления(Кит.Кнопка(Новый Структура("Подпись", "Сохранить")),
		Кит.Текст("х")), "кнопка холстом не бывает").Заполнено();

КонецПроцедуры

// Модель приходит от вызывающего, и слот, дописанный в неё на печати, всплыл бы у него
// при следующей сборке того же экрана.
&Тест
Процедура ПечатьСлотаНеПортитПереданнуюМодель() Экспорт

	Модель = Новый Структура("Заголовок", "Пулы");
	Карточка = Кит.Карточка(Модель);
	Карточка.Добавить(Кит.Примечание("две штуки"));
	Карточка.Рендер();

	Значение = "";
	Ожидаем.Что(Модель.Свойство("Тело", Значение),
		"в модель вызывающего слот не дописан").ЭтоЛожь();

КонецПроцедуры

// Сетка раскладывает детей САМА, поэтому получает их по одному: склеенные в строку они
// стали бы одной ячейкой на всех, и раскладка в колонки исчезла бы.
&Тест
Процедура СеткаДелаетКаждогоРебёнкаОтдельнойЯчейкой() Экспорт

	Сетка = Кит.Сетка(Новый Структура("Колонки", 2));
	Сетка.Добавить(Кит.Примечание("слева"));
	Сетка.Добавить(Кит.Примечание("справа"));

	HTML = Сетка.Рендер();

	Ожидаем.Что(СтрЧислоВхождений(HTML, "grid__cell"),
		"два ребёнка — две ячейки: " + HTML).Равно(2);
	Ожидаем.Что(СтрНайти(HTML, "grid--2") > 0,
		"колонки из модели на месте: " + HTML).ЭтоИстина();

	// КОНТРОЛЬ: пустая сетка не печатает ни рамки, ни пустой ячейки
	Ожидаем.Что(Кит.Сетка(Новый Структура("Колонки", 2)).Рендер(),
		"сетка без детей не печатается вовсе").Равно("");

КонецПроцедуры

// Действия шапки объекта — обычные дети узла: пока они приходили готовой разметкой,
// каждая страница объекта склеивала кнопки строкой.
&Тест
Процедура ШапкаОбъектаБерётДействияДетьми() Экспорт

	Шапка = Кит.ШапкаОбъекта(Новый Структура("Имя", "Витрина"));
	Шапка.Добавить(Кит.Кнопка(Новый Структура("Подпись, Адрес", "Править", "/x")));

	HTML = Шапка.Рендер();
	Действия = МеждуМаркеров(HTML, "objhead__actions", "</div>");

	Ожидаем.Что(СтрНайти(Действия, "Править") > 0,
		"кнопка напечатана в действиях шапки: " + HTML).ЭтоИстина();

	// КОНТРОЛЬ: шапка без детей действий не печатает
	Ожидаем.Что(СтрНайти(Кит.ШапкаОбъекта(Новый Структура("Имя", "Витрина")).Рендер(),
		"objhead__actions"), "пустого блока действий нет").Равно(0);

КонецПроцедуры

// Признак у имени — значок, а не плашка: он стоит в самом заголовке сразу за именем,
// назван для скринридера своей подписью — она же всплывающая подсказка — и держится
// за последний символ имени, чтобы не уйти на строку один. Имя экранируется.
&Тест
Процедура ПризнакСтоитСразуЗаИменемИНазванДляСкринридера() Экспорт

	HTML = ШапкаСПризнаком("отчёт<b>").Рендер();
	Заголовок = МеждуМаркеров(HTML, "<h1", "</h1>");

	Ожидаем.Что(СтрНайти(Заголовок,
			"отчёт&lt;b<span class=""objhead__tail"">&gt;<span class=""objhead__mark"">") > 0,
		"значок стоит сразу за именем, приклеенный к его последнему символу: " + Заголовок)
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Заголовок, "role=""img""") > 0
			И СтрНайти(Заголовок, "<title>Выпуск подписан ключом</title>") > 0,
		"значок назван подписью — она же подсказка: " + Заголовок).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Заголовок, " title="""),
		"второй подсказки, которую перекрыл бы <title> значка, нет: " + Заголовок).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "objhead__chips"),
		"признак — не ряд плашек: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<b>"), "имя разметкой не стало: " + HTML).Равно(0);

КонецПроцедуры

// Символ за пределами BMP в строке — два юнита (суррогатная пара). Разрежь имя между
// ними — и обе половины станут знаками замены «�»: вместо смайлика у имени человек
// увидит два ромба с вопросом.
&Тест
Процедура ИмяСоСмайликомВКонцеНеРежетсяПополам() Экспорт

	Смайлик = "😀";
	Ожидаем.Что(СтрДлина(Смайлик), "смайлик в строке — суррогатная пара").Равно(2);

	Заголовок = МеждуМаркеров(ШапкаСПризнаком("отчёт" + Смайлик).Рендер(), "<h1", "</h1>");

	Ожидаем.Что(СтрНайти(Заголовок, "отчёт<span class=""objhead__tail"">" + Смайлик
			+ "<span class=""objhead__mark"">") > 0,
		"к значку приклеен смайлик целиком: " + Заголовок).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Заголовок, Символ(65533)), "знаков замены нет").Равно(0);

	// КОНТРОЛЬ: обычная буква в конце режется одна
	Ожидаем.Что(СтрНайти(МеждуМаркеров(ШапкаСПризнаком("отчёт").Рендер(), "<h1", "</h1>"),
		"отчё<span class=""objhead__tail"">т<span") > 0, "обычная буква — одна").ЭтоИстина();

КонецПроцедуры

// Без признаков шапка печатается прежней — байт в байт; признак с неизвестным значком
// не печатается, и шапка тоже остаётся прежней. Признак без подписи — ошибка вызывающего:
// немой значок у имени скринридер не назовёт, и шапка его не печатает, а отвергает.
&Тест
Процедура БезПризнаковШапкаПечатаетсяПрежней() Экспорт

	Прежняя = "<header class=""objhead""><div class=""objhead__top"">"
		+ "<h1 class=""objhead__title""><span>Витрина</span></h1></div></header>";

	Ожидаем.Что(Кит.ШапкаОбъекта(Новый Структура("Имя", "Витрина")).Рендер(),
		"шапка без признаков").Равно(Прежняя);

	Неизвестные = Новый Массив();
	Неизвестные.Добавить(Новый Структура("Иконка, Подпись", "такого-значка-нет", "Подписан"));
	Ожидаем.Что(Кит.ШапкаОбъекта(Новый Структура("Имя, Признаки", "Витрина", Неизвестные))
		.Рендер(), "признак с неизвестным значком не печатается").Равно(Прежняя);
	Ожидаем.Что(Кит.ШапкаОбъекта(Новый Структура("Имя, Признаки", "Витрина", Новый Массив()))
		.Рендер(), "пустой список признаков").Равно(Прежняя);

	Немые = Новый Массив();
	Немые.Добавить(Новый Структура("Иконка", "замок"));
	Ожидаем.Что(ОшибкаПечати(Кит.ШапкаОбъекта(Новый Структура("Имя, Признаки", "Витрина", Немые))),
		"признак без подписи отвергается").Заполнено();

КонецПроцедуры

// Значок признака размером с букву имени и стоит по средней линии строки, цвет — из
// токенов темы; последний символ имени и значок — неразрывный кусок. Считается каскадом
// листа для самого значка на ширине телефона.
&Тест
Процедура ПризнакРазмеромСБуквуИмениИНеОтрываетсяОтНего() Экспорт

	Цепочка = Новый Массив();
	Цепочка.Добавить(Разбор.Узел("header", "objhead"));
	Цепочка.Добавить(Разбор.Узел("div", "objhead__top"));
	Цепочка.Добавить(Разбор.Узел("h1", "objhead__title"));
	Цепочка.Добавить(Разбор.Узел("span"));
	Цепочка.Добавить(Разбор.Узел("span", "objhead__tail"));
	Хвост = Разбор.Каскад(Цепочка, 390, "white-space");

	Цепочка.Добавить(Разбор.Узел("span", "objhead__mark"));
	Обёртка = Разбор.Каскад(Цепочка, 390, "margin-left");

	Цепочка.Добавить(Разбор.Узел("svg", "icon"));
	Значок = Разбор.Каскад(Цепочка, 390, "width,height,vertical-align,color");

	Ожидаем.Что(Хвост.Получить("white-space"),
		"последний символ имени и значок — неразрывный кусок").Равно("nowrap");
	Ожидаем.Что(Значок.Получить("width"), "значок шириной с букву имени").Равно("1em");
	Ожидаем.Что(Значок.Получить("height"), "и высотой с неё").Равно("1em");
	Ожидаем.Что(Значок.Получить("vertical-align"), "по средней линии строки").Равно("middle");
	Ожидаем.Что(СтрНачинаетсяС(Строка(Значок.Получить("color")), "var(--"),
		"цвет значка — токен темы: " + Значок.Получить("color")).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строка(Обёртка.Получить("margin-left")), "var(--space-") > 0,
		"зазор до имени — токен отступа: " + Обёртка.Получить("margin-left")).ЭтоИстина();

КонецПроцедуры

// Обёртка над компонентом названа: в дереве экрана видно, ЧТО за компонент напечатан,
// а не безымянный кусок разметки.
&Тест
Процедура ОбёрткаНадКомпонентомНазванаВДереве() Экспорт

	Холст = Кит.Холст();
	Холст.Добавить(Кит.ПустоеСостояние("Ничего нет"));
	Холст.Добавить(Кит.Пагинация(Новый Структура("ВсегоСтраниц, Страница, Основа",
		3, 1, "/каталог")));
	Холст.Добавить(Кит.Иконка("инфо"));

	Дерево = Холст.Дерево();

	Ожидаем.Что(СтрНайти(Дерево, "компонент[пустое]") > 0,
		"пустое состояние названо в дереве: " + Дерево).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Дерево, "компонент[страницы]") > 0,
		"пагинация названа в дереве: " + Дерево).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Дерево, "компонент[иконка]") > 0,
		"значок назван в дереве: " + Дерево).ЭтоИстина();

	HTML = Холст.Рендер();
	Ожидаем.Что(СтрНайти(HTML, "Ничего нет") > 0,
		"и напечатано это тем же компонентом: " + HTML).ЭтоИстина();

КонецПроцедуры

// Ряд метаданных оформляется парой классов, и пара у шапки объекта своя. Класс приходит
// не строкой от экрана, а видом: иначе имя класса снова протекает наружу.
&Тест
Процедура РядМетыБерётОформлениеУВидаАНеУВызывающего() Экспорт

	Элементы = Новый Массив();
	Элементы.Добавить(Новый Структура("Подпись, Значение", "Обновлён", "вчера"));

	HTML = Кит.РядМеты(Элементы, "шапка").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "objhead__meta") > 0,
		"ряд оформлен как ряд шапки: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "вчера") > 0, "значение на месте: " + HTML).ЭтоИстина();

	// КОНТРОЛЬ: вида, которого кит не знает, не бывает — молча неоформленного ряда нет
	Ожидаем.Что(ОшибкаМеты(Элементы, "objhead__meta"),
		"имя класса видом не притворится").Содержит("не бывает");

КонецПроцедуры

#КонецОбласти

#Область СпискиИСвойства

// Список — раскладка, а не абзац с переносами: пункты кладут внутрь, и чужой род
// внутрь не ложится, иначе он исчез бы со страницы молча.
&Тест
Процедура СписокПечатаетПунктыИЧужогоРодаНеПринимает() Экспорт

	Список = Кит.Список("сноска");
	Список.Добавить(Кит.Пункт()).Добавить(Кит.Текст("восемь символов"));
	Список.Добавить(Кит.Пункт()).Добавить(Кит.Ссылка("/x").Добавить(Кит.Текст("прежний"))
		.Родитель());

	HTML = Список.Рендер();

	Ожидаем.Что(СтрЧислоВхождений(HTML, "<li>"),
		"два пункта — два тега: " + HTML).Равно(2);
	Ожидаем.Что(СтрНайти(HTML, "<a href=""/x"">прежний</a>") > 0,
		"ссылка напечатана внутри пункта: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "list-note") > 0,
		"вид «сноска» оформил список: " + HTML).ЭтоИстина();

	Ожидаем.Что(ОшибкаДобавления(Кит.Список(), Кит.Текст("мимо")),
		"текст в список кладут пунктом").Заполнено();

КонецПроцедуры

// Свойство печатается ПАРОЙ тегов: имя и значение — соседи, а не вложенные друг в друга.
// Пока пара собиралась строкой, детали записи журнала печатал экран.
&Тест
Процедура СвойствоПечатаетсяПаройИмениИЗначения() Экспорт

	Свойства = Кит.Свойства();
	Свойства.Добавить(Кит.Свойство("Кто")).Добавить(Кит.Код("admin"));

	HTML = Свойства.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<dt>Кто</dt><dd><code>admin</code></dd>") > 0,
		"имя и значение стоят парой: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<dl class=""props"">") > 0,
		"и лежат в списке определений: " + HTML).ЭтоИстина();

	Ожидаем.Что(ОшибкаДобавления(Кит.Свойства(), Кит.Пункт()),
		"пункт списка в список определений не ложится").Заполнено();

КонецПроцедуры

#КонецОбласти

#Область ВидыРаскрывашкиИКода

// У раскрывашки не одно оформление: панель настроек несёт три класса, а строка
// «подробнее» в ячейке таблицы — ни одного лишнего.
&Тест
Процедура ВидРаскрывашкиМеняетОформлениеВсехТрёхТегов() Экспорт

	Панель = Кит.Раскрывашка();
	Панель.Шапка().Добавить(Кит.Текст("Провайдер"));
	Панель.Добавить(Кит.Примечание("тело"));
	СКлассами = Панель.Рендер();

	Ожидаем.Что(СтрНайти(СКлассами, "<details class=""panel""") > 0,
		"панель осталась панелью: " + СКлассами).ЭтоИстина();
	Ожидаем.Что(СтрНайти(СКлассами, "panel__head") > 0,
		"и её шапка тоже: " + СКлассами).ЭтоИстина();

	Простая = Кит.Раскрывашка("простая");
	Простая.Шапка().Добавить(Кит.Текст("ещё 3"));
	Простая.Добавить(Кит.Текст("хвост"));
	Голая = Простая.Рендер();

	Ожидаем.Что(СтрНайти(Голая, "class="),
		"«простая» не несёт ни одного класса: " + Голая).Равно(0);
	Ожидаем.Что(СтрНайти(Голая, "<summary>ещё 3</summary>") > 0,
		"шапка на месте: " + Голая).ЭтоИстина();

КонецПроцедуры

// Свёрнутая строка называет всю раскрывашку скринридеру: без имени он читает «details»
// и человек не знает, что откроется.
&Тест
Процедура ПодписьРаскрывашкиСтановитсяИменемСвёрнутойСтроки() Экспорт

	Узел = Кит.Раскрывашка("подробность").Подпись("Подробности события");
	Узел.Шапка().Добавить(Кит.Текст("подробнее"));
	Узел.Добавить(Кит.Примечание("что поменялось"));

	HTML = Узел.Рендер();
	Шапка = МеждуМаркеров(HTML, "<summary", "</summary>");

	Ожидаем.Что(СтрНайти(Шапка, "aria-label=""Подробности события""") > 0,
		"имя стоит на свёрнутой строке, а не на всей раскрывашке: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<details class=""fold-detail""") > 0,
		"вид «подробность» оформил раскрывашку: " + HTML).ЭтоИстина();

КонецПроцедуры

// Образец команды в несколько строк переносами и держится: обычный <code> схлопнул бы
// их в пробелы, и образец перестал бы копироваться правильно.
&Тест
Процедура БлочныйКодСохраняетПереносыОбразца() Экспорт

	HTML = Кит.Код("[hub]" + Символы.ПС + "url = /", "блочный").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<pre class=""code""><code>") > 0,
		"образец печатается преформатированным: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, Символы.ПС) > 0,
		"перенос внутри образца цел: " + HTML).ЭтоИстина();

	// КОНТРОЛЬ: значение внутри строки текста остаётся обычным <code>
	Ожидаем.Что(Кит.Код("opm").Рендер(),
		"машинное значение в строке не обрастает <pre>").Равно("<code>opm</code>");

КонецПроцедуры

#КонецОбласти

#Область КарточкаОбъекта

// Карточка объекта — не компонент кита, а КОМПОЗИЦИЯ его родов: статья, шапка, имя,
// плашки, действия, описание и ряд метаданных. Пока таких видов не было, приложение
// печатало карточку своими руками — вместе с именами классов.
&Тест
Процедура КарточкаОбъектаСобираетсяКомпозициейРодов() Экспорт

	Список = Кит.Область("карточки");
	Карточка = Список.Добавить(Кит.Статья("карточка"));

	Шапка = Карточка.Добавить(Кит.Область("шапка"));
	Шапка.Добавить(Кит.Заголовок(3, "имя")).Добавить(Кит.Текст("winow"));
	Шапка.Добавить(Кит.Область("плашки")).Добавить(Кит.Плашка("свежий"));
	Шапка.Добавить(Кит.Область("действия"))
		.Добавить(Кит.Кнопка(Новый Структура("Подпись, Адрес", "Настроить", "/x")));

	Карточка.Добавить(Кит.Примечание("веб-фреймворк", "описание"));

	Мета = Новый Массив();
	Мета.Добавить(Новый Структура("Подпись, Значение", "Версия", "1.2.0"));
	Карточка.Добавить(Кит.РядМеты(Мета, "карточка"));

	HTML = Список.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<div class=""objcard-list""><article class=""objcard"">") > 0,
		"карточка лежит в колонке карточек: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<h3 class=""objcard__name"">winow</h3>") > 0,
		"имя объекта — заголовок третьего уровня: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "objcard__chips") > 0, "плашки: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "objcard__actions") > 0, "действия: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<p class=""objcard__desc"">веб-фреймворк</p>") > 0,
		"описание: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "objcard__meta-item") > 0,
		"ряд метаданных карточки: " + HTML).ЭтоИстина();

КонецПроцедуры

// Свёрнутый хвост ряда плашек — обычная раскрывашка своего вида: у неё свой класс на
// каждом из трёх тегов, и приложению не нужно печатать их самому.
&Тест
Процедура РядПлашекСоСвёрнутымХвостомСобираетсяРодами() Экспорт

	Ряд = Кит.Ряд("свёрнутые");
	Ряд.Добавить(Кит.Плашка("stable"));

	Хвост = Ряд.Добавить(Кит.Раскрывашка("хвост"));
	Хвост.Шапка().Добавить(Кит.Текст("ещё 2"));
	Хвост.Добавить(Кит.Плашка("rc"));

	HTML = Ряд.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<div class=""tag-row tag-row--inline"">") > 0,
		"ряд со свёрткой — тот же ряд плашек, только в строку: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<details class=""tag-row__more"">") > 0,
		"хвост — раскрывашка: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<summary class=""tag-row__count"">ещё 2</summary>") > 0,
		"счётчик — её свёрнутая строка: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "rc") > СтрНайти(HTML, "tag-row__rest"),
		"остаток лежит в теле раскрывашки: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "tag-fold"),
		"класса-двойника ряда плашек не осталось: " + HTML).Равно(0);

КонецПроцедуры

// Список без записей отвечает человеку словами; строку пустоты печатает тот же кит,
// а не экран своим литералом — ровно та протечка, ради которой заведён слой элементов.
&Тест
Процедура ТаблицаКарточкамиИПримечаниеПустотыБерутВидУКита() Экспорт

	Таблица = Кит.Таблица("карточками");
	Таблица.Добавить(Кит.Колонка("Пул"));
	Таблица.Пусто().Добавить(Кит.Примечание("Ничего не найдено", "пусто"));

	Пустая = Таблица.Рендер();
	Ожидаем.Что(Пустая, "строку пустоты печатает кит своим видом")
		.Равно("<p class=""note-empty"">Ничего не найдено</p>");

	Полная = Кит.Таблица("карточками");
	Полная.Добавить(Кит.Колонка("Пул"));
	Запись = Полная.Добавить(Кит.Запись());
	Запись.Добавить(Кит.Ячейка()).Добавить(Кит.Текст("общий"));
	Запись.Добавить(Кит.Ячейка("величина")).Добавить(Кит.Текст("12 / 100 МБ"));

	HTML = Полная.Рендер();
	Ожидаем.Что(СтрНайти(HTML, "<table class=""table table-cards"">") > 0,
		"таблица оформлена карточками: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<td class=""cell-value"">") > 0,
		"ячейка величины: " + HTML).ЭтоИстина();

КонецПроцедуры

// Запись таблицы карточками на узком экране теряет шапку, и ячейка называет свою колонку
// сама: «садовник» без «Роль» и дата без «Опубликована» не читаются. Подписи не несут:
// заглавная ячейка (её узнают в лицо), пустая — в том числе из одних пробелов и
// Кит.Ничего() (её не видно), ячейка с меню строки на любой глубине (там действия)
// и колонка, явно отказавшаяся от подписи. Плашка подпись не снимает: по виду значения
// кит не угадывает, называет ли оно себя само. Пустая ячейка помечена классом, по
// которому её прячет лист, — и у таблицы без колонок тоже.
&Тест
Процедура ЯчейкаЗаписиКарточкойНесётПодписьСвоейКолонки() Экспорт

	Ячейки = ОткрывающиеТегиЯчеек(ТаблицаУчёта("карточками").Рендер());

	Ожидаем.Что(Ячейки.Количество(), "ячеек в записи восемь").Равно(8);
	Ожидаем.Что(ПодписьЯчейки(Ячейки[1]),
		"ячейка несёт подпись своей колонки: " + Ячейки[1]).Равно("Роль & «доступ»");
	Ожидаем.Что(СтрНайти(Ячейки[1], Экран.Атрибут("data-label", "Роль & «доступ»")) > 0,
		"и подпись экранирована как атрибут: " + Ячейки[1]).ЭтоИстина();
	Ожидаем.Что(ПодписьЯчейки(Ячейки[4]),
		"ячейка из одной плашки подписана, пока колонка не отказалась: " + Ячейки[4])
		.Равно("Статус");
	Ожидаем.Что(ПодписьЯчейки(Ячейки[6]),
		"плашка рядом с текстом — тоже: " + Ячейки[6]).Равно("Признак");

	Ожидаем.Что(ПодписьЯчейки(Ячейки[0]), "заглавная ячейка без подписи").Равно("");
	Ожидаем.Что(ПодписьЯчейки(Ячейки[2]), "пустая ячейка без подписи").Равно("");
	Ожидаем.Что(ПодписьЯчейки(Ячейки[3]),
		"колонка, отказавшаяся от подписи, её не даёт").Равно("");
	Ожидаем.Что(ПодписьЯчейки(Ячейки[5]),
		"ячейка из пробелов и Ничего() без подписи").Равно("");
	Ожидаем.Что(ПодписьЯчейки(Ячейки[7]),
		"ячейка с меню строки, уложенным в ряд, без подписи").Равно("");

	// «пустая» для подписи и для листа — одно и то же: пустые помечены, остальные нет
	Для Номер = 0 По Ячейки.ВГраница() Цикл
		Ожидаем.Что(СтрНайти(Ячейки[Номер], "cell-empty") > 0,
			СтрШаблон("ячейка %1 помечена пустой ровно тогда, когда в ней нечего прочесть: %2",
				Номер, Ячейки[Номер])).Равно(Номер = 2 ИЛИ Номер = 5);
	КонецЦикла;

	// у таблицы карточками без колонок подписей нет, а пустая ячейка помечена всё равно
	БезКолонок = Кит.Таблица("карточками");
	Запись = БезКолонок.Добавить(Кит.Запись());
	Запись.Добавить(Кит.Ячейка()).Добавить(Кит.Текст("алиса"));
	Запись.Добавить(Кит.Ячейка());
	Голые = ОткрывающиеТегиЯчеек(БезКолонок.Рендер());
	Ожидаем.Что(СтрНайти(Голые[1], "cell-empty") > 0,
		"пустая ячейка таблицы без колонок помечена: " + Голые[1]).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Голые[0], "cell-empty"), "а заполненная — нет").Равно(0);

	// у обычной таблицы есть шапка: подписи в ячейках ей не нужны
	Ожидаем.Что(СтрНайти(ТаблицаУчёта("").Рендер(), "data-label"),
		"обычная таблица подписей в ячейках не несёт").Равно(0);

	// отказ от подписи — дело колонки: у ячейки его не бывает
	Ожидаем.Что(ОшибкаСвойстваУзла(Кит.Ячейка(), "БезПодписиВЗаписи"),
		"ячейка от подписи не отказывается").Заполнено();

КонецПроцедуры

// Узкий столбец на широком экране сжат по содержимому и не переносится. В записи-карточке
// та же ячейка — строка во всю ширину карточки: сохрани она 1% ширины и запрет переноса,
// номер встал бы столбиком по букве, а длинное значение увело бы запись вбок.
&Тест
Процедура УзкийСтолбецВЗаписиКарточкиРастянутНаВсюШирину() Экспорт

	Ячейка = Кит.Ячейка("узкая");
	Ячейка.Добавить(Кит.Текст("12"));
	Ожидаем.Что(СтрНайти(Ячейка.Рендер(), "cell-narrow") > 0,
		"узкая ячейка печатается своим классом: " + Ячейка.Рендер()).ЭтоИстина();

	Телефон = ВидУзкойЯчейкиЗаписи(390);
	Ожидаем.Что(Телефон.Получить("width") <> "1%",
		"в записи на телефоне узкая ячейка не сжата до 1%: " + Телефон.Получить("width"))
		.ЭтоИстина();
	Ожидаем.Что(Телефон.Получить("white-space") <> "nowrap",
		"и переносу в ней не запрещено").ЭтоИстина();

	Широкий = ВидУзкойЯчейкиЗаписи(1280);
	Ожидаем.Что(Широкий.Получить("width"), "на широком узкий столбец сжат по содержимому")
		.Равно("1%");
	Ожидаем.Что(Широкий.Получить("white-space"), "и не переносится").Равно("nowrap");

КонецПроцедуры

// Подпись ячейки печатает лист, и только на узком экране: на широком у таблицы есть шапка,
// и подпись над значением была бы дублем. Пустая ячейка на узком экране места в записи
// не занимает, а на широком остаётся — иначе поедут колонки.
&Тест
Процедура ПодписьЯчейкиПечатаетсяТолькоВЗаписиУзкогоЭкрана() Экспорт

	Узкий = 390;
	Широкий = 1280;

	Ожидаем.Что(ПодписьНадЯчейкой(Узкий).Получить("content"),
		"на узком лист печатает подпись колонки из разметки").Равно("attr(data-label)");
	Ожидаем.Что(ПодписьНадЯчейкой(Узкий).Получить("display"),
		"и это видимая строка").ЭтоНе().Равно("none");
	Ожидаем.Что(ПодписьНадЯчейкой(Широкий).Получить("content"),
		"на широком подписи над ячейкой нет: там шапка таблицы").Равно(Неопределено);

	Ожидаем.Что(ПоказПустойЯчейки(Узкий), "пустая ячейка записи на узком спрятана")
		.Равно("none");
	Ожидаем.Что(ПоказПустойЯчейки(Широкий) <> "none",
		"а на широком она на месте: колонки не едут").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СвойстваУзла

// Без enctype браузер отправляет вместо файла одно его имя, и загрузка молча приходит
// пустой. Свойство спрашивается у формы и только у неё.
&Тест
Процедура ФормаСФайламиОбъявляетЭтоБраузеру() Экспорт

	Форма = Кит.Форма("/hub/settings/branding", "токен").СФайлами();
	Форма.Добавить(Кит.Поле(Новый Структура("Имя, Вид", "файл", "файл")));

	HTML = Форма.Рендер();
	Ожидаем.Что(СтрНайти(HTML, "enctype=""multipart/form-data""") > 0,
		"форма объявила, что несёт файл: " + HTML).ЭтоИстина();

	// КОНТРОЛЬ: обычная форма enctype не несёт, а чужой род свойства не принимает
	Ожидаем.Что(СтрНайти(Кит.Форма("/x", "токен").Рендер(), "enctype"),
		"обычная форма без enctype").Равно(0);
	Ожидаем.Что(ОшибкаСвойстваУзла(Кит.Область(), "СФайлами"),
		"область файлов не несёт").Заполнено();

КонецПроцедуры

// Высота печатается атрибутом, чтобы место под картинку было занято ещё до листа стилей:
// иначе страница прыгает, когда картинка доезжает.
&Тест
Процедура ВысотаКартинкиПечатаетсяАтрибутом() Экспорт

	HTML = Кит.Картинка("/static/logo.svg").Высота(32).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "height=""32""") > 0,
		"высота на месте: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кит.Картинка("/static/logo.svg").Рендер(), "height"),
		"без высоты атрибута нет").Равно(0);
	Ожидаем.Что(ОшибкаСвойстваУзла(Кит.Надпись(""), "Высота"),
		"у надписи высоты не бывает").Заполнено();

КонецПроцедуры

// Ширина ставится только там, где пропорции известны заранее: у картинки произвольных
// пропорций заданная ширина впрессовала бы её в чужую рамку. Порядок «ширина, потом
// высота» — тот, в котором их читает браузер.
&Тест
Процедура ШиринаКартинкиПечатаетсяПередВысотой() Экспорт

	HTML = Кит.Картинка("/static/logo.svg").Ширина(28).Высота(28).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "width=""28"" height=""28""") > 0,
		"ширина стоит перед высотой: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кит.Картинка("/static/logo.svg").Высота(28).Рендер(), "width"),
		"без ширины атрибута нет").Равно(0);
	Ожидаем.Что(ОшибкаСвойстваУзла(Кит.Надпись(""), "Ширина"),
		"у надписи ширины не бывает").Заполнено();

КонецПроцедуры

// Роль сообщает скринридеру, что блок говорит о состоянии дела, а не является частью
// раскладки: без неё изменившийся текст остаётся непрочитанным.
&Тест
Процедура РолиСостоянияИТревогиКитуИзвестны() Экспорт

	Ожидаем.Что(СтрНайти(Кит.Область().Роль("состояние").Рендер(), "role=""status""") > 0,
		"состояние").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кит.Область().Роль("тревога").Рендер(), "role=""alert""") > 0,
		"тревога").ЭтоИстина();

	Ожибка = "";
	Попытка
		Кит.Область().Роль("status");
	Исключение
		Ожибка = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Ожибка, "значение атрибута ролью не притворится").Заполнено();

КонецПроцедуры

// Подсказка объясняет усечённое значение целиком — её спрашивают у машинного значения,
// у которого в строке видна только часть.
&Тест
Процедура ПодсказкаПечатаетсяАтрибутомTitle() Экспорт

	HTML = Кит.Код("a1b2").Подсказка("Полный отпечаток ключа").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "title=""Полный отпечаток ключа""") > 0,
		"подсказка на месте: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кит.Код("a1b2").Рендер(), "title"),
		"без подсказки атрибута нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ОбъявленныеФормы

// Форма знает свои поля и умеет разобрать пришедшее — это знание деревом печати
// не заменяется, поэтому объявленная форма входит в дерево узлом-компонентом.
&Тест
Процедура ОбъявленнаяФормаВходитВДеревоУзломКомпонента() Экспорт

	Объявление = ОбъявлениеПробы();
	Холст = Кит.Холст();
	Холст.Добавить(Кит.ОбъявленнаяФорма(Объявление, Новый Структура("имя", "витрина"),
		"/hub/settings/pools", "токен-сессии", "столбик"));

	Дерево = Холст.Дерево();
	Ожидаем.Что(СтрНайти(Дерево, "компонент[объявление]") > 0,
		"форма названа в дереве: " + Дерево).ЭтоИстина();

	HTML = Холст.Рендер();
	Ожидаем.Что(СтрНайти(HTML, "form-stack") > 0,
		"вид «столбик» доехал классом раскладки: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "витрина") > 0,
		"действующее значение поля напечатано: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "токен-сессии") > 0,
		"и CSRF-токен тоже: " + HTML).ЭтоИстина();

КонецПроцедуры

// Окно заведения — та же объявленная форма, показанная поверх экрана.
&Тест
Процедура ОкноВходитВДеревоТемЖеУзломЧтоИФорма() Экспорт

	Свойства = Новый Структура("Заголовок, Открывашка", "Новый пул", "Завести");
	Узел = Кит.Окно(ОбъявлениеПробы(), Новый Структура(), "/hub/settings/pools",
		"токен-сессии", Свойства);

	Ожидаем.Что(СтрНайти(Узел.Дерево(), "компонент[окно]") > 0,
		"окно названо в дереве: " + Узел.Дерево()).ЭтоИстина();

	HTML = Узел.Рендер();
	Ожидаем.Что(СтрНайти(HTML, "Новый пул") > 0,
		"окно называет себя заголовком: " + HTML).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Ссылка

// Адрес чужой схемы не должен доехать до href ни при какой сборке дерева: содержимое
// остаётся видимым, кликабельным оно не становится.
&Тест
Процедура СсылкаНедопустимойСхемыНеСтановитсяСсылкой() Экспорт

	Опасная = Кит.Ссылка("javascript:alert(1)");
	Опасная.Добавить(Кит.Текст("нажми"));
	HTML = Опасная.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<a"), "ссылки нет: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "нажми") > 0, "а текст виден: " + HTML).ЭтоИстина();

	// КОНТРОЛЬ: обычный адрес ссылкой становится
	Обычная = Кит.Ссылка("/packages/x");
	Обычная.Добавить(Кит.Текст("пакет"));
	Ожидаем.Что(СтрНайти(Обычная.Рендер(), "<a href=""/packages/x"">") > 0,
		"КОНТРОЛЬ: относительный адрес доехал").ЭтоИстина();

КонецПроцедуры

// Пустая ссылка кликабельна, но не названа: для скринридера это ссылка в никуда.
&Тест
Процедура СсылкаБезСодержимогоНеПечатается() Экспорт
	Ожидаем.Что(Кит.Ссылка("/x").Рендер(), "пустой ссылки нет").Равно("");
КонецПроцедуры

#КонецОбласти

#Область ПримечаниеИШаблон

// Половина примечаний экрана — фраза со вставкой внутри; пока примечание принимало только
// строку, вставку приклеивали готовым HTML.
&Тест
Процедура ПримечаниеПринимаетДетейИБезНихНеПечатается() Экспорт

	Примечание = Кит.Примечание();
	Примечание.Добавить(Кит.Текст("команда "));
	Примечание.Добавить(Кит.Код("opm install"));

	HTML = Примечание.Рендер();
	Ожидаем.Что(СтрНайти(HTML, "<code>opm install</code>") > 0,
		"вставка напечатана разметкой внутри примечания: " + HTML).ЭтоИстина();

	Ожидаем.Что(Кит.Примечание().Рендер(), "пустого абзаца нет").Равно("");
	Ожидаем.Что(СтрНайти(Кит.Примечание("одной строкой").Рендер(), "одной строкой") > 0,
		"КОНТРОЛЬ: примечание одной строкой по-прежнему работает").ЭтоИстина();

КонецПроцедуры

// Фраза остаётся цельной строкой для перевода, а вставки в неё собираются деревом.
&Тест
Процедура ШаблонСтавитДетейНаМестаИЭкранируетСвойТекст() Экспорт

	Шаблон = Кит.Шаблон("<b>Ставьте</b> %1 или %2");
	Шаблон.Добавить(Кит.Код("opm install"));
	Шаблон.Добавить(Кит.Ссылка("/x").Добавить(Кит.Текст("вручную")).Родитель());

	HTML = Шаблон.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<b>"), "текст шаблона разметкой не стал: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;b&gt;") > 0, "он напечатан текстом: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<code>opm install</code>") > 0,
		"первый ребёнок занял первое место: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<code") < СтрНайти(HTML, "<a href"),
		"порядок мест соблюдён: " + HTML).ЭтоИстина();

КонецПроцедуры

// Место без ребёнка напечатало бы «%2» человеку, ребёнок без места исчез бы со страницы.
&Тест
Процедура ШаблонОтбиваетРасхождениеМестИДетей() Экспорт

	Голодный = Кит.Шаблон("%1 и %2");
	Голодный.Добавить(Кит.Текст("одно"));
	Ожидаем.Что(ОшибкаПечати(Голодный), "мест больше, чем детей").Заполнено();

	Лишний = Кит.Шаблон("только %1");
	Лишний.Добавить(Кит.Текст("одно"));
	Лишний.Добавить(Кит.Текст("второе"));
	Ожидаем.Что(ОшибкаПечати(Лишний), "детей больше, чем мест").Заполнено();

	// КОНТРОЛЬ: сошлось — печатается
	Ровный = Кит.Шаблон("только %1");
	Ровный.Добавить(Кит.Текст("одно"));
	Ожидаем.Что(ОшибкаПечати(Ровный), "КОНТРОЛЬ: ровный шаблон печатается").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ОбластьИНадпись

// Признак для скрипта вешают на узел, у которого есть тег. У холста тега нет по замыслу —
// поэтому для «мне нужен блок, за который возьмётся скрипт» есть область.
&Тест
Процедура ОбластьНесётПризнакАХолстОстаётсяПрозрачным() Экспорт

	Блок = Кит.Область().Признак("state", "ready");
	Блок.Добавить(Кит.Текст("готово"));

	HTML = Блок.Рендер();
	Ожидаем.Что(СтрНайти(HTML, "<div data-state=""ready"">готово</div>") > 0,
		"область печатает свой блок с признаком: " + HTML).ЭтоИстина();

	Прозрачный = Кит.Холст();
	Прозрачный.Добавить(Кит.Текст("готово"));
	Ожидаем.Что(Прозрачный.Рендер(), "холст печатает только детей").Равно("готово");

КонецПроцедуры

// «Здесь показывать нечего» — свой вызов, а не холст, который забыли наполнить: экран
// возвращает Ничего() и не оставляет на странице ни байта. Тег, пробел или перенос строки
// от него сдвинули бы соседей — поэтому сверка на РАВЕНСТВО разметке без него.
&Тест
Процедура НичегоНеОставляетНаСтраницеНиБайта() Экспорт

	Ожидаем.Что(Кит.Ничего().Рендер(), "ничего печатается пустой строкой").Равно("");

	СНичем = Кит.Ряд("строкой");
	СНичем.Добавить(Кит.Надпись("название")).Добавить(Кит.Текст("имя"));
	СНичем.Добавить(Кит.Ничего());
	СНичем.Добавить(Кит.Надпись("пояснение")).Добавить(Кит.Текст("вчера"));

	БезНего = Кит.Ряд("строкой");
	БезНего.Добавить(Кит.Надпись("название")).Добавить(Кит.Текст("имя"));
	БезНего.Добавить(Кит.Надпись("пояснение")).Добавить(Кит.Текст("вчера"));

	Ожидаем.Что(СНичем.Рендер(), "ничего не оставляет следа между соседями")
		.Равно(БезНего.Рендер());

КонецПроцедуры

// Ничего — тот же узел, что холст, названный смыслом: он ложится всюду, куда ложится
// холст, и в дереве экрана виден тем же родом. Отдельный род сделал бы «нечего показывать»
// местом, куда не пускают правила вложения.
&Тест
Процедура НичегоЭтоТотЖеУзел_ЧтоПустойХолст() Экспорт

	Ожидаем.Что(Кит.Ничего().Род(), "род тот же, что у холста").Равно(Кит.Холст().Род());

	Ячейка = Кит.Ячейка();
	Ячейка.Добавить(Кит.Ничего());
	Ожидаем.Что(Ячейка.Рендер(), "и кладётся туда же, куда холст").Равно("<td></td>");

КонецПроцедуры

// Приглушённая надпись — восьмая часть всех надписей хаба. Вид вне закрытого набора
// останавливает сборку, поэтому «нет вида» значит «экран не соберётся вовсе».
&Тест
Процедура ПриглушённаяНадписьЕстьВНабореВидов() Экспорт

	Надпись = Кит.Надпись("приглушённая");
	Надпись.Добавить(Кит.Текст("необязательно"));

	HTML = Надпись.Рендер();
	Ожидаем.Что(СтрНайти(HTML, "class=") > 0, "вид даёт свой класс: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "необязательно") > 0, "и текст на месте: " + HTML).ЭтоИстина();

	Ожидаем.Что(Разметка.ВидыРода("надпись").Найти("приглушённая"),
		"вид объявлен роду «надпись»").Заполнено();

КонецПроцедуры

#КонецОбласти

#Область Формы

// Форма без токена выглядит рабочей и гарантированно получает 403. Отказ называет обе
// замены, чтобы автор не выкрутился пустым токеном.
&Тест
Процедура ФормаВошедшегоБезТокенаНеСобирается() Экспорт

	Отказ = ОшибкаСборкиФормы("");
	Ожидаем.Что(Отказ, "форма без токена отбита").Заполнено();
	Ожидаем.Что(СтрНайти(Отказ, "ФормаБезСессии") > 0,
		"названа замена для посетителя без сессии: " + Отказ).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ, "ФормаОтбора") > 0,
		"и замена для формы, которая ничего не меняет: " + Отказ).ЭтоИстина();

	HTML = Кит.Форма("/hub/settings/providers", "т0кен", "столбик").Рендер();
	Ожидаем.Что(СтрНайти(HTML, "name=""_csrf""") > 0,
		"а с токеном скрытое поле на месте: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "value=""т0кен""") > 0,
		"и в нём именно токен сессии: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "method=""post""") > 0, "и метод POST: " + HTML).ЭтоИстина();

КонецПроцедуры

// У посетителя, который ещё не вошёл, сессии нет, а CSRF-токен живёт В СЕССИИ — брать
// его неоткуда, и сервер на такой форме его не спрашивает. Отдельный род называет это
// исключение вслух: в дереве экрана видно «форма-без-сессии».
&Тест
Процедура ФормаБезСессииИдётPOSTБезПоляТокена() Экспорт

	Форма = Кит.ФормаБезСессии("/login", "столбик");
	Форма.Добавить(Кит.Поле(Новый Структура("Имя, Метка", "login", "Логин")));

	HTML = Форма.Рендер();
	Ожидаем.Что(СтрНайти(HTML, "method=""post""") > 0, "вход меняет состояние: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "_csrf"), "поля токена нет: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(Форма.Дерево(), "форма-без-сессии") > 0,
		"исключение названо в дереве экрана: " + Форма.Дерево()).ЭтоИстина();

КонецПроцедуры

// Отбор ничего не меняет, поэтому защищать в нём нечего: он идёт GET, и отправленный
// отбор виден в адресе и повторяем ссылкой.
&Тест
Процедура ФормаОтбораИдётGETБезПоляТокена() Экспорт

	HTML = Кит.ФормаОтбора("/packages", "строкой").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "method=""get""") > 0, "отбор спрашивает: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "_csrf"), "поля токена нет: " + HTML).Равно(0);

КонецПроцедуры

// Есть запросы, у которых сессия ЕСТЬ, а токена сервер не спрашивает сознательно: цена
// подделки — неудобство, а не ущерб (сменить читателю тему, выйти). Исключение названо
// родом, поэтому видно в дереве экрана и в дифе, а не спрятано во флаг.
&Тест
Процедура ФормаБезТокенаНазванаРодомИВидна() Экспорт

	Форма = Кит.ФормаБезТокена("/ui/theme", "переключатель");

	HTML = Форма.Рендер();
	Ожидаем.Что(СтрНайти(HTML, "method=""post""") > 0,
		"переключение меняет состояние: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "class=""theme-toggle""") > 0,
		"переключатель оформлен своим видом: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "_csrf"), "поля токена нет: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(Форма.Дерево(), "форма-без-токена") > 0,
		"исключение названо в дереве экрана: " + Форма.Дерево()).ЭтоИстина();

	// умолчание не тронуто: отказ формы вошедшего называет и эту замену
	Ожидаем.Что(СтрНайти(ОшибкаСборкиФормы(""), "ФормаБезТокена") > 0,
		"отказ называет форму без токена: " + ОшибкаСборкиФормы("")).ЭтоИстина();

КонецПроцедуры

// Форма без адреса действия отправила бы запрос на текущую страницу — молча и не туда.
&Тест
Процедура ЛюбаяФормаБезАдресаДействияНеПечатается() Экспорт

	Ожидаем.Что(ОшибкаПечати(Кит.Форма("", "т0кен")), "форма вошедшего").Заполнено();
	Ожидаем.Что(ОшибкаПечати(Кит.ФормаБезСессии("")), "форма без сессии").Заполнено();
	Ожидаем.Что(ОшибкаПечати(Кит.ФормаОтбора("")), "форма отбора").Заполнено();
	Ожидаем.Что(ОшибкаПечати(Кит.ФормаБезТокена("")), "форма без токена").Заполнено();

	Ожидаем.Что(ОшибкаПечати(Кит.ФормаОтбора("/packages")),
		"КОНТРОЛЬ: с адресом печатается").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Заголовок

// Уровень — место заголовка в оглавлении страницы, а не оформление, поэтому он число.
&Тест
Процедура ЗаголовокПечатаетсяУровнемИзЧисла() Экспорт

	Третий = Кит.Заголовок(3);
	Третий.Добавить(Кит.Текст("Зеркала"));
	HTML = Третий.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<h3>Зеркала</h3>") > 0,
		"уровень доехал до тега: " + HTML).ЭтоИстина();

	Первый = Кит.Заголовок(1);
	Первый.Добавить(Кит.Текст("Зеркала"));
	Ожидаем.Что(СтрНайти(Первый.Рендер(), "<h1>") > 0,
		"КОНТРОЛЬ: другой уровень даёт другой тег").ЭтоИстина();

КонецПроцедуры

// Седьмого уровня в HTML нет, нулевого тем более: молча съехав на первый, заголовок
// сломал бы оглавление страницы для скринридера.
&Тест
Процедура ЗаголовокВнеУровнейОтбиваетсяАПустойНеПечатается() Экспорт

	Ожидаем.Что(ОшибкаЗаголовка(7), "седьмого уровня не бывает").Заполнено();
	Ожидаем.Что(ОшибкаЗаголовка(0), "нулевого тоже").Заполнено();
	Ожидаем.Что(ОшибкаЗаголовка(2), "КОНТРОЛЬ: второй уровень бывает").Равно("");

	Ожидаем.Что(Кит.Заголовок(2).Рендер(), "пустого заголовка на странице нет").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Дерево

// «Из чего собран этот экран» отвечается объектом. Второй холст узла в дереве назван:
// иначе шапку раскрывашки не отличить от её тела.
&Тест
Процедура ДеревоНазываетВторойХолстУзла() Экспорт

	Раскрывашка = Кит.Раскрывашка();
	Раскрывашка.Шапка().Добавить(Кит.Надпись("название"));
	Раскрывашка.Добавить(Кит.Примечание("тело"));

	Дерево = Раскрывашка.Дерево();
	Ожидаем.Что(СтрНайти(Дерево, "шапка") > 0, "шапка названа: " + Дерево).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Дерево, "надпись[название]") > 0,
		"и её содержимое видно: " + Дерево).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Дерево, "надпись") > СтрНайти(Дерево, "шапка"),
		"содержимое шапки печатается ПОД ней: " + Дерево).ЭтоИстина();

	Таблица = Кит.Таблица();
	Таблица.Добавить(Кит.Запись()).Разворот().Добавить(Кит.Примечание("подробности"));
	Ожидаем.Что(СтрНайти(Таблица.Дерево(), "разворот") > 0,
		"разворот записи назван: " + Таблица.Дерево()).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Таблица.Дерево(), "пусто") > 0,
		"и холст пустоты таблицы: " + Таблица.Дерево()).ЭтоИстина();

КонецПроцедуры

// Второго холста у большинства узлов нет, и просьба о нём — ошибка автора, а не пустой
// холст, содержимое которого никуда не попадёт.
&Тест
Процедура ЧужойВторойХолстОтбиваетсяСИменемСвоего() Экспорт

	Отказ = "";
	Попытка
		Проба = Кит.Раскрывашка().Разворот();
		Проба = Проба;
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(Отказ, "у раскрывашки разворота нет").Заполнено();
	Ожидаем.Что(СтрНайти(Отказ, "шапка") > 0, "названо, как называется её второй холст: "
		+ Отказ).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СловарьДоменнойРаскладки

// Раскрытая раскрывашка — то же свойство узла, что «отключить» и «спрятать»: карточка,
// чью правку сервер отбил, приезжает развёрнутой, и человек видит своё поле с отказом.
&Тест
Процедура РаскрывашкаПечатаетсяРаскрытой() Экспорт

	Карточка = Кит.Раскрывашка().Открыть();
	Карточка.Шапка().Добавить(Кит.Текст("подписка"));
	Карточка.Добавить(Кит.Текст("форма"));

	HTML = Карточка.Рендер();
	Ожидаем.Что(СтрНайти(HTML, "<details class=""panel"" open>") > 0,
		"раскрывашка печатается с open: " + HTML).ЭтоИстина();

	Свёрнутая = Кит.Раскрывашка();
	Свёрнутая.Шапка().Добавить(Кит.Текст("подписка"));
	Ожидаем.Что(СтрНайти(Свёрнутая.Рендер(), " open"),
		"а без просьбы — без него: " + Свёрнутая.Рендер()).Равно(0);

КонецПроцедуры

// Открыть можно только раскрывашку: на чужом теге браузер атрибут выбросит, и «открытым»
// узел будет лишь в голове у автора.
&Тест
Процедура ОткрытымБываетТолькоРаскрывашка() Экспорт

	Отказ = ОшибкаОткрытия(Кит.Область());

	Ожидаем.Что(Отказ, "чужой род отбит").Заполнено();
	Ожидаем.Что(СтрНайти(Отказ, "область") > 0, "род назван: " + Отказ).ЭтоИстина();

КонецПроцедуры

// Приглушённый код — машинное значение, которое не спорит с соседним текстом. Пока вида
// не было, экран приглушал его надписью-обёрткой и печатал два тега вместо одного.
&Тест
Процедура ПриглушённыйКодПечатаетсяОднимТегом() Экспорт

	HTML = Кит.Код("sha256:abc", "приглушённый").Рендер();

	Ожидаем.Что(HTML, "код приглушён своим классом").Равно("<code class=""muted"">sha256:abc</code>");

КонецПроцедуры

// Форма внутри пункта меню — своя раскладка, а не «столбик»: панель меню узкая, и поля
// в ней стоят теснее. Вид задаёт кит, поэтому экрану не нужен ни свой <form>, ни класс.
&Тест
Процедура ФормаВМенюБеретРаскладкуУКита() Экспорт

	HTML = Кит.Форма("/pools", "t0k3n", "меню").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<form method=""post"" action=""/pools"" class=""menu__form"">") > 0,
		"форма меню несёт свою раскладку: " + HTML).ЭтоИстина();
	Ожидаем.Что(Разметка.ВидыРода("форма-отбора").Найти("меню"),
		"вид объявлен всем трём родам формы").Заполнено();

КонецПроцедуры

// Врезка — шаг ВНУТРИ формы, а не своя секция: у неё пунктирная рамка, заголовок и лид.
// Экран собирает её родами, поэтому имени класса за границей кита нет.
&Тест
Процедура ВрезкаСобираетсяОбластьюИНадписями() Экспорт

	Врезка = Кит.Область("вставка");
	Врезка.Добавить(Кит.Надпись("заголовок")).Добавить(Кит.Текст("Есть ссылка?"));
	Врезка.Добавить(Кит.Надпись("лид")).Добавить(Кит.Текст("Разберём её"));
	Врезка.Добавить(Кит.Ряд("справа")).Добавить(Кит.Текст("кнопка"));

	HTML = Врезка.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<div class=""inset"">") > 0,
		"врезка — своя область: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""inset__title"">Есть ссылка?</span>") > 0,
		"заголовок врезки: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""inset__lead"">Разберём её</span>") > 0,
		"и её лид: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<div class=""row-end"">кнопка</div>") > 0,
		"действие прижато к правому краю: " + HTML).ЭтоИстина();

КонецПроцедуры

// Студия — работа слева, живой образец справа. Колонки — виды области: на узком экране
// образец уезжает под работу, и держит это сама раскладка, а не медиазапрос экрана.
&Тест
Процедура СтудияСобираетсяДвумяКолонкамиОбласти() Экспорт

	Студия = Кит.Область("студия");
	Студия.Добавить(Кит.Область("работа")).Добавить(Кит.Текст("поля"));
	Студия.Добавить(Кит.Область("образец")).Добавить(Кит.Текст("плашка"));

	HTML = Студия.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<div class=""studio""><div class=""studio__work"">поля</div>") > 0,
		"работа — первая колонка: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<div class=""studio__sample"">плашка</div></div>") > 0,
		"образец — вторая: " + HTML).ЭтоИстина();

КонецПроцедуры

// Поле, чьё управление собрано вручную (ряд ссылок вместо <select>), остаётся полем:
// метка и пояснение читаются так же, как у обычного поля формы.
&Тест
Процедура ПолеСоСвоимУправлениемСобираетсяРодами() Экспорт

	Поле = Кит.Область("поле");
	Поле.Добавить(Кит.Надпись("метка")).Добавить(Кит.Текст("Тип"));
	Ряд = Поле.Добавить(Кит.Ряд("признаки"));
	Ряд.Добавить(Кит.Ссылка("/a", "пилюля")).Добавить(Кит.Текст("GitHub"));
	Ряд.Добавить(Кит.Ссылка("/b", "пилюля-текущая")).Добавить(Кит.Текст("GitLab"));

	HTML = Поле.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<div class=""field""><span class=""field__label"">Тип</span>") > 0,
		"поле и его метка: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<a href=""/a"" class=""chip"">GitHub</a>") > 0,
		"обычная пилюля: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<a href=""/b"" class=""chip chip--active"">GitLab</a>") > 0,
		"и выбранная: " + HTML).ЭтоИстина();

КонецПроцедуры

// Двухэтажная ячейка: сверху строка «значок и значение», снизу приписка. Значок при строке
// текста меньше обычного — иначе он перерастает строчку.
&Тест
Процедура ДвухэтажнаяЯчейкаСобираетсяРодами() Экспорт

	Ячейка = Кит.Ячейка("столбиком");
	Строка_ = Ячейка.Добавить(Кит.Ряд("строкой"));
	Строка_.Добавить(Кит.Картинка("/gh.svg", "значок-малый").Подпись("GitHub"));
	Строка_.Добавить(Кит.Код("acme/lib"));
	Ячейка.Добавить(Кит.Надпись("пояснение")).Добавить(Кит.Текст("издатель acme"));

	HTML = Ячейка.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<td class=""cell-stack""><div class=""row-line"">") > 0,
		"ячейка столбиком, внутри строка: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML,
		"<img class=""image-icon image-icon--small"" src=""/gh.svg"" alt=""GitHub"">") > 0,
		"значок при строке — малый, подпись стала alt: " + HTML).ЭтоИстина();

КонецПроцедуры

// Картинка без подписи декоративна: alt остаётся пустым, и скринридер её пропускает,
// а не читает вслух имя файла.
&Тест
Процедура КартинкаБезПодписиОстаётсяДекоративной() Экспорт

	HTML = Кит.Картинка("/logo.svg", "превью").Подсказка("Логотип хаба").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "alt=""""") > 0, "alt пуст: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "title=""Логотип хаба""") > 0,
		"подсказка стала title: " + HTML).ЭтоИстина();

КонецПроцедуры

// Плашка, чьё содержимое собирают дети: подпись — своим узлом, значки — своими. Так живое
// превью ставит крючки для скрипта, не собирая при этом плашку из тегов руками.
&Тест
Процедура ПлашкаБерётСодержимоеДетьми() Экспорт

	Плашка = Кит.Плашка(Новый Структура("Текст, Вид", "не видно", "ok"));
	Плашка.Добавить(Кит.Надпись().Признак("chip-glyph", "звезда")).Добавить(Кит.Текст("*"));
	Плашка.Добавить(Кит.Надпись().Признак("chip-caption", "")).Добавить(Кит.Текст("lts"));

	HTML = Плашка.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<span class=""tag tag--ok"">") > 0,
		"вид плашки на месте: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span data-chip-caption="""">lts</span>") > 0,
		"подпись — отдельный узел с признаком: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "не видно"),
		"текст модели уступил детям: " + HTML).Равно(0);

	Ожидаем.Что(Кит.Плашка("stable").Рендер(), "плашка строкой печатается как раньше")
		.Равно("<span class=""tag"">stable</span>");
	Ожидаем.Что(Кит.Плашка(Неопределено).Рендер(), "плашки нет — нет и разметки").Равно("");

КонецПроцедуры

// Группа без оформления существует ради одного: отключить и спрятать свои поля разом.
// Браузер не отправляет поля отключённого fieldset — этим переключаются наборы правила.
&Тест
Процедура ПростаяГруппаОтключаетсяИПрячетсяЦеликом() Экспорт

	Набор = Кит.Группа("", "простая").Признак("set", "semver").Отключить().Скрыть();
	Набор.Добавить(Кит.Текст("правило"));

	HTML = Набор.Рендер();

	Ожидаем.Что(СтрНайти(HTML,
		"<fieldset class=""field-set"" data-set=""semver"" disabled hidden>") > 0,
		"группа отключена и спрятана целиком: " + HTML).ЭтоИстина();

КонецПроцедуры

// Рамка объявленной формы — единственное место, куда имя CSS-класса заходило в кит строкой.
// Теперь это ВИД области: неизвестный останавливает сборку, а не даёт голый <div>.
&Тест
Процедура РамкаОбъявленнойФормыНазываетсяВидомОбласти() Экспорт

	Ф = Формы.Новая();
	Ф.Блок("<i>шаг</i>", Новый Структура("Рамка", "вставка"));
	Ф.Поле("ссылка", "Ссылка", "строка", Новый Структура("Рамка", "вставка"));

	Разметка_ = Ф.Тело();

	Ожидаем.Что(СтрНайти(Разметка_, "<div class=""inset"">") > 0,
		"рамка напечатана классом своего вида: " + Разметка_).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Разметка_, "вставка"),
		"имя вида в разметку не просачивается: " + Разметка_).Равно(0);

	Ожидаем.Что(ОшибкаРамки("ci-link"), "имя класса рамкой не считается").Заполнено();

КонецПроцедуры

#КонецОбласти

#Область АдресОтправкиКнопки

// Кнопка отправки уводит свою форму на другой адрес: так одна форма отправляется в два места,
// и данные формы едут телом, а адрес называет, куда.
&Тест
Процедура АдресОтправкиУводитФормуКнопкиНаСвойАдрес() Экспорт

	Тег = ТегКнопки(Новый Структура("Подпись, Имя, Значение, АдресОтправки", "Предпросмотр", "вид", "черновик",
		"/статьи/предпросмотр?вид=черновик#текст"));

	Ожидаем.Что(ЗначениеАтрибута(Тег, "formaction"), "форма уходит на адрес кнопки: " + Тег)
		.Равно("/статьи/предпросмотр?вид=черновик#текст");
	Ожидаем.Что(ЗначениеАтрибута(Тег, "type"), "и это по-прежнему кнопка отправки").Равно("submit");

КонецПроцедуры

// Адрес своего приложения бывает любого вида, лишь бы без схемы и без хоста: от корня,
// одним запросом или якорем, путём от текущей страницы. Двоеточие дальше первой косой
// схемой не считается.
&Тест
Процедура ОтносительныйАдресОтправкиПечатаетсяКакЕсть() Экспорт

	Адреса = Новый Массив();
	Адреса.Добавить("/статьи/предпросмотр");
	Адреса.Добавить("/заметки/12:30");
	Адреса.Добавить("?вид=предпросмотр");
	Адреса.Добавить("#текст");
	Адреса.Добавить("предпросмотр/черновик");
	Адреса.Добавить("../статьи?время=12:30");

	Для Каждого Адрес Из Адреса Цикл
		Тег = ТегКнопки(Новый Структура("Подпись, АдресОтправки", "Предпросмотр", Адрес));
		Ожидаем.Что(ЗначениеАтрибута(Тег, "formaction"), "адрес «" + Адрес + "» напечатан как есть: " + Тег)
			.Равно(Адрес);
	КонецЦикла;

КонецПроцедуры

// Пустой адрес значит «не задан»: форма уходит на свой адрес, и это не ошибка.
&Тест
Процедура ПустойАдресОтправкиАтрибутаНеДаёт() Экспорт

	Для Каждого Адрес Из СтрРазделить(",   ," + Символы.Таб + Символы.ПС, ",") Цикл
		Модель = Новый Структура("Подпись, АдресОтправки", "Сохранить", Адрес);
		Ожидаем.Что(ОшибкаКнопки(Модель), "пустой адрес — не ошибка").Равно("");
		Тег = ТегКнопки(Модель);
		Ожидаем.Что(СтрНайти(Тег, "formaction"), "пустой адрес — форма уходит на свой: " + Тег).Равно(0);
	КонецЦикла;

КонецПроцедуры

// Адрес — чужие данные: кавычка не рвёт атрибут, амперсанд печатается сущностью, а браузер
// читает ровно тот адрес, что передали.
&Тест
Процедура АдресОтправкиЭкранируетсяКакАдресаКита() Экспорт

	Адрес = "/x?a=1&b=""2""><script>";
	Тег = ТегКнопки(Новый Структура("Подпись, АдресОтправки", "Отправить", Адрес));

	Ожидаем.Что(СтрНайти(Тег, "formaction=""/x?a=1&amp;b=&quot;2&quot;&gt;&lt;script&gt;"""), "адрес экранирован: " + Тег)
		.Больше(0);
	Ожидаем.Что(ЗначениеАтрибута(Тег, "formaction"), "и читается тем же адресом").Равно(Адрес);
	Ожидаем.Что(СтрНайти(Тег, "<script"), "разметкой адрес не стал").Равно(0);

КонецПроцедуры

// Форма кита несёт токен CSRF, и адрес со схемой или чужим хостом увёз бы его со страницы.
// Молча выбросить такой адрес нельзя: кнопка ушла бы на адрес самой формы и выполнила бы
// другое действие, — поэтому разработчик получает исключение, где названы параметр и причина.
&Тест
Процедура НеОтносительныйАдресОтправкиОтбиваетсяИсключением() Экспорт

	Адреса = Новый Массив();
	Адреса.Добавить("https://чужой.пример/приём");
	Адреса.Добавить("http://чужой.пример/приём");
	Адреса.Добавить("HTTPS://чужой.пример/приём");
	Адреса.Добавить("ftp://чужой.пример/приём");
	Адреса.Добавить("mailto:кто@чужой.пример");
	Адреса.Добавить("javascript:alert(1)");
	Адреса.Добавить("JavaScript:alert(1)");
	Адреса.Добавить("data:text/html,<b>x</b>");
	Адреса.Добавить("VBScript:msgbox(1)");
	Адреса.Добавить(" javascript:alert(1)");
	Адреса.Добавить("java" + Символы.Таб + "script:alert(1)");
	Адреса.Добавить(Символ(1) + "javascript:alert(1)");
	Адреса.Добавить("&#106;avascript:alert(1)");
	Адреса.Добавить("javascript&colon;alert(1)");
	Адреса.Добавить("https&#58;//чужой.пример/приём");
	Адреса.Добавить("//чужой.пример/приём");
	Адреса.Добавить("/" + Символы.Таб + "/чужой.пример/приём");
	Адреса.Добавить("\\чужой.пример/приём");
	Адреса.Добавить("/\чужой.пример/приём");

	Для Каждого Адрес Из Адреса Цикл
		Отказ = ОшибкаКнопки(Новый Структура("Подпись, АдресОтправки", "Предпросмотр", Адрес));
		Ожидаем.Что(Отказ, "адрес «" + Адрес + "» отбит исключением").Заполнено();
		Ожидаем.Что(СтрНайти(Отказ, "АдресОтправки") > 0
			И СтрНайти(Отказ, "не относительный адрес своего приложения") > 0,
			"исключение называет параметр и причину: " + Отказ).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Ссылки кита принимают те же адреса, что принимали: строгость адреса отправки их не задела.
&Тест
Процедура СсылкиКитаПринимаютПрежниеАдреса() Экспорт

	Для Каждого Адрес Из СтрРазделить("https://пример.рф/док,//пример.рф/док,mailto:кто@пример.рф", ",") Цикл
		HTML = Кит.Кнопка(Новый Структура("Подпись, Адрес", "Документ", Адрес)).Рендер();
		Ожидаем.Что(ЗначениеАтрибута(HTML, "href"), "ссылка-кнопка ведёт на «" + Адрес + "»: " + HTML)
			.Равно(Адрес);
	КонецЦикла;

КонецПроцедуры

// Кнопка, которая форму не отправляет, адреса отправки не несёт: он был бы ложным обещанием.
&Тест
Процедура КнопкаБезОтправкиАдресаОтправкиНеНесёт() Экспорт

	Обычная = ТегКнопки(Новый Структура("Подпись, Тип, АдресОтправки", "Показать", "обычная", "/x"));
	Команда = ТегКнопки(Новый Структура("Подпись, Команда, Цель, АдресОтправки", "Открыть", "показать-окно",
		"окно", "/x"));
	Ссылка = Кит.Кнопка(Новый Структура("Подпись, Адрес, АдресОтправки", "Перейти", "/y", "/x")).Рендер();

	Ожидаем.Что(СтрНайти(Обычная, "formaction"), "у обычной кнопки: " + Обычная).Равно(0);
	Ожидаем.Что(СтрНайти(Команда, "formaction"), "у кнопки команды: " + Команда).Равно(0);
	Ожидаем.Что(СтрНайти(Ссылка, "formaction"), "у ссылки-кнопки: " + Ссылка).Равно(0);

КонецПроцедуры

// Кнопки, которым адрес отправки не задан, печатаются так же, как в 0.7.0, — байт в байт.
&Тест
Процедура КнопкаБезАдресаОтправкиПечатаетсяКакПрежде() Экспорт

	Ожидаем.Что(Кит.Кнопка(Новый Структура("Подпись", "Сохранить")).Рендер(), "простая кнопка")
		.Равно("<button type=""submit"" class=""button button--primary""><span>Сохранить</span></button>");
	Ожидаем.Что(Кит.Кнопка(Новый Структура("Подпись, Вариант, Имя, Значение, Подсказка", "статьи/черновик", "ссылка",
		"открыть", "статьи/черновик", "Открыть черновик")).Рендер(), "кнопка с именем и значением")
		.Равно("<button type=""submit"" class=""button button--link"" name=""открыть"" value=""статьи/черновик"""
			+ " title=""Открыть черновик""><span>статьи/черновик</span></button>");
	Ожидаем.Что(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер, БезВалидации", "Удалить", "опасная", "малый",
		Истина)).Рендер(), "кнопка без валидации")
		.Равно("<button type=""submit"" class=""button button--danger button--sm"" formnovalidate>"
			+ "<span>Удалить</span></button>");
	Ожидаем.Что(Кит.Кнопка(Новый Структура("Подпись, Адрес", "Настроить", "/x?a=1&b=2")).Рендер(), "ссылка-кнопка")
		.Равно("<a href=""/x?a=1&amp;b=2"" class=""button button--primary""><span>Настроить</span></a>");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТегКнопки(Знач Модель)
	HTML = Кит.Кнопка(Модель).Рендер();
	Возврат Лев(HTML, СтрНайти(HTML, ">"));
КонецФункции

Функция ОшибкаКнопки(Знач Модель)

	Попытка
		Кит.Кнопка(Модель).Рендер();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

// Значение атрибута, как его прочитал бы браузер: сущности раскрыты.
Функция ЗначениеАтрибута(Знач Тег, Знач Имя)
	Начало = СтрНайти(Тег, " " + Имя + "=""");
	Если Начало = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Хвост = Сред(Тег, Начало + СтрДлина(Имя) + 3);
	Значение = Лев(Хвост, СтрНайти(Хвост, """") - 1);
	Для Каждого Пара Из СтрРазделить("&quot;="",&lt;=<,&gt;=>,&#39;='", ",") Цикл
		Значение = СтрЗаменить(Значение, Лев(Пара, СтрНайти(Пара, "=") - 1), Сред(Пара, СтрНайти(Пара, "=") + 1));
	КонецЦикла;
	Возврат СтрЗаменить(Значение, "&amp;", "&");
КонецФункции

Функция ОшибкаДобавления(Знач Холст, Знач Ребёнок)

	Попытка
		Холст.Добавить(Ребёнок);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция ОшибкаПечати(Знач Элемент)

	Попытка
		Элемент.Рендер();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция ОшибкаСборкиФормы(Знач Токен)

	Попытка
		Проба = Кит.Форма("/hub/settings/providers", Токен);
		Проба = Проба;
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция ОшибкаЗаголовка(Знач Уровень)

	Попытка
		Проба = Кит.Заголовок(Уровень);
		Проба = Проба;
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

// Таблица учёта в восемь колонок и одну запись: заглавная, обычная, пустая, самоназванная,
// из одной плашки, из пробелов и Ничего(), плашка с текстом и меню строки, уложенное в ряд.
Функция ТаблицаУчёта(Знач Вид)

	Таблица = Кит.Таблица(Вид);
	Для Каждого Заголовок Из СтрРазделить(
			"Логин|Роль & «доступ»|Почта|Занято|Статус|Заметка|Признак|Действие", "|") Цикл
		Колонка = Таблица.Добавить(Кит.Колонка(Заголовок));
		Если Заголовок = "Занято" Тогда
			Колонка.БезПодписиВЗаписи();
		КонецЕсли;
	КонецЦикла;

	Пункты = Новый Массив();
	Пункты.Добавить(Новый Структура("Подпись, Адрес", "Правка", "/правка"));

	Запись = Таблица.Добавить(Кит.Запись());
	Запись.Добавить(Кит.Ячейка()).Добавить(Кит.Текст("алиса"));
	Запись.Добавить(Кит.Ячейка()).Добавить(Кит.Текст("садовник"));
	Запись.Добавить(Кит.Ячейка());
	Запись.Добавить(Кит.Ячейка()).Добавить(Кит.Текст("занято 3 из 5"));
	Запись.Добавить(Кит.Ячейка()).Добавить(Кит.Плашка("активна"));

	Пробелы = Запись.Добавить(Кит.Ячейка());
	Пробелы.Добавить(Кит.Ничего());
	Пробелы.Добавить(Кит.Текст("  "));

	Признак = Запись.Добавить(Кит.Ячейка());
	Признак.Добавить(Кит.Плашка("новая"));
	Признак.Добавить(Кит.Текст("с 1 августа"));

	Ряд = Запись.Добавить(Кит.Ячейка()).Добавить(Кит.Ряд("строкой"));
	Ряд.Добавить(Кит.Текст("правка"));
	Ряд.Добавить(Кит.Меню(Новый Структура("Подпись, Пункты", "Действия над «алиса»", Пункты)));

	Возврат Таблица;

КонецФункции

// Каскад листа о узкой ячейке записи таблицы карточками на экране этой ширины.
Функция ВидУзкойЯчейкиЗаписи(Знач Ширина)

	Цепочка = Новый Массив();
	Цепочка.Добавить(Разбор.Узел("div", "table-scroll"));
	Цепочка.Добавить(Разбор.Узел("table", "table,table-cards"));
	Цепочка.Добавить(Разбор.Узел("tbody"));
	Цепочка.Добавить(Разбор.Узел("tr"));
	Цепочка.Добавить(Разбор.Узел("td", "cell-narrow"));
	Возврат Разбор.Каскад(Цепочка, Ширина, "width,white-space");

КонецФункции

// Открывающие теги ячеек тела таблицы по порядку.
Функция ОткрывающиеТегиЯчеек(Знач HTML)

	Результат = Новый Массив();
	Тело = Сред(HTML, СтрНайти(HTML, "<tbody>"));
	Позиция = СтрНайти(Тело, "<td");
	Пока Позиция > 0 Цикл
		Хвост = Сред(Тело, Позиция);
		Результат.Добавить(Лев(Хвост, СтрНайти(Хвост, ">")));
		Позиция = СтрНайти(Тело, "<td", НаправлениеПоиска.СНачала, Позиция + 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Подпись ячейки словами — значение data-label, разэкранированное; "" — подписи нет.
Функция ПодписьЯчейки(Знач Тег)

	Начало = СтрНайти(Тег, "data-label=""");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Тег, Начало + СтрДлина("data-label="""));
	Значение = Лев(Хвост, СтрНайти(Хвост, """") - 1);
	Для Каждого Пара Из СтрРазделить("&lt;=<|&gt;=>|&quot;=""|&#39;='|&amp;=&", "|") Цикл
		Значение = СтрЗаменить(Значение, Лев(Пара, СтрНайти(Пара, "=") - 1),
			Сред(Пара, СтрНайти(Пара, "=") + 1));
	КонецЦикла;
	Возврат Значение;

КонецФункции

// Последнее слово каскада о подписи над ячейкой таблицы карточками на этой ширине.
Функция ПодписьНадЯчейкой(Знач Ширина)

	Итог = Новый Соответствие();
	Для Каждого Правило Из Разбор.ПравилаКласса("table-cards") Цикл
		Если СтрНайти(Правило.Селектор, "td[data-label]::before") > 0
			И Разбор.ДействуетНаШирине(Правило.Условия, Ширина) Тогда
			Для Каждого Объявление Из Правило.Объявления Цикл
				Итог.Вставить(Объявление.Ключ, НРег(СокрЛП(Объявление.Значение)));
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;

КонецФункции

// Показ пустой ячейки записи таблицы карточками на этой ширине: каскад листа.
Функция ПоказПустойЯчейки(Знач Ширина)

	Цепочка = Новый Массив();
	Цепочка.Добавить(Разбор.Узел("div", "table-scroll"));
	Цепочка.Добавить(Разбор.Узел("table", "table,table-cards"));
	Цепочка.Добавить(Разбор.Узел("tbody"));
	Цепочка.Добавить(Разбор.Узел("tr"));
	Цепочка.Добавить(Разбор.Узел("td", "cell-empty"));
	Возврат Строка(Разбор.Каскад(Цепочка, Ширина, "display").Получить("display"));

КонецФункции

Функция ОшибкаСвойстваУзла(Знач Элемент, Знач Имя)

	Попытка
		Если Имя = "СФайлами" Тогда
			Элемент.СФайлами();
		ИначеЕсли Имя = "БезПодписиВЗаписи" Тогда
			Элемент.БезПодписиВЗаписи();
		Иначе
			Элемент.Высота(32);
		КонецЕсли;
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция ОшибкаРамки(Знач Вид)

	Попытка
		Проба = Формы.Новая();
		Проба.Блок("<i>шаг</i>", Новый Структура("Рамка", Вид));
		Проба = Проба.Тело();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция ОшибкаОткрытия(Знач Элемент)

	Попытка
		Элемент.Открыть();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция ОшибкаМеты(Знач Элементы, Знач Вид)

	Попытка
		Проба = Кит.РядМеты(Элементы, Вид);
		Проба = Проба;
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция ОбъявлениеПробы()

	Результат = Формы.Новая();
	Результат.Поле("имя", "Имя пула");
	Возврат Результат;

КонецФункции

Функция ШапкаСПризнаком(Знач Имя)

	Признаки = Новый Массив();
	Признаки.Добавить(Новый Структура("Иконка, Подпись", "замок", "Выпуск подписан ключом"));
	Возврат Кит.ШапкаОбъекта(Новый Структура("Имя, Признаки", Имя, Признаки));

КонецФункции

Функция МеждуМаркеров(Знач Текст, Знач Начало, Знач Конец)

	Открытие = СтрНайти(Текст, Начало);
	Если Открытие = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Открытие + СтрДлина(Начало));
	Закрытие = СтрНайти(Хвост, Конец);
	Возврат ?(Закрытие = 0, Хвост, Лев(Хвост, Закрытие - 1));

КонецФункции

#КонецОбласти
