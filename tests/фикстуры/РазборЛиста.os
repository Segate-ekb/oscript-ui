// Фикстура: разбор таблицы стилей. Читает КОД, а не текст — комментарии и содержимое
// строковых литералов снимаются, поэтому имя из пояснения и имя из content: "…"
// использованием не считаются.

#Область ПубличныйИнтерфейс

// Имена CSS-переменных, которые лист ИСПОЛЬЗУЕТ через var(--…).
//
// Параметры:
//  ТекстCSS - Строка - таблица стилей либо блок объявлений.
//
// Возвращаемое значение:
//  Массив из Строка - имена вида «--color-bg», каждое по одному разу. Запасное значение
//   var(--x, значение) отбрасывается, вложенные var() учитываются.
//
Функция ИспользованныеПеременные(Знач ТекстCSS) Экспорт

	Результат = Новый Массив();
	// комментарий заменяется ПРОБЕЛОМ: склейка соседей («solid/*c*/var(--x)» → «solidvar(»)
	// теряла бы такое использование молча
	Текст = БезЛитералов(БезКомментариев(ТекстCSS, " "));
	Позиция = 1;

	Пока Истина Цикл

		Начало = СтрНайти(Текст, "var(", НаправлениеПоиска.СНачала, Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		Позиция = Начало + 4;

		// «--my-var(» — хвост чужого идентификатора, а не функция var()
		Если Начало > 1 И НЕ Разделитель(Сред(Текст, Начало - 1, 1)) Тогда
			Продолжить;
		КонецЕсли;

		Имя = ИмяПеременной(Текст, ПропуститьПробельные(Текст, Позиция));
		Если ЗначениеЗаполнено(Имя) И Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Имена CSS-переменных, которые текст ОБЪЯВЛЯЕТ («--имя: значение»).
//
// Параметры:
//  ТекстCSS - Строка - блок объявлений либо таблица стилей.
//
// Возвращаемое значение:
//  Массив из Строка - имена вида «--color-bg», каждое по одному разу. Использование
//   var(--x) в значении объявлением не считается, «.button--link» — тем более.
//
Функция ОбъявленныеПеременные(Знач ТекстCSS) Экспорт

	Результат = Новый Массив();
	Текст = БезКомментариев(ТекстCSS);
	Позиция = 1;

	Пока Истина Цикл

		Начало = СтрНайти(Текст, "--", НаправлениеПоиска.СНачала, Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		Позиция = Начало + 2;

		// «.button--link» — модификатор класса, а не переменная
		Если Начало > 1 И НЕ Разделитель(Сред(Текст, Начало - 1, 1)) Тогда
			Продолжить;
		КонецЕсли;

		Имя = ИмяПеременной(Текст, Начало);
		Если НЕ ЗначениеЗаполнено(Имя) Тогда
			Продолжить;
		КонецЕсли;

		// двоеточие после имени отличает объявление от var(--x) в значении
		Если Сред(Текст, ПропуститьПробельные(Текст, Начало + СтрДлина(Имя)), 1) <> ":" Тогда
			Продолжить;
		КонецЕсли;

		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Есть ли в листе цвет, записанный значением, а не токеном темы.
//
// Параметры:
//  ТекстCSS - Строка - таблица стилей.
//
// Возвращаемое значение:
//  Строка - первая найденная запись цвета либо "", если лист пользуется только var(--…).
//
Функция ЗаписьЦвета(Знач ТекстCSS) Экспорт

	Текст = БезЛитералов(БезКомментариев(ТекстCSS, " "));

	Решётка = СтрНайти(Текст, "#");
	Пока Решётка > 0 Цикл
		Хвост = ШестнадцатеричныйХвост(Текст, Решётка + 1);
		Если СтрДлина(Хвост) = 3 ИЛИ СтрДлина(Хвост) = 6 ИЛИ СтрДлина(Хвост) = 8 Тогда
			Возврат "#" + Хвост;
		КонецЕсли;
		Решётка = СтрНайти(Текст, "#", НаправлениеПоиска.СНачала, Решётка + 1);
	КонецЦикла;

	Для Каждого Функция_ Из ЦветовыеФункции() Цикл
		Если СтрНайти(Текст, Функция_) > 0 Тогда
			Возврат Функция_ + "…)";
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Правила листа: селектор, объявления и условия, под которыми правило вообще работает.
//
// Параметры:
//  ТекстCSS - Строка - таблица стилей.
//
// Возвращаемое значение:
//  Массив из Структура - Селектор (один; список «a, b» разбирается двумя правилами),
//   Условия (прелюдии вложенных @-блоков через пробел; "" — правило работает всегда)
//   и Объявления (Соответствие: свойство -> значение). Комментарии и содержимое строковых
//   литералов сняты, поэтому фигурная скобка внутри content: "…" разбор не ломает.
//
Функция Правила(Знач ТекстCSS) Экспорт

	Результат = Новый Массив();
	Текст = БезЛитералов(БезКомментариев(ТекстCSS, " "));
	Условия = Новый Массив();
	Прелюдия = "";
	Индекс = 1;

	Пока Индекс <= СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Индекс, 1);

		Если Символ = "{" И СтрНачинаетсяС(СокрЛП(Прелюдия), "@") Тогда
			// @media, @supports, @starting-style — внутри них лежат ПРАВИЛА, а не объявления
			Условия.Добавить(СокрЛП(Прелюдия));
			Прелюдия = "";
		ИначеЕсли Символ = "{" Тогда
			Конец = СтрНайти(Текст, "}", НаправлениеПоиска.СНачала, Индекс + 1);
			Конец = ?(Конец = 0, СтрДлина(Текст) + 1, Конец);
			ДобавитьПравила(Результат, Прелюдия, Сред(Текст, Индекс + 1, Конец - Индекс - 1),
				СтрСоединить(Условия, " "));
			Индекс = Конец;
			Прелюдия = "";
		ИначеЕсли Символ = "}" Тогда
			Если Условия.Количество() > 0 Тогда
				Условия.Удалить(Условия.ВГраница());
			КонецЕсли;
			Прелюдия = "";
		Иначе
			Прелюдия = Прелюдия + Символ;
		КонецЕсли;

		Индекс = Индекс + 1;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Селекторы правила касаются этого класса.
//
// Параметры:
//  Селектор - Строка - селектор правила.
//  Класс    - Строка - имя класса без точки.
//
// Возвращаемое значение:
//  Булево - Истина, если класс назван в селекторе целиком: «.tree__link--active»
//   класса «tree__link» не стилизует.
//
Функция СелекторКасаетсяКласса(Знач Селектор, Знач Класс) Экспорт

	Искомое = "." + Класс;
	Позиция = СтрНайти(Селектор, Искомое);

	Пока Позиция > 0 Цикл
		Если НЕ ПродолжениеИмени(Сред(Селектор, Позиция + СтрДлина(Искомое), 1)) Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = СтрНайти(Селектор, Искомое, НаправлениеПоиска.СНачала, Позиция + 1);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Правило стилизует САМ элемент этого класса, а не его потомка.
//
// Параметры:
//  Селектор - Строка - селектор правила.
//  Класс    - Строка - имя класса без точки.
//
// Возвращаемое значение:
//  Булево - Истина, если класс назван в ПОСЛЕДНЕЙ части селектора: у «.a .b» оформляется
//   «.b», и правилом класса «a» оно не является — предку от него не достаётся ничего.
//
Функция СелекторСтилизуетКласс(Знач Селектор, Знач Класс) Экспорт
	Возврат СелекторКасаетсяКласса(ПоследняяЧасть(Селектор), Класс);
КонецФункции

// Размер в пикселях из значения объявления.
//
// Параметры:
//  Значение - Строка, Неопределено - значение вида «44px».
//
// Возвращаемое значение:
//  Число - пиксели; -1, если значение задано не пикселями либо его нет вовсе.
//
Функция Пиксели(Знач Значение) Экспорт

	Текст = НРег(СокрЛП(?(Значение = Неопределено, "", Строка(Значение))));
	Если НЕ СтрЗаканчиваетсяНа(Текст, "px") Тогда
		Возврат -1;
	КонецЕсли;

	Попытка
		Возврат Число(Лев(Текст, СтрДлина(Текст) - 2));
	Исключение
		Возврат -1;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Список селекторов «a, b» — это два правила с одними и теми же объявлениями.
Процедура ДобавитьПравила(Знач Результат, Знач Прелюдия, Знач Тело, Знач Условия)

	Объявления = Объявления(Тело);

	Для Каждого Селектор Из СтрРазделить(Прелюдия, ",", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Селектор)) Тогда
			Результат.Добавить(Новый Структура("Селектор, Условия, Объявления",
				СокрЛП(Селектор), Условия, Объявления));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция Объявления(Знач Тело)

	Результат = Новый Соответствие();

	Для Каждого Объявление Из СтрРазделить(Тело, ";", Ложь) Цикл
		Двоеточие = СтрНайти(Объявление, ":");
		Если Двоеточие > 0 Тогда
			Результат.Вставить(НРег(СокрЛП(Лев(Объявление, Двоеточие - 1))),
				СокрЛП(Сред(Объявление, Двоеточие + 1)));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПродолжениеИмени(Знач Символ)
	Возврат ЗначениеЗаполнено(Символ) И НЕ Разделитель(Символ);
КонецФункции

// Что оформляет селектор: всё, что стоит после последнего комбинатора (пробел, >, +, ~).
Функция ПоследняяЧасть(Знач Селектор)

	Результат = СокрЛП(Селектор);

	Для Каждого Комбинатор Из Комбинаторы() Цикл
		Позиция = СтрНайти(Результат, Комбинатор, НаправлениеПоиска.СКонца);
		Если Позиция > 0 Тогда
			Результат = СокрЛП(Сред(Результат, Позиция + СтрДлина(Комбинатор)));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Комбинаторы()

	Результат = Новый Массив();
	Результат.Добавить(" ");
	Результат.Добавить(">");
	Результат.Добавить("+");
	Результат.Добавить("~");
	Возврат Результат;

КонецФункции

Функция ЦветовыеФункции()

	Результат = Новый Массив();
	Результат.Добавить("rgb(");
	Результат.Добавить("rgba(");
	Результат.Добавить("hsl(");
	Результат.Добавить("hsla(");
	Возврат Результат;

КонецФункции

Функция ШестнадцатеричныйХвост(Знач Текст, Знач Начало)

	Цифры = "0123456789abcdefABCDEF";
	Хвост = "";
	Индекс = Начало;

	Пока Индекс <= СтрДлина(Текст) И СтрНайти(Цифры, Сред(Текст, Индекс, 1)) > 0 Цикл
		Хвост = Хвост + Сред(Текст, Индекс, 1);
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Хвост;

КонецФункции

Функция ИмяПеременной(Знач Текст, Знач Начало)

	Если Сред(Текст, Начало, 2) <> "--" Тогда
		Возврат "";
	КонецЕсли;

	Имя = "--";
	Индекс = Начало + 2;
	Пока Индекс <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Разделитель(Символ) Тогда
			Прервать;
		КонецЕсли;
		Имя = Имя + Символ;
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат ?(Имя = "--", "", Имя);

КонецФункции

Функция ПропуститьПробельные(Знач Текст, Знач Начало)

	Индекс = Начало;
	Пока Индекс <= СтрДлина(Текст) И Пробельный(Сред(Текст, Индекс, 1)) Цикл
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Индекс;

КонецФункции

Функция Пробельный(Знач Символ)
	Возврат Символ = " " ИЛИ Символ = Символы.Таб ИЛИ Символ = Символы.ПС ИЛИ Символ = Символы.ВК;
КонецФункции

// Что угодно, кроме символов имени: дефис и подчёркивание в имя входят, буквы любого
// алфавита — тоже, поэтому перечислены именно РАЗДЕЛИТЕЛИ.
Функция Разделитель(Знач Символ)
	Возврат СтрНайти(" ,;:(){}[]<>'""/*+~=|!?.#%&@\" + Символы.Таб + Символы.ПС + Символы.ВК,
		Символ) > 0;
КонецФункции

Функция БезКомментариев(Знач Текст, Знач Замена = "")

	Результат = Текст;
	Пока Истина Цикл
		Начало = СтрНайти(Результат, "/*");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Конец = СтрНайти(Результат, "*/", НаправлениеПоиска.СНачала, Начало + 2);
		Если Конец = 0 Тогда
			Возврат Лев(Результат, Начало - 1);
		КонецЕсли;
		Результат = Лев(Результат, Начало - 1) + Замена + Сред(Результат, Конец + 2);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Содержимое строковых литералов вырезается: «content: "var(--x)"» переменной не использует,
// а сканер считал бы её живой и требовал объявления.
Функция БезЛитералов(Знач Текст)

	Результат = "";
	Кавычка = "";

	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если ЗначениеЗаполнено(Кавычка) Тогда
			Если Символ = Кавычка Тогда
				Кавычка = "";
				Результат = Результат + Символ;
			КонецЕсли;
		ИначеЕсли Символ = """" ИЛИ Символ = "'" Тогда
			Кавычка = Символ;
			Результат = Результат + Символ;
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
