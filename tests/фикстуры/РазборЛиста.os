// Фикстура: разбор таблицы стилей. Читает КОД, а не текст — комментарии и содержимое
// строковых литералов снимаются, поэтому имя из пояснения и имя из content: "…"
// использованием не считаются.

#Область ПубличныйИнтерфейс

// Имена CSS-переменных, которые лист ИСПОЛЬЗУЕТ через var(--…).
//
// Параметры:
//  ТекстCSS - Строка - таблица стилей либо блок объявлений.
//
// Возвращаемое значение:
//  Массив из Строка - имена вида «--color-bg», каждое по одному разу. Запасное значение
//   var(--x, значение) отбрасывается, вложенные var() учитываются.
//
Функция ИспользованныеПеременные(Знач ТекстCSS) Экспорт

	Результат = Новый Массив();
	// комментарий заменяется ПРОБЕЛОМ: склейка соседей («solid/*c*/var(--x)» → «solidvar(»)
	// теряла бы такое использование молча
	Текст = БезЛитералов(БезКомментариев(ТекстCSS, " "));
	Позиция = 1;

	Пока Истина Цикл

		Начало = СтрНайти(Текст, "var(", НаправлениеПоиска.СНачала, Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		Позиция = Начало + 4;

		// «--my-var(» — хвост чужого идентификатора, а не функция var()
		Если Начало > 1 И НЕ Разделитель(Сред(Текст, Начало - 1, 1)) Тогда
			Продолжить;
		КонецЕсли;

		Имя = ИмяПеременной(Текст, ПропуститьПробельные(Текст, Позиция));
		Если ЗначениеЗаполнено(Имя) И Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Имена CSS-переменных, которые текст ОБЪЯВЛЯЕТ («--имя: значение»).
//
// Параметры:
//  ТекстCSS - Строка - блок объявлений либо таблица стилей.
//
// Возвращаемое значение:
//  Массив из Строка - имена вида «--color-bg», каждое по одному разу. Использование
//   var(--x) в значении объявлением не считается, «.button--link» — тем более.
//
Функция ОбъявленныеПеременные(Знач ТекстCSS) Экспорт

	Результат = Новый Массив();
	Текст = БезКомментариев(ТекстCSS);
	Позиция = 1;

	Пока Истина Цикл

		Начало = СтрНайти(Текст, "--", НаправлениеПоиска.СНачала, Позиция);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;

		Позиция = Начало + 2;

		// «.button--link» — модификатор класса, а не переменная
		Если Начало > 1 И НЕ Разделитель(Сред(Текст, Начало - 1, 1)) Тогда
			Продолжить;
		КонецЕсли;

		Имя = ИмяПеременной(Текст, Начало);
		Если НЕ ЗначениеЗаполнено(Имя) Тогда
			Продолжить;
		КонецЕсли;

		// двоеточие после имени отличает объявление от var(--x) в значении
		Если Сред(Текст, ПропуститьПробельные(Текст, Начало + СтрДлина(Имя)), 1) <> ":" Тогда
			Продолжить;
		КонецЕсли;

		Если Результат.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Есть ли в листе цвет, записанный значением, а не токеном темы.
//
// Параметры:
//  ТекстCSS - Строка - таблица стилей.
//
// Возвращаемое значение:
//  Строка - первая найденная запись цвета либо "", если лист пользуется только var(--…).
//
Функция ЗаписьЦвета(Знач ТекстCSS) Экспорт

	Текст = БезЛитералов(БезКомментариев(ТекстCSS, " "));

	Решётка = СтрНайти(Текст, "#");
	Пока Решётка > 0 Цикл
		Хвост = ШестнадцатеричныйХвост(Текст, Решётка + 1);
		Если СтрДлина(Хвост) = 3 ИЛИ СтрДлина(Хвост) = 6 ИЛИ СтрДлина(Хвост) = 8 Тогда
			Возврат "#" + Хвост;
		КонецЕсли;
		Решётка = СтрНайти(Текст, "#", НаправлениеПоиска.СНачала, Решётка + 1);
	КонецЦикла;

	Для Каждого Функция_ Из ЦветовыеФункции() Цикл
		Если СтрНайти(Текст, Функция_) > 0 Тогда
			Возврат Функция_ + "…)";
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Правила листа: селектор, объявления и условия, под которыми правило вообще работает.
//
// Параметры:
//  ТекстCSS - Строка - таблица стилей.
//
// Возвращаемое значение:
//  Массив из Структура - Селектор (один; список «a, b» разбирается двумя правилами),
//   Условия (прелюдии вложенных @-блоков через пробел; "" — правило работает всегда),
//   Прелюдии (те же прелюдии списком, от внешней к внутренней) и Объявления
//   (Соответствие: свойство -> значение). Комментарии и содержимое строковых
//   литералов сняты, поэтому фигурная скобка внутри content: "…" разбор не ломает.
//
Функция Правила(Знач ТекстCSS) Экспорт

	Результат = Новый Массив();
	Текст = БезЛитералов(БезКомментариев(ТекстCSS, " "));
	Условия = Новый Массив();
	Прелюдия = "";
	Индекс = 1;

	Пока Индекс <= СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Индекс, 1);

		Если Символ = "{" И СтрНачинаетсяС(СокрЛП(Прелюдия), "@") Тогда
			// @media, @supports, @starting-style — внутри них лежат ПРАВИЛА, а не объявления
			Условия.Добавить(СокрЛП(Прелюдия));
			Прелюдия = "";
		ИначеЕсли Символ = "{" Тогда
			Конец = СтрНайти(Текст, "}", НаправлениеПоиска.СНачала, Индекс + 1);
			Конец = ?(Конец = 0, СтрДлина(Текст) + 1, Конец);
			ДобавитьПравила(Результат, Прелюдия, Сред(Текст, Индекс + 1, Конец - Индекс - 1),
				Условия);
			Индекс = Конец;
			Прелюдия = "";
		ИначеЕсли Символ = "}" Тогда
			Если Условия.Количество() > 0 Тогда
				Условия.Удалить(Условия.ВГраница());
			КонецЕсли;
			Прелюдия = "";
		Иначе
			Прелюдия = Прелюдия + Символ;
		КонецЕсли;

		Индекс = Индекс + 1;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Селекторы правила касаются этого класса.
//
// Параметры:
//  Селектор - Строка - селектор правила.
//  Класс    - Строка - имя класса без точки.
//
// Возвращаемое значение:
//  Булево - Истина, если класс назван в селекторе целиком: «.tree__link--active»
//   класса «tree__link» не стилизует.
//
Функция СелекторКасаетсяКласса(Знач Селектор, Знач Класс) Экспорт

	Искомое = "." + Класс;
	Позиция = СтрНайти(Селектор, Искомое);

	Пока Позиция > 0 Цикл
		Если НЕ ПродолжениеИмени(Сред(Селектор, Позиция + СтрДлина(Искомое), 1)) Тогда
			Возврат Истина;
		КонецЕсли;
		Позиция = СтрНайти(Селектор, Искомое, НаправлениеПоиска.СНачала, Позиция + 1);
	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Правило стилизует САМ элемент этого класса, а не его потомка.
//
// Параметры:
//  Селектор - Строка - селектор правила.
//  Класс    - Строка - имя класса без точки.
//
// Возвращаемое значение:
//  Булево - Истина, если класс назван в ПОСЛЕДНЕЙ части селектора: у «.a .b» оформляется
//   «.b», и правилом класса «a» оно не является — предку от него не достаётся ничего.
//
Функция СелекторСтилизуетКласс(Знач Селектор, Знач Класс) Экспорт
	Возврат СелекторКасаетсяКласса(ПоследняяЧасть(Селектор), Класс);
КонецФункции

// Правило работает только там, где движок знает ВЕРХНИЙ СЛОЙ.
//
// Параметры:
//  Условия - Строка - условия правила (см. Правила).
//
// Возвращаемое значение:
//  Булево - сверяется САМА проверка «умеешь ли ты :popover-open», а не слово «@supports»:
//   под чужим условием (скажем, про сетку) правило доедет и до движка без верхнего слоя.
//
Функция ТребуетВерхнегоСлоя(Знач Условия) Экспорт
	Возврат СтрНайти(Условия, ":popover-open") > 0;
КонецФункции

// Правило работает на экране телефона.
//
// Параметры:
//  Условия - Строка - условия правила (см. Правила).
//  Граница - Число - (необязательный, по умолчанию 900) до какой ширины экран считается
//            узким; это брейкпоинт самого листа.
//
// Возвращаемое значение:
//  Булево - Истина, если условие ограничивает ширину и его граница не шире заданной.
//
Функция УзкийЭкран(Знач Условия, Знач Граница = 900) Экспорт

	Позиция = СтрНайти(Условия, "max-width");
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Хвост = Сред(Условия, Позиция + СтрДлина("max-width"));
	Хвост = Сред(Хвост, СтрНайти(Хвост, ":") + 1);
	Найденная = Пиксели(СокрЛП(Лев(Хвост, СтрНайти(Хвост, ")") - 1)));

	Возврат Найденная > 0 И Найденная <= Граница;

КонецФункции

// Классы, у которых НЕТ базового правила — то есть правила вне всяких условий, где класс
// и есть оформляемый элемент. Такого класса для сканеров потребителя не существует.
//
// Параметры:
//  Классы  - Массив из Строка - имена классов без точки.
//  Правила - Массив - правила листа (см. Правила).
//
// Возвращаемое значение:
//  Массив из Строка - классы, оставшиеся без базового правила.
//
Функция КлассыБезБазовогоПравила(Знач Классы, Знач Правила) Экспорт

	Результат = Новый Массив();

	Для Каждого Класс Из Классы Цикл
		Найдено = Ложь;
		Для Каждого Правило Из Правила Цикл
			Если Правило.Условия = "" И СелекторСтилизуетКласс(Правило.Селектор, Класс) Тогда
				Найдено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Найдено Тогда
			Результат.Добавить(Класс);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Размер в пикселях из значения объявления.
//
// Параметры:
//  Значение - Строка, Неопределено - значение вида «44px».
//
// Возвращаемое значение:
//  Число - пиксели; -1, если значение задано не пикселями либо его нет вовсе. Голый нуль
//   единицы не требует — это тот же нуль пикселей, так его и читает браузер.
//
Функция Пиксели(Знач Значение) Экспорт

	Текст = НРег(СокрЛП(?(Значение = Неопределено, "", Строка(Значение))));
	Если Текст = "0" Тогда
		Возврат 0;
	КонецЕсли;

	Если НЕ СтрЗаканчиваетсяНа(Текст, "px") Тогда
		Возврат -1;
	КонецЕсли;

	Попытка
		Возврат Число(Лев(Текст, СтрДлина(Текст) - 2));
	Исключение
		Возврат -1;
	КонецПопытки;

КонецФункции

// Текст базового листа кита — того, что печатает КаркасСтраницы первым тегом <link>.
//
// Возвращаемое значение:
//  Строка - содержимое файла; "" — файл пуст.
//
Функция ТекстБазовогоЛиста() Экспорт

	Раскладка = Новый РаскладкаСтатики(Новый СтатикаИнсталляцииПоУмолчанию());
	Чтение = Новый ЧтениеТекста(Раскладка.ПолныйПуть(Раскладка.ФайлБазовогоЛиста()),
		КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

// Правила базового листа, чьи селекторы касаются класса, — в порядке листа.
//
// Параметры:
//  Класс - Строка - имя класса без точки.
//
// Возвращаемое значение:
//  Массив - правила (см. Правила).
//
Функция ПравилаКласса(Знач Класс) Экспорт

	Результат = Новый Массив();
	Для Каждого Правило Из Правила(ТекстБазовогоЛиста()) Цикл
		Если СелекторКасаетсяКласса(Правило.Селектор, Класс) Тогда
			Результат.Добавить(Правило);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Правило оформляет сам элемент класса, а не его псевдоэлемент и не то, что внутри.
//
// Параметры:
//  Селектор - Строка - селектор правила.
//  Класс    - Строка - имя класса без точки.
//
// Возвращаемое значение:
//  Булево
//
Функция СтилизуетСамЭлемент(Знач Селектор, Знач Класс) Экспорт
	Возврат СелекторСтилизуетКласс(Селектор, Класс) И СтрНайти(Селектор, "::") = 0;
КонецФункции

// Сторона из сокращённой записи inset.
//
// Параметры:
//  Значение - Строка - значение inset: одно, два, три или четыре слова.
//  Сторона  - Число  - 1 — верх, 2 — право, 3 — низ, 4 — лево.
//
// Возвращаемое значение:
//  Строка - значение этой стороны строчными.
//
Функция СторонаИзInset(Знач Значение, Знач Сторона) Экспорт

	Части = СтрРазделить(СокрЛП(НРег(Значение)), " ", Ложь);
	Если Части.Количество() = 1 Тогда
		Возврат Части[0];
	ИначеЕсли Части.Количество() = 2 Тогда
		Возврат ?(Сторона = 1 ИЛИ Сторона = 3, Части[0], Части[1]);
	ИначеЕсли Части.Количество() = 3 Тогда
		Возврат ?(Сторона = 1, Части[0], ?(Сторона = 3, Части[2], Части[1]));
	КонецЕсли;

	Возврат Части[Сторона - 1];

КонецФункции

// Высота кнопки на ПАЛЬЦЕВОЙ поверхности: последнее слово каскада о min-height из правил,
// которые на телефоне действуют (безусловных и узких) и оформляют саму кнопку, а не её
// наведение. Правила широкого экрана пропускаются: там мышь.
//
// Параметры:
//  Правила - Массив - правила-кандидаты (см. Правила), уже отобранные по месту кнопки.
//
// Возвращаемое значение:
//  Число - пиксели; -1 — высота не объявлена. Ноль — значение, как остальные:
//   min-height: 0 в узком блоке критерий не выполняет.
//
Функция ПальцеваяВысота(Знач Правила) Экспорт

	Результат = -1;

	Для Каждого Правило Из Правила Цикл

		Если НЕ СелекторСтилизуетКласс(Правило.Селектор, "button")
			ИЛИ СтрНайти(Правило.Селектор, ":hover") > 0
			ИЛИ (Правило.Условия <> "" И НЕ УзкийЭкран(Правило.Условия)) Тогда
			Продолжить;
		КонецЕсли;

		Значение = Пиксели(Правило.Объявления.Получить("min-height"));
		Если Значение >= 0 Тогда
			Результат = Значение;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Условие одной прелюдии @supports: проверка ОДНОГО объявления или селектора, возможно
// под отрицанием. Составные условия (and, or) простыми не считаются.
//
// Параметры:
//  Прелюдия - Строка - прелюдия @-блока целиком, например «@supports not (top: anchor(bottom))».
//
// Возвращаемое значение:
//  Структура, Неопределено - Отрицание (Булево), Вид («объявление» | «селектор»),
//   Свойство (у объявления), Значение (значение объявления либо проверяемый селектор);
//   Неопределено — это не @supports или условие составное.
//
Функция УсловиеПоддержки(Знач Прелюдия) Экспорт

	Текст = СокрЛП(Прелюдия);
	Если НЕ СтрНачинаетсяС(НРег(Текст), "@supports") Тогда
		Возврат Неопределено;
	КонецЕсли;

	Текст = СокрЛП(Сред(Текст, СтрДлина("@supports") + 1));
	Отрицание = СтрНачинаетсяС(НРег(Текст), "not ") ИЛИ СтрНачинаетсяС(НРег(Текст), "not(");
	Если Отрицание Тогда
		Текст = СокрЛП(Сред(Текст, 4));
	КонецЕсли;

	Вид = "объявление";
	Если СтрНачинаетсяС(НРег(Текст), "selector(") Тогда
		Вид = "селектор";
		Текст = Сред(Текст, СтрДлина("selector") + 1);
	КонецЕсли;

	Внутри = ВнутриСкобок(Текст);
	Если Внутри = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура("Отрицание, Вид, Свойство, Значение", Отрицание, Вид, "", "");
	Если Вид = "селектор" Тогда
		Результат.Значение = СокрЛП(Внутри);
		Возврат Результат;
	КонецЕсли;

	Двоеточие = СтрНайти(Внутри, ":");
	Если Двоеточие = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат.Свойство = НРег(СокрЛП(Лев(Внутри, Двоеточие - 1)));
	Результат.Значение = СокрЛП(Сред(Внутри, Двоеточие + 1));
	Возврат Результат;

КонецФункции

// Правило действует только там, где движок НЕ понимает значения с этой функцией: одна
// из его прелюдий — @supports not (свойство: …функция(…)…).
//
// Параметры:
//  Правило  - Структура - правило (см. Правила).
//  ИмяФункции - Строка  - имя CSS-функции без скобки, например «anchor».
//
// Возвращаемое значение:
//  Булево
//
Функция ТолькоБезПоддержки(Знач Правило, Знач ИмяФункции) Экспорт

	Для Каждого Прелюдия Из Правило.Прелюдии Цикл
		Условие = УсловиеПоддержки(Прелюдия);
		Если Условие <> Неопределено И Условие.Отрицание И Условие.Вид = "объявление"
			И СтрНайти(НРег(Условие.Значение), НРег(ИмяФункции) + "(") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Правило действует на экране этой ширины: каждое ограничение ширины в его @media
// выполнено. Правило без ограничений ширины действует на любой.
//
// Параметры:
//  Условия - Строка - условия правила (см. Правила).
//  Ширина  - Число  - ширина окна в пикселях.
//
// Возвращаемое значение:
//  Булево
//
Функция ДействуетНаШирине(Знач Условия, Знач Ширина) Экспорт

	Для Каждого Граница Из СтрРазделить("max-width,min-width", ",") Цикл

		Позиция = СтрНайти(Условия, Граница);
		Пока Позиция > 0 Цикл
			Хвост = Сред(Условия, Позиция + СтрДлина(Граница));
			Хвост = Сред(Хвост, СтрНайти(Хвост, ":") + 1);
			Значение = Пиксели(СокрЛП(Лев(Хвост, СтрНайти(Хвост, ")") - 1)));
			Если Значение >= 0 И (Граница = "max-width" И Ширина > Значение
				ИЛИ Граница = "min-width" И Ширина < Значение) Тогда
				Возврат Ложь;
			КонецЕсли;
			Позиция = СтрНайти(Условия, Граница, НаправлениеПоиска.СНачала, Позиция + 1);
		КонецЦикла;

	КонецЦикла;

	Возврат Истина;

КонецФункции

// Специфичность селектора, как её считает браузер: идентификаторы, затем классы,
// атрибуты и псевдоклассы, затем элементы и псевдоэлементы. :is(), :not() и :has()
// весят как самый тяжёлый аргумент, :where() — ноль.
//
// Параметры:
//  Селектор - Строка - ОДИН селектор (не список).
//
// Возвращаемое значение:
//  Число - идентификаторы × 1000000 + классы × 1000 + элементы; сравнивается как число.
//
Функция Специфичность(Знач Селектор) Экспорт

	Текст = СокрЛП(Селектор);
	Результат = 0;
	Индекс = 1;

	Пока Индекс <= СтрДлина(Текст) Цикл

		Символ = Сред(Текст, Индекс, 1);

		Если Символ = "#" Тогда
			Результат = Результат + 1000000;
			Индекс = КонецИмени(Текст, Индекс + 1);
		ИначеЕсли Символ = "." Тогда
			Результат = Результат + 1000;
			Индекс = КонецИмени(Текст, Индекс + 1);
		ИначеЕсли Символ = "[" Тогда
			Результат = Результат + 1000;
			Индекс = СтрНайти(Текст, "]", НаправлениеПоиска.СНачала, Индекс) + 1;
		ИначеЕсли Сред(Текст, Индекс, 2) = "::" Тогда
			Результат = Результат + 1;
			Индекс = ПослеСкобок(Текст, КонецИмени(Текст, Индекс + 2));
		ИначеЕсли Символ = ":" Тогда
			Конец = КонецИмени(Текст, Индекс + 1);
			Имя = НРег(Сред(Текст, Индекс + 1, Конец - Индекс - 1));
			Если Имя = "is" ИЛИ Имя = "not" ИЛИ Имя = "has" Тогда
				Результат = Результат + ТяжелейшийАргумент(ВнутриСкобок(Сред(Текст, Конец)));
			ИначеЕсли Имя <> "where" Тогда
				Результат = Результат + 1000;
			КонецЕсли;
			Индекс = ПослеСкобок(Текст, Конец);
		ИначеЕсли ПродолжениеИмени(Символ) И Символ <> "*" Тогда
			Результат = Результат + 1;
			Индекс = КонецИмени(Текст, Индекс);
		Иначе
			Индекс = Индекс + 1;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

// Узел цепочки элементов для подбора селекторов: тег и классы одного элемента страницы.
//
// Параметры:
//  Тег    - Строка - имя тега строчными, например «td».
//  Классы - Строка - классы через запятую, например «table,table-cards»; "" — классов нет.
//
// Возвращаемое значение:
//  Структура - Тег, Классы (Массив из Строка).
//
Функция Узел(Знач Тег, Знач Классы = "") Экспорт
	Возврат Новый Структура("Тег, Классы", НРег(Тег), СтрРазделить(Классы, ",", Ложь));
КонецФункции

// Селектор подходит последнему элементу цепочки. Цепочка описывает элементы в покое:
// псевдокласс состояния (:hover, :focus, :popover-open…) и псевдоэлемент (::before…)
// к ним не подходят наверняка. Понимаются комбинаторы «пробел» и «>» (порознь), тег,
// классы, :not(.класс) и «*»; «>» и пробел — и порознь, и вперемешку: смесь сопоставляется
// с откатом, поэтому «.a > .b .c» находит .b у прямого родителя .a, а не у первого
// попавшегося. Селектор, который разбор оценить не может (структурный псевдокласс, :is(),
// :where(), атрибут, :not() не от одного класса, «+» и «~»), — исключение, если по понятой
// части он элементу подходит: ответ «не подходит» в этом случае был бы ложной защитой.
//
// Параметры:
//  Селектор - Строка - ОДИН селектор (не список).
//  Цепочка  - Массив из Структура - узлы (см. Узел) от внешнего к самому элементу.
//
// Возвращаемое значение:
//  Булево
//
Функция ПодходитЦепочке(Знач Селектор, Знач Цепочка) Экспорт

	Части = СтрРазделить(СтрЗаменить(СокрЛП(Селектор), ">", " > "), " ", Ложь);
	Позиция = Цепочка.ВГраница();

	Оценка = ОценкаСоставного(Части[Части.ВГраница()], Цепочка[Позиция]);
	Если Оценка = "нет" Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Оценка = "неясно"
		ИЛИ Части.Найти("+") <> Неопределено ИЛИ Части.Найти("~") <> Неопределено Тогда
		ОтказатьсяОценивать(Селектор);
	КонецЕсли;

	Возврат ПодходятПредки(Селектор, Части, Части.ВГраница(), Цепочка, Позиция);

КонецФункции

// Составное Части[Номер] уже подошло узлу Цепочка[Позиция]; подходят ли ему левые части.
// Потомок перебирает всех предков по очереди и откатывается, если дальше не сошлось:
// жадный выбор ближайшего предка ошибался бы на смеси «>» и пробела.
Функция ПодходятПредки(Знач Селектор, Знач Части, Знач Номер, Знач Цепочка, Знач Позиция)

	Если Номер = 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Прямой = (Части[Номер - 1] = ">");
	Левый = ?(Прямой, Номер - 2, Номер - 1);

	Кандидат = Позиция - 1;
	Пока Кандидат >= 0 Цикл

		Оценка = ОценкаСоставного(Части[Левый], Цепочка[Кандидат]);
		Если Оценка = "неясно" Тогда
			ОтказатьсяОценивать(Селектор);
		ИначеЕсли Оценка = "да" И ПодходятПредки(Селектор, Части, Левый, Цепочка, Кандидат) Тогда
			Возврат Истина;
		КонецЕсли;

		Если Прямой Тогда
			Прервать;
		КонецЕсли;
		Кандидат = Кандидат - 1;

	КонецЦикла;

	Возврат Ложь;

КонецФункции

// Последнее слово каскада листа о последнем элементе цепочки на экране этой ширины:
// подходящие правила по специфичности, при равной — по порядку в листе. Считаются только
// правила, объявляющие спрошенные свойства; правило под @supports not и стартовый кадр
// (@starting-style) не считаются — лист читается глазами движка, который понимает всё.
//
// Параметры:
//  Цепочка  - Массив из Структура - узлы (см. Узел) от внешнего к самому элементу.
//  Ширина   - Число  - ширина окна в пикселях.
//  Свойства - Строка - свойства через запятую, например «width,white-space».
//  Лист     - Строка - (необязательный) текст листа; по умолчанию базовый лист кита.
//
// Возвращаемое значение:
//  Соответствие - свойство -> значение строчными; необъявленного свойства в нём нет.
//
Функция Каскад(Знач Цепочка, Знач Ширина, Знач Свойства, Знач Лист = Неопределено) Экспорт

	Нужные = СтрРазделить(СтрЗаменить(Свойства, " ", ""), ",", Ложь);
	Подходящие = Новый Массив();

	Для Каждого Правило Из Правила(?(Лист = Неопределено, ТекстБазовогоЛиста(), Лист)) Цикл

		Если НЕ ОбъявляетЛюбое(Правило, Нужные)
			ИЛИ ПодОтрицаниемИлиСтартом(Правило)
			ИЛИ НЕ ДействуетНаШирине(Правило.Условия, Ширина)
			ИЛИ НЕ ПодходитЦепочке(Правило.Селектор, Цепочка) Тогда
			Продолжить;
		КонецЕсли;

		// устойчивая вставка: равные по весу остаются в порядке листа
		Вес = Специфичность(Правило.Селектор);
		Место = Подходящие.Количество();
		Пока Место > 0 И Специфичность(Подходящие[Место - 1].Селектор) > Вес Цикл
			Место = Место - 1;
		КонецЦикла;
		Подходящие.Вставить(Место, Правило);

	КонецЦикла;

	Итог = Новый Соответствие();
	Для Каждого Правило Из Подходящие Цикл
		Для Каждого Свойство Из Нужные Цикл
			Значение = Правило.Объявления.Получить(Свойство);
			Если Значение <> Неопределено Тогда
				Итог.Вставить(Свойство, НРег(СокрЛП(Значение)));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Итог;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Список селекторов «a, b» — это два правила с одними и теми же объявлениями.
Процедура ДобавитьПравила(Знач Результат, Знач Прелюдия, Знач Тело, Знач Условия)

	Объявления = Объявления(Тело);
	Прелюдии = Новый Массив();
	Для Каждого Условие Из Условия Цикл
		Прелюдии.Добавить(Условие);
	КонецЦикла;

	Для Каждого Селектор Из СтрРазделить(Прелюдия, ",", Ложь) Цикл
		Если ЗначениеЗаполнено(СокрЛП(Селектор)) Тогда
			Результат.Добавить(Новый Структура("Селектор, Условия, Прелюдии, Объявления",
				СокрЛП(Селектор), СтрСоединить(Прелюдии, " "), Прелюдии, Объявления));
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция Объявления(Знач Тело)

	Результат = Новый Соответствие();

	Для Каждого Объявление Из СтрРазделить(Тело, ";", Ложь) Цикл
		Двоеточие = СтрНайти(Объявление, ":");
		Если Двоеточие > 0 Тогда
			Результат.Вставить(НРег(СокрЛП(Лев(Объявление, Двоеточие - 1))),
				СокрЛП(Сред(Объявление, Двоеточие + 1)));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Оценка составного селектора (без комбинаторов) на узле цепочки: «да», «нет» — наверняка,
// «неясно» — понятая часть подходит, а остальное разбор оценить не может.
Функция ОценкаСоставного(Знач Составной, Знач Узел)

	Если Составной = "*" Тогда
		Возврат "да";
	КонецЕсли;
	Если СтрНайти(Составной, "::") > 0 Тогда
		Возврат "нет";
	КонецЕсли;

	Тег = НРег(Лев(Составной, КонецИмени(Составной, 1) - 1));
	Если ЗначениеЗаполнено(Тег) И Тег <> Узел.Тег Тогда
		Возврат "нет";
	КонецЕсли;

	Остаток = Сред(Составной, СтрДлина(Тег) + 1);
	Неясно = Ложь;

	Пока Остаток <> "" Цикл

		Если СтрНачинаетсяС(Остаток, ".") Тогда
			Конец = КонецИмени(Остаток, 2);
			Если Узел.Классы.Найти(Сред(Остаток, 2, Конец - 2)) = Неопределено Тогда
				Возврат "нет";
			КонецЕсли;
			Остаток = Сред(Остаток, Конец);
		ИначеЕсли СтрНачинаетсяС(Остаток, ":") Тогда
			Конец = КонецИмени(Остаток, 2);
			Имя = НРег(Сред(Остаток, 2, Конец - 2));
			Внутри = ?(Сред(Остаток, Конец, 1) = "(", ВнутриСкобок(Сред(Остаток, Конец)), Неопределено);
			Если Имя = "not" И ОдинКласс(Внутри) Тогда
				Если Узел.Классы.Найти(Сред(Внутри, 2)) <> Неопределено Тогда
					Возврат "нет";
				КонецЕсли;
			ИначеЕсли СостоянияЭлемента().Найти(Имя) <> Неопределено Тогда
				Возврат "нет";
			Иначе
				Неясно = Истина;
			КонецЕсли;
			Остаток = Сред(Остаток, ПослеСкобок(Остаток, Конец));
		ИначеЕсли СтрНачинаетсяС(Остаток, "[") Тогда
			Неясно = Истина;
			Остаток = Сред(Остаток, СтрНайти(Остаток, "]") + 1);
		Иначе
			Возврат "неясно";
		КонецЕсли;

	КонецЦикла;

	Возврат ?(Неясно, "неясно", "да");

КонецФункции

// Псевдоклассы состояния: цепочка описывает элементы в покое, и такие правила к ней
// не подходят наверняка.
Функция СостоянияЭлемента()
	Возврат СтрРазделить("hover,focus,focus-visible,focus-within,active,visited,checked,"
		+ "disabled,popover-open,open,target,placeholder-shown,invalid,valid,user-invalid,"
		+ "indeterminate,modal", ",");
КонецФункции

// Аргумент :not() — ровно один класс.
Функция ОдинКласс(Знач Аргумент)

	Если Аргумент = Неопределено ИЛИ НЕ СтрНачинаетсяС(Аргумент, ".") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат КонецИмени(Аргумент, 2) = СтрДлина(Аргумент) + 1;

КонецФункции

Процедура ОтказатьсяОценивать(Знач Селектор)

	ВызватьИсключение СтрШаблон("Разбор листа: селектор «%1» к элементу, по понятой части,"
		+ " подходит, а целиком разбор его оценить не может. Ответить «не подходит» значило бы"
		+ " выронить правило из каскада молча — расширьте разбор, а не ослабляйте сторожа.",
		Селектор);

КонецПроцедуры

Функция ОбъявляетЛюбое(Знач Правило, Знач Свойства)

	Для Каждого Свойство Из Свойства Цикл
		Если Правило.Объявления.Получить(Свойство) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ПодОтрицаниемИлиСтартом(Знач Правило)

	Для Каждого Прелюдия Из Правило.Прелюдии Цикл
		Условие = УсловиеПоддержки(Прелюдия);
		Если СтрНачинаетсяС(НРег(Прелюдия), "@starting-style")
			ИЛИ (Условие <> Неопределено И Условие.Отрицание) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Содержимое первых скобок текста (с учётом вложенных); Неопределено — скобок нет.
Функция ВнутриСкобок(Знач Текст)

	Начало = СтрНайти(Текст, "(");
	Если Начало = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Глубина = 0;
	Для Индекс = Начало По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Сред(Текст, Начало + 1, Индекс - Начало - 1);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;

КонецФункции

// Позиция сразу за скобками, открытыми в этой позиции; нет скобок — сама позиция.
Функция ПослеСкобок(Знач Текст, Знач Позиция)

	Если Сред(Текст, Позиция, 1) <> "(" Тогда
		Возврат Позиция;
	КонецЕсли;
	Возврат Позиция + СтрДлина(ВнутриСкобок(Сред(Текст, Позиция))) + 2;

КонецФункции

// Позиция первого символа за именем, начатым в этой позиции.
Функция КонецИмени(Знач Текст, Знач Позиция)

	Индекс = Позиция;
	Пока Индекс <= СтрДлина(Текст) И ПродолжениеИмени(Сред(Текст, Индекс, 1)) Цикл
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Индекс;

КонецФункции

// Самый тяжёлый селектор из списка аргументов — делится запятыми верхнего уровня.
Функция ТяжелейшийАргумент(Знач Список)

	Если Список = Неопределено Тогда
		Возврат 0;
	КонецЕсли;

	Результат = 0;
	Глубина = 0;
	Начало = 1;
	Для Индекс = 1 По СтрДлина(Список) + 1 Цикл
		Символ = ?(Индекс > СтрДлина(Список), ",", Сред(Список, Индекс, 1));
		Если Символ = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" Тогда
			Глубина = Глубина - 1;
		ИначеЕсли Символ = "," И Глубина = 0 Тогда
			Результат = Макс(Результат, Специфичность(Сред(Список, Начало, Индекс - Начало)));
			Начало = Индекс + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПродолжениеИмени(Знач Символ)
	Возврат ЗначениеЗаполнено(Символ) И НЕ Разделитель(Символ);
КонецФункции

// Что оформляет селектор: всё, что стоит после последнего комбинатора (пробел, >, +, ~).
Функция ПоследняяЧасть(Знач Селектор)

	Результат = СокрЛП(Селектор);

	Для Каждого Комбинатор Из Комбинаторы() Цикл
		Позиция = СтрНайти(Результат, Комбинатор, НаправлениеПоиска.СКонца);
		Если Позиция > 0 Тогда
			Результат = СокрЛП(Сред(Результат, Позиция + СтрДлина(Комбинатор)));
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция Комбинаторы()

	Результат = Новый Массив();
	Результат.Добавить(" ");
	Результат.Добавить(">");
	Результат.Добавить("+");
	Результат.Добавить("~");
	Возврат Результат;

КонецФункции

Функция ЦветовыеФункции()

	Результат = Новый Массив();
	Результат.Добавить("rgb(");
	Результат.Добавить("rgba(");
	Результат.Добавить("hsl(");
	Результат.Добавить("hsla(");
	Возврат Результат;

КонецФункции

Функция ШестнадцатеричныйХвост(Знач Текст, Знач Начало)

	Цифры = "0123456789abcdefABCDEF";
	Хвост = "";
	Индекс = Начало;

	Пока Индекс <= СтрДлина(Текст) И СтрНайти(Цифры, Сред(Текст, Индекс, 1)) > 0 Цикл
		Хвост = Хвост + Сред(Текст, Индекс, 1);
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Хвост;

КонецФункции

Функция ИмяПеременной(Знач Текст, Знач Начало)

	Если Сред(Текст, Начало, 2) <> "--" Тогда
		Возврат "";
	КонецЕсли;

	Имя = "--";
	Индекс = Начало + 2;
	Пока Индекс <= СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если Разделитель(Символ) Тогда
			Прервать;
		КонецЕсли;
		Имя = Имя + Символ;
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат ?(Имя = "--", "", Имя);

КонецФункции

Функция ПропуститьПробельные(Знач Текст, Знач Начало)

	Индекс = Начало;
	Пока Индекс <= СтрДлина(Текст) И Пробельный(Сред(Текст, Индекс, 1)) Цикл
		Индекс = Индекс + 1;
	КонецЦикла;

	Возврат Индекс;

КонецФункции

Функция Пробельный(Знач Символ)
	Возврат Символ = " " ИЛИ Символ = Символы.Таб ИЛИ Символ = Символы.ПС ИЛИ Символ = Символы.ВК;
КонецФункции

// Что угодно, кроме символов имени: дефис и подчёркивание в имя входят, буквы любого
// алфавита — тоже, поэтому перечислены именно РАЗДЕЛИТЕЛИ.
Функция Разделитель(Знач Символ)
	Возврат СтрНайти(" ,;:(){}[]<>'""/*+~=|!?.#%&@\" + Символы.Таб + Символы.ПС + Символы.ВК,
		Символ) > 0;
КонецФункции

Функция БезКомментариев(Знач Текст, Знач Замена = "")

	Результат = Текст;
	Пока Истина Цикл
		Начало = СтрНайти(Результат, "/*");
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Конец = СтрНайти(Результат, "*/", НаправлениеПоиска.СНачала, Начало + 2);
		Если Конец = 0 Тогда
			Возврат Лев(Результат, Начало - 1);
		КонецЕсли;
		Результат = Лев(Результат, Начало - 1) + Замена + Сред(Результат, Конец + 2);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Содержимое строковых литералов вырезается: «content: "var(--x)"» переменной не использует,
// а сканер считал бы её живой и требовал объявления.
Функция БезЛитералов(Знач Текст)

	Результат = "";
	Кавычка = "";

	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Индекс, 1);
		Если ЗначениеЗаполнено(Кавычка) Тогда
			Если Символ = Кавычка Тогда
				Кавычка = "";
				Результат = Результат + Символ;
			КонецЕсли;
		ИначеЕсли Символ = """" ИЛИ Символ = "'" Тогда
			Кавычка = Символ;
			Результат = Результат + Символ;
		Иначе
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти
