// Фикстура: сборка слоя элементов экрана — кит, разметка узлов и набор компонентов.
// Граф собирается руками, потому что в тестах контейнера ОСени нет.

// Собирает кит и всё, на что он опирается.
//
// Параметры:
//  Обрамление - ОбрамлениеПробы, Неопределено - (необязательный) чем обрамляется страница;
//               Неопределено — обрамление кита по умолчанию, то есть пустое.
//
// Возвращаемое значение:
//  Структура - Кит, Разметка, Набор, Экран, Формы, Настройки, Каркас, Обрамление,
//              Место, Активы.
//
Функция Собрать(Знач Обрамление = Неопределено) Экспорт

	Экран = Новый ЭкранированиеHTML();
	Модели = Новый ЧтениеМодели();
	Место = Новый РаскладкаСтатики(Новый СтатикаИнсталляцииПоУмолчанию());
	Значки = Новый Иконка(Экран, Новый НаборИконок(Место, Новый ЧтениеГлифа()), Модели);
	Тексты = Новый ТекстыИнтерфейса(Словарь(Обрамление));

	Набор = НаборКомпонентов(Экран, Модели, Значки);
	Разметка = Новый РазметкаЭлементов(Экран);
	Настройки = Новый РендерерНастроек(Экран, Модели, Набор, Тексты);

	Активы = Новый АктивыСтатики(Место, Новый ОтпечаткиСтатики(Место));

	Результат = Новый Структура();
	Результат.Вставить("Экран", Экран);
	Результат.Вставить("Набор", Набор);
	Результат.Вставить("Разметка", Разметка);
	Результат.Вставить("Место", Место);
	Результат.Вставить("Активы", Активы);
	Результат.Вставить("Настройки", Настройки);
	Результат.Вставить("Кит", Новый Кит(Разметка, Набор, Настройки));
	Результат.Вставить("Формы", Новый Формы(Модели, Новый ПроверкаПоля(Тексты),
		Новый ЗначенияФормы(), Новый ПечатьФормы(Экран, Набор, Модели, Разметка), Настройки));

	Рамка = ?(Обрамление = Неопределено, Новый ОбрамлениеИнсталляцииПоУмолчанию(), Обрамление);
	Результат.Вставить("Обрамление", Рамка);
	Результат.Вставить("Каркас", Новый КаркасСтраницы(Результат.Кит, Новый ТокеныТемы(),
		Новый ВыборОформления(Новый ОформлениеИнсталляцииПоУмолчанию()), Тексты, Модели,
		Активы, Рамка));

	Возврат Результат;

КонецФункции

// Словарь инсталляции: у кита он пуст по построению, поэтому строки обрамления берутся
// из пробного словаря — как на боевой инсталляции.
Функция Словарь(Знач Обрамление)

	Если Обрамление = Неопределено Тогда
		Возврат Новый СловарьИнтерфейсаПоУмолчанию();
	КонецЕсли;
	Возврат Новый СловарьПробы();

КонецФункции

Функция НаборКомпонентов(Знач Экран, Знач Модели, Знач Значки)

	Кнопки = Новый Кнопка(Экран, Модели, Значки);
	Плашки = Новый Плашка(Экран, Модели, Значки);
	Поля = Новый ПолеФормы(Экран, Модели);
	ПоляСкрытые = Новый СкрытоеПоле(Экран, Модели);
	Заглавия = Новый ЗаголовокСтраницы(Экран, Модели);
	Команды = Новый БлокКоманды(Экран, Модели, Значки);
	РядыМеты = Новый РядМеты(Экран, Модели, Значки);

	Возврат Новый НаборКомпонентов(
		Новый Карточка(Экран, Модели, Значки),
		Поля,
		Новый ПолеИзКонфига(Экран, Модели, Поля, Значки),
		Новый Таблица(Экран, Модели),
		Новый Тост(Экран, Модели, Значки),
		Плашки,
		Новый ДеревоРазделов(Экран, Модели, Значки),
		Новый ПанельСохранения(Экран, Модели, Кнопки),
		Значки,
		Новый Тумблер(Экран, Модели),
		Новый Проводник(Экран, Модели, Значки),
		Кнопки,
		Новый Табы(Экран, Модели, Значки),
		Новый ПустоеСостояние(Экран, Модели, Значки, Кнопки),
		Новый ОпаснаяЗона(Экран, Модели, Значки, Поля, Кнопки),
		Команды,
		Новый ШапкаОбъекта(Экран, Модели, Значки, Плашки, Команды, РядыМеты),
		Новый Пагинация(Экран, Модели, Значки),
		Новый Плитка(Экран, Модели, Значки),
		Новый Сетка(Экран, Модели),
		ПоляСкрытые,
		Заглавия,
		Новый СтраницаОшибки(Модели, Заглавия),
		Новый ФормаОтбора(Экран, Модели, Поля, Кнопки, ПоляСкрытые),
		Новый ПолосаЗаполнения(Экран, Модели),
		Новый Меню(Экран, Модели, Кнопки),
		РядыМеты);

КонецФункции
