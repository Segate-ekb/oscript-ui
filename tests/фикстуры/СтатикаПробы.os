// Заглушка контракта «СтатикаИнсталляции»: каталог и список файлов задаются снаружи.
// Ею проверяется, что кит раздаёт то, что объявила инсталляция, а не зашитый в код список.

Перем Корень;
Перем Объявленные;

// Каталог статики инсталляции на диске.
//
// Возвращаемое значение:
//  Строка
//
Функция Каталог() Экспорт
	Возврат Корень;
КонецФункции

// Файлы, которые инсталляция отдаёт по /static.
//
// Возвращаемое значение:
//  Соответствие - имя файла -> Структура("Подкаталог, ТипКонтента").
//
Функция Файлы() Экспорт
	Возврат Объявленные;
КонецФункции

// Объявляет файл инсталляции.
//
// Параметры:
//  Имя         - Строка - имя файла.
//  Подкаталог  - Строка - подкаталог внутри каталога статики; "" — корень.
//  ТипКонтента - Строка - Content-Type, с которым файл отдаётся.
//
Процедура Объявить(Знач Имя, Знач Подкаталог, Знач ТипКонтента) Экспорт
	Объявленные.Вставить(Имя,
		Новый Структура("Подкаталог, ТипКонтента", Подкаталог, ТипКонтента));
КонецПроцедуры

Процедура ПриСозданииОбъекта(Знач _Корень = "") Экспорт
	Корень = _Корень;
	Объявленные = Новый Соответствие();
КонецПроцедуры
