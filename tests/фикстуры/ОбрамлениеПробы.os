// Фикстура: обрамление ЧУЖОЙ инсталляции — реализация контракта «ОбрамлениеИнсталляции»
// со значениями, которых у кита нет и быть не может. Если каркас напечатает своё вместо
// присланного, тест это увидит.

Перем Приватные; // Массив разделов приватной части; пустой — страница публичная
Перем Действия_; // Массив — действия шапки инсталляции; пустой — действий нет
Перем ЕдиноеМеню; // Структура — слот единого меню хаба; Неопределено — слота в рамке нет
Перем УвиденныйПуть; // Строка — путь запроса, который каркас довёз последним вызовом
Перем Название;  // Булево — печатать ли название рядом со знаком
Перем Ширина;    // Число — известная ширина знака; 0 — пропорции произвольны
Перем Лист;      // Строка — адрес своего листа стилей; "" — хватает базового
Перем Оформление; // Строка — адрес переключателя темы; "" — переключателя нет

// Кладёт на страницу навигацию приватной части.
//
// Параметры:
//  Разделы - Массив из Структура - Подпись, Адрес, Иконка.
//
Процедура НавигацияПриватной(Знач Разделы) Экспорт
	Приватные = Разделы;
КонецПроцедуры

// Отдаёт шапке действия инсталляции: модели кнопок, узлы холста, готовые фрагменты.
//
// Параметры:
//  Список - Массив, Неопределено - действия по порядку; Неопределено — снова без действий.
//
Процедура Действия(Знач Список) Экспорт
	Действия_ = ?(Список = Неопределено, Новый Массив(), Список);
КонецПроцедуры

// Отдаёт каркасу слот ЕДИНОГО меню. Не вызвана — слота в рамке нет вовсе: так выглядит
// обрамление инсталляции, написанное до его появления.
//
// Параметры:
//  Модель - Структура, Неопределено - Счётчик, ПодписьСчётчика, Учётка, Дела, Навигация,
//           Выход (см. контракт).
//
Процедура МенюХаба(Знач Модель) Экспорт
	ЕдиноеМеню = Модель;
КонецПроцедуры

// Путь запроса, доехавший до обрамления последним вызовом. По нему инсталляция решает,
// какая её дорога активна, поэтому потеря пути по дороге — молчаливая потеря подсветки.
//
// Возвращаемое значение:
//  Строка
//
Функция УвиденныйПуть() Экспорт
	Возврат УвиденныйПуть;
КонецФункции

// Прячет название рядом со знаком: на картинке оно уже нарисовано.
Процедура БезНазвания() Экспорт
	Название = Ложь;
КонецПроцедуры

// Ставит знак произвольных пропорций — такой, ширину которого считает браузер.
Процедура ЗнамяПроизвольныхПропорций() Экспорт
	Ширина = 0;
КонецПроцедуры

// Адрес переключателя темы; пустой — инсталляция без переключателя.
Процедура АдресОформления(Знач Адрес) Экспорт
	Оформление = Адрес;
КонецПроцедуры

// Оставляет инсталляцию без своего листа стилей: ей хватает базового листа библиотеки.
Процедура БезСвоегоЛиста() Экспорт
	Лист = "";
КонецПроцедуры

// Обрамление чужой инсталляции.
//
// Параметры:
//  Контекст - Структура - контекст запроса.
//
// Возвращаемое значение:
//  Структура - см. контракт ОбрамлениеИнсталляции.
//
Функция Обрамление(Знач Контекст) Экспорт

	УвиденныйПуть = ?(ТипЗнч(Контекст) = Тип("Структура") И Контекст.Свойство("Путь"),
		Строка(Контекст.Путь), "");

	Иконки = Новый Массив();
	Иконки.Добавить(Новый Структура("Отношение, Адрес, Тип, Размеры",
		"icon", "/ресурсы/значок.svg", "image/svg+xml", ""));
	Иконки.Добавить(Новый Структура("Отношение, Адрес, Тип, Размеры",
		"icon", "/ресурсы/запасной.ico", "", "any"));

	Разделы = Новый Массив();
	Разделы.Добавить(Новый Структура("Подпись, Адрес, Иконка",
		"Витрина", "/витрина", "куб"));

	Результат = Новый Структура();
	Результат.Вставить("Язык", "ru");
	Результат.Вставить("Знак", "Ромашка");
	Результат.Вставить("Подпись", "Внутренний портал компании");
	Результат.Вставить("ПолитикаПерехода", "same-origin");
	Результат.Вставить("АдресСтилей", Лист);
	Результат.Вставить("АдресСкрипта", "/ресурсы/страница.js");
	Результат.Вставить("Иконки", Иконки);
	Результат.Вставить("Знамя", Новый Структура("Адрес, Ширина, Название",
		"/ресурсы/знак.svg", Ширина, Название));
	Результат.Вставить("Разделы", Разделы);
	Результат.Вставить("Приватные", Приватные);
	Результат.Вставить("Действия", Действия_);
	Если ЕдиноеМеню <> Неопределено Тогда
		Результат.Вставить("МенюХаба", ЕдиноеМеню);
	КонецЕсли;
	Результат.Вставить("Адреса", Новый Структура("Корень, Оформление", "/", Оформление));
	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта() Экспорт
	Приватные = Новый Массив();
	Действия_ = Новый Массив();
	ЕдиноеМеню = Неопределено;
	УвиденныйПуть = "";
	Название = Истина;
	Ширина = 28;
	Лист = "/ресурсы/лист.css";
	Оформление = "/вид";
КонецПроцедуры
