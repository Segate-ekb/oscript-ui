// Фикстура: обрамление ЧУЖОЙ инсталляции — реализация контракта «ОбрамлениеИнсталляции»
// со значениями, которых у кита нет и быть не может. Если каркас напечатает своё вместо
// присланного, тест это увидит.

Перем Приватные; // Массив разделов приватной части; пустой — страница публичная
Перем Вошедший;  // Строка — имя вошедшего; "" — посетитель
Перем Меню;      // Структура — модель меню учётки; Неопределено — поля в рамке НЕТ вовсе,
                 // как у обрамления, написанного до появления слота
Перем Название;  // Булево — печатать ли название рядом со знаком
Перем Ширина;    // Число — известная ширина знака; 0 — пропорции произвольны
Перем Лист;      // Строка — адрес своего листа стилей; "" — хватает базового

// Кладёт на страницу навигацию приватной части.
//
// Параметры:
//  Разделы - Массив из Структура - Подпись, Адрес, Иконка.
//
Процедура НавигацияПриватной(Знач Разделы) Экспорт
	Приватные = Разделы;
КонецПроцедуры

// Сажает на страницу вошедшего.
//
// Параметры:
//  Имя - Строка - имя учётки; "" — на странице посетитель.
//
Процедура Учётка(Знач Имя) Экспорт
	Вошедший = Имя;
КонецПроцедуры

// Отдаёт шапке модель меню учётки. Не вызвана — поля в рамке нет вовсе: так выглядит
// обрамление инсталляции, написанное до появления слота.
//
// Параметры:
//  Модель - Структура, Неопределено - Подпись, Счётчик, Пункты (см. контракт).
//
Процедура МенюУчётки(Знач Модель) Экспорт
	Меню = Модель;
КонецПроцедуры

// Прячет название рядом со знаком: на картинке оно уже нарисовано.
Процедура БезНазвания() Экспорт
	Название = Ложь;
КонецПроцедуры

// Ставит знак произвольных пропорций — такой, ширину которого считает браузер.
Процедура ЗнамяПроизвольныхПропорций() Экспорт
	Ширина = 0;
КонецПроцедуры

// Оставляет инсталляцию без своего листа стилей: ей хватает базового листа библиотеки.
Процедура БезСвоегоЛиста() Экспорт
	Лист = "";
КонецПроцедуры

// Обрамление чужой инсталляции.
//
// Параметры:
//  Контекст - Структура - контекст запроса.
//
// Возвращаемое значение:
//  Структура - см. контракт ОбрамлениеИнсталляции.
//
Функция Обрамление(Знач Контекст) Экспорт

	Иконки = Новый Массив();
	Иконки.Добавить(Новый Структура("Отношение, Адрес, Тип, Размеры",
		"icon", "/ресурсы/значок.svg", "image/svg+xml", ""));
	Иконки.Добавить(Новый Структура("Отношение, Адрес, Тип, Размеры",
		"icon", "/ресурсы/запасной.ico", "", "any"));

	Разделы = Новый Массив();
	Разделы.Добавить(Новый Структура("Подпись, Адрес, Иконка",
		"Витрина", "/витрина", "куб"));

	Результат = Новый Структура();
	Результат.Вставить("Язык", "ru");
	Результат.Вставить("Знак", "Ромашка");
	Результат.Вставить("Подпись", "Внутренний портал компании");
	Результат.Вставить("ПолитикаПерехода", "same-origin");
	Результат.Вставить("АдресСтилей", Лист);
	Результат.Вставить("АдресСкрипта", "/ресурсы/страница.js");
	Результат.Вставить("Иконки", Иконки);
	Результат.Вставить("Знамя", Новый Структура("Адрес, Ширина, Название",
		"/ресурсы/знак.svg", Ширина, Название));
	Результат.Вставить("Разделы", Разделы);
	Результат.Вставить("Приватные", Приватные);
	Результат.Вставить("Аккаунт", Вошедший);
	Если Меню <> Неопределено Тогда
		Результат.Вставить("МенюУчётки", Меню);
	КонецЕсли;
	Результат.Вставить("Адреса", Новый Структура("Корень, Вход, Кабинет, Выход, Оформление",
		"/", "/вход", "/личное", "/выход", "/вид"));
	Возврат Результат;

КонецФункции

Процедура ПриСозданииОбъекта() Экспорт
	Приватные = Новый Массив();
	Вошедший = "";
	Меню = Неопределено;
	Название = Истина;
	Ширина = 28;
	Лист = "/ресурсы/лист.css";
КонецПроцедуры
