// Документация обещает разработчику три вещи: каждый образец на её страницах нарисован
// ровно тем кодом, что показан под ним; в ней виден ВЕСЬ словарь кита; и ни одна её
// страница не врёт — не ссылается в пустоту и не описывает модель, которой нет.
// Сайт на winow здесь не нужен: проверяется движок, который печатает его страницы.

#Использовать "../"
#Использовать oscript-md
#Использовать asserts

Перем Каталог;    // Строка — каталог документации
Перем Сборка;     // СборкаДокументации — движок, собранный руками
Перем Страницы;   // Соответствие: ключ -> напечатанная страница (печатаются один раз)
Перем Порядок;    // Массив ключей в порядке печати

// Четыре имени, которые видит исходник образца, — и больше ничего: если образец
// опирается на что-то ещё, здесь он не исполнится.
Перем Набор;      // НаборКомпонентов
Перем Кит;        // Кит
Перем Формы;      // Формы
Перем Настройки;  // РендерерНастроек
Перем Печать;     // РазметкаЭлементов
Перем Экран;      // ЭкранированиеHTML

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура НапечататьДокументацию() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;

	Каталог = ОбъединитьПути(КаталогТестов, "..", "документация");
	Движок = ОбъединитьПути(Каталог, "src", "Классы", "движок");
	Для Каждого Имя Из СтрРазделить("СловарьДокументации,ИсполнениеОбразца,СправкаКомпонента,ДирективыДокументации,"
			+ "ПечатьДокументации,ОглавлениеДокументации,СборкаДокументации", ",") Цикл
		ПодключитьСценарий(ОбъединитьПути(Движок, Имя + ".os"), Имя);
	КонецЦикла;

	// движок печатает страницы СВОИМ графом кита, а образцы ниже исполняются СВОИМ:
	// меню и объявление формы выдают порядковые идентификаторы, и два прогона одних и тех
	// же образцов совпадут, только если каждый считает со своего нуля в одном порядке
	Сборка = Новый СборкаДокументации();
	Страницы = Новый Соответствие();
	Порядок = Новый Массив();
	Для Каждого Ключ Из Сборка.Оглавление().Ключи() Цикл
		Путь = ОбъединитьПути(Каталог, "страницы", Ключ + ".md");
		Если НЕ Новый Файл(Путь).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Страницы.Вставить(Ключ, Сборка.Печать().Напечатать(ПрочитатьТекст(Путь)));
		Порядок.Добавить(Ключ);
	КонецЦикла;

	// своя сборка того же устройства (и того же словаря), но со своими счётчиками
	Слой = Новый СборкаДокументации().Желуди();
	Набор = Слой.Набор;
	Кит = Слой.Кит;
	Формы = Слой.Формы;
	Настройки = Слой.Настройки;
	Печать = Слой.Разметка;
	Экран = Слой.Экран;

КонецПроцедуры

#Область Страницы

// У каждой строки оглавления есть страница, и у каждой страницы — строка оглавления:
// страница без места в навигации недостижима, место без страницы ведёт в заглушку.
&Тест
Процедура ОглавлениеИКаталогСтраницСовпадают() Экспорт

	Ключи = Сборка.Оглавление().Ключи();
	Без = Новый Массив();
	Для Каждого Ключ Из Ключи Цикл
		Если Страницы.Получить(Ключ) = Неопределено Тогда
			Без.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;

	Сироты = Новый Массив();
	Для Каждого Файл Из НайтиФайлы(ОбъединитьПути(Каталог, "страницы"), "*.md") Цикл
		Если Ключи.Найти(НРег(Файл.ИмяБезРасширения)) = Неопределено Тогда
			Сироты.Добавить(Файл.Имя);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Ключи.Количество() > 40, "страниц в оглавлении: " + Ключи.Количество()).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Без, ", "), "строки оглавления без страницы").Равно("");
	Ожидаем.Что(СтрСоединить(Сироты, ", "), "страницы без строки оглавления").Равно("");

КонецПроцедуры

// Страница печатается целиком: заголовок, пояснение под ним, каждый образец собирается,
// каждая справка нашла описание в исходнике кита.
&Тест
Процедура КаждаяСтраницаСобираетсяБезОшибок() Экспорт

	Беды = Новый Массив();
	Образцов = 0;
	Для Каждого Ключ Из Порядок Цикл
		Страница = Страницы.Получить(Ключ);
		Если НЕ ЗначениеЗаполнено(Страница.Заголовок) Тогда
			Беды.Добавить(Ключ + ": нет заголовка");
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Страница.Пояснение) Тогда
			Беды.Добавить(Ключ + ": нет пояснения");
		КонецЕсли;
		Если СтрНайти(Страница.Тело, "class=""docs-error""") > 0 Тогда
			Беды.Добавить(Ключ + ": на странице ошибка образца или справки");
		КонецЕсли;
		Для Каждого Образец Из Страница.Образцы Цикл
			Образцов = Образцов + 1;
			Если НЕ Образец.Успех Тогда
				Беды.Добавить(СтрШаблон("%1 / %2: %3", Ключ, Образец.Подпись, Образец.Ошибка));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Образцов > 150, "образцов в документации: " + Образцов).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Беды, Символы.ПС), "страницы с ошибками").Равно("");

КонецПроцедуры

// Ссылка на соседнюю страницу ведёт туда, где страница есть: переименованный ключ
// оставлял бы в тексте ссылки в никуда.
&Тест
Процедура СсылкиВедутНаСуществующиеСтраницы() Экспорт

	Битые = Новый Массив();
	Для Каждого Ключ Из Порядок Цикл
		Текст = ПрочитатьТекст(ОбъединитьПути(Каталог, "страницы", Ключ + ".md"));
		Позиция = СтрНайти(Текст, "](");
		Пока Позиция > 0 Цикл
			Конец = СтрНайти(Текст, ")", НаправлениеПоиска.СНачала, Позиция);
			Цель = Сред(Текст, Позиция + 2, Конец - Позиция - 2);
			Решётка = СтрНайти(Цель, "#");
			Если Решётка > 0 Тогда
				Цель = Лев(Цель, Решётка - 1);
			КонецЕсли;
			Если ЗначениеЗаполнено(Цель) И СтрНайти(Цель, ":") = 0 И НЕ СтрНачинаетсяС(Цель, "/")
				И Сборка.Оглавление().Страница(Цель) = Неопределено Тогда
				Битые.Добавить(Ключ + " → " + Цель);
			КонецЕсли;
			Позиция = СтрНайти(Текст, "](", НаправлениеПоиска.СНачала, Конец);
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Битые, ", "), "ссылки на страницы, которых нет").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Образцы

// Показанный код — не подпись к картинке, а её источник. Проверка исполняет каждый
// образец ЗАНОВО, в чужом модуле с одними четырьмя желудями, и сверяет с тем, что
// нарисовала страница.
&Тест
Процедура ПоказанныйКодРисуетТотЖеОбразец() Экспорт

	Расхождения = Новый Массив();
	Для Каждого Ключ Из Порядок Цикл
		Для Каждого Образец Из Страницы.Получить(Ключ).Образцы Цикл
			Если Образец.Успех И Исполнить(Образец.Исходник) <> Образец.HTML Тогда
				Расхождения.Добавить(Ключ + " / " + Образец.Подпись);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Расхождения, "; "),
		"образцы, у которых показанный код рисует НЕ ТО, что нарисовано рядом").Равно("");

КонецПроцедуры

// Исходник живого образца попадает на страницу целиком и без правок — и в текст блока,
// и в кнопку копирования: его копируют и вставляют к себе.
&Тест
Процедура СтраницаПоказываетИДаётСкопироватьТотЖеИсходник() Экспорт

	Потери = Новый Массив();
	Для Каждого Ключ Из Порядок Цикл
		Страница = Страницы.Получить(Ключ);
		Для Каждого Образец Из Страница.Образцы Цикл
			Если СтрНайти(Страница.Тело, Экран.Экранировать(Образец.Исходник)) = 0 Тогда
				Потери.Добавить(Ключ + " / " + Образец.Подпись + ": нет в тексте");
			КонецЕсли;
			Если (Образец.Вид = "живой" ИЛИ Образец.Вид = "разметкой")
				И СтрНайти(Страница.Тело, Экран.Атрибут("data-copy", Образец.Исходник)) = 0 Тогда
				Потери.Добавить(Ключ + " / " + Образец.Подпись + ": нет в кнопке");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Потери, "; "),
		"исходники, показанные или копируемые не такими, какими исполнены").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Словарь

// Документация — место, где библиотеку видно целиком: заведённый род холста или новый
// компонент обязаны в ней появиться, иначе разработчик о них не узнает.
&Тест
Процедура ДокументацияПоказываетВесьСловарьКита() Экспорт

	Показано = Новый Соответствие();
	Для Каждого Ключ Из Порядок Цикл
		Для Каждого Имя Из Страницы.Получить(Ключ).Словарь Цикл
			Показано.Вставить(Имя, Ключ);
		КонецЦикла;
	КонецЦикла;

	Пропущено = Новый Массив();
	Для Каждого Род Из Печать.Роды() Цикл
		Если Показано.Получить("род:" + Род) = Неопределено Тогда
			Пропущено.Добавить("род " + Род);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Вид Из Печать.ВидыРода("компонент") Цикл
		Если Показано.Получить("компонент:" + Вид) = Неопределено Тогда
			Пропущено.Добавить("компонент " + Вид);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Пропущено, ", "), "словарь кита, которого в документации нет")
		.Равно("");

КонецПроцедуры

// Объявить род мало — его надо ПОКАЗАТЬ: род печатается своим тегом хотя бы в одном
// образце той страницы, что его объявила. Тег спрашивается у самого кита.
&Тест
Процедура ОбъявленныйРодПечатаетсяСвоимТегомНаСвоейСтранице() Экспорт

	Необоснованные = Новый Массив();
	Для Каждого Ключ Из Порядок Цикл
		Страница = Страницы.Получить(Ключ);
		Разметка = "";
		Для Каждого Образец Из Страница.Образцы Цикл
			Разметка = Разметка + Образец.HTML;
		КонецЦикла;
		Для Каждого Имя Из Страница.Словарь Цикл
			Тег = ПроверяемыйТег(Имя);
			Если ЗначениеЗаполнено(Тег) И СтрНайти(Разметка, "<" + Тег) = 0 Тогда
				Необоснованные.Добавить(Имя + " (страница " + Ключ + ")");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Необоснованные, ", "),
		"роды, объявленные страницей, но ни одним её образцом не напечатанные").Равно("");

КонецПроцедуры

// Обратная сторона: страница объявила то, чего в ките уже нет, — и врёт читателю.
&Тест
Процедура ДокументацияНеОбещаетТого_ЧегоВКитеНет() Экспорт

	Лишнее = Новый Массив();
	Для Каждого Ключ Из Порядок Цикл
		Для Каждого Имя Из Страницы.Получить(Ключ).Словарь Цикл
			Если НЕ КитЗнает(Имя) Тогда
				Лишнее.Добавить(Имя + " (страница " + Ключ + ")");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Лишнее, ", "), "документация обещает то, чего в ките нет").Равно("");

КонецПроцедуры

#КонецОбласти

#Область Движок

// Особые блоки страницы печатает сама документация: живой образец с кодом и кнопкой
// копирования, пары правил одной сеткой, справку из исходника, директиву кита; словарь
// не печатается вовсе; заголовок и пояснение уходят из тела в шапку страницы.
&Тест
Процедура ДвижокПечатаетОсобыеБлоки() Экспорт

	Текст = "# Проба" + Символы.ПС + Символы.ПС + "Пояснение пробы." + Символы.ПС + Символы.ПС
		+ "## Раздел" + Символы.ПС + Символы.ПС + "## Раздел" + Символы.ПС + Символы.ПС
		+ Блок("живой Подпись образца", "HTML = Набор.Кнопка().Отрисовать(""Да"");")
		+ Блок("делайте Так", "HTML = ""<b>да</b>"";")
		+ Блок("не делайте Не так", "HTML = ""<i>нет</i>"";")
		+ Блок("справка Кнопка", "")
		+ Блок("директива иконки", "")
		+ Блок("словарь компонент:кнопка", "")
		+ Блок("bsl", "Сообщить(1);");

	Страница = Сборка.Печать().Напечатать(Текст);

	Ожидаем.Что(Страница.Заголовок, "заголовок — из первого h1").Равно("Проба");
	Ожидаем.Что(Страница.Пояснение, "пояснение — первый абзац").Равно("Пояснение пробы.");
	Ожидаем.Что(СтрНайти(Страница.Тело, "Пояснение пробы"), "пояснения нет в теле").Равно(0);
	Ожидаем.Что(Страница.Разделы.Количество(), "два раздела второго уровня").Равно(2);
	Ожидаем.Что(Страница.Разделы[1].Ид, "повтор якоря получает номер").Равно("раздел-2");

	Ожидаем.Что(СтрНайти(Страница.Тело, "class=""docs-sample""") > 0, "живой образец").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница.Тело, "data-copy") > 0, "кнопка копирования").ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(Страница.Тело, "class=""docs-rules"""),
		"соседние правила — одной сеткой").Равно(1);
	Ожидаем.Что(СтрНайти(Страница.Тело, "docs-rule--dont") > 0, "«не делайте» через пробел").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница.Тело, "src/Классы/компоненты/Кнопка.os") > 0,
		"справка называет файл исходника").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница.Тело, "class=""docs-icons""") > 0, "директива иконок").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница.Тело, "компонент:кнопка"), "словарь не печатается").Равно(0);
	Ожидаем.Что(Страница.Словарь.Найти("компонент:кнопка") <> Неопределено, "но записан").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница.Тело, "<pre class=""code""><code>Сообщить(1);") > 0,
		"обычный код не исполняется").ЭтоИстина();
	Ожидаем.Что(Страница.Образцы.Количество(), "исполнены образец и два правила").Равно(3);

	// сломанный образец не роняет страницу, а печатает ошибку на месте картинки
	Сломанная = Сборка.Печать().Напечатать("# Х" + Символы.ПС + Символы.ПС
		+ Блок("живой Сломан", "HTML = НетТакого.Метода();"));
	Ожидаем.Что(Сломанная.Образцы[0].Успех, "образец сломан").ЭтоЛожь();
	Ожидаем.Что(СтрНайти(Сломанная.Тело, "class=""docs-error""") > 0, "ошибка видна").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Исходник образца исполняется здесь так же, как в документации, — но в ЧУЖОМ модуле:
// ничего, кроме Набора, Кита, Форм и Настроек, ему тут не видно.
Функция Исполнить(Знач Исходник)

	HTML = "";
	Попытка
		Выполнить(Исходник);
	Исключение
		Возврат "исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат HTML;

КонецФункции

Функция Блок(Знач Пометка, Знач Код)
	Возврат "```" + Пометка + Символы.ПС + Код + ?(ЗначениеЗаполнено(Код), Символы.ПС, "")
		+ "```" + Символы.ПС + Символы.ПС;
КонецФункции

// Тег годится в сторожа, только когда он один: у заголовка это диапазон «h1…h6», а роду
// без тега (холст, текст, шаблон, готовое, компонент) сверять нечего — его показ видит глаз.
Функция ПроверяемыйТег(Знач Имя)

	Если НЕ СтрНачинаетсяС(Имя, "род:") Тогда
		Возврат "";
	КонецЕсли;

	Тег = Печать.ТегРода(Сред(Имя, 5));
	Возврат ?(СтрНайти(Тег, "…") = 0, Тег, "");

КонецФункции

Функция КитЗнает(Знач Имя)

	Если СтрНачинаетсяС(Имя, "род:") Тогда
		Возврат Печать.Роды().Найти(Сред(Имя, 5)) <> Неопределено;
	КонецЕсли;

	Возврат СтрНачинаетсяС(Имя, "компонент:")
		И Печать.ВидыРода("компонент").Найти(Сред(Имя, 11)) <> Неопределено;

КонецФункции

Функция ПрочитатьТекст(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

#КонецОбласти
