// Слова дев-сборки 0.13.0-dev.9: выбор значка, пресеты темы, переключатель темы пилюлей и
// хвосты трека хаба ui-хвост-единообразие (П4, П6). Проверяется то, что ломается для
// человека: рубрика шторки читается соседней группой, два пути из пустоты не помещаются,
// пресет не держит контраст текста, а узлы без новых слов печатаются иначе, чем до сборки.

#Использовать "../"
#Использовать asserts

Перем Кит;    // Кит
Перем Набор;  // НаборКомпонентов
Перем Разбор; // РазборЛиста — сканер, читающий КОД листа
Перем ПравилаЛиста; // правила базового листа, разобранные однажды

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "РазборЛиста.os"), "РазборЛиста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Кит = Слой.Кит;
	Набор = Слой.Набор;
	Разбор = Новый РазборЛиста();

КонецПроцедуры

#Область РубрикаШторки

// П6: рубрика внутри группы шторки — ступенью ниже имени группы: кегль меньше, левый край —
// с текстом пунктов (дальше имени группы), цвет приглушённый. Разметка прежняя.
&Тест
Процедура РубрикаШторкиСтупеньюНижеИмениГруппы() Экспорт

	Ожидаем.Что(ОбъявлениеЛиста(".hubmenu__title", "font"), "имя группы — title-small")
		.Равно("var(--type-title-small)");
	Ожидаем.Что(ОбъявлениеЛиста(".hubmenu__rubric", "font"), "рубрика — label-medium")
		.Равно("var(--type-label-medium)");
	Ожидаем.Что(ОбъявлениеЛиста(".hubmenu__rubric", "color"), "рубрика приглушена")
		.Равно("var(--md-sys-color-on-surface-variant)");
	Ожидаем.Что(ОбъявлениеЛиста(".hubmenu__rubric", "padding"), "рубрика без значков — с полем пунктов")
		.Равно("var(--space-3) var(--space-4) var(--space-1)");
	Ожидаем.Что(ОбъявлениеЛиста(".hubmenu__rubric:has(+ .button > .icon)", "padding-left"),
		"рубрика пунктов со значком — с их текстом").Равно("calc(var(--space-4) + 24px + var(--space-3))");
	Ожидаем.Что(ОбъявлениеЛиста(".hubmenu .button .icon", "width"), "значок пункта — 24, на нём держится отступ рубрики")
		.Равно("24px");
	Ожидаем.Что(ОбъявлениеЛиста(".hubmenu .button", "gap"), "зазор значка и подписи пункта")
		.Равно("var(--space-3)");

	HTML = Набор.МенюХаба().Отрисовать(МенюСРубрикой()).Панель;
	Ожидаем.Что(HTML, "разметка рубрики прежняя").Содержит("<p class=""hubmenu__rubric"">Доступ</p>");

КонецПроцедуры

#КонецОбласти

#Область ПустоеСостояниеСДвумяПутями

// П4: два пути из пустоты — Действие дважды; главный первым своим видом, второй без вида —
// вторичным, оба в одной группе.
&Тест
Процедура ПустоеСостояниеПечатаетДваДействия() Экспорт

	HTML = Кит.ПустоеСостояние("В пуле пока нет пакетов")
		.Действие(Кит.Кнопка("Опубликовать").Основная().Адрес("/опубликовать"))
		.Действие(Кит.Кнопка("Перенести").Адрес("/перенести"))
		.Рендер();
	Группа = МеждуМаркеров(HTML, "<div class=""empty__actions"">", "</div>");
	Ожидаем.Что(Группа, "главный — основной").Содержит("button--primary");
	Ожидаем.Что(Группа, "второй — вторичный").Содержит("button--ghost");
	Ожидаем.Что(СтрНайти(Группа, "Опубликовать") < СтрНайти(Группа, "Перенести"), "главный первым").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "empty__action"""), "одиночной обёртки нет").Равно(0);

	Словом = Кит.ПустоеСостояние("В пуле пока нет пакетов")
		.Действия(Кит.Кнопка("Опубликовать").Основная().Адрес("/опубликовать"),
			Кит.Кнопка("Перенести").Адрес("/перенести"))
		.Рендер();
	Ожидаем.Что(Словом, "Действия(…) — то же, что Действие дважды").Равно(HTML);

	Свой = Кит.ПустоеСостояние("Пусто").Действие(Кит.Кнопка("А").Основная()).Действие(Кит.Кнопка("Б").Ссылкой()).Рендер();
	Ожидаем.Что(Свой, "свой вид второго — его").Содержит("button--link");

КонецПроцедуры

// Одно действие — прежняя разметка байт в байт; модель структурой с полем Действия —
// тот же вывод, что слова.
&Тест
Процедура ПустоеСостояниеСОднимДействиемКакПрежде() Экспорт

	Прежнее = Набор.ПустоеСостояние().Отрисовать(Новый Структура("Пояснение, Действие",
		"Пусто", Новый Структура("Подпись, Вариант", "Создать", "основная")));
	Ожидаем.Что(Кит.ПустоеСостояние("Пусто").Действие(Кит.Кнопка("Создать").Основная()).Рендер(), "одно действие")
		.Равно(Прежнее);
	Ожидаем.Что(Прежнее, "прежняя обёртка").Содержит("<div class=""empty__action""><");

	Действия = Новый Массив();
	Действия.Добавить(Новый Структура("Подпись", "Перенести"));
	Структурой = Набор.ПустоеСостояние().Отрисовать(Новый Структура("Пояснение, Действие, Действия",
		"Пусто", Новый Структура("Подпись, Вариант", "Создать", "основная"), Действия));
	Ожидаем.Что(Структурой, "поле модели Действия").Содержит("empty__actions");
	Ожидаем.Что(Действия[0].Свойство("Вариант"), "модель вызывающего не тронута").ЭтоЛожь();

КонецПроцедуры

// Ритм у корня: пустое состояние держит отбивку снизу, как карточка; на телефоне пути —
// столбиком во всю ширину.
&Тест
Процедура ПустоеСостояниеНеСлипаетсяСКарточкой() Экспорт

	Ожидаем.Что(ОбъявлениеЛиста(":where(.empty:not(.empty--compact):not(:last-child))", "margin-bottom"), "отбивка снизу")
		.Равно(ОбъявлениеЛиста(".card", "margin-bottom"));
	Ожидаем.Что(ОбъявлениеЛиста(".empty__actions", "display"), "пути рядом").Равно("flex");
	Ожидаем.Что(ОбъявлениеЛиста(".empty__actions", "flex-direction", "@media (max-width: 600px)"),
		"на телефоне столбиком").Равно("column");

КонецПроцедуры

#КонецОбласти

#Область ПилюляТемы

// Пилюля темы: размер по пилюлям кита (44×24), бегунок едет за темой страницы за 0.2 с
// токеном движения, без движения — без перехода; скрипт сразу правит aria-checked.
&Тест
Процедура ПилюляТемыЕдетЗаТемойСтраницы() Экспорт

	Ожидаем.Что(ОбъявлениеЛиста(".theme-switch__track", "width"), "ширина дорожки").Равно("44px");
	Ожидаем.Что(ОбъявлениеЛиста(".theme-switch__track", "height"), "высота дорожки").Равно("24px");
	Ожидаем.Что(ОбъявлениеЛиста(".theme-switch", "border-radius"), "кольцо фокуса — пилюлей")
		.Равно("var(--md-sys-shape-corner-full)");
	Ожидаем.Что(ОбъявлениеЛиста(".theme-switch__thumb", "transform"), "тёмная — бегунок справа").Равно("translateX(20px)");
	Ожидаем.Что(ОбъявлениеЛиста("html[data-theme=""""] .theme-switch__thumb", "transform"), "светлая — слева")
		.Равно("none");
	Ожидаем.Что(ОбъявлениеЛиста(".theme-switch__thumb", "transition"), "переход 0.2 с токеном")
		.Равно("transform var(--md-sys-motion-duration-short4) var(--md-sys-motion-easing-standard)");
	Ожидаем.Что(ОбъявлениеЛиста(".theme-switch__thumb", "transition", "@media (prefers-reduced-motion: reduce)"),
		"без движения — без перехода").Равно("none");
	Ожидаем.Что(ОбъявлениеЛиста("html[data-theme=""""] .theme-switch__sun", "display"), "в светлой — солнце")
		.Равно("inline-flex");
	Ожидаем.Что(ОбъявлениеЛиста("html[data-theme=""""] .theme-switch__moon", "display"), "луна спрятана")
		.Равно("none");
	Ожидаем.Что(ТекстСкрипта(), "скрипт сразу правит состояние переключателя")
		.Содержит("switches[i].setAttribute('aria-checked', next === 'dark' ? 'true' : 'false');");

КонецПроцедуры

#КонецОбласти

#Область ПресетыТемы

// Пресет приходит из cookie оформления ключом «пресет» и переживает смену темы: переключатель
// темы пишет куку заново, и стёртый пресет вернул бы посетителю чужие цвета.
&Тест
Процедура ПресетВКукеОформления() Экспорт

	Выбор = Новый ВыборОформления(Новый ОформлениеИнсталляцииПоУмолчанию());
	Поля = Выбор.РазобратьЗначение("тема=светлая&пресет=oscript");
	Ожидаем.Что(Поля.Пресет, "пресет из куки").Равно("oscript");
	Ожидаем.Что(Выбор.ЗначениеCookieСТемой("тема=светлая&пресет=classic", "тёмная"), "смена темы хранит пресет")
		.Равно("тема=тёмная&пресет=classic");
	Ожидаем.Что(Выбор.ПоУмолчанию().Свойство("Пресет"), "у оформления инсталляции есть поле пресета").ЭтоИстина();

КонецПроцедуры

// Рамка образца пресетом: один пресет — признак data-preset и его палитры обеих тем; с именем
// поля — зеркало признаком и палитры всех трёх, ключом значения поля.
&Тест
Процедура ОбразецПоказываетПресет() Экспорт

	Один = Кит.Образец("Как было", Кит.Надпись("текст")).Пресет("classic").Рендер();
	Ожидаем.Что(Один, "признак пресета").Содержит("data-preset=""classic""");
	Ожидаем.Что(Один, "палитра тёмной").Содержит(".preview[data-preset=""classic""] > .preview__frame{color-scheme:dark;");
	Ожидаем.Что(Один, "палитра светлой")
		.Содержит("html[data-theme=""light""] .preview[data-preset=""classic""] > .preview__frame:not([data-theme=""dark""]),");
	Ожидаем.Что(Один, "фон кита 0.8").Содержит("--md-sys-color-surface:#171925;");
	Ожидаем.Что(СтрЧислоВхождений(Один, "color-scheme:"), "две темы одного пресета").Равно(2);
	Ожидаем.Что(СтрНайти(Один, "</div><style>") > 0 И СтрЗаканчиваетсяНа(Один, "</style></figure>"),
		"палитры — в конце фигуры").ЭтоИстина();

	Зеркальный = Кит.Образец("Пресет", Кит.Надпись("текст")).Пресет("material", "пресет").Рендер();
	Ожидаем.Что(Зеркальный, "зеркало признаком").Содержит("data-mirror-пресет=""material""");
	Ожидаем.Что(СтрЧислоВхождений(Зеркальный, "color-scheme:"), "палитры всех трёх").Равно(6);
	Ожидаем.Что(Зеркальный, "ключ — значение поля").Содержит(".preview[data-mirror-пресет=""oscript""] > .preview__frame{");
	Ожидаем.Что(СтрНайти(Зеркальный, "data-preset"), "без признака одного пресета").Равно(0);

	Отказ = "";
	Попытка
		Кит.Образец("x", Кит.Надпись("т")).Пресет("зелёный");
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Отказ, "чужой пресет").Содержит("пресета темы «зелёный» нет — есть classic, material, oscript");
	Ожидаем.Что(СтрНайти(Кит.Образец("x", Кит.Надпись("т")).Рендер(), "<style>"), "без слова — без палитр").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область ВыборЗначка

// Выбор значка без скрипта — радио-сетка: каждый значок обоих каталогов ячейкой с радиокнопкой
// имени поля, выбранный — checked; поиск печатается спрятанным и в отправку не входит.
&Тест
Процедура ВыборЗначкаПечатаетРадиоСетку() Экспорт

	HTML = Кит.Поле("значок", "Значок").ВыборЗначка().Значение("тег").Рендер();
	Ожидаем.Что(HTML, "группа полей").Содержит("<fieldset class=""field field--icons"" data-iconpicker=""Найдено: %1""><legend class=""field__label"">Значок</legend>");
	Ожидаем.Что(HTML, "выбранный — checked")
		.Содержит("<label class=""iconpicker__item"" title=""тег"" data-iconpicker-name=""тег""><input type=""radio"" class=""iconpicker__radio"" name=""значок"" value=""тег"" checked>");
	Ожидаем.Что(СтрЧислоВхождений(HTML, " checked"), "выбран один").Равно(1);
	Глифов = НайтиФайлы(ОбъединитьПути(ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..", "src"), "статика", "иконки"), "*.svg").Количество();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "class=""iconpicker__radio"""), "все глифы и все бренды")
		.Равно(Глифов + 11);
	Ожидаем.Что(HTML, "бренд — значением с приставкой и названием в поиске")
		.Содержит("title=""Telegram"" data-iconpicker-name=""бренд:telegram telegram""><input type=""radio"" class=""iconpicker__radio"" name=""значок"" value=""бренд:telegram"">");
	Ожидаем.Что(HTML, "разделы").Содержит("aria-label=""Глифы"" data-iconpicker-group><p class=""iconpicker__title"" aria-hidden=""true"">Глифы</p>");
	Ожидаем.Что(СтрНайти(HTML, "aria-label=""Глифы""") < СтрНайти(HTML, "aria-label=""Бренды"""), "глифы, потом бренды").ЭтоИстина();
	Ожидаем.Что(HTML, "поиск спрятан, без имени и формы").Содержит("data-iconpicker-search hidden>");
	Поиск = МеждуМаркеров(HTML, "data-iconpicker-search hidden>", "</div>");
	Ожидаем.Что(СтрНайти(Поиск, "name="), "у строки поиска нет имени").Равно(0);
	Ожидаем.Что(Поиск, "и формы").Содержит("form=""""");
	Ожидаем.Что(HTML, "живая область счёта").Содержит("<p class=""visually-hidden"" aria-live=""polite"" data-iconpicker-found></p>");
	Ожидаем.Что(СтрНайти(HTML, "iconpicker__grid--none"), "без слова Пусто — без «без значка»").Равно(0);

КонецПроцедуры

// Слова выбора значка: разделы и их порядок, «без значка» первой ячейкой (выбран при пустом
// значении), узел Кит.ВыборЗначка — то же поле; чужой раздел — отказ с перечнем.
&Тест
Процедура СловаВыбораЗначка() Экспорт

	Бренды = Кит.ВыборЗначка("з", "Значок").Разделы("бренды").Пусто().Рендер();
	Ожидаем.Что(СтрНайти(Бренды, "aria-label=""Глифы"""), "только бренды").Равно(0);
	Ожидаем.Что(Бренды, "«без значка» — подпись словаря, выбран при пустом значении")
		.Содержит("<div class=""iconpicker__grid iconpicker__grid--none""><label class=""iconpicker__item"" title=""Без значка"" data-iconpicker-name=""без значка""><input type=""radio"" class=""iconpicker__radio"" name=""з"" value="""" checked>");
	Ожидаем.Что(Кит.ВыборЗначка("з", "Значок").Разделы("бренды").Пусто().Рендер(), "узел — то же поле")
		.Равно(Кит.Поле("з", "Значок").ВыборЗначка().Разделы("бренды").Пусто().Рендер());
	Порядок = Кит.ВыборЗначка("з").Разделы("бренды", "глифы").Рендер();
	Ожидаем.Что(СтрНайти(Порядок, "aria-label=""Бренды""") < СтрНайти(Порядок, "aria-label=""Глифы"""), "порядок разделов").ЭтоИстина();
	Ожидаем.Что(Кит.ВыборЗначка("з").Пусто("Нет").Рендер(), "своя подпись").Содержит("title=""Нет""");
	Ожидаем.Что(ОшибкаПечати(Кит.ВыборЗначка("з").Разделы("смайлики")), "чужой раздел")
		.Содержит("раздела значков «смайлики» нет у поля «з» — разделы выбора значка: «глифы», «бренды»");
	Ожидаем.Что(Кит.ВыборЗначка("з").Заблокировано().Рендер(), "заблокировано").Содержит("value=""тег"" disabled>");

КонецПроцедуры

// Вид выбранного — по правилам M3 выбранного: заливка secondary-container и кольцо primary;
// фокус — кольцо secondary; скрипт фильтрует по имени и пишет значок в зеркало.
&Тест
Процедура ВыборЗначкаВидИСкрипт() Экспорт

	Выбранный = ".iconpicker__item:has(> .iconpicker__radio:checked)";
	Ожидаем.Что(ОбъявлениеЛиста(Выбранный, "--_bg"), "заливка выбранного").Равно("var(--md-sys-color-secondary-container)");
	Ожидаем.Что(ОбъявлениеЛиста(Выбранный, "box-shadow"), "кольцо выбранного").Равно("inset 0 0 0 2px var(--md-sys-color-primary)");
	Ожидаем.Что(ОбъявлениеЛиста(".iconpicker__item:has(> .iconpicker__radio:focus-visible)", "outline"), "фокус")
		.Равно("3px solid var(--md-sys-color-secondary)");
	Ожидаем.Что(ОбъявлениеЛиста(".iconpicker__radio", "opacity"), "радиокнопка поверх значка невидима").Равно("0");
	Ожидаем.Что(ОбъявлениеЛиста(".iconpicker__item", "width"), "ячейка 40").Равно("40px");

	Скрипт = ТекстСкрипта();
	Ожидаем.Что(Скрипт, "фильтр по имени").Содержит("items[i].getAttribute('data-iconpicker-name').indexOf(q) >= 0");
	Ожидаем.Что(Скрипт, "счёт найденного шаблоном словаря").Содержит("(root.getAttribute('data-iconpicker') || '%1').replace('%1', String(found))");
	Ожидаем.Что(Скрипт, "зеркало значка").Содержит("function iconMirror(control, targets, attrTargets)");

КонецПроцедуры

#КонецОбласти

#Область СтраницаВхода

// П7 (слово владельца: «экран логина как на GitHub»): узкая колонка с шапкой — знак, h1 и
// подпись первым ребёнком, где бы ни стояло слово; без заголовка шапки нет.
&Тест
Процедура УзкаяСтраницаСШапкой() Экспорт

	HTML = Кит.УзкаяСтраница(Кит.Надпись("тело")).Шапка("/знак.svg", "Вход в Ромашку", "Проекты").Рендер();
	Ожидаем.Что(HTML, "колонка и шапка первой")
		.Содержит("<div class=""narrow""><div class=""narrow__head""><img src=""/знак.svg"" alt="""" height=""48""><h1>");
	Ожидаем.Что(СтрНайти(HTML, "<img") > 0 И СтрНайти(HTML, "src=""/знак.svg""") > 0 И СтрНайти(HTML, "height=""48""") > 0,
		"знак 48: " + HTML).ЭтоИстина();
	Ожидаем.Что(HTML, "заголовок и подпись").Содержит("<h1>Вход в Ромашку</h1><p class=""muted"">Проекты</p></div>");
	Ожидаем.Что(СтрНайти(HTML, "narrow__head") < СтрНайти(HTML, "тело"), "шапка до тела").ЭтоИстина();
	Отказ = "";
	Попытка
		Кит.УзкаяСтраница().Шапка("/знак.svg", "");
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Отказ, "без заголовка").Содержит("у шапки узкой страницы нет заголовка");
	Ожидаем.Что(ОбъявлениеЛиста(".narrow", "max-width"), "колонка 360").Равно("360px");
	Ожидаем.Что(ОбъявлениеЛиста(".narrow__head > h1", "font"), "заголовок headline-small").Равно("var(--type-headline-small)");
	Ожидаем.Что(ОбъявлениеЛиста(".stack", "gap"), "столбик кнопок — 8").Равно("var(--space-2)");
	Ожидаем.Что(ОбъявлениеЛиста(".narrow > :not(:first-child)", "margin-top"), "ритм колонки старше нулевого маргина рамки")
		.Равно("var(--space-4)");

КонецПроцедуры

// Разделитель: с текстом — текст посередине (читается), без — линия <hr>; примечание
// «рамка» и ссылка рядом с полем — новыми словами, прежние узлы те же.
&Тест
Процедура РазделительРамкаИСсылкаРядом() Экспорт

	Ожидаем.Что(Кит.Разделитель("или").Рендер(), "с текстом")
		.Равно("<div class=""divider""><span class=""divider__text"">или</span></div>");
	Ожидаем.Что(Кит.Разделитель().Рендер(), "без текста").Равно("<hr class=""divider"">");
	Ожидаем.Что(Кит.Разделитель("<b>").Рендер(), "текст экранирован").Содержит("&lt;b&gt;");
	Ожидаем.Что(Кит.Примечание("Нет аккаунта? ", Кит.Ссылка("/р", "Зарегистрироваться")).Вид("рамка").Рендер(), "рамка")
		.Равно("<p class=""note-frame"">Нет аккаунта? <a href=""/р"">Зарегистрироваться</a></p>");
	Пароль = Кит.Поле("пароль", "Пароль").Секрет();
	Прежнее = Пароль.Рендер();
	Ожидаем.Что(Кит.Поле("пароль", "Пароль").Секрет().СсылкаРядом("/вход/пароль", "Забыли пароль?").Рендер(), "ссылка до поля")
		.Равно("<div class=""field-aside""><a href=""/вход/пароль"" class=""field-aside__link"">Забыли пароль?</a>" + Прежнее + "</div>");
	Ожидаем.Что(ОбъявлениеЛиста(".field-aside__link", "align-self"), "ссылка справа").Равно("flex-end");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МенюСРубрикой()

	Разделы = Новый Массив();
	Разделы.Добавить(Новый Структура("Подпись, Адрес, Иконка, Рубрика", "Профиль", "/а/профиль", "аккаунт", ""));
	Разделы.Добавить(Новый Структура("Подпись, Адрес, Иконка, Рубрика", "Токены", "/а/токены", "ключ", "Доступ"));
	Возврат Новый Структура("Учётка, Разделы, ЗаголовокРазделов",
		Новый Структура("Логин, Роль", "мария", "участник"), Разделы, "Настройки аккаунта");

КонецФункции

Функция ОшибкаПечати(Знач Узел)

	Попытка
		Узел.Рендер();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция МеждуМаркеров(Знач Текст, Знач Начало, Знач Конец)

	Открытие = СтрНайти(Текст, Начало);
	Если Открытие = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Открытие + СтрДлина(Начало));
	Закрытие = СтрНайти(Хвост, Конец);
	Возврат ?(Закрытие = 0, Хвост, Лев(Хвост, Закрытие - 1));

КонецФункции

Функция ТекстСкрипта()

	Корень = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..");
	Текст = Новый ТекстовыйДокумент();
	Текст.Прочитать(ОбъединитьПути(Корень, "src", "статика", "oscript-ui.js"), КодировкаТекста.UTF8);
	Возврат Текст.ПолучитьТекст();

КонецФункции

Функция Правила()

	Если ПравилаЛиста = Неопределено Тогда
		ПравилаЛиста = Разбор.Правила(Разбор.ТекстБазовогоЛиста());
	КонецЕсли;
	Возврат ПравилаЛиста;

КонецФункции

// Значение свойства у правила базового листа с ровно этим селектором под ровно этими
// условиями; из нескольких побеждает последнее, как в каскаде. Нет — Неопределено.
Функция ОбъявлениеЛиста(Знач Селектор, Знач Свойство, Знач Условия = "")

	Результат = Неопределено;
	Для Каждого Правило Из Правила() Цикл
		Если Правило.Селектор = Селектор И Правило.Условия = Условия Тогда
			Значение = Правило.Объявления.Получить(Свойство);
			Если Значение <> Неопределено Тогда
				Результат = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
