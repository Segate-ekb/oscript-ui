// Слова дев-сборки 0.13.0-dev.9: выбор значка, пресеты темы, переключатель темы пилюлей и
// хвосты трека хаба ui-хвост-единообразие (П4, П6). Проверяется то, что ломается для
// человека: рубрика шторки читается соседней группой, два пути из пустоты не помещаются,
// пресет не держит контраст текста, а узлы без новых слов печатаются иначе, чем до сборки.

#Использовать "../"
#Использовать asserts

Перем Кит;    // Кит
Перем Набор;  // НаборКомпонентов
Перем Разбор; // РазборЛиста — сканер, читающий КОД листа
Перем ПравилаЛиста; // правила базового листа, разобранные однажды

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "РазборЛиста.os"), "РазборЛиста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Кит = Слой.Кит;
	Набор = Слой.Набор;
	Разбор = Новый РазборЛиста();

КонецПроцедуры

#Область РубрикаШторки

// П6: рубрика внутри группы шторки — ступенью ниже имени группы: кегль меньше, левый край —
// с текстом пунктов (дальше имени группы), цвет приглушённый. Разметка прежняя.
&Тест
Процедура РубрикаШторкиСтупеньюНижеИмениГруппы() Экспорт

	Ожидаем.Что(ОбъявлениеЛиста(".hubmenu__title", "font"), "имя группы — title-small")
		.Равно("var(--type-title-small)");
	Ожидаем.Что(ОбъявлениеЛиста(".hubmenu__rubric", "font"), "рубрика — label-medium")
		.Равно("var(--type-label-medium)");
	Ожидаем.Что(ОбъявлениеЛиста(".hubmenu__rubric", "color"), "рубрика приглушена")
		.Равно("var(--md-sys-color-on-surface-variant)");
	Ожидаем.Что(ОбъявлениеЛиста(".hubmenu__rubric", "padding"), "рубрика без значков — с полем пунктов")
		.Равно("var(--space-3) var(--space-4) var(--space-1)");
	Ожидаем.Что(ОбъявлениеЛиста(".hubmenu__rubric:has(+ .button > .icon)", "padding-left"),
		"рубрика пунктов со значком — с их текстом").Равно("calc(var(--space-4) + 24px + var(--space-3))");
	Ожидаем.Что(ОбъявлениеЛиста(".hubmenu .button .icon", "width"), "значок пункта — 24, на нём держится отступ рубрики")
		.Равно("24px");
	Ожидаем.Что(ОбъявлениеЛиста(".hubmenu .button", "gap"), "зазор значка и подписи пункта")
		.Равно("var(--space-3)");

	HTML = Набор.МенюХаба().Отрисовать(МенюСРубрикой()).Панель;
	Ожидаем.Что(HTML, "разметка рубрики прежняя").Содержит("<p class=""hubmenu__rubric"">Доступ</p>");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МенюСРубрикой()

	Разделы = Новый Массив();
	Разделы.Добавить(Новый Структура("Подпись, Адрес, Иконка, Рубрика", "Профиль", "/а/профиль", "аккаунт", ""));
	Разделы.Добавить(Новый Структура("Подпись, Адрес, Иконка, Рубрика", "Токены", "/а/токены", "ключ", "Доступ"));
	Возврат Новый Структура("Учётка, Разделы, ЗаголовокРазделов",
		Новый Структура("Логин, Роль", "мария", "участник"), Разделы, "Настройки аккаунта");

КонецФункции

Функция ОшибкаПечати(Знач Узел)

	Попытка
		Узел.Рендер();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция МеждуМаркеров(Знач Текст, Знач Начало, Знач Конец)

	Открытие = СтрНайти(Текст, Начало);
	Если Открытие = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Открытие + СтрДлина(Начало));
	Закрытие = СтрНайти(Хвост, Конец);
	Возврат ?(Закрытие = 0, Хвост, Лев(Хвост, Закрытие - 1));

КонецФункции

Функция ТекстСкрипта()

	Корень = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..");
	Текст = Новый ТекстовыйДокумент();
	Текст.Прочитать(ОбъединитьПути(Корень, "src", "статика", "oscript-ui.js"), КодировкаТекста.UTF8);
	Возврат Текст.ПолучитьТекст();

КонецФункции

Функция Правила()

	Если ПравилаЛиста = Неопределено Тогда
		ПравилаЛиста = Разбор.Правила(Разбор.ТекстБазовогоЛиста());
	КонецЕсли;
	Возврат ПравилаЛиста;

КонецФункции

// Значение свойства у правила базового листа с ровно этим селектором под ровно этими
// условиями; из нескольких побеждает последнее, как в каскаде. Нет — Неопределено.
Функция ОбъявлениеЛиста(Знач Селектор, Знач Свойство, Знач Условия = "")

	Результат = Неопределено;
	Для Каждого Правило Из Правила() Цикл
		Если Правило.Селектор = Селектор И Правило.Условия = Условия Тогда
			Значение = Правило.Объявления.Получить(Свойство);
			Если Значение <> Неопределено Тогда
				Результат = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
