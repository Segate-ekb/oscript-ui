// Находки аудита экранов против Material Design 3 (выпуск 0.13, дев-сборка 5): то, что лист
// кита обязан делать после них. Здесь — правила листа и скрипта, прочитанные разбором кода;
// как это выглядит и где проходит граница в пикселях, проверяет tests/браузер/облик-m3.js.

#Использовать "../"
#Использовать asserts

Перем Разбор;   // РазборЛиста
Перем Правила;  // Массив правил базового листа
Перем Кит;      // Кит

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Подготовить() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "РазборЛиста.os"), "РазборЛиста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");
	Кит = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы()).Кит;

	Разбор = Новый РазборЛиста();
	Правила = Разбор.Правила(Разбор.ТекстБазовогоЛиста());

КонецПроцедуры

#Область КарточкаОбъекта

// S1: в узкой карточке с плашкой и кнопкой имя сжималось до нуля — плашки и действия держали
// ширину, а имя с основой auto и min-width 0 отдавало им всё. Теперь имя сжимается последним
// и не уже девяти знаков, ряд переносится, а в узкой шапке плашки уходят строкой под имя.
&Тест
Процедура ИмяКарточкиОбъектаНеСжимаетсяВНоль() Экспорт

	ПроверитьОбъявления("", СтрРазделить(
		".objcard__head|flex-wrap|wrap;"
		+ ".objcard__head|container-type|inline-size;"
		+ ".objcard__name|display|block;"
		+ ".objcard__name|flex|1 1 0;"
		+ ".objcard__name|min-width|min(9ch, 100%);"
		+ ".objcard__name|white-space|nowrap;"
		+ ".objcard__name|text-overflow|ellipsis;"
		+ ".objcard__name|overflow|hidden;"
		+ ".objcard__chips|flex|none;"
		+ ".objcard__chips|flex-wrap|wrap;"
		+ ".objcard__actions|flex|none", ";"));

	ПроверитьОбъявления("@container (max-width: 28rem)", СтрРазделить(
		".objcard__chips|order|1;"
		+ ".objcard__chips|flex|1 0 100%", ";"));

	// прежнее правило ссылки внутри имени снято: многоточие ставит блок имени целиком
	Ожидаем.Что(ОбъявлениеЛиста(".objcard__name a", "text-overflow", ""), "многоточие — у имени, не у ссылки")
		.Равно(Неопределено);

	Скрипт = ТекстСкрипта();
	Начало = СтрНайти(Скрипт, "15. подсказка обрезанного имени");
	Ожидаем.Что(Начало, "у скрипта есть раздел подсказки обрезанного имени").Больше(0);
	Раздел = Сред(Скрипт, Начало);
	Ожидаем.Что(СтрНайти(Раздел, "closest('.objcard__name')"), "подсказка — у имени карточки объекта").Больше(0);
	Ожидаем.Что(СтрНайти(Раздел, "name.scrollWidth > name.clientWidth"), "только у обрезанного имени").Больше(0);

КонецПроцедуры

#КонецОбласти

#Область БлокКоманды

// S7: на 390 длинная команда держала ширину целиком, и кнопка «Копировать» уезжала за край
// блока. Код сжимается и рвёт строку без пробелов, кнопка держит ширину, на телефоне ряд
// переносится и кнопка встаёт под код.
&Тест
Процедура КнопкаКопированияНеУезжаетЗаКрай() Экспорт

	ПроверитьОбъявления("", СтрРазделить(
		".cmd code|flex|1 1 auto;"
		+ ".cmd code|min-width|0;"
		+ ".cmd code|overflow-wrap|anywhere;"
		+ ".cmd code|white-space|pre-wrap;"
		+ ".cmd .copy|flex|none", ";"));
	ПроверитьОбъявления("@media (max-width: 600px)", СтрРазделить(".cmd|flex-wrap|wrap", ";"));

КонецПроцедуры

#КонецОбласти

#Область Окно

// S2: окно в теле карточки или секции получало от правила ритма контейнера margin-top 16px
// и вставало у верхнего края экрана. Модальное окно центрирует margin: auto, и правило
// сильнее любого «контейнер > * + *» (два класса против одного).
&Тест
Процедура ОкноПоЦентруВЛюбомКонтейнере() Экспорт

	ПроверитьОбъявления("", СтрРазделить(".modal:modal|margin|auto", ";"));
	Для Каждого Контейнер Из СтрРазделить(".card__body,.section__body,.panel__body,.modal__body", ",") Цикл
		Ожидаем.Что(ОбъявлениеЛиста(Контейнер + " > * + *", "margin-top"), "ритм " + Контейнер
			+ " — маргином сверху, его и перебивает правило окна").Заполнено();
	КонецЦикла;

КонецПроцедуры


// S5: на телефоне любое окно вставало листом во весь экран — и подтверждение из поля и двух
// кнопок тоже. Базовое окно остаётся базовым (по центру, в экран без полей 16 px), листом
// встаёт окно со словом ВоВесьЭкран и окно с шагами. Ширина — базового диалога Material:
// 560 px, широкое — 640.
&Тест
Процедура ОкноНаТелефонеБазовоеАЛистомПоСлову() Экспорт

	ПроверитьОбъявления("", СтрРазделить(
		".modal|max-width|min(35rem, calc(100vw - var(--space-6)));"
		+ ".modal--wide|max-width|min(40rem, calc(100vw - var(--space-6)))", ";"));

	Телефон = "@media (max-width: 640px)";
	ПроверитьОбъявления(Телефон, СтрРазделить(
		".modal:modal|width|calc(100% - var(--space-6));"
		+ ".modal:modal|height|;"
		+ ".modal--full:modal|height|100%;"
		+ ".modal--full:modal|border-radius|0;"
		+ ".modal:modal:has([data-steps])|height|100%;"
		+ ".modal--full:modal .modal__actions|position|sticky;"
		+ ".modal:modal:has([data-steps]) .modal__actions|position|sticky;"
		+ ".modal:modal .modal__actions|position|", ";"));

	Короткое = Кит.Окно("Переименовать", Кит.Поле("name", "Название")).Якорь("p").Рендер();
	Ожидаем.Что(СтрНайти(Короткое, "<dialog class=""modal"" id=""p"""), "короткое окно — базовое: " + Короткое)
		.Больше(0);
	Лист = Кит.Окно("Подключить", Кит.Поле("url", "Адрес")).ВоВесьЭкран().Якорь("l").Рендер();
	Ожидаем.Что(СтрНайти(Лист, "<dialog class=""modal modal--full"" id=""l"""), "ВоВесьЭкран: " + Лист)
		.Больше(0);
	Широкое = Кит.Окно("Ключи", Кит.Примечание("т")).Широкое().ВоВесьЭкран().Якорь("k").Рендер();
	Ожидаем.Что(СтрНайти(Широкое, "<dialog class=""modal modal--wide modal--full"" id=""k"""),
		"Широкое — вид «широкое», и лист к нему: " + Широкое).Больше(0);
	Опасное = Кит.Подтверждение("Удалить?", "Насовсем").Форма("/x").Токен("т").ВоВесьЭкран().Якорь("u").Рендер();
	Ожидаем.Что(СтрНайти(Опасное, "modal--confirm modal--full"), "подтверждение тоже встаёт листом по слову: "
		+ Опасное).Больше(0);

	Попытка
		Кит.Карточка("Проект").ВоВесьЭкран();
		Отказ = "";
	Исключение
		Отказ = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Ожидаем.Что(Отказ, "во весь экран встаёт только окно").Содержит("во весь экран встаёт окно");

КонецПроцедуры

#КонецОбласти

#Область КарточкаВКарточке

// S6: на телефоне карточка в карточке съедала треть ширины: поле страницы 20, поле секции 20,
// кольцо и поле вложенной карточки 16 — содержимому оставалось около 270 из 390. На compact
// поля 16, а вложенная карточка, секция и карточка объекта — часть родителя: без тени, кольца,
// заливки и боковых полей, с чертой между соседями; таблица — без своей обводки.
&Тест
Процедура КарточкаВКарточкеНаТелефонеБезВложения() Экспорт

	Телефон = "@media (max-width: 600px)";
	ПроверитьОбъявления(Телефон, СтрРазделить(
		".wrap|padding-left|var(--space-4);"
		+ ".wrap|padding-right|var(--space-4);"
		+ ".card|padding|var(--space-4);"
		+ ".section|padding|var(--space-4);"
		+ ".card .table-scroll|border|0;"
		+ ".section .table-scroll|border|0", ";"));
	Для Каждого Внешняя Из СтрРазделить(".card,.section", ",") Цикл
		Для Каждого Вложенная Из СтрРазделить(".card,.section,.objcard", ",") Цикл
			Селектор = Внешняя + " " + Вложенная;
			ПроверитьОбъявления(Телефон, СтрРазделить(
				Селектор + "|box-shadow|none;"
				+ Селектор + "|background|transparent;"
				+ Селектор + "|padding|var(--space-3) 0 0;"
				+ Селектор + "|border-top|1px solid var(--md-sys-color-outline-variant)", ";"));
		КонецЦикла;
	КонецЦикла;

	// на широком экране вложенная карточка — карточка: правил вне телефона у неё нет
	Ожидаем.Что(ОбъявлениеЛиста(".card .card", "box-shadow"), "вне телефона вложенная карточка не меняется")
		.Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОбъявления(Знач Условия, Знач Ожидания)

	Для Каждого Ожидание Из Ожидания Цикл
		Части = СтрРазделить(Ожидание, "|");
		Значение = ОбъявлениеЛиста(Части[0], Части[1], Условия);
		Что = СокрЛП(Условия + " " + Части[0] + " { " + Части[1] + " }");
		Если Части[2] = "" Тогда
			Ожидаем.Что(Значение, Что + " — не объявлено").Равно(Неопределено);
		Иначе
			Ожидаем.Что(Значение, Что).Равно(Части[2]);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Значение свойства у правила базового листа с ровно этим селектором под ровно этими
// условиями (прелюдиями @-блоков через пробел; "" — вне блоков); из нескольких побеждает
// последнее, как в каскаде. Нет — Неопределено.
Функция ОбъявлениеЛиста(Знач Селектор, Знач Свойство, Знач Условия = "")

	Результат = Неопределено;
	Для Каждого Правило Из Правила Цикл
		Если Правило.Селектор = Селектор И Правило.Условия = Условия Тогда
			Значение = Правило.Объявления.Получить(Свойство);
			Если Значение <> Неопределено Тогда
				Результат = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТекстСкрипта()

	Корень = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..");
	Текст = Новый ТекстовыйДокумент();
	Текст.Прочитать(ОбъединитьПути(Корень, "src", "статика", "oscript-ui.js"), КодировкаТекста.UTF8);
	Возврат Текст.ПолучитьТекст();

КонецФункции

#КонецОбласти
