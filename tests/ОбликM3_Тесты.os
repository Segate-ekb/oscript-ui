// Находки аудита экранов против Material Design 3 (выпуск 0.13, дев-сборка 5): то, что лист
// кита обязан делать после них. Здесь — правила листа и скрипта, прочитанные разбором кода;
// как это выглядит и где проходит граница в пикселях, проверяет tests/браузер/облик-m3.js.

#Использовать "../"
#Использовать asserts

Перем Разбор;   // РазборЛиста
Перем Правила;  // Массив правил базового листа
Перем Кит;      // Кит
Перем Токены;   // ТокеныТемы

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Подготовить() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "РазборЛиста.os"), "РазборЛиста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");
	Кит = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы()).Кит;
	Токены = Новый ТокеныТемы();

	Разбор = Новый РазборЛиста();
	Правила = Разбор.Правила(Разбор.ТекстБазовогоЛиста());

КонецПроцедуры

#Область КарточкаОбъекта

// S1: в узкой карточке с плашкой и кнопкой имя сжималось до нуля — плашки и действия держали
// ширину, а имя с основой auto и min-width 0 отдавало им всё. Теперь имя сжимается последним
// и не уже девяти знаков, ряд переносится, а в узкой шапке плашки уходят строкой под имя.
&Тест
Процедура ИмяКарточкиОбъектаНеСжимаетсяВНоль() Экспорт

	ПроверитьОбъявления("", СтрРазделить(
		".objcard__head|flex-wrap|wrap;"
		+ ".objcard__head|container-type|inline-size;"
		+ ".objcard__name|display|block;"
		+ ".objcard__name|flex|1 1 0;"
		+ ".objcard__name|min-width|min(9ch, 100%);"
		+ ".objcard__name|white-space|nowrap;"
		+ ".objcard__name|text-overflow|ellipsis;"
		+ ".objcard__name|overflow|hidden;"
		+ ".objcard__chips|flex|none;"
		+ ".objcard__chips|flex-wrap|wrap;"
		+ ".objcard__actions|flex|none", ";"));

	ПроверитьОбъявления("@container (max-width: 28rem)", СтрРазделить(
		".objcard__chips|order|1;"
		+ ".objcard__chips|flex|1 0 100%", ";"));

	// прежнее правило ссылки внутри имени снято: многоточие ставит блок имени целиком
	Ожидаем.Что(ОбъявлениеЛиста(".objcard__name a", "text-overflow", ""), "многоточие — у имени, не у ссылки")
		.Равно(Неопределено);

	Скрипт = ТекстСкрипта();
	Начало = СтрНайти(Скрипт, "15. подсказка обрезанного имени");
	Ожидаем.Что(Начало, "у скрипта есть раздел подсказки обрезанного имени").Больше(0);
	Раздел = Сред(Скрипт, Начало);
	Ожидаем.Что(СтрНайти(Раздел, "closest('.objcard__name')"), "подсказка — у имени карточки объекта").Больше(0);
	Ожидаем.Что(СтрНайти(Раздел, "name.scrollWidth > name.clientWidth"), "только у обрезанного имени").Больше(0);

КонецПроцедуры

#КонецОбласти

#Область БлокКоманды

// S7: на 390 длинная команда держала ширину целиком, и кнопка «Копировать» уезжала за край
// блока. Код сжимается и рвёт строку без пробелов, кнопка держит ширину, на телефоне ряд
// переносится и кнопка встаёт под код.
&Тест
Процедура КнопкаКопированияНеУезжаетЗаКрай() Экспорт

	ПроверитьОбъявления("", СтрРазделить(
		".cmd code|flex|1 1 auto;"
		+ ".cmd code|min-width|0;"
		+ ".cmd code|overflow-wrap|anywhere;"
		+ ".cmd code|white-space|pre-wrap;"
		+ ".cmd .copy|flex|none", ";"));
	ПроверитьОбъявления("@media (max-width: 600px)", СтрРазделить(".cmd|flex-wrap|wrap", ";"));

КонецПроцедуры

#КонецОбласти

#Область Окно

// S2: окно в теле карточки или секции получало от правила ритма контейнера margin-top 16px
// и вставало у верхнего края экрана. Модальное окно центрирует margin: auto, и правило
// сильнее любого «контейнер > * + *» (два класса против одного).
&Тест
Процедура ОкноПоЦентруВЛюбомКонтейнере() Экспорт

	ПроверитьОбъявления("", СтрРазделить(".modal:modal|margin|auto", ";"));
	Для Каждого Контейнер Из СтрРазделить(".card__body,.section__body,.panel__body,.modal__body", ",") Цикл
		Ожидаем.Что(ОбъявлениеЛиста(Контейнер + " > * + *", "margin-top"), "ритм " + Контейнер
			+ " — маргином сверху, его и перебивает правило окна").Заполнено();
	КонецЦикла;

КонецПроцедуры


// S5: на телефоне любое окно вставало листом во весь экран — и подтверждение из поля и двух
// кнопок тоже. Базовое окно остаётся базовым (по центру, в экран без полей 16 px), листом
// встаёт окно со словом ВоВесьЭкран и окно с шагами. Ширина — базового диалога Material:
// 560 px, широкое — 640.
&Тест
Процедура ОкноНаТелефонеБазовоеАЛистомПоСлову() Экспорт

	ПроверитьОбъявления("", СтрРазделить(
		".modal|max-width|min(35rem, calc(100vw - var(--space-6)));"
		+ ".modal--wide|max-width|min(40rem, calc(100vw - var(--space-6)))", ";"));

	Телефон = "@media (max-width: 640px)";
	ПроверитьОбъявления(Телефон, СтрРазделить(
		".modal:modal|width|calc(100% - var(--space-6));"
		+ ".modal:modal|height|;"
		+ ".modal--full:modal|height|100%;"
		+ ".modal--full:modal|border-radius|0;"
		+ ".modal:modal:has([data-steps])|height|100%;"
		+ ".modal--full:modal .modal__actions|position|sticky;"
		+ ".modal:modal:has([data-steps]) .modal__actions|position|sticky;"
		+ ".modal:modal .modal__actions|position|", ";"));

	Короткое = Кит.Окно("Переименовать", Кит.Поле("name", "Название")).Якорь("p").Рендер();
	Ожидаем.Что(СтрНайти(Короткое, "<dialog class=""modal"" id=""p"""), "короткое окно — базовое: " + Короткое)
		.Больше(0);
	Лист = Кит.Окно("Подключить", Кит.Поле("url", "Адрес")).ВоВесьЭкран().Якорь("l").Рендер();
	Ожидаем.Что(СтрНайти(Лист, "<dialog class=""modal modal--full"" id=""l"""), "ВоВесьЭкран: " + Лист)
		.Больше(0);
	Широкое = Кит.Окно("Ключи", Кит.Примечание("т")).Широкое().ВоВесьЭкран().Якорь("k").Рендер();
	Ожидаем.Что(СтрНайти(Широкое, "<dialog class=""modal modal--wide modal--full"" id=""k"""),
		"Широкое — вид «широкое», и лист к нему: " + Широкое).Больше(0);
	Опасное = Кит.Подтверждение("Удалить?", "Насовсем").Форма("/x").Токен("т").ВоВесьЭкран().Якорь("u").Рендер();
	Ожидаем.Что(СтрНайти(Опасное, "modal--confirm modal--full"), "подтверждение тоже встаёт листом по слову: "
		+ Опасное).Больше(0);

	Попытка
		Кит.Карточка("Проект").ВоВесьЭкран();
		Отказ = "";
	Исключение
		Отказ = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Ожидаем.Что(Отказ, "во весь экран встаёт только окно").Содержит("во весь экран встаёт окно");

КонецПроцедуры

#КонецОбласти

#Область КарточкаВКарточке

// S6: на телефоне карточка в карточке съедала треть ширины: поле страницы 20, поле секции 20,
// кольцо и поле вложенной карточки 16 — содержимому оставалось около 270 из 390. На compact
// поля 16, а вложенная карточка, секция и карточка объекта — часть родителя: без тени, кольца,
// заливки и боковых полей, с чертой между соседями; таблица — без своей обводки.
&Тест
Процедура КарточкаВКарточкеНаТелефонеБезВложения() Экспорт

	Телефон = "@media (max-width: 600px)";
	ПроверитьОбъявления(Телефон, СтрРазделить(
		".wrap|padding-left|var(--space-4);"
		+ ".wrap|padding-right|var(--space-4);"
		+ ".card|padding|var(--space-4);"
		+ ".section|padding|var(--space-4);"
		+ ".card .table-scroll|border|0;"
		+ ".section .table-scroll|border|0", ";"));
	Для Каждого Внешняя Из СтрРазделить(".card,.section", ",") Цикл
		Для Каждого Вложенная Из СтрРазделить(".card,.section,.objcard", ",") Цикл
			Селектор = Внешняя + " " + Вложенная;
			ПроверитьОбъявления(Телефон, СтрРазделить(
				Селектор + "|box-shadow|none;"
				+ Селектор + "|background|transparent;"
				+ Селектор + "|padding|var(--space-3) 0 0;"
				+ Селектор + "|border-top|1px solid var(--md-sys-color-outline-variant)", ";"));
		КонецЦикла;
	КонецЦикла;

	// на широком экране вложенная карточка — карточка: заливка, скругление и поля свои; тени
	// своей у неё нет (аудит M3 №11, дев-сборка 8) — только кольцо
	Ожидаем.Что(ОбъявлениеЛиста(".card .card", "box-shadow"), "вне телефона вложенная карточка — с кольцом")
		.Равно("var(--elevation-ring)");
	Ожидаем.Что(ОбъявлениеЛиста(".card .card", "background"), "вне телефона заливка своя").Равно(Неопределено);

КонецПроцедуры

#КонецОбласти

#Область РамкаПоля

// S3: рамка поля цвета outline-variant давала с заливкой поля и с карточкой 1.2–1.8:1, и в
// светлой теме поле на карточке почти пропадало. Рамка — роль outline: не меньше 3:1 с
// заливкой поля, поверхностью карточки и страницей в обеих темах; в фокусе — 2px primary,
// у поля с отказом — error. Замер — по токенам темы по умолчанию (любой акцент проверяет
// ТемаMaterial_Тесты.ПарыРолейЧитаемыПриЛюбомАкценте).
&Тест
Процедура РамкаПоляКонтрастнаВОбеихТемах() Экспорт

	ПроверитьОбъявления("", СтрРазделить(
		".field__control|border|1px solid var(--md-sys-color-outline);"
		+ ".field__control:focus|border-color|var(--_line);"
		+ ".field__control:focus|box-shadow|inset 0 0 0 1px var(--_line);"
		+ ".field__control|--_line|var(--md-sys-color-primary);"
		+ ".field--error .field__control|--_line|var(--md-sys-color-error);"
		+ ".field--error .field__control|border-color|var(--md-sys-color-error)", ";"));

	Провалы = Новый Массив();
	Для Каждого Тема Из СтрРазделить("тёмная,светлая", ",") Цикл
		Цвета = ЦветаТемы(Тема);
		Рамка = Цвета.Получить("--md-sys-color-outline");
		Карточка = ?(Тема = "тёмная", "surface-container", "surface-container-low");
		Для Каждого Фон Из СтрРазделить("surface-container-highest," + Карточка + ",surface", ",") Цикл
			Контраст = Токены.КоэффициентКонтраста(Рамка, Цвета.Получить("--md-sys-color-" + Фон));
			Если Контраст < 3 Тогда
				Провалы.Добавить(СтрШаблон("%1: рамка на %2 — %3", Тема, Фон, Окр(Контраст, 2)));
			КонецЕсли;
		КонецЦикла;
		Было = Токены.КоэффициентКонтраста(Цвета.Получить("--md-sys-color-outline-variant"),
			Цвета.Получить("--md-sys-color-surface-container-highest"));
		Ожидаем.Что(Было < 3, Тема + ": прежняя рамка outline-variant и правда не видна (" + Окр(Было, 2) + ")")
			.ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Провалы, Символы.ПС), "рамка поля ≥ 3:1").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СсылкиВТексте

// S4: ссылку в тексте отличал от текста только цвет — 2.67:1 в светлой и 1.32:1 в тёмной
// теме при норме 3:1. Ссылка без класса в тексте подчёркнута всегда; ссылки-компоненты,
// ячейки таблиц и имя карточки объекта — нет.
&Тест
Процедура СсылкаВТекстеПодчёркнута() Экспорт

	Для Каждого Место Из СтрРазделить("p,li,dd,blockquote,figcaption,.card__lead,.section__lead,.modal__lead,"
			+ ".field__hint,.cmd__note,.toast", ",") Цикл
		ПроверитьОбъявления("", СтрРазделить(
			Место + " a:not([class])|text-decoration|underline;"
			+ Место + " a:not([class])|text-underline-offset|.2em", ";"));
	КонецЦикла;
	ПроверитьОбъявления("", СтрРазделить("a|text-decoration|none", ";"));
	ПроверитьОбъявления("", СтрРазделить("nav li a:not([class])|text-decoration|none", ";"));
	Для Каждого Место Из СтрРазделить("td,.objcard__name,.prose", ",") Цикл
		Ожидаем.Что(ОбъявлениеЛиста(Место + " a:not([class])", "text-decoration"), Место + ": ссылка не в тексте")
			.Равно(Неопределено);
	КонецЦикла;

	// доказательство, что цветом не обойтись: primary к тексту в обеих темах ниже 3:1
	Для Каждого Тема Из СтрРазделить("тёмная,светлая", ",") Цикл
		Цвета = ЦветаТемы(Тема);
		Контраст = Токены.КоэффициентКонтраста(Цвета.Получить("--md-sys-color-primary"),
			Цвета.Получить("--md-sys-color-on-surface"));
		Ожидаем.Что(Контраст < 3, Тема + ": primary к тексту " + Окр(Контраст, 2) + " — цвет не отличает ссылку")
			.ЭтоИстина();
	КонецЦикла;

	Примечание = Кит.Примечание("в разделе ", Кит.Ссылка("/доступ", "доступ"), ".").Рендер();
	Ожидаем.Что(СтрНайти(Примечание, "<a href=""/доступ"">"), "ссылка в примечании — без класса: " + Примечание)
		.Больше(0);
	Ожидаем.Что(СтрНайти(Примечание, "<p"), "примечание — абзац: " + Примечание).Равно(1);

КонецПроцедуры

#КонецОбласти

#Область ЦелиКасания

// S8: на касании цели меньше 48 — кнопка-значок 36 и 32, крестик плашки списка 24, кружок
// акцента 44, ссылка в ячейке таблицы 16–18. Видимый размер — решение плотности, область
// касания расширяет невидимый псевдоэлемент 48×48 под (pointer: coarse); «?» подсказки
// расширен всегда. Мышью всё как было.
&Тест
Процедура ЦелиКасанияНеМеньше48НаКасании() Экспорт

	Касание = "@media (pointer: coarse)";
	Для Каждого Цель Из СтрРазделить(".button--icon::after,.chips-in__remove::before,.swatches__item::after", ",") Цикл
		ПроверитьОбъявления(Касание, СтрРазделить(
			Цель + "|width|48px;"
			+ Цель + "|height|48px;"
			+ Цель + "|position|absolute;"
			+ Цель + "|transform|translate(-50%, -50%)", ";"));
		Ожидаем.Что(ОбъявлениеЛиста(Цель, "width"), Цель + " мышью не расширяется").Равно(Неопределено);
	КонецЦикла;
	ПроверитьОбъявления(Касание, СтрРазделить(
		"td > a:only-child:not([class])|min-height|48px;"
		+ ".chips-in__remove|position|relative", ";"));
	ПроверитьОбъявления("", СтрРазделить(
		".help::before|inset|-12px;"
		+ ".help|width|24px;"
		+ ".button--icon|width|36px;"
		+ ".button--icon.button--sm|width|32px", ";"));
	// у кнопки ::before занят индикатором занятости — область касания не на нём
	ПроверитьОбъявления("", СтрРазделить(".button--busy::before|content|""""", ";"));

КонецПроцедуры

#КонецОбласти

#Область ЗаголовкиГруппНавигации

// S10: рубрики колонки разделов и шторки печатались label-medium прописными — стиль M2; в
// шторке рядом стоял заголовок группы title-small. Заголовок секции ящика навигации M3 —
// title-small обычным регистром.
&Тест
Процедура РубрикиНавигацииОбычнымРегистром() Экспорт

	Для Каждого Рубрика Из СтрРазделить(".tree__rubric,.hubmenu__rubric", ",") Цикл
		ПроверитьОбъявления("", СтрРазделить(
			Рубрика + "|font|var(--type-title-small);"
			+ Рубрика + "|letter-spacing|var(--md-sys-typescale-title-small-tracking);"
			+ Рубрика + "|text-transform|;"
			+ Рубрика + "|color|var(--md-sys-color-on-surface-variant)", ";"));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ПробелыХаба

// Пробел dev.4 п. 5: три сегмента с подписями в два слова на 390 резались многоточием. На
// телефоне группа — во всю ширину равными колонками (не уже самого длинного слова подписи —
// дев-сборка 7), подпись переносится во вторую строку.
&Тест
Процедура СегментыНаТелефонеБезМноготочия() Экспорт

	Телефон = "@media (max-width: 600px)";
	ПроверитьОбъявления(Телефон, СтрРазделить(
		".segments|display|grid;"
		+ ".segments|grid-auto-columns|minmax(min-content, 1fr);"
		+ ".segments|width|100%;"
		+ ".segments__text|white-space|normal;"
		+ ".segments__text|text-overflow|clip", ";"));
	ПроверитьОбъявления("", СтрРазделить(".segments__text|text-overflow|ellipsis", ";"));

КонецПроцедуры

// Пробел dev.4 п. 14: у тумблера не было слова Источник — приложение печатало источник
// своим абзацем крупнее подсказки — и справки «?», как у поля. Без новых слов разметка
// тумблера прежняя байт в байт.
&Тест
Процедура ТумблерСИсточникомИСправкой() Экспорт

	Прежний = Кит.Тумблер("a", "Письма").Подсказка("владельцам").Рендер();
	Ожидаем.Что(Прежний, "без новых слов — прежняя разметка").Равно("<div class=""toggle""><label class=""toggle__box"">"
		+ "<input type=""checkbox"" class=""toggle__input"" name=""a"" value=""1"">"
		+ "<span class=""toggle__track"" aria-hidden=""true""><span class=""toggle__thumb""></span></span>"
		+ "<span class=""toggle__text""><span class=""toggle__label"">Письма</span></span></label>"
		+ "<input type=""hidden"" name=""a"" value=""0""><span class=""toggle__hint"">владельцам</span></div>");

	СИсточником = Кит.Тумблер("a", "Письма").Подсказка("владельцам").Источник("по умолчанию · mail.on").Рендер();
	Ожидаем.Что(СИсточником, "источник — мелко справа в строке подсказки").Содержит(
		"<span class=""toggle__hint toggle__hint--origin"">владельцам<span class=""field__origin"">по умолчанию · mail.on</span></span>");

	СоСправкой = Кит.Тумблер("a", "Письма").Справка("Уходит после трёх сбоев <подряд>").Рендер();
	Ожидаем.Что(СтрНачинаетсяС(СоСправкой, "<div class=""field-help""><div class=""toggle"">"), "обёртка справки: " + СоСправкой)
		.ЭтоИстина();
	Ожидаем.Что(СоСправкой, "тумблер ссылается на справку").Содержит("class=""toggle__input"" name=""a"" value=""1"" aria-describedby=""help-a"">");
	Ожидаем.Что(СоСправкой, "«?» открывает поповер").Содержит("<button type=""button"" class=""help"" popovertarget=""help-a"">");
	Ожидаем.Что(СоСправкой, "текст справки экранирован").Содержит("<span class=""help__pop"" id=""help-a"" popover>Уходит после трёх сбоев &lt;подряд&gt;</span>");
	Ожидаем.Что(СтрНайти(СоСправкой, "</label>") < СтрНайти(СоСправкой, "<button"), "«?» — вне метки тумблера").ЭтоИстина();

	ПроверитьОбъявления("", СтрРазделить(
		".toggle__hint--origin|display|flex;"
		+ ".field-help:has(> .toggle) > .help|position|static", ";"));

КонецПроцедуры

// Пробел dev.4 п. 15: у поля не было метки только для скринридера — строке поиска доступное
// имя давал пример (placeholder). Слово СкрытаяМетка печатает метку visually-hidden: поле
// садится как поле без метки, имя — от метки. Без слова разметка прежняя.
&Тест
Процедура МеткаПоляТолькоДляСкринридера() Экспорт

	Видимая = Кит.Поле("q", "Поиск по проектам").Пример("Имя проекта").Рендер();
	Ожидаем.Что(Видимая, "без слова — прежняя метка").Содержит("<span class=""field__label"">Поиск по проектам</span>");

	Скрытая = Кит.Поле("q", "Поиск по проектам").Пример("Имя проекта").СкрытаяМетка().Рендер();
	Ожидаем.Что(Скрытая, "метка — только для скринридера").Содержит("<label class=""field""><span class=""visually-hidden"">Поиск по проектам</span><input");
	Ожидаем.Что(СтрНайти(Скрытая, "field__label"), "видимой метки нет — поле садится как без метки").Равно(0);
	Ожидаем.Что(Скрытая, "пример на месте").Содержит("placeholder=""Имя проекта""");

	Поиск = Кит.СтрокаПоиска("/проекты").Метка("Поиск по проектам").Пример("Имя").СкрытаяМетка().Кнопка("Найти").Рендер();
	Ожидаем.Что(Поиск, "строка поиска — тоже").Содержит("<span class=""visually-hidden"">Поиск по проектам</span>");
	Прежний = Кит.СтрокаПоиска("/проекты").Метка("Поиск по проектам").Кнопка("Найти").Рендер();
	Ожидаем.Что(Прежний, "строка поиска без слова — прежняя").Содержит("<span class=""field__label"">Поиск по проектам</span>");

	// поле без .field__label садится посередине — то же правило листа держит и скрытую метку
	ПроверитьОбъявления("", СтрРазделить(".field:is(:not(:has(> .field__label))) > .field__control|padding-top|10px", ";"));

КонецПроцедуры

// Пробел dev.4 п. 3: ответ тихой отправки 2xx без перенаправления, который печатает окно
// открытым, не ложился в открытое окно: морфинг держит открытость за браузером. После
// морфинга скрипт сверяет окна с ответом: окно ответа поднимает, лишние закрывает.
// Поведение проверяет tests/браузер/облик-m3.js (окно ответа).
&Тест
Процедура ОкнаОтветаТихойОтправкиЛожатсяНаСтраницу() Экспорт

	Скрипт = ТекстСкрипта();
	Приземление = Сред(Скрипт, СтрНайти(Скрипт, "function land(form, submitter, response, html) {"));
	Приземление = Лев(Приземление, СтрНайти(Приземление, Символы.ПС + "	}" + Символы.ПС));
	Ожидаем.Что(СтрНайти(Приземление, "settleWindows(next);") > СтрНайти(Приземление, "morphChildren(doc.body, next.body);"),
		"окна сверяются с ответом после морфинга страницы").ЭтоИстина();
	Сверка = Сред(Скрипт, СтрНайти(Скрипт, "function settleWindows(next) {"));
	Сверка = Лев(Сверка, СтрНайти(Сверка, Символы.ПС + "	}" + Символы.ПС));
	Для Каждого Шаг Из СтрРазделить("dialog.modal[open][id],d.close(),showModal(),lift(),d.matches(SHELL)", ",") Цикл
		Ожидаем.Что(СтрНайти(Сверка, Шаг), "в сверке окон есть " + Шаг).Больше(0);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьОбъявления(Знач Условия, Знач Ожидания)

	Для Каждого Ожидание Из Ожидания Цикл
		Части = СтрРазделить(Ожидание, "|");
		Значение = ОбъявлениеЛиста(Части[0], Части[1], Условия);
		Что = СокрЛП(Условия + " " + Части[0] + " { " + Части[1] + " }");
		Если Части[2] = "" Тогда
			Ожидаем.Что(Значение, Что + " — не объявлено").Равно(Неопределено);
		Иначе
			Ожидаем.Что(Значение, Что).Равно(Части[2]);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Значение свойства у правила базового листа с ровно этим селектором под ровно этими
// условиями (прелюдиями @-блоков через пробел; "" — вне блоков); из нескольких побеждает
// последнее, как в каскаде. Нет — Неопределено.
Функция ОбъявлениеЛиста(Знач Селектор, Знач Свойство, Знач Условия = "")

	Результат = Неопределено;
	Для Каждого Правило Из Правила Цикл
		Если Правило.Селектор = Селектор И Правило.Условия = Условия Тогда
			Значение = Правило.Объявления.Получить(Свойство);
			Если Значение <> Неопределено Тогда
				Результат = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТекстСкрипта()

	Корень = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..");
	Текст = Новый ТекстовыйДокумент();
	Текст.Прочитать(ОбъединитьПути(Корень, "src", "статика", "oscript-ui.js"), КодировкаТекста.UTF8);
	Возврат Текст.ПолучитьТекст();

КонецФункции

// Объявления цветов темы: тёмная — блок :root, светлая — :root, перекрытый блоком
// html[data-theme="light"].
Функция ЦветаТемы(Знач Тема)

	Текст = Токены.Переменные(Неопределено);
	Граница = СтрНайти(Текст, "html[data-theme=");
	Результат = ОбъявленияБлока(Лев(Текст, Граница - 1));
	Если Тема = "светлая" Тогда
		Для Каждого КиЗ Из ОбъявленияБлока(Сред(Текст, Граница)) Цикл
			Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ОбъявленияБлока(Знач Блок)

	Результат = Новый Соответствие();
	Начало = СтрНайти(Блок, "{");
	Конец = СтрНайти(Блок, "}", НаправлениеПоиска.СКонца);
	Для Каждого Объявление Из СтрРазделить(Сред(Блок, Начало + 1, Конец - Начало - 1), ";", Ложь) Цикл
		Двоеточие = СтрНайти(Объявление, ":");
		Если Двоеточие > 0 Тогда
			Результат.Вставить(СокрЛП(Лев(Объявление, Двоеточие - 1)), СокрЛП(Сред(Объявление, Двоеточие + 1)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
