// Единое меню инсталляции: бургер узкой шапки, кнопка-учётка широкой и одна панель
// на обе ширины. Проверяется то, что ломается для человека: кнопка открывает не ту панель
// или не открывает ничего, сумма дел врёт, вошедшего не видно, разделы экрана пропали,
// в пункт не попасть пальцем, а движок без верхнего слоя оставляет мёртвые кнопки
// и страницу без навигации.

#Использовать "../"
#Использовать asserts

Перем Меню;         // МенюХаба — компонент кита словами пробной инсталляции
Перем БезСловаря;   // МенюХаба — тот же компонент с пустым словарём кита
Перем Разбор;       // РазборЛиста — сканер, читающий КОД листа, а не его текст
Перем Место;        // РаскладкаСтатики — где лежит базовый лист

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьМеню() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "РазборЛиста.os"), "РазборЛиста");

	Меню = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы()).Набор.МенюХаба();
	БезСловаря = Новый СборкаХолста().Собрать().Набор.МенюХаба();

	Разбор = Новый РазборЛиста();
	Место = Новый РаскладкаСтатики(Новый СтатикаИнсталляцииПоУмолчанию());

КонецПроцедуры

#Область ОднаПанельНаОбеШирины

// Панель в разметке ОДНА, и открывают её обе кнопки — бургер шапки и кнопка рейки.
// Разъедься идентификаторы — на одной из ширин меню перестало бы открываться совсем.
&Тест
Процедура ОбеОткрывашкиИКрестВедутВОднуПанель() Экспорт

	Части = Меню.Отрисовать(МодельМеню());
	Ид = ЗначениеАтрибута(ОткрывающийТег(Части.Панель, "div"), "id");

	Ожидаем.Что(Ид, "у панели свой идентификатор: " + Части.Панель).Заполнено();
	Ожидаем.Что(СтрНайти(Части.Панель, " popover>") > 0,
		"панель всплывающая — открытие, Esc и щелчок мимо делает движок: "
			+ Лев(Части.Панель, 120)).ЭтоИстина();

	Ожидаем.Что(ЗначениеАтрибута(ОткрывающийТег(Части.Бургер, "button"), "popovertarget"),
		"бургер шапки открывает эту панель: " + Части.Бургер).Равно(Ид);
	Ожидаем.Что(ЗначениеАтрибута(ОткрывающийТег(Части.Учётка, "button"), "popovertarget"),
		"и кнопка-учётка широкой шапки — её же: " + Части.Учётка).Равно(Ид);

	Крест = ОткрывающийТег(МеждуМаркеров(Части.Панель, "hubmenu__head", "</div>"), "button");
	Ожидаем.Что(ЗначениеАтрибута(Крест, "popovertarget"),
		"крест первой строкой закрывает её же: " + Крест).Равно(Ид);
	Ожидаем.Что(ЗначениеАтрибута(Крест, "aria-label"),
		"и называет себя словами инсталляции: " + Крест).Равно("Закрыть меню");

КонецПроцедуры

// Пункты живут в ОДНОМ месте: вторая копия в разметке разъехалась бы с первой на первой же
// правке, а весит столько же.
&Тест
Процедура ПунктыНапечатаныОдинРаз() Экспорт

	Части = Меню.Отрисовать(МодельМеню());
	Всё = Части.Бургер + Части.Учётка + Части.Панель;

	Ожидаем.Что(СтрЧислоВхождений(Всё, "/кабинет/уведомления"),
		"дело названо один раз — в панели: " + Всё).Равно(1);
	Ожидаем.Что(СтрЧислоВхождений(Всё, "href=""/пакеты"""),
		"и дорога один раз: в шапку её печатает каркас своим деревом").Равно(1);

КонецПроцедуры

// Меню инсталляции на странице ОДНО, и его разметка обязана быть одинаковой от запроса
// к запросу: порядковый номер в идентификаторе делал каждый ответ побайтово новым,
// и страница, которая должна отвечать «не изменилась», отвечала целой копией.
&Тест
Процедура МенюОтрисовываетсяПобайтовоОдинаково() Экспорт

	Первое = Меню.Отрисовать(МодельМеню());
	Второе = Меню.Отрисовать(МодельМеню());

	Ожидаем.Что(Второе.Панель, "панель дважды одна и та же").Равно(Первое.Панель);
	Ожидаем.Что(Второе.Бургер, "и бургер тоже").Равно(Первое.Бургер);
	Ожидаем.Что(Второе.Учётка, "и кнопка-учётка").Равно(Первое.Учётка);

	// идентификатор — это и есть контракт: он стоит в разметке и на него ссылаются обе
	// открывашки, поэтому сверяется значением, а не признаком «в нём нет цифры»
	Ид = ЗначениеАтрибута(ОткрывающийТег(Первое.Панель, "div"), "id");
	Ожидаем.Что(Ид, "идентификатор панели постоянен").Равно("hubmenu");

КонецПроцедуры

#КонецОбласти

#Область Содержимое

// Кнопка-учётка — та же, что у меню строки: имя вошедшего ТЕКСТОМ, число дел бейджем
// и шеврон раскрытия. Без шеврона она неотличима от хода по ссылке, и человек не знает,
// что она раскроется, а не уведёт со страницы.
&Тест
Процедура КнопкаУчёткиНесётИмяЧислоИШеврон() Экспорт

	Учётка = Меню.Отрисовать(МодельМеню()).Учётка;

	Ожидаем.Что(СтрНайти(Учётка, "<span>а.иванова</span>") > 0,
		"имя вошедшего видно глазом: " + Учётка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Учётка, ">5</span>") > 0,
		"сумма дел бейджем на ней же: " + Учётка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Учётка, "button__chevron") > 0,
		"и видимый признак раскрытия: " + Учётка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Учётка, "type=""button""") > 0,
		"кнопка ничего не отправляет: в шапке она стоит рядом с формой темы: "
			+ Учётка).ЭтоИстина();

КонецПроцедуры

// Гостю кнопки-учётки нет: панель ему нечем наполнить сверх того, что уже стоит в шапке,
// а кнопка с пустым именем — это кнопка в никуда. Бургер при этом остаётся: на телефоне
// полоса ходов спрятана, и дороги живут только в панели.
&Тест
Процедура ГостюКнопкиУчёткиНет() Экспорт

	Гость = МодельМеню();
	Гость.Вставить("Учётка", Неопределено);
	Части = Меню.Отрисовать(Гость);

	Ожидаем.Что(Части.Учётка, "открывашки-учётки у гостя нет").Равно("");
	Ожидаем.Что(Части.Бургер, "а бургер на месте").Заполнено();
	Ожидаем.Что(СтрНайти(Части.Панель, "href=""/пакеты""") > 0,
		"и дороги в панели тоже: " + Части.Панель).ЭтоИстина();

КонецПроцедуры

// Пустой слот — прежняя шапка: ни бургера, ни учётки, ни панели. Инсталляция, написанная
// до появления слота, ничего не теряет.
&Тест
Процедура ПустойСлотНеПечатаетНичего() Экспорт

	Пусто = Меню.Отрисовать(Новый Структура());

	Ожидаем.Что(Пусто.Бургер, "бургера нет").Равно("");
	Ожидаем.Что(Пусто.Учётка, "кнопки-учётки нет").Равно("");
	Ожидаем.Что(Пусто.Панель, "и панели нет").Равно("");
	Ожидаем.Что(Меню.Пустое(Неопределено), "слота нет вовсе — меню пустое").ЭтоИстина();
	Ожидаем.Что(Меню.Пустое(МодельМеню()), "а наполненный слот — не пустое").ЭтоЛожь();

КонецПроцедуры

// Сумма дел стоит НА БУРГЕРЕ — ради неё на кнопку смотрят, не открывая меню; в самом меню
// у каждого дела своё число, иначе непонятно, где именно тебя ждут.
&Тест
Процедура СуммаНаБургере_АУДелРаздельныеЧисла() Экспорт

	Части = Меню.Отрисовать(МодельМеню());
	Кнопка = ОткрывающийТег(Части.Бургер, "button");

	Ожидаем.Что(СтрНайти(Части.Бургер, ">5</span>") > 0,
		"сумма дел бейджем на бургере: " + Части.Бургер).ЭтоИстина();
	Ожидаем.Что(ЗначениеАтрибута(Кнопка, "aria-label"),
		"и она названа словами инсталляции: " + Кнопка).Равно("Меню, 5 дел");

	Ожидаем.Что(СтрНайти(Части.Панель, ">3</span>") > 0,
		"у дела своё число: " + Части.Панель).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Части.Панель, "3 непрочитанных") > 0,
		"и своя подпись для речи: " + Части.Панель).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Части.Панель, ">5</span>"),
		"а суммы в меню нет — она только на бургере").Равно(0);

КонецПроцедуры

// Блок вошедшего: кружок с первой буквой, логин, роль — и весь блок ведёт в кабинет.
&Тест
Процедура БлокУчёткиВедётВКабинетИПоказываетРоль() Экспорт

	Панель = Меню.Отрисовать(МодельМеню()).Панель;
	Блок = МеждуМаркеров(Панель, "<a href=""/личное"" class=""hubmenu__account""", "</a>");

	Ожидаем.Что(Блок, "блок учётки — ссылка в кабинет: " + Панель).Заполнено();
	Ожидаем.Что(СтрНайти(Блок, ">А</span>") > 0,
		"в кружке первая буква логина, заглавная: " + Блок).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Блок, "а.иванова") > 0, "рядом сам логин: " + Блок).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Блок, "администратор") > 0, "и роль словами: " + Блок).ЭтоИстина();

	// посетителю блока не печатают вовсе: логина нет — нечего и показывать
	Модель = МодельМеню();
	Модель.Вставить("Учётка", Новый Структура("Логин, Роль, Адрес", "", "", ""));
	Ожидаем.Что(СтрНайти(Меню.Отрисовать(Модель).Панель, "hubmenu__account"),
		"без логина блока учётки нет").Равно(0);

КонецПроцедуры

// Разделы ТЕКУЩЕГО экрана — отдельная секция меню: с телефона это единственный способ
// попасть в соседний раздел дома настроек. Пусто — секции нет, заголовок над пустотой
// обещал бы пункты, которых нет.
&Тест
Процедура РазделыЭкранаЕдутСвоейСекцией() Экспорт

	Модель = МодельМеню();
	Разделы = Новый Массив();
	Разделы.Добавить(Новый Структура("Подпись, Адрес, Иконка, Активен",
		"Общее", "/hub/settings", "шестерёнка", Истина));
	Разделы.Добавить(Новый Структура("Подпись, Адрес, Иконка", "Пулы", "/hub/settings/pools", "стопка"));
	Модель.Вставить("Разделы", Разделы);

	Панель = Меню.Отрисовать(Модель).Панель;

	Ожидаем.Что(СтрНайти(Панель, "aria-label=""Разделы экрана""") > 0,
		"секция разделов экрана названа: " + Панель).ЭтоИстина();
	// на широком её прячет лист — ИМЕННО по этому классу; потеряй разметка класс,
	// и разделы вернулись бы вторым списком к колонке, которая уже стоит на странице
	Ожидаем.Что(СтрНайти(Панель, "class=""hubmenu__section hubmenu__section--screen""") > 0,
		"и помечена классом, по которому её прячет широкий экран: " + Панель).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "href=""/hub/settings/pools""") > 0,
		"и несёт разделы страницы: " + Панель).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Панель, "aria-current=""true""") > 0,
		"активный раздел помечен: " + Панель).ЭтоИстина();

	Ожидаем.Что(СтрНайти(Меню.Отрисовать(МодельМеню()).Панель, "Разделы экрана"),
		"без разделов секции нет вовсе").Равно(0);

КонецПроцедуры

// Рубрики и подписи кнопок кит не сочиняет: их даёт словарь инсталляции. Нет ключа —
// на экране виден маркер, а не пустое место.
&Тест
Процедура ПодписиМенюПриходятИзСловаря() Экспорт

	СоСловарём = Меню.Отрисовать(МодельМеню());
	Пустой = БезСловаря.Отрисовать(МодельМеню());

	Ожидаем.Что(СтрНайти(СоСловарём.Панель, "Мои дела") > 0,
		"рубрика дел из словаря: " + СоСловарём.Панель).ЭтоИстина();
	Ожидаем.Что(СтрНайти(СоСловарём.Учётка, "title=""Меню""") > 0,
		"подсказка кнопки-учётки из словаря: " + СоСловарём.Учётка).ЭтоИстина();

	Ожидаем.Что(СтрНайти(Пустой.Панель, "[?chrome.menu.section.deeds]") > 0,
		"без ключа видно, ЧЕГО не хватает: " + Пустой.Панель).ЭтоИстина();
	Ожидаем.Что(ЗначениеАтрибута(ОткрывающийТег(Пустой.Бургер, "button"), "aria-label"),
		"и на бургере тоже").Равно("[?chrome.menu.open], 5 дел");

КонецПроцедуры

// Меню стоит на КАЖДОЙ странице инсталляции, поэтому недособранная модель обязана падать
// громко и называть поле контракта, а не рисовать пустую строку в навигации.
&Тест
Процедура НедособраннаяМодельОтвергаетсяСУказаниемПоля() Экспорт

	БезЛогина = МодельМеню();
	БезЛогина.Вставить("Учётка", Новый Структура("Логин, Роль, Адрес",
		"", "администратор", "/личное"));
	Отказ = ОтказМеню(БезЛогина);
	Ожидаем.Что(Отказ, "учётка без логина — исключение").Заполнено();
	Ожидаем.Что(СтрНайти(Отказ, "МенюХаба.Учётка.Логин") > 0,
		"отказ называет поле контракта: " + Отказ).ЭтоИстина();

	БезПодписи = МодельМеню();
	Пункты = Новый Массив();
	Пункты.Добавить(Новый Структура("Адрес, Иконка", "/пулы", "стопка"));
	БезПодписи.Вставить("Навигация", Пункты);
	Отказ = ОтказМеню(БезПодписи);
	Ожидаем.Что(Отказ, "пункт без подписи — исключение").Заполнено();
	Ожидаем.Что(СтрНайти(Отказ, "МенюХаба.Навигация") > 0,
		"и здесь отказ называет список контракта: " + Отказ).ЭтоИстина();

	// разделы экрана приходят не из слота, а от страницы — и проверяются так же строго
	БезПодписиРаздела = МодельМеню();
	Разделы = Новый Массив();
	Разделы.Добавить(Новый Структура("Адрес, Иконка", "/настройки/доступ", "замок"));
	БезПодписиРаздела.Вставить("Разделы", Разделы);
	Отказ = ОтказМеню(БезПодписиРаздела);
	Ожидаем.Что(СтрНайти(Отказ, "МенюХаба.Разделы[1]") > 0,
		"отказ называет номер и список, а не компонент кнопки: " + Отказ).ЭтоИстина();

	// число без подписи скринридер прочитает голой цифрой — и на бургере, и у пункта
	СуммаБезПодписи = МодельМеню();
	СуммаБезПодписи.Вставить("ПодписьСчётчика", "");
	Отказ = ОтказМеню(СуммаБезПодписи);
	Ожидаем.Что(СтрНайти(Отказ, "МенюХаба.ПодписьСчётчика") > 0,
		"пара «число — подпись» стережётся у суммы: " + Отказ).ЭтоИстина();

	ДелоБезПодписи = МодельМеню();
	Дела = Новый Массив();
	Дела.Добавить(Новый Структура("Подпись, Адрес, Счётчик", "Заявки", "/заявки", 7));
	ДелоБезПодписи.Вставить("Дела", Дела);
	Отказ = ОтказМеню(ДелоБезПодписи);
	Ожидаем.Что(СтрНайти(Отказ, "МенюХаба.Дела[1].ПодписьСчётчика") > 0,
		"и у числа пункта — с адресом самого пункта: " + Отказ).ЭтоИстина();

	// учётки нет вовсе — это не поломка: меню просто собирается без блока вошедшего
	БезУчётки = МодельМеню();
	БезУчётки.Вставить("Учётка", Неопределено);
	Ожидаем.Что(ОтказМеню(БезУчётки), "без учётки меню собирается молча").Равно("");

	// ноль дел — не число: ноль и пусто не печатаются, и подписи им не нужно
	Нулевая = МодельМеню();
	Нулевая.Вставить("Счётчик", 0);
	Нулевая.Вставить("ПодписьСчётчика", "");
	Ожидаем.Что(ОтказМеню(Нулевая), "нулевая сумма подписи не требует").Равно("");

КонецПроцедуры

// Логин и роль приходят из данных, поэтому экранируются, как любой чужой текст.
&Тест
Процедура ИмяВошедшегоЭкранируется() Экспорт

	Модель = МодельМеню();
	Модель.Вставить("Учётка", Новый Структура("Логин, Роль, Адрес",
		"ev<il>&", "<b>админ</b>", "/личное"));

	Панель = Меню.Отрисовать(Модель).Панель;

	Ожидаем.Что(СтрНайти(Панель, "<il>"), "сырых скобок нет: " + Панель).Равно(0);
	Ожидаем.Что(СтрНайти(Панель, "<b>админ"), "и в роли тоже: " + Панель).Равно(0);
	Ожидаем.Что(СтрНайти(Панель, "&lt;il&gt;") > 0, "логин экранирован: " + Панель).ЭтоИстина();

КонецПроцедуры

// Тема и выход пришиты к низу меню: инсталляция даёт их готовыми фрагментами, кит ставит
// их на место и ничего в них не правит.
&Тест
Процедура ТемаИВыходСтоятВПодвалеМеню() Экспорт

	Части = Меню.Отрисовать(МодельМеню());
	// подвал — весь хвост панели: внутри него есть свои закрывающие теги, и резать
	// по первому из них значило бы проверять только первую строку
	Подвал = Сред(Части.Панель, СтрНайти(Части.Панель, "hubmenu__foot"));

	Ожидаем.Что(СтрНайти(Подвал, "action=""/вид""") > 0,
		"переключатель темы в подвале меню: " + Подвал).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Подвал, "hubmenu__theme") > 0,
		"он стоит своей строкой — её лист прячет на широком: " + Подвал).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Подвал, "action=""/выход""") > 0,
		"и форма выхода рядом: " + Подвал).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Части.Учётка, "action=""/вид"""),
		"а на кнопке-учётке переключателя нет — он стоит в самой шапке").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Лист

// Класс, у которого правило есть только внутри @media, для потребителя не существует:
// его сканеры такое правило не видят, а на широком экране элемент остаётся неоформленным.
&Тест
Процедура КаждыйКлассМенюИмеетПравилоВнеМедиа() Экспорт

	Классы = КлассыМеню();
	Правила = Разбор.Правила(ТекстЛиста());

	Ожидаем.Что(Классы.Количество() >= 7,
		"классов у меню: " + Классы.Количество() + " — скан ослеп").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Разбор.КлассыБезБазовогоПравила(Классы, Правила), ", "),
		"классы меню, у которых правило есть только в @media").Равно("");

КонецПроцедуры

// Урок шторки: кнопка, которой нечего открыть, — мёртвая кнопка. Обе открывашки видны
// ровно там, где движок знает верхний слой.
&Тест
Процедура ОткрывашкиВидныТолькоПриРабочемВерхнемСлое() Экспорт

	Лишние = Новый Массив();
	Показанных = 0;

	Для Каждого Класс Из СтрРазделить("hubmenu__opener,hubmenu__user,hubmenu__close", ",") Цикл
		Для Каждого Правило Из ПравилаКласса(Класс) Цикл

			Если НЕ Разбор.СелекторСтилизуетКласс(Правило.Селектор, Класс)
				ИЛИ НЕ Показывает(Правило) Тогда
				Продолжить;
			КонецЕсли;

			Показанных = Показанных + 1;
			Если НЕ Разбор.ТребуетВерхнегоСлоя(Правило.Условия) Тогда
				Лишние.Добавить(Правило.Селектор + " {" + Правило.Условия + "}");
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Показанных, "все три открывашки где-то показываются").Равно(3);
	Ожидаем.Что(СтрСоединить(Лишние, ", "),
		"правила, показывающие открывашку там, где она ничего не откроет").Равно("");

КонецПроцедуры

// Движок без верхнего слоя до @supports не доходит: для него панель — обычный блок
// в потоке. Спрячь её там — и вся навигация инсталляции пропадёт со страницы разом.
&Тест
Процедура БезВерхнегоСлояПанельОстаётсяВПотоке() Экспорт

	Показ = "";
	Последнее = "";

	Для Каждого Правило Из ПравилаКласса("hubmenu") Цикл

		Если Разбор.ТребуетВерхнегоСлоя(Правило.Условия)
			ИЛИ НЕ ЭтоСамаПанель(Правило.Селектор)
			ИЛИ Правило.Объявления.Получить("display") = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Показ = Правило.Объявления.Получить("display");
		Последнее = Правило.Селектор + " {" + Правило.Условия + "}";

	КонецЦикла;

	Ожидаем.Что(Показ, "панель объявлена видимой и без верхнего слоя").Заполнено();
	Ожидаем.Что(НРег(Показ),
		"последнее слово о показе панели без верхнего слоя говорит " + Последнее)
		.ЭтоНе().Равно("none");

КонецПроцедуры

// Дел, дорог и разделов у инсталляции больше, чем влезает в высоту экрана. Не прокручивайся
// панель сама — нижние пункты недостижимы: до них не дотянуться ни пальцем, ни клавишей,
// а страница за ними не едет.
&Тест
Процедура ОткрытаяПанельПрокручиваетсяСама() Экспорт

	Ожидаем.Что(Прокрутка("hubmenu", Истина),
		"вертикальная прокрутка открытой панели").ЭтоИстина();

КонецПроцедуры

// Полоса ходов — единственный вход в навигацию на широком экране, пока панель закрыта.
// Спрячь её на любом куске десктопных ширин — и на ноутбуке человек останется без дорог.
// Считается ВЕСЬ каскад: последнее слово может сказать и правило под своим условием.
&Тест
Процедура НаЛюбойШирокойШиринеПолосаХодовВидна() Экспорт

	Показ = "";
	Последнее = "";

	Для Каждого Правило Из ПравилаКласса("top__nav") Цикл

		Если Разбор.УзкийЭкран(Правило.Условия)
			ИЛИ НЕ Разбор.СелекторСтилизуетКласс(Правило.Селектор, "top__nav")
			ИЛИ Правило.Объявления.Получить("display") = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Показ = Правило.Объявления.Получить("display");
		Последнее = Правило.Селектор + " {" + Правило.Условия + "}";

	КонецЦикла;

	Ожидаем.Что(Показ, "полоса ходов объявлена видимой на широком экране").Заполнено();
	Ожидаем.Что(НРег(Показ),
		"последнее слово о полосе ходов на широком говорит " + Последнее + " — и это «спрятана»")
		.ЭтоНе().Равно("none");

КонецПроцедуры

// Панель выпадает у кнопки, которая её открыла, — а кнопка стоит СПРАВА в шапке. Уедь
// панель влево, и меню окажется в другом конце экрана, чем нажатая кнопка: ровно это
// и увидел владелец, когда позиция держалась на привязке к якорю.
&Тест
Процедура НаШирокомПанельПрижатаКПравомуКраю() Экспорт

	Слева = "";
	Справа = "";
	Последнее = "";

	Для Каждого Правило Из ПравилаКласса("hubmenu") Цикл

		Если Разбор.УзкийЭкран(Правило.Условия) ИЛИ НЕ ЭтоСамаПанель(Правило.Селектор) Тогда
			Продолжить;
		КонецЕсли;

		// сокращённая запись переписывает обе стороны разом
		Если Правило.Объявления.Получить("inset") <> Неопределено Тогда
			Слева = СторонаИзInset(Правило.Объявления.Получить("inset"), 4);
			Справа = СторонаИзInset(Правило.Объявления.Получить("inset"), 2);
		КонецЕсли;

		Слева = ?(Правило.Объявления.Получить("left") = Неопределено,
			Слева, НРег(Правило.Объявления.Получить("left")));
		Если Правило.Объявления.Получить("right") <> Неопределено Тогда
			Справа = НРег(Правило.Объявления.Получить("right"));
			Последнее = Правило.Селектор + " {" + Правило.Условия + "}";
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(Справа, "правый край панели на широком экране задан " + Последнее).Заполнено();
	Ожидаем.Что(Справа, "и это не «как получится»").ЭтоНе().Равно("auto");
	Ожидаем.Что(Слева = "" ИЛИ Слева = "auto",
		"панель прижата и слева тоже («" + Слева + "») — уедет в другой конец экрана")
		.ЭтоИстина();

	// позиция не должна зависеть от привязки к якорю: её знают не все движки, и там,
	// где не знают, панель прилипала к левому верхнему углу
	Ожидаем.Что(СтрНайти(Справа, "anchor("),
		"позиция панели держится на якоре — движок без него положит её мимо кнопки").Равно(0);

КонецПроцедуры

// Знак инсталляции стоит в самой шапке, в двух шагах от кнопки: в выпадающем меню он
// не к месту — так и сказал владелец. Прячется он вместе со всей шапкой панели (там же
// живёт крест, которому на широком тоже нечего делать: закрывают меню Esc и щелчком мимо).
// На телефоне шторка занимает весь экран, и там знак с крестом первой строкой остаются.
&Тест
Процедура НаШирокомШапкаПанелиНеПечатается() Экспорт

	Ожидаем.Что(СпрятанНаШироком("hubmenu__head") ИЛИ СпрятанНаШироком("hubmenu__brand"),
		"на широком экране знак из панели убран").ЭтоИстина();
	Ожидаем.Что(СпрятанБезУсловий("hubmenu__head") ИЛИ СпрятанБезУсловий("hubmenu__brand"),
		"а на телефоне шапка панели остаётся: шторка занимает весь экран").ЭтоЛожь();

КонецПроцедуры

// Затемнение — признак «страница за этим сейчас не работает», и оно верно для шторки,
// которая накрывает телефон целиком. Выпадающее меню страницу не отнимает: прежнее меню
// учётки ничего не затемняло, и владелец потребовал того же.
&Тест
Процедура ЗатемнениеТемнитТолькоПодШторкой() Экспорт

	Узкое = "";
	Широкое = "";

	Для Каждого Правило Из ПравилаКласса("hubmenu") Цикл

		Если СтрНайти(Правило.Селектор, "::backdrop") = 0
			ИЛИ Правило.Объявления.Получить("background") = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Значение = НРег(Правило.Объявления.Получить("background"));
		Если Разбор.УзкийЭкран(Правило.Условия) Тогда
			Узкое = Значение;
		Иначе
			Широкое = Значение;
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(Узкое, "под шторкой страница затемнена").Заполнено();
	Ожидаем.Что(Узкое, "и это настоящий цвет, а не пустота").ЭтоНе().Равно("transparent");
	Ожидаем.Что(Широкое = "" ИЛИ Широкое = "transparent" ИЛИ Широкое = "none",
		"под выпадающим меню страница не затемняется, а сейчас «" + Широкое + "»").ЭтоИстина();

КонецПроцедуры

// Разделы текущего экрана на широком уже стоят колонкой на самой странице — второй список
// в меню владелец назвал дублем. На телефоне колонки нет, и секция там единственная дорога
// к соседнему разделу: спрячь её на обеих ширинах — и с телефона в разделы не попасть.
&Тест
Процедура СекцияРазделовВиднаТолькоНаУзком() Экспорт

	Базовое = "";
	Широкое = "";

	Для Каждого Правило Из ПравилаКласса("hubmenu__section--screen") Цикл

		Если НЕ Разбор.СелекторСтилизуетКласс(Правило.Селектор, "hubmenu__section--screen")
			ИЛИ Правило.Объявления.Получить("display") = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Значение = НРег(Правило.Объявления.Получить("display"));
		Если Правило.Условия = "" Тогда
			Базовое = Значение;
		ИначеЕсли НЕ Разбор.УзкийЭкран(Правило.Условия) Тогда
			Широкое = Значение;
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(Широкое, "на широком секция разделов из меню убрана").Равно("none");
	Ожидаем.Что(Базовое, "а по умолчанию она видна — на телефоне это вход в разделы")
		.Заполнено();
	Ожидаем.Что(Базовое, "и это не «спрятана»").ЭтоНе().Равно("none");

КонецПроцедуры

// Панель — колонка, и содержимого в ней бывает больше, чем высоты. Разреши браузеру ужимать
// строки — он ужмёт: у вошедшего с семью делами учётка садилась на аватар, а рубрики
// наезжали друг на друга. Строки держат высоту, лишнее уходит в прокрутку.
&Тест
Процедура СтрокиПанелиНеУжимаются() Экспорт

	Держат = Ложь;

	Для Каждого Правило Из ПравилаКласса("hubmenu") Цикл

		Если СтрНайти(Правило.Селектор, "hubmenu") = 0
			ИЛИ СтрНайти(Правило.Селектор, "*") = 0 Тогда
			Продолжить;
		КонецЕсли;

		Сжатие = Правило.Объявления.Получить("flex");
		Если Сжатие = Неопределено Тогда
			Сжатие = Правило.Объявления.Получить("flex-shrink");
		КонецЕсли;

		Если Сжатие <> Неопределено
			И (НРег(Сжатие) = "none" ИЛИ СокрЛП(Сжатие) = "0") Тогда
			Держат = Истина;
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(Держат,
		"детям панели разрешено ужиматься — на длинном списке строки наедут друг на друга")
		.ЭтоИстина();

КонецПроцедуры

// Разделы экрана печатаются дважды — колонкой дома настроек и секцией меню, — поэтому
// на телефоне колонка прячется. Но ТОЛЬКО у страницы с меню: «страница с меню» выражена
// соседством с панелью, и у инсталляции без слота колонка остаётся единственным входом
// в соседний раздел.
&Тест
Процедура НаУзкомЭкранеКолонкаРазделовПрячетсяТолькоПодМеню() Экспорт

	Прячущие = Новый Массив();
	Спрятана = Ложь;

	Для Каждого Правило Из ПравилаКласса("settings__nav") Цикл

		Если НРег(Строка(Правило.Объявления.Получить("display"))) <> "none" Тогда
			Продолжить;
		КонецЕсли;

		Если Разбор.УзкийЭкран(Правило.Условия)
			И Разбор.СелекторКасаетсяКласса(Правило.Селектор, "hubmenu") Тогда
			Спрятана = Истина;
		Иначе
			Прячущие.Добавить(Правило.Селектор + " {" + Правило.Условия + "}");
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(Спрятана,
		"на узком экране колонка разделов уступает место секции меню").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Прячущие, ", "),
		"правила, прячущие колонку у страницы БЕЗ единого меню").Равно("");

КонецПроцедуры

// Палец в цель высотой в 27 px не попадает: пункт меню не мельче 44 px.
&Тест
Процедура ПунктыМенюНеМельчеПальца() Экспорт

	Ожидаем.Что(ПальцеваяВысотаКнопки("hubmenu"),
		"последнее слово каскада о высоте пункта на телефоне").БольшеИлиРавно(44);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Модель меню глазами инсталляции: сумма дел, вошедший, его дела с раздельными числами
// и дороги хаба. Ни одного из этих слов кит не знает.
Функция МодельМеню()

	Дела = Новый Массив();
	Дела.Добавить(Новый Структура("Подпись, Адрес, Иконка",
		"Кабинет", "/кабинет", "аккаунт"));
	Дела.Добавить(Новый Структура("Подпись, Адрес, Иконка, Счётчик, ПодписьСчётчика",
		"Уведомления", "/кабинет/уведомления", "конверт", 3, "3 непрочитанных"));

	Дороги = Новый Массив();
	Дороги.Добавить(Новый Структура("Подпись, Адрес, Иконка, Активен",
		"Пакеты", "/пакеты", "куб", Истина));
	Дороги.Добавить(Новый Структура("Подпись, Адрес, Иконка", "Пулы", "/пулы", "стопка"));

	Возврат Новый Структура(
		"Счётчик, ПодписьСчётчика, Учётка, Дела, Навигация, Знак, Тема, Выход",
		5, "5 дел",
		Новый Структура("Логин, Роль, Адрес", "а.иванова", "администратор", "/личное"),
		Дела, Дороги,
		"<a href=""/"" class=""brand"">Ромашка</a>",
		"<form method=""post"" action=""/вид"" class=""theme-toggle""></form>",
		"<form method=""post"" action=""/выход""></form>");

КонецФункции

// Классы, которыми кит обвязывает меню: сама разметка компонента, без кнопок и значков —
// у них свои правила и свои сторожа.
Функция КлассыМеню()

	Части = Меню.Отрисовать(МодельМеню());
	Возврат КлассыИзРазметки(Части.Бургер + Части.Учётка + Части.Панель);

КонецФункции

Функция КлассыИзРазметки(Знач Разметка)

	Результат = Новый Массив();
	Позиция = СтрНайти(Разметка, "class=""");

	Пока Позиция > 0 Цикл
		Хвост = Сред(Разметка, Позиция + 7);
		Для Каждого Имя Из СтрРазделить(Лев(Хвост, СтрНайти(Хвост, """") - 1), " ", Ложь) Цикл
			Если СтрНачинаетсяС(Имя, "hubmenu") Тогда
				Если Результат.Найти(Имя) = Неопределено Тогда
					Результат.Добавить(Имя);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Позиция = СтрНайти(Разметка, "class=""", НаправлениеПоиска.СНачала, Позиция + 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Отказ компонента на этой модели; пустая строка означает, что меню собралось.
Функция ОтказМеню(Знач Модель)

	Попытка
		Меню.Отрисовать(Модель);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;

	Возврат "";

КонецФункции

Функция ПравилаКласса(Знач Класс)

	Результат = Новый Массив();
	Для Каждого Правило Из Разбор.Правила(ТекстЛиста()) Цикл
		Если Разбор.СелекторКасаетсяКласса(Правило.Селектор, Класс) Тогда
			Результат.Добавить(Правило);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Объявлена ли этому классу вертикальная прокрутка. ТолькоОткрытой — считать лишь то
// правило, что описывает выдвинутое состояние: закрытая панель не прокручивается ничем.
Функция Прокрутка(Знач Класс, Знач ТолькоОткрытой)

	Значение = "";

	Для Каждого Правило Из ПравилаКласса(Класс) Цикл

		Если НЕ Разбор.СелекторСтилизуетКласс(Правило.Селектор, Класс)
			ИЛИ (ТолькоОткрытой И СтрНайти(Правило.Селектор, ":popover-open") = 0) Тогда
			Продолжить;
		КонецЕсли;

		Объявлено = Правило.Объявления.Получить("overflow-y");
		Если Объявлено = Неопределено Тогда
			Объявлено = Правило.Объявления.Получить("overflow");
		КонецЕсли;
		Значение = ?(Объявлено = Неопределено, Значение, НРег(Объявлено));

	КонецЦикла;

	Возврат Значение = "auto" ИЛИ Значение = "scroll";

КонецФункции

// Правило показывает элемент: объявляет показ, и это не «спрятан».
Функция Показывает(Знач Правило)

	Значение = Правило.Объявления.Получить("display");
	Возврат Значение <> Неопределено И НРег(Значение) <> "none";

КонецФункции

// Показ класса объявлен «спрятан» правилом широкого экрана.
Функция СпрятанНаШироком(Знач Класс)

	Значение = "";
	Для Каждого Правило Из ПравилаКласса(Класс) Цикл
		Если НЕ Разбор.СелекторСтилизуетКласс(Правило.Селектор, Класс)
			ИЛИ Разбор.УзкийЭкран(Правило.Условия)
			ИЛИ Правило.Условия = ""
			ИЛИ Правило.Объявления.Получить("display") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Значение = НРег(Правило.Объявления.Получить("display"));
	КонецЦикла;

	Возврат Значение = "none";

КонецФункции

// Показ класса объявлен «спрятан» правилом БЕЗ условий — то есть на любой ширине.
Функция СпрятанБезУсловий(Знач Класс)

	Значение = "";
	Для Каждого Правило Из ПравилаКласса(Класс) Цикл
		Если Правило.Условия = ""
			И Разбор.СелекторСтилизуетКласс(Правило.Селектор, Класс)
			И Правило.Объявления.Получить("display") <> Неопределено Тогда
			Значение = НРег(Правило.Объявления.Получить("display"));
		КонецЕсли;
	КонецЦикла;

	Возврат Значение = "none";

КонецФункции

// Сторона из сокращённой записи inset: 1 — верх, 2 — право, 3 — низ, 4 — лево.
// Одно значение задаёт все четыре, два — вертикаль и горизонталь.
Функция СторонаИзInset(Знач Значение, Знач Сторона)

	Части = СтрРазделить(СокрЛП(НРег(Значение)), " ", Ложь);
	Если Части.Количество() = 1 Тогда
		Возврат Части[0];
	ИначеЕсли Части.Количество() = 2 Тогда
		Возврат ?(Сторона = 1 ИЛИ Сторона = 3, Части[0], Части[1]);
	ИначеЕсли Части.Количество() = 3 Тогда
		Возврат ?(Сторона = 1, Части[0], ?(Сторона = 3, Части[2], Части[1]));
	КонецЕсли;

	Возврат Части[Сторона - 1];

КонецФункции

// Правило оформляет саму панель, а не её псевдоэлемент и не то, что внутри.
Функция ЭтоСамаПанель(Знач Селектор)

	Возврат Разбор.СелекторСтилизуетКласс(Селектор, "hubmenu")
		И СтрНайти(Селектор, "::") = 0;

КонецФункции

// Высота кнопки на ПАЛЬЦЕВОЙ поверхности: последнее слово каскада из правил, которые
// на телефоне действуют, — безусловных и узких. Правила широкого экрана пропускаются:
// там мышь, и компактная строка дропдауна пальцу не мешает.
//
// Ноль — такое же значение, как остальные: пропусти его «как пустое» — и правило
// min-height: 0, дописанное в узкий блок, оставило бы критерий мёртвым при зелёном тесте.
Функция ПальцеваяВысотаКнопки(Знач Класс)

	Результат = -1;

	Для Каждого Правило Из ПравилаКласса(Класс) Цикл

		Если НЕ Разбор.СелекторСтилизуетКласс(Правило.Селектор, "button")
			ИЛИ (Правило.Условия <> "" И НЕ Разбор.УзкийЭкран(Правило.Условия)) Тогда
			Продолжить;
		КонецЕсли;

		Значение = Разбор.Пиксели(Правило.Объявления.Получить("min-height"));
		Если Значение >= 0 Тогда
			Результат = Значение;
		КонецЕсли;

	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ТекстЛиста()

	Чтение = Новый ЧтениеТекста(Место.ПолныйПуть(Место.ФайлБазовогоЛиста()),
		КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

Функция ОткрывающийТег(Знач HTML, Знач Тег)

	Начало = СтрНайти(HTML, "<" + Тег);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Конец = СтрНайти(HTML, ">", НаправлениеПоиска.СНачала, Начало);
	Возврат Сред(HTML, Начало, Конец - Начало + 1);

КонецФункции

Функция ЗначениеАтрибута(Знач Тег, Знач Имя)

	Начало = СтрНайти(Тег, Имя + "=""");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Тег, Начало + СтрДлина(Имя) + 2);
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

Функция МеждуМаркеров(Знач Текст, Знач Начало, Знач Конец)

	От = СтрНайти(Текст, Начало);
	До = СтрНайти(Текст, Конец, НаправлениеПоиска.СНачала, ?(От = 0, 1, От));
	Возврат ?(От = 0 ИЛИ До = 0, "", Сред(Текст, От, До - От + СтрДлина(Конец)));

КонецФункции

#КонецОбласти
