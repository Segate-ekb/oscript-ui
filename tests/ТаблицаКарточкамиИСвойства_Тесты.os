// Таблица карточками и свойства (выпуск 0.13, шаги 21 и 22). Проверяется то, что ломается
// для человека: на телефоне запись-карточка не начинается с того, по чему её узнают, меню
// строки теряется среди значений, кнопка копирования кладёт в буфер не то, секрет виден
// без спроса или не открывается без скрипта, а свойства и таблицы без новых слов
// печатаются иначе, чем до выпуска.

#Использовать "../"
#Использовать asserts

Перем Кит;    // Кит
Перем Экран;  // ЭкранированиеHTML
Перем Разбор; // РазборЛиста — каскад листа на ширине экрана

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "РазборЛиста.os"), "РазборЛиста");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Кит = Слой.Кит;
	Экран = Слой.Экран;
	Разбор = Новый РазборЛиста();

КонецПроцедуры

#Область ТаблицаКарточками

// Заглавная ячейка записи-карточки помечена классом, и по нему лист ставит её первой: по
// ней запись узнают в лицо. Заглавной объявлена вторая колонка — значит, подписи нет у неё,
// а первая колонка свою подпись получает. Ячейка с меню строки помечена своим классом и
// подписи не несёт: там действия, а не значение.
&Тест
Процедура ЗаглавнаяЯчейкаИЯчейкаМенюПомеченыКлассами() Экспорт

	Ячейки = ОткрывающиеТегиЯчеек(ТаблицаУчастников(Истина).Рендер());

	Ожидаем.Что(Ячейки.Количество(), "в записи четыре ячейки").Равно(4);
	Ожидаем.Что(Ячейки[0], "первая колонка не заглавная: подписана и без класса")
		.Равно("<td data-label=""Вошёл"">");
	Ожидаем.Что(Ячейки[1], "заглавная — по слову Заглавная, без подписи")
		.Равно("<td class=""cell-title"">");
	Ожидаем.Что(Ячейки[2], "прочая ячейка подписана своей колонкой")
		.Равно("<td data-label=""Роль"">");
	Ожидаем.Что(Ячейки[3], "ячейка с меню строки — своим классом, без подписи")
		.Равно("<td class=""cell-narrow cell-menu"">");

	// без слова Заглавная заглавной остаётся первая колонка
	Ячейки = ОткрывающиеТегиЯчеек(ТаблицаУчастников(Ложь).Рендер());
	Ожидаем.Что(Ячейки[0], "по умолчанию заглавная — первая").Равно("<td class=""cell-title"">");
	Ожидаем.Что(Ячейки[1], "вторая тогда подписана").Равно("<td data-label=""Участник"">");

КонецПроцедуры

// Заглавная колонка, снятая словом Когда, места не держит: заглавной становится первая
// напечатанная. Пустая заглавная ячейка остаётся пустой — класс у неё есть, а места на
// узком экране она не занимает.
&Тест
Процедура СнятаяЗаглавнаяУступаетПервойКолонке() Экспорт

	Таблица = Кит.Таблица(
		Кит.Колонка("Вошёл"),
		Кит.Колонка("Участник").Заглавная().Когда(Ложь),
		Кит.Колонка("Роль"),
		Кит.Запись(Кит.Ячейка("вчера"), Кит.Ячейка("анна"), Кит.Ячейка()))
		.Вид("карточками");

	Ячейки = ОткрывающиеТегиЯчеек(Таблица.Рендер());
	Ожидаем.Что(Ячейки.Количество(), "ячейка снятой колонки ушла вместе с ней").Равно(2);
	Ожидаем.Что(Ячейки[0], "заглавной стала первая напечатанная").Равно("<td class=""cell-title"">");
	Ожидаем.Что(Ячейки[1], "пустая ячейка помечена пустой").Равно("<td class=""cell-empty"">");

КонецПроцедуры

// Таблица из данных объявляет заглавную тем же словом у своей колонки.
&Тест
Процедура ЗаглавнаяКолонкаТаблицыИзДанных() Экспорт

	Данные = Новый Массив();
	Данные.Добавить(Новый Структура("Имя, Проект", "анна", "альфа"));
	Таблица = Кит.Таблица(Данные).Вид("карточками");
	Таблица.Колонка("Имя", "Участник");
	Таблица.Колонка("Проект", "Проект").Заглавная();

	Ячейки = ОткрывающиеТегиЯчеек(Таблица.Рендер());
	Ожидаем.Что(Ячейки[0], "первая подписана").Равно("<td data-label=""Участник"">");
	Ожидаем.Что(Ячейки[1], "заглавная — объявленная").Равно("<td class=""cell-title"">");

КонецПроцедуры

// Обычная таблица — с шапкой, и места в карточке у неё нет: слово Заглавная и меню строки
// её разметку не меняют ни на байт.
&Тест
Процедура ОбычнаяТаблицаПечатаетсяКакПрежде() Экспорт

	// панель меню нумеруется по счёту меню в прогоне: номер сравнению не мешает
	Номер = Новый РегулярноеВыражение("menu-\d+");
	Со = Номер.Заменить(ТаблицаУчастников(Истина).Вид("").Рендер(), "menu-N");
	Без = Номер.Заменить(ТаблицаУчастников(Ложь).Вид("").Рендер(), "menu-N");

	Ожидаем.Что(Со, "слово Заглавная у обычной таблицы ничего не печатает").Равно(Без);
	Ожидаем.Что(СтрНайти(Со, "cell-title") + СтрНайти(Со, "cell-menu"),
		"классов места в карточке у обычной таблицы нет: " + Со).Равно(0);
	Ожидаем.Что(СтрНайти(Со, "<td class=""cell-narrow""><div class=""menu"">") > 0,
		"ячейка меню — прежняя: " + Со).ЭтоИстина();

КонецПроцедуры

// Заглавной бывает только колонка: у ячейки и у таблицы этого слова нет.
&Тест
Процедура ЗаглавнойБываетТолькоКолонка() Экспорт

	Попытка
		Кит.Ячейка("анна").Заглавная();
		Ошибка = "";
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;

	Ожидаем.Что(СтрНайти(Ошибка, "заглавной бывает колонка") > 0,
		"ячейка заглавной не бывает: " + Ошибка).ЭтоИстина();

КонецПроцедуры

// На телефоне запись — сетка: заглавная и меню делят первую строку (заглавная слева,
// меню в правом углу), прочие ячейки идут под ними во всю ширину. На широком экране
// у таблицы шапка, и лист оставляет ячейки в ряду.
&Тест
Процедура ЗаглавнаяИМенюДелятПервуюСтрокуКарточки() Экспорт

	Запись = КаскадЯчейки("tr", "", 390, "display,grid-template-columns");
	Ожидаем.Что(Запись.Получить("display"), "запись на телефоне — сетка").Равно("grid");

	Заглавная = КаскадЯчейки("td", "cell-title", 390, "grid-row,grid-column,font");
	Ожидаем.Что(Заглавная.Получить("grid-row"), "заглавная — первой строкой").Равно("1");
	Ожидаем.Что(Заглавная.Получить("grid-column"), "в левой колонке").Равно("1");
	Ожидаем.Что(Заглавная.Получить("font"), "крупнее значений").Равно("var(--type-title-medium)");

	Меню = КаскадЯчейки("td", "cell-menu", 390, "grid-row,grid-column");
	Ожидаем.Что(Меню.Получить("grid-row"), "меню — в первой строке").Равно("1");
	Ожидаем.Что(Меню.Получить("grid-column"), "в правом углу").Равно("2");

	Прочая = КаскадЯчейки("td", "", 390, "grid-column");
	Ожидаем.Что(Прочая.Получить("grid-column"), "прочие — во всю ширину").Равно("1 / -1");

	Широкий = КаскадЯчейки("td", "cell-title", 1280, "grid-row,font");
	Ожидаем.Что(Широкий.Получить("grid-row"), "на широком экране места в карточке нет")
		.Равно(Неопределено);
	Ожидаем.Что(Широкий.Получить("font") <> "var(--type-title-medium)",
		"и заглавная не крупнее соседей").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Свойства

// Свойство без новых слов печатается прежней парой байт в байт.
&Тест
Процедура СвойствоБезСловПечатаетсяКакПрежде() Экспорт

	Ожидаем.Что(Кит.Свойства(Кит.Свойство("Создан", "вчера")).Рендер(), "прежняя пара")
		.Равно("<dl class=""props""><dt>Создан</dt><dd>вчера</dd></dl>");
	Ожидаем.Что(Кит.Свойство("Размер", Кит.Код("430 МБ")).Примечание("").Рендер(),
		"пустое примечание — это его отсутствие")
		.Равно("<dt>Размер</dt><dd><code>430 МБ</code></dd>");

КонецПроцедуры

// Значение свойства — дерево: плашка, ссылка и полоса заполнения печатаются внутри <dd>
// своей разметкой — и без слов, и со словами (тогда внутри обёртки значения).
&Тест
Процедура ЗначениеСвойстваПлашкаСсылкаИПолоса() Экспорт

	Плашка = Кит.Плашка("активен").Вид("ok").Рендер();
	Ссылка = Кит.Ссылка("/люди/7", "Анна Смирнова").Рендер();
	Полоса = Кит.ПолосаЗаполнения(40, "занято 4 ГБ из 10").Рендер();

	HTML = Кит.Свойства(
		Кит.Свойство("Состояние", Кит.Плашка("активен").Вид("ok")),
		Кит.Свойство("Владелец", Кит.Ссылка("/люди/7", "Анна Смирнова")),
		Кит.Свойство("Место", Кит.ПолосаЗаполнения(40, "занято 4 ГБ из 10"))).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<dt>Состояние</dt><dd>" + Плашка + "</dd>") > 0,
		"плашка — значением: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<dt>Владелец</dt><dd>" + Ссылка + "</dd>") > 0,
		"ссылка — значением: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<dt>Место</dt><dd>" + Полоса + "</dd>") > 0,
		"полоса заполнения — значением: " + HTML).ЭтоИстина();

	Со = Кит.Свойство("Место", Кит.ПолосаЗаполнения(40, "занято 4 ГБ из 10"))
		.Примечание("пересчитано ночью").Рендер();
	Ожидаем.Что(СтрНайти(Со, "<div class=""props__text"">" + Полоса + "</div>") > 0,
		"со словами значение-дерево — в обёртке значения: " + Со).ЭтоИстина();

КонецПроцедуры

// Примечание печатается приглушённой строкой ПОСЛЕ значения и экранируется.
&Тест
Процедура ПримечаниеСтоитПослеЗначения() Экспорт

	HTML = Кит.Свойство("Размер", Кит.Код("430 МБ")).Примечание("<на 1 мая>").Рендер();

	Ожидаем.Что(HTML, "значение, затем примечание").Равно("<dt>Размер</dt>"
		+ "<dd class=""props__value""><div class=""props__text""><code>430 МБ</code></div>"
		+ "<span class=""props__note"">&lt;на 1 мая&gt;</span></dd>");

КонецПроцедуры

// Кнопка копирования — та же, что у блока команды (data-copy, её оживляет скрипт
// инсталляции), стоит сразу за значением и кладёт в буфер текст значения. Своя строка
// словом перекрывает текст значения; копировать нечего — сборка останавливается.
&Тест
Процедура КопируемоеСвойствоНесётТекстЗначения() Экспорт

	HTML = Кит.Свойство("Ключ", Кит.Код("api_7f2c")).Копируемое().Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<button class=""copy props__copy"" type=""button"""
		+ " data-copy=""api_7f2c"" title=""Копировать"">") > 0,
		"кнопка копирования с текстом значения: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""visually-hidden"">Копировать</span></button>") > 0,
		"у кнопки-иконки есть имя для скринридера: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "</div><button") > 0,
		"кнопка — сразу за значением: " + HTML).ЭтоИстина();

	Своя = Кит.Свойство("Адрес", Кит.Ссылка("https://пример.рф/a", "открыть"))
		.Копируемое("https://пример.рф/a?x=1&y=2").Рендер();
	Ожидаем.Что(СтрНайти(Своя, Экран.Атрибут("data-copy", "https://пример.рф/a?x=1&y=2")) > 0,
		"своя строка копии, экранированная как атрибут: " + Своя).ЭтоИстина();

	Попытка
		Кит.Свойство("Состояние", Кит.Плашка("активен")).Копируемое().Рендер();
		Ошибка = "";
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Ошибка, ".Копируемое(") > 0,
		"значение без текста копировать нечего — сказано, что сделать: " + Ошибка).ЭтоИстина();

КонецПроцедуры

// Секрет без скрипта: галка «Показать» стоит ПЕРЕД точками и значением (правило «:checked ~»
// открывает значение), подпись связана с галкой, точки скрыты от скринридера. Идентификатор
// галки повторяется от печати к печати, а у свойства с якорем — от якоря.
&Тест
Процедура СекретПечатаетТочкиИГалкуПоказать() Экспорт

	Свойство = Кит.Свойство("Токен", Кит.Код("s3cr3t")).Секрет().Копируемое();
	HTML = Свойство.Рендер();

	Ид = ИдГалки(HTML);
	Ожидаем.Что(СтрНачинаетсяС(Ид, "reveal-"), "у галки свой идентификатор: " + HTML).ЭтоИстина();
	Ожидаем.Что(HTML, "галка, точки, значение, «Показать», копирование").Равно("<dt>Токен</dt>"
		+ "<dd class=""props__value props__value--secret"">"
		+ "<input type=""checkbox"" class=""props__reveal-box"" id=""" + Ид + """>"
		+ "<span class=""props__mask"" aria-hidden=""true"">••••••••</span>"
		+ "<div class=""props__text""><code>s3cr3t</code></div>"
		+ "<label class=""props__reveal"" for=""" + Ид + """>"
		+ "<span class=""props__reveal-show"">Показать</span>"
		+ "<span class=""props__reveal-hide"">Скрыть</span></label>"
		+ Сред(HTML, СтрНайти(HTML, "<button")));
	Ожидаем.Что(СтрНайти(HTML, "data-copy=""s3cr3t""") > 0,
		"копируется сам секрет, а не точки: " + HTML).ЭтоИстина();
	Ожидаем.Что(Свойство.Рендер(), "печать повторяется байт в байт").Равно(HTML);

	СЯкорем = Кит.Свойство("Токен", "s3cr3t").Секрет().Якорь("token").Рендер();
	Ожидаем.Что(ИдГалки(СЯкорем), "у свойства с якорем — от якоря").Равно("token-reveal");
	Ожидаем.Что(СтрНайти(СЯкорем, "<dd id=""token"" class=""props__value props__value--secret"">") > 0,
		"якорь остаётся у значения: " + СЯкорем).ЭтоИстина();

	Ожидаем.Что(СтрНайти(Кит.Свойство("Токен", "s3cr3t").Секрет(Ложь).Рендер(), "props__"),
		"Секрет(Ложь) снимает слово").Равно(0);

КонецПроцедуры

// Секрет открывает лист, а не скрипт: значение скрыто, пока галка не отмечена, и точки
// уходят, когда она отмечена.
&Тест
Процедура СекретОткрываетЛистБезСкрипта() Экспорт

	Лист = Разбор.ТекстБазовогоЛиста();
	Ожидаем.Что(СтрНайти(Лист, ".props__value--secret .props__text { display: none; }") > 0,
		"значение секрета скрыто").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Лист, ".props__reveal-box:checked ~ .props__text { display: block; }") > 0,
		"отмеченная галка открывает значение").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Лист, ".props__reveal-box:checked ~ .props__mask { display: none; }") > 0,
		"и снимает точки").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Лист, ".props__reveal-box:focus-visible ~ .props__reveal {") > 0,
		"фокус на спрятанной галке виден на её подписи").ЭтоИстина();

КонецПроцедуры

// Слова свойства — только у свойства: у текста и у поля их смысл другой или его нет.
// Секрет у поля по-прежнему делает пароль.
&Тест
Процедура СловаСвойстваТолькоУСвойства() Экспорт

	Для Каждого Слово Из СтрРазделить("Копируемое,Примечание", ",") Цикл
		Попытка
			Если Слово = "Копируемое" Тогда
				Кит.Ссылка("/a", "a").Копируемое();
			Иначе
				Кит.Ссылка("/a", "a").Примечание("x");
			КонецЕсли;
			Ошибка = "";
		Исключение
			Ошибка = ОписаниеОшибки();
		КонецПопытки;
		Ожидаем.Что(СтрНайти(Ошибка, "у свойства (Кит.Свойство") > 0,
			Слово + " у ссылки отвергнуто: " + Ошибка).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(СтрНайти(Кит.Поле("pass", "Пароль").Секрет().Рендер(), "type=""password""") > 0,
		"Секрет у поля — пароль, как прежде").ЭтоИстина();
	Ожидаем.Что(Кит.Примечание("обновлено вчера").Рендер(), "фабрика Кит.Примечание не задета")
		.Равно("<p class=""muted"">обновлено вчера</p>");

КонецПроцедуры

// До 640px свойства — одна колонка: имя над значением. Шире — две колонки, как прежде.
&Тест
Процедура СвойстваНаТелефонеВОднуКолонку() Экспорт

	Цепочка = Новый Массив();
	Цепочка.Добавить(Разбор.Узел("dl", "props"));

	Телефон = Разбор.Каскад(Цепочка, 390, "grid-template-columns");
	Ожидаем.Что(Телефон.Получить("grid-template-columns"), "на телефоне — одна колонка")
		.Равно("minmax(0, 1fr)");

	Широкий = Разбор.Каскад(Цепочка, 1280, "grid-template-columns");
	Ожидаем.Что(Широкий.Получить("grid-template-columns"), "шире — имя и значение рядом")
		.Равно("auto 1fr");

КонецПроцедуры

#КонецОбласти

#Область Служебное

// Таблица участников карточками: «Вошёл», «Участник» (заглавная, если просили), «Роль»
// и узкая колонка меню строки.
Функция ТаблицаУчастников(Знач СЗаглавной)

	Участник = Кит.Колонка("Участник");
	Если СЗаглавной Тогда
		Участник.Заглавная();
	КонецЕсли;

	Пункты = Новый Массив();
	Пункты.Добавить(Новый Структура("Подпись, Адрес", "Открыть", "/участники/1"));

	Возврат Кит.Таблица(
		Кит.Колонка("Вошёл"),
		Участник,
		Кит.Колонка("Роль"),
		Кит.Колонка().Вид("узкая"),
		Кит.Запись(
			Кит.Ячейка("вчера"),
			Кит.Ячейка("анна"),
			Кит.Ячейка("владелец"),
			Кит.Ячейка(Кит.Меню(Новый Структура("Подпись, Пункты", "Действия над «анна»", Пункты)))
				.Вид("узкая"))).Вид("карточками");

КонецФункции

// Открывающие теги ячеек тела таблицы по порядку.
Функция ОткрывающиеТегиЯчеек(Знач HTML)

	Результат = Новый Массив();
	Тело = Сред(HTML, СтрНайти(HTML, "<tbody>"));
	Позиция = СтрНайти(Тело, "<td");
	Пока Позиция > 0 Цикл
		Хвост = Сред(Тело, Позиция);
		Результат.Добавить(Лев(Хвост, СтрНайти(Хвост, ">")));
		Позиция = СтрНайти(Тело, "<td", НаправлениеПоиска.СНачала, Позиция + 1);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Каскад листа о строке или ячейке записи таблицы карточками на экране этой ширины.
Функция КаскадЯчейки(Знач Тег, Знач Классы, Знач Ширина, Знач Свойства)

	Цепочка = Новый Массив();
	Цепочка.Добавить(Разбор.Узел("div", "table-scroll"));
	Цепочка.Добавить(Разбор.Узел("table", "table,table-cards"));
	Цепочка.Добавить(Разбор.Узел("tbody"));
	Цепочка.Добавить(Разбор.Узел("tr"));
	Если Тег = "td" Тогда
		Цепочка.Добавить(Разбор.Узел("td", Классы));
	КонецЕсли;
	Возврат Разбор.Каскад(Цепочка, Ширина, Свойства);

КонецФункции

Функция ИдГалки(Знач HTML)

	Начало = СтрНайти(HTML, "class=""props__reveal-box"" id=""");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Начало + СтрДлина("class=""props__reveal-box"" id="""));
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

#КонецОбласти
