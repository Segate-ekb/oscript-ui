// Витрина обещает разработчику две вещи: рядом с каждым образцом лежит ТОТ САМЫЙ код,
// которым образец нарисован, и в ней виден ВЕСЬ словарь кита. Оба обещания и проверяются:
// исходник каждого образца исполняется здесь заново, в чужом модуле, где нет ничего кроме
// трёх желудей, — и обязан дать ровно ту разметку, которую витрина показывает.

#Использовать "../"
#Использовать asserts

Перем Печать;    // РазметкаЭлементов — словарь родов и видов
Перем Экран;     // ЭкранированиеHTML

// Четыре имени, которые видит исходник образца, — и больше ничего. Названы так же, как
// в витрине: если образец опирается на что-то ещё, здесь он не исполнится.
Перем Набор;      // НаборКомпонентов
Перем Кит;        // Кит
Перем Формы;      // Формы
Перем Настройки;  // РендерерНастроек

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура ПодключитьФикстуру() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	ПодключитьСценарий(ОбъединитьПути(КаталогТестов, "фикстуры", "СборкаХолста.os"),
		"СборкаХолста");

	ВзятьСвойСлой();

КонецПроцедуры

// Показанный код — не подпись к картинке, а её источник. Проверка исполняет его ЗАНОВО
// и сверяет с тем, что витрина нарисовала: разойтись они могут только если картинку
// рисует не этот текст.
&Тест
Процедура ПоказанныйКодРисуетТотЖеОбразец() Экспорт

	ВзятьСвойСлой();
	Расхождения = Новый Массив();
	Образцов = 0;

	Для Каждого Часть Из СвежаяВитрина().Разделы() Цикл
		Для Каждого Образец Из Часть.Образцы Цикл
			Образцов = Образцов + 1;
			Если Исполнить(Образец.Исходник) <> Образец.Разметка Тогда
				Расхождения.Добавить(Часть.Ключ + " / " + Образец.Подпись);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Расхождения.Количество(),
		"образцы, у которых показанный код рисует НЕ ТО, что нарисовано рядом: "
			+ СтрСоединить(Расхождения, "; ")).Равно(0);
	Ожидаем.Что(Образцов > 100, "образцов в витрине: " + Образцов).ЭтоИстина();

КонецПроцедуры

// Исходник образца самодостаточен: его копируют со страницы и вставляют к себе. Если он
// опирается на что-то, чего у читателя нет, проверка выше не исполнится вовсе, — а здесь
// проверяется, что на страницу он попадает ЦЕЛИКОМ и без правок: и в текст блока,
// и в кнопку копирования.
&Тест
Процедура СтраницаПоказываетИДаётСкопироватьТотЖеИсходник() Экспорт

	Витрина = СвежаяВитрина();
	Страница = Витрина.Отрисовать();
	Потери = Новый Массив();

	Для Каждого Часть Из Витрина.Разделы() Цикл
		Для Каждого Образец Из Часть.Образцы Цикл

			Если СтрНайти(Страница, Экран.Экранировать(Образец.Исходник)) = 0 Тогда
				Потери.Добавить(Часть.Ключ + " / " + Образец.Подпись + ": нет в тексте");
			КонецЕсли;

			Если СтрНайти(Страница, Экран.Атрибут("data-copy", Образец.Исходник)) = 0 Тогда
				Потери.Добавить(Часть.Ключ + " / " + Образец.Подпись + ": нет в кнопке");
			КонецЕсли;

		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Потери.Количество(),
		"исходники, показанные или копируемые не такими, какими исполнены: "
			+ СтрСоединить(Потери, "; ")).Равно(0);

КонецПроцедуры

// Скрипт витрины только оживляет кнопку кита: код образца лежит в разметке, и человек
// без JavaScript читает и выделяет его так же. Скрипт, который принёс бы код с собой,
// эту проверку и роняет.
&Тест
Процедура КодОбразцаЛежитВРазметке_АНеВСкрипте() Экспорт

	Витрина = СвежаяВитрина();
	Страница = Витрина.Отрисовать();
	Скрипт = Витрина.Скрипт();
	Принесённые = Новый Массив();

	Для Каждого Часть Из Витрина.Разделы() Цикл
		Для Каждого Образец Из Часть.Образцы Цикл
			Если СтрНайти(Скрипт, Образец.Исходник) > 0 Тогда
				Принесённые.Добавить(Часть.Ключ + " / " + Образец.Подпись);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Принесённые.Количество(),
		"исходники, которые страница получает от скрипта, а не из разметки: "
			+ СтрСоединить(Принесённые, "; ")).Равно(0);
	Ожидаем.Что(СтрНайти(Скрипт, "data-copy") > 0,
		"скрипт оживляет кнопку кита по её же атрибуту: " + Скрипт).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Страница, "<code>") > 0,
		"код образца напечатан текстом страницы").ЭтоИстина();

КонецПроцедуры

// Витрина — единственное место, где библиотеку видно целиком: заведённый род или новая
// обёртка над компонентом обязаны в ней появиться, иначе разработчик о них не узнает.
&Тест
Процедура ВитринаПоказываетВесьСловарьКита() Экспорт

	Показано = Новый Соответствие();
	Для Каждого Часть Из СвежаяВитрина().Разделы() Цикл
		Для Каждого Имя Из СтрРазделить(Часть.Словарь, ",", Ложь) Цикл
			Если ЗначениеЗаполнено(СокрЛП(Имя)) Тогда
				Показано.Вставить(СокрЛП(Имя), Часть.Ключ);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Пропущено = Новый Массив();
	Для Каждого Род Из Печать.Роды() Цикл
		Если Показано.Получить("род:" + Род) = Неопределено Тогда
			Пропущено.Добавить("род " + Род);
		КонецЕсли;
	КонецЦикла;

	Для Каждого Вид Из Печать.ВидыРода("компонент") Цикл
		Если Показано.Получить("компонент:" + Вид) = Неопределено Тогда
			Пропущено.Добавить("компонент " + Вид);
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Пропущено.Количество(),
		"словарь кита, которого в витрине нет: " + СтрСоединить(Пропущено, ", ")).Равно(0);

КонецПроцедуры

// Объявить род мало — его надо ПОКАЗАТЬ. Проверка идёт по значению: род печатается своим
// тегом, и тег спрашивается у самого кита, а не переписан сюда списком.
&Тест
Процедура ОбъявленныйРодПечатаетсяСвоимТегомВСвоёмРазделе() Экспорт

	Необоснованные = Новый Массив();

	Для Каждого Часть Из СвежаяВитрина().Разделы() Цикл

		Разметка = "";
		Для Каждого Образец Из Часть.Образцы Цикл
			Разметка = Разметка + Образец.Разметка;
		КонецЦикла;

		Для Каждого Имя Из СтрРазделить(Часть.Словарь, ",", Ложь) Цикл
			Тег = ПроверяемыйТег(СокрЛП(Имя));
			Если ЗначениеЗаполнено(Тег) И СтрНайти(Разметка, "<" + Тег) = 0 Тогда
				Необоснованные.Добавить(СокрЛП(Имя) + " (раздел " + Часть.Ключ + ")");
			КонецЕсли;
		КонецЦикла;

	КонецЦикла;

	Ожидаем.Что(Необоснованные.Количество(),
		"роды, объявленные разделом, но ни одним его образцом не напечатанные: "
			+ СтрСоединить(Необоснованные, ", ")).Равно(0);

КонецПроцедуры

// Обратная сторона той же сверки: раздел объявил то, чего в ките уже нет. Такая строка
// не краснеет сама по себе, но врёт читателю про несуществующий род.
&Тест
Процедура ВитринаНеОбещаетТого_ЧегоВКитеНет() Экспорт

	Лишнее = Новый Массив();

	Для Каждого Часть Из СвежаяВитрина().Разделы() Цикл
		Для Каждого Имя Из СтрРазделить(Часть.Словарь, ",", Ложь) Цикл
			Если ЗначениеЗаполнено(СокрЛП(Имя)) И НЕ КитЗнает(СокрЛП(Имя)) Тогда
				Лишнее.Добавить(СокрЛП(Имя) + " (раздел " + Часть.Ключ + ")");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Лишнее.Количество(),
		"витрина обещает то, чего в ките нет: " + СтрСоединить(Лишнее, ", ")).Равно(0);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

// Исходник образца исполняется здесь так же, как в витрине, — но в ЧУЖОМ модуле:
// ничего, кроме Набора, Кита, Форм и Настроек, ему тут не видно.
Функция Исполнить(Знач Исходник)

	HTML = "";
	Выполнить(Исходник);
	Возврат HTML;

КонецФункции

// Свежий слой на каждую сторону сверки: и меню, и объявление формы выдают порядковые
// идентификаторы, поэтому два прогона одних и тех же образцов совпадут только тогда,
// когда каждый считает со своего нуля.
Процедура ВзятьСвойСлой()

	Слой = Новый СборкаХолста().Собрать();
	Набор = Слой.Набор;
	Кит = Слой.Кит;
	Формы = Слой.Формы;
	Настройки = Слой.Настройки;
	Печать = Слой.Разметка;
	Экран = Слой.Экран;

КонецПроцедуры

Функция СвежаяВитрина()

	Слой = Новый СборкаХолста().Собрать();
	Сборка = Новый СборкаОбразцов();

	Возврат Новый ВитринаКита(Слой.Набор, Слой.Кит, Слой.Формы, Слой.Настройки, Слой.Разметка,
		Новый ОбразцыСтраницы(Сборка), Новый ОбразцыВвода(Сборка),
		Новый ОбразцыПоказа(Сборка), Новый ОбразцыХолста(Сборка));

КонецФункции

// Тег годится в сторожа, только когда он один: у заголовка это диапазон «h1…h6», а роду
// без тега (холст, текст, шаблон, готовое, компонент) сверять нечего — его показ видит глаз.
Функция ПроверяемыйТег(Знач Имя)

	Если НЕ СтрНачинаетсяС(Имя, "род:") Тогда
		Возврат "";
	КонецЕсли;

	Тег = Печать.ТегРода(Сред(Имя, 5));
	Возврат ?(СтрНайти(Тег, "…") = 0, Тег, "");

КонецФункции

Функция КитЗнает(Знач Имя)

	Если СтрНачинаетсяС(Имя, "род:") Тогда
		Возврат Печать.Роды().Найти(Сред(Имя, 5)) <> Неопределено;
	КонецЕсли;

	Возврат СтрНачинаетсяС(Имя, "компонент:")
		И Печать.ВидыРода("компонент").Найти(Сред(Имя, 11)) <> Неопределено;

КонецФункции

#КонецОбласти
