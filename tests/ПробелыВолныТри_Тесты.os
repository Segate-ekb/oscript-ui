// Слова дев-сборки 0.13.0-dev.6: полные ряды сетки карточек (замечание владельца к превью 2,
// п. 4 — «плашки на компьютере растянутые и сплюснутые») и пробелы кита, которые записали
// треки хаба волны 3. Проверяется то, что ломается для человека: на какой-то ширине
// последний ряд сетки остаётся неполным или пропадает целиком, а узлы без новых слов
// печатаются иначе, чем до сборки.

#Использовать "../"
#Использовать asserts

Перем Кит;    // Кит
Перем Набор;  // НаборКомпонентов
Перем Разбор; // РазборЛиста — сканер, читающий КОД листа

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "РазборЛиста.os"), "РазборЛиста");

	Слой = Новый СборкаХолста().Собрать();
	Кит = Слой.Кит;
	Набор = Слой.Набор;
	Разбор = Новый РазборЛиста();

КонецПроцедуры

#Область ПолныеРяды

// Слово печатает класс полных рядов; сетка без слова — прежняя байт в байт.
&Тест
Процедура ПолныеРядыПечатаютКлассСетки() Экспорт

	Сетка = Кит.Сетка(Кит.Примечание("а"), Кит.Примечание("б")).Колонки(4).ПолныеРяды();
	HTML = Сетка.Рендер();
	Ожидаем.Что(СтрНайти(HTML, "<div class=""grid grid--4 grid--full-rows"">") = 1,
		"класс полных рядов после числа колонок: " + HTML).ЭтоИстина();

	Прежняя = Кит.Сетка(Кит.Примечание("а"), Кит.Примечание("б")).Колонки(4).Рендер();
	Ожидаем.Что(Прежняя, "без слова — прежняя разметка").Равно(
		Набор.Сетка().Отрисовать(Новый Структура("Ячейки, Колонки",
			СтрРазделить(Кит.Примечание("а").Рендер() + "|" + Кит.Примечание("б").Рендер(), "|"), 4)));
	Ожидаем.Что(СтрНайти(Прежняя, "full-rows"), "без слова класса нет").Равно(0);

	Плотная = Кит.Сетка(Кит.Примечание("а")).Колонки(3).Плотная().ПолныеРяды().Рендер();
	Ожидаем.Что(СтрНайти(Плотная, "class=""grid grid--3 grid--tight grid--full-rows""") > 0,
		"и у плотной сетки: " + Плотная).ЭтоИстина();

	Снятое = Кит.Сетка(Кит.Примечание("а")).Колонки(4).ПолныеРяды(Ложь).Рендер();
	Ожидаем.Что(СтрНайти(Снятое, "full-rows"), "ПолныеРяды(Ложь) снимает слово").Равно(0);

КонецПроцедуры

// У 1, 2 и «авто» число колонок не задано точками перелома: лист не знает, какой ряд
// неполный, и молча ничего бы не сделал. Сборка останавливается и называет, что сделать.
&Тест
Процедура ПолныеРядыТолькоУТрёхИЧетырёхКолонок() Экспорт

	Для Каждого Колонки Из СтрРазделить("1,2,авто", ",") Цикл
		Сетка = Кит.Сетка(Кит.Примечание("а")).Колонки(Колонки).ПолныеРяды();
		Текст = "";
		Попытка
			Сетка.Рендер();
		Исключение
			Текст = ИнформацияОбОшибке().Описание;
		КонецПопытки;
		Ожидаем.Что(СтрНайти(Текст, ".Колонки(3) или .Колонки(4)") > 0,
			"колонки «" + Колонки + "»: исключение с подсказкой: " + Текст).ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(Кит.Сетка().Колонки(4).ПолныеРяды().Рендер(), "пустая сетка не печатается, как прежде").Равно("");

КонецПроцедуры

// Каскад листа на каждой ширине и при любом числе карточек: видно столько, сколько
// заполняет ряды целиком, а хвост неполного ряда спрятан. Первый ряд не прячется никогда —
// три карточки в четырёх колонках остаются тремя, а не пустой сеткой. Восемь карточек в
// четырёх колонках — 8, 6, 8, 8 на 1280, 900, 600, 390 (замечание владельца к превью 2, п. 4).
&Тест
Процедура ПолныеРядыЗаполняютсяНаКаждойШирине() Экспорт

	Правила = Разбор.Правила(Разбор.ТекстБазовогоЛиста());

	Для Каждого Колонки Из СтрРазделить("3,4", ",") Цикл
		Для Каждого Ширина Из СтрРазделить("2560,1280,1001,1000,900,761,760,601,600,521,520,390", ",") Цикл
			ВРяду = КолонокНаШирине(Правила, Колонки, Число(Ширина));
			Для Карточек = 1 По 13 Цикл
				Видно = 0;
				Для Номер = 1 По Карточек Цикл
					Если НЕ ЯчейкаСпрятана(Правила, Колонки, Число(Ширина), Номер, Карточек) Тогда
						Видно = Видно + 1;
					КонецЕсли;
				КонецЦикла;
				Ждём = ?(Карточек <= ВРяду, Карточек, Карточек - Карточек % ВРяду);
				Ожидаем.Что(Видно, СтрШаблон("grid--%1 на %2 (%3 в ряду), карточек %4",
					Колонки, Ширина, ВРяду, Карточек)).Равно(Ждём);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	// восемь карточек в четырёх колонках по ширинам из замечания
	Для Каждого Пара Из СтрРазделить("1280:8,900:6,600:8,390:8", ",") Цикл
		Части = СтрРазделить(Пара, ":");
		Видно = 0;
		Для Номер = 1 По 8 Цикл
			Если НЕ ЯчейкаСпрятана(Правила, "4", Число(Части[0]), Номер, 8) Тогда
				Видно = Видно + 1;
			КонецЕсли;
		КонецЦикла;
		Ожидаем.Что(Видно, "восемь карточек в Колонки(4) на " + Части[0]).Равно(Число(Части[1]));
	КонецЦикла;

	// счёт формул не ослеп
	Ожидаем.Что(ПодходитФормула("4n+5", 9)).ЭтоИстина();
	Ожидаем.Что(ПодходитФормула("4n+5", 1)).ЭтоЛожь();
	Ожидаем.Что(ПодходитФормула("-n+3", 3)).ЭтоИстина();
	Ожидаем.Что(ПодходитФормула("-n+3", 4)).ЭтоЛожь();
	Ожидаем.Что(ПодходитФормула("1", 1)).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область КолонкаЧисел

// Колонка чисел: заголовок и ячейки по правому краю. В таблице из данных вид колонки
// переходит её ячейкам — сказать им вид больше некому; в ручной сборке ячейке вид дают
// словом. Колонки без вида печатаются как прежде.
&Тест
Процедура КолонкаЧиселПечатаетКлассыЗаголовкаИЯчеек() Экспорт

	Данные = Новый Массив();
	Данные.Добавить(Новый Структура("Имя, Пакетов", "основной", 1204));
	Данные.Добавить(Новый Структура("Имя, Пакетов", "зеркало", 87));
	Таблица = Кит.Таблица(Данные);
	Таблица.Колонка("Имя", "Пул");
	Таблица.Колонка("Пакетов", "Пакетов").Вид("число");
	HTML = Таблица.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<th scope=""col"" class=""col-num"">Пакетов</th>") > 0,
		"заголовок колонки чисел: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "<td class=""cell-num"">"), "ячейки колонки чисел: " + HTML).Равно(2);
	Ожидаем.Что(СтрНайти(HTML, "<td class=""cell-num"">1204</td>") > 0, "число в ячейке: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<th scope=""col"">Пул</th>") > 0, "соседняя колонка — без класса: " + HTML).ЭтоИстина();

	Ручная = Кит.Таблица(Кит.Колонка("Пул"), Кит.Колонка("Пакетов").Вид("число"),
		Кит.Запись(Кит.Ячейка("основной"), Кит.Ячейка("1204").Вид("число")),
		Кит.Запись(Кит.Ячейка("зеркало"), Кит.Ячейка("87").Вид("число")));
	Ожидаем.Что(HTML, "из данных — то же, что ручная сборка").Равно(Ручная.Рендер());

	Прежняя = Кит.Таблица(Данные);
	Прежняя.Колонка("Имя", "Пул");
	Прежняя.Колонка("Пакетов", "Пакетов");
	Ожидаем.Что(СтрНайти(Прежняя.Рендер(), "num"), "без вида — ни одного класса чисел").Равно(0);

КонецПроцедуры

// Число и его заголовок — по правому краю и цифрами одной ширины; в таблице карточками на
// телефоне число — обычная строка под подписью колонки, слева.
&Тест
Процедура КолонкаЧиселПоПравомуКраюАВКарточкеСлева() Экспорт

	Заголовок = Новый Массив();
	Заголовок.Добавить(Разбор.Узел("table", "table"));
	Заголовок.Добавить(Разбор.Узел("thead"));
	Заголовок.Добавить(Разбор.Узел("tr"));
	Заголовок.Добавить(Разбор.Узел("th", "col-num"));
	Итог = Разбор.Каскад(Заголовок, 1280, "text-align,font-variant-numeric");
	Ожидаем.Что(Итог.Получить("text-align"), "заголовок колонки чисел").Равно("right");
	Ожидаем.Что(Итог.Получить("font-variant-numeric"), "цифры заголовка").Равно("tabular-nums");

	Ячейка = Новый Массив();
	Ячейка.Добавить(Разбор.Узел("div", "table-scroll"));
	Ячейка.Добавить(Разбор.Узел("table", "table,table-cards"));
	Ячейка.Добавить(Разбор.Узел("tbody"));
	Ячейка.Добавить(Разбор.Узел("tr"));
	Ячейка.Добавить(Разбор.Узел("td", "cell-num"));
	Широкий = Разбор.Каскад(Ячейка, 1280, "text-align,font-variant-numeric,white-space");
	Ожидаем.Что(Широкий.Получить("text-align"), "ячейка чисел на широком").Равно("right");
	Ожидаем.Что(Широкий.Получить("font-variant-numeric"), "цифры одной ширины").Равно("tabular-nums");
	Ожидаем.Что(Широкий.Получить("white-space"), "число не рвётся").Равно("nowrap");
	Ожидаем.Что(Разбор.Каскад(Ячейка, 390, "text-align").Получить("text-align"),
		"в карточке на телефоне — слева, под подписью").Равно("left");

КонецПроцедуры

#КонецОбласти

#Область ИсточникСегментов

// Источник значения сегментов печатается перед группой и связан с ней aria-describedby;
// текст экранируется. Без слова разметка сегментов прежняя байт в байт.
&Тест
Процедура ИсточникСегментовПередГруппойИСвязанСНей() Экспорт

	Сегменты = Кит.Сегменты("theme",
		Кит.Сегмент("light", "Светлая"),
		Кит.Сегмент("dark", "Тёмная")).Подпись("Тема").Выбрано("dark");
	Прежние = Сегменты.Рендер();

	HTML = Сегменты.Источник("по умолчанию · <ui.theme>").Рендер();
	Ид = ИдИз(HTML, "<span class=""segments__origin"" id=""");
	Ожидаем.Что(СтрНачинаетсяС(Ид, "origin-"), "у источника идентификатор: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(HTML, "<span class=""segments__origin"" id=""" + Ид + """>"
			+ "по умолчанию · &lt;ui.theme&gt;</span><div class=""segments"" role=""radiogroup"""
			+ " aria-label=""Тема"" aria-describedby=""" + Ид + """>"),
		"источник перед группой, экранирован, группа ссылается на него: " + HTML).ЭтоИстина();

	Ожидаем.Что(СтрЗаменить(СтрЗаменить(HTML, " aria-describedby=""" + Ид + """", ""),
			"<span class=""segments__origin"" id=""" + Ид + """>по умолчанию · &lt;ui.theme&gt;</span>", ""),
		"остальная разметка — та же, что без слова").Равно(Прежние);

	Без = Кит.Сегменты("theme", Кит.Сегмент("light", "Светлая")).Рендер();
	Ожидаем.Что(СтрНайти(Без, "origin"), "без слова источника нет").Равно(0);

	// с наборами полей источник — перед всей обёрткой, рядом с подписью группы
	СНаборами = Кит.Сегменты("auth",
		Кит.Сегмент("key", "Ключ", Кит.Поле("token", "Ключ")),
		Кит.Сегмент("none", "Без входа")).Источник("из окружения").Рендер();
	Ожидаем.Что(СтрНайти(СНаборами, "</span><div class=""segments-set"">") > 0,
		"с наборами — перед обёрткой: " + СНаборами).ЭтоИстина();

КонецПроцедуры

// Источник встаёт справа на строке подписи группы: подпись обтекает слева, источник справа,
// группа — под ними; сам он мелкий и приглушённый, как у поля.
&Тест
Процедура ИсточникСегментовСправаНаСтрокеПодписи() Экспорт

	Цепочка = Новый Массив();
	Цепочка.Добавить(Разбор.Узел("fieldset", "field-set"));
	Цепочка.Добавить(Разбор.Узел("span", "segments__origin"));
	Итог = Разбор.Каскад(Цепочка, 1280, "text-align,color");
	Ожидаем.Что(Итог.Получить("text-align"), "источник прижат вправо").Равно("end");
	Ожидаем.Что(Итог.Получить("color"), "цвет вспомогательного текста").Равно("var(--md-sys-color-on-surface-variant)");

	Правила = Разбор.Правила(Разбор.ТекстБазовогоЛиста());
	Нашлось = Новый Соответствие();
	Для Каждого Правило Из Правила Цикл
		Если Правило.Селектор = "fieldset > legend:has(+ .segments__origin)" Тогда
			Нашлось.Вставить("подпись", Правило.Объявления.Получить("float"));
		ИначеЕсли Правило.Селектор = "fieldset > legend + .segments__origin" Тогда
			Нашлось.Вставить("источник", Правило.Объявления.Получить("float"));
		ИначеЕсли Правило.Селектор = "fieldset > legend + .segments__origin + *" Тогда
			Нашлось.Вставить("группа", Правило.Объявления.Получить("clear"));
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(Нашлось.Получить("подпись"), "подпись группы — влево").Равно("left");
	Ожидаем.Что(Нашлось.Получить("источник"), "источник — вправо").Равно("right");
	Ожидаем.Что(Нашлось.Получить("группа"), "группа — под ними").Равно("both");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Число колонок .grid--N на ширине — последним действующим правилом листа.
Функция КолонокНаШирине(Знач Правила, Знач Колонки, Знач Ширина)

	Шаблон = "";
	Для Каждого Правило Из Правила Цикл
		Если Правило.Селектор = ".grid--" + Колонки И Разбор.ДействуетНаШирине(Правило.Условия, Ширина) Тогда
			Значение = Правило.Объявления.Получить("grid-template-columns");
			Если Значение <> Неопределено Тогда
				Шаблон = СокрЛП(Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если СтрНачинаетсяС(Шаблон, "repeat(") Тогда
		Возврат Число(СокрЛП(Сред(Шаблон, 8, СтрНайти(Шаблон, ",") - 8)));
	КонецЕсли;
	Возврат 1;

КонецФункции

// Ячейку с этим номером из стольких прячет правило полных рядов, действующее на ширине.
Функция ЯчейкаСпрятана(Знач Правила, Знач Колонки, Знач Ширина, Знач Номер, Знач Всего)

	Начало = ".grid--" + Колонки + ".grid--full-rows > .grid__cell:nth-child(";
	Для Каждого Правило Из Правила Цикл
		Если НЕ СтрНачинаетсяС(Правило.Селектор, Начало)
			ИЛИ Правило.Объявления.Получить("display") <> "none"
			ИЛИ НЕ Разбор.ДействуетНаШирине(Правило.Условия, Ширина) Тогда
			Продолжить;
		КонецЕсли;
		ОтНачала = АргументПсевдокласса(Правило.Селектор, ":nth-child(");
		ОтКонца = АргументПсевдокласса(Правило.Селектор, ":nth-last-child(");
		Если ПодходитФормула(ОтНачала, Номер) И ПодходитФормула(ОтКонца, Всего - Номер + 1) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция АргументПсевдокласса(Знач Селектор, Знач Псевдокласс)
	Хвост = Сред(Селектор, СтрНайти(Селектор, Псевдокласс) + СтрДлина(Псевдокласс));
	Возврат СокрЛП(Лев(Хвост, СтрНайти(Хвост, ")") - 1));
КонецФункции

// Позиция (с единицы) подходит формуле An+B при каком-нибудь n ≥ 0.
Функция ПодходитФормула(Знач Формула, Знач Позиция)

	Текст = СтрЗаменить(НРег(Формула), " ", "");
	ПозицияN = СтрНайти(Текст, "n");
	Если ПозицияN = 0 Тогда
		Возврат Позиция = Число(Текст);
	КонецЕсли;

	Множитель = Лев(Текст, ПозицияN - 1);
	A = ?(Множитель = "" ИЛИ Множитель = "+", 1, ?(Множитель = "-", -1, Число(Множитель)));
	Сдвиг = Сред(Текст, ПозицияN + 1);
	B = ?(Сдвиг = "", 0, Число(СтрЗаменить(Сдвиг, "+", "")));

	Если A = 0 Тогда
		Возврат Позиция = B;
	ИначеЕсли A > 0 Тогда
		Возврат Позиция >= B И (Позиция - B) % A = 0;
	КонецЕсли;
	Возврат Позиция <= B И (B - Позиция) % (-A) = 0;

КонецФункции

// Значение атрибута сразу после начала.
Функция ИдИз(Знач HTML, Знач Начало)
	Позиция = СтрНайти(HTML, Начало);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Позиция + СтрДлина(Начало));
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);
КонецФункции

#КонецОбласти
