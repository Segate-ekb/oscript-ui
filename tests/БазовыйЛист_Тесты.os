// Базовый лист библиотеки: правила примитивов кита. Проверяется то, что ломается для
// человека, открывшего страницу, — правило, которое браузер отбрасывает целиком из-за
// необъявленной переменной, и цвет, записанный мимо темы: он не переключается вместе
// с ней и остаётся тёмным на светлом фоне.

#Использовать "../"
#Использовать asserts

Перем Разбор;    // РазборЛиста — сканер, читающий КОД листа, а не его текст
Перем Место;     // РаскладкаСтатики — где лежит базовый лист
Перем Токены;    // ТокеныТемы — единственный объявитель переменных

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьРазбор() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	ПодключитьСценарий(ОбъединитьПути(КаталогТестов, "фикстуры", "РазборЛиста.os"), "РазборЛиста");

	Разбор = Новый РазборЛиста();
	Место = Новый РаскладкаСтатики(Новый СтатикаИнсталляцииПоУмолчанию());
	Токены = Новый ТокеныТемы();

КонецПроцедуры

// var(--имя) без объявления браузер отбрасывает вместе со ВСЕМ объявлением: правило
// молча перестаёт работать, а глазами это не видно — в тексте листа всё на месте.
&Тест
Процедура КаждаяПеременнаяЛистаОбъявленаТокенамиТемы() Экспорт

	Использованные = Разбор.ИспользованныеПеременные(ТекстЛиста());
	Объявленные = Разбор.ОбъявленныеПеременные(Токены.Переменные());

	Ожидаем.Что(Использованные.Количество() > 20,
		СтрШаблон("var(--…) в базовом листе найдено: %1 — сканер не ослеп",
			Использованные.Количество())).ЭтоИстина();
	Ожидаем.Что(Объявленные.Количество() > 40,
		СтрШаблон("токенов разобрано: %1 — разбор источника не ослеп",
			Объявленные.Количество())).ЭтоИстина();

	Ожидаем.Что(СтрСоединить(Необъявленные(Использованные, Объявленные), ", "),
		"var(--…) в базовом листе, которых не объявляет ТокеныТемы: браузер отбрасывает"
			+ " такое объявление целиком, правило не работает").Равно("");

КонецПроцедуры

// Цвет, записанный значением, не переключается вместе с темой: в светлой он остаётся
// тёмным, и правило рисует чёрное по белому либо белое по белому.
&Тест
Процедура ВБазовомЛистеНетЗаписанногоЦвета() Экспорт

	Ожидаем.Что(Разбор.ЗаписьЦвета(ТекстЛиста()),
		"цвет мимо токенов темы: он не переключится вместе с ней").Равно("");

	// сканер не ослеп: на приманке он цвет находит
	Ожидаем.Что(Разбор.ЗаписьЦвета(".a { color: #1c1d26; }"), "hex-цвет виден").Равно("#1c1d26");
	Ожидаем.Что(Разбор.ЗаписьЦвета(".a { color: rgba(0,0,0,.4); }"),
		"цветовая функция видна").Равно("rgba(…)");

КонецПроцедуры

// Сканер обязан читать КОД, а не текст: имя из пояснения и имя из строкового литерала
// живой переменной не делают, а «.button--link» — не объявление.
&Тест
Процедура СканЛистаНеПитаетсяКомментариямиИЛитералами() Экспорт

	Приманка = "/* var(--из-комментария): #fff — только текст */" + Символы.ПС
		+ ".a { color: var( --с-пробелом , #fff); border: 1px solid var(--первый) var(--второй); }"
		+ Символы.ПС
		+ ".b { box-shadow: 0 0 0 1px var(--внешний, var(--вложенный)); }" + Символы.ПС
		+ ".c { border: 1px solid/*пояснение*/var(--за-комментарием); }" + Символы.ПС
		+ ".d::before { content: ""var(--из-литерала) #abcdef""; }" + Символы.ПС
		+ ".button--link:hover { text-decoration: underline; }";

	Имена = Разбор.ИспользованныеПеременные(Приманка);

	Ожидаем.Что(Имена.Найти("--с-пробелом") <> Неопределено,
		"пробелы внутри var() и запасное значение").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("--первый") <> Неопределено И Имена.Найти("--второй") <> Неопределено,
		"два var() в одном объявлении").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("--вложенный") <> Неопределено,
		"var() внутри запасного значения").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("--за-комментарием") <> Неопределено,
		"комментарий вплотную к var(): склейка соседей теряла бы использование молча")
		.ЭтоИстина();
	Ожидаем.Что(Имена.Найти("--из-комментария") = Неопределено,
		"имя из комментария CSS использованием не считается").ЭтоИстина();
	Ожидаем.Что(Имена.Найти("--из-литерала") = Неопределено,
		"имя внутри строкового литерала переменной не использует").ЭтоИстина();
	Ожидаем.Что(Имена.Количество(), "лишнего в выборке нет").Равно(6);

	// у цвета своя приманка: в общей он есть по-настоящему — запасным значением var()
	Ожидаем.Что(Разбор.ЗаписьЦвета(
			"/* было #1c1d26 */" + Символы.ПС + ".a::before { content: ""#ffffff""; }"),
		"цвет из комментария и из литерала цветом листа не считается").Равно("");
	Ожидаем.Что(Разбор.ЗаписьЦвета(Приманка),
		"а запасное значение внутри var() — самый настоящий цвет листа").Равно("#fff");

	Объявления = Разбор.ОбъявленныеПеременные(
		"--объявленный:#fff;--через-пробел : 4px;--тень:0 0 0 1px var(--объявленный);");

	Ожидаем.Что(Объявления.Найти("--объявленный") <> Неопределено, "простое объявление").ЭтоИстина();
	Ожидаем.Что(Объявления.Найти("--через-пробел") <> Неопределено,
		"пробел перед двоеточием").ЭтоИстина();
	Ожидаем.Что(Объявления.Найти("--тень") <> Неопределено, "объявление со ссылкой внутри").ЭтоИстина();
	Ожидаем.Что(Объявления.Количество(),
		"var(--x) в значении объявлением не считается").Равно(3);
	Ожидаем.Что(Разбор.ОбъявленныеПеременные(".button--link { color: red; }").Количество(),
		"модификатор класса переменной не объявляет").Равно(0);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

Функция ТекстЛиста()

	Путь = Место.ПолныйПуть(Место.ФайлБазовогоЛиста());
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

Функция Необъявленные(Знач Использованные, Знач Объявленные)

	Результат = Новый Массив();
	Для Каждого Имя Из Использованные Цикл
		Если Объявленные.Найти(Имя) = Неопределено Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
