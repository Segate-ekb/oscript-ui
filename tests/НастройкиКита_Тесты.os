// Дом настроек: колонка разделов внутри экрана. Выдвижного меню у неё нет — те же разделы
// едут секцией в ЕДИНОЕ меню инсталляции (МенюХабаКита_Тесты), а здесь проверяется то,
// что ломается для человека: колонка пропала с широкого экрана, дерево разделов поехало,
// самый длинный дом не помещается, в пункт не попасть пальцем.

#Использовать "../"
#Использовать asserts

Перем Настройки;      // РендерерНастроек — дом настроек словами пробной инсталляции
Перем Разделы;        // ДеревоРазделов — им же сверяется разметка дерева
Перем Разбор;         // РазборЛиста — сканер, читающий КОД листа, а не его текст
Перем Кит;            // Кит — те же секции узлами

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьДом() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "РазборЛиста.os"), "РазборЛиста");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Настройки = Слой.Настройки;
	Разделы = Слой.Набор.ДеревоРазделов();
	Кит = Слой.Кит;

	Разбор = Новый РазборЛиста();

КонецПроцедуры

#Область КолонкаРазделов

// Колонка — обычная <aside> в потоке экрана: ни кнопок, ни верхнего слоя. Всплывающее
// меню на этом экране одно, и оно принадлежит инсталляции, а не дому настроек.
&Тест
Процедура КолонкаРазделовСтоитВПотокеЭкрана() Экспорт

	HTML = ДомСРазделами(3);

	Ожидаем.Что(СтрНайти(HTML, "<aside class=""settings__nav"">") > 0,
		"колонка разделов на месте: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "popover"),
		"своего выдвижного меню у дома настроек нет: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<button"),
		"и открывать нечего — кнопок в обвязке разделов нет: " + HTML).Равно(0);

КонецПроцедуры

// Дом без разделов не печатает пустой колонки: место она заняла бы, а показать ей нечего.
&Тест
Процедура ДомБезРазделовНеПечатаетКолонки() Экспорт

	HTML = Настройки.Отрисовать(Новый Структура("Ключ, Заголовок, Секции",
		"project", "Настройки", Секции()));

	Ожидаем.Что(СтрНайти(HTML, "settings__nav"), "колонки нет: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<aside"), "и вообще никакого бока: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "section") > 0, "а секции дома на месте: " + HTML).ЭтоИстина();

КонецПроцедуры

// Колонка стоит ПЕРЕД секциями: разделы человек встречает раньше содержимого.
&Тест
Процедура КолонкаСтоитПередСекциями() Экспорт

	HTML = ДомСРазделами(3);

	МестоКолонки = СтрНайти(HTML, "<aside");
	МестоСекций = СтрНайти(HTML, "settings__panes");

	Ожидаем.Что(МестоКолонки > 0 И МестоКолонки < МестоСекций,
		СтрШаблон("порядок «колонка (%1) → секции (%2)»", МестоКолонки, МестоСекций)).ЭтоИстина();

КонецПроцедуры

// Каркас не правит разметку дерева: внутри колонки лежит ровно то, что рисует компонент.
// Разойдись они — у инсталляции поедут её собственные правила и сканеры, написанные
// на эту разметку.
&Тест
Процедура КолонкаНесётДеревоКомпонентаБезПравок() Экспорт

	Модель = МодельРазделов(16);

	ВКолонке = МеждуМаркеров(Настройки.Отрисовать(МодельДома(Модель)), "<nav", "</nav>");
	Своё = Разделы.Отрисовать(Новый Структура("Заголовок, Разделы, Ориентация, Класс",
		"Разделы настроек", Модель, "вертикаль", "tree--settings"));

	Ожидаем.Что(ВКолонке, "дерево в колонке — разметка самого компонента").Равно(Своё);

КонецПроцедуры

// Самый длинный дом инсталляции — шестнадцать разделов; в колонку обязаны попасть все.
&Тест
Процедура ВКолонкуПомещаетсяСамыйДлинныйДом() Экспорт

	Колонка = МеждуМаркеров(Настройки.Отрисовать(МодельДома(МодельРазделов(16))),
		"<aside", "</aside>");

	Ожидаем.Что(СтрЧислоВхождений(Колонка, "class=""tree__link"),
		"все шестнадцать разделов в колонке: " + Колонка).Равно(16);
	Ожидаем.Что(СтрНайти(Колонка, "Раздел 16") > 0,
		"включая последний: " + Колонка).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ДействияСекции

// Кнопка «Добавить» стоит справа от заголовка секции, а не над списком: слот печатается
// в шапке секции ПОСЛЕ заголовка и лида — так он и читается, и на телефоне встаёт под лид.
&Тест
Процедура СлотДействийПечатаетсяВШапкеПослеЗаголовкаИЛида() Экспорт

	Действия = Новый Массив();
	Действия.Добавить(Новый Структура("Подпись, Адрес", "Добавить", "/ключи/новый"));
	Секция = Настройки.Секция("Ключи", "Кто может входить без пароля", "<p>тело</p>");
	Секция.Действия = Действия;
	HTML = Настройки.ОтрисоватьСекцию(Секция);

	Заголовок = СтрНайти(HTML, "<h2 class=""section__title"">");
	Лид = СтрНайти(HTML, "<p class=""section__lead"">");
	Слот = СтрНайти(HTML, "<div class=""section__actions"">");
	КонецШапки = СтрНайти(HTML, "</header>");
	Тело = СтрНайти(HTML, "<div class=""section__body"">");

	Ожидаем.Что(Заголовок > 0 И Заголовок < Лид И Лид < Слот И Слот < КонецШапки И КонецШапки < Тело,
		"порядок «заголовок → лид → действия → конец шапки → тело»: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<header class=""section__head section__head--actions"">") > 0,
		"шапка с действиями помечена — её раскладывает сетка: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "href=""/ключи/новый""") > Слот,
		"кнопка из модели нарисована компонентом внутри слота: " + HTML).ЭтоИстина();

КонецПроцедуры

// Пустой слот не печатается вовсе: ни обёртки, ни класса — секции без действий выглядят
// и читаются ровно как прежде.
&Тест
Процедура ПустойСлотДействийНеПечатаетсяВовсе() Экспорт

	Без = Настройки.ОтрисоватьСекцию(Настройки.Секция("Ключи", "лид", "<p>тело</p>"));
	Пустой = Настройки.Секция("Ключи", "лид", "<p>тело</p>");
	Пустой.Действия = Новый Массив();

	Ожидаем.Что(СтрНайти(Без, "section__actions"), "обёртки слота нет: " + Без).Равно(0);
	Ожидаем.Что(СтрНайти(Без, "section__head--actions"), "и пометки шапки тоже").Равно(0);
	Ожидаем.Что(Настройки.ОтрисоватьСекцию(Пустой), "пустой массив — то же, что без поля")
		.Равно(Без);
	Ожидаем.Что(Кит.Секция("Ключи", Кит.Готовое("<p>тело</p>")).Лид("лид").Рендер(),
		"узел без действий — та же разметка").Равно(Без);

КонецПроцедуры

// Узел печатает тот же слот, что и модель: второй холст Действия(д…) у секции то же, что
// поле Действия структуры с готовой разметкой.
&Тест
Процедура ДействияУзлаСекцииРавныПолюМодели() Экспорт

	Узлом = Кит.Секция("Ключи", Кит.Готовое("<p>тело</p>")).Лид("лид")
		.Действия(Кит.Кнопка("Добавить").Адрес("/ключи/новый")).Рендер();

	Модель = Настройки.Секция("Ключи", "лид", "<p>тело</p>");
	Модель.Действия = Кит.Кнопка("Добавить").Адрес("/ключи/новый").Рендер();

	Ожидаем.Что(Узлом, "байт в байт").Равно(Настройки.ОтрисоватьСекцию(Модель));

КонецПроцедуры

// Форма в слоте берёт адрес и токен у дома, как и форма в теле секции.
&Тест
Процедура ФормаВСлотеДействийБерётАдресИТокенДома() Экспорт

	HTML = Кит.ДомНастроек("Ключи", "/проекты/альфа/ключи", "т0кен",
		Кит.Секция("Мои ключи", Кит.Примечание("Ключей пока нет."))
			.Действия(Кит.Форма("новый", Кит.Кнопка("Добавить").Основная()))).Рендер();

	Слот = СтрНайти(HTML, "<div class=""section__actions"">");
	Ожидаем.Что(Слот > 0 И СтрНайти(HTML, "action=""/проекты/альфа/ключи/новый""") > Слот,
		"форма слота постит на адрес дома: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "value=""т0кен""") > Слот, "с его токеном").ЭтоИстина();

КонецПроцедуры

// Справа от заголовка кнопка на телефоне сжала бы его до пары слов: до 640 px шапка
// становится одной колонкой, и кнопка растягивается во всю ширину под лидом.
&Тест
Процедура НаТелефонеДействияВстаютПодЛидомВоВсюШирину() Экспорт

	Колонки = "";
	Растяжка = "";
	Ширина = "";
	Для Каждого Правило Из Разбор.Правила(Разбор.ТекстБазовогоЛиста()) Цикл
		Если НЕ (Разбор.УзкийЭкран(Правило.Условия) И СтрНайти(Правило.Условия, "640px") > 0) Тогда
			Продолжить;
		КонецЕсли;
		Если Правило.Селектор = ".section__head--actions" Тогда
			Колонки = Правило.Объявления.Получить("grid-template-columns");
		ИначеЕсли Правило.Селектор = ".section__actions > *" Тогда
			Растяжка = Правило.Объявления.Получить("flex");
		ИначеЕсли Правило.Селектор = ".section__actions .button" Тогда
			Ширина = Правило.Объявления.Получить("width");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Колонки, "шапка в одну колонку").Равно("minmax(0, 1fr)");
	Ожидаем.Что(Растяжка, "каждое действие — своей строкой во всю ширину").Равно("1 1 100%");
	Ожидаем.Что(Ширина, "кнопка растянута").Равно("100%");

КонецПроцедуры

#КонецОбласти

#Область ШапкаДома

// У короткого дома пояснения нет — и пустого абзаца под заголовком тоже: он дал бы
// лишний отступ и пустую строку скринридеру.
&Тест
Процедура ДомБезПоясненияНеПечатаетПустогоАбзаца() Экспорт

	HTML = Настройки.Отрисовать(Новый Структура("Ключ, Заголовок, Секции",
		"project", "Настройки", Секции()));
	Узлом = Кит.ДомНастроек("Настройки", "/настройки", "",
		Кит.Секция("Общее", Кит.Готовое("<p>тело секции</p>"))).Ключ("project").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "settings__lead"), "абзаца пояснения нет: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<header class=""settings__head""><h1 class=""settings__title"">"
		+ "Настройки</h1></header>") > 0, "шапка — один заголовок: " + HTML).ЭтоИстина();
	Ожидаем.Что(Узлом, "дом узлом без слова Пояснение — то же").Равно(HTML);

КонецПроцедуры

// Крошки дома печатает компонент «Крошки»: последняя — текущая страница, без ссылки.
// Имя навигации у дома своё — прежний ключ словаря.
&Тест
Процедура КрошкиДомаПечатаетКомпонент() Экспорт

	HTML = Кит.ДомНастроек("Ключи", "/проекты/альфа/ключи", "",
		Кит.Секция("Ключи", Кит.Примечание("Ключей пока нет.")))
		.Крошка("Проекты", "/проекты").Крошка("альфа", "/проекты/альфа").Крошка("Ключи", "/ключи")
		.Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<nav class=""crumbs"" aria-label=""Путь к настройкам"">") > 0,
		"имя навигации из словаря: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<li class=""crumbs__item"" aria-current=""page"">Ключи</li>") > 0,
		"последняя крошка — текущая, текстом: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "href=""/ключи"""), "ссылки на саму страницу нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<nav class=""crumbs""") < СтрНайти(HTML, "settings__head"),
		"крошки стоят перед шапкой дома").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Лист

// Класс, у которого правило есть только внутри @media, для потребителя не существует:
// его сканеры такое правило не видят, а на широком экране элемент остаётся неоформленным.
// Правило соседа («.бок .пункт») классу бока не достаётся: оформляется пункт.
&Тест
Процедура КаждыйКлассЭкранаНастроекИмеетПравилоВнеМедиа() Экспорт

	Классы = КлассыЭкранаНастроек();
	Правила = Разбор.Правила(Разбор.ТекстБазовогоЛиста());

	Ожидаем.Что(Классы.Количество() >= 3,
		"классов у экрана настроек: " + Классы.Количество() + " — скан ослеп").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Разбор.КлассыБезБазовогоПравила(Классы, Правила), ", "),
		"классы экрана настроек, у которых правило есть только в @media").Равно("");

	// сканер не ослеп: класс, спрятанный в медиа-блок, он находит — и правилом предка
	// не обманывается
	Пропажа = Новый Массив();
	Пропажа.Добавить("только-в-медиа");
	Ожидаем.Что(Разбор.КлассыБезБазовогоПравила(Пропажа, Разбор.Правила(
			"@media (max-width: 900px) { .только-в-медиа { display: block; } }")).Количество(),
		"правило внутри @media базовым не считается").Равно(1);
	Ожидаем.Что(Разбор.КлассыБезБазовогоПравила(Пропажа, Разбор.Правила(
			".только-в-медиа .кнопка { min-height: 44px; }")).Количество(),
		"правило потомка базовым правилом класса-предка не является").Равно(1);

КонецПроцедуры

// Палец в пункт высотой в 27 px не попадает. На узком экране пункт разделов не ниже 44 px —
// это нижняя граница попадания, а не украшение. Верхнего слоя правило не требует: колонка
// стоит в потоке у любого движка.
&Тест
Процедура ПунктРазделаНаУзкомЭкранеНеМельчеПальца() Экспорт

	Высота = -1;

	Для Каждого Правило Из Разбор.Правила(Разбор.ТекстБазовогоЛиста()) Цикл
		Если Разбор.УзкийЭкран(Правило.Условия) И НЕ Разбор.ТребуетВерхнегоСлоя(Правило.Условия)
			И Разбор.СелекторКасаетсяКласса(Правило.Селектор, "tree__link") Тогда
			Высота = Макс(Высота, Разбор.Пиксели(Правило.Объявления.Получить("min-height")));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Высота >= 44,
		"пункт разделов на узком экране: " + Высота + " px — палец промахивается").ЭтоИстина();

КонецПроцедуры

// Ключ настройки подписывает каждое значение, и на телефоне длинный ключ шире строки.
// Запрети ему переноситься — и вбок поедет ВСЯ страница, а с ней и лист меню, прибитый
// к краям окна. Сначала ряд источника переносится целиком и ключ встаёт своей строкой;
// не влез и так — переносится внутри себя. Годится только anywhere: break-word во флекс-
// ряду не уменьшает минимальную ширину ключа, и ряд всё равно распирает страницу.
&Тест
Процедура КлючНастройкиНаТелефонеНеУводитСтраницуВбок() Экспорт

	ПереносРяда = "";
	Пробелы = "";
	ПереносСлова = "";

	Для Каждого Правило Из Разбор.ПравилаКласса("note-origin") Цикл
		Если Разбор.СелекторСтилизуетКласс(Правило.Селектор, "note-origin")
			И (Правило.Условия = "" ИЛИ Разбор.УзкийЭкран(Правило.Условия))
			И Правило.Объявления.Получить("flex-wrap") <> Неопределено Тогда
			ПереносРяда = НРег(Правило.Объявления.Получить("flex-wrap"));
		КонецЕсли;
	КонецЦикла;

	Для Каждого Правило Из Разбор.ПравилаКласса("text-key") Цикл
		Если СтрНайти(Правило.Селектор, "code") = 0
			ИЛИ (Правило.Условия <> "" И НЕ Разбор.УзкийЭкран(Правило.Условия)) Тогда
			Продолжить;
		КонецЕсли;
		Если Правило.Объявления.Получить("white-space") <> Неопределено Тогда
			Пробелы = НРег(Правило.Объявления.Получить("white-space"));
		КонецЕсли;
		Если Правило.Объявления.Получить("overflow-wrap") <> Неопределено Тогда
			ПереносСлова = НРег(Правило.Объявления.Получить("overflow-wrap"));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(ПереносРяда, "ряд источника переносится, и ключ встаёт своей строкой")
		.Равно("wrap");
	Ожидаем.Что(Пробелы, "на телефоне ключ переносу не запрещён").ЭтоНе().Равно("nowrap");
	Ожидаем.Что(ПереносСлова,
		"ключ длиннее строки переносится внутри себя и не распирает флекс-ряд").Равно("anywhere");

КонецПроцедуры

// Широкий экран: колонка едет со страницей и никем не спрятана. Считается ВЕСЬ каскад
// широкого экрана — последнее слово может сказать и правило под своим медиа-условием.
&Тест
Процедура НаШирокомЭкранеКолонкаВиднаИЛипкая() Экспорт

	Показ = "";
	Положение = "";
	Последнее = "";

	Для Каждого Правило Из Разбор.ПравилаКласса("settings__nav") Цикл

		Если Разбор.УзкийЭкран(Правило.Условия)
			ИЛИ НЕ Разбор.СтилизуетСамЭлемент(Правило.Селектор, "settings__nav") Тогда
			Продолжить;
		КонецЕсли;

		Если Правило.Объявления.Получить("display") <> Неопределено Тогда
			Показ = Правило.Объявления.Получить("display");
			Последнее = Правило.Селектор + " {" + Правило.Условия + "}";
		КонецЕсли;
		Если Правило.Объявления.Получить("position") <> Неопределено Тогда
			Положение = Правило.Объявления.Получить("position");
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(НРег(Показ),
		"последнее слово о показе колонки говорит " + Последнее + " — и это «спрятана»")
		.ЭтоНе().Равно("none");
	Ожидаем.Что(НРег(Положение), "колонка едет со страницей, как и раньше").Равно("sticky");

КонецПроцедуры

// Сканер листа обязан читать КОД: класс из пояснения и класс из строкового литерала
// правила не объявляют, а правило из медиа-блока не становится базовым.
&Тест
Процедура СканПравилНеПитаетсяКомментариямиИЛитералами() Экспорт

	Приманка = "/* .из-комментария { display: none } */" + Символы.ПС
		+ ".живой::before { content: "".из-литерала { display: none }""; color: var(--x); }"
		+ Символы.ПС
		+ "@media (max-width: 900px) { @supports selector(:popover-open) {"
		+ " .вложенный, .второй { min-height: 44px } } }";

	Правила = Разбор.Правила(Приманка);
	Имена = Новый Массив();
	Для Каждого Правило Из Правила Цикл
		Имена.Добавить(Правило.Селектор + " | " + Правило.Условия);
	КонецЦикла;

	Ожидаем.Что(Правила.Количество(),
		"правил в приманке: живое, два вложенных — и ни одного из текста: "
			+ СтрСоединить(Имена, "; ")).Равно(3);
	Ожидаем.Что(Правила[0].Селектор, "селектор живого правила").Равно(".живой::before");
	Ожидаем.Что(Правила[0].Условия, "живое правило работает всегда").Равно("");
	Ожидаем.Что(Правила[0].Объявления.Получить("color"),
		"значение объявления разобрано").Равно("var(--x)");
	Ожидаем.Что(Правила[1].Селектор, "список селекторов разобран поштучно").Равно(".вложенный");
	Ожидаем.Что(СтрНайти(Правила[2].Условия, "@supports") > 0,
		"вложенные условия видны оба: " + Правила[2].Условия).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Правила[2].Условия, "@media") > 0,
		"включая внешнее: " + Правила[2].Условия).ЭтоИстина();

	Ожидаем.Что(Разбор.СелекторКасаетсяКласса(".tree__link--active", "tree__link"),
		"модификатор класса — не сам класс").ЭтоЛожь();
	Ожидаем.Что(Разбор.СелекторКасаетсяКласса(".settings__nav .tree__link", "tree__link"),
		"а вложенный селектор — сам").ЭтоИстина();

	Ожидаем.Что(Разбор.СелекторСтилизуетКласс(".бок .пункт", "бок"),
		"предок в селекторе оформления не получает").ЭтоЛожь();
	Ожидаем.Что(Разбор.СелекторСтилизуетКласс(".бок > .пункт", "пункт"),
		"оформляется то, что стоит последним").ЭтоИстина();
	Ожидаем.Что(Разбор.СелекторСтилизуетКласс(".бок:hover", "бок"),
		"состояние самого элемента — это он сам").ЭтоИстина();

	Ожидаем.Что(Разбор.УзкийЭкран("@media (max-width: 900px)"), "узкий экран виден").ЭтоИстина();
	Ожидаем.Что(Разбор.УзкийЭкран("@media (min-width: 900px)"), "широкий — не узкий").ЭтоЛожь();
	Ожидаем.Что(Разбор.ТребуетВерхнегоСлоя("@media (max-width: 900px) @supports selector(:popover-open)"),
		"условие верхнего слоя видно во вложенных").ЭтоИстина();
	Ожидаем.Что(Разбор.ТребуетВерхнегоСлоя("@media (max-width: 900px) @supports (display: grid)"),
		"чужая проверка возможностей верхнего слоя не обещает").ЭтоЛожь();

	Ожидаем.Что(Разбор.Пиксели("44px"), "размер в пикселях").Равно(44);
	Ожидаем.Что(Разбор.Пиксели("0"), "голый нуль единицы не требует").Равно(0);
	Ожидаем.Что(Разбор.Пиксели("auto"), "размер не пикселями размером не считается").Равно(-1);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДомСРазделами(Знач Количество)
	Возврат Настройки.Отрисовать(МодельДома(МодельРазделов(Количество)));
КонецФункции

Функция МодельДома(Знач СписокРазделов)

	Возврат Новый Структура("Ключ, Заголовок, Объект, Разделы, Секции",
		"project", "Настройки", "альфа", СписокРазделов, Секции());

КонецФункции

Функция МодельРазделов(Знач Количество)

	Результат = Новый Массив();
	Для Номер = 1 По Количество Цикл
		Результат.Добавить(Настройки.Раздел("Раздел " + Номер,
			"/настройки/раздел-" + Номер, "шестерёнка", Номер = 1));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Секции()

	Результат = Новый Массив();
	Результат.Добавить(Настройки.Секция("Общее", "", "<p>тело секции</p>"));
	Возврат Результат;

КонецФункции

// Классы, которыми экран настроек обвязывает разделы. Само дерево вырезано — его разметку
// держит компонент и его собственные правила.
Функция КлассыЭкранаНастроек()

	Кусок = МеждуМаркеров(ДомСРазделами(3), "<div class=""settings__layout""",
		"<div class=""settings__panes""");
	Начало = СтрНайти(Кусок, "<nav");
	Конец = СтрНайти(Кусок, "</nav>");
	Если Начало > 0 И Конец > Начало Тогда
		Кусок = Лев(Кусок, Начало - 1) + Сред(Кусок, Конец + СтрДлина("</nav>"));
	КонецЕсли;

	Результат = Новый Массив();
	Позиция = СтрНайти(Кусок, "class=""");

	Пока Позиция > 0 Цикл
		Хвост = Сред(Кусок, Позиция + 7);
		Для Каждого Имя Из СтрРазделить(Лев(Хвост, СтрНайти(Хвост, """") - 1), " ", Ложь) Цикл
			Если ЗначениеЗаполнено(Имя) И Результат.Найти(Имя) = Неопределено Тогда
				Результат.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
		Позиция = СтрНайти(Кусок, "class=""", НаправлениеПоиска.СНачала, Позиция + 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция МеждуМаркеров(Знач Текст, Знач Начало, Знач Конец)

	От = СтрНайти(Текст, Начало);
	До = СтрНайти(Текст, Конец);
	Возврат ?(От = 0 ИЛИ До = 0, "", Сред(Текст, От, До - От + СтрДлина(Конец)));

КонецФункции

#КонецОбласти
