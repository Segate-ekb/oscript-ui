// Дом настроек на узком экране: разделы уходят в шторку. Проверяется то, что ломается
// для человека с телефона: кнопка открывает не ту панель или не открывает ничего, дом без
// разделов показывает кнопку в пустоту, подпись кнопки не читается скринридером, разделы
// не помещаются или в них не попасть пальцем, а на широком экране колонка пропадает вовсе.

#Использовать "../"
#Использовать asserts

Перем Настройки;      // РендерерНастроек — дом настроек словами пробной инсталляции
Перем БезСловаря;     // РендерерНастроек — тот же дом с пустым словарём кита
Перем Разделы;        // ДеревоРазделов — им же сверяется разметка дерева
Перем Значки;         // Иконка — им же сверяется глиф на кнопке
Перем Разбор;         // РазборЛиста — сканер, читающий КОД листа, а не его текст
Перем Место;          // РаскладкаСтатики — где лежит базовый лист

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьДом() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "РазборЛиста.os"), "РазборЛиста");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Настройки = Слой.Настройки;
	Разделы = Слой.Набор.ДеревоРазделов();
	Значки = Слой.Набор.Иконка();

	БезСловаря = Новый СборкаХолста().Собрать().Настройки;

	Разбор = Новый РазборЛиста();
	Место = Новый РаскладкаСтатики(Новый СтатикаИнсталляцииПоУмолчанию());

КонецПроцедуры

#Область Шторка

// Кнопка называет панель атрибутом popovertarget, панель отзывается своим идентификатором.
// Разойдись они — нажатие не открывает ничего, и разделы на телефоне недостижимы вовсе.
&Тест
Процедура КнопкаОткрываетИменноПанельРазделов() Экспорт

	HTML = ДомСРазделами(3);

	ТегКнопки = ОткрывающийТег(HTML, "button");
	ТегПанели = ОткрывающийТег(HTML, "aside");
	Ид = ЗначениеАтрибута(ТегПанели, "id");

	Ожидаем.Что(Ид, "у панели разделов свой идентификатор: " + ТегПанели).Заполнено();
	Ожидаем.Что(ЗначениеАтрибута(ТегКнопки, "popovertarget"),
		"кнопка открывает ИМЕННО эту панель: " + ТегКнопки).Равно(Ид);
	Ожидаем.Что(СтрНайти(ТегПанели, " popover>") > 0,
		"панель объявлена всплывающей — открытие, Esc и щелчок мимо делает движок: "
			+ ТегПанели).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТегКнопки, "type=""button""") > 0,
		"кнопка ничего не отправляет: на экране настроек она стоит среди форм: "
			+ ТегКнопки).ЭтоИстина();

	// Видимого текста у кнопки нет: пропал глиф — и единственный вход в разделы
	// становится пустым квадратом, по которому не догадаться, что он нажимается.
	Кнопка = МеждуМаркеров(HTML, "<button", "</button>");
	Ожидаем.Что(СтрНайти(Кнопка, "<svg") > 0,
		"на кнопке нарисованы три черты: " + Кнопка).ЭтоИстина();
	Ожидаем.Что(Кнопка, "и это глиф самого кита, а не чужой рисунок")
		.Содержит(Значки.Отрисовать("меню"));

КонецПроцедуры

// Два дома на одной странице — разные идентификаторы: возьми кит имя из данных, и кнопка
// второго дома открывала бы панель первого.
&Тест
Процедура СоседнийДомПолучаетСвойИдентификатор() Экспорт

	Первый = ДомСРазделами(3);
	Второй = ДомСРазделами(3);

	ИдПервого = ЗначениеАтрибута(ОткрывающийТег(Первый, "aside"), "id");
	ИдВторого = ЗначениеАтрибута(ОткрывающийТег(Второй, "aside"), "id");

	Ожидаем.Что(ИдВторого, "идентификаторы соседних домов разные").ЭтоНе().Равно(ИдПервого);
	Ожидаем.Что(ЗначениеАтрибута(ОткрывающийТег(Второй, "button"), "popovertarget"),
		"и кнопка второго открывает свою панель, а не соседнюю").Равно(ИдВторого);

КонецПроцедуры

// Кнопка, открывающая пустоту, — сломанный экран. Дом без разделов остаётся таким же,
// каким был до шторки: ни кнопки, ни панели.
&Тест
Процедура ДомБезРазделовНеПечатаетНиКнопкиНиПанели() Экспорт

	HTML = Настройки.Отрисовать(Новый Структура("Ключ, Заголовок, Секции",
		"project", "Настройки", Секции()));

	Ожидаем.Что(СтрНайти(HTML, "<button"), "кнопки нет: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<aside"), "и панели тоже: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "settings__navtoggle"), "и полосы под кнопку: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "popover"), "и открывать нечего: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "section") > 0, "а секции дома на месте: " + HTML).ЭтоИстина();

КонецПроцедуры

// Кнопка стоит ПЕРЕД панелью и перед секциями: с телефона человек видит вход в разделы
// сразу, а не пролистав всю страницу.
&Тест
Процедура КнопкаСтоитПередПанельюИПередСекциями() Экспорт

	HTML = ДомСРазделами(3);

	МестоКнопки = СтрНайти(HTML, "<button");
	МестоПанели = СтрНайти(HTML, "<aside");
	МестоСекций = СтрНайти(HTML, "settings__panes");

	Ожидаем.Что(МестоКнопки > 0 И МестоКнопки < МестоПанели И МестоПанели < МестоСекций,
		СтрШаблон("порядок «кнопка (%1) → панель (%2) → секции (%3)»: %4",
			МестоКнопки, МестоПанели, МестоСекций, HTML)).ЭтоИстина();

КонецПроцедуры

// Подпись кнопки — единственное, что о ней узнает скринридер: видимого текста у неё нет.
// Слов кит не сочиняет, их даёт словарь инсталляции по своему ключу.
&Тест
Процедура ПодписьКнопкиПриходитИзСловаря() Экспорт

	СоСловарём = ОткрывающийТег(ДомСРазделами(3), "button");
	Пустой = ОткрывающийТег(ДомБезСловаря(), "button");

	Ожидаем.Что(ЗначениеАтрибута(СоСловарём, "aria-label"),
		"кнопку называет словарь инсталляции: " + СоСловарём).Равно("Разделы");
	Ожидаем.Что(ЗначениеАтрибута(СоСловарём, "title"),
		"и подсказка та же — глазом кнопка тоже безымянна").Равно("Разделы");

	Ожидаем.Что(ЗначениеАтрибута(Пустой, "aria-label"),
		"без ключа в словаре видно, ЧЕГО не хватает: " + Пустой)
		.Равно("[?settings.frame.nav.toggle]");

КонецПроцедуры

#КонецОбласти

#Область ДеревоРазделов

// Шторка — новая обёртка, а не новое дерево: внутри панели лежит ровно то, что рисует
// компонент «Дерево разделов». Разойдись они — у инсталляции поедут её собственные
// правила и сканеры, написанные на эту разметку.
&Тест
Процедура ПанельНесётДеревоКомпонентаБезПравок() Экспорт

	Модель = МодельРазделов(16);

	ВПанели = МеждуМаркеров(Настройки.Отрисовать(МодельДома(Модель)), "<nav", "</nav>");
	Своё = Разделы.Отрисовать(Новый Структура("Заголовок, Разделы, Ориентация, Класс",
		"Разделы настроек", Модель, "вертикаль", "tree--settings"));

	Ожидаем.Что(ВПанели, "дерево в панели — разметка самого компонента").Равно(Своё);

КонецПроцедуры

// Самый длинный дом инсталляции — шестнадцать разделов; в панель обязаны попасть все.
&Тест
Процедура ВПанельПомещаетсяСамыйДлинныйДом() Экспорт

	Панель = МеждуМаркеров(Настройки.Отрисовать(МодельДома(МодельРазделов(16))),
		"<aside", "</aside>");

	Ожидаем.Что(СтрЧислоВхождений(Панель, "class=""tree__link"),
		"все шестнадцать разделов в панели: " + Панель).Равно(16);
	Ожидаем.Что(СтрНайти(Панель, "Раздел 16") > 0,
		"включая последний: " + Панель).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Лист

// Класс, у которого правило есть только внутри @media, для потребителя не существует:
// его сканеры такое правило не видят, а на широком экране элемент остаётся неоформленным.
// Правило соседа («.полоса .кнопка») классу полосы не достаётся: оформляется кнопка.
&Тест
Процедура КаждыйКлассЭкранаНастроекИмеетПравилоВнеМедиа() Экспорт

	Классы = КлассыОбвязкиРазделов();
	Правила = Разбор.Правила(ТекстЛиста());

	Ожидаем.Что(Классы.Количество() >= 4,
		"классов у обвязки разделов: " + Классы.Количество() + " — скан ослеп").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(БезБазовогоПравила(Классы, Правила), ", "),
		"классы экрана настроек, у которых правило есть только в @media").Равно("");

	// сканер не ослеп: класс, спрятанный в медиа-блок, он находит — и правилом предка
	// не обманывается
	Пропажа = Новый Массив();
	Пропажа.Добавить("только-в-медиа");
	Ожидаем.Что(БезБазовогоПравила(Пропажа, Разбор.Правила(
			"@media (max-width: 900px) { .только-в-медиа { display: block; } }")).Количество(),
		"правило внутри @media базовым не считается").Равно(1);
	Ожидаем.Что(БезБазовогоПравила(Пропажа, Разбор.Правила(
			".только-в-медиа .кнопка { min-height: 44px; }")).Количество(),
		"правило потомка базовым правилом класса-предка не является").Равно(1);

КонецПроцедуры

// Палец в пункт высотой в 27 px не попадает. На узком экране пункт разделов не ниже 44 px —
// это нижняя граница попадания, а не украшение. Правило обязано работать и БЕЗ верхнего слоя:
// там разделы стоят колонкой в потоке, и тычут в них тем же пальцем.
&Тест
Процедура ПунктРазделаНаУзкомЭкранеНеМельчеПальца() Экспорт

	Высота = -1;

	Для Каждого Правило Из Разбор.Правила(ТекстЛиста()) Цикл
		Если УзкийЭкран(Правило.Условия) И НЕ ТребуетВерхнегоСлоя(Правило.Условия)
			И Разбор.СелекторКасаетсяКласса(Правило.Селектор, "tree__link") Тогда
			Высота = Макс(Высота, Разбор.Пиксели(Правило.Объявления.Получить("min-height")));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Высота >= 44,
		"пункт разделов на узком экране: " + Высота + " px — палец промахивается").ЭтоИстина();

КонецПроцедуры

// Браузер без верхнего слоя до @supports не доходит: для него узкий экран — это панель
// в потоке. Спрячь её там — и разделы дома пропадут с телефона целиком, а кнопка их
// не вернёт: открывать нечем.
&Тест
Процедура БезВерхнегоСлояПанельНаУзкомЭкранеОстаётсяВидимой() Экспорт

	Спрятавшие = Новый Массив();

	Для Каждого Правило Из ПравилаКласса("settings__nav") Цикл
		Если УзкийЭкран(Правило.Условия) И НЕ ТребуетВерхнегоСлоя(Правило.Условия)
			И ЭтоСамаПанель(Правило.Селектор)
			И НРег(Строка(Правило.Объявления.Получить("display"))) = "none" Тогда
			Спрятавшие.Добавить(Правило.Селектор + " {" + Правило.Условия + "}");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Спрятавшие, ", "),
		"правила, прячущие разделы там, где шторки нет").Равно("");

КонецПроцедуры

// Кнопка видна ровно там, где ей есть что открыть. Покажи полосу шире — на широком экране
// появится вторая, никому не нужная кнопка; покажи её без верхнего слоя — человек будет
// жать мёртвую кнопку, пока не догадается прокрутить страницу до разделов.
&Тест
Процедура ПолосаОткрывашкиВиднаТолькоПриРабочейШторке() Экспорт

	Показанная = Новый Массив();
	Лишние = Новый Массив();

	Для Каждого Правило Из ПравилаКласса("settings__navtoggle") Цикл

		Если НЕ Разбор.СелекторСтилизуетКласс(Правило.Селектор, "settings__navtoggle")
			ИЛИ Правило.Объявления.Получить("display") = Неопределено
			ИЛИ НРег(Правило.Объявления.Получить("display")) = "none" Тогда
			Продолжить;
		КонецЕсли;

		Показанная.Добавить(Правило.Условия);
		Если НЕ УзкийЭкран(Правило.Условия) ИЛИ НЕ ТребуетВерхнегоСлоя(Правило.Условия) Тогда
			Лишние.Добавить(Правило.Селектор + " {" + Правило.Условия + "}");
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(Показанная.Количество() > 0,
		"полоса открывашки где-то показывается — иначе входа в разделы нет вовсе").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Лишние, ", "),
		"правила, показывающие кнопку там, где она ничего не откроет").Равно("");

КонецПроцедуры

// Широкий экран остаётся прежним: панель — колонка в потоке. Движок прячет всплывающую
// панель до открытия своим правилом, и не перебей его лист — колонка разделов исчезла бы
// со всех широких экранов разом. Считается ВЕСЬ каскад широкого экрана: последнее слово
// может сказать и правило под своим медиа-условием, лишь бы оно не было про телефон.
&Тест
Процедура НаШирокомЭкранеПанельОстаётсяВидимойКолонкой() Экспорт

	Показ = "";
	Положение = "";
	Последнее = "";

	Для Каждого Правило Из ПравилаКласса("settings__nav") Цикл

		Если УзкийЭкран(Правило.Условия) ИЛИ НЕ ЭтоСамаПанель(Правило.Селектор) Тогда
			Продолжить;
		КонецЕсли;

		Если Правило.Объявления.Получить("display") <> Неопределено Тогда
			Показ = Правило.Объявления.Получить("display");
			Последнее = Правило.Селектор + " {" + Правило.Условия + "}";
		КонецЕсли;
		Если Правило.Объявления.Получить("position") <> Неопределено Тогда
			Положение = Правило.Объявления.Получить("position");
		КонецЕсли;

	КонецЦикла;

	Ожидаем.Что(Показ, "панель объявлена видимой на широком экране").Заполнено();
	Ожидаем.Что(НРег(Показ),
		"последнее слово о показе панели говорит " + Последнее + " — и это «спрятана»")
		.ЭтоНе().Равно("none");
	Ожидаем.Что(НРег(Положение), "колонка едет со страницей, как и раньше").Равно("sticky");

КонецПроцедуры

// Шестнадцать разделов в экран телефона не влезают. Выдвинутая шторка прокручивается сама;
// без этого нижние разделы недостижимы — до них нельзя дотянуться ни пальцем, ни клавишей.
&Тест
Процедура ВыдвинутаяШторкаПрокручиваетсяСама() Экспорт

	Прокрутка = "";

	Для Каждого Правило Из ПравилаКласса("settings__nav") Цикл
		Если УзкийЭкран(Правило.Условия) И СтрНайти(Правило.Селектор, ":popover-open") > 0 Тогда
			Значение = Правило.Объявления.Получить("overflow-y");
			Прокрутка = ?(Значение = Неопределено, Прокрутка, НРег(Значение));
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Прокрутка = "auto" ИЛИ Прокрутка = "scroll",
		"вертикальная прокрутка выдвинутой шторки: «" + Прокрутка + "»").ЭтоИстина();

КонецПроцедуры

// Сканер листа обязан читать КОД: класс из пояснения и класс из строкового литерала
// правила не объявляют, а правило из медиа-блока не становится базовым.
&Тест
Процедура СканПравилНеПитаетсяКомментариямиИЛитералами() Экспорт

	Приманка = "/* .из-комментария { display: none } */" + Символы.ПС
		+ ".живой::before { content: "".из-литерала { display: none }""; color: var(--x); }"
		+ Символы.ПС
		+ "@media (max-width: 900px) { @supports selector(:popover-open) {"
		+ " .вложенный, .второй { min-height: 44px } } }";

	Правила = Разбор.Правила(Приманка);
	Имена = Новый Массив();
	Для Каждого Правило Из Правила Цикл
		Имена.Добавить(Правило.Селектор + " | " + Правило.Условия);
	КонецЦикла;

	Ожидаем.Что(Правила.Количество(),
		"правил в приманке: живое, два вложенных — и ни одного из текста: "
			+ СтрСоединить(Имена, "; ")).Равно(3);
	Ожидаем.Что(Правила[0].Селектор, "селектор живого правила").Равно(".живой::before");
	Ожидаем.Что(Правила[0].Условия, "живое правило работает всегда").Равно("");
	Ожидаем.Что(Правила[0].Объявления.Получить("color"),
		"значение объявления разобрано").Равно("var(--x)");
	Ожидаем.Что(Правила[1].Селектор, "список селекторов разобран поштучно").Равно(".вложенный");
	Ожидаем.Что(СтрНайти(Правила[2].Условия, "@supports") > 0,
		"вложенные условия видны оба: " + Правила[2].Условия).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Правила[2].Условия, "@media") > 0,
		"включая внешнее: " + Правила[2].Условия).ЭтоИстина();

	Ожидаем.Что(Разбор.СелекторКасаетсяКласса(".tree__link--active", "tree__link"),
		"модификатор класса — не сам класс").ЭтоЛожь();
	Ожидаем.Что(Разбор.СелекторКасаетсяКласса(".settings__nav .tree__link", "tree__link"),
		"а вложенный селектор — сам").ЭтоИстина();

	Ожидаем.Что(Разбор.СелекторСтилизуетКласс(".полоса .кнопка", "полоса"),
		"предок в селекторе оформления не получает").ЭтоЛожь();
	Ожидаем.Что(Разбор.СелекторСтилизуетКласс(".полоса > .кнопка", "кнопка"),
		"оформляется то, что стоит последним").ЭтоИстина();
	Ожидаем.Что(Разбор.СелекторСтилизуетКласс(".полоса:hover", "полоса"),
		"состояние самого элемента — это он сам").ЭтоИстина();
	Ожидаем.Что(Разбор.СелекторСтилизуетКласс(".settings__navtoggle", "settings__nav"),
		"общая приставка классом не делает").ЭтоЛожь();

	Ожидаем.Что(УзкийЭкран("@media (max-width: 900px)"), "узкий экран виден").ЭтоИстина();
	Ожидаем.Что(УзкийЭкран("@media (min-width: 900px)"), "широкий — не узкий").ЭтоЛожь();
	Ожидаем.Что(ТребуетВерхнегоСлоя("@media (max-width: 900px) @supports selector(:popover-open)"),
		"условие верхнего слоя видно во вложенных").ЭтоИстина();
	Ожидаем.Что(ТребуетВерхнегоСлоя("@media (max-width: 900px)"),
		"а без него правило работает и в деградации").ЭтоЛожь();
	Ожидаем.Что(ТребуетВерхнегоСлоя("@media (max-width: 900px) @supports (display: grid)"),
		"чужая проверка возможностей верхнего слоя не обещает").ЭтоЛожь();

	Ожидаем.Что(Разбор.Пиксели("44px"), "размер в пикселях").Равно(44);
	Ожидаем.Что(Разбор.Пиксели("auto"), "размер не пикселями размером не считается").Равно(-1);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДомСРазделами(Знач Количество)
	Возврат Настройки.Отрисовать(МодельДома(МодельРазделов(Количество)));
КонецФункции

Функция ДомБезСловаря()
	Возврат БезСловаря.Отрисовать(МодельДома(МодельРазделов(3)));
КонецФункции

Функция МодельДома(Знач СписокРазделов)

	Возврат Новый Структура("Ключ, Заголовок, Объект, Разделы, Секции",
		"project", "Настройки", "альфа", СписокРазделов, Секции());

КонецФункции

Функция МодельРазделов(Знач Количество)

	Результат = Новый Массив();
	Для Номер = 1 По Количество Цикл
		Результат.Добавить(Настройки.Раздел("Раздел " + Номер,
			"/настройки/раздел-" + Номер, "шестерёнка", Номер = 1));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Секции()

	Результат = Новый Массив();
	Результат.Добавить(Настройки.Секция("Общее", "", "<p>тело секции</p>"));
	Возврат Результат;

КонецФункции

// Классы, которыми экран настроек обвязывает разделы: кнопка, её полоса и панель.
// Само дерево вырезано — его разметку держит компонент и его собственные правила.
Функция КлассыОбвязкиРазделов()

	Кусок = МеждуМаркеров(ДомСРазделами(3), "<div class=""settings__layout""",
		"<div class=""settings__panes""");
	Начало = СтрНайти(Кусок, "<nav");
	Конец = СтрНайти(Кусок, "</nav>");
	Если Начало > 0 И Конец > Начало Тогда
		Кусок = Лев(Кусок, Начало - 1) + Сред(Кусок, Конец + СтрДлина("</nav>"));
	КонецЕсли;

	Результат = Новый Массив();
	Позиция = СтрНайти(Кусок, "class=""");

	Пока Позиция > 0 Цикл
		Хвост = Сред(Кусок, Позиция + 7);
		Для Каждого Имя Из СтрРазделить(Лев(Хвост, СтрНайти(Хвост, """") - 1), " ", Ложь) Цикл
			Если ЗначениеЗаполнено(Имя) И Результат.Найти(Имя) = Неопределено Тогда
				Результат.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
		Позиция = СтрНайти(Кусок, "class=""", НаправлениеПоиска.СНачала, Позиция + 1);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция БезБазовогоПравила(Знач Классы, Знач Правила)

	Результат = Новый Массив();

	Для Каждого Класс Из Классы Цикл
		Найдено = Ложь;
		Для Каждого Правило Из Правила Цикл
			Если Правило.Условия = ""
				И Разбор.СелекторСтилизуетКласс(Правило.Селектор, Класс) Тогда
				Найдено = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ Найдено Тогда
			Результат.Добавить(Класс);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПравилаКласса(Знач Класс)

	Результат = Новый Массив();
	Для Каждого Правило Из Разбор.Правила(ТекстЛиста()) Цикл
		Если Разбор.СелекторКасаетсяКласса(Правило.Селектор, Класс) Тогда
			Результат.Добавить(Правило);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Правило оформляет саму панель, а не её псевдоэлемент: у затемнения под шторкой
// (::backdrop) свой показ, и к видимости разделов он отношения не имеет.
Функция ЭтоСамаПанель(Знач Селектор)

	Возврат Разбор.СелекторСтилизуетКласс(Селектор, "settings__nav")
		И СтрНайти(Селектор, "::") = 0;

КонецФункции

// Правило работает только там, где движок знает верхний слой. Сверяется САМА проверка —
// «умеешь ли ты :popover-open», — а не слово «@supports»: под чужим условием (скажем,
// про сетку) правило до движка без верхнего слоя доедет, и деградация останется голой.
Функция ТребуетВерхнегоСлоя(Знач Условия)
	Возврат СтрНайти(Условия, ":popover-open") > 0;
КонецФункции

// Экран телефона: условие ограничивает ширину, и граница не шире 900 px.
Функция УзкийЭкран(Знач Условия)

	Позиция = СтрНайти(Условия, "max-width");
	Если Позиция = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Хвост = Сред(Условия, Позиция + СтрДлина("max-width"));
	Хвост = Сред(Хвост, СтрНайти(Хвост, ":") + 1);
	Граница = Разбор.Пиксели(СокрЛП(Лев(Хвост, СтрНайти(Хвост, ")") - 1)));

	Возврат Граница > 0 И Граница <= 900;

КонецФункции

Функция ТекстЛиста()

	Чтение = Новый ЧтениеТекста(Место.ПолныйПуть(Место.ФайлБазовогоЛиста()),
		КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);

КонецФункции

Функция ОткрывающийТег(Знач HTML, Знач Тег)

	Начало = СтрНайти(HTML, "<" + Тег);
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Конец = СтрНайти(HTML, ">", НаправлениеПоиска.СНачала, Начало);
	Возврат Сред(HTML, Начало, Конец - Начало + 1);

КонецФункции

Функция ЗначениеАтрибута(Знач Тег, Знач Имя)

	Начало = СтрНайти(Тег, Имя + "=""");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Тег, Начало + СтрДлина(Имя) + 2);
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

Функция МеждуМаркеров(Знач Текст, Знач Начало, Знач Конец)

	От = СтрНайти(Текст, Начало);
	До = СтрНайти(Текст, Конец);
	Возврат ?(От = 0 ИЛИ До = 0, "", Сред(Текст, От, До - От + СтрДлина(Конец)));

КонецФункции

#КонецОбласти
