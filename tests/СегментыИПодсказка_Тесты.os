// Сегменты и подсказка (выпуск 0.12). Проверяется то, что ломается для человека: выбор
// не уходит с формой или уходит не тот, отмечено два сегмента или ни одного, скринридер
// не слышит, что это группа и как она называется, набор полей не того сегмента; пояснение
// поля не открывается без скрипта или скринридер не связывает его с полем.

#Использовать "../"
#Использовать asserts

Перем Кит;   // Кит
Перем Набор; // НаборКомпонентов
Перем Лист;  // Строка — базовый лист кита

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Кит = Слой.Кит;
	Набор = Слой.Набор;

	Чтение = Новый ЧтениеТекста(ОбъединитьПути(ОбъединитьПути(КаталогТестов, "..", "src"), "статика", "oscript-ui.css"),
		КодировкаТекста.UTF8);
	Лист = Чтение.Прочитать();
	Чтение.Закрыть();

КонецПроцедуры

#Область Сегменты

// Группа радиокнопок одного имени: выбор уходит с формой без скрипта, скринридер слышит
// «группа переключателей, Тема» — роль и имя группы печатаются всегда.
&Тест
Процедура СегментыГруппаРадиокнопокСИменемИПодписью() Экспорт

	HTML = Тема().Подпись("Тема").Рендер();

	Ожидаем.Что(СтрНачинаетсяС(HTML, "<div class=""segments"" role=""radiogroup"" aria-label=""Тема"">"),
		"корень: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "<input type=""radio"""), "радиокнопок").Равно(3);
	Ожидаем.Что(СтрЧислоВхождений(HTML, "name=""theme"""), "имя у каждой").Равно(3);
	Светлая = СтрНайти(HTML, "value=""light""");
	Тёмная = СтрНайти(HTML, "value=""dark""");
	Системная = СтрНайти(HTML, "value=""auto""");
	Ожидаем.Что(Светлая > 0 И Светлая < Тёмная И Тёмная < Системная, "порядок детей").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""segments__text"">Тёмная</span>") > 0, "подпись сегмента").ЭтоИстина();
	// радиокнопка внутри своей метки: щелчок по подписи выбирает её без for и id
	Ожидаем.Что(СтрЧислоВхождений(HTML, "<label class=""segments__item""><input type=""radio"""), "метка вокруг").Равно(3);
	// галка выбранного — оформление, скринридер её не читает
	Ожидаем.Что(СтрЧислоВхождений(HTML, "<span class=""segments__check"" aria-hidden=""true"">"), "галка скрыта").Равно(3);

КонецПроцедуры

// Отмечен ровно один: без отмеченной группа не отправляет имени вовсе, две отметки
// браузер не покажет. Выбран() у сегмента главнее Выбрано(Значение) у группы, значение,
// которого нет среди сегментов, отмечает первый — как выпадающий список.
&Тест
Процедура ОтмеченРовноОдинСегмент() Экспорт

	Ожидаем.Что(Отмеченный(Тема().Рендер()), "без выбора — первый").Равно("light");
	Ожидаем.Что(Отмеченный(Тема().Выбрано("dark").Рендер()), "по значению").Равно("dark");
	Ожидаем.Что(Отмеченный(Тема().Выбрано("нет-такого").Рендер()), "чужое значение — первый").Равно("light");

	С = Кит.Сегменты("theme", Кит.Сегмент("light", "Светлая"), Кит.Сегмент("dark", "Тёмная"),
		Кит.Сегмент("auto", "Как в системе").Выбран()).Выбрано("dark");
	Ожидаем.Что(Отмеченный(С.Рендер()), "Выбран() главнее Выбрано").Равно("auto");

	Ч = Кит.Сегменты("size", Кит.Сегмент("1", "Один"), Кит.Сегмент("2", "Два")).Выбрано(2);
	Ожидаем.Что(Отмеченный(Ч.Рендер()), "число значением").Равно("2");

КонецПроцедуры

// СохранятьСразу — как у тумблера: признак data-autosubmit у каждой радиокнопки, его
// исполняет раздел «отправка по изменению» скрипта кита. Без слова признака нет.
&Тест
Процедура СохранятьСразуПомечаетКаждуюРадиокнопку() Экспорт

	Ожидаем.Что(СтрЧислоВхождений(Тема().СохранятьСразу().Рендер(), " data-autosubmit"), "у каждой").Равно(3);
	Ожидаем.Что(СтрНайти(Тема().Рендер(), "data-autosubmit"), "без слова").Равно(0);

КонецПроцедуры

&Тест
Процедура МалыеСегментыСвоимКлассом() Экспорт

	HTML = Тема().Малые().Рендер();
	Ожидаем.Что(СтрНачинаетсяС(HTML, "<div class=""segments segments--small"" role=""radiogroup"">"),
		HTML).ЭтоИстина();

КонецПроцедуры

// Дети сегмента — его набор полей: панели под группой в порядке сегментов, у КАЖДОГО
// сегмента своя (пустая — у сегмента без набора), иначе лист сопоставил бы номера не те.
&Тест
Процедура НаборыПолейПанелямиПоПорядкуСегментов() Экспорт

	HTML = Вход().Рендер();

	Ожидаем.Что(СтрНачинаетсяС(HTML, "<div class=""segments-set""><div class=""segments"" role=""radiogroup"""),
		"обёртка и группа первой: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "<div class=""segments__panel"""), "панелей").Равно(3);
	Ключ = СтрНайти(HTML, "<div class=""segments__panel"" data-segment=""key"">");
	Пароль = СтрНайти(HTML, "<div class=""segments__panel"" data-segment=""password"">");
	Без = СтрНайти(HTML, "<div class=""segments__panel"" data-segment=""none""></div>");
	Ожидаем.Что(Ключ > СтрНайти(HTML, "</label></div>"), "панели после группы").ЭтоИстина();
	Ожидаем.Что(Ключ > 0 И Ключ < Пароль И Пароль < Без, "порядок панелей: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""token""") > Ключ И СтрНайти(HTML, "name=""token""") < Пароль,
		"поле набора в своей панели").ЭтоИстина();
	Ожидаем.Что(СтрЗаканчиваетсяНа(HTML, "</div></div>"), "обёртка закрыта").ЭтоИстина();

	// без наборов обёртки нет: сегменты — одна группа
	Ожидаем.Что(СтрНайти(Тема().Рендер(), "segments-set"), "без наборов").Равно(0);

КонецПроцедуры

// Лист переключает наборы по номеру сегмента: правил в нём ровно столько, сколько наборов
// пускает рисователь, — иначе девятый набор не показался бы никогда.
&Тест
Процедура ЛистПереключаетСтолькоНаборов_СколькоПускаетКит() Экспорт

	Предел = Новый Сегменты(Новый ЭкранированиеHTML(), Набор).НаборовНаЛисте();
	Для Номер = 1 По Предел Цикл
		Правило = СтрШаблон(".segments-set:has(> .segments > :nth-child(%1) > :checked) > .segments__panel:nth-child(%2):not(:empty)",
			Формат(Номер, "ЧГ=0"), Формат(Номер + 1, "ЧГ=0"));
		Ожидаем.Что(СтрНайти(Лист, Правило) > 0, "правило набора " + Номер).ЭтоИстина();
	КонецЦикла;
	Ожидаем.Что(СтрНайти(Лист, ":nth-child(" + Формат(Предел + 1, "ЧГ=0") + ") > :checked"),
		"лишних правил").Равно(0);
	// движок без :has() показывает все наборы: прячущее правило — только под @supports
	Ожидаем.Что(СтрНайти(Лист, "@supports selector(:has(*)) {" + Символы.ПС
		+ Символы.Таб + ".segments-set > .segments__panel { display: none; }") > 0, "прячет только :has()").ЭтоИстина();

	Попытка
		Кит.Сегменты("many", Кит.Сегмент("1", "1", "а"), Кит.Сегмент("2", "2"), Кит.Сегмент("3", "3"),
			Кит.Сегмент("4", "4"), Кит.Сегмент("5", "5"), Кит.Сегмент("6", "6"), Кит.Сегмент("7", "7"),
			Кит.Сегмент("8", "8")).Добавить(Кит.Сегмент("9", "9")).Родитель().Рендер();
		Ошибка_ = "";
	Исключение
		Ошибка_ = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Ошибка_, "девять наборов").Содержит("не больше 8");

КонецПроцедуры

// Сегмент, снятый словом Когда, уходит вместе со своим набором: номера не сдвигаются.
&Тест
Процедура СнятыйСегментУноситСвойНабор() Экспорт

	HTML = Кит.Сегменты("auth",
		Кит.Сегмент("key", "Ключ", Кит.Поле("token", "Ключ доступа")).Когда(Ложь),
		Кит.Сегмент("password", "Пароль", Кит.Поле("secret", "Пароль").Секрет())).Рендер();

	Ожидаем.Что(СтрНайти(HTML, "value=""key"""), "сегмент снят").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "data-segment=""key"""), "и его набор").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "name=""token"""), "и поле набора").Равно(0);
	Ожидаем.Что(Отмеченный(HTML), "отмечен оставшийся").Равно("password");

КонецПроцедуры

// Текст из данных экранируется везде: в подписи, в значении, в признаке набора.
&Тест
Процедура СегментыЭкранируютТекст() Экспорт

	HTML = Кит.Сегменты("q", Кит.Сегмент("a""b", "<b>жирно</b>", "x"), Кит.Сегмент("c", "C"))
		.Подпись("Тема <i>").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<b>"), "подпись").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "&lt;b&gt;жирно&lt;/b&gt;") > 0, "подпись экранирована").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "value=""a&quot;b""") > 0, "значение экранировано").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-segment=""a&quot;b""") > 0, "признак набора экранирован").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "aria-label=""Тема &lt;i&gt;""") > 0, "имя группы экранировано").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ДеревоПоказываетСегменты() Экспорт

	Ожидаем.Что(Кит.Холст(Вход()).Дерево(), "дерево").Содержит("  сегменты" + Символы.ПС + "    сегмент");

КонецПроцедуры

// Ошибка сборки называет, что сделать: без имени выбор не уйдёт, без подписи сегменту
// нечего показать, два одинаковых значения сервер не различит.
&Тест
Процедура СегментыОтвергаютНеполноеИЧужое() Экспорт

	Ожидаем.Что(ОшибкаСегментов("БезИмени"), "без имени").Содержит("Кит.Сегменты(""theme""");
	Ожидаем.Что(ОшибкаСегментов("БезПодписи"), "без подписи").Содержит("без подписи");
	Ожидаем.Что(ОшибкаСегментов("Дубль"), "одно значение дважды").Содержит("своё значение");
	Ожидаем.Что(ОшибкаСегментов("Вне"), "сегмент вне сегментов").Содержит("Кит.Сегменты");
	Ожидаем.Что(ОшибкаСегментов("Чужой"), "поле в сегментах").Содержит("сегмент");
	Ожидаем.Что(ОшибкаСегментов("ВыбранНеТам"), "Выбран у поля").Содержит("Кит.Сегмент");
	Ожидаем.Что(ОшибкаСегментов("ВыбраноНеТам"), "Выбрано у ряда").Содержит("Кит.Сегменты");
	Ожидаем.Что(ОшибкаСегментов("МалыеНеТам"), "Малые у ряда").Содержит("Кит.Сегменты");

КонецПроцедуры

#КонецОбласти

#Область Подсказка

// Значок «?» — кнопка, которая открывает поповер атрибутом popovertarget: без скрипта.
// Кнопка не отправляет форму (type="button") и называет себя скринридеру словом словаря.
&Тест
Процедура ПодсказкаКнопкаИПоповерБезСкрипта() Экспорт

	HTML = Кит.Подсказка("Ключ виден в адресе проекта.").Якорь("key-help").Рендер();

	Ожидаем.Что(HTML, "разметка").Равно("<button type=""button"" class=""help"" popovertarget=""key-help"""
		+ " aria-label=""Справка""><span class=""help__mark"" aria-hidden=""true"">?</span></button>"
		+ "<span class=""help__pop"" id=""key-help"" popover>Ключ виден в адресе проекта.</span>");

	Своя = Кит.Подсказка("Текст").Подпись("Что такое ключ?").Рендер();
	Ожидаем.Что(СтрНайти(Своя, "aria-label=""Что такое ключ?""") > 0, "своё имя значка").ЭтоИстина();

	Опасная = Кит.Подсказка("<script>x</script>").Рендер();
	Ожидаем.Что(СтрНайти(Опасная, "<script>"), "текст экранирован").Равно(0);

КонецПроцедуры

// Без якоря идентификатор выдаёт кит: тот же для того же дерева (ответ повторяется байт
// в байт), разный у двух подсказок с одним текстом в разных местах.
&Тест
Процедура ИдентификаторПодсказкиПостоянныйИСвойУКаждой() Экспорт

	Первый = Кит.Холст(Кит.Подсказка("Одно"), Кит.Подсказка("Одно")).Рендер();
	Второй = Кит.Холст(Кит.Подсказка("Одно"), Кит.Подсказка("Одно")).Рендер();
	Ожидаем.Что(Первый, "повторяется").Равно(Второй);

	Ид = ИдентификаторыПоповеров(Первый);
	Ожидаем.Что(Ид.Количество(), "поповеров").Равно(2);
	Ожидаем.Что(Ид[0] <> Ид[1], "у каждой свой: " + Первый).ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(Ид[0], "help-"), Ид[0]).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Первый, "popovertarget=""" + Ид[1] + """") > 0, "кнопка ведёт на свой").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ПодсказкаБезТекстаОтвергается() Экспорт

	Попытка
		Кит.Подсказка("  ");
		Ошибка_ = "";
	Исключение
		Ошибка_ = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Ошибка_, "пустая подсказка").Содержит("Кит.Подсказка(""");

КонецПроцедуры

// Справка поля: значок «?» рядом с подписью, поповер с текстом, и поле ссылается на поповер
// из aria-describedby — скринридер прочтёт пояснение, когда фокус придёт в поле. Значок —
// вне <label>: кнопка внутри метки стала бы её полем. Короткая подсказка остаётся строкой.
&Тест
Процедура СправкаПоляСвязанаСПолемИзAriaDescribedby() Экспорт

	HTML = Кит.Поле("key", "Ключ проекта").Ид("key").Подсказка("латиницей")
		.Справка("Ключ входит в адрес проекта и в имена его файлов; сменить его потом нельзя.").Рендер();

	Ожидаем.Что(HTML, "разметка").Равно("<div class=""field-help""><label class=""field"" for=""key"">"
		+ "<span class=""field__label"">Ключ проекта</span><input class=""field__control"" type=""text"""
		+ " id=""key"" name=""key"" aria-describedby=""key-help""><span class=""field__hint"">латиницей</span>"
		+ "</label><button type=""button"" class=""help"" popovertarget=""key-help"""
		+ " aria-label=""Справка: Ключ проекта""><span class=""help__mark"" aria-hidden=""true"">?</span>"
		+ "</button><span class=""help__pop"" id=""key-help"" popover>Ключ входит в адрес проекта"
		+ " и в имена его файлов; сменить его потом нельзя.</span></div>");

	Ожидаем.Что(ОписаниеПоля(HTML), "описание поля — текст поповера").Равно(ИдентификаторыПоповеров(HTML)[0]);

КонецПроцедуры

// У отбитого поля описание — и отказ, и справка: отказ первым, он важнее.
&Тест
Процедура ОтказИСправкаВОписанииПоля() Экспорт

	HTML = Кит.Поле("key", "Ключ").Ид("key").Ошибка("Ключ занят").Справка("Пояснение").Рендер();
	Ожидаем.Что(ОписаниеПоля(HTML), "описание").Равно("key-err key-help");
	Ожидаем.Что(СтрНайти(HTML, "aria-invalid=""true""") > 0, "отказ на месте").ЭтоИстина();

	// без Ид идентификатор выдаёт кит — постоянный и свой у одноимённых полей в разных формах
	Две = Кит.Холст(Кит.Поле("q", "Поиск").Справка("Ищет по имени"), Кит.Поле("q", "Поиск").Справка("Ищет по имени"))
		.Рендер();
	Ид = ИдентификаторыПоповеров(Две);
	Ожидаем.Что(Ид.Количество(), "поповеров").Равно(2);
	Ожидаем.Что(Ид[0] <> Ид[1], "свои у одноимённых").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Две, "aria-describedby=""" + Ид[0] + """") > 0, "первое поле — на свой").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Две, "aria-describedby=""" + Ид[1] + """") > 0, "второе поле — на свой").ЭтоИстина();

КонецПроцедуры

// Компонент строкой печатает справку сам — тем же полем модели; идентификатор по умолчанию
// из имени, а имя значка — из модели (словаря у компонента нет).
&Тест
Процедура КомпонентСтрокойПечатаетСправкуСам() Экспорт

	HTML = Набор.Поле().Отрисовать(Новый Структура("Имя, Метка, Справка, ПодписьСправки",
		"q", "Поиск", "Ищет по имени и описанию", "Справка: Поиск"));
	Ожидаем.Что(ОписаниеПоля(HTML), "описание").Равно("help-q");
	Ожидаем.Что(СтрНайти(HTML, "popovertarget=""help-q"" aria-label=""Справка: Поиск""") > 0, HTML).ЭтоИстина();

	БезИмени = Набор.Поле().Отрисовать(Новый Структура("Имя, Метка, Справка", "q", "Поиск", "Текст"));
	Ожидаем.Что(СтрНайти(БезИмени, "<span class=""help__mark"">?</span>") > 0,
		"без имени значок называется знаком вопроса, а не молчит").ЭтоИстина();

КонецПроцедуры

// Поле без справки печатается байт в байт как прежде: и простое, и отбитое.
&Тест
Процедура ПолеБезСправкиПрежнее() Экспорт

	Ожидаем.Что(Кит.Поле("name", "Название").Подсказка("коротко").Рендер(), "простое").Равно(
		"<label class=""field""><span class=""field__label"">Название</span><input class=""field__control"""
		+ " type=""text"" name=""name""><span class=""field__hint"">коротко</span></label>");
	Ожидаем.Что(Кит.Поле("name", "Название").Ид("nm").Ошибка("плохо").Рендер(), "отбитое").Равно(
		"<label class=""field field--error"" for=""nm""><span class=""field__label"">Название</span>"
		+ "<input class=""field__control"" type=""text"" id=""nm"" name=""name"" aria-invalid=""true"""
		+ " aria-describedby=""nm-err""><span class=""field__error"" role=""alert"" id=""nm-err"">плохо</span></label>");
	Ожидаем.Что(Кит.Поле("name", "Название").Ошибка("плохо").Рендер(), "отбитое без Ид").Равно(
		"<label class=""field field--error""><span class=""field__label"">Название</span>"
		+ "<input class=""field__control"" type=""text"" name=""name"" aria-invalid=""true"">"
		+ "<span class=""field__error"" role=""alert"">плохо</span></label>");

КонецПроцедуры

&Тест
Процедура СправкаБываетТолькоУПоля() Экспорт

	Попытка
		Кит.Кнопка("Сохранить").Справка("Текст");
		Ошибка_ = "";
	Исключение
		Ошибка_ = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Ошибка_, "у кнопки").Содержит("Справка");

КонецПроцедуры

// На телефоне поповер шириной в экран с полями: не уходит за край, где бы ни стоял значок.
&Тест
Процедура ПоповерНаТелефонеНеУходитЗаКрай() Экспорт

	Ожидаем.Что(СтрНайти(Лист, "max-width: min(312px, calc(100vw - 2 * var(--space-4)));") > 0,
		"ширина не больше экрана с полями").ЭтоИстина();
	Телефон = СтрНайти(Лист, "@media (max-width: 640px) {" + Символы.ПС + Символы.Таб + Символы.Таб + ".help__pop, .field-help > .help__pop {");
	Ожидаем.Что(Телефон > 0, "правило телефона").ЭтоИстина();
	Ожидаем.Что(Сред(Лист, Телефон, 300), "поля 16px").Содержит("left: var(--space-4);");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Тема()
	Возврат Кит.Сегменты("theme", Кит.Сегмент("light", "Светлая"), Кит.Сегмент("dark", "Тёмная"),
		Кит.Сегмент("auto", "Как в системе"));
КонецФункции

Функция Вход()
	Возврат Кит.Сегменты("auth",
		Кит.Сегмент("key", "Ключ", Кит.Поле("token", "Ключ доступа")),
		Кит.Сегмент("password", "Пароль", Кит.Поле("login", "Логин"), Кит.Поле("secret", "Пароль").Секрет()),
		Кит.Сегмент("none", "Без входа")).Подпись("Способ входа");
КонецФункции

// Значение единственной отмеченной радиокнопки; две отметки — провал.
Функция Отмеченный(Знач HTML)

	Ожидаем.Что(СтрЧислоВхождений(HTML, " checked"), "отмечено: " + HTML).Равно(1);
	Хвост = Лев(HTML, СтрНайти(HTML, " checked") - 1);
	Начало = СтрНайти(Хвост, "value=""", НаправлениеПоиска.СКонца) + СтрДлина("value=""");
	Возврат Сред(Хвост, Начало, СтрДлина(Хвост) - Начало);

КонецФункции

Функция ОписаниеПоля(Знач HTML)

	Начало = СтрНайти(HTML, "aria-describedby=""");
	Если Начало = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(HTML, Начало + СтрДлина("aria-describedby="""));
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

Функция ИдентификаторыПоповеров(Знач HTML)

	Результат = Новый Массив();
	Метка = "<span class=""help__pop"" id=""";
	Хвост = HTML;
	Номер = СтрНайти(Хвост, Метка);
	Пока Номер > 0 Цикл
		Хвост = Сред(Хвост, Номер + СтрДлина(Метка));
		Результат.Добавить(Лев(Хвост, СтрНайти(Хвост, """") - 1));
		Номер = СтрНайти(Хвост, Метка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОшибкаСегментов(Знач Случай)

	Попытка
		Если Случай = "БезИмени" Тогда
			Кит.Сегменты(" ", Кит.Сегмент("a", "А"));
		ИначеЕсли Случай = "БезПодписи" Тогда
			Кит.Сегмент("a", "");
		ИначеЕсли Случай = "Дубль" Тогда
			Кит.Сегменты("x", Кит.Сегмент("a", "А"), Кит.Сегмент("a", "Б")).Рендер();
		ИначеЕсли Случай = "Вне" Тогда
			Кит.Холст(Кит.Сегмент("a", "А")).Рендер();
		ИначеЕсли Случай = "Чужой" Тогда
			Кит.Сегменты("x", Кит.Поле("y", "Y"));
		ИначеЕсли Случай = "ВыбранНеТам" Тогда
			Кит.Ряд("действия").Выбран();
		ИначеЕсли Случай = "ВыбраноНеТам" Тогда
			Кит.Ряд("действия").Выбрано("a");
		ИначеЕсли Случай = "МалыеНеТам" Тогда
			Кит.Ряд("действия").Малые();
		КонецЕсли;
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

#КонецОбласти
