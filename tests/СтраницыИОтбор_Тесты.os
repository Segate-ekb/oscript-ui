// Страницы и отбор без перезагрузки (выпуск 0.13, шаг 20). Проверяется то, что ломается
// для человека: без скрипта ссылки страниц, сортировка и отбор — обычные переходы и GET;
// тихий признак стоит там, где его ищет скрипт, и только там, где его просили; «41–60 из 137»
// считает последнюю страницу честно; скринридер слышит порядок сортировки и смену страницы;
// разметка тех, кто новыми словами не пользуется, не меняется.

#Использовать "../"
#Использовать asserts

Перем Кит;   // Кит
Перем Набор; // НаборКомпонентов

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Кит = Слой.Кит;
	Набор = Слой.Набор;

КонецПроцедуры

#Область Пагинация

// «N из M»: какие записи на экране и сколько всего; число страниц считается из записей.
&Тест
Процедура ПагинацияПечатаетДиапазонИзВсего() Экспорт

	HTML = Кит.Пагинация("/проекты", 3).Всего(137).НаСтранице(20).Рендер();

	Ожидаем.Что(HTML).Содержит("<span class=""pagination__status"">Страница 3 из 7</span>");
	Ожидаем.Что(HTML).Содержит("<span class=""pagination__count"">41–60 из 137</span>");
	// диапазон стоит между состоянием и «Вперёд»
	Ожидаем.Что(СтрНайти(HTML, "pagination__status") < СтрНайти(HTML, "pagination__count")
		И СтрНайти(HTML, "pagination__count") < СтрНайти(HTML, "rel=""next"""), HTML).ЭтоИстина();

КонецПроцедуры

// Последняя страница кончается последней записью, а не полной страницей.
&Тест
Процедура ПоследняяСтраницаКончаетсяПоследнейЗаписью() Экспорт

	HTML = Кит.Пагинация("/проекты", 7).Всего(137).НаСтранице(20).Рендер();

	Ожидаем.Что(HTML).Содержит(">121–137 из 137<");
	Ожидаем.Что(HTML).Содержит("Страница 7 из 7");
	Ожидаем.Что(HTML).Не_().Содержит("rel=""next""");

КонецПроцедуры

// Заданное число страниц главнее подсчёта; номер вне диапазона поправлен и в диапазоне.
&Тест
Процедура ЯвноеЧислоСтраницГлавнее() Экспорт

	HTML = Кит.Пагинация("/проекты", 40, 5).Всего(90).НаСтранице(20).Рендер();

	Ожидаем.Что(HTML).Содержит("Страница 5 из 5");
	Ожидаем.Что(HTML).Содержит(">81–90 из 90<");

КонецПроцедуры

// Все записи на одной странице — навигации нет, как и без новых слов.
&Тест
Процедура ОднаСтраницаЗаписейБезНавигации() Экспорт

	Ожидаем.Что(Кит.Пагинация("/проекты", 1).Всего(12).НаСтранице(20).Рендер()).Равно("");
	Ожидаем.Что(Кит.Пагинация("/проекты", 1).Всего(0).НаСтранице(20).Рендер()).Равно("");

КонецПроцедуры

// Без размера страницы диапазон не посчитать: он не печатается, остальное как было.
&Тест
Процедура БезРазмераСтраницыДиапазонаНет() Экспорт

	HTML = Кит.Пагинация("/проекты", 2, 4).Всего(70).Рендер();
	Ожидаем.Что(HTML).Не_().Содержит("pagination__count");
	Ожидаем.Что(HTML).Равно(Кит.Пагинация("/проекты", 2, 4).Рендер());

КонецПроцедуры

// Текст диапазона — из словаря инсталляции.
&Тест
Процедура ДиапазонИзСловаря() Экспорт

	Слой = Новый СборкаХолста().Собрать();
	HTML = Слой.Кит.Пагинация("/проекты", 1).Всего(30).НаСтранице(10).Рендер();
	// у кита свой словарь пуст: ключ виден маркером, а не пропадает молча
	Ожидаем.Что(HTML).Содержит("[?pagination.of]");

КонецПроцедуры

// Тихие ссылки: data-quiet на каждой ссылке страницы, состояние — живая область.
&Тест
Процедура ТихаяПагинацияПомечаетСсылки() Экспорт

	HTML = Кит.Пагинация("/проекты", 2, 5).Параметры("q", "кот").БезПерезагрузки().Рендер();

	Ожидаем.Что(СтрЧислоВхождений(HTML, " data-quiet=""""")).Равно(2);
	Ожидаем.Что(HTML).Содержит("<a href=""/проекты?q=%D0%BA%D0%BE%D1%82&amp;page=1"""
		+ " class=""pagination__link pagination__link--prev"" rel=""prev"" data-quiet="""">");
	Ожидаем.Что(HTML).Содержит("<span class=""pagination__status"" aria-live=""polite"">Страница 2 из 5</span>");
	// без скрипта это обычные ссылки: href на месте
	Ожидаем.Что(СтрЧислоВхождений(HTML, "<a href=""/проекты?")).Равно(2);

КонецПроцедуры

// Слова печатают то же, что поля модели прежнего вида.
&Тест
Процедура СловаПагинацииРавныСтруктуре() Экспорт

	Модель = Новый Структура("Основа, Страница, Всего, НаСтранице, БезПерезагрузки",
		"/проекты", 2, 45, 20, Истина);
	Ожидаем.Что(Кит.Пагинация("/проекты", 2).Всего(45).НаСтранице(20).БезПерезагрузки().Рендер())
		.Равно(Набор.Пагинация().Отрисовать(Модель));

КонецПроцедуры

// Без новых слов разметка байт в байт прежняя.
&Тест
Процедура ПрежняяПагинацияНеМеняется() Экспорт

	Ожидаем.Что(Кит.Пагинация("/документы", 2, 4).Рендер()).Равно(
		"<nav class=""pagination"" aria-label=""Постраничная навигация"">"
		+ "<a href=""/документы?page=1"" class=""pagination__link pagination__link--prev"" rel=""prev"">"
		+ Набор.Иконка().Отрисовать("влево") + "<span>Назад</span></a>"
		+ "<span class=""pagination__status"">Страница 2 из 4</span>"
		+ "<a href=""/документы?page=3"" class=""pagination__link pagination__link--next"" rel=""next"">"
		+ "<span>Вперёд</span>" + Набор.Иконка().Отрисовать("вправо") + "</a></nav>");

КонецПроцедуры

#КонецОбласти

#Область Отбор

// Строка поиска со словом БезПерезагрузки — GET-форма с data-quiet; метод и адрес те же.
&Тест
Процедура ТихаяСтрокаПоиска() Экспорт

	HTML = Кит.СтрокаПоиска("/проекты").Метка("Поиск").Кнопка("Найти").БезПерезагрузки().Рендер();

	Ожидаем.Что(СтрНачинаетсяС(HTML,
		"<form class=""filters"" method=""get"" action=""/проекты"" data-quiet="""">"), HTML).ЭтоИстина();
	Ожидаем.Что(Кит.СтрокаПоиска("/проекты").Метка("Поиск").Кнопка("Найти").Рендер())
		.Не_().Содержит("data-quiet");

КонецПроцедуры

// Род «форма-отбора» берёт общий признак тихой формы.
&Тест
Процедура ТихаяФормаОтбора() Экспорт

	HTML = Кит.ФормаОтбора("/проекты", Кит.Поле("q", "Имя проекта"), Кит.Кнопка("Найти"))
		.БезПерезагрузки().Рендер();

	Ожидаем.Что(СтрНачинаетсяС(HTML, "<form method=""get"" action=""/проекты"""), HTML).ЭтоИстина();
	Ожидаем.Что(Лев(HTML, СтрНайти(HTML, ">"))).Содержит(" data-quiet=""""");

КонецПроцедуры

// Без слова строка поиска печатается, как печаталась.
&Тест
Процедура ПрежняяСтрокаПоискаНеМеняется() Экспорт

	Ожидаем.Что(Кит.СтрокаПоиска("/документы").Метка("Поиск").Кнопка("Найти").Рендер()).Равно(
		Набор.ФормаОтбора().Отрисовать(Новый Структура("Действие, Метка, Кнопка",
			"/документы", "Поиск", "Найти")));
	Ожидаем.Что(СтрНачинаетсяС(Набор.ФормаОтбора().Отрисовать(Новый Структура("Действие, Кнопка",
		"/документы", "Найти")), "<form class=""filters"" method=""get"" action=""/документы"">"))
		.ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Сортировка

// Заголовок сортируемой колонки — ссылка, текущий порядок — aria-sort у th.
&Тест
Процедура СортировкаПечатаетСсылкуИAriaSort() Экспорт

	HTML = Таблица("возр", "").Рендер();

	Ожидаем.Что(HTML).Содержит("<th scope=""col"" aria-sort=""ascending"">"
		+ "<a class=""table__sort"" href=""/проекты?sort=name&amp;order=desc"">Имя</a></th>");
	Ожидаем.Что(HTML).Содержит("<th scope=""col""><a class=""table__sort"""
		+ " href=""/проекты?sort=members"">Участников</a></th>");
	Ожидаем.Что(СтрЧислоВхождений(HTML, "aria-sort")).Равно(1);

	Ожидаем.Что(Таблица("убыв", "").Рендер()).Содержит("aria-sort=""descending""");
	Ожидаем.Что(Таблица("", "").Рендер()).Не_().Содержит("aria-sort");

КонецПроцедуры

// Слово БезПерезагрузки у таблицы делает тихими ссылки сортировки; сама таблица признака
// не носит — его ищет скрипт только у ссылок и форм.
&Тест
Процедура ТихаяСортировкаУТаблицы() Экспорт

	HTML = Таблица("возр", "").БезПерезагрузки().Рендер();

	Ожидаем.Что(СтрЧислоВхождений(HTML, "<a class=""table__sort"" href=")).Равно(2);
	Ожидаем.Что(СтрЧислоВхождений(HTML, " data-quiet=""""")).Равно(2);
	Ожидаем.Что(HTML).Не_().Содержит("<table data-quiet");
	Ожидаем.Что(HTML).Содержит("order=desc"" data-quiet="""">Имя</a>");

КонецПроцедуры

// Колонка ручной сборки тоже сортируется; слово у неё самой делает тихой её ссылку.
&Тест
Процедура СортировкаУКолонкиРучнойСборки() Экспорт

	HTML = Кит.Таблица(
		Кит.Колонка("Имя").Сортировка("/x?sort=name", "убыв").БезПерезагрузки(),
		Кит.Колонка("Роль"),
		Кит.Запись(Кит.Ячейка("Анна"), Кит.Ячейка("автор"))).Рендер();

	Ожидаем.Что(HTML).Содержит("<th scope=""col"" aria-sort=""descending""><a class=""table__sort"""
		+ " href=""/x?sort=name"" data-quiet="""">Имя</a></th><th scope=""col"">Роль</th>");

КонецПроцедуры

// Опасная схема в адресе сортировки ссылкой не печатается: заголовок остаётся текстом.
&Тест
Процедура ОпасныйАдресСортировкиОстаётсяТекстом() Экспорт

	HTML = Кит.Таблица(Кит.Колонка("Имя").Сортировка("javascript:alert(1)", "возр"),
		Кит.Запись(Кит.Ячейка("Анна"))).Рендер();

	Ожидаем.Что(HTML).Не_().Содержит("javascript");
	Ожидаем.Что(HTML).Содержит("<th scope=""col"" aria-sort=""ascending"">Имя</th>");

КонецПроцедуры

// Неизвестный порядок и сортировка не у колонки останавливают сборку с подсказкой.
&Тест
Процедура НеизвестныйПорядокОтвергается() Экспорт

	Попытка
		Кит.Колонка("Имя").Сортировка("/x", "asc");
		ВызватьИсключение "порядок asc принят";
	Исключение
		Ожидаем.Что(ИнформацияОбОшибке().Описание).Содержит("«возр», «убыв»");
	КонецПопытки;

	Попытка
		Кит.Ссылка("/x", "Имя").Сортировка("/x", "возр");
		ВызватьИсключение "сортировка у ссылки принята";
	Исключение
		Ожидаем.Что(ИнформацияОбОшибке().Описание).Содержит("только у колонки");
	КонецПопытки;

КонецПроцедуры

// Без слова заголовок колонки печатается, как печатался, и подпись в карточке — словами.
&Тест
Процедура ПрежняяКолонкаНеМеняется() Экспорт

	Данные = Новый Массив();
	Данные.Добавить(Новый Структура("name, role", "Альфа", "автор"));

	Простая = Кит.Таблица(Данные);
	Простая.Колонка("name", "Имя");
	Ожидаем.Что(Простая.Рендер()).Содержит("<thead><tr><th scope=""col"">Имя</th></tr></thead>");

	Карточками = Кит.Таблица(Данные).Вид("карточками");
	Карточками.Колонка("name", "Имя").Сортировка("/x", "возр");
	Карточками.Колонка("role", "Роль");
	Ожидаем.Что(Карточками.Рендер()).Содержит("data-label=""Роль""");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Таблица проектов из данных с двумя сортируемыми колонками.
Функция Таблица(Знач ПорядокИмени, Знач ПорядокУчастников)

	Данные = Новый Массив();
	Данные.Добавить(Новый Структура("name, members", "Альфа", 3));
	Данные.Добавить(Новый Структура("name, members", "Бета", 5));

	Результат = Кит.Таблица(Данные);
	Результат.Колонка("name", "Имя").Сортировка("/проекты?sort=name&order=desc", ПорядокИмени);
	Результат.Колонка("members", "Участников").Сортировка("/проекты?sort=members", ПорядокУчастников);
	Возврат Результат;

КонецФункции

#КонецОбласти
