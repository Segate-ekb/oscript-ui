// Шаги: длинная форма по одному экрану за раз. Проверяется то, что ломается для человека:
// без скрипта форма не видна целиком или не отправляется, шаги идут не по порядку,
// вернувшаяся с отказом форма открывает не тот шаг, скринридер не слышит, где он.

#Использовать "../"
#Использовать asserts

Перем Кит; // Кит

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");

	Кит = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы()).Кит;

КонецПроцедуры

// Панели печатаются в порядке детей, номер у каждой свой, полоса номеров — в том же
// порядке; начинает первый шаг.
&Тест
Процедура ШагиПечатаютсяПоПорядку() Экспорт

	HTML = Мастер().Рендер();

	Ожидаем.Что(СтрНачинаетсяС(HTML, "<div class=""steps"" data-steps=""1"">"), "корень: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "data-steps-panel"), "панелей").Равно(3);
	Первый = СтрНайти(HTML, "aria-label=""Шаг 1 из 3: Проект""");
	Второй = СтрНайти(HTML, "aria-label=""Шаг 2 из 3: Участники""");
	Третий = СтрНайти(HTML, "aria-label=""Шаг 3 из 3: Проверка""");
	Ожидаем.Что(Первый > 0 И Первый < Второй И Второй < Третий, "порядок панелей: " + HTML).ЭтоИстина();

	Ожидаем.Что(СтрНайти(HTML, "data-steps-go=""1""") < СтрНайти(HTML, "data-steps-go=""2"""),
		"порядок полосы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-steps-go=""2""") < СтрНайти(HTML, "data-steps-go=""3"""),
		"порядок полосы").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""steps__label"">Участники</span>") > 0, "подпись в полосе").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""steps__title"">Проверка</span>") > 0, "подпись панели").ЭтоИстина();

	// поля шага печатаются в его панели
	Ожидаем.Что(СтрНайти(HTML, "name=""name""") > Первый И СтрНайти(HTML, "name=""name""") < Второй,
		"поле первого шага в первой панели").ЭтоИстина();

КонецПроцедуры

// Без скрипта форма видна целиком: панели — раскрывашки подряд, первая открыта, кнопка
// отправки видна; полоса номеров и «Назад / Дальше» спрятаны — их показывает скрипт.
&Тест
Процедура БезСкриптаПанелиПодрядИОтправкаВидна() Экспорт

	HTML = Мастер().Рендер();

	Ожидаем.Что(СтрЧислоВхождений(HTML, "<details class=""panel steps__panel"" data-steps-panel"),
		"панели — раскрывашки").Равно(3);
	Ожидаем.Что(СтрЧислоВхождений(HTML, "<summary class=""panel__head steps__head"">"), "у каждой шапка").Равно(3);
	Ожидаем.Что(СтрЧислоВхождений(HTML, " open>"), "открыта одна").Равно(1);
	Ожидаем.Что(СтрНайти(HTML, "aria-label=""Шаг 1 из 3: Проект"" open>") > 0, "открыта первая").ЭтоИстина();

	Ожидаем.Что(СтрНайти(HTML, "<ol class=""steps__bar"" data-steps-bar hidden>") > 0, "полоса спрятана").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-steps-back hidden>") > 0, "«Назад» спрятана").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-steps-next hidden>") > 0, "«Дальше» спрятана").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span class=""steps__act"" data-steps-submit><button type=""submit""") > 0,
		"отправка видна: " + HTML).ЭтоИстина();

	// «Назад» и «Дальше» форму не отправляют
	Ожидаем.Что(СтрНайти(HTML, "data-steps-next hidden><button type=""button""") > 0, "«Дальше» — не отправка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-steps-back hidden><button type=""button""") > 0, "«Назад» — не отправка").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span>Дальше</span>") > 0, "подпись из словаря").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span>Назад</span>") > 0, "подпись из словаря").ЭтоИстина();

	// кнопки — после всех панелей
	Ожидаем.Что(СтрНайти(HTML, "steps__nav") > СтрНайти(HTML, "Шаг 3 из 3"), "ряд кнопок под панелями").ЭтоИстина();

КонецПроцедуры

// Вернувшаяся с отказом форма открывает шаг, где отказ: человек видит, что исправить.
// Без отказа начинает шаг, помеченный Текущий(); отказ старше пометки.
&Тест
Процедура НачалоОтказИлиТекущий() Экспорт

	Текущий = Кит.Шаги(
		Кит.Шаг("Проект", Кит.Поле("name", "Название")),
		Кит.Шаг("Участники", Кит.Поле("who", "Кто")).Текущий(),
		Кит.Шаг("Проверка", "Всё верно?")).Рендер();
	Ожидаем.Что(СтрНайти(Текущий, "data-steps=""2""") > 0, "Текущий: " + Текущий).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текущий, "Шаг 2 из 3: Участники"" open>") > 0, "открыт Текущий").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Текущий, "<li class=""steps__item"" aria-current=""step""><button type=""button"""
		+ " class=""steps__go"" data-steps-go=""2"">") > 0, "текущий в полосе").ЭтоИстина();

	Отказ = Кит.Шаги(
		Кит.Шаг("Проект", Кит.Поле("name", "Название")).Текущий(),
		Кит.Шаг("Участники", Кит.Группа("Кто", Кит.Поле("who", "Кто").Ошибка("Нет такого"))),
		Кит.Шаг("Проверка", Кит.Поле("ok", "Готово").Ошибка("Отметьте"))).Рендер();
	Ожидаем.Что(СтрНайти(Отказ, "data-steps=""2""") > 0, "первый шаг с отказом: " + Отказ).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(Отказ, " open>"), "открыт один").Равно(1);
	Ожидаем.Что(СтрНайти(Отказ, "Шаг 2 из 3: Участники"" open>") > 0, "открыт шаг с отказом").ЭтоИстина();

КонецПроцедуры

// Снятый словом Когда шаг уходит вместе с номером: «Шаг 2 из 2», а не дыра в счёте.
&Тест
Процедура СнятыйШагУноситНомер() Экспорт

	HTML = Кит.Шаги(
		Кит.Шаг("Проект", "а"),
		Кит.Шаг("Оплата", "б").Когда(Ложь),
		Кит.Шаг("Проверка", "в")).Рендер();

	Ожидаем.Что(СтрЧислоВхождений(HTML, "data-steps-panel"), "панелей").Равно(2);
	Ожидаем.Что(СтрНайти(HTML, "Оплата"), "снятого шага нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "Шаг 2 из 2: Проверка") > 0, "счёт без дыры: " + HTML).ЭтоИстина();

КонецПроцедуры

// Вид «вкладки» — правка: «Назад / Дальше» нет вовсе, отправка видна всегда.
&Тест
Процедура ВидВкладкиБезНазадИДальше() Экспорт

	HTML = Мастер().Вид("вкладки").Рендер();

	Ожидаем.Что(СтрНачинаетсяС(HTML, "<div class=""steps steps--tabs"" data-steps=""1"">"), "класс вида").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-steps-back"), "«Назад» нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "data-steps-next"), "«Дальше» нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "data-steps-submit>") > 0, "отправка видна").ЭтоИстина();

	Ошибка = "";
	Попытка
		Мастер().Вид("ленточкой");
	Исключение
		Ошибка = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Ошибка, "вкладки") > 0, "неизвестный вид с перечнем: " + Ошибка).ЭтоИстина();

КонецПроцедуры

// Кнопка отправки: подпись словом, узел кнопки — как есть, без слова — текст словаря.
&Тест
Процедура КнопкаОтправки() Экспорт

	Подписью = Мастер().Кнопка("Создать проект").Рендер();
	Ожидаем.Что(СтрНайти(Подписью, "data-steps-submit><button type=""submit"" class=""button button--primary"">"
		+ "<span>Создать проект</span>") > 0, "подпись: " + Подписью).ЭтоИстина();

	Узлом = Мастер().Кнопка(Кит.Кнопка("Удалить").Опасная().Имя("do", "drop")).Рендер();
	Ожидаем.Что(СтрНайти(Узлом, "name=""do"" value=""drop""") > 0, "модель узла: " + Узлом).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Узлом, "button--danger") > 0, "вариант узла: " + Узлом).ЭтоИстина();

	БезСлова = Кит.Шаги(Кит.Шаг("Один", "а")).Рендер();
	Ожидаем.Что(СтрНайти(БезСлова, "<span>Отправить</span>") > 0, "словарь steps.submit: " + БезСлова).ЭтоИстина();

КонецПроцедуры

// Доступность: полоса — список, номер скрыт от скринридера, текущий шаг — aria-current,
// у панели имя «Шаг N из M: подпись», у полосы — имя из слова Подпись.
&Тест
Процедура ДоступностьШагов() Экспорт

	HTML = Мастер().Подпись("Новый проект").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<ol class=""steps__bar"" aria-label=""Новый проект"" data-steps-bar hidden>") > 0,
		"имя полосы: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "aria-current=""step"""), "текущий один").Равно(1);
	Ожидаем.Что(СтрЧислоВхождений(HTML, "<span class=""steps__mark"" aria-hidden=""true"">"), "номер скрыт").Равно(6);
	Ожидаем.Что(СтрЧислоВхождений(HTML, "<button type=""button"" class=""steps__go"""), "шаг полосы — кнопка").Равно(3);

	Без = Мастер().Рендер();
	Ожидаем.Что(СтрНайти(Без, "<ol class=""steps__bar"" data-steps-bar hidden>") > 0, "без имени").ЭтоИстина();

КонецПроцедуры

// Подпись шага — данные: она экранируется и в полосе, и в шапке, и в имени панели.
&Тест
Процедура ПодписьШагаЭкранируется() Экспорт

	HTML = Кит.Шаги(Кит.Шаг("<b>Проект</b>", "а")).Рендер();
	Ожидаем.Что(СтрНайти(HTML, "<b>"), "разметка из данных: " + HTML).Равно(0);
	Ожидаем.Что(СтрЧислоВхождений(HTML, "&lt;b&gt;Проект&lt;/b&gt;"), "экранирована трижды").Равно(3);

КонецПроцедуры

// Якорь и признак узла печатаются у корня и у панели, как у любого узла.
&Тест
Процедура ЯкорьИПризнакПечатаются() Экспорт

	HTML = Кит.Шаги(Кит.Шаг("Один", "а").Якорь("шаг-один").Признак("step", "1"))
		.Якорь("мастер").Признак("form", "new").Рендер();
	Ожидаем.Что(СтрНачинаетсяС(HTML, "<div id=""мастер"" class=""steps"" data-form=""new"" data-steps=""1"">"),
		"корень: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<details id=""шаг-один"" class=""panel steps__panel"" data-step=""1"" data-steps-panel") > 0,
		"панель: " + HTML).ЭтоИстина();

КонецПроцедуры

// Шаги без шагов не печатают ничего; дерево показывает шаги и шаг.
&Тест
Процедура ПустыеШагиИДерево() Экспорт

	Ожидаем.Что(Кит.Шаги().Рендер(), "без шагов").Равно("");
	Ожидаем.Что(Кит.Шаги(Кит.Шаг("Один", "а").Когда(Ложь)).Рендер(), "все сняты").Равно("");

	Дерево = Мастер().Дерево();
	Ожидаем.Что(СтрНачинаетсяС(Дерево, "шаги" + Символы.ПС + "  шаг" + Символы.ПС), "дерево: " + Дерево).ЭтоИстина();

КонецПроцедуры

// Внутрь шагов кладут только шаги, шаг без шагов не печатается, шаг без подписи
// не рождается, вид строкой на месте ребёнка — подсказка про .Вид().
&Тест
Процедура ВложениеШагов() Экспорт

	Ожидаем.Что(Ошибка("Текст"), "строка в шагах").Содержит("шаг");
	Ожидаем.Что(Ошибка("Поле"), "поле в шагах").Содержит("шаг");
	Ожидаем.Что(Ошибка("ШагВне"), "шаг вне шагов").Содержит("Кит.Шаги");
	Ожидаем.Что(Ошибка("БезПодписи"), "шаг без подписи").Содержит("подпис");
	Ожидаем.Что(Ошибка("Вид"), "вид строкой").Содержит(".Вид(");

КонецПроцедуры

// Шаги в форме: токен формы первым, шаги — её содержимое.
&Тест
Процедура ШагиВФорме() Экспорт

	HTML = Кит.Форма("/проекты", Мастер()).Токен("т").Рендер();
	Ожидаем.Что(СтрНачинаетсяС(HTML, "<form method=""post"" action=""/проекты""><input type=""hidden"""),
		"форма: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<div class=""steps"" data-steps=""1"">") > 0, "шаги внутри").ЭтоИстина();

КонецПроцедуры

Функция Мастер()

	Возврат Кит.Шаги(
		Кит.Шаг("Проект", Кит.Поле("name", "Название").Обязательное()),
		Кит.Шаг("Участники", Кит.Поле("who", "Кто")),
		Кит.Шаг("Проверка", "Всё верно?"));

КонецФункции

Функция Ошибка(Знач Случай)

	Попытка
		Если Случай = "Текст" Тогда
			Кит.Шаги("просто текст", Кит.Шаг("Один", "а"));
		ИначеЕсли Случай = "Поле" Тогда
			Кит.Шаги(Кит.Поле("x", "X"));
		ИначеЕсли Случай = "ШагВне" Тогда
			Кит.Холст(Кит.Шаг("Один", "а")).Рендер();
		ИначеЕсли Случай = "БезПодписи" Тогда
			Кит.Шаг("  ", "а");
		ИначеЕсли Случай = "Вид" Тогда
			Кит.Шаги("вкладки");
		КонецЕсли;
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "исключения не было";

КонецФункции
