// Дерево галок на тысячу пунктов (выпуск 0.13, шаг 23): что видит человек без скрипта —
// первые 50 детей ветки и ссылка «Показать ещё» на адрес ветки, сегменты режима ветки,
// поле поиска с кнопкой отправки на адрес поиска, ответ поиска с «Включить / Снять
// найденные»; ответы сервера (страница ветки, ответ поиска) — той же печатью; разбор правок.
// Дерево без новых слов печатается прежним, байт в байт.

#Использовать "../"
#Использовать asserts

Перем Кит;      // Кит — фабрика элементов экрана
Перем Набор;    // НаборКомпонентов

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Кит = Слой.Кит;
	Набор = Слой.Набор;

КонецПроцедуры

#Область ПрежнееДерево

// Разметка, которую печатал выпуск 0.12: без полей 0.13 она обязана остаться такой же —
// на неё опираются лист и скрипты страниц.
&Тест
Процедура ДеревоБезНовыхСловПечатаетсяКакПрежде() Экспорт

	Ожидаемое = "<ul class=""checktree"" data-checktree aria-label=""Где работаем""><li class=""checktree__node"">"
		+ "<details class=""checktree__branch"" open><summary class=""checktree__toggle""><span class=""visually-hidden"">"
		+ "Север</span></summary><ul class=""checktree__children""><li class=""checktree__node""><div class=""checktree__row"">"
		+ "<label class=""checktree__item""><input type=""checkbox"" class=""checktree__box"" data-checktree-box name=""г1"""
		+ " value=""1"" data-checktree-state=""on"" checked data-key=""г1""><span class=""checktree__label"">Мурманск</span>"
		+ "</label></div></li><li class=""checktree__node""><div class=""checktree__row""><label class=""checktree__item"">"
		+ "<input type=""checkbox"" class=""checktree__box"" data-checktree-box name=""г2"" value=""весь"""
		+ " data-checktree-state=""off"" disabled><span class=""checktree__label"">Кола</span></label></div></li></ul>"
		+ "<p class=""checktree__more"">Показаны 2 из 40</p></details><div class=""checktree__row""><label class=""checktree__item"">"
		+ "<input type=""checkbox"" class=""checktree__box"" data-checktree-box name=""к1"" value=""1"""
		+ " data-checktree-state=""mixed"" checked aria-checked=""mixed""><span class=""checktree__label"">Север</span></label>"
		+ "<span class=""checktree__note"">2 города</span></div></li><li class=""checktree__node""><div class=""checktree__row"">"
		+ "<label class=""checktree__item""><input type=""checkbox"" class=""checktree__box"" data-checktree-box name=""к2"""
		+ " value=""1"" data-checktree-state=""off""><span class=""checktree__label"">Юг</span></label>"
		+ "<span class=""checktree__marks""><span class=""tag"">столица</span></span></div></li></ul>";

	Ожидаем.Что(Набор.ДеревоГалок().Отрисовать(МодельПрежнего()), "компонент строкой").Равно(Ожидаемое);
	Ожидаем.Что(Кит.ДеревоГалок(МодельПрежнего()).Рендер(), "узел из структуры").Равно(Ожидаемое);
	Ожидаем.Что(Кит.ДеревоГалок(МодельПрежнего().Узлы).Подпись("Где работаем").Рендер(), "узел словами")
		.Равно(Ожидаемое);

КонецПроцедуры

// Без адреса ветке неоткуда взять остальное: она печатает всех детей, как прежде.
&Тест
Процедура БезАдресаВеткаПечатаетВсехДетей() Экспорт

	HTML = Кит.ДеревоГалок(Узлы(1, 120)).Режимы().Рендер();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "data-checktree-box"), "все дети ветки").Равно(120);
	Ожидаем.Что(СтрНайти(HTML, "data-checktree-more"), "и никакого «Показать ещё»").Равно(0);

КонецПроцедуры

// Компонент, собранный руками по-старому (три зависимости), печатает прежнее дерево,
// а поля 0.13 просит собрать его целиком.
&Тест
Процедура СобранныйПоСтаромуПечатаетПрежнееДерево() Экспорт

	Экран = Новый ЭкранированиеHTML();
	Модели = Новый ЧтениеМодели();
	Старый = Новый ДеревоГалок(Экран, Модели, Набор.Тег());
	Ожидаем.Что(Старый.Отрисовать(МодельПрежнего()), "прежнее дерево")
		.Равно(Набор.ДеревоГалок().Отрисовать(МодельПрежнего()));

	Модель = МодельПрежнего();
	Модель.Вставить("Адрес", "/дерево/ветка");
	Ожидаем.Что(Ошибка(Старый, Модель), "поля 0.13 без зависимостей").Содержит("со всеми зависимостями");

КонецПроцедуры

#КонецОбласти

#Область СтраницыВетки

&Тест
Процедура АдресПечатаетПервыеПятьдесятИСсылкуПоказатьЕщё() Экспорт

	HTML = Кит.ДеревоГалок(Узлы(1, 120)).Адрес("/дерево/ветка").Рендер();
	Ветка = МеждуМаркеров(HTML, "<ul class=""checktree__children"" data-checktree-page=""п1"">", "</ul>");

	Ожидаем.Что(СтрЧислоВхождений(Ветка, "data-checktree-box"), "без скрипта — первые 50")
		.Равно(Набор.ДеревоГалок().РазмерСтраницы());
	Ожидаем.Что(Ветка, "первый ребёнок напечатан").Содержит("name=""у1""");
	Ожидаем.Что(СтрНайти(Ветка, "name=""у51"""), "пятьдесят первый — уже нет").Равно(0);

	Ещё = МеждуМаркеров(HTML, "<p class=""checktree__more checktree__page"" data-checktree-more=""п1"">", "</p>");
	Ожидаем.Что(Ещё, "«Показать ещё» — настоящая ссылка на вторую страницу ветки")
		.Содержит("<a href=""/дерево/ветка?" + Код("ветка") + "=" + Код("п1") + "&amp;" + Код("страница") + "=2""");
	Ожидаем.Что(Ещё, "подпись ссылки").Содержит("Показать ещё");
	Ожидаем.Что(Ещё, "и счёт показанного").Содержит("Показано 50 из 120");
	Ожидаем.Что(HTML, "дерево в обёртке для скрипта").Содержит("<div class=""checktree-set"" data-checktree-set>");
	Ожидаем.Что(HTML, "корень — тоже страница").Содержит("data-checktree data-checktree-page=""""");

КонецПроцедуры

&Тест
Процедура ВсёПоказаноСсылкиНет() Экспорт

	HTML = Кит.ДеревоГалок(Узлы(1, 30)).Адрес("/дерево/ветка").Рендер();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "data-checktree-box"), "все тридцать и ветка").Равно(31);
	Ожидаем.Что(СтрНайти(HTML, "data-checktree-more"), "ссылки нет").Равно(0);

КонецПроцедуры

// Ветка без напечатанных детей и с числом их на сервере — ленивая: дети приедут при
// раскрытии, а без скрипта ссылка ведёт на первую страницу.
&Тест
Процедура ВеткаБезДетейСЧисломГрузитсяПоАдресу() Экспорт

	Узлы = Новый Массив();
	Узлы.Добавить(Новый Структура("Имя, Подпись, Всего", "п2", "Бета", 7));
	HTML = Кит.ДеревоГалок(Узлы).Адрес("/дерево/ветка?проект=1").Рендер();

	Ожидаем.Что(HTML, "ветка с пустым списком").Содержит("<ul class=""checktree__children"" data-checktree-page=""п2""></ul>");
	Ожидаем.Что(HTML, "ссылка на первую страницу, адрес с запросом дописан через &")
		.Содержит("href=""/дерево/ветка?проект=1&amp;" + Код("ветка") + "=" + Код("п2") + "&amp;" + Код("страница") + "=1""");
	Ожидаем.Что(HTML, "счёт").Содержит("Показано 0 из 7");

КонецПроцедуры

// Ответ адреса ветки — фрагмент: список с ключом ветки и «Показать ещё» до следующей.
&Тест
Процедура СтраницаВеткиПечатаетсяФрагментом() Экспорт

	HTML = Кит.ДеревоГалок(Узлы(51, 100)[0].Дети).Адрес("/дерево/ветка").Ветка("п1", 2, 120).Рендер();

	Ожидаем.Что(СтрНачинаетсяС(HTML, "<ul class=""checktree"" data-checktree-page=""п1"">"),
		"фрагмент — список ветки без обёртки: " + Лев(HTML, 120)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-checktree-set"), "ни обёртки").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "data-checktree-search"), "ни поиска").Равно(0);
	Ожидаем.Что(HTML, "следующая — третья").Содержит(Код("страница") + "=3""");
	Ожидаем.Что(HTML, "показано с прошлыми страницами").Содержит("Показано 100 из 120");

	Последняя = Кит.ДеревоГалок(Узлы(101, 120)[0].Дети).Адрес("/дерево/ветка").Ветка("п1", 3, 120).Рендер();
	Ожидаем.Что(СтрНайти(Последняя, "data-checktree-more"), "последняя страница — без ссылки").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область РежимыВетки

&Тест
Процедура РежимВеткиПечатаетсяСегментамиВместоГалки() Экспорт

	HTML = Кит.ДеревоГалок(Узлы(1, 3, "частично")).Режимы().Рендер();
	Строка_ = МеждуМаркеров(HTML, "</details><div class=""checktree__row"">", "</li>");

	Ожидаем.Что(Строка_, "группа радиокнопок с именем ветки для скринридера")
		.Содержит("<div class=""segments segments--small checktree__modes"" role=""radiogroup"""
			+ " aria-label=""Режим ветки «Альфа»"" data-checktree-modes=""п1"">");
	Ожидаем.Что(СтрЧислоВхождений(Строка_, "name=""режим:п1"""), "три режима одним именем ветки").Равно(3);
	Ожидаем.Что(Строка_, "«частично» — режим «выбранные»").Содержит("value=""выбранные"" checked");
	Ожидаем.Что(Строка_, "подписи режимов").Содержит(">Никакие</span>");
	Ожидаем.Что(СтрНайти(Строка_, "data-checktree-box"), "галки у ветки с режимами нет").Равно(0);
	Ожидаем.Что(Строка_, "подпись ветки — текстом").Содержит("<span class=""checktree__item""><span class=""checktree__label"">Альфа</span></span>");
	Ожидаем.Что(СтрЧислоВхождений(HTML, "data-checktree-box"), "у детей галки на месте").Равно(3);

КонецПроцедуры

&Тест
Процедура РежимБерётсяИзМоделиИлиСостояния() Экспорт

	Узлы = Новый Массив();
	Узлы.Добавить(Новый Структура("Имя, Подпись, Дети", "п1", "Альфа", Новый Массив()));
	Узлы.Добавить(Новый Структура("Имя, Подпись, Состояние, Дети", "п2", "Бета", "выкл", Новый Массив()));
	Узлы.Добавить(Новый Структура("Имя, Подпись, Режим, Дети, Отключён", "п3", "Гамма", "Выбранные", Новый Массив(), Истина));
	HTML = Кит.ДеревоГалок(Узлы).Режимы().Рендер();

	Ожидаем.Что(HTML, "«вкл» — все").Содержит("name=""режим:п1"" value=""все"" checked");
	Ожидаем.Что(HTML, "«выкл» — никакие").Содержит("name=""режим:п2"" value=""никакие"" checked");
	Ожидаем.Что(HTML, "явный режим, отключённая ветка").Содержит("name=""режим:п3"" value=""выбранные"" checked disabled");

	Чужие = Новый Массив();
	Чужие.Добавить(Новый Структура("Имя, Подпись, Режим, Дети", "п4", "Дельта", "половина", Новый Массив()));
	Ожидаем.Что(Ошибка(Набор.ДеревоГалок(), Новый Структура("Узлы, Режимы", Чужие, Истина)), "чужой режим")
		.Содержит("режима ветки «половина»");

КонецПроцедуры

// Ключ узла — своё значение галки, иначе имя: по нему сервер узнаёт ветку в адресе
// и в правках.
&Тест
Процедура КлючВеткиСвоёЗначениеИначеИмя() Экспорт

	Узлы = Новый Массив();
	Узлы.Добавить(Новый Структура("Имя, Значение, Подпись, Всего", "проект", "alpha", "Альфа", 3));
	HTML = Кит.ДеревоГалок(Узлы).Адрес("/дерево/ветка").Режимы().Рендер();

	Ожидаем.Что(HTML, "список ветки").Содержит("data-checktree-page=""alpha""");
	Ожидаем.Что(HTML, "режим ветки").Содержит("name=""режим:alpha""");
	Ожидаем.Что(HTML, "адрес ветки").Содержит(Код("ветка") + "=alpha");

КонецПроцедуры

#КонецОбласти

#Область Поиск

&Тест
Процедура ПоискНадДеревомПолеИКнопкаОтправкиНаСвойАдрес() Экспорт

	HTML = Кит.ДеревоГалок(Узлы(1, 2)).Поиск("/дерево/поиск").Рендер();
	Поиск = МеждуМаркеров(HTML, "<div class=""checktree__search"" role=""search"" data-checktree-search>", "</div>");

	Ожидаем.Что(Поиск, "поле поиска с подписью").Содержит("<span class=""field__label"">Найти в дереве</span>"
		+ "<input class=""field__control"" type=""search"" name=""найти"" autocomplete=""off"">");
	Ожидаем.Что(Поиск, "без скрипта кнопка отправляет форму на адрес поиска, не спрашивая полей")
		.Содержит("formaction=""/дерево/поиск"" formnovalidate><span>Найти</span></button>");
	Ожидаем.Что(СтрНайти(HTML, "<div class=""checktree__search""") < СтрНайти(HTML, "<ul class=""checktree"" data-checktree"),
		"поиск — над деревом").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОтветПоискаЗаменяетВеткиСпискомСовпадений() Экспорт

	HTML = Кит.ДеревоГалок(Узлы(1, 60)[0].Дети).Поиск("/дерево/поиск").Найдено("Уч", 75).Рендер();
	Найдено = МеждуМаркеров(HTML, "<div class=""checktree__found"" data-checktree-found>", "</ul>");

	Ожидаем.Что(Найдено, "число найденного — скринридеру")
		.Содержит("<p class=""checktree__found-count"" role=""status"">По запросу «Уч» найдено: 75</p>");
	Ожидаем.Что(Найдено, "«Включить найденные» — кнопка формы").Содержит("name=""найденные"" value=""вкл"" formnovalidate>"
		+ "<span>Включить найденные</span>");
	Ожидаем.Что(Найдено, "«Снять найденные»").Содержит("name=""найденные"" value=""выкл"" formnovalidate>");
	Ожидаем.Что(СтрЧислоВхождений(Найдено, "data-checktree-box"), "совпадения — первые 50").Равно(50);
	Ожидаем.Что(HTML, "что показано не всё").Содержит("Показано 50 из 75 — уточните запрос");
	Ожидаем.Что(СтрНайти(HTML, "<ul class=""checktree"" data-checktree"), "веток в ответе нет").Равно(0);
	Ожидаем.Что(HTML, "поле поиска помнит строку").Содержит("value=""Уч""");

	Пусто = Кит.ДеревоГалок().Найдено("<b>").Рендер();
	Ожидаем.Что(Пусто, "ничего не нашлось — тоже ответ, строка экранирована")
		.Содержит("role=""status"">По запросу «&lt;b&gt;» ничего не нашлось</p>");
	Ожидаем.Что(СтрНайти(Пусто, "найденные"), "без совпадений кнопок нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Правки

&Тест
Процедура ТолькоПравкиПечатаютРядПлашекИШаблон() Экспорт

	HTML = Кит.ДеревоГалок(Узлы(1, 2)).ТолькоПравки().Рендер();

	Ожидаем.Что(HTML, "обёртка говорит скрипту отдавать правки")
		.Содержит("<div class=""checktree-set"" data-checktree-set data-checktree-edits-only>");
	Ожидаем.Что(HTML, "ряд правок спрятан без скрипта")
		.Содержит("<div class=""checktree__edits"" data-checktree-edits hidden>");
	Ожидаем.Что(HTML, "шаблон плашки с текстами словаря").Содержит("<template data-checktree-chip"
		+ " data-checktree-text-on=""+ %1"" data-checktree-text-off=""− %1"" data-checktree-text-mode=""%1: %2"">");
	Ожидаем.Что(HTML, "крестик плашки назван").Содержит("aria-label=""Отменить правку «%1»"" data-checktree-undo>");
	Ожидаем.Что(СтрНайти(HTML, "</ul><div class=""checktree__edits""") > 0, "ряд правок — под деревом").ЭтоИстина();
	Ожидаем.Что(HTML, "без скрипта галки уходят как обычно").Содержит("name=""у1"" value=""1""");

	Без = Кит.ДеревоГалок(Узлы(1, 2)).Режимы().Рендер();
	Ожидаем.Что(СтрНайти(Без, "data-checktree-edits"), "без слова ряда правок нет").Равно(0);

КонецПроцедуры

&Тест
Процедура ПравкиРазбираютсяИзТелаФормы() Экспорт

	Тело = "правки=1&включить=" + Код("у 1") + "&включить=b&снять=c&режим=" + Код("p:1:все")
		+ "&" + Код("режим:п2") + "=" + Код("никакие") + "&режим=" + Код("x:половина") + "&_csrf=t";
	Итог = Набор.ДеревоГалок().РазобратьПравки(Тело);

	Ожидаем.Что(Итог.Правки, "форма прислала правки").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Итог.Включить, ","), "включить — все, по порядку").Равно("у 1,b");
	Ожидаем.Что(СтрСоединить(Итог.Снять, ","), "снять").Равно("c");
	Ожидаем.Что(Итог.Режимы.Получить("p:1"), "правка режима делится по последнему двоеточию").Равно("все");
	Ожидаем.Что(Итог.Режимы.Получить("п2"), "радиокнопка режима без скрипта").Равно("никакие");
	Ожидаем.Что(Итог.Режимы.Получить("x"), "чужой режим отброшен").Равно(Неопределено);

	Галки = Набор.ДеревоГалок().РазобратьПравки("у1=1&у2=1");
	Ожидаем.Что(Галки.Правки, "без скрипта пришли галки, а не правки").ЭтоЛожь();
	Ожидаем.Что(Набор.ДеревоГалок().РазобратьПравки(Неопределено).Включить.Количество(), "пустое тело").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Слова

// Слова узла пишут поля модели: узел словами печатает то же, что компонент со структурой.
&Тест
Процедура СловаДереваПечатаютТоЖеЧтоСтруктура() Экспорт

	Модель = Новый Структура("Подпись, Узлы, Адрес, Поиск, Режимы, ТолькоПравки", "Кто в проектах",
		Узлы(1, 60), "/дерево/ветка", "/дерево/поиск", Истина, Истина);
	Словами = Кит.ДеревоГалок()
		.Подпись("Кто в проектах")
		.Узел(Узлы(1, 60)[0])
		.Адрес("/дерево/ветка")
		.Поиск("/дерево/поиск")
		.Режимы()
		.ТолькоПравки()
		.Рендер();

	Ожидаем.Что(Словами, "слова = структура").Равно(Набор.ДеревоГалок().Отрисовать(Модель));

	Попытка
		Кит.ДеревоГалок(Узлы(1, 2)).Сведение("x", "y");
		Отказ = "";
	Исключение
		Отказ = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(Отказ, "чужое слово отвергается с перечнем слов дерева").Содержит("ТолькоПравки");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ветка «Альфа» (ключ п1) с детьми у<Первый>…у<Последний>.
Функция Узлы(Знач Первый, Знач Последний, Знач Состояние = "вкл")

	Дети = Новый Массив();
	Для Номер = Первый По Последний Цикл
		Дети.Добавить(Новый Структура("Имя, Подпись, Состояние", "у" + Формат(Номер, "ЧГ=0"),
			"Участник " + Формат(Номер, "ЧГ=0"), ?(Номер % 2 = 0, "вкл", "выкл")));
	КонецЦикла;
	Узлы = Новый Массив();
	Узлы.Добавить(Новый Структура("Имя, Подпись, Состояние, Дети", "п1", "Альфа", Состояние, Дети));
	Возврат Узлы;

КонецФункции

Функция МодельПрежнего()

	Данные = Новый Соответствие();
	Данные.Вставить("key", "г1");
	Дети = Новый Массив();
	Дети.Добавить(Новый Структура("Имя, Подпись, Данные", "г1", "Мурманск", Данные));
	Дети.Добавить(Новый Структура("Имя, Подпись, Значение, Состояние, Отключён", "г2", "Кола", "весь", "выкл", Истина));
	Признаки = Новый Массив();
	Признаки.Добавить("столица");
	Узлы = Новый Массив();
	Узлы.Добавить(Новый Структура("Имя, Подпись, Пояснение, Состояние, Дети, Открыт, Примечание",
		"к1", "Север", "2 города", "частично", Дети, Истина, "Показаны 2 из 40"));
	Узлы.Добавить(Новый Структура("Имя, Подпись, Состояние, Признаки", "к2", "Юг", "выкл", Признаки));
	Возврат Новый Структура("Подпись, Узлы", "Где работаем", Узлы);

КонецФункции

Функция Код(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция Ошибка(Знач Компонент, Знач Модель)

	Попытка
		Компонент.Отрисовать(Модель);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция МеждуМаркеров(Знач Текст, Знач Начало, Знач Конец)

	Открытие = СтрНайти(Текст, Начало);
	Если Открытие = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Открытие + СтрДлина(Начало));
	Закрытие = СтрНайти(Хвост, Конец);
	Возврат ?(Закрытие = 0, Хвост, Лев(Хвост, Закрытие - 1));

КонецФункции

#КонецОбласти
