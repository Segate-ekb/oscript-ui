// Соответствие Material Design 3. Кит заявляет облик Material — значит токены темы обязаны
// нести словарь системы целиком и с её значениями, пары ролей — оставаться читаемыми при
// ЛЮБОМ акценте, который выберет посетитель, а базовый лист — брать формы, тени, движение
// и кегли из токенов, а не записывать их мимо. Всё проверяется без браузера: разбором
// печатаемых токенов и кода листа.
//
// Списки ролей, стилей шрифта и ступеней здесь выписаны РУКАМИ из спецификации
// (m3.material.io), а не взяты у кита: сверка кита с самим собой ничего бы не доказала.

#Использовать "../"
#Использовать asserts

Перем Токены;  // ТокеныТемы
Перем Разбор;  // РазборЛиста

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура Подготовить() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	ПодключитьСценарий(ОбъединитьПути(КаталогТестов, "фикстуры", "РазборЛиста.os"), "РазборЛиста");

	Токены = Новый ТокеныТемы();
	Разбор = Новый РазборЛиста();

КонецПроцедуры

#Область Цвет

// Каждая роль цвета Material 3 объявлена в обеих темах: роль, которой нет в одной из них,
// превращает правило листа в пустое место ровно в этой теме.
&Тест
Процедура ТокеныОбъявляютВсеРолиЦветаВОбеихТемах() Экспорт

	Для Каждого Тема Из Темы() Цикл

		Объявления = ОбъявленияТемы(Неопределено, Тема);
		Недостающие = Новый Массив();
		Для Каждого Роль Из РолиMaterial() Цикл
			Если Объявления.Получить("--md-sys-color-" + Роль) = Неопределено Тогда
				Недостающие.Добавить(Роль);
			КонецЕсли;
		КонецЦикла;

		Ожидаем.Что(СтрСоединить(Недостающие, ", "),
			"роли Material 3, которых нет в теме «" + Тема + "»").Равно("");

	КонецЦикла;

	Ожидаем.Что(РолиMaterial().Количество(), "словарь ролей выписан целиком: 28 акцентных, 12 фиксированных, 21 поверхностная")
		.Равно(61);

КонецПроцедуры

// Текст на своей роли читается (WCAG AA, 4.5:1) в обеих темах ПРИ ЛЮБОЙ затравке: акцент
// выбирает посетитель, и жёлтый, белый, серый или чёрный акцент не имеют права дать
// нечитаемую кнопку. Обводка поля и разделитель элемента управления — не текст, им 3:1.
&Тест
Процедура ПарыРолейЧитаемыПриЛюбомАкценте() Экспорт

	Провалы = Новый Массив();
	Проверено = 0;

	Для Каждого Затравка Из СтрРазделить("#6750a4,#ffeb3b,#00bcd4,#808080,#000000,#ffffff,#e91e63,#4caf50,#ff9800", ",") Цикл
		Оформление = Новый Структура("Акцент", Затравка);
		Для Каждого Тема Из Темы() Цикл

			Цвета = ОбъявленияТемы(Оформление, Тема);

			Для Каждого Пара Из ПарыТекста() Цикл
				Проверено = Проверено + 1;
				ПроверитьПару(Провалы, Цвета, Пара, 4.5, Затравка, Тема);
			КонецЦикла;

			Для Каждого Пара Из ПарыЭлементовУправления() Цикл
				Проверено = Проверено + 1;
				ПроверитьПару(Провалы, Цвета, Пара, 3, Затравка, Тема);
			КонецЦикла;

		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Проверено > 500, "пар проверено: " + Проверено + " — проверка не ослепла")
		.ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Провалы, Символы.ПС), "нечитаемые пары ролей").Равно("");

КонецПроцедуры

// Затравка по умолчанию — базовый цвет Material 3, и схема из неё совпадает с базовой
// схемой Google: primary светлой темы — ровно сама затравка (тон 40), остальное — в пределах
// разницы оттенка LCh и CAM16.
&Тест
Процедура ЗатравкаПоУмолчаниюДаётБазовуюСхемуMaterial() Экспорт

	Ожидаем.Что(Токены.АкцентПоУмолчанию(), "базовый цвет Material 3").Равно("#6750a4");

	Светлая = ОбъявленияТемы(Неопределено, "светлая");
	Тёмная = ОбъявленияТемы(Неопределено, "тёмная");

	Ожидаем.Что(Светлая.Получить("--md-sys-color-primary"), "primary светлой — тон 40 затравки")
		.Равно("#6750a4");

	Эталоны = Новый Массив();
	Эталоны.Добавить(Новый Структура("Цвета, Роль, Эталон", Тёмная, "primary", "#d0bcff"));
	Эталоны.Добавить(Новый Структура("Цвета, Роль, Эталон", Светлая, "primary-container", "#eaddff"));
	Эталоны.Добавить(Новый Структура("Цвета, Роль, Эталон", Светлая, "surface", "#fef7ff"));
	Эталоны.Добавить(Новый Структура("Цвета, Роль, Эталон", Тёмная, "surface", "#141218"));
	Эталоны.Добавить(Новый Структура("Цвета, Роль, Эталон", Светлая, "on-surface", "#1d1b20"));
	Эталоны.Добавить(Новый Структура("Цвета, Роль, Эталон", Светлая, "outline", "#79747e"));
	Эталоны.Добавить(Новый Структура("Цвета, Роль, Эталон", Светлая, "error", "#b3261e"));

	Для Каждого Эталон Из Эталоны Цикл
		Цвет = Эталон.Цвета.Получить("--md-sys-color-" + Эталон.Роль);
		Ожидаем.Что(РасхождениеКаналов(Цвет, Эталон.Эталон) <= 8,
			СтрШаблон("%1 = %2 против базовой схемы %3", Эталон.Роль, Цвет, Эталон.Эталон))
			.ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Акцент посетителя перекрашивает всю схему, а статусы остаются статусами: ошибка красная
// при любом акценте.
&Тест
Процедура АкцентМеняетСхемуАОшибкаОстаётсяОшибкой() Экспорт

	Базовая = ОбъявленияТемы(Неопределено, "светлая");
	Зелёная = ОбъявленияТемы(Новый Структура("Акцент", "#2e7d32"), "светлая");

	Ожидаем.Что(Зелёная.Получить("--md-sys-color-primary"), "primary пошёл за акцентом")
		.ЭтоНе().Равно(Базовая.Получить("--md-sys-color-primary"));
	Ожидаем.Что(Зелёная.Получить("--md-sys-color-surface"), "поверхность — с оттенком акцента")
		.ЭтоНе().Равно(Базовая.Получить("--md-sys-color-surface"));
	Ожидаем.Что(Зелёная.Получить("--md-sys-color-error"), "ошибка от акцента не зависит")
		.Равно(Базовая.Получить("--md-sys-color-error"));

	// недопустимый акцент — тот же CSS-контекст, что и раньше: отбрасывается к базовому
	Чужой = ОбъявленияТемы(Новый Структура("Акцент", "#fff;}html{display:none"), "светлая");
	Ожидаем.Что(Чужой.Получить("--md-sys-color-primary"), "инъекция не прошла")
		.Равно(Базовая.Получить("--md-sys-color-primary"));

КонецПроцедуры

#КонецОбласти

#Область НецветовыеТокены

// Типографическая шкала Material 3: пятнадцать стилей, у каждого пять токенов, значения —
// спецификации.
&Тест
Процедура ШкалаШрифтаПолнаяИПоСпецификации() Экспорт

	Объявления = ОбъявленияТемы(Неопределено, "тёмная");
	Недостающие = Новый Массив();

	Для Каждого Стиль Из СтилиШрифта() Цикл
		Для Каждого Свойство Из СтрРазделить("font,weight,size,line-height,tracking", ",") Цикл
			Имя = СтрШаблон("--md-sys-typescale-%1-%2", Стиль.Имя, Свойство);
			Если Объявления.Получить(Имя) = Неопределено Тогда
				Недостающие.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
		Ожидаем.Что(Объявления.Получить("--md-sys-typescale-" + Стиль.Имя + "-size"),
			"кегль " + Стиль.Имя).Равно(Стиль.Кегль);
		Ожидаем.Что(Объявления.Получить("--md-sys-typescale-" + Стиль.Имя + "-line-height"),
			"интерлиньяж " + Стиль.Имя).Равно(Стиль.Интерлиньяж);
		Ожидаем.Что(Объявления.Получить("--md-sys-typescale-" + Стиль.Имя + "-weight"),
			"начертание " + Стиль.Имя).Равно(Стиль.Начертание);
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Недостающие, ", "), "токены шкалы шрифта").Равно("");

КонецПроцедуры

// Формы, возвышение, слои состояний и движение — словарь Material 3 целиком; скругления
// идут за множителем радиуса из оформления, а пилюля остаётся пилюлей.
&Тест
Процедура ФормыВозвышениеСостоянияИДвижениеПоСпецификации() Экспорт

	Объявления = ОбъявленияТемы(Неопределено, "тёмная");

	Формы = Новый Структура("none, extra_small, small, medium, large, extra_large, full",
		"0px", "4px", "8px", "12px", "16px", "28px", "9999px");
	Для Каждого Форма Из Формы Цикл
		Ожидаем.Что(Объявления.Получить("--md-sys-shape-corner-" + СтрЗаменить(Форма.Ключ, "_", "-")),
			"скругление " + Форма.Ключ).Равно(Форма.Значение);
	КонецЦикла;

	Крупные = ОбъявленияТемы(Новый Структура("Радиус", 2), "тёмная");
	Ожидаем.Что(Крупные.Получить("--md-sys-shape-corner-medium"), "множитель радиуса").Равно("24px");
	Ожидаем.Что(Крупные.Получить("--md-sys-shape-corner-full"), "пилюля не умножается")
		.Равно("9999px");

	Ожидаем.Что(Объявления.Получить("--md-sys-elevation-level0"), "уровень 0 без тени").Равно("none");
	Для Уровень = 1 По 5 Цикл
		Ожидаем.Что(Объявления.Получить("--md-sys-elevation-level" + Уровень),
			"уровень возвышения " + Уровень).Заполнено();
	КонецЦикла;

	Состояния = Новый Структура("hover, focus, pressed, dragged", "0.08", "0.1", "0.1", "0.16");
	Для Каждого Состояние Из Состояния Цикл
		Ожидаем.Что(Объявления.Получить("--md-sys-state-" + Состояние.Ключ + "-state-layer-opacity"),
			"слой состояния " + Состояние.Ключ).Равно(Состояние.Значение);
	КонецЦикла;

	Ожидаем.Что(Объявления.Получить("--md-sys-motion-easing-standard"), "стандартная кривая")
		.Равно("cubic-bezier(.2,0,0,1)");
	Ожидаем.Что(Объявления.Получить("--md-sys-motion-easing-emphasized-decelerate"),
		"выразительное торможение").Равно("cubic-bezier(.05,.7,.1,1)");
	Длительности = Новый Структура("short1, short4, medium1, medium4, long1, long4, extra_long1, extra_long4",
		"50ms", "200ms", "250ms", "400ms", "450ms", "600ms", "700ms", "1000ms");
	Для Каждого Длительность Из Длительности Цикл
		Ожидаем.Что(Объявления.Получить("--md-sys-motion-duration-" + СтрЗаменить(Длительность.Ключ, "_", "-")),
			"длительность " + Длительность.Ключ).Равно(Длительность.Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область Лист

// Лист говорит словарём Material: прежние имена (--color-*, --shadow-*, --radius-*,
// --font-*) — псевдонимы для листов инсталляций, а не для самого кита.
&Тест
Процедура ЛистГоворитСловарёмMaterial() Экспорт

	Использованные = Разбор.ИспользованныеПеременные(Разбор.ТекстБазовогоЛиста());
	Прежние = Новый Массив();
	Роли = 0;
	Для Каждого Имя Из Использованные Цикл
		Если СтрНачинаетсяС(Имя, "--md-sys-color-") Тогда
			Роли = Роли + 1;
		КонецЕсли;
		Для Каждого Префикс Из СтрРазделить("--color-,--shadow-,--radius-,--font-", ",") Цикл
			Если СтрНачинаетсяС(Имя, Префикс) Тогда
				Прежние.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Роли > 25, "ролей цвета лист использует: " + Роли).ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Прежние, ", "), "прежние имена в базовом листе").Равно("");

КонецПроцедуры

// Скругление — ступень шкалы форм: записанное числом не идёт за множителем радиуса
// и выпадает из системы. Допустимы токен, ноль, круг (50%) и наследование.
&Тест
Процедура СкруглениеТолькоИзШкалыФорм() Экспорт

	Нарушения = Новый Массив();
	Всего = 0;
	Для Каждого Правило Из Разбор.Правила(Разбор.ТекстБазовогоЛиста()) Цикл
		Значение = Правило.Объявления.Получить("border-radius");
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Всего = Всего + 1;
		Для Каждого Часть Из СтрРазделить(БезФункций(Значение), " ", Ложь) Цикл
			Если СтрРазделить("0,0px,50%,inherit,ф", ",").Найти(Часть) = Неопределено Тогда
				Нарушения.Добавить(Правило.Селектор + " { border-radius: " + Значение + " }");
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Всего > 30, "скруглений в листе: " + Всего + " — разбор не ослеп").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Нарушения, Символы.ПС), "скругления мимо шкалы форм").Равно("");

	// сторож не ослеп
	Ожидаем.Что(БезФункций("calc(var(--a) / 2) 0 50%"), "функции схлопываются").Равно("ф 0 50%");

КонецПроцедуры

// Тень с размытием или смещением — уровень возвышения, а не рисунок на месте. Кольцо без
// размытия (обводка, слой состояния вокруг бегунка) тенью-возвышением не считается.
&Тест
Процедура ТеньТолькоУровнемВозвышения() Экспорт

	Нарушения = Новый Массив();
	Всего = 0;
	Для Каждого Правило Из Разбор.Правила(Разбор.ТекстБазовогоЛиста()) Цикл
		Значение = Правило.Объявления.Получить("box-shadow");
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Всего = Всего + 1;
		Если НЕ ТеньДопустима(Значение) Тогда
			Нарушения.Добавить(Правило.Селектор + " { box-shadow: " + Значение + " }");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Всего > 10, "теней в листе: " + Всего + " — разбор не ослеп").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Нарушения, Символы.ПС), "тени мимо уровней возвышения").Равно("");

	Ожидаем.Что(ТеньДопустима("0 2px 8px var(--x)"), "размытая тень — нарушение").ЭтоЛожь();
	Ожидаем.Что(ТеньДопустима("inset 0 0 0 1px var(--x)"), "кольцо — нет").ЭтоИстина();

КонецПроцедуры

// Длительность и кривая движения — токены: так переход «быстрый» везде одинаково быстрый.
// Исключение — блок prefers-reduced-motion, который гасит движение до нуля.
&Тест
Процедура ДвижениеТолькоТокенами() Экспорт

	Нарушения = Новый Массив();
	Всего = 0;
	Для Каждого Правило Из Разбор.Правила(Разбор.ТекстБазовогоЛиста()) Цикл
		Если СтрНайти(Правило.Условия, "prefers-reduced-motion") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Свойство Из СтрРазделить("transition,animation,transition-duration,animation-duration", ",") Цикл
			Значение = Правило.Объявления.Получить(Свойство);
			Если Значение = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Всего = Всего + 1;
			Если ЕстьЛитералВремени(Значение) ИЛИ СтрНайти(БезФункций(Значение), "ease") > 0 Тогда
				Нарушения.Добавить(Правило.Селектор + " { " + Свойство + ": " + Значение + " }");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Ожидаем.Что(Всего > 20, "переходов в листе: " + Всего + " — разбор не ослеп").ЭтоИстина();
	Ожидаем.Что(СтрСоединить(Нарушения, Символы.ПС), "движение мимо токенов").Равно("");

	Ожидаем.Что(ЕстьЛитералВремени("opacity 120ms ease"), "литерал виден").ЭтоИстина();
	Ожидаем.Что(ЕстьЛитералВремени("opacity var(--d) var(--e)"), "токен — нет").ЭтоЛожь();

КонецПроцедуры

// Кегль текста — стиль шкалы. Число допустимо только у значка: размер глифа — не текст.
&Тест
Процедура КегльТекстаТолькоИзШкалы() Экспорт

	Нарушения = Новый Массив();
	Для Каждого Правило Из Разбор.Правила(Разбор.ТекстБазовогоЛиста()) Цикл
		Значение = Правило.Объявления.Получить("font-size");
		Если Значение = Неопределено ИЛИ СтрНайти(Правило.Селектор, "icon") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Значение, "var(") = 0 И Значение <> "inherit" Тогда
			Нарушения.Добавить(Правило.Селектор + " { font-size: " + Значение + " }");
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(СтрСоединить(Нарушения, Символы.ПС), "кегли мимо шкалы шрифта").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Темы()
	Возврат СтрРазделить("тёмная,светлая", ",");
КонецФункции

// Объявления одной темы: тёмная — блок :root, светлая — :root, перекрытый блоком
// html[data-theme="light"] (тот же элемент, светлые роли сильнее).
Функция ОбъявленияТемы(Знач Оформление, Знач Тема)

	Текст = Токены.Переменные(Оформление);
	Граница = СтрНайти(Текст, "html[data-theme=");

	Результат = ОбъявленияБлока(Лев(Текст, Граница - 1));
	Если Тема = "светлая" Тогда
		Для Каждого КиЗ Из ОбъявленияБлока(Сред(Текст, Граница)) Цикл
			Результат.Вставить(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция ОбъявленияБлока(Знач Блок)

	Результат = Новый Соответствие();
	Начало = СтрНайти(Блок, "{");
	Конец = СтрНайти(Блок, "}", НаправлениеПоиска.СКонца);
	Для Каждого Объявление Из СтрРазделить(Сред(Блок, Начало + 1, Конец - Начало - 1), ";", Ложь) Цикл
		Двоеточие = СтрНайти(Объявление, ":");
		Если Двоеточие > 0 Тогда
			Результат.Вставить(СокрЛП(Лев(Объявление, Двоеточие - 1)), СокрЛП(Сред(Объявление, Двоеточие + 1)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура ПроверитьПару(Провалы, Знач Цвета, Знач Пара, Знач Порог, Знач Затравка, Знач Тема)

	Фон = Цвета.Получить("--md-sys-color-" + Пара.Фон);
	Текст = Цвета.Получить("--md-sys-color-" + Пара.Текст);
	Контраст = Токены.КоэффициентКонтраста(Фон, Текст);
	Если Контраст < Порог Тогда
		Провалы.Добавить(СтрШаблон("%1 на %2 (%3, %4): %5 < %6", Пара.Текст, Пара.Фон, Затравка,
			Тема, Окр(Контраст, 2), Порог));
	КонецЕсли;

КонецПроцедуры

Функция ПарыТекста()

	Результат = Новый Массив();
	Для Каждого Семья Из СтрРазделить("primary,secondary,tertiary,error,success,warning,info", ",") Цикл
		Результат.Добавить(Пара(Семья, "on-" + Семья));
		Результат.Добавить(Пара(Семья + "-container", "on-" + Семья + "-container"));
	КонецЦикла;
	Для Каждого Поверхность Из СтрРазделить("surface,surface-dim,surface-bright,surface-container-lowest,"
			+ "surface-container-low,surface-container,surface-container-high,surface-container-highest", ",") Цикл
		Результат.Добавить(Пара(Поверхность, "on-surface"));
		Результат.Добавить(Пара(Поверхность, "on-surface-variant"));
		Результат.Добавить(Пара(Поверхность, "primary"));
		Результат.Добавить(Пара(Поверхность, "error"));
	КонецЦикла;
	Результат.Добавить(Пара("surface-variant", "on-surface-variant"));
	Результат.Добавить(Пара("inverse-surface", "inverse-on-surface"));
	Результат.Добавить(Пара("primary-fixed", "on-primary-fixed"));
	Результат.Добавить(Пара("secondary-fixed", "on-secondary-fixed-variant"));
	Возврат Результат;

КонецФункции

Функция ПарыЭлементовУправления()

	Результат = Новый Массив();
	Результат.Добавить(Пара("surface", "outline"));
	Результат.Добавить(Пара("surface-container-low", "outline"));
	Результат.Добавить(Пара("surface-container-highest", "on-surface-variant"));
	Возврат Результат;

КонецФункции

Функция Пара(Знач Фон, Знач Текст)
	Возврат Новый Структура("Фон, Текст", Фон, Текст);
КонецФункции

// Роли Material 3 (m3.material.io/styles/color/roles) и три пользовательских семьи кита.
Функция РолиMaterial()

	Результат = Новый Массив();
	Для Каждого Семья Из СтрРазделить("primary,secondary,tertiary,error,success,warning,info", ",") Цикл
		Результат.Добавить(Семья);
		Результат.Добавить("on-" + Семья);
		Результат.Добавить(Семья + "-container");
		Результат.Добавить("on-" + Семья + "-container");
	КонецЦикла;
	Для Каждого Семья Из СтрРазделить("primary,secondary,tertiary", ",") Цикл
		Результат.Добавить(Семья + "-fixed");
		Результат.Добавить(Семья + "-fixed-dim");
		Результат.Добавить("on-" + Семья + "-fixed");
		Результат.Добавить("on-" + Семья + "-fixed-variant");
	КонецЦикла;
	Для Каждого Роль Из СтрРазделить("surface,on-surface,surface-variant,on-surface-variant,surface-dim,"
			+ "surface-bright,surface-container-lowest,surface-container-low,surface-container,"
			+ "surface-container-high,surface-container-highest,inverse-surface,inverse-on-surface,"
			+ "inverse-primary,outline,outline-variant,shadow,scrim,surface-tint,background,on-background", ",") Цикл
		Результат.Добавить(Роль);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СтилиШрифта()

	Результат = Новый Массив();
	Для Каждого Строка Из СтрРазделить("display-large 57 64 400|display-medium 45 52 400|"
			+ "display-small 36 44 400|headline-large 32 40 400|headline-medium 28 36 400|"
			+ "headline-small 24 32 400|title-large 22 28 400|title-medium 16 24 500|"
			+ "title-small 14 20 500|body-large 16 24 400|body-medium 14 20 400|body-small 12 16 400|"
			+ "label-large 14 20 500|label-medium 12 16 500|label-small 11 16 500", "|") Цикл
		Части = СтрРазделить(Строка, " ");
		Результат.Добавить(Новый Структура("Имя, Кегль, Интерлиньяж, Начертание",
			Части[0], Части[1] + "px", Части[2] + "px", Части[3]));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Наибольшее расхождение каналов двух цветов #rrggbb, 0..255.
Функция РасхождениеКаналов(Знач Первый, Знач Второй)

	А = Токены.КомпонентыЦвета(Первый);
	Б = Токены.КомпонентыЦвета(Второй);
	Если А = Неопределено ИЛИ Б = Неопределено Тогда
		Возврат 255;
	КонецЕсли;
	Возврат Макс(Макс(Макс(А.Красный - Б.Красный, Б.Красный - А.Красный),
		Макс(А.Зелёный - Б.Зелёный, Б.Зелёный - А.Зелёный)),
		Макс(А.Синий - Б.Синий, Б.Синий - А.Синий));

КонецФункции

// Значение, где каждая функция (var, calc, color-mix, cubic-bezier…) со всем содержимым
// заменена буквой «ф»: остаётся то, что записано мимо токенов.
Функция БезФункций(Знач Значение)

	Результат = "";
	Глубина = 0;
	Текст = Строка(Значение);
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если Символ = "(" Тогда
			Если Глубина = 0 Тогда
				// имя функции уже в результате — заменяем его буквой
				Пока СтрДлина(Результат) > 0 И СтрНайти(" ,", Прав(Результат, 1)) = 0 Цикл
					Результат = Лев(Результат, СтрДлина(Результат) - 1);
				КонецЦикла;
				Результат = Результат + "ф";
			КонецЕсли;
			Глубина = Глубина + 1;
		ИначеЕсли Символ = ")" Тогда
			Глубина = Глубина - 1;
		ИначеЕсли Глубина = 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
	КонецЦикла;
	Возврат СокрЛП(Результат);

КонецФункции

Функция ЕстьЛитералВремени(Знач Значение)

	Для Каждого Часть Из СтрРазделить(СтрЗаменить(БезФункций(Значение), ",", " "), " ", Ложь) Цикл
		Если (СтрЗаканчиваетсяНа(Часть, "ms") ИЛИ СтрЗаканчиваетсяНа(Часть, "s"))
			И СтрНайти("0123456789.", Лев(Часть, 1)) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ТеньДопустима(Знач Значение)

	Текст = НРег(СокрЛП(Значение));
	Если Текст = "none" ИЛИ СтрНачинаетсяС(Текст, "var(") Тогда
		Возврат Истина;
	КонецЕсли;

	// каждый слой тени — кольцо: смещения и размытие нулевые, остаётся только разлив
	Для Каждого Слой Из СтрРазделить(БезФункций(Текст), ",", Ложь) Цикл
		Числа = Новый Массив();
		Для Каждого Часть Из СтрРазделить(Слой, " ", Ложь) Цикл
			Если Часть <> "inset" И Часть <> "ф" И Часть <> "transparent" Тогда
				Числа.Добавить(Часть);
			КонецЕсли;
		КонецЦикла;
		Если Числа.Количество() < 3 Тогда
			Возврат Ложь;
		КонецЕсли;
		Для Номер = 0 По 2 Цикл
			Если Числа[Номер] <> "0" И Числа[Номер] <> "0px" Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Истина;

КонецФункции

#КонецОбласти
