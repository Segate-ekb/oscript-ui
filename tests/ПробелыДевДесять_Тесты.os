// Слова дев-сборки 0.13.0-dev.10 — пробелы волны 5 хаба (ui-вход, ui-брендирование-2,
// ui-значки, ui-каталог-2, ui-получатели-2, ui-окна) и слова владельца 2026-10-14.
// Проверяется то, что ломается для человека: шапка ворот на телефоне в две строки, отказ
// без строки под сегментами, секрет окна, оставшийся в DOM, показ дерева, разошедшийся
// с тем, что сохранится, — и что узлы без новых слов печатаются, как до сборки.

#Использовать "../"
#Использовать asserts

Перем Кит;    // Кит
Перем Набор;  // НаборКомпонентов
Перем Разбор; // РазборЛиста — сканер, читающий КОД листа
Перем ПравилаЛиста; // правила базового листа, разобранные однажды

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "РазборЛиста.os"), "РазборЛиста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Кит = Слой.Кит;
	Набор = Слой.Набор;
	Разбор = Новый РазборЛиста();

КонецПроцедуры

#Область ШапкаУзкойСтраницы

// П1 (ui-вход): на телефоне прежняя шапка встаёт колонкой, и пилюля темы ворот уходила
// второй строкой под знак. У узкой страницы — одна строка: знак слева, навигация справа,
// длинное имя знака сжимается, а не сталкивает пилюлю. Разметка шапки прежняя.
&Тест
Процедура ШапкаУзкойСтраницыОднойСтрокой() Экспорт

	Узкой = "body:has(> main > .narrow) > .top";
	Условие = "@media (max-width: 640px)";
	Ожидаем.Что(ОбъявлениеЛиста(".top:not(.top--menu) .wrap", "flex-direction", Условие), "прежняя шапка — колонкой")
		.Равно("column");
	Ожидаем.Что(ОбъявлениеЛиста(Узкой + " .wrap", "flex-direction", Условие), "шапка узкой — строкой").Равно("row");
	Ожидаем.Что(ОбъявлениеЛиста(Узкой + " .wrap", "justify-content", Условие), "знак слева, пилюля справа")
		.Равно("space-between");
	Ожидаем.Что(ОбъявлениеЛиста(Узкой + " .top__nav", "flex", Условие), "навигация не сжимается").Равно("none");
	Ожидаем.Что(ОбъявлениеЛиста(Узкой + " .brand", "min-width", Условие), "знак сжимается").Равно("0");

КонецПроцедуры

#КонецОбласти

#Область Сноска

// П2 (ui-вход): атрибуция и лицензия внизу колонки — самый мелкий петит без рамки и своих
// маргинов; ссылка внутри — того же кегля; в узкой колонке по центру.
&Тест
Процедура ПримечаниеВидаСноска() Экспорт

	Ожидаем.Что(Кит.Примечание("Данные — ", Кит.Ссылка("https://db-ip.com", "DB-IP")).Вид("сноска").Рендер(), "сноска")
		.Равно("<p class=""note-footnote"">Данные — <a href=""https://db-ip.com"">DB-IP</a></p>");
	Ожидаем.Что(ОбъявлениеЛиста(".note-footnote", "font"), "body-small").Равно("var(--type-body-small)");
	Ожидаем.Что(ОбъявлениеЛиста(".note-footnote", "color"), "цветом пояснения")
		.Равно("var(--md-sys-color-on-surface-variant)");
	Ожидаем.Что(ОбъявлениеЛиста(".note-footnote", "margin"), "без своих маргинов").Равно("0");
	Ожидаем.Что(ОбъявлениеЛиста(".note-footnote", "border"), "без рамки").Равно(Неопределено);
	Ожидаем.Что(ОбъявлениеЛиста(".note-footnote a", "font"), "ссылка того же кегля").Равно("inherit");
	Ожидаем.Что(ОбъявлениеЛиста(".narrow > .note-footnote", "text-align"), "в узкой — по центру").Равно("center");

КонецПроцедуры

#КонецОбласти

#Область ЦветаПресетаВДокументации

// Документация называет печатный цвет пресета, а не затравку: хаб и читатель сверяют
// страницу «Цвет» с тем, что видят в браузере. Затравка oscript тёмной — #60a5fa,
// печатается #61a6fb (тон 67).
&Тест
Процедура СтраницаЦветаНазываетПечатныеЦветаПресетов() Экспорт

	Токены = Новый ТокеныТемы();
	Страница = ТекстФайла(ОбъединитьПути("документация", "страницы", "цвет.md"));
	Пары = Новый Массив();
	Пары.Добавить("oscript|1|primary");
	Пары.Добавить("oscript|0|primary");
	Пары.Добавить("oscript|1|surface");
	Пары.Добавить("oscript|1|surface-container");
	Пары.Добавить("oscript|0|surface");
	Пары.Добавить("classic|1|primary");
	Пары.Добавить("classic|1|surface");
	Пары.Добавить("classic|0|surface");
	Нет = Новый Массив();
	Для Каждого Пара Из Пары Цикл
		Части = СтрРазделить(Пара, "|");
		Цвета = Токены.ЦветаПресета(Части[0], Части[1] = "1");
		Метка = "--md-sys-color-" + Части[2] + ":";
		Начало = СтрНайти(Цвета, Метка) + СтрДлина(Метка);
		Цвет = Сред(Цвета, Начало, 7);
		Если СтрНайти(Страница, "`" + Цвет + "`") = 0 Тогда
			Нет.Добавить(Пара + " " + Цвет);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Нет, "; "), "печатные цвета на странице «Цвет»").Равно("");
	Ожидаем.Что(Токены.ЦветаПресета("oscript", Истина), "oscript тёмная").Содержит("--md-sys-color-primary:#61a6fb;");

КонецПроцедуры

#КонецОбласти

#Область ПанельСохраненияБезСкрипта

// П2 ревью ui-брендирование-2: без скрипта признака прилипания нет, и панель цвета
// карточки срезала поля под собой без края. Без скрипта — кольцо outline-variant всегда,
// со скриптом — по-прежнему тень по data-stuck; слой панели выше плавающих подписей полей.
&Тест
Процедура ПрилипшаяПанельБезСкриптаСКраем() Экспорт

	Ожидаем.Что(ОбъявлениеЛиста(".savebar", "box-shadow", "@media (scripting: none)"), "кольцо без скрипта")
		.Равно("0 0 0 1px var(--md-sys-color-outline-variant)");
	Ожидаем.Что(ОбъявлениеЛиста(".savebar", "box-shadow"), "со скриптом без прилипания — без тени").Равно("none");
	Ожидаем.Что(ОбъявлениеЛиста(".savebar[data-stuck]", "box-shadow"), "прилипшая — тень")
		.Равно("var(--md-sys-elevation-level2)");
	Ожидаем.Что(Число(ОбъявлениеЛиста(".savebar", "z-index")) > Число(ОбъявлениеЛиста(".field__label", "z-index")),
		"панель выше подписи поля").ЭтоИстина();
	Ожидаем.Что(Число(ОбъявлениеЛиста(".savebar", "z-index")) < Число(ОбъявлениеЛиста(".top", "z-index")),
		"панель ниже шапки").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаПечати(Знач Узел)

	Попытка
		Узел.Рендер();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция МеждуМаркеров(Знач Текст, Знач Начало, Знач Конец)

	Открытие = СтрНайти(Текст, Начало);
	Если Открытие = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Открытие + СтрДлина(Начало));
	Закрытие = СтрНайти(Хвост, Конец);
	Возврат ?(Закрытие = 0, Хвост, Лев(Хвост, Закрытие - 1));

КонецФункции

Функция ТекстСкрипта()

	Корень = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..");
	Текст = Новый ТекстовыйДокумент();
	Текст.Прочитать(ОбъединитьПути(Корень, "src", "статика", "oscript-ui.js"), КодировкаТекста.UTF8);
	Возврат Текст.ПолучитьТекст();

КонецФункции

Функция ТекстФайла(Знач Путь)

	Корень = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..");
	Текст = Новый ТекстовыйДокумент();
	Текст.Прочитать(ОбъединитьПути(Корень, Путь), КодировкаТекста.UTF8);
	Возврат Текст.ПолучитьТекст();

КонецФункции

Функция Правила()

	Если ПравилаЛиста = Неопределено Тогда
		ПравилаЛиста = Разбор.Правила(Разбор.ТекстБазовогоЛиста());
	КонецЕсли;
	Возврат ПравилаЛиста;

КонецФункции

// Значение свойства у правила базового листа с ровно этим селектором под ровно этими
// условиями; из нескольких побеждает последнее, как в каскаде. Нет — Неопределено.
Функция ОбъявлениеЛиста(Знач Селектор, Знач Свойство, Знач Условия = "")

	Результат = Неопределено;
	Для Каждого Правило Из Правила() Цикл
		Если Правило.Селектор = Селектор И Правило.Условия = Условия Тогда
			Значение = Правило.Объявления.Получить(Свойство);
			Если Значение <> Неопределено Тогда
				Результат = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
