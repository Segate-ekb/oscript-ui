// Слова дев-сборки 0.13.0-dev.10 — пробелы волны 5 хаба (ui-вход, ui-брендирование-2,
// ui-значки, ui-каталог-2, ui-получатели-2, ui-окна) и слова владельца 2026-10-14.
// Проверяется то, что ломается для человека: шапка ворот на телефоне в две строки, отказ
// без строки под сегментами, секрет окна, оставшийся в DOM, показ дерева, разошедшийся
// с тем, что сохранится, — и что узлы без новых слов печатаются, как до сборки.

#Использовать "../"
#Использовать asserts

Перем Кит;    // Кит
Перем Набор;  // НаборКомпонентов
Перем Разбор; // РазборЛиста — сканер, читающий КОД листа
Перем ПравилаЛиста; // правила базового листа, разобранные однажды

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "РазборЛиста.os"), "РазборЛиста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Кит = Слой.Кит;
	Набор = Слой.Набор;
	Разбор = Новый РазборЛиста();

КонецПроцедуры

#Область ШапкаУзкойСтраницы

// П1 (ui-вход): на телефоне прежняя шапка встаёт колонкой, и пилюля темы ворот уходила
// второй строкой под знак. У узкой страницы — одна строка: знак слева, навигация справа,
// длинное имя знака сжимается, а не сталкивает пилюлю. Разметка шапки прежняя.
&Тест
Процедура ШапкаУзкойСтраницыОднойСтрокой() Экспорт

	Узкой = "body:has(> main > .narrow) > .top";
	Условие = "@media (max-width: 640px)";
	Ожидаем.Что(ОбъявлениеЛиста(".top:not(.top--menu) .wrap", "flex-direction", Условие), "прежняя шапка — колонкой")
		.Равно("column");
	Ожидаем.Что(ОбъявлениеЛиста(Узкой + " .wrap", "flex-direction", Условие), "шапка узкой — строкой").Равно("row");
	Ожидаем.Что(ОбъявлениеЛиста(Узкой + " .wrap", "justify-content", Условие), "знак слева, пилюля справа")
		.Равно("space-between");
	Ожидаем.Что(ОбъявлениеЛиста(Узкой + " .top__nav", "flex", Условие), "навигация не сжимается").Равно("none");
	Ожидаем.Что(ОбъявлениеЛиста(Узкой + " .brand", "min-width", Условие), "знак сжимается").Равно("0");

КонецПроцедуры

#КонецОбласти

#Область Сноска

// П2 (ui-вход): атрибуция и лицензия внизу колонки — самый мелкий петит без рамки и своих
// маргинов; ссылка внутри — того же кегля; в узкой колонке по центру.
&Тест
Процедура ПримечаниеВидаСноска() Экспорт

	Ожидаем.Что(Кит.Примечание("Данные — ", Кит.Ссылка("https://db-ip.com", "DB-IP")).Вид("сноска").Рендер(), "сноска")
		.Равно("<p class=""note-footnote"">Данные — <a href=""https://db-ip.com"">DB-IP</a></p>");
	Ожидаем.Что(ОбъявлениеЛиста(".note-footnote", "font"), "body-small").Равно("var(--type-body-small)");
	Ожидаем.Что(ОбъявлениеЛиста(".note-footnote", "color"), "цветом пояснения")
		.Равно("var(--md-sys-color-on-surface-variant)");
	Ожидаем.Что(ОбъявлениеЛиста(".note-footnote", "margin"), "без своих маргинов").Равно("0");
	Ожидаем.Что(ОбъявлениеЛиста(".note-footnote", "border"), "без рамки").Равно(Неопределено);
	Ожидаем.Что(ОбъявлениеЛиста(".note-footnote a", "font"), "ссылка того же кегля").Равно("inherit");
	Ожидаем.Что(ОбъявлениеЛиста(".narrow > .note-footnote", "text-align"), "в узкой — по центру").Равно("center");

КонецПроцедуры

#КонецОбласти

#Область ЦветаПресетаВДокументации

// Документация называет печатный цвет пресета, а не затравку: хаб и читатель сверяют
// страницу «Цвет» с тем, что видят в браузере. Затравка oscript тёмной — #60a5fa,
// печатается #61a6fb (тон 67).
&Тест
Процедура СтраницаЦветаНазываетПечатныеЦветаПресетов() Экспорт

	Токены = Новый ТокеныТемы();
	Страница = ТекстФайла(ОбъединитьПути("документация", "страницы", "цвет.md"));
	Пары = Новый Массив();
	Пары.Добавить("oscript|1|primary");
	Пары.Добавить("oscript|0|primary");
	Пары.Добавить("oscript|1|surface");
	Пары.Добавить("oscript|1|surface-container");
	Пары.Добавить("oscript|0|surface");
	Пары.Добавить("classic|1|primary");
	Пары.Добавить("classic|1|surface");
	Пары.Добавить("classic|0|surface");
	Нет = Новый Массив();
	Для Каждого Пара Из Пары Цикл
		Части = СтрРазделить(Пара, "|");
		Цвета = Токены.ЦветаПресета(Части[0], Части[1] = "1");
		Метка = "--md-sys-color-" + Части[2] + ":";
		Начало = СтрНайти(Цвета, Метка) + СтрДлина(Метка);
		Цвет = Сред(Цвета, Начало, 7);
		Если СтрНайти(Страница, "`" + Цвет + "`") = 0 Тогда
			Нет.Добавить(Пара + " " + Цвет);
		КонецЕсли;
	КонецЦикла;
	Ожидаем.Что(СтрСоединить(Нет, "; "), "печатные цвета на странице «Цвет»").Равно("");
	Ожидаем.Что(Токены.ЦветаПресета("oscript", Истина), "oscript тёмная").Содержит("--md-sys-color-primary:#61a6fb;");

КонецПроцедуры

#КонецОбласти

#Область ПанельСохраненияБезСкрипта

// П2 ревью ui-брендирование-2: без скрипта признака прилипания нет, и панель цвета
// карточки срезала поля под собой без края. Без скрипта — кольцо outline-variant всегда,
// со скриптом — по-прежнему тень по data-stuck; слой панели выше плавающих подписей полей.
&Тест
Процедура ПрилипшаяПанельБезСкриптаСКраем() Экспорт

	Ожидаем.Что(ОбъявлениеЛиста(".savebar", "box-shadow", "@media (scripting: none)"), "кольцо без скрипта")
		.Равно("0 0 0 1px var(--md-sys-color-outline-variant)");
	Ожидаем.Что(ОбъявлениеЛиста(".savebar", "box-shadow"), "со скриптом без прилипания — без тени").Равно("none");
	Ожидаем.Что(ОбъявлениеЛиста(".savebar[data-stuck]", "box-shadow"), "прилипшая — тень")
		.Равно("var(--md-sys-elevation-level2)");
	Ожидаем.Что(Число(ОбъявлениеЛиста(".savebar", "z-index")) > Число(ОбъявлениеЛиста(".field__label", "z-index")),
		"панель выше подписи поля").ЭтоИстина();
	Ожидаем.Что(Число(ОбъявлениеЛиста(".savebar", "z-index")) < Число(ОбъявлениеЛиста(".top", "z-index")),
		"панель ниже шапки").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныйЗначокКлюча

// П5 (ui-значки): key.svg — глиф Material, а не бренд. Файл остаётся (контракт для <img>),
// «бренд:key» печатается (сохранённое раньше не роняет страницу), но перечень брендов
// и раздел «Бренды» выбора значка — только настоящие бренды.
&Тест
Процедура КлючНеБрендВПеречне() Экспорт

	Бренды = Набор.Иконка().ИменаБрендов();
	Ожидаем.Что(Бренды.Найти("бренд:key"), "key не бренд").Равно(Неопределено);
	Ожидаем.Что(Бренды.Найти("бренд:telegram") <> Неопределено, "telegram бренд").ЭтоИстина();
	Файл = Новый Файл(ОбъединитьПути(ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..", "src"), "статика", "провайдеры", "key.svg"));
	Ожидаем.Что(Файл.Существует(), "файл key.svg на месте").ЭтоИстина();
	Ожидаем.Что(Кит.Иконка("бренд:key").Рендер(), "бренд:key печатается").Содержит("<svg");

	Сетка = Кит.ВыборЗначка("значок", "Значок").Разделы("бренды").Рендер();
	Ожидаем.Что(СтрНайти(Сетка, "value=""бренд:key"""), "в сетке брендов ключа нет").Равно(0);
	Ожидаем.Что(Сетка, "бренды в сетке").Содержит("value=""бренд:github""");

	Отказ = ОшибкаПечати(Кит.Иконка("бренд:нет"));
	Ожидаем.Что(Отказ, "перечень известных").Содержит("известны");
	Ожидаем.Что(СтрНайти(Отказ, " key,"), "в перечне известных брендов ключа нет").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеГлифыВВыбореЗначка

// Слово владельца 2026-10-14: служебные глифы (стрелки, меню, крестик, солнце, луна) в
// выборе значка скрыты; свой раздел «служебные» — только названный. Исключить убирает
// имена, которых домен не принимает. Сохранённое значение остаётся ячейкой всегда.
&Тест
Процедура СлужебныеГлифыСкрытыВВыбореЗначка() Экспорт

	Служебные = Набор.Иконка().СлужебныеГлифы();
	Ожидаем.Что(СтрСоединить(Служебные, ","), "перечень").Равно("влево,вверх,вниз,вправо,закрыть,луна,меню,солнце");

	HTML = Кит.ВыборЗначка("значок", "Значок").Рендер();
	Для Каждого Имя Из Служебные Цикл
		Ожидаем.Что(СтрНайти(HTML, "value=""" + Имя + """"), "скрыт " + Имя).Равно(0);
	КонецЦикла;
	Ожидаем.Что(HTML, "прочие глифы на месте").Содержит("value=""тег""");
	Ожидаем.Что(СтрНайти(HTML, "Служебные"), "раздела нет").Равно(0);

	С = Кит.ВыборЗначка("значок", "Значок").Разделы("глифы", "бренды", "служебные").Значение("луна").Рендер();
	Ожидаем.Что(С, "раздел служебных").Содержит("aria-label=""Служебные"" data-iconpicker-group><p class=""iconpicker__title"" aria-hidden=""true"">Служебные</p>");
	Ожидаем.Что(СтрЧислоВхождений(С, "value=""луна"""), "луна одна — в служебных").Равно(1);
	Ожидаем.Что(СтрНайти(С, "aria-label=""Бренды""") < СтрНайти(С, "aria-label=""Служебные"""), "порядок вызова").ЭтоИстина();
	Ожидаем.Что(С, "выбранная отмечена").Содержит("value=""луна"" checked>");

	Своё = Кит.ВыборЗначка("значок", "Значок").Значение("меню").Рендер();
	Ожидаем.Что(Своё, "сохранённый служебный остаётся ячейкой").Содержит("value=""меню"" checked>");

	Без = Кит.ВыборЗначка("значок", "Значок").Исключить("тег", "бренд:telegram").Исключить(СтрРазделить("ключ", ",")).Рендер();
	Ожидаем.Что(СтрНайти(Без, "value=""тег"""), "исключён глиф").Равно(0);
	Ожидаем.Что(СтрНайти(Без, "value=""бренд:telegram"""), "исключён бренд").Равно(0);
	Ожидаем.Что(СтрНайти(Без, "value=""ключ"""), "исключён массивом, второй вызов дописал").Равно(0);
	Ожидаем.Что(Без, "прочие на месте").Содержит("value=""куб""");
	Ожидаем.Что(Кит.ВыборЗначка("значок", "Значок").Исключить("тег").Значение("тег").Рендер(), "исключённое сохранённое — ячейкой")
		.Содержит("value=""тег"" checked>");

	Ожидаем.Что(ОшибкаПечати(Кит.ВыборЗначка("значок", "Значок").Разделы("эмодзи")), "закрытый набор")
		.Содержит("«глифы», «бренды», «служебные»");
	Ожидаем.Что(Кит.Иконка("меню").Рендер(), "Кит.Иконка служебный печатает").Содержит("<svg");

КонецПроцедуры

#КонецОбласти

#Область АдресЗакрытияСлотаКартинки

// П1 (ui-окна): окно сброса слота картинки закрывалось только командой движка «закрыть» —
// напечатанное открытым по адресу, без скрипта в браузере без команды оно не закрывалось.
// Слово АдресЗакрытия у слота: крестик и «Отмена» — ссылками на страницу без окна (со
// скриптом — закрытие на месте, data-closes); без слова — прежняя разметка байт в байт.
&Тест
Процедура СлотКартинкиЗакрываетОкноСбросаАдресом() Экспорт

	Прежний = Кит.Холст(Кит.СлотКартинки("logo", "Логотип").Адрес("/знак.svg").Форма("/бренд")
		.Сброс("/бренд/сброс").Открыто()).Токен("т").Рендер();
	С = Кит.Холст(Кит.СлотКартинки("logo", "Логотип").Адрес("/знак.svg").Форма("/бренд")
		.Сброс("/бренд/сброс").Открыто().АдресЗакрытия("/бренд")).Токен("т").Рендер();
	Ожидаем.Что(Прежний, "без слова — команда движка").Содержит("command=""close""");
	Окно = МеждуМаркеров(С, "<dialog", "</dialog>");
	Ожидаем.Что(СтрНайти(Окно, "command=""close"""), "с адресом — команды нет").Равно(0);
	Ожидаем.Что(СтрЧислоВхождений(Окно, "href=""/бренд"""), "крестик и «Отмена» — ссылки").Равно(2);
	Ожидаем.Что(СтрЧислоВхождений(Окно, "data-closes="""), "со скриптом — на месте").Равно(2);
	Ожидаем.Что(ОшибкаПечати(Кит.Холст(Кит.СлотКартинки("logo", "Логотип").Форма("/бренд")
		.АдресЗакрытия("/бренд")).Токен("т")), "без сброса").Содержит("окна сброса нет");
	// номер меню ⚙ — счётчик страницы, у второго слота он следующий
	Ожидаем.Что(Лев(Прежний, СтрНайти(Прежний, "<dialog")), "форма слота прежняя")
		.Равно(СтрЗаменить(Лев(С, СтрНайти(С, "<dialog")), "menu-2", "menu-1"));

КонецПроцедуры

#КонецОбласти

#Область ЛидВШапкеУзкойСтраницы

// П3 (ui-вход): вводный абзац ворот и причина отказа — роль шапки колонки. Подпись шапки —
// строка или узел (текст со ссылкой), длинная переносится по словам по центру, не шире
// колонки; строка печатается, как прежде.
&Тест
Процедура ЛидВоротВПодписиШапки() Экспорт

	Прежняя = Кит.УзкаяСтраница().Шапка("", "Вход", "Проекты").Рендер();
	Ожидаем.Что(Прежняя, "строка — прежний абзац").Содержит("<h1>Вход</h1><p class=""muted"">Проекты</p></div>");

	HTML = Кит.УзкаяСтраница().Шапка("", "Доступ закрыт",
		Кит.Холст("Вход из вашей страны закрыт администратором. ", Кит.Ссылка("/помощь", "Что делать?"))).Рендер();
	Ожидаем.Что(HTML, "узел в подписи")
		.Содержит("<h1>Доступ закрыт</h1><p class=""muted"">Вход из вашей страны закрыт администратором. <a href=""/помощь"">Что делать?</a></p></div>");
	Ожидаем.Что(Кит.УзкаяСтраница().Шапка("", "Вход", "<b>").Рендер(), "строка экранирована").Содержит("&lt;b&gt;");

	Ожидаем.Что(ОбъявлениеЛиста(".narrow__head > p", "max-width"), "не шире колонки").Равно("100%");
	Ожидаем.Что(ОбъявлениеЛиста(".narrow__head > p", "text-wrap"), "строки по длине").Равно("balance");
	Ожидаем.Что(ОбъявлениеЛиста(".narrow__head > p", "overflow-wrap"), "длинное слово переносится").Равно("anywhere");
	Ожидаем.Что(ОбъявлениеЛиста(".narrow__head", "text-align"), "по центру").Равно("center");

КонецПроцедуры

#КонецОбласти

#Область ОтказУСегментов

// П1 (ui-брендирование-2): чужое значение темы или пресета нечем было отбить под
// сегментами. Ошибка(Текст) — строка field__error под пилюлей, группа aria-invalid
// и ссылается на строку aria-describedby (вместе с источником); у набора с панелями
// строка — после панелей (номера панелей прежние), под пилюлю её ставит порядок флекса.
&Тест
Процедура ОтказПодСегментами() Экспорт

	Прежние = Кит.Сегменты("пресет", Кит.Сегмент("a", "А"), Кит.Сегмент("b", "Б")).Рендер();
	С = Кит.Сегменты("пресет", Кит.Сегмент("a", "А"), Кит.Сегмент("b", "Б")).Ошибка("Чужое <значение>").Рендер();
	Ид = МеждуМаркеров(С, "<span class=""field__error segments__error"" role=""alert"" id=""", """");
	Ожидаем.Что(Ид, "строка с id").Содержит("error-");
	Ожидаем.Что(С, "группа отбита и ссылается на строку")
		.Содержит("role=""radiogroup"" aria-describedby=""" + Ид + """ aria-invalid=""true"">");
	Ожидаем.Что(С, "строка после группы, текст экранирован")
		.Содержит("</div><span class=""field__error segments__error"" role=""alert"" id=""" + Ид + """>Чужое &lt;значение&gt;</span>");
	Ожидаем.Что(СтрНайти(Прежние, "aria-invalid"), "без слова — прежние").Равно(0);
	Ожидаем.Что(Кит.Сегменты("пресет", Кит.Сегмент("a", "А"), Кит.Сегмент("b", "Б")).Ошибка("").Рендер(), "пустой отказ")
		.Равно(Прежние);

	СИсточником = Кит.Сегменты("тема", Кит.Сегмент("a", "А")).Источник("по умолчанию").Ошибка("нет").Рендер();
	Ожидаем.Что(СтрНайти(СИсточником, "aria-describedby=""origin-") > 0
		И СтрНайти(СИсточником, " error-") > 0, "оба описания: " + СИсточником).ЭтоИстина();

	Набор_ = Кит.Сегменты("способ", Кит.Сегмент("a", "А", Кит.Поле("x", "X")), Кит.Сегмент("b", "Б")).Ошибка("нет").Рендер();
	Ожидаем.Что(СтрНайти(Набор_, "segments__panel") < СтрНайти(Набор_, "segments__error"), "строка после панелей").ЭтоИстина();
	Ожидаем.Что(ОбъявлениеЛиста(".segments-set > .segments__error", "order"), "под пилюлей").Равно("-1");
	Ожидаем.Что(ОбъявлениеЛиста(".segments-set > .segments", "order"), "пилюля первой").Равно("-2");
	// разбор листа опускает содержимое кавычек: [aria-invalid="true"] читается как [aria-invalid=""]
	Ожидаем.Что(ОбъявлениеЛиста(".segments[aria-invalid=""""]", "border-color"), "рамка цветом ошибки")
		.Равно("var(--md-sys-color-error)");
	Ожидаем.Что(ТекстСкрипта(), "фокус на отмеченный сегмент")
		.Содержит("bad = bad.querySelector('input:checked') || bad.querySelector('input');");

КонецПроцедуры

#КонецОбласти

#Область ЗначокУСегмента

// П1 (ui-значки): каналы подписки — сегменты со значком перед подписью (глиф или бренд),
// декоративным; без слова разметка сегмента прежняя.
&Тест
Процедура СегментСоЗначком() Экспорт

	Прежний = Кит.Сегменты("канал", Кит.Сегмент("email", "Почта")).Рендер();
	С = Кит.Сегменты("канал", Кит.Сегмент("email", "Почта").Иконка("конверт"),
		Кит.Сегмент("telegram", "Telegram").Иконка("бренд:telegram")).Рендер();
	Ожидаем.Что(Прежний, "без значка прежний")
		.Содержит("</span><span class=""segments__text"">Почта</span>");
	Ожидаем.Что(С, "глиф перед подписью, декоративный")
		.Содержит("</span><svg class=""icon segments__icon"" viewBox=""0 -960 960 960"" aria-hidden=""true""");
	Ожидаем.Что(С, "бренд перед подписью, декоративный")
		.Содержит("<svg class=""icon icon--brand segments__icon"" viewBox=""0 0 24 24"" aria-hidden=""true""");
	Ожидаем.Что(СтрНайти(С, "segments__icon") < СтрНайти(С, ">Почта<"), "значок до подписи").ЭтоИстина();
	Ожидаем.Что(ОшибкаПечати(Кит.Сегменты("канал", Кит.Сегмент("x", "X").Иконка("бренд:нет"))), "чужой бренд")
		.Содержит("бренда «нет» в ките нет");
	Ожидаем.Что(ОбъявлениеЛиста(".segments__icon", "flex"), "значок не сжимается").Равно("none");
	Ожидаем.Что(ОбъявлениеЛиста(".segments__icon", "width"), "18 px").Равно("18px");

КонецПроцедуры

#КонецОбласти

#Область ПустаяЯчейкаСоСвоимЗначком

// П4 (ui-значки), слово владельца 2026-10-14: «По издателю» — своя пустая ячейка. Пусто(Подпись,
// Иконка) — приглушённый значок вместо перечёркнутого круга и видимая подпись рядом
// (скринридер читает подпись в ячейке, видимая скрыта от него); без значка — прежняя ячейка.
&Тест
Процедура ПустаяЯчейкаВыбораЗначкаСоСвоимЗначком() Экспорт

	Прежняя = Кит.ВыборЗначка("з", "Значок").Разделы("бренды").Пусто("По издателю").Рендер();
	Ожидаем.Что(Прежняя, "без значка — перечёркнутый круг").Содержит("<span class=""iconpicker__nothing""></span>");
	Ожидаем.Что(СтрНайти(Прежняя, "iconpicker__caption"), "и без видимой подписи").Равно(0);

	HTML = Кит.ВыборЗначка("з", "Значок").Разделы("бренды").Пусто("По издателю", "ключ").Рендер();
	Ячейка = МеждуМаркеров(HTML, "<div class=""iconpicker__grid iconpicker__grid--none"">", "</label>");
	Ожидаем.Что(Ячейка, "значение пустое, выбрано").Содержит("value="""" checked>");
	Ожидаем.Что(Ячейка, "приглушённый глиф").Содержит("<svg class=""icon iconpicker__default""");
	Ожидаем.Что(СтрНайти(Ячейка, "iconpicker__nothing"), "круга нет").Равно(0);
	Ожидаем.Что(Ячейка, "подпись для скринридера в ячейке").Содержит("<span class=""visually-hidden"">По издателю</span>");
	Ожидаем.Что(HTML, "видимая подпись рядом")
		.Содержит("</label><span class=""iconpicker__caption"" aria-hidden=""true"">По издателю</span></div>");
	Ожидаем.Что(ОбъявлениеЛиста(".iconpicker__item .iconpicker__default", "opacity"), "приглушён").Равно(".6");
	Ожидаем.Что(Кит.ВыборЗначка("з", "Значок").Пусто("", "ключ").Рендер(), "без подписи — словарь")
		.Содержит("aria-hidden=""true"">Без значка</span>");

КонецПроцедуры

#КонецОбласти

#Область ПрозаИзЧужогоHTML

// П1 (ui-каталог-2): README пакета — чужой документ, деревом не собирается. Кит.Проза(Html)
// санитизирует его при печати: скрипт и обработчики не проходят, уже чистый HTML печатается
// как есть — то же, что прежняя сборка Область(Готовое(Чистый)).Вид("проза").
&Тест
Процедура ПрозаСанитизируетЧужойHTML() Экспорт

	Грязный = "<h2>Установка</h2><script>alert(1)</script><p onclick=""x()"">Текст <a href=""javascript:alert(3)"">ссылка</a></p>"
		+ "<img src=""/a.png"" onerror=""x()"" alt=""схема"">";
	HTML = Кит.Проза(Грязный).Рендер();
	Ожидаем.Что(СтрНайти(НРег(HTML), "<script"), "скрипта нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "onclick"), "обработчика нет").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "onerror"), "и у картинки").Равно(0);
	Ожидаем.Что(СтрНайти(НРег(HTML), "javascript:"), "опасной схемы нет").Равно(0);
	Ожидаем.Что(HTML, "проза — div.prose").Содержит("<div class=""prose""><h2>Установка</h2>");

	Чистый = "<h2>Установка</h2><p>Пакет: <code>opm install ромашка</code>, <a href=""https://example.org/doc"">справка</a>.</p>"
		+ "<pre><code class=""language-bsl"">Сообщить(1);</code></pre><table><tr><td align=""right"">1</td></tr></table>"
		+ "<ul><li><input type=""checkbox"" checked disabled> готово</li></ul><p><del>старое</del></p>";
	Очищенный = Новый ЭкранированиеHTML().Очистить(Чистый);
	Ожидаем.Что(Кит.Проза(Очищенный).Рендер(), "уже чистый — как прежняя сборка")
		.Равно(Кит.Область(Кит.Готовое(Очищенный)).Вид("проза").Рендер());
	Ожидаем.Что(Кит.Проза(Очищенный).Якорь("readme").Рендер(), "якорь").Содержит("<div id=""readme"" class=""prose"">");
	Ожидаем.Что(Кит.Проза("").Рендер(), "пустая").Равно("<div class=""prose""></div>");
	Ожидаем.Что(Кит.Проза(Чистый).Рендер(), "галка задачи и зачёркнутое GitHub проходят")
		.Содержит("<del>старое</del>");
	Ожидаем.Что(Кит.Проза(Чистый).Рендер(), "галка задачи").Содержит("<input type=""checkbox""");

КонецПроцедуры

#КонецОбласти

#Область ТриРежимаВеткиСМассовымиГалками

// П15 (слово владельца 2026-10-14 03:20): «все» — дети отмечены и заперты, «никакие» — сняты
// и заперты, «выбранные» — правятся. Сервер печатает детей ветки «все» | «никакие» состоянием
// режима, запертыми (disabled, data-checktree-locked): показ совпадает с тем, что сохранится,
// и без скрипта; запертые в поле «показано» не входят — их решает режим.
&Тест
Процедура ДетиВеткиВсеИНикакиеЗаперты() Экспорт

	Узлы = Новый Массив();
	Для Каждого Режим Из СтрРазделить("все,никакие,выбранные", ",") Цикл
		Дети = Новый Массив();
		Дети.Добавить(Новый Структура("Имя, Подпись, Состояние", Лев(Режим, 2) + "1", "Первый", "выкл"));
		Дети.Добавить(Новый Структура("Имя, Подпись, Состояние", Лев(Режим, 2) + "2", "Второй", "вкл"));
		Узлы.Добавить(Новый Структура("Имя, Подпись, Режим, Дети", "п-" + Лев(Режим, 2), Режим, Режим, Дети));
	КонецЦикла;
	HTML = Кит.ДеревоГалок(Узлы).Режимы("все", "выбранные", "никакие").ТолькоПравки().ПравкиБезСкрипта().Рендер();

	Ожидаем.Что(HTML, "«все»: снятый ребёнок напечатан отмеченным и запертым")
		.Содержит("name=""вс1"" value=""1"" data-checktree-state=""on"" checked disabled data-checktree-locked>");
	Ожидаем.Что(HTML, "«никакие»: отмеченный — снятым и запертым")
		.Содержит("name=""ни2"" value=""1"" data-checktree-state=""off"" disabled data-checktree-locked>");
	Ожидаем.Что(HTML, "«выбранные»: дети своим состоянием, отперты")
		.Содержит("name=""вы1"" value=""1"" data-checktree-state=""off"">");
	Ожидаем.Что(HTML, "«выбранные»: отмеченный").Содержит("name=""вы2"" value=""1"" data-checktree-state=""on"" checked>");
	Ожидаем.Что(HTML, "показано — без запертых").Содержит("value=""=п-вс:все,=п-ни:никакие,-вы1,+вы2,=п-вы:выбранные"" data-checktree-shown>");

	// закрытая приложением галка в ветке «все» — своим признаком закрытой, не запертой режимом
	Дети = Новый Массив();
	Дети.Добавить(Новый Структура("Имя, Подпись, Отключён", "з1", "Закрытый", Истина));
	Закрытые = Новый Массив();
	Закрытые.Добавить(Новый Структура("Имя, Подпись, Режим, Дети", "п", "П", "все", Дети));
	Ожидаем.Что(СтрНайти(Кит.ДеревоГалок(Закрытые).Режимы().Рендер(), "data-checktree-locked"), "закрытая — не заперта")
		.Равно(0);

	Скрипт = ТекстСкрипта();
	Ожидаем.Что(Скрипт, "смена режима запирает и отпирает").Содержит("function ctLockBox(box, lock)");
	Ожидаем.Что(Скрипт, "основа «выбранных» уходит с правкой режима").Содержит("data.append('основа', ed.key + ':' + ed.base);");
	Ожидаем.Что(Скрипт, "подгруженные дети встают по режиму").Содержит("var force = lock ? (mode === 'все' ? 'on' : 'off')");

КонецПроцедуры

// Правки ветки: со скриптом основа приходит полем «основа», без скрипта кит выводит её из
// показанного режима; ПравкиВетки раскладывает правки одной ветки для сервера.
&Тест
Процедура ПравкиВеткиСОсновой() Экспорт

	Дерево = Набор.ДеревоГалок();
	Разбор = Дерево.РазобратьПравки("правки=1&режим=p1%3A%D0%B2%D1%8B%D0%B1%D1%80%D0%B0%D0%BD%D0%BD%D1%8B%D0%B5"
		+ "&основа=p1%3A%D0%B2%D1%81%D0%B5&снять=a&снять=b&снять=x&основа=p2%3Aчто-то");
	Ожидаем.Что(Разбор.Основы.Получить("p1"), "основа p1").Равно("все");
	Ожидаем.Что(Разбор.Основы.Получить("p2"), "чужая основа отброшена").Равно(Неопределено);
	Ветка = Дерево.ПравкиВетки(Разбор, "p1", СтрРазделить("a,b", ","));
	Ожидаем.Что(Ветка.Режим, "режим").Равно("выбранные");
	Ожидаем.Что(Ветка.БылРежим, "начаты со всех").Равно("все");
	Ожидаем.Что(СтрСоединить(Ветка.Снятые, ","), "снятые — только дети ветки").Равно("a,b");

	Все = Дерево.ПравкиВетки(Дерево.РазобратьПравки("правки=1&режим=p1%3A%D0%B2%D1%81%D0%B5&снять=a"), "p1");
	Ожидаем.Что(Все.Режим + "|" + Все.Снятые.Количество(), "«все» — правки детей отброшены").Равно("все|0");

	// без скрипта: показан режим «все», пришли «выбранные» — основа «все»; запертые дети не
	// уходили и в показанном их нет — снятых нет
	БезСкрипта = Дерево.РазобратьПравки("показано=%3Dp1%3A%D0%B2%D1%81%D0%B5%2C%2Bq1"
		+ "&режим%3Ap1=%D0%B2%D1%8B%D0%B1%D1%80%D0%B0%D0%BD%D0%BD%D1%8B%D0%B5&q1=1");
	Ожидаем.Что(БезСкрипта.Режимы.Получить("p1"), "режим сменили").Равно("выбранные");
	Ожидаем.Что(БезСкрипта.Основы.Получить("p1"), "основа — показанный режим").Равно("все");
	Ожидаем.Что(Дерево.ПравкиВетки(БезСкрипта, "p1").БылРежим, "в правках ветки").Равно("все");

	Прежняя = Дерево.ПравкиВетки(Дерево.РазобратьПравки("правки=1&включить=a"), "p1");
	Ожидаем.Что(Прежняя.Режим + "|" + Прежняя.БылРежим + "|" + СтрСоединить(Прежняя.Включённые, ","),
		"без смены режима — хранимое ± правки").Равно("||a");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаПечати(Знач Узел)

	Попытка
		Узел.Рендер();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция МеждуМаркеров(Знач Текст, Знач Начало, Знач Конец)

	Открытие = СтрНайти(Текст, Начало);
	Если Открытие = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Открытие + СтрДлина(Начало));
	Закрытие = СтрНайти(Хвост, Конец);
	Возврат ?(Закрытие = 0, Хвост, Лев(Хвост, Закрытие - 1));

КонецФункции

Функция ТекстСкрипта()

	Корень = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..");
	Текст = Новый ТекстовыйДокумент();
	Текст.Прочитать(ОбъединитьПути(Корень, "src", "статика", "oscript-ui.js"), КодировкаТекста.UTF8);
	Возврат Текст.ПолучитьТекст();

КонецФункции

Функция ТекстФайла(Знач Путь)

	Корень = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..");
	Текст = Новый ТекстовыйДокумент();
	Текст.Прочитать(ОбъединитьПути(Корень, Путь), КодировкаТекста.UTF8);
	Возврат Текст.ПолучитьТекст();

КонецФункции

Функция Правила()

	Если ПравилаЛиста = Неопределено Тогда
		ПравилаЛиста = Разбор.Правила(Разбор.ТекстБазовогоЛиста());
	КонецЕсли;
	Возврат ПравилаЛиста;

КонецФункции

// Значение свойства у правила базового листа с ровно этим селектором под ровно этими
// условиями; из нескольких побеждает последнее, как в каскаде. Нет — Неопределено.
Функция ОбъявлениеЛиста(Знач Селектор, Знач Свойство, Знач Условия = "")

	Результат = Неопределено;
	Для Каждого Правило Из Правила() Цикл
		Если Правило.Селектор = Селектор И Правило.Условия = Условия Тогда
			Значение = Правило.Объявления.Получить(Свойство);
			Если Значение <> Неопределено Тогда
				Результат = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
