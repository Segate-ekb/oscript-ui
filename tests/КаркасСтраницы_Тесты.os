// Корень страницы: документ собирается деревом целиком, а кто такая инсталляция —
// приходит контрактом «ОбрамлениеИнсталляции». Проверяется то, что ломается для человека:
// страница приезжает без темы, вкладка называется не так, ход ведёт не туда, выход
// не работает, скринридер не находит ориентиров.

#Использовать "../"
#Использовать asserts

Перем Каркас;      // КаркасСтраницы — корень страницы
Перем Обрамление;  // ОбрамлениеПробы — чужая инсталляция
Перем Кит;         // Кит — фабрика элементов экрана
Перем Активы;      // АктивыСтатики — адрес базового листа библиотеки

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьКаркас() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");

	Обрамление = Новый ОбрамлениеПробы();
	Слой = Новый СборкаХолста().Собрать(Обрамление);
	Каркас = Слой.Каркас;
	Кит = Слой.Кит;
	Активы = Слой.Активы;

КонецПроцедуры

#Область Документ

// Страница без объявления типа приезжает в браузер режимом совместимости: коробочная
// модель другая, и вёрстка едет вся сразу.
&Тест
Процедура ДокументНачинаетсяОбъявлениемТипаИНесётЯзыкСТемой() Экспорт

	HTML = Страница();

	Ожидаем.Что(СтрНачинаетсяС(HTML, "<!DOCTYPE html>" + Символы.ПС),
		"объявление типа первой строкой: " + Лев(HTML, 60)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<html lang=""ru"" data-theme=""dark"">") > 0,
		"язык и тема на теге документа: " + Лев(HTML, 200)).ЭтоИстина();
	Ожидаем.Что(СтрЗаканчиваетсяНа(HTML, "</body></html>"),
		"документ закрыт: " + Прав(HTML, 40)).ЭтоИстина();

КонецПроцедуры

// Инсталляция без языка не должна получать lang="": пустой язык для скринридера хуже,
// чем его отсутствие.
&Тест
Процедура ДокументБезЯзыкаЕгоНеОбъявляет() Экспорт

	Пустой = Кит.Документ("", "dark").Рендер();

	Ожидаем.Что(СтрНайти(Пустой, "lang="), "пустого lang нет: " + Пустой).Равно(0);
	Ожидаем.Что(СтрНайти(Пустой, "data-theme=""dark""") > 0, "а тема есть: " + Пустой).ЭтоИстина();

КонецПроцедуры

// Голова — не свалка: <p> в ней браузер выбрасывает в тело, и порядок страницы уезжает.
&Тест
Процедура ВГоловуКладутТолькоЕёУзлы() Экспорт

	Поймано = Ложь;
	Попытка
		Кит.Голова().Добавить(Кит.Примечание("текст"));
	Исключение
		Поймано = Истина;
	КонецПопытки;
	Ожидаем.Что(Поймано, "примечание в голову не кладётся").ЭтоИстина();

	Поймано = Ложь;
	Попытка
		Кит.Документ("ru", "dark").Добавить(Кит.Область());
	Исключение
		Поймано = Истина;
	КонецПопытки;
	Ожидаем.Что(Поймано, "в документе живут только голова и тело").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Голова

// Голову собирает ОДИН механизм: объявления, заглавие, иконки, палитра и лист стилей
// идут деревом и в объявленном порядке — иначе страница мигает чужими цветами.
&Тест
Процедура ГоловаСобранаДеревомВОбъявленномПорядке() Экспорт

	Голова = МеждуМаркеров(Страница(), "<head>", "</head>");

	Ожидаем.Что(СтрНачинаетсяС(Голова, "<head><meta charset=""utf-8"">"),
		"кодировка объявлена первой: " + Лев(Голова, 80)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Голова, "<meta name=""viewport"" content=""width=device-width, initial-scale=1"">") > 0,
		"видимая область: " + Голова).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Голова, "<meta name=""referrer"" content=""same-origin"">") > 0,
		"политика перехода пришла от инсталляции: " + Голова).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Голова, "<title>Каталог — Ромашка</title>") > 0,
		"вкладка названа заголовком и знаком: " + Голова).ЭтоИстина();

	Ожидаем.Что(СтрНайти(Голова, "<link rel=""icon"" type=""image/svg+xml"" href=""/ресурсы/значок.svg"">") > 0,
		"иконка инсталляции: " + Голова).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Голова, "<link rel=""icon"" sizes=""any"" href=""/ресурсы/запасной.ico"">") > 0,
		"запасная иконка со своими размерами: " + Голова).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Голова, "<link rel=""stylesheet"" href=""/ресурсы/лист.css"">") > 0,
		"лист стилей инсталляции: " + Голова).ЭтоИстина();

	// палитра обязана стоять ДО листа стилей: иначе первый экран приедет нецветным
	Ожидаем.Что(СтрНайти(Голова, "<style id=""токены-темы"">") > 0
			И СтрНайти(Голова, "<style") < СтрНайти(Голова, "rel=""stylesheet"""),
		"палитра инлайном и раньше листа: " + Голова).ЭтоИстина();

КонецПроцедуры

// Библиотека, поставленная в чужой проект, обязана выглядеть прилично сама по себе:
// свой базовый лист она подключает без единой строки CSS от потребителя.
&Тест
Процедура БазовыйЛистБиблиотекиПодключаетсяСам() Экспорт

	Голова = МеждуМаркеров(Страница(), "<head>", "</head>");

	Ожидаем.Что(СтрНайти(Голова, СтрШаблон("<link rel=""stylesheet"" href=""%1"">",
			Активы.АдресБазовогоЛиста())) > 0,
		"базовый лист библиотеки подключён: " + Голова).ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(Активы.АдресБазовогоЛиста(), "/static/oscript-ui-"),
		"адрес несёт отпечаток содержимого: " + Активы.АдресБазовогоЛиста()).ЭтоИстина();

КонецПроцедуры

// Порядок листов = порядок каскада. Встань лист инсталляции первым — её правило
// перестало бы перебивать китовое, и переопределение работало бы только через
// !important либо повышение специфичности.
&Тест
Процедура БазовыйЛистСтоитПередЛистомИнсталляции() Экспорт

	Голова = МеждуМаркеров(Страница(), "<head>", "</head>");

	Базовый = СтрНайти(Голова, Активы.АдресБазовогоЛиста());
	Свой = СтрНайти(Голова, "/ресурсы/лист.css");

	Ожидаем.Что(Базовый > 0 И Свой > 0 И Базовый < Свой,
		"базовый лист раньше листа инсталляции: " + Голова).ЭтоИстина();

КонецПроцедуры

// Инсталляции, которой хватает базового листа, второй <link> не печатается вовсе:
// запрос в никуда браузер всё равно сделает и получит саму страницу.
&Тест
Процедура ИнсталляцияБезСвоегоЛистаПолучаетТолькоБазовый() Экспорт

	Своё = Новый ОбрамлениеПробы();
	Своё.БезСвоегоЛиста();
	Другая = Новый СборкаХолста().Собрать(Своё);

	Голова = МеждуМаркеров(СтраницаКаркаса(Другая.Каркас), "<head>", "</head>");

	Ожидаем.Что(СтрЧислоВхождений(Голова, "rel=""stylesheet"""),
		"ровно один лист — базовый: " + Голова).Равно(1);
	Ожидаем.Что(СтрНайти(Голова, Другая.Активы.АдресБазовогоЛиста()) > 0,
		"и это он: " + Голова).ЭтоИстина();

КонецПроцедуры

// Пустой заголовок оставляет во вкладке один знак: «— Ромашка» с висящим тире человек
// видит в списке вкладок и в закладках.
&Тест
Процедура ВкладкаБезЗаголовкаНазванаОднимЗнаком() Экспорт

	HTML = Каркас.Страница("", Кит.Примечание("тело"), Контекст());

	Ожидаем.Что(СтрНайти(HTML, "<title>Ромашка</title>") > 0,
		"во вкладке один знак: " + HTML).ЭтоИстина();

КонецПроцедуры

// Правила внутри <style> — это CSS, а не HTML: экранирование там не защищает, а ломает
// объявления. Значение приходит уже провалидированным.
&Тест
Процедура ПравилаСтиляПечатаютсяКакЕсть() Экспорт

	HTML = Кит.Стиль("проба", ":root{--a:'x' > 'y'}").Рендер();

	Ожидаем.Что(HTML).Равно("<style id=""проба"">:root{--a:'x' > 'y'}</style>");

КонецПроцедуры

// Ресурс без адреса — запрос в никуда: браузер сходит за пустотой и получит саму страницу.
&Тест
Процедура РесурсБезАдресаНеПечатается() Экспорт
	Ожидаем.Что(Кит.Ресурс("stylesheet", "").Рендер()).Равно("");
КонецПроцедуры

#КонецОбласти

#Область Тело

// Ориентиры страницы — то, чем скринридер по ней ходит: шапка, основное, подвал.
&Тест
Процедура ТелоРазмеченоОриентирами() Экспорт

	HTML = Страница();

	Ожидаем.Что(СтрНайти(HTML, "<body><header class=""top""><div class=""wrap"">") > 0,
		"шапка страницы с полосой содержимого: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<main class=""wrap"">") > 0,
		"основное — своим ориентиром: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<footer class=""bottom""><div class=""wrap"">Внутренний портал компании</div></footer>") > 0,
		"подвал подписан инсталляцией: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<nav class=""top__nav"">") > 0,
		"ряд ходов в шапке — навигация: " + HTML).ЭтоИстина();

КонецПроцедуры

// Скрипт страницы отложенный и стоит последним: иначе он останавливает разбор разметки
// и первый экран ждёт его загрузки.
&Тест
Процедура СкриптОтложенИСтоитПоследним() Экспорт

	HTML = Страница();

	Ожидаем.Что(СтрНайти(HTML, "<script src=""/ресурсы/страница.js"" defer></script></body></html>") > 0,
		"отложенный скрипт последним ребёнком тела: " + Прав(HTML, 120)).ЭтоИстина();

КонецПроцедуры

// Экран, ещё не собранный деревом, отдаёт строку — она обязана доехать до страницы
// как есть, иначе постраничный перевод встанет.
&Тест
Процедура СодержимоеСтрокойЗаворачиваетсяВГотовыйФрагмент() Экспорт

	HTML = Каркас.Страница("Каталог", "<p>непереведённый экран</p>", Контекст());

	Ожидаем.Что(СтрНайти(HTML, "<main class=""wrap""><p>непереведённый экран</p></main>") > 0,
		"строка встала внутрь основного как есть: " + HTML).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Шапка

// Ход на главную — знак инсталляции: картинка плюс название текстом, чтобы название
// читалось поиском и скринридером, а не пряталось внутрь картинки.
&Тест
Процедура ХодНаГлавнуюНесётЗнакИНазвание() Экспорт

	Шапка = МеждуМаркеров(Страница(), "<header", "</header>");

	Ожидаем.Что(СтрНайти(Шапка, "<a href=""/"" class=""brand""><img class=""brand__mark"""
			+ " src=""/ресурсы/знак.svg"" alt="""" width=""28"" height=""28""><span>Ромашка</span></a>") > 0,
		"знак картинкой, название текстом: " + Шапка).ЭтоИстина();

КонецПроцедуры

// Спрятали название — картинка остаётся единственным именем хода, и подпись обязана
// его назвать: иначе скринридер прочтёт «ссылка» и замолчит.
&Тест
Процедура СпрятанноеНазваниеПереезжаетВПодписьКартинки() Экспорт

	Свой = Новый ОбрамлениеПробы();
	Свой.БезНазвания();
	Другой = Новый СборкаХолста().Собрать(Свой).Каркас;

	Шапка = МеждуМаркеров(СтраницаКаркаса(Другой), "<header", "</header>");

	Ожидаем.Что(СтрНайти(Шапка, "alt=""Ромашка""") > 0,
		"картинка названа знаком: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "<span>Ромашка</span>"),
		"а второго названия рядом нет: " + Шапка).Равно(0);

КонецПроцедуры

// Пропорции загруженного логотипа произвольны: ширина, заданная разметкой, впрессовала
// бы его в чужую рамку. Ширину печатает только знак, чьи пропорции известны.
&Тест
Процедура ЗнакНеизвестныхПропорцийШириныНеПечатает() Экспорт

	Свой = Новый ОбрамлениеПробы();
	Свой.ЗнамяПроизвольныхПропорций();
	Другой = Новый СборкаХолста().Собрать(Свой).Каркас;

	Шапка = МеждуМаркеров(СтраницаКаркаса(Другой), "<header", "</header>");

	Ожидаем.Что(СтрНайти(Шапка, "width="), "ширины нет: " + Шапка).Равно(0);
	Ожидаем.Что(СтрНайти(Шапка, "height=""28""") > 0,
		"высота на месте — под неё занято место: " + Шапка).ЭтоИстина();

КонецПроцедуры

// Переключатель темы работает без единой строки скрипта: обычная форма, значок выбирает
// сервер по текущему оформлению.
&Тест
Процедура ПереключательТемыЭтоФормаБезТокена() Экспорт

	Шапка = МеждуМаркеров(Страница(), "<header", "</header>");

	Ожидаем.Что(СтрНайти(Шапка, "<form method=""post"" action=""/вид"" class=""theme-toggle"">") > 0,
		"форма переключателя на адрес инсталляции: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "Включить светлую тему") > 0,
		"тёмной теме предлагают светлую: " + Шапка).ЭтоИстина();

КонецПроцедуры

// Посетителю нужен ход ко входу, и только он: «Выйти» у того, кто не входил, — обман.
&Тест
Процедура ПосетителюПоказанТолькоХодКоВходу() Экспорт

	Шапка = МеждуМаркеров(Страница(), "<header", "</header>");

	Ожидаем.Что(СтрНайти(Шапка, "<a href=""/вход"" class=""top__link"">Войти</a>") > 0,
		"ход ко входу: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "/выход"), "и никакого выхода: " + Шапка).Равно(0);

КонецПроцедуры

// Вошедший видит своё имя, ход в личное и выход. Выход идёт формой: ход по ссылке
// уводил бы из учётки предзагрузкой соседней вкладки.
&Тест
Процедура ВошедшемуПоказаныИмяЛичноеИВыходФормой() Экспорт

	Шапка = ШапкаУчётки("алиса", Неопределено);

	Ожидаем.Что(СтрНайти(Шапка, "<span class=""who"">") > 0, "имя вошедшего: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "алиса") > 0, "и оно то самое: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "<a href=""/личное"" class=""top__link"">Личное</a>") > 0,
		"ход в личное: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "<form method=""post"" action=""/выход"" class=""form-inline"">") > 0,
		"выход формой, а не ссылкой: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, ">Войти<"), "и второго входа нет: " + Шапка).Равно(0);

КонецПроцедуры

// Имя вошедшего приходит из данных, поэтому оно экранируется по природе текстового узла.
&Тест
Процедура ИмяВошедшегоЭкранируется() Экспорт

	Шапка = ШапкаУчётки("ev<il>&", Неопределено);

	Ожидаем.Что(СтрНайти(Шапка, "<il>"), "сырых скобок нет: " + Шапка).Равно(0);
	Ожидаем.Что(СтрНайти(Шапка, "&lt;il&gt;") > 0, "имя экранировано: " + Шапка).ЭтоИстина();

КонецПроцедуры

// Инсталляция, приславшая модель меню, получает вместо трёх ходов ОДНУ кнопку с именем:
// имя на ней — из рамки, а чем меню наполнено, знает только инсталляция. Своих пунктов
// кит не сочиняет: ни хода в кабинет, ни выхода в панели не окажется, пока их не дали.
&Тест
Процедура МенюУчёткиИзОбрамленияЗаменяетТриХодаОдним() Экспорт

	Шапка = ШапкаУчётки("алиса", МодельМенюУчётки());

	Ожидаем.Что(СтрНайти(Шапка, "<div class=""menu"">") > 0,
		"шапка обслуживает вошедшего меню: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "<span>алиса</span>") > 0,
		"на кнопке — имя вошедшего из рамки: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "<span class=""button__count"" aria-hidden=""true"">4</span>") > 0,
		"и счётчик из модели: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "<span class=""visually-hidden"">4 неразобранных дела</span>") > 0,
		"вместе с подписью счётчика — её тоже дала инсталляция: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "button__chevron") > 0,
		"кнопка видна раскрывающейся: " + Шапка).ЭтоИстина();

	Ожидаем.Что(СтрНайти(Шапка, "class=""who"""),
		"отдельной надписи с именем в полосе больше нет: " + Шапка).Равно(0);
	Ожидаем.Что(СтрНайти(Шапка, "<a href=""/личное"" class=""top__link"">"),
		"и отдельного хода в кабинет тоже: " + Шапка).Равно(0);

	Ожидаем.Что(СтрНайти(Шапка, "<a href=""/личное/вещи""") > 0,
		"пункт из модели инсталляции: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "<form method=""post"" action=""/выход""") > 0,
		"и её же готовый фрагмент — форма выхода: " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "Личное"),
		"кит не сочиняет пунктов: в меню только подписи инсталляции: " + Шапка).Равно(0);

КонецПроцедуры

// Слот меню — добавка, а не замена. Обрамление, написанное до его появления, поля
// «МенюУчётки» не знает вовсе; обрамление, посчитавшее пункты и не набравшее ни одного,
// присылает пустой список. Оба обязаны получить ту же шапку, что и раньше: кнопка,
// открывающая пустоту, хуже трёх отдельных ходов.
&Тест
Процедура ОбрамлениеБезПунктовМенюПечатаетПрежнююШапку() Экспорт

	ПрежняяШапка(ШапкаУчётки("алиса", Неопределено), "поля «МенюУчётки» в рамке нет вовсе");

	Пустая = Новый Структура("Подпись, Счётчик, Пункты",
		"Меню учётки алисы", 4, Новый Массив());
	ПрежняяШапка(ШапкаУчётки("алиса", Пустая), "модель есть, а пунктов в ней ноль");

КонецПроцедуры

// Подпись объясняет кнопку с именем: без неё она безымянна для скринридера, и шапка —
// а с ней КАЖДАЯ страница инсталляции — не собирается. Отказ обязан называть поле
// контракта: иначе искать его будут в компоненте, которого на этом экране никто не звал.
&Тест
Процедура МенюУчёткиБезПодписиОтвергаетсяСУказаниемПоля() Экспорт

	Безымянная = МодельМенюУчётки();
	Безымянная.Вставить("Подпись", "");

	Отказ = ОтказШапки("алиса", Безымянная);

	Ожидаем.Что(Отказ, "модель без подписи — исключение").Заполнено();
	Ожидаем.Что(СтрНайти(Отказ, "МенюУчётки.Подпись") > 0,
		"отказ называет поле контракта, которое надо заполнить: " + Отказ).ЭтоИстина();

	// фикстура вернулась в исходное состояние даже через исключение: соседи по набору
	// не должны получить чужую учётку
	Ожидаем.Что(СтрНайти(МеждуМаркеров(Страница(), "<header", "</header>"), "алиса"),
		"имя из упавшего теста не осталось в обрамлении").Равно(0);

КонецПроцедуры

// Имя на кнопке меню приходит из данных ровно так же, как имя в прежней надписи, —
// значит и экранируется так же.
&Тест
Процедура ИмяВМенюУчёткиЭкранируется() Экспорт

	Шапка = ШапкаУчётки("ev<il>&", МодельМенюУчётки());

	Ожидаем.Что(СтрНайти(Шапка, "<il>"), "сырых скобок на кнопке нет: " + Шапка).Равно(0);
	Ожидаем.Что(СтрНайти(Шапка, "&lt;il&gt;") > 0, "имя экранировано: " + Шапка).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ПриватнаяЧасть

// У приватной части свой ряд разделов, и он встаёт НАД содержимым: человек должен
// увидеть, где он, раньше, чем содержимое страницы.
&Тест
Процедура НавигацияПриватнойВстаётПередСодержимым() Экспорт

	Разделы = Новый Массив();
	Разделы.Добавить(Новый Структура("Подпись, Адрес, Иконка", "Мои вещи", "/личное/вещи", "куб"));
	Обрамление.НавигацияПриватной(Разделы);
	HTML = Страница();
	Обрамление.НавигацияПриватной(Новый Массив());

	Основное = МеждуМаркеров(HTML, "<main", "</main>");
	Ожидаем.Что(СтрНайти(Основное, "office-nav") > 0,
		"разделы приватной части внутри основного: " + Основное).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Основное, "Мои вещи") > 0, "и они те самые: " + Основное).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Основное, "office-nav") < СтрНайти(Основное, "тело страницы"),
		"навигация раньше содержимого: " + Основное).ЭтоИстина();

КонецПроцедуры

// Публичная страница разделов приватной части не показывает вовсе: пустой список
// и означает «страница публичная».
&Тест
Процедура ПубличнаяСтраницаРазделовПриватнойНеПоказывает() Экспорт

	Основное = МеждуМаркеров(Страница(), "<main", "</main>");

	Ожидаем.Что(СтрНайти(Основное, "office-nav"), "чужих разделов нет: " + Основное).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Контекст

// Страница без кук молча теряет оформление читателя, поэтому контекст обязателен,
// а ошибка называет лекарство.
&Тест
Процедура СтраницаБезКонтекстаПадаетИНазываетЛекарство() Экспорт

	Поймано = Ложь;
	Попытка
		Каркас.Страница("Каталог", Кит.Примечание("тело"), Неопределено);
	Исключение
		Поймано = Истина;
		Ожидаем.Что(СтрНайти(ОписаниеОшибки(), "КонтекстСтраницы") > 0,
			"ошибка называет сборку контекста: " + ОписаниеОшибки()).ЭтоИстина();
	КонецПопытки;
	Ожидаем.Что(Поймано, "без контекста — падение, а не молчание").ЭтоИстина();

	Поймано = Ложь;
	Попытка
		Каркас.Страница("Каталог", Кит.Примечание("тело"),
			Новый Структура("Пользователь", Неопределено));
	Исключение
		Поймано = Истина;
	КонецПопытки;
	Ожидаем.Что(Поймано, "контекст без кук — тоже падение").ЭтоИстина();

КонецПроцедуры

// Из чего собрана страница, отвечается объектом, а не чтением одиннадцати файлов.
&Тест
Процедура ДеревоСтраницыПечатаетсяОтКорня() Экспорт

	Дерево = Каркас.Документ("Каталог", Кит.Примечание("тело"), Контекст()).Дерево();

	Ожидаем.Что(СтрНачинаетсяС(Дерево, "документ" + Символы.ПС),
		"корень дерева — документ: " + Лев(Дерево, 80)).ЭтоИстина();
	Для Каждого Род Из СтрРазделить("голова,титул,тело,шапка[страницы],основное[полоса],подвал[страницы]", ",") Цикл
		Ожидаем.Что(СтрНайти(Дерево, Род) > 0,
			СтрШаблон("в дереве виден узел «%1»: %2", Род, Дерево)).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Страница()
	Возврат СтраницаКаркаса(Каркас);
КонецФункции

Функция СтраницаКаркаса(Знач Другой)
	Возврат Другой.Страница("Каталог", Кит.Примечание("тело страницы"), Контекст());
КонецФункции

Функция Контекст()
	Возврат Каркас.КонтекстСтраницы(Неопределено, Неопределено);
КонецФункции

// Модель меню учётки глазами инсталляции: подпись кнопки, счётчик со своей подписью
// и пункты — ход в свои вещи и готовый фрагмент с формой выхода. Ни одного из этих слов
// кит не знает.
Функция МодельМенюУчётки()

	Выход = Кит.ФормаБезТокена("/выход", "меню");
	Выход.Добавить(Кит.Кнопка(Новый Структура("Подпись, Вариант, Размер, Иконка",
		"Выйти из Ромашки", "ссылка", "малый", "выход")));

	Пункты = Новый Массив();
	Пункты.Добавить(Новый Структура("Подпись, Адрес, Иконка", "Мои вещи", "/личное/вещи", "куб"));
	Пункты.Добавить(Новый Структура("HTML", Выход.Рендер()));

	Возврат Новый Структура("Подпись, Счётчик, ПодписьСчётчика, Пункты",
		"Меню учётки алисы", 4, "4 неразобранных дела", Пункты);

КонецФункции

// Шапка страницы вошедшего при заданной модели меню. Обрамление возвращается в исходное
// состояние ЛЮБЫМ путём, включая исключение: иначе имя и меню упавшего теста достались бы
// соседям по набору — фикстура у них общая.
Функция ШапкаУчётки(Знач Имя, Знач Модель)

	Обрамление.Учётка(Имя);
	Обрамление.МенюУчётки(Модель);

	Попытка
		HTML = Страница();
	Исключение
		ВернутьОбрамление();
		ВызватьИсключение;
	КонецПопытки;

	ВернутьОбрамление();
	Возврат МеждуМаркеров(HTML, "<header", "</header>");

КонецФункции

// Отказ каркаса на этой модели; пустая строка означает, что страница собралась.
Функция ОтказШапки(Знач Имя, Знач Модель)

	Попытка
		ШапкаУчётки(Имя, Модель);
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;

	Возврат "";

КонецФункции

Процедура ВернутьОбрамление()

	Обрамление.МенюУчётки(Неопределено);
	Обрамление.Учётка("");

КонецПроцедуры

// Прежняя учётка тремя ходами — то, что видит инсталляция, не заявившая меню.
Процедура ПрежняяШапка(Знач Шапка, Знач Случай)

	Ожидаем.Что(СтрНайти(Шапка, "class=""menu"""),
		"меню в шапке не появилось (" + Случай + "): " + Шапка).Равно(0);
	Ожидаем.Что(СтрНайти(Шапка, "<span class=""who"">") > 0,
		"имя стоит прежней надписью (" + Случай + "): " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "<a href=""/личное"" class=""top__link"">Личное</a>") > 0,
		"ход в кабинет отдельный (" + Случай + "): " + Шапка).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Шапка, "<form method=""post"" action=""/выход"" class=""form-inline"">") > 0,
		"выход отдельной формой (" + Случай + "): " + Шапка).ЭтоИстина();

КонецПроцедуры

Функция МеждуМаркеров(Знач Текст, Знач Начало, Знач Конец)

	От = СтрНайти(Текст, Начало);
	До = СтрНайти(Текст, Конец);
	Возврат ?(От = 0 ИЛИ До = 0, "", Сред(Текст, От, До - От + СтрДлина(Конец)));

КонецФункции

#КонецОбласти
