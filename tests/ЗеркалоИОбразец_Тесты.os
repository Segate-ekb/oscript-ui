// Зеркало значения и образец выпуска 0.12 (шаг 17). Проверяется то, что ломается для
// человека: признак зеркала пропадает молча (на компоненте, на узле без тега), цвет
// уходит в атрибут style непроверенным, образец безымянен для скринридера, переключатель
// темы не говорит, какая тема выбрана, а узлы без зеркала печатаются не так, как прежде.

#Использовать "../"
#Использовать asserts

Перем Кит;  // Кит

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");

	Кит = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы()).Кит;

КонецПроцедуры

#Область Зеркало

// Зеркало — признак data-mirror с именем поля; текст узла — то, что напечатал сервер.
&Тест
Процедура ЗеркалоПечатаетПризнак() Экспорт

	Ожидаем.Что(Кит.Заголовок(2, "Альфа").Зеркало("name").Рендер(), "заголовок с зеркалом")
		.Равно("<h2 data-mirror=""name"">Альфа</h2>");
	Ожидаем.Что(Кит.Надпись("Без названия").Вид("приглушённая").Зеркало("title").Рендер(),
		"признак рядом с классом вида")
		.Равно("<span class=""muted"" data-mirror=""title"">Без названия</span>");

КонецПроцедуры

// Цвет вторым аргументом — то же свойство CSS, что скрипт пишет при вводе: сохранённый цвет
// виден и без скрипта. Цвет приводится к нижнему регистру.
&Тест
Процедура ЦветЗеркалаПечатаетсяСвойствомCSS() Экспорт

	Ожидаем.Что(Кит.Область("Альфа").Зеркало("accent", "#3366FF").Рендер(), "цвет зеркала")
		.Равно("<div data-mirror=""accent"" style=""--mirror-accent:#3366ff"">Альфа</div>");

	Для Каждого Годный Из СтрРазделить("#abc,#abcd,#aabbcc,#aabbccdd", ",") Цикл
		Ожидаем.Что(СтрНайти(Кит.Область().Зеркало("c", Годный).Рендер(), Годный) > 0,
			"годный цвет " + Годный).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// Атрибут style — CSS-контекст: экранирование HTML там не защищает, поэтому всё, кроме
// шестнадцатеричного цвета, останавливает сборку.
&Тест
Процедура НегодныйЦветИлиИмяОтвергаются() Экспорт

	Для Каждого Негодный Из СтрРазделить("red|#12|#12345g|#fff;background:url(x)|var(--x)", "|") Цикл
		Ожидаем.Что(Ошибка("Кит.Область().Зеркало(""accent"", """ + Негодный + """)"),
			"негодный цвет " + Негодный).Содержит("#rrggbb");
	КонецЦикла;

	Ожидаем.Что(Ошибка("Кит.Область().Зеркало("""")"), "пустое имя").Содержит("буквами, цифрами");
	Ожидаем.Что(Ошибка("Кит.Область().Зеркало(""a b"")"), "имя с пробелом").Содержит("буквами, цифрами");
	Ожидаем.Что(Ошибка("Кит.Область().Зеркало(""a[b]"")"), "имя со скобкой").Содержит("буквами, цифрами");
	Ожидаем.Что(Кит.Область().Зеркало("цвет_акцента-2").Рендер(), "кириллица, цифры, - и _ годятся")
		.Равно("<div data-mirror=""цвет_акцента-2""></div>");

КонецПроцедуры

// Компонент рисует себя сам, у текста и холста тега нет: признак на них пропал бы молча.
&Тест
Процедура ЗеркалоНаУзлеБезСвоегоТегаОтвергается() Экспорт

	Ожидаем.Что(Ошибка("Кит.Кнопка(""x"").Зеркало(""name"")"), "компонент")
		.Содержит("компонент рисует себя сам");
	Ожидаем.Что(Ошибка("Кит.Текст(""x"").Зеркало(""name"")"), "текст").Содержит("не печатается");
	Ожидаем.Что(Ошибка("Кит.Холст().Зеркало(""name"")"), "холст").Содержит("не печатается");
	Ожидаем.Что(Ошибка("Кит.Картинка(""/a.png"").Зеркало(""name"")"), "картинка").Содержит("не печатается");

КонецПроцедуры

// Байт в байт: узлы без зеркала печатаются как прежде — ни признака, ни атрибута style.
&Тест
Процедура БезЗеркалаРазметкаПрежняя() Экспорт

	Ожидаем.Что(Кит.Область(Кит.Заголовок(2, "Альфа"), Кит.Надпись("x")).Признак("row", "1").Рендер(),
		"прежняя разметка").Равно("<div data-row=""1""><h2>Альфа</h2><span>x</span></div>");

КонецПроцедуры

#КонецОбласти

#Область Образец

// Образец — фигура: подпись первой (её и читает скринридер именем фигуры), переключатель
// темы — группа кнопок-тумблеров с подписью, рамка с содержимым — последней.
&Тест
Процедура ОбразецПечатаетФигуруСПереключателем() Экспорт

	HTML = Кит.Образец("Шапка сайта", Кит.Заголовок(2, "Альфа").Зеркало("name")).Рендер();

	Ожидаем.Что(HTML, "образец").Равно("<figure class=""preview""><figcaption class=""preview__label"">"
		+ "Шапка сайта</figcaption><div class=""preview__themes"" role=""group"" aria-label=""Тема образца"">"
		+ "<button type=""button"" class=""preview__theme"" data-preview-theme=""light"" aria-pressed=""false"">"
		+ "Светлая</button><button type=""button"" class=""preview__theme"" data-preview-theme=""dark"""
		+ " aria-pressed=""false"">Тёмная</button></div><div class=""preview__frame"">"
		+ "<h2 data-mirror=""name"">Альфа</h2></div></figure>");

КонецПроцедуры

// Тема словом печатает data-theme на рамке и нажатой — свою кнопку.
&Тест
Процедура ТемаОбразцаПечатаетсяНаРамке() Экспорт

	Светлая = Кит.Образец("Шапка", "текст").Тема("светлая").Рендер();
	Ожидаем.Что(СтрНайти(Светлая, "<div class=""preview__frame"" data-theme=""light"">текст</div>") > 0,
		"светлая рамка: " + Светлая).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Светлая, "data-preview-theme=""light"" aria-pressed=""true""") > 0,
		"нажата светлая: " + Светлая).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Светлая, "data-preview-theme=""dark"" aria-pressed=""false""") > 0,
		"тёмная не нажата: " + Светлая).ЭтоИстина();

	Тёмная = Кит.Образец("Шапка").Тема("тёмная").Рендер();
	Ожидаем.Что(СтрНайти(Тёмная, "data-theme=""dark""") > 0, "тёмная рамка: " + Тёмная).ЭтоИстина();

	Ожидаем.Что(Ошибка("Кит.Образец(""Шапка"").Тема(""синяя"")"), "неизвестная тема")
		.Содержит("«светлая», «тёмная»");
	Ожидаем.Что(Ошибка("Кит.Область().Тема(""светлая"")"), "тема не у образца").Содержит("Кит.Образец");

КонецПроцедуры

// Фигура несёт общие атрибуты узла: якорь, признаки и зеркало — цвет на всю рамку.
&Тест
Процедура ОбразецНесётОбщиеАтрибуты() Экспорт

	HTML = Кит.Образец("Шапка").Якорь("p").Зеркало("accent", "#6750a4").Рендер();
	Ожидаем.Что(СтрНачинаетсяС(HTML, "<figure id=""p"" class=""preview"" data-mirror=""accent"""
		+ " style=""--mirror-accent:#6750a4""><figcaption"), "атрибуты фигуры: " + HTML).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОбразецБезПодписиНеСобирается() Экспорт
	Ожидаем.Что(Ошибка("Кит.Образец("""")"), "без подписи").Содержит("не задана подпись");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Ошибка(Знач Код)

	Попытка
		Узел = Вычислить(Код);
		Узел.Рендер();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

#КонецОбласти
