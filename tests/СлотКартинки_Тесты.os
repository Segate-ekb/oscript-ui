// Слот картинки выпуска 0.12 (шаг 16). Проверяется то, что ломается для человека: файл
// уходит без имени или не тем способом (без multipart), без скрипта нечем отправить,
// кнопка «Заменить» не говорит, что заменяет, «Вернуть стандартную» срабатывает без
// подтверждения, слот внутри формы собирается в разметку, которую браузер разберёт иначе.

#Использовать "../"
#Использовать asserts

Перем Кит;  // Кит

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");

	Кит = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы()).Кит;

КонецПроцедуры

#Область Состояния

// Стандартная картинка: сбрасывать нечего — меню ⚙ и окна нет, строка состояния говорит
// «стандартная», кнопка пустого слота — «Загрузить». Форма своя: POST multipart с токеном
// и тихой отправкой, файловое поле с именем, accept и признаком отправки по выбору.
&Тест
Процедура СтандартнаяПечатаетсяБезСброса() Экспорт

	HTML = Кит.Холст(Кит.СлотКартинки("logo", "Логотип").Форма("/brand/logo").Якорь("s"))
		.Токен("т0кен").Рендер();

	Ожидаем.Что(СтрНачинаетсяС(HTML, "<div class=""imgslot"" id=""s""><form method=""post"""
		+ " action=""/brand/logo"" enctype=""multipart/form-data"" class=""imgslot__upload"""
		+ " data-quiet=""""><input type=""hidden"" name=""_csrf"" value=""т0кен"">"),
		"своя форма multipart с токеном: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<div class=""imgslot__preview""></div>") > 0,
		"пустой слот — одна шахматка: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<p class=""imgslot__state"" id=""s-state"">Стандартная</p>") > 0,
		"состояние стандартной из словаря: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span>Загрузить</span>") > 0, "пустой слот — «Загрузить»: " + HTML)
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<input type=""file"" name=""logo"" accept=""image/*"""
		+ " class=""imgslot__file"" aria-labelledby=""s-face s-label"" aria-describedby=""s-state"""
		+ " data-autosubmit></label>") > 0, "файловое поле: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<button type=""submit"" class=""button button--ghost button--sm"">"
		+ "<span>Отправить файл</span></button>") > 0,
		"без скрипта форму отправляет кнопка: " + HTML).ЭтоИстина();

	Ожидаем.Что(СтрНайти(HTML, "imgslot__reset"), "формы сброса нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "<dialog"), "окна сброса нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "class=""menu"""), "меню ⚙ нет").Равно(0);

КонецПроцедуры

// Своя картинка: предпросмотр, состояние, «Заменить» и меню ⚙ с «Вернуть стандартную».
// Пункт меню отправляет форму сброса, а её отправку перехватывает подтверждение
// (data-confirm); кнопка окна отправляет ту же форму с полем подтверждения.
&Тест
Процедура СвояПечатаетсяСоСбросомЧерезПодтверждение() Экспорт

	HTML = Кит.Холст(Кит.СлотКартинки("logo", "Логотип")
		.Адрес("/files/logo.png").Состояние("logo.png · 12 КБ · 3 октября")
		.Форма("/brand/logo").Сброс("/brand/logo/reset").Якорь("s")).Токен("т0кен").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<div class=""imgslot__preview""><img class=""imgslot__image"""
		+ " src=""/files/logo.png"" alt=""""></div>") > 0, "предпросмотр: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, ">logo.png · 12 КБ · 3 октября</p>") > 0, "состояние: " + HTML)
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span>Заменить</span>") > 0, "картинка стоит — «Заменить»: " + HTML)
		.ЭтоИстина();

	Ожидаем.Что(СтрНайти(HTML, "</form><form method=""post"" action=""/brand/logo/reset"""
		+ " class=""imgslot__reset"" id=""s-reset-form"" data-confirm=""s-reset"" data-quiet="""">"
		+ "<input type=""hidden"" name=""_csrf"" value=""т0кен"">") > 0,
		"форма сброса рядом с формой загрузки, не внутри: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "aria-label=""Действия: Логотип""") > 0, "меню ⚙ названо: " + HTML)
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span>Вернуть стандартную</span></button></div></div></div></form>") > 0,
		"пункт меню — кнопка отправки формы сброса: " + HTML).ЭтоИстина();

	Окно = Сред(HTML, СтрНайти(HTML, "<dialog"));
	Ожидаем.Что(СтрНачинаетсяС(Окно, "<dialog class=""modal modal--danger modal--confirm"" id=""s-reset"""
		+ " aria-labelledby=""s-reset-title"" aria-describedby=""s-reset-lead"">"),
		"окно подтверждения: " + Окно).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, ">Вернуть стандартную картинку: Логотип?</h2>") > 0,
		"вопрос называет картинку: " + Окно).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Окно, "<button type=""submit"" class=""button button--danger"" name=""confirmed"""
		+ " value=""1"" form=""s-reset-form""><span>Вернуть стандартную</span></button>") > 0,
		"кнопка подтверждения отправляет форму сброса: " + Окно).ЭтоИстина();
	Ожидаем.Что(СтрЗаканчиваетсяНа(HTML, "</dialog></div>"), "окно — внутри слота: " + HTML).ЭтоИстина();

КонецПроцедуры

// Без скрипта форма сброса уходит без подтверждения, и сервер отвечает страницей, где окно
// сброса напечатано открытым: человек подтверждает там.
&Тест
Процедура ОкноСбросаПечатаетсяОткрытым() Экспорт

	HTML = Кит.Холст(Кит.СлотКартинки("logo", "Логотип").Адрес("/files/logo.png")
		.Форма("/brand/logo").Сброс("/brand/logo/reset").Открыто().Якорь("s")).Токен("т").Рендер();
	Ожидаем.Что(СтрНайти(HTML, " aria-describedby=""s-reset-lead"" open>") > 0,
		"окно сброса открыто: " + HTML).ЭтоИстина();

	Ожидаем.Что(Ошибка("Кит.Холст(Кит.СлотКартинки(""logo"", ""Логотип"").Форма(""/a"").Открыто()).Токен(""т"")"),
		"открытого окна без сброса не бывает").Содержит(".Сброс(");

КонецПроцедуры

// Слова слота: свой accept и своя подпись кнопки; адрес — хвост к адресу дома настроек.
&Тест
Процедура СловаСлотаПишутМодель() Экспорт

	HTML = Кит.Холст(Кит.СлотКартинки("icon", "Значок вкладки").Принимает("image/png,.ico")
		.КнопкаЗагрузки("Выбрать значок").Форма("/brand/icon").Якорь("i")).Токен("т").Рендер();
	Ожидаем.Что(СтрНайти(HTML, " accept=""image/png,.ico""") > 0, "accept: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<span>Выбрать значок</span>") > 0, "подпись кнопки: " + HTML).ЭтоИстина();

	Дом = Кит.ДомНастроек("Оформление", "/settings", "т0кен",
		Кит.Секция("Картинки", Кит.СлотКартинки("logo", "Логотип").Форма("logo").Сброс("logo/reset")
			.Якорь("d")));
	Дом.Раздел("Оформление", "brand").Текущий();
	Печать = Дом.Рендер();
	Ожидаем.Что(СтрНайти(Печать, "action=""/settings/brand/logo"" enctype=""multipart/form-data""") > 0,
		"адрес загрузки — хвост к разделу дома: " + Печать).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Печать, "action=""/settings/brand/logo/reset""") > 0,
		"адрес сброса — тоже: " + Печать).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Печать, "name=""_csrf"" value=""т0кен""") > 0, "токен дома: " + Печать).ЭтоИстина();

КонецПроцедуры

// Без якоря идентификатор выдаёт кит — из имени и места в дереве: ответ повторяется байт
// в байт, а два слота одной страницы получают разные идентификаторы.
&Тест
Процедура ИдентификаторПостоянен() Экспорт

	Первый = Кит.Холст(Кит.СлотКартинки("logo", "Логотип").Форма("/a")).Токен("т").Рендер();
	Второй = Кит.Холст(Кит.СлотКартинки("logo", "Логотип").Форма("/a")).Токен("т").Рендер();
	Ожидаем.Что(Первый, "тот же слот — та же разметка").Равно(Второй);

	Два = Кит.Холст(Кит.СлотКартинки("logo", "Логотип").Форма("/a"),
		Кит.СлотКартинки("logo", "Логотип").Форма("/b")).Токен("т").Рендер();
	Ид = Сред(Два, СтрНайти(Два, " id=""") + 5, 16);
	Ожидаем.Что(СтрЧислоВхождений(Два, " id=""" + Ид + """"), "у двух слотов разные идентификаторы: " + Два)
		.Равно(1);

КонецПроцедуры

#КонецОбласти

#Область Отказы

// Слот — своя форма: внутри другой формы браузер выбросил бы вложенный <form>.
&Тест
Процедура СлотВнутриФормыОтвергается() Экспорт

	Ожидаем.Что(Ошибка("Кит.Форма(""/x"", Кит.СлотКартинки(""logo"", ""Логотип"").Форма(""/a"")).Токен(""т"")"),
		"слот внутри формы").Содержит("внутри формы");

КонецПроцедуры

&Тест
Процедура БезИмениПодписиТокенаИАдресаНеСобирается() Экспорт

	Ожидаем.Что(Ошибка("Кит.Холст(Кит.СлотКартинки("""", ""Логотип"").Форма(""/a"")).Токен(""т"")"),
		"без имени поля").Содержит("не задано Имя");
	Ожидаем.Что(Ошибка("Кит.Холст(Кит.СлотКартинки(""logo"", """").Форма(""/a"")).Токен(""т"")"),
		"без подписи").Содержит("не задана Подпись");
	Ожидаем.Что(Ошибка("Кит.СлотКартинки(""logo"", ""Логотип"").Форма(""/a"")"),
		"без токена").Содержит("CSRF");
	Ожидаем.Что(Ошибка("Кит.Холст(Кит.СлотКартинки(""logo"", ""Логотип"")).Токен(""т"")"),
		"без адреса и без дома").Содержит("абсолютный адрес");
	Ожидаем.Что(Ошибка("Кит.Холст(Кит.СлотКартинки(""logo"", ""Логотип"").Адрес(""javascript:alert(1)"")"
		+ ".Форма(""/a"")).Токен(""т"")"), "опасный адрес картинки").Содержит("не годится");

	Встроенная = Кит.Холст(Кит.СлотКартинки("logo", "Логотип").Адрес("data:image/png;base64,iVBOR")
		.Форма("/a")).Токен("т").Рендер();
	Ожидаем.Что(СтрНайти(Встроенная, "src=""data:image/png;base64,iVBOR""") > 0,
		"встроенная картинка годится: " + Встроенная).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ЧужоеСловоОтвергается() Экспорт

	Ожидаем.Что(Ошибка("Кит.СлотКартинки(""logo"", ""Логотип"").Иконка(""плюс"")"),
		"у слота нет слова Иконка").Содержит("Принимает");
	Ожидаем.Что(Ошибка("Кит.Надпись(""x"").Состояние(""y"")"), "Состояние — слово слота")
		.Содержит("слова «Состояние» нет");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Ошибка(Знач Код)

	Попытка
		Узел = Вычислить(Код);
		Узел.Рендер();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

#КонецОбласти
