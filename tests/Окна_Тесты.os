// Окна выпуска 0.11: окно со слотами, подтверждение, окно по адресу. Проверяется то, что
// ломается для человека: окно безымянно для скринридера, кнопка открывает чужое окно,
// ответ на тот же запрос не повторяется байт в байт, подтверждаемая форма уходит без
// подтверждения или не уходит вовсе, на странице две оболочки или ни одной.

#Использовать "../"
#Использовать asserts

Перем Кит;     // Кит
Перем Каркас;  // КаркасСтраницы
Перем Формы;   // Формы

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Кит = Слой.Кит;
	Каркас = Слой.Каркас;
	Формы = Слой.Формы;

КонецПроцедуры

#Область ОкноСоСлотами

// Слоты печатаются в порядке лид — тело — действия, под шапкой с заголовком и крестиком:
// так их читает и глаз, и скринридер, сколько бы раз слова ни звали в другом порядке.
&Тест
Процедура СлотыПечатаютсяПоПорядку() Экспорт

	HTML = Кит.Окно("Новый проект", Кит.Примечание("тело окна"))
		.Действия(Кит.Кнопка("Создать"))
		.Лид("лид окна")
		.Якорь("w")
		.Рендер();

	Шапка = СтрНайти(HTML, "<div class=""modal__head"">");
	Лид = СтрНайти(HTML, "<p class=""modal__lead"" id=""w-lead"">лид окна</p>");
	Тело = СтрНайти(HTML, "<div class=""modal__body""><p class=""muted"">тело окна</p></div>");
	Действия = СтрНайти(HTML, "<div class=""modal__actions""><button type=""submit""");
	Ожидаем.Что(Шапка > 0 И Лид > Шапка И Тело > Лид И Действия > Тело,
		"шапка — лид — тело — действия: " + HTML).ЭтоИстина();

КонецПроцедуры

// Окно называет себя заголовком, а лид — его описание: скринридер слышит «Новый проект,
// диалог» и следом, о чём он. Ссылка в пустоту оставила бы окно безымянным.
&Тест
Процедура ОкноНазваноЗаголовкомИОписаноЛидом() Экспорт

	HTML = Кит.Окно("Новый проект").Лид("Проект появится сразу").Якорь("w").Рендер();

	Ожидаем.Что(СтрНачинаетсяС(HTML, "<dialog class=""modal"" id=""w"" aria-labelledby=""w-title"""
		+ " aria-describedby=""w-lead"">"), "рамка окна: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<h2 class=""modal__title"" id=""w-title"">Новый проект</h2>") > 0,
		"заголовок с идентификатором: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "command=""close"" commandfor=""w""") > 0,
		"крестик закрывает это окно командой движка: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "aria-label=""Закрыть окно""") > 0,
		"крестик назван словом словаря: " + HTML).ЭтоИстина();

	Без = Кит.Окно("Окно").Якорь("x").Рендер();
	Ожидаем.Что(СтрНайти(Без, "aria-describedby"), "без лида описания нет").Равно(0);
	Ожидаем.Что(СтрНайти(Без, "modal__lead"), "без лида строки нет").Равно(0);
	Ожидаем.Что(СтрНайти(Без, "modal__body"), "без тела обёртки нет").Равно(0);
	Ожидаем.Что(СтрНайти(Без, "modal__actions"), "без действий ряда нет").Равно(0);

КонецПроцедуры

// Вид даёт класс из закрытого набора; неизвестный вид останавливает сборку.
&Тест
Процедура ВидДаётКласс() Экспорт

	Ожидаем.Что(СтрНачинаетсяС(Кит.Окно("О").Вид("опасное").Рендер(), "<dialog class=""modal modal--danger"""),
		"опасное").ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(Кит.Окно("О").Вид("широкое").Рендер(), "<dialog class=""modal modal--wide"""),
		"широкое").ЭтоИстина();
	Ожидаем.Что(СтрНачинаетсяС(Кит.Окно("О").Вид("обычное").Рендер(), "<dialog class=""modal"""),
		"обычное").ЭтоИстина();
	Ожидаем.Что(Ошибка("Кит.Окно(""О"").Вид(""огромное"")"), "неизвестный вид").Заполнено();
	Ожидаем.Что(Ошибка("Кит.Окно(""опасное"")"), "КОНТРОЛЬ: заголовок — не вид").Равно("");
	Ожидаем.Что(Ошибка("Кит.Окно(""О"", ""опасное"")"), "вид на месте ребёнка").Заполнено();

КонецПроцедуры

// Окно без заголовка безымянно для скринридера — оно не печатается.
&Тест
Процедура ОкноБезЗаголовкаНеПечатается() Экспорт
	Ожидаем.Что(Ошибка("Кит.Окно("""")"), "пустой заголовок").Заполнено();
КонецПроцедуры

// Открыто — окно, которое сервер печатает по ?окно=…: атрибут open.
&Тест
Процедура ОткрытоПечатаетOpen() Экспорт

	Ожидаем.Что(СтрНайти(Кит.Окно("О").Открыто().Рендер(), " open>") > 0, "открыто").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кит.Окно("О").Открыто(Ложь).Рендер(), " open"), "закрыто").Равно(0);
	Ожидаем.Что(Ошибка("Кит.Холст().Открыто()"), "открытым бывает окно").Заполнено();

КонецПроцедуры

// Кнопка, которой дали узел окна, — команда движка show-modal с его идентификатором.
&Тест
Процедура КнопкаОткрываетОкноКомандойДвижка() Экспорт

	Окно = Кит.Окно("Новый проект");
	HTML = Кит.Холст(Кит.Кнопка("Создать проект").Открывает(Окно), Окно).Рендер();
	Ид = ИдОкна(HTML);

	Ожидаем.Что(СтрНайти(HTML, СтрШаблон("<button type=""button"" class=""button button--primary"""
		+ " command=""show-modal"" commandfor=""%1"">", Ид)) > 0, "команда и цель: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "popovertarget"), "не всплывающая панель").Равно(0);

	// строкой — идентификатор окна этой же страницы; не окно — прежняя всплывающая панель
	Именное = Кит.Окно("Правка").Якорь("pravka");
	Строкой = Кит.Холст(Кит.Кнопка("Править").Открывает("pravka"), Именное).Рендер();
	Ожидаем.Что(СтрНайти(Строкой, "command=""show-modal"" commandfor=""pravka""") > 0,
		"строка-идентификатор окна: " + Строкой).ЭтоИстина();
	Панель = Кит.Кнопка("Меню").Открывает("panel").Рендер();
	Ожидаем.Что(СтрНайти(Панель, "popovertarget=""panel""") > 0, "панель по-прежнему: " + Панель).ЭтоИстина();

	Ожидаем.Что(Ошибка("Кит.Кнопка(""К"").Открывает(Кит.Холст())"), "открывают окно, а не холст").Заполнено();

КонецПроцедуры

// Идентификатор, выданный китом, повторяется на том же дереве (ответ на тот же запрос
// байт в байт), а у двух окон с одним заголовком в разных местах — разный.
&Тест
Процедура ИдентификаторПостояненИРазличим() Экспорт

	Первый = ЭкранСДвумяОкнами().Рендер();
	Второй = ЭкранСДвумяОкнами().Рендер();
	Ожидаем.Что(Первый, "ответ повторяется байт в байт").Равно(Второй);

	Ид1 = ИдОкна(Первый);
	Ид2 = ИдОкна(Сред(Первый, СтрНайти(Первый, "</dialog>")));
	Ожидаем.Что(СтрНачинаетсяС(Ид1, "okno-") И СтрДлина(Ид1) = 13, "вид идентификатора: " + Ид1).ЭтоИстина();
	Ожидаем.Что(Ид1 <> Ид2, "два окна — два идентификатора: " + Ид1 + " " + Ид2).ЭтоИстина();

	Ожидаем.Что(ИдОкна(Кит.Окно("О").Якорь("svoi").Рендер()), "якорь главнее").Равно("svoi");

КонецПроцедуры

// Окно-форма: коробка — <form> с токеном из контекста, тихая отправка — у формы, не у окна.
&Тест
Процедура ОкноФормаБерётТокенИзКонтекста() Экспорт

	HTML = Кит.Холст(Кит.Окно("Новый проект", Кит.Поле("name", "Название"))
		.Форма("/проекты").БезПерезагрузки().Якорь("w")
		.Действия(Кит.Кнопка("Создать"))).Токен("токен-сессии").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "<dialog class=""modal"" id=""w"" aria-labelledby=""w-title""><form"
		+ " method=""post"" action=""/проекты"" class=""modal__box"" data-quiet=""""><input type=""hidden"""
		+ " name=""_csrf"" value=""токен-сессии"">") > 0, "форма окна: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "</div></form></dialog>") > 0, "действия внутри формы: " + HTML).ЭтоИстина();

	Ожидаем.Что(ОшибкаПечати(Кит.Окно("О").Форма("/x")), "форма окна без токена").Заполнено();
	Ожидаем.Что(ОшибкаПечати(Кит.Холст(Кит.Окно("О").Форма("")).Токен("т")),
		"относительный адрес без дома").Заполнено();

КонецПроцедуры

// Признак data-focus — тем словом, которым сервер помечает только что созданную запись.
&Тест
Процедура ФокусПечатаетПризнак() Экспорт

	HTML = Кит.Таблица(Кит.Колонка("Проект"), Кит.Запись(Кит.Ячейка("Дельта")).Фокус()).Рендер();
	Ожидаем.Что(СтрНайти(HTML, "<tr data-focus="""">") > 0, "признак у записи: " + HTML).ЭтоИстина();

КонецПроцедуры

// Прежний вызов с объявленной формой печатает прежний HTML — тот же, что
// ОбъявлениеФормы.ОтрисоватьВОкне, — и кнопка открывает его по идентификатору объявления.
&Тест
Процедура ОбъявленнаяФормаДаётПрежнийHTML() Экспорт

	Объявление = Формы.Новая();
	Объявление.Поле("имя", "Имя проекта");
	Свойства = Новый Структура("Заголовок, Лид, Открывашка, Отмена, Отправка", "Новый проект",
		"Пояснение", "Завести", "Отмена", "Создать");

	Прямо = Объявление.ОтрисоватьВОкне(Новый Структура(), "/проекты", "т", Свойства);
	Узел = Кит.Окно(Объявление, Новый Структура(), "/проекты", "т", Свойства);
	Ожидаем.Что(Узел.Рендер(), "прежний HTML байт в байт").Равно(Прямо);
	Ожидаем.Что(Узел.Род(), "новый узел").Равно("окно");
	Ожидаем.Что(СтрНайти(Прямо, "<dialog class=""modal"" id=""" + Объявление.ИдентификаторОкна()
		+ """ aria-label=""Новый проект""><div class=""modal__box""><h2>Новый проект</h2>") > 0,
		"прежняя рамка: " + Прямо).ЭтоИстина();

	Кнопка = Кит.Кнопка("Ещё раз").Открывает(Узел).Рендер();
	Ожидаем.Что(СтрНайти(Кнопка, "commandfor=""" + Объявление.ИдентификаторОкна() + """") > 0,
		"кнопка открывает прежнее окно: " + Кнопка).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Подтверждение

// Эхо-поле печатает pattern из образца — буквально: точка образца не «любой символ».
// Кнопка подтверждения — опасная и несёт поле подтверждения, по которому сервер узнаёт
// подтверждённую отправку.
&Тест
Процедура ЭхоПечатаетPatternАКнопкаОпасная() Экспорт

	HTML = Кит.Форма("/проекты/1", Кит.Подтверждение("Удалить проект?", "Ключи перестанут работать.")
		.Эхо("name", "альфа.бета (1)").Кнопка("Удалить").Якорь("p")).Токен("т").Рендер();

	Ожидаем.Что(СтрНайти(HTML, "pattern=""альфа\.бета \(1\)""") > 0, "pattern: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<button type=""submit"" class=""button button--danger"" name=""confirmed"""
		+ " value=""1""><span>Удалить</span></button>") > 0, "кнопка опасная: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<dialog class=""modal modal--danger modal--confirm"" id=""p""") > 0,
		"окно опасного вида: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "aria-describedby=""p-lead""") > 0
		И СтрНайти(HTML, "<p class=""modal__lead"" id=""p-lead"">Ключи перестанут работать.</p>") > 0,
		"последствия — описание окна: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "Чтобы подтвердить, введите «альфа.бета (1)»") > 0,
		"подпись эха из словаря: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "required disabled") > 0,
		"эхо закрытого окна заблокировано и обязательно: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "command=""close"" commandfor=""p""><span>Отмена</span>") > 0,
		"отмена закрывает окно: " + HTML).ЭтоИстина();

	Открытое = Кит.Форма("/x", Кит.Подтверждение("Удалить?").Эхо("n", "да").Открыто()).Токен("т").Рендер();
	Ожидаем.Что(СтрНайти(Открытое, "disabled"), "эхо открытого окна доступно: " + Открытое).Равно(0);

КонецПроцедуры

// Форма с подтверждением: data-confirm с идентификатором окна и свой id, на который
// ссылаются кнопка и эхо-поле окна, стоящего вне формы.
&Тест
Процедура ФормаСПодтверждениемСвязанаСОкном() Экспорт

	Подтверждение = Кит.Подтверждение("Удалить проект?", "Насовсем.").Эхо("name", "Альфа").Якорь("p");
	HTML = Кит.Холст(
		Кит.Форма("/проекты/1/удалить", Кит.Кнопка("Удалить").Опасная()).СПодтверждением(Подтверждение),
		Подтверждение).Токен("т").Рендер();

	Ожидаем.Что(СтрНачинаетсяС(HTML, "<form method=""post"" action=""/проекты/1/удалить"" id=""p-form"""
		+ " data-confirm=""p"">"), "признак формы: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "name=""confirmed"" value=""1"" form=""p-form""") > 0,
		"кнопка окна отправляет форму: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "form=""p-form"" placeholder=""Альфа""") > 0,
		"эхо уходит с формой: " + HTML).ЭтоИстина();

	// якорь формы главнее выданного идентификатора; имя окна строкой находит своё окно
	Второе = Кит.Подтверждение("Удалить?").Якорь("q");
	Строкой = Кит.Холст(Кит.Форма("/x").Якорь("f").СПодтверждением("q"), Второе).Токен("т").Рендер();
	Ожидаем.Что(СтрНайти(Строкой, "<form method=""post"" action=""/x"" id=""f"" data-confirm=""q"">") > 0,
		"якорь формы: " + Строкой).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Строкой, "form=""f""><span>Подтвердить</span>") > 0,
		"кнопка по умолчанию и связь по имени: " + Строкой).ЭтоИстина();

	Ожидаем.Что(Ошибка("Кит.Холст().СПодтверждением(""q"")"), "подтверждение спрашивает форма").Заполнено();

КонецПроцедуры

// Подтверждению без формы нечего отправлять — оно не печатается молча неработающим.
&Тест
Процедура ПодтверждениеБезФормыНеПечатается() Экспорт

	Ожидаем.Что(ОшибкаПечати(Кит.Подтверждение("Удалить?")), "без формы").Заполнено();
	Ожидаем.Что(ОшибкаПечати(Кит.Холст(Кит.Подтверждение("Удалить?").Форма("/x")).Токен("т")),
		"КОНТРОЛЬ: своя форма").Равно("");
	Ожидаем.Что(ОшибкаПечати(Кит.Форма("/x", Кит.Подтверждение("Удалить?")).Токен("т")),
		"КОНТРОЛЬ: форма вокруг").Равно("");
	Ожидаем.Что(Ошибка("Кит.Подтверждение(""У"").Эхо(""n"", """")"), "эхо без образца").Заполнено();
	Ожидаем.Что(Ошибка("Кит.Окно(""У"").Эхо(""n"", ""да"")"), "эхо — у подтверждения").Заполнено();

КонецПроцедуры

// Отказ сервера ложится под эхо-полем: набранное не совпало с образцом.
&Тест
Процедура ОтказПодЭхоПолем() Экспорт

	HTML = Кит.Форма("/x", Кит.Подтверждение("Удалить?").Эхо("n", "да").Открыто().Якорь("p")
		.Ошибка("Не совпало")).Токен("т").Рендер();
	Ожидаем.Что(СтрНайти(HTML, "aria-invalid=""true"" aria-describedby=""p-echo-err""") > 0
		И СтрНайти(HTML, "<span class=""field__error"" role=""alert"" id=""p-echo-err"">Не совпало</span>") > 0,
		"отказ у эха: " + HTML).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область ОкноПоАдресу

// Без скрипта кнопка — ссылка на страницу с окном; признак — для скрипта.
&Тест
Процедура КнопкаОкнаПоАдресуСсылка() Экспорт

	HTML = Кит.ОкноПоАдресу("/проекты?окно=правка&id=1", "Править").Малая().Иконка("карандаш").Рендер();
	Ожидаем.Что(СтрНачинаетсяС(HTML, "<a href=""/проекты?окно=правка&amp;id=1"" class=""button button--ghost"
		+ " button--sm"" data-window-link><svg"), "ссылка-кнопка: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрЗаканчиваетсяНа(HTML, "<span>Править</span></a>"), "подпись: " + HTML).ЭтоИстина();

	Значок = Кит.ОкноПоАдресу("?окно=1", "Править").ТолькоИконка().Иконка("карандаш").Рендер();
	Ожидаем.Что(СтрНайти(Значок, "title=""Править"" aria-label=""Править""") > 0,
		"кнопка-значок названа: " + Значок).ЭтоИстина();

	Ожидаем.Что(Ошибка("Кит.ОкноПоАдресу(""javascript:alert(1)"", ""П"")"), "чужая схема").Заполнено();
	Ожидаем.Что(Ошибка("Кит.ОкноПоАдресу(""//чужой.сайт/x"", ""П"")"), "чужой хост").Заполнено();
	Ожидаем.Что(Ошибка("Кит.ОкноПоАдресу(""/x"", """")"), "без подписи").Заполнено();
	Ожидаем.Что(Ошибка("Кит.ОкноПоАдресу(""/x"", ""П"").Заголовок(""з"")"), "чужое слово").Заполнено();

КонецПроцедуры

// Оболочка одна на страницу, сколько бы кнопок ни было; без кнопок её нет вовсе — страница
// без окон по адресу остаётся той же байт в байт.
&Тест
Процедура ОболочкаОднаНаСтраницу() Экспорт

	Содержимое = Кит.Холст(
		Кит.ОкноПоАдресу("?окно=1", "Первое"),
		Кит.Область(Кит.ОкноПоАдресу("?окно=2", "Второе")),
		Кит.Таблица(Кит.Колонка("К"), Кит.Запись(Кит.Ячейка(Кит.ОкноПоАдресу("?окно=3", "Третье")))));
	HTML = Каркас.Страница("Проекты", Содержимое, Контекст());

	Ожидаем.Что(СтрЧислоВхождений(HTML, "data-window-link"), "три кнопки").Равно(3);
	Ожидаем.Что(СтрЧислоВхождений(HTML, "data-window-shell"), "одна оболочка").Равно(1);
	Ожидаем.Что(СтрНайти(HTML, "<dialog class=""modal"" id=""okno-po-adresu"" data-window-shell></dialog>"
		+ "<div class=""window-error"" data-window-error hidden><div class=""toast toast--err"" role=""alert"">") > 0,
		"оболочка и тост ошибки: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "data-window-shell") > СтрНайти(HTML, "</main>"),
		"оболочка после содержимого").ЭтоИстина();

	Без = Каркас.Страница("Проекты", Кит.Холст(Кит.Примечание("ничего нет")), Контекст());
	Ожидаем.Что(СтрНайти(Без, "data-window"), "без кнопок оболочки нет").Равно(0);

	Строкой = Каркас.Страница("Проекты", Кит.ОкноПоАдресу("?окно=1", "П").Рендер(), Контекст());
	Ожидаем.Что(СтрЧислоВхождений(Строкой, "data-window-shell"), "содержимое строкой").Равно(1);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭкранСДвумяОкнами()
	Возврат Кит.Холст(Кит.Окно("Правка"), Кит.Область(Кит.Окно("Правка")));
КонецФункции

Функция ИдОкна(Знач HTML)

	Начало = СтрНайти(HTML, "<dialog");
	Хвост = Сред(HTML, Начало);
	Метка = " id=""";
	Позиция = СтрНайти(Хвост, Метка) + СтрДлина(Метка);
	Хвост = Сред(Хвост, Позиция);
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

Функция Контекст()
	Возврат Каркас.КонтекстСтраницы(Неопределено, Неопределено);
КонецФункции

Функция Ошибка(Знач Код)

	Попытка
		Узел = Вычислить(Код);
		Узел.Рендер();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция ОшибкаПечати(Знач Узел)

	Попытка
		Узел.Рендер();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

#КонецОбласти
