// Проверка до отправки и тост из ответа (выпуск 0.12, шаги 18 и 19). Проверяется то, что
// ломается для человека: браузер проверяет одно, а сервер другое; отказ до отправки звучит
// не теми словами, что отказ сервера; ошибка сервера ложится не туда, куда скрипт пишет
// свою; прежнее поле меняет разметку без спроса; тост тревоги закрывается сам; список
// и цвет теряют справку и ограничения, которые несут прочие поля.

#Использовать "../"
#Использовать asserts

Перем Кит;     // Кит
Перем Набор;   // НаборКомпонентов
Перем Формы;   // Формы

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");

	// словарь пробной инсталляции: тексты form.error.* в нём есть, как на боевой
	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Кит = Слой.Кит;
	Набор = Слой.Набор;
	Формы = Слой.Формы;

КонецПроцедуры

#Область ОдинИсточник

// Объявление — один источник: атрибуты, которые проверяет браузер, и тексты отказов,
// которые пишет скрипт, печатаются из одних и тех же слов описания поля.
&Тест
Процедура ОбъявлениеПечатаетОграниченияИТекстыОтказов() Экспорт

	HTML = Объявление().Отрисовать(Неопределено, "/проекты", "т");

	Сайт = Управление(HTML, "site");
	Ожидаем.Что(СтрНайти(Сайт, "type=""url""") > 0 И СтрНайти(Сайт, " required") > 0,
		"адрес: type=url и required: " + Сайт).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Сайт, "data-error-required=""Заполните поле""") > 0,
		"текст пустого поля из словаря: " + Сайт).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Сайт, "data-error-type=""Нужен адрес страницы целиком, например https://пример.рф""") > 0,
		"текст негодного адреса из словаря: " + Сайт).ЭтоИстина();

	Имя = Управление(HTML, "name");
	Ожидаем.Что(СтрНайти(Имя, "minlength=""2"" maxlength=""40"" pattern=""[a-z0-9\-]+""") > 0,
		"длина и шаблон: " + Имя).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Имя, "data-check=""/проекты/имя""") > 0, "адрес проверки на сервере: " + Имя)
		.ЭтоИстина();
	Ожидаем.Что(СтрНайти(Имя, "data-error-pattern=""Значение не подходит под образец""") > 0
		И СтрНайти(Имя, "data-error-minlength=""Не короче 2 символов""") > 0
		И СтрНайти(Имя, "data-error-maxlength=""Не длиннее 40 символов""") > 0,
		"тексты шаблона и длины с пределом: " + Имя).ЭтоИстина();

	Почта = Управление(HTML, "mail");
	Ожидаем.Что(СтрНайти(Почта, "type=""email""") > 0
		И СтрНайти(Почта, "data-error-type=""Нужен адрес почты, например имя@пример.рф""") > 0,
		"почта: " + Почта).ЭтоИстина();

	Лимит = Управление(HTML, "limit");
	Ожидаем.Что(СтрНайти(Лимит, "min=""1"" max=""100""") > 0
		И СтрНайти(Лимит, "data-error-min=""Не меньше 1""") > 0
		И СтрНайти(Лимит, "data-error-max=""Не больше 100""") > 0
		И СтрНайти(Лимит, "data-error-number=""Нужно число""") > 0,
		"число с пределами: " + Лимит).ЭтоИстина();

КонецПроцедуры

// Поле холста печатает те же ограничения теми же словами, что и объявленное.
&Тест
Процедура ПолеХолстаПечатаетТоЖеЧтоОбъявленное() Экспорт

	Холст = Кит.Поле("name", "Имя").Ид("name").Обязательное().Длина(2, 40).Шаблон("[a-z0-9\-]+")
		.ПроверкаНаСервере("/проекты/имя").Рендер();
	Объявленное = Управление(Объявление().Отрисовать(Неопределено, "/проекты", "т"), "name");

	Ожидаем.Что(Управление(Холст, "name"), "управление поля холста и объявленного").Равно(Объявленное);

	Пределы = Кит.Поле("limit", "Лимит").ТипЗначения(Тип("Число")).Пределы(1, 100)
		.ПроверкаДоОтправки().Рендер();
	Ожидаем.Что(СтрНайти(Пределы, "min=""1"" max=""100""") > 0
		И СтрНайти(Пределы, "data-error-max=""Не больше 100""") > 0, "пределы холста: " + Пределы).ЭтоИстина();

	Срок = Кит.Поле("до", "Срок").ТипЗначения(Тип("Дата")).Пределы(Дата(2024, 1, 1), Дата(2024, 12, 31)).Рендер();
	Ожидаем.Что(СтрНайти(Срок, "min=""2024-01-01"" max=""2024-12-31""") > 0,
		"пределы даты — в формате ввода: " + Срок).ЭтоИстина();

	// явные пределы старше максимума, который дали квалификаторы типа, в любом порядке
	Порядок = Кит.Поле("n", "N").Пределы(1, 5)
		.ТипЗначения(Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0))).Рендер();
	Ожидаем.Что(СтрНайти(Порядок, "max=""5""") > 0, "Пределы до ТипЗначения: " + Порядок).ЭтоИстина();

КонецПроцедуры

// Поле, которому проверку до отправки не включали, печатается как прежде байт в байт:
// и прежние ограничения (обязательность, почта, пределы), и прежние слова.
&Тест
Процедура ПрежнееПолеБезНовыхСловТоЖеБайтВБайт() Экспорт

	Ожидаем.Что(Кит.Поле("mail", "Почта").ТипЗначения("email").Обязательное().Рендер(),
		"почта холста").Равно(Набор.Поле().Отрисовать(
			Новый Структура("Имя, Метка, Тип, Обязательное", "mail", "Почта", "email", Истина)));

	Прежнее = Формы.Новая();
	Прежнее.Поле("срок", "Срок, дней").ТипЗначения(Тип("Число")).Пределы(1, 90).Обязательное();
	HTML = Прежнее.Отрисовать(Неопределено, "/x", "т");
	Ожидаем.Что(СтрНайти(HTML, "data-error"), "у прежнего поля объявления текстов нет: " + HTML).Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "data-check"), "и адреса проверки нет").Равно(0);
	Ожидаем.Что(СтрНайти(HTML, "minlength"), "и пустых пределов длины нет").Равно(0);

КонецПроцедуры

// Негодный шаблон останавливает сборку там, где его объявили, а не на первом запросе.
&Тест
Процедура НегодныйШаблонОстанавливаетСборку() Экспорт

	Текст = "";
	Попытка
		Формы.Новая().Поле("name", "Имя").Шаблон("[a-");
	Исключение
		Текст = ОписаниеОшибки();
	КонецПопытки;
	Ожидаем.Что(СтрНайти(Текст, "не регулярное выражение") > 0, "исключение называет беду: " + Текст)
		.ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Сервер

// Без скрипта судит сервер — теми же ограничениями и теми же словами, что поле печатает
// браузеру: отказ до отправки и отказ после неё одинаковы.
&Тест
Процедура РазборОтбиваетТеЖеОграниченияТемиЖеСловами() Экспорт

	Форма = Объявление();
	Присланное = Новый Соответствие();
	Присланное.Вставить("site", "пример.рф");
	Присланное.Вставить("name", "Имя");
	Присланное.Вставить("mail", "кто-то@");
	Присланное.Вставить("limit", "500");
	Итог = Форма.Разобрать(Присланное);
	HTML = Форма.Отрисовать(Неопределено, "/проекты", "т");

	Ожидаем.Что(Итог.Принято, "негодное не принято").ЭтоЛожь();
	Ожидаем.Что(Итог.Отказы.Получить("site"), "адрес без схемы")
		.Равно(Атрибут(Управление(HTML, "site"), "data-error-type"));
	Ожидаем.Что(Итог.Отказы.Получить("name"), "регистр значим: «Имя» не под [a-z0-9\-]+")
		.Равно(Атрибут(Управление(HTML, "name"), "data-error-pattern"));
	Ожидаем.Что(Итог.Отказы.Получить("mail"), "почта без домена")
		.Равно(Атрибут(Управление(HTML, "mail"), "data-error-type"));
	Ожидаем.Что(Итог.Отказы.Получить("limit"), "число вне пределов")
		.Равно(Атрибут(Управление(HTML, "limit"), "data-error-max"));

	Присланное.Вставить("name", "a");
	Ожидаем.Что(Объявление().Разобрать(Присланное).Отказы.Получить("name"), "короче двух")
		.Равно("Не короче 2 символов");

	Годное = Новый Соответствие();
	Годное.Вставить("site", "https://пример.рф/проект");
	Годное.Вставить("name", "my-project");
	Годное.Вставить("mail", "имя@example.com");
	Годное.Вставить("limit", "100");
	Годное_ = Объявление().Разобрать(Годное);
	// почта по правилу type=email: домен латиницей (кириллица в имени до @ — тоже нет)
	Ожидаем.Что(Годное_.Отказы.Получить("mail"), "кириллица в почте браузер не пропускает").Заполнено();
	Годное.Вставить("mail", "name@example.com");
	Годное_ = Объявление().Разобрать(Годное);
	Ожидаем.Что(Годное_.Принято, "годное принято: " + Годное_.Отказ).ЭтоИстина();

КонецПроцедуры

// Ошибка сервера ложится туда же, куда скрипт пишет свою: в field__error своего поля,
// а поле помечается aria-invalid и ссылается на текст из aria-describedby. Тексты отказов
// при этом на месте — после исправления скрипт проверяет поле дальше.
&Тест
Процедура ОтказСервераЛожитсяВТоЖеМесто() Экспорт

	Форма = Объявление();
	Присланное = Новый Соответствие();
	Присланное.Вставить("site", "https://пример.рф");
	Присланное.Вставить("name", "alpha");
	Присланное.Вставить("mail", "");
	Присланное.Вставить("limit", "");
	Форма.Разобрать(Присланное);
	Форма.Отбить("name", "Имя «alpha» занято");
	HTML = Форма.Отрисовать(Неопределено, "/проекты", "т");

	Ожидаем.Что(СтрНайти(HTML, "<span class=""field__error"" role=""alert"" id=""name-err"">Имя «alpha» занято</span>") > 0,
		"текст отказа под своим полем: " + HTML).ЭтоИстина();
	Имя = Управление(HTML, "name");
	Ожидаем.Что(СтрНайти(Имя, "aria-invalid=""true"" aria-describedby=""name-err""") > 0
		И СтрНайти(Имя, "data-check=""/проекты/имя""") > 0, "поле отбито и проверяется дальше: " + Имя)
		.ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СписокИЦвет

// Справка и проверка до отправки доходят и до полей «список» и «цвет»: у них своя разметка,
// но атрибуты ввода те же, что у прочих полей, — иначе скринридер не услышал бы справку,
// а браузер и скрипт не знали бы пределов списка.
&Тест
Процедура СписокСоСправкойИДлинойНесётОграничения() Экспорт

	HTML = Кит.Поле("маски", "Маски файлов").Ид("masks").Список().Справка("Через запятую или Enter.")
		.Длина(2, 40).Рендер();

	Ввод = Тег(HTML, "chips-in__input");
	Ожидаем.Что(Атрибут(Ввод, "aria-describedby"), "строка ввода ссылается на справку: " + Ввод)
		.Равно("masks-help");
	Ожидаем.Что(СтрНайти(Ввод, "minlength=""2"" maxlength=""40""") > 0
		И СтрНайти(Ввод, "data-error-minlength=""Не короче 2 символов""") > 0
		И СтрНайти(Ввод, "data-error-maxlength=""Не длиннее 40 символов""") > 0,
		"пределы длины и их тексты: " + Ввод).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "<div class=""field-help""><div class=""field field--chips"" data-chips>") > 0
		И СтрНайти(HTML, "<span class=""help__pop"" id=""masks-help"" popover>Через запятую или Enter.</span></div>") > 0,
		"значок и поповер справки рядом со списком: " + HTML).ЭтоИстина();

	// без новых слов список тот же, что раньше: ни справки, ни признаков проверки
	Прежний = Кит.Поле("маски", "Маски файлов").Список().Рендер();
	Ожидаем.Что(СтрНайти(Прежний, "field-help") + СтрНайти(Прежний, "data-error")
		+ СтрНайти(Прежний, "minlength") + СтрНайти(Прежний, "aria-describedby"), "прежний список: " + Прежний)
		.Равно(0);

КонецПроцедуры

// Поле цвета: справка — у поля кода, отказ шаблона — свой текст form.error.color, тот же,
// что отдаёт разбор.
&Тест
Процедура ЦветСоСправкойИПроверкойНесётСвоиТексты() Экспорт

	HTML = Кит.Поле("акцент", "Цвет акцента").Ид("accent").Образец("#1a73e8", "Синий")
		.Справка("Цвет кнопок и ссылок.").Обязательное().ПроверкаДоОтправки().Рендер();

	Код = Тег(HTML, "swatches__code");
	Ожидаем.Что(Атрибут(Код, "aria-describedby"), "поле кода ссылается на справку: " + Код)
		.Равно("accent-help");
	Ожидаем.Что(Атрибут(Код, "data-error-pattern"), "отказ шаблона — словами разбора")
		.Равно("Код цвета — # и шесть цифр, например #1a73e8");
	Ожидаем.Что(Атрибут(Код, "data-error-required"), "текст пустого поля").Равно("Заполните поле");
	Ожидаем.Что(СтрНайти(HTML, "<div class=""field-help""><fieldset class=""field field--color"" data-swatches>") > 0,
		"справка рядом с полем цвета: " + HTML).ЭтоИстина();

КонецПроцедуры

// Разбор судит строку списка теми же пределами, что строка ввода печатает браузеру.
&Тест
Процедура РазборСпискаСудитДлинуТемиЖеСловами() Экспорт

	Форма = Формы.Новая();
	Форма.Поле("маски", "Маски").Список().Длина(1, 10);
	Присланное = Новый Соответствие();
	Присланное.Вставить("маски", "*.os, *.bsl, *.json");
	Итог = Форма.Разобрать(Присланное);
	HTML = Форма.Отрисовать(Неопределено, "/проект", "т");

	Ожидаем.Что(Итог.Отказы.Получить("маски"), "строка списка длиннее десяти")
		.Равно(Атрибут(Тег(HTML, "chips-in__input"), "data-error-maxlength"));

	Присланное.Вставить("маски", "*.os, *.os");
	Годное = Формы.Новая();
	Годное.Поле("маски", "Маски").Список().Длина(1, 10);
	Итог = Годное.Разобрать(Присланное);
	Ожидаем.Что(Итог.Принято, "повтор отброшен, строка «*.os» годна: " + Итог.Отказ).ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Тост

// Тревога — role="alert" при любом виде: скринридер объявляет сразу, скрипт не закрывает
// сам. Тост без неё печатается как прежде.
&Тест
Процедура ТревогаДаётРольAlert() Экспорт

	Тревога = Кит.Уведомление("Лимит исчерпан").Вид("warn").Тревога().Рендер();
	Ожидаем.Что(СтрНайти(Тревога, "<div class=""toast toast--warn"" role=""alert"">") > 0,
		"тревога: " + Тревога).ЭтоИстина();

	Ожидаем.Что(Кит.Уведомление("Сохранено").Заголовок("Проект").Закрываемый().Рендер(), "прежний тост")
		.Равно(Набор.Тост().Отрисовать(Новый Структура("Текст, Заголовок, Закрываемый",
			"Сохранено", "Проект", Истина)));
	Ожидаем.Что(СтрНайти(Кит.Уведомление("Сохранено").Рендер(), "role=""status""") > 0,
		"успех — status").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кит.Уведомление("Не сохранено").Вид("err").Рендер(), "role=""alert""") > 0,
		"ошибка — alert, как прежде").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Объявление()

	Результат = Формы.Новая();
	Результат.Поле("site", "Сайт").ТипЗначения("url").Обязательное().ПроверкаДоОтправки()
		.Поле("name", "Имя").Обязательное().Длина(2, 40).Шаблон("[a-z0-9\-]+")
			.ПроверкаНаСервере("/проекты/имя")
		.Поле("mail", "Почта").ТипЗначения("email").ПроверкаДоОтправки()
		.Поле("limit", "Лимит").ТипЗначения(Тип("Число")).Пределы(1, 100).ПроверкаДоОтправки();
	Возврат Результат;

КонецФункции

// Тег управления поля по его имени: <input …name="имя"…> целиком.
Функция Управление(Знач HTML, Знач Имя)

	Метка = "name=""" + Имя + """";
	Позиция = СтрНайти(HTML, Метка);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = Позиция;
	Пока Начало > 1 И Сред(HTML, Начало, 1) <> "<" Цикл
		Начало = Начало - 1;
	КонецЦикла;
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));

КонецФункции

// Тег по его классу: <… class="… класс…" …> целиком.
Функция Тег(Знач HTML, Знач Класс)

	Позиция = СтрНайти(HTML, Класс);
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Начало = Позиция;
	Пока Начало > 1 И Сред(HTML, Начало, 1) <> "<" Цикл
		Начало = Начало - 1;
	КонецЦикла;
	Хвост = Сред(HTML, Начало);
	Возврат Лев(Хвост, СтрНайти(Хвост, ">"));

КонецФункции

Функция Атрибут(Знач Тег, Знач Имя)

	Метка = " " + Имя + "=""";
	Позиция = СтрНайти(Тег, Метка);
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Хвост = Сред(Тег, Позиция + СтрДлина(Метка));
	Возврат Лев(Хвост, СтрНайти(Хвост, """") - 1);

КонецФункции

#КонецОбласти
