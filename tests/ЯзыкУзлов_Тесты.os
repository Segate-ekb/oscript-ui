// Язык узлов 0.10: по коду экрана видно, что встанет на экран, а разметка на выходе та же,
// что у прежней сборки. Проверяется каждое из шести правил и то, что ломается для
// человека: строка-вид печатается словом на экране, токен утекает текстом, таблица
// из данных расходится с ручной, форма уходит не на тот адрес.

#Использовать "../"
#Использовать asserts

Перем Кит;       // Кит
Перем Набор;     // НаборКомпонентов
Перем Настройки; // РендерерНастроек
Перем Экран;     // ЭкранированиеHTML
Перем Формы;     // Формы — фабрика объявлений форм

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	ПодключитьСценарий(ОбъединитьПути(КаталогТестов, "фикстуры", "СборкаХолста.os"), "СборкаХолста");

	Слой = Новый СборкаХолста().Собрать();
	Кит = Слой.Кит;
	Набор = Слой.Набор;
	Настройки = Слой.Настройки;
	Экран = Слой.Экран;
	Формы = Слой.Формы;

КонецПроцедуры

#Область СтрокаЭтоТекст

// Строка на месте узла — текст: она экранируется так же, как Кит.Текст, и разметкой
// не станет никогда.
&Тест
Процедура СтрокаНаМестеУзлаСтановитсяТекстом() Экспорт

	Коротко = Кит.Заголовок(2, "Мои <токены>").Рендер();
	Длинно = Кит.Заголовок(2).Добавить(Кит.Текст("Мои <токены>")).Родитель().Рендер();
	Ожидаем.Что(Коротко, "строка-ребёнок печатается как Кит.Текст").Равно(Длинно);
	Ожидаем.Что(СтрНайти(Коротко, "&lt;токены&gt;") > 0, "и экранируется: " + Коротко).ЭтоИстина();

	Ряд = Кит.Ряд("справа");
	Положенный = Ряд.Добавить("подпись");
	Ожидаем.Что(Положенный.Род(), "Добавить строки отдаёт её текстовый узел").Равно("текст");

КонецПроцедуры

// Токен формы раньше шёл вторым позиционным аргументом; строкой-ребёнком он напечатался бы
// на экране, поэтому строка в форме не принимается вовсе — и отказ называет лекарство.
&Тест
Процедура СтрокаВФормеОтвергаетсяИНазываетСловоТокен() Экспорт

	Для Каждого Род Из СтрРазделить("Форма,ФормаБезСессии,ФормаОтбора,ФормаБезТокена", ",") Цикл
		Отказ = Ошибка("Кит." + Род + "(""/x"", ""т0кен-сессии"")");
		Ожидаем.Что(СтрНайти(Отказ, ".Токен(") > 0, Род + ": отказ называет слово Токен: " + Отказ)
			.ЭтоИстина();
		Ожидаем.Что(СтрНайти(Отказ, "Кит.Текст()") > 0, Род + ": и узел для текста").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

// В строгом роде (таблица, запись, список) строка отвергается той же проверкой вложения:
// текст в записи не печатается, его кладут в ячейку.
&Тест
Процедура СтрокаВСтрогомРодеОтвергаетсяПроверкойВложения() Экспорт

	Ожидаем.Что(Ошибка("Кит.Запись(""значение"")"), "строка в записи").Заполнено();
	Ожидаем.Что(Ошибка("Кит.Список().Добавить(""пункт"")"), "строка в списке").Заполнено();
	Ожидаем.Что(Ошибка("Кит.Ячейка(""значение"")"), "КОНТРОЛЬ: в ячейке строка ложится").Равно("");

КонецПроцедуры

#КонецОбласти

#Область ДетиАргументами

// Восемь детей позиционно в порядке аргументов, Неопределено пропускается, девятый —
// Добавить, который по-прежнему отдаёт ребёнка.
&Тест
Процедура ДетиАргументамиИДевятыйЧерезДобавить() Экспорт

	Холст = Кит.Холст("1", "2", Неопределено, "3", "4", "5", "6", "7");
	Девятый = Холст.Добавить(Кит.Код("9"));

	Ожидаем.Что(Холст.Рендер(), "порядок аргументов — порядок на экране").Равно("1234567<code>9</code>");
	Ожидаем.Что(Холст.Дети().Количество(), "Неопределено не стало ребёнком").Равно(8);
	Ожидаем.Что(Девятый.Род(), "Добавить отдаёт ребёнка").Равно("код");

	Ожидаем.Что(Кит.Ряд("справа", Кит.Код("а"), "б").Рендер(),
		"ряд: вид первым, дети следом").Равно("<div class=""row-end""><code>а</code>б</div>");

КонецПроцедуры

// Второй холст с аргументами наполняется и возвращает владельца — цепочка продолжается
// у раскрывашки, записи и таблицы; без аргументов отдаёт сам холст.
&Тест
Процедура ВторойХолстСАргументамиВозвращаетВладельца() Экспорт

	Раскрывашка = Кит.Раскрывашка("тело").Шапка("Подробнее", Кит.Код("x"));
	Ожидаем.Что(Раскрывашка.Род(), "Шапка(д…) отдаёт раскрывашку").Равно("раскрывашка");
	Ожидаем.Что(Раскрывашка.Рендер(), "шапка и тело на месте").Равно(
		"<details class=""panel""><summary class=""panel__head"">Подробнее<code>x</code></summary>"
		+ "<div class=""panel__body"">тело</div></details>");

	Запись = Кит.Запись(Кит.Ячейка("пакет")).Разворот(Кит.Примечание("подробности"));
	Ожидаем.Что(Запись.Род(), "Разворот(д…) отдаёт запись").Равно("запись");
	Ожидаем.Что(Кит.Раскрывашка().Шапка().Род(), "без аргументов — холст шапки").Равно("холст");

	Пустая = Кит.Таблица(Кит.Колонка("Имя")).Пусто("Ничего не найдено");
	Ожидаем.Что(Пустая.Род(), "Пусто(д…) отдаёт таблицу").Равно("таблица");
	Ожидаем.Что(Пустая.Рендер(), "строка пустоты — примечание вида «пусто»")
		.Равно(Кит.Примечание("Ничего не найдено").Вид("пусто").Рендер());

КонецПроцедуры

#КонецОбласти

#Область УсловиеСловом

// Когда(Ложь) печатает пустую строку, а узел остаётся в дереве и виден в Дерево() пометкой.
&Тест
Процедура КогдаЛожьПечатаетПустоИДеревоПомечаетУзел() Экспорт

	Холст = Кит.Холст(
		Кит.Примечание("видно").Когда(Истина),
		Кит.Примечание("не видно").Когда(Ложь));

	Ожидаем.Что(Холст.Рендер(), "снятый узел не печатается").Равно("<p class=""muted"">видно</p>");
	Ожидаем.Что(СтрНайти(Холст.Дерево(), "примечание [скрыт]") > 0,
		"а в дереве он есть: " + Холст.Дерево()).ЭтоИстина();
	Ожидаем.Что(Ошибка("Кит.Холст().Когда(""да"")"), "условие — Булево").Заполнено();

КонецПроцедуры

// Снятая колонка уносит и заголовок, и ячейки под собой: иначе значения съехали бы
// под чужие заголовки.
&Тест
Процедура СнятаяКолонкаУноситЗаголовокИЯчейки() Экспорт

	Таблица = Кит.Таблица(
		Кит.Колонка("Имя"),
		Кит.Колонка("Пул").Когда(Ложь),
		Кит.Колонка("Размер"),
		Кит.Запись(Кит.Ячейка("пакет"), Кит.Ячейка("основной"), Кит.Ячейка("12")));

	Ручная = Кит.Таблица(
		Кит.Колонка("Имя"),
		Кит.Колонка("Размер"),
		Кит.Запись(Кит.Ячейка("пакет"), Кит.Ячейка("12")));

	Ожидаем.Что(Таблица.Рендер(), "как будто колонки не было").Равно(Ручная.Рендер());

КонецПроцедуры

#КонецОбласти

#Область ТаблицаИзДанных

// Таблица значений даёт колонки с их заголовками и записи — разметка та же, что у ручной
// сборки из колонок, записей и ячеек.
&Тест
Процедура ТаблицаИзТаблицыЗначенийРавнаРучнойСборке() Экспорт

	Данные = Новый ТаблицаЗначений();
	Данные.Колонки.Добавить("Имя");
	Данные.Колонки.Добавить("Размер", , "Размер, КБ");
	Данные.Колонки.Добавить("Пул");
	Строка_ = Данные.Добавить();
	Строка_.Имя = "отчёт";
	Строка_.Размер = 12345;
	Строка_.Пул = Кит.Код("основной");
	Строка_ = Данные.Добавить();
	Строка_.Имя = "журнал";
	Строка_.Размер = 0.5;

	Ручная = Кит.Таблица(
		Кит.Колонка("Имя"), Кит.Колонка("Размер, КБ"), Кит.Колонка("Пул"),
		Кит.Запись(Кит.Ячейка("отчёт"), Кит.Ячейка("12345"), Кит.Ячейка(Кит.Код("основной"))),
		Кит.Запись(Кит.Ячейка("журнал"), Кит.Ячейка(Формат(0.5, "ЧН=0; ЧГ=0")), Кит.Ячейка()));

	ИзДанных = Кит.Таблица(Данные);
	Ожидаем.Что(ИзДанных.Рендер(), "заголовки, порядок, число, узел и пустая ячейка").Равно(Ручная.Рендер());
	Ожидаем.Что(ИзДанных.Рендер(), "узел ячейки отпущен: таблица печатается снова").Равно(Ручная.Рендер());

	ИзДанных.Колонка("Имя", "Пакет").Вид("узкая");
	Ожидаем.Что(СтрНайти(ИзДанных.Рендер(), "<th scope=""col"" class=""col-narrow"">Пакет</th>") > 0,
		"слово Колонка переопределяет заголовок и вид: " + ИзДанных.Рендер()).ЭтоИстина();
	Ожидаем.Что(Ошибка("Кит.Таблица(Новый ТаблицаЗначений()).Колонка(""Нет"")"),
		"колонки, которой в таблице значений нет, не бывает").Заполнено();

КонецПроцедуры

// Массив структур: колонки объявляются словом в порядке вызовов; без них порядка полей нет.
&Тест
Процедура ТаблицаИзМассиваБерётКолонкиИзСлов() Экспорт

	Данные = Новый Массив();
	Данные.Добавить(Новый Структура("Имя, Роль", "анна", "владелец"));
	Соответствие_ = Новый Соответствие();
	Соответствие_.Вставить("Имя", "борис");
	Данные.Добавить(Соответствие_);

	Таблица = Кит.Таблица(Данные);
	Таблица.Колонка("Роль", "Роль");
	Таблица.Колонка("Имя", "Участник");

	Ручная = Кит.Таблица(Кит.Колонка("Роль"), Кит.Колонка("Участник"),
		Кит.Запись(Кит.Ячейка("владелец"), Кит.Ячейка("анна")),
		Кит.Запись(Кит.Ячейка(), Кит.Ячейка("борис")));
	Ожидаем.Что(Таблица.Рендер(), "порядок объявления и соответствие").Равно(Ручная.Рендер());

	Ожидаем.Что(ОшибкаПечати(Кит.Таблица(Данные)), "без колонок не печатается").Заполнено();

КонецПроцедуры

// Дату и Булево кит не форматирует: «Истина» и «05.03.2024 0:00:00» уехали бы человеку
// как есть. Отказ называет колонку.
&Тест
Процедура ДатаВЯчейкеОтвергаетсяСИменемКолонки() Экспорт

	Данные = Новый Массив();
	Данные.Добавить(Новый Структура("Создан", Дата(2024, 3, 5)));
	Таблица = Кит.Таблица(Данные);
	Таблица.Колонка("Создан", "Создан");

	Отказ = ОшибкаПечати(Таблица);
	Ожидаем.Что(СтрНайти(Отказ, "«Создан»") > 0, "отказ называет колонку: " + Отказ).ЭтоИстина();

КонецПроцедуры

// Пустые данные печатают Пусто; колонка разворота печатается строкой под записью,
// а пустое её значение разворота не даёт.
&Тест
Процедура ПустоИРазворотТаблицыИзДанных() Экспорт

	Данные = Новый ТаблицаЗначений();
	Данные.Колонки.Добавить("Имя");
	Данные.Колонки.Добавить("Манифест");

	Таблица = Кит.Таблица(Данные).Разворот("Манифест").Пусто("Заявок нет.");
	Ожидаем.Что(Таблица.Рендер(), "пустые данные — текст пустоты")
		.Равно(Кит.Примечание("Заявок нет.").Вид("пусто").Рендер());

	Строка_ = Данные.Добавить();
	Строка_.Имя = "первая";
	Строка_.Манифест = Кит.Примечание("сведения");
	Строка_ = Данные.Добавить();
	Строка_.Имя = "вторая";

	Ручная = Кит.Таблица(Кит.Колонка("Имя"),
		Кит.Запись(Кит.Ячейка("первая")).Разворот(Кит.Примечание("сведения")),
		Кит.Запись(Кит.Ячейка("вторая")));
	Ожидаем.Что(Таблица.Рендер(), "разворот — под записью, а не колонкой").Равно(Ручная.Рендер());

КонецПроцедуры

#КонецОбласти

#Область ТипыПоля

// Тип поля задаётся системой типов OneScript, квалификаторы дают пределы ввода.
&Тест
Процедура ТипПоляЗадаётсяСистемойТипов() Экспорт

	Ожидаем.Что(СтрНайти(Поле().ТипЗначения(Тип("Число")).Рендер(), "type=""number""") > 0,
		"Число — числовое поле").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Поле().ТипЗначения(Тип("Булево")).Рендер(), "type=""checkbox""") > 0,
		"Булево — флажок").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Поле().ТипЗначения(Тип("Дата")).Рендер(), "type=""date""") > 0,
		"Дата — поле даты").ЭтоИстина();

	Деньги = Поле().ТипЗначения(Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(7, 2))).Рендер();
	Ожидаем.Что(СтрНайти(Деньги, "max=""99999.99"" step=""0.01""") > 0,
		"квалификаторы числа — max и step: " + Деньги).ЭтоИстина();
	Целое = Поле().ТипЗначения(Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0))).Рендер();
	Ожидаем.Что(СтрНайти(Целое, "max=""999"" step=""1""") > 0, "целое — шаг 1: " + Целое).ЭтоИстина();

	Имя = Поле().ТипЗначения(Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50))).Рендер();
	Ожидаем.Что(СтрНайти(Имя, "maxlength=""50""") > 0, "длина строки — maxlength: " + Имя).ЭтоИстина();

	Срок = Поле().ТипЗначения(Новый ОписаниеТипов("Дата", , ,
		Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя))).Рендер();
	Ожидаем.Что(СтрНайти(Срок, "type=""datetime-local""") > 0, "дата и время: " + Срок).ЭтоИстина();
	Время = Поле().ТипЗначения(Новый ОписаниеТипов("Дата", , ,
		Новый КвалификаторыДаты(ЧастиДаты.Время))).Рендер();
	Ожидаем.Что(СтрНайти(Время, "type=""time""") > 0, "время: " + Время).ЭтоИстина();

	Ожидаем.Что(Поле().ТипЗначения("email").Рендер(),
		"строка — прежний Тип модели").Равно(Набор.Поле().Отрисовать(
			Новый Структура("Имя, Метка, Тип", "срок", "Срок", "email")));

КонецПроцедуры

// Тип выводится из значения, значение печатается в формате ввода; явный тип старше.
&Тест
Процедура ТипПоляВыводитсяИзЗначения() Экспорт

	Число_ = Поле().Значение(1234.5).Рендер();
	Ожидаем.Что(СтрНайти(Число_, "type=""number""") > 0 И СтрНайти(Число_, "value=""1234.5""") > 0,
		"число: числовое поле, точка, без разделителя групп: " + Число_).ЭтоИстина();

	Флажок = Поле().Значение(Истина).Рендер();
	Ожидаем.Что(СтрНайти(Флажок, "type=""checkbox""") > 0 И СтрНайти(Флажок, " checked") > 0,
		"Истина — отмеченный флажок: " + Флажок).ЭтоИстина();

	День = Поле().Значение(Дата(2024, 3, 5)).Рендер();
	Ожидаем.Что(СтрНайти(День, "type=""date""") > 0 И СтрНайти(День, "value=""2024-03-05""") > 0,
		"дата — в формате ввода: " + День).ЭтоИстина();

	Явный = Поле().Значение(42).ТипЗначения("текст").Рендер();
	Ожидаем.Что(СтрНайти(Явный, "type=""text""") > 0, "явный тип старше вывода: " + Явный).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Поле().ТипЗначения("текст").Значение(42).Рендер(), "type=""text""") > 0,
		"в любом порядке").ЭтоИстина();

	Выбор = Поле().Вариант("a", "Альфа").Вариант("b", "Бета").Значение("b").Рендер();
	Ожидаем.Что(СтрНайти(Выбор, "<select") > 0 И СтрНайти(Выбор, "<option value=""b"" selected>") > 0,
		"Вариант делает поле выбором: " + Выбор).ЭтоИстина();

КонецПроцедуры

// Объявленная форма: Поле отдаёт описание со словами, разбор приводит пришедшее
// к объявленному типу, а цепочка полей по-прежнему продолжается.
&Тест
Процедура ПолеОбъявленнойФормыНастраиваетсяСловами() Экспорт

	Объявление = Формы.Новая();
	Объявление.Поле("срок", "Срок, дней").ТипЗначения(Тип("Число")).Пределы(1, 90).Обязательное()
		.Поле("согласие", "Согласен").ТипЗначения(Тип("Булево"))
		.Поле("с", "Начало").ТипЗначения(Тип("Дата"))
		.Поле("имя", "Имя").ТипЗначения(Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)))
			.Пример("ноутбук");

	Присланное = Новый Соответствие();
	Присланное.Вставить("срок", "30");
	Присланное.Вставить("согласие", "1");
	Присланное.Вставить("с", "2024-03-05");
	Присланное.Вставить("имя", "ноут");
	Итог = Объявление.Разобрать(Присланное);

	Ожидаем.Что(Итог.Принято, "принято: " + Итог.Отказ).ЭтоИстина();
	Ожидаем.Что(Итог.Значения.Получить("срок"), "число — Число").Равно(30);
	Ожидаем.Что(Итог.Значения.Получить("согласие"), "флажок — Булево").Равно(Истина);
	Ожидаем.Что(Итог.Значения.Получить("с"), "дата — Дата").Равно(Дата(2024, 3, 5));

	Присланное.Вставить("с", "вчера");
	Присланное.Вставить("срок", "120");
	Отбитое = Объявление.Разобрать(Присланное);
	Ожидаем.Что(Отбитое.Отказы.Получить("с"), "нечитаемая дата отбита").Заполнено();
	Ожидаем.Что(Отбитое.Отказы.Получить("срок"), "число вне пределов отбито").Заполнено();

	Действующие = Новый Структура("с", Дата(2024, 3, 5));
	HTML = Объявление.Отрисовать(Действующие, "/x", "т");
	Ожидаем.Что(СтрНайти(HTML, "type=""number""") > 0 И СтрНайти(HTML, "min=""1"" max=""90""") > 0,
		"число с пределами: " + HTML).ЭтоИстина();
	// набранное старше действующего: дату из данных показывает свежее объявление
	Свежее = Формы.Новая();
	Свежее.Поле("с", "Начало").ТипЗначения(Тип("Дата"));
	Дата_ = Свежее.Отрисовать(Действующие, "/x", "т");
	Ожидаем.Что(СтрНайти(Дата_, "type=""date""") > 0 И СтрНайти(Дата_, "value=""2024-03-05""") > 0,
		"дата из данных — в формате ввода: " + Дата_).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "maxlength=""20""") > 0 И СтрНайти(HTML, "placeholder=""ноутбук""") > 0,
		"длина и пример").ЭтоИстина();

КонецПроцедуры

// Прежний вызов с видом и свойствами печатает то же, что и раньше, и цепочка не рвётся.
&Тест
Процедура ПрежнееОбъявлениеПоляРаботаетКакРаньше() Экспорт

	Прежнее = Формы.Новая().Поле("имя", "Имя", "строка", Новый Структура("Обязательное", Истина))
		.Поле("число", "Число", "число", Новый Структура("Мин, Макс", 1, 5));
	Словами = Формы.Новая();
	Словами.Поле("имя", "Имя").Обязательное();
	Словами.Поле("число", "Число").ТипЗначения("число");
	Словами.Состав()[1].Мин = 1;

	Ожидаем.Что(Прежнее.Тело(), "та же разметка").Равно(Словами.Тело());
	Ожидаем.Что(СтрНайти(Прежнее.Тело(), "min="), "прежние Мин и Макс атрибутов не дают").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область Контекст

// Адрес и токен задаются один раз у дома; форма с относительным адресом постит на адрес
// текущего раздела, абсолютный остаётся своим.
&Тест
Процедура ФормаБерётАдресИТокенУДома() Экспорт

	Дом = Кит.ДомНастроек("Настройки", "/проект/настройки", "т0кен");
	Дом.Раздел("Общее", "");
	Дом.Раздел("Токены", "токены").Текущий();
	Дом.Добавить(Кит.Секция("Мои токены",
		Кит.Форма("", Кит.Кнопка("Выпустить")),
		Кит.Форма("12/revoke", Кит.Кнопка("Отозвать")),
		Кит.Форма("/выход", Кит.Кнопка("Выйти"))));

	HTML = Дом.Рендер();
	Ожидаем.Что(СтрНайти(HTML, "action=""/проект/настройки/токены""") > 0,
		"пустой адрес — адрес текущего раздела: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "action=""/проект/настройки/токены/12/revoke""") > 0,
		"относительный дописывается к разделу").ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "action=""/выход""") > 0, "абсолютный — свой").ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "name=""_csrf"" value=""т0кен"""),
		"токен дома у каждой формы").Равно(3);

	Отказ = ОшибкаПечати(Кит.Форма("", Кит.Кнопка("Да")).Токен("т"));
	Ожидаем.Что(СтрНайти(Отказ, "абсолютный адрес или дом/секция вокруг") > 0,
		"относительный адрес без контекста не печатается: " + Отказ).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ОшибкаПечати(Кит.Холст(Кит.Форма("/x"))), "403") > 0,
		"форма без токена у себя и у предков — прежний отказ про 403").ЭтоИстина();
	Ожидаем.Что(СтрНайти(Кит.Холст(Кит.Форма("/x")).Токен("т").Рендер(), "value=""т""") > 0,
		"токен предка-холста").ЭтоИстина();

КонецПроцедуры

// Значение ячейки таблицы из данных в дереве не лежит, но форма в нём находит дом.
&Тест
Процедура ФормаВЯчейкеДанныхНаходитКонтекстДома() Экспорт

	Данные = Новый Массив();
	Данные.Добавить(Новый Структура("Имя, Действие", "ноутбук",
		Кит.Форма("7/revoke", Кит.Кнопка("Отозвать").Опасная().Малая())));
	Таблица = Кит.Таблица(Данные);
	Таблица.Колонка("Имя", "Имя");
	Таблица.Колонка("Действие");

	Дом = Кит.ДомНастроек("Настройки", "/настройки", "т0кен", Кит.Секция("Токены", Таблица));
	HTML = Дом.Рендер();
	Ожидаем.Что(СтрНайти(HTML, "action=""/настройки/7/revoke""") > 0,
		"форма из ячейки взяла адрес дома: " + HTML).ЭтоИстина();
	Ожидаем.Что(СтрНайти(HTML, "value=""т0кен""") > 0, "и его токен").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область КаркасНастроек

// Дом из узлов печатает ту же разметку, что модель-структура прежнего вызова.
&Тест
Процедура ДомИзУзловРавенМоделиСтруктуре() Экспорт

	Дом = Кит.ДомНастроек("Настройки", "/настройки", "т")
		.Ключ("project").Объект("альфа").Пояснение("Что видит участник")
		.Крошка("Проекты", "/проекты").Крошка("альфа")
		.Уведомление(Кит.Уведомление("Сохранено"));
	Дом.Раздел("Общее", "", "шестерёнка").Текущий();
	Дом.Раздел("Доступ", "доступ", "замок");
	Дом.Добавить(Кит.Секция("Имя проекта", Кит.Поле("имя", "Имя").Значение("альфа"))
		.Лид("Видно всем").Форма().ПояснениеПанели("Увидят все"));
	Дом.Добавить(Кит.Секция("Удаление", Кит.Примечание("Отменить нельзя."))
		.Опасная().БезПанели().Иконка("корзина"));

	Разделы = Новый Массив();
	Разделы.Добавить(Настройки.Раздел("Общее", "/настройки", "шестерёнка", Истина));
	Разделы.Добавить(Настройки.Раздел("Доступ", "/настройки/доступ", "замок"));

	Первая = Настройки.Секция("Имя проекта", "Видно всем",
		Набор.Поле().Отрисовать(Новый Структура("Имя, Метка, Значение", "имя", "Имя", "альфа")));
	Первая.Действие = "/настройки";
	Первая.Токен = "т";
	Первая.ПояснениеПанели = "Увидят все";
	Вторая = Настройки.Секция("Удаление", "", "<p class=""muted"">Отменить нельзя.</p>");
	Вторая.Опасная = Истина;
	Вторая.БезПанели = Истина;
	Вторая.Иконка = "корзина";
	Секции = Новый Массив();
	Секции.Добавить(Первая);
	Секции.Добавить(Вторая);

	Хлебные = Новый Массив();
	Хлебные.Добавить(Новый Структура("Подпись, Адрес", "Проекты", "/проекты"));
	Хлебные.Добавить(Новый Структура("Подпись, Адрес", "альфа", ""));
	Уведомления = Новый Массив();
	Уведомления.Добавить(Новый Структура("Текст", "Сохранено"));

	Прежний = Настройки.Отрисовать(Новый Структура(
		"Ключ, Заголовок, Объект, Пояснение, Разделы, Секции, Хлебные, Уведомления",
		"project", "Настройки", "альфа", "Что видит участник", Разделы, Секции, Хлебные,
		Уведомления));

	Ожидаем.Что(Дом.Рендер(), "байт в байт").Равно(Прежний);
	Ожидаем.Что(Кит.РазделыДома(Дом).Количество(), "разделы для единого меню").Равно(2);
	Ожидаем.Что(Кит.РазделыДома(Дом)[1].Адрес, "адрес раздела — адрес дома и ключ")
		.Равно("/настройки/доступ");

КонецПроцедуры

// Секция вне дома печатается тем же каркасом; секция-форма вне дома требует абсолютного
// хвоста, а токен берёт у предков.
&Тест
Процедура СекцияВнеДомаПечатаетсяКаркасом() Экспорт

	Узлом = Кит.Холст(Кит.Секция("Описание", "текст").Форма("/описание")).Токен("т").Рендер();

	Модель = Настройки.Секция("Описание", "", "текст");
	Модель.Действие = "/описание";
	Модель.Токен = "т";
	Ожидаем.Что(Узлом, "та же разметка").Равно(Настройки.ОтрисоватьСекцию(Модель));

	Ожидаем.Что(ОшибкаПечати(Кит.Секция("Описание").Форма()), "без контекста — отказ").Заполнено();
	Ожидаем.Что(СтрНайти(ОшибкаПечати(Кит.Секция("Описание").Форма("/x")), "CSRF") > 0,
		"без токена — отказ про CSRF").ЭтоИстина();

КонецПроцедуры

#КонецОбласти

#Область Совместимость

// Прежний вызов со строкой-видом напечатал бы слово «полоса» на экране; он отвергается
// с подсказкой, как теперь.
&Тест
Процедура СтарыйВызовСВидомОтвергаетсяСПодсказкой() Экспорт

	Для Каждого Вызов Из СтрРазделить("Кит.Область(""полоса"")|Кит.Запись(""выделенная"")"
		+ "|Кит.Таблица(""карточками"")|Кит.Надпись(""приглушённая"")|Кит.Заголовок(3, ""имя"")"
		+ "|Кит.Ссылка(""/a"", ""пилюля"")|Кит.Группа(""Г"", ""набор"")"
		+ "|Кит.Примечание(""Ничего"", ""пусто"")|Кит.ФормаБезСессии(""/login"", ""столбик"")"
		+ "|Кит.Колонка(""Имя"", ""узкая"")|Кит.Код(""x"", ""блочный"")|Кит.Картинка(""/a.png"", ""значок"")",
		"|") Цикл
		Отказ = Ошибка(Вызов);
		Ожидаем.Что(СтрНайти(Отказ, ".Вид(") > 0, Вызов + ": подсказка про слово Вид: " + Отказ)
			.ЭтоИстина();
	КонецЦикла;

	Ожидаем.Что(Ошибка("Кит.Примечание(""Ничего не найдено"")"), "КОНТРОЛЬ: обычный текст").Равно("");

КонецПроцедуры

// Компонент со словами печатает байт в байт то же, что компонент со структурой-моделью
// и компонент строкой из набора.
&Тест
Процедура КомпонентСловамиРавенСтруктуре() Экспорт

	Сверить(Кит.Кнопка("Отозвать").Опасная().Малая().Иконка("корзина").Имя("операция", "1"),
		Набор.Кнопка().Отрисовать(Новый Структура("Подпись, Вариант, Размер, Иконка, Имя, Значение",
			"Отозвать", "опасная", "малый", "корзина", "операция", "1")), "кнопка");
	Сверить(Кит.Кнопка("Меню").Вторичная().ТолькоИконка().Счётчик(3, "новых").ЗнакРаскрытия(),
		Набор.Кнопка().Отрисовать(Новый Структура(
			"Подпись, Вариант, ТолькоИконка, Счётчик, ПодписьСчётчика, ЗнакРаскрытия",
			"Меню", "вторичная", Истина, 3, "новых", Истина)), "кнопка-значок");
	Сверить(Кит.Плашка("готов").Вид("ok").Иконка("галка"),
		Кит.Плашка(Новый Структура("Текст, Вид, Иконка", "готов", "ok", "галка")), "плашка");
	Сверить(Кит.Карточка("Пулы", "две штуки").Описание("лид").Действия(Кит.Кнопка("Открыть")),
		Кит.Карточка(Новый Структура("Заголовок, Описание, Действия", "Пулы", "лид",
			Набор.Кнопка().Отрисовать("Открыть"))).Наполнить("две штуки"), "карточка");
	Сверить(Кит.ПустоеСостояние("Добавьте первый").Заголовок("Пусто").Действие(Кит.Кнопка("Добавить")),
		Набор.ПустоеСостояние().Отрисовать(Новый Структура("Пояснение, Заголовок, Действие",
			"Добавьте первый", "Пусто", Новый Структура("Подпись", "Добавить"))), "пустое состояние");
	Сверить(Кит.Пагинация("/список", 2, 5).Параметры("q", "кот").Параметр("стр"),
		Набор.Пагинация().Отрисовать(Новый Структура("Основа, Страница, ВсегоСтраниц, Параметры, Параметр",
			"/список", 2, 5, СписокИз(Новый Структура("Имя, Значение", "q", "кот")), "стр")), "пагинация");
	Сверить(Кит.Табы(Кит.Вкладка("Обзор", "/о").Активна(), Кит.Вкладка("Версии", "/в").Счётчик(4))
			.Заголовок("Разделы"),
		Набор.Табы().Отрисовать(Новый Структура("Заголовок, Вкладки", "Разделы", СписокИз(
			Новый Структура("Подпись, Адрес, Активна", "Обзор", "/о", Истина),
			Новый Структура("Подпись, Адрес, Счётчик", "Версии", "/в", 4)))), "табы");
	Сверить(Кит.Меню("Действия", Кит.ПунктМеню("Открыть", "/о").Иконка("папка"),
			Кит.ФормаБезТокена("/выход", Кит.Кнопка("Выйти")).Вид("меню")),
		Набор.Меню().Отрисовать(Новый Структура("Подпись, Пункты", "Действия", СписокИз(
			Новый Структура("Подпись, Адрес, Иконка", "Открыть", "/о", "папка"),
			Новый Структура("HTML", Кит.ФормаБезТокена("/выход", Кит.Кнопка("Выйти")).Вид("меню")
				.Рендер())))), "меню");
	Сверить(Кит.Сводка("отчёт").Подпись("вчера").Подпись("анна").Сведение("Размер", "12 КБ"),
		Набор.Сводка().Отрисовать(Новый Структура("Название, Подпись, Сведения", "отчёт",
			СписокИз("вчера", "анна"), СписокИз(Новый Структура("Подпись, Значение, Вид",
				"Размер", "12 КБ", "")))), "сводка");
	Сверить(Кит.ШапкаОбъекта("альфа", Кит.Кнопка("Править")).Описание("проект").Знак("замок", "закрыт")
			.Мета("Участников", "3").Плашка("новый"),
		Набор.ШапкаОбъекта().Отрисовать(Новый Структура("Имя, Описание, Признаки, Мета, Плашки, Действия",
			"альфа", "проект", СписокИз(Новый Структура("Иконка, Подпись", "замок", "закрыт")),
			СписокИз(Новый Структура("Подпись, Значение, Значок, Адрес", "Участников", "3", "", "")),
			СписокИз(Новый Структура("Текст", "новый")), Набор.Кнопка().Отрисовать("Править"))),
		"шапка объекта");
	Сверить(Кит.Поле("срок", "Срок, дней").ТипЗначения("число").Значение("30").Обязательное()
			.Подсказка("От 1 до 90").Пример("30"),
		Набор.Поле().Отрисовать(Новый Структура("Имя, Метка, Тип, Значение, Обязательное, Подсказка,"
			+ " Плейсхолдер", "срок", "Срок, дней", "число", "30", Истина, "От 1 до 90", "30")), "поле");
	Сверить(Кит.Тумблер("вкл", "Включено").Включено().Значения("да", "нет").Подписи("Да", "Нет"),
		Набор.Тумблер().Отрисовать(Новый Структура("Имя, Метка, Включено, ЗначениеВкл, ЗначениеВыкл,"
			+ " ПодписьВкл, ПодписьВыкл", "вкл", "Включено", Истина, "да", "нет", "Да", "Нет")), "тумблер");
	Сверить(Кит.ПанельСохранения("Сохранить").Пояснение("Увидят все").АдресОтмены("/назад"),
		Набор.ПанельСохранения().Отрисовать(Новый Структура("Подпись, Пояснение, АдресОтмены",
			"Сохранить", "Увидят все", "/назад")), "панель");
	Сверить(Кит.СтрокаПоиска("/список").Значение("кот").Кнопка("Найти", "лупа").СкрытоеПоле("стр", "2"),
		Набор.ФормаОтбора().Отрисовать(Новый Структура("Действие, Значение, Кнопка, Иконка, СкрытыеПоля",
			"/список", "кот", "Найти", "лупа", СписокИз(Новый Структура("Имя, Значение", "стр", "2")))),
		"строка поиска");
	Сверить(Кит.ОпаснаяЗона("Удалить", "тело").Пояснение("Нельзя вернуть")
			.Подтверждение("имя", "альфа").Кнопка("Удалить навсегда"),
		Набор.ОпаснаяЗона().Отрисовать(Новый Структура("Заголовок, Тело, Пояснение, Подтверждение, Кнопка",
			"Удалить", "тело", "Нельзя вернуть", Новый Структура("Имя, Образец, Метка, Подсказка",
				"имя", "альфа", "", ""), Новый Структура("Подпись", "Удалить навсегда"))), "опасная зона");

КонецПроцедуры

// Слово, которого компонент не знает, останавливает сборку с перечнем его слов.
&Тест
Процедура НеизвестноеСловоОтвергаетсяСПереченьСлов() Экспорт

	Отказ = Ошибка("Кит.Плашка(""готов"").Основная()");
	Ожидаем.Что(СтрНайти(Отказ, "«плашка»") > 0 И СтрНайти(Отказ, "Основная") > 0,
		"названы компонент и слово: " + Отказ).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Отказ, "«Вид», «Адрес», «Иконка», «Подсказка»") > 0,
		"и его слова: " + Отказ).ЭтоИстина();
	Ожидаем.Что(Ошибка("Кит.Ряд(""справа"").Иконка(""x"")"), "у рода без модели — тоже").Заполнено();
	Ожидаем.Что(Ошибка("Кит.Кнопка(Новый Структура(""Подпись"", ""да"")).Основная()"),
		"КОНТРОЛЬ: слова дописывают и прежнюю модель").Равно("");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Поле()
	Возврат Кит.Поле("срок", "Срок");
КонецФункции

Процедура Сверить(Знач Узел, Знач Ожидаемое, Знач Что)

	Если ТипЗнч(Ожидаемое) <> Тип("Строка") Тогда
		Ожидаемое = Ожидаемое.Рендер();
	КонецЕсли;
	// у меню номер панели растёт с каждой печатью: сверяется разметка без номера
	Ожидаем.Что(БезНомераПанели(Узел.Рендер()), Что + ": словами — то же, что структурой")
		.Равно(БезНомераПанели(Ожидаемое));

КонецПроцедуры

Функция БезНомераПанели(Знач HTML)

	Результат = HTML;
	Для Номер = 1 По 50 Цикл
		Результат = СтрЗаменить(Результат, "menu-" + Формат(Номер, "ЧГ=0") + """", "menu-N""");
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СписокИз(Знач П1, Знач П2 = Неопределено)

	Результат = Новый Массив();
	Результат.Добавить(П1);
	Если П2 <> Неопределено Тогда
		Результат.Добавить(П2);
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция Ошибка(Знач Код)

	Попытка
		Узел = Вычислить(Код);
		Узел.Рендер();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция ОшибкаПечати(Знач Узел)

	Попытка
		Узел.Рендер();
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

#КонецОбласти
