// Слова дев-сборки 0.13.0-dev.8: дерево галок для получателей подписки (трек хаба ПЛ4) и хвосты
// аудита dev.5. Проверяется то, что ломается для человека: исключить ребёнка из ветки «все»
// нельзя, без скрипта приложение само сравнивает форму с напечатанным, отмеченное вне показанного
// не видно, а узлы без новых слов печатаются иначе, чем до сборки.

#Использовать "../"
#Использовать asserts

Перем Кит;    // Кит
Перем Набор;  // НаборКомпонентов
Перем Разбор; // РазборЛиста — сканер, читающий КОД листа
Перем ПравилаЛиста; // правила базового листа, разобранные однажды

&ТестовыйНабор(Характер = "Одиночка")
Процедура ПриСозданииОбъекта() Экспорт
КонецПроцедуры

&ПередВсеми
Процедура СобратьХолст() Экспорт

	КаталогТестов = Новый Файл(ТекущийСценарий().Источник).Путь;
	Фикстуры = ОбъединитьПути(КаталогТестов, "фикстуры");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СборкаХолста.os"), "СборкаХолста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "РазборЛиста.os"), "РазборЛиста");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "СловарьПробы.os"), "СловарьПробы");
	ПодключитьСценарий(ОбъединитьПути(Фикстуры, "ОбрамлениеПробы.os"), "ОбрамлениеПробы");

	Слой = Новый СборкаХолста().Собрать(Новый ОбрамлениеПробы());
	Кит = Слой.Кит;
	Набор = Слой.Набор;
	Разбор = Новый РазборЛиста();

КонецПроцедуры

#Область РежимКроме

// П1: четвёртый режим ветки — «все, кроме»: сегмент с подписью словаря, радиокнопка «кроме».
&Тест
Процедура РежимКромеПечатаетсяСвоимСегментом() Экспорт

	HTML = Кит.ДеревоГалок(Ветка("кроме")).Режимы("все", "кроме", "выбранные", "никакие").Рендер();
	Группа = МеждуМаркеров(HTML, "data-checktree-modes=""п1"">", "</div>");

	Ожидаем.Что(СтрЧислоВхождений(Группа, "name=""режим:п1"""), "четыре сегмента").Равно(4);
	Ожидаем.Что(Группа, "«кроме» отмечен").Содержит("value=""кроме"" checked");
	Ожидаем.Что(Группа, "подпись — словарь checktree.mode.except").Содержит(">Все, кроме</span>");
	Ожидаем.Что(СтрНайти(Группа, "value=""все""") < СтрНайти(Группа, "value=""кроме""")
		И СтрНайти(Группа, "value=""кроме""") < СтрНайти(Группа, "value=""выбранные"""),
		"сегменты — в порядке набора").ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "data-checktree-box"), "дети ветки — галки").Равно(2);
	Ожидаем.Что(HTML, "снятый ребёнок — своим состоянием").Содержит("name=""у1"" value=""1"" data-checktree-state=""off""");

КонецПроцедуры

// П2: набор режимов — сегменты только допустимых; свой набор у ветки — поле узла Режимы.
&Тест
Процедура НаборРежимовПечатаетТолькоДопустимые() Экспорт

	HTML = Кит.ДеревоГалок(Ветка("все")).Режимы("все", "выбранные").Рендер();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "name=""режим:п1"""), "два сегмента").Равно(2);
	Ожидаем.Что(СтрНайти(HTML, "value=""никакие"""), "«никакие» не печатается").Равно(0);

	Узлы = Ветка("выбранные");
	Узлы[0].Вставить("Режимы", СтрРазделить("выбранные,кроме", ","));
	HTML = Кит.ДеревоГалок(Узлы).Режимы().Рендер();
	Ожидаем.Что(СтрЧислоВхождений(HTML, "name=""режим:п1"""), "свой набор ветки").Равно(2);
	Ожидаем.Что(HTML, "свой набор — со своим «кроме»").Содержит("value=""кроме""");

	Ожидаем.Что(Отказ(Ветка("никакие"), СтрРазделить("все,выбранные", ",")), "режим вне набора")
		.Содержит("допустимы только «все», «выбранные»");
	Ожидаем.Что(Отказ(Ветка("все"), СтрРазделить("все,половина", ",")), "чужой режим в наборе")
		.Содержит("«половина» — такого режима не бывает");

КонецПроцедуры

// Режимы() без набора и набор из трёх прежних печатают одно и то же — прежнюю разметку.
&Тест
Процедура РежимыБезНабораПечатаютсяКакПрежде() Экспорт

	Прежнее = Набор.ДеревоГалок().Отрисовать(Новый Структура("Узлы, Режимы", Ветка("выбранные"), Истина));
	Ожидаем.Что(Кит.ДеревоГалок(Ветка("выбранные")).Режимы().Рендер(), "слово без набора").Равно(Прежнее);
	Ожидаем.Что(Кит.ДеревоГалок(Ветка("выбранные")).Режимы("все", "выбранные", "никакие").Рендер(),
		"набор из трёх прежних").Равно(Прежнее);
	Ожидаем.Что(СтрНайти(Прежнее, "кроме"), "«кроме» — только по слову").Равно(0);
	Ожидаем.Что(СтрНайти(Прежнее, "data-checktree-shown"), "поля показанного нет").Равно(0);

КонецПроцедуры

// Лист запирает детей по значению радиокнопки «все» и «никакие», а не по месту сегмента:
// иначе «кроме» вторым сегментом заперло бы детей, а «никакие» не последним — нет.
&Тест
Процедура ЛистЗапираетДетейПоЗначениюРежима() Экспорт

	// сканер листа стирает строковые литералы — значение радиокнопки сверяется текстом листа
	Корень = ".checktree__node:has(> .checktree__row > .checktree__modes > .segments__item > ";
	Хвост = ":checked) > .checktree__branch > .checktree__children";
	Лист = Разбор.ТекстБазовогоЛиста();
	Ожидаем.Что(Лист, "«все» и «никакие» заперты").Содержит(Корень + "[value=""все""]" + Хвост + ","
		+ Символы.ПС + Корень + "[value=""никакие""]" + Хвост + " {" + Символы.ПС + Символы.Таб
		+ "pointer-events: none;");
	Ожидаем.Что(ОбъявлениеЛиста(Корень + "[value=""""]" + Хвост, "pointer-events"), "правило на месте")
		.Равно("none");
	Ожидаем.Что(СтрНайти(Лист, "[value=""кроме""]"), "«кроме» правится").Равно(0);
	Ожидаем.Что(СтрНайти(Лист, "checktree__modes > :first-child"), "место сегмента больше не решает").Равно(0);

	Скрипт = ТекстСкрипта();
	Ожидаем.Что(Скрипт, "скрипт запирает по значению").Содержит("list.inert = mode === 'все' || mode === 'никакие';");
	Ожидаем.Что(Скрипт, "переход «все» ↔ «кроме»").Содержит("function ctModeTurn(set, group, from, to)");

КонецПроцедуры

#КонецОбласти

#Область ПравкиБезСкрипта

// П1 без скрипта: кит печатает скрытое поле «показано» — что показал и как.
&Тест
Процедура ПравкиБезСкриптаПечатаютПолеПоказанного() Экспорт

	Узлы = Ветка("кроме");
	Узлы[0].Дети.Добавить(Новый Структура("Имя, Значение, Подпись", "у", "a,b%", "Запятая"));
	Узлы[0].Дети.Добавить(Новый Структура("Имя, Подпись, Отключён", "у9", "Закрытый", Истина));
	HTML = Кит.ДеревоГалок(Узлы).Режимы("все", "кроме").ТолькоПравки().ПравкиБезСкрипта().Рендер();

	Ожидаем.Что(HTML, "поле в конце обёртки").Содержит("<input type=""hidden"" name=""показано"""
		+ " value=""-у1,+у2,+a%2Cb%25,=п1:кроме"" data-checktree-shown></div>");

	Найдено = Кит.ДеревоГалок(Ветка("все")[0].Дети).Поиск("/д/поиск").Найдено("уч", 2).ПравкиБезСкрипта().Рендер();
	Ожидаем.Что(Найдено, "у ответа поиска — найденное").Содержит("value=""-у1,+у2"" data-checktree-shown>");

	Страница = Кит.ДеревоГалок(Ветка("все")[0].Дети).Адрес("/д/ветка").Ветка("п1", 2, 120).ПравкиБезСкрипта().Рендер();
	Ожидаем.Что(Страница, "у страницы ветки — после списка").Содержит("</ul><p class=""checktree__more checktree__page""");
	Ожидаем.Что(СтрЗаканчиваетсяНа(Страница, "value=""-у1,+у2"" data-checktree-shown>"), "поле — последним").ЭтоИстина();

КонецПроцедуры

// Без скрипта РазобратьПравки отдаёт правки против показанного: приложению не нужно сравнивать.
&Тест
Процедура РазборПравокБезСкриптаСчитаетПротивПоказанного() Экспорт

	Тело = "_csrf=т&показано=" + Код("+a,-b,~c,+d,=p:все,=q:выбранные,-x%2Cy") + "&b=1&d=1&"
		+ Код("режим:p") + "=" + Код("кроме") + "&" + Код("режим:q") + "=" + Код("выбранные")
		+ "&f=" + Код("x,y") + "&" + Код("снять") + "=d";
	Итог = Набор.ДеревоГалок().РазобратьПравки(Тело);

	Ожидаем.Что(Итог.Правки, "это не правки скрипта").ЭтоЛожь();
	Ожидаем.Что(СтрСоединить(Итог.Включить, ","), "отметили снятые").Равно("b,x,y");
	Ожидаем.Что(СтрСоединить(Итог.Снять, ","), "сняли отмеченные и «частично»; «снять» главнее галки")
		.Равно("d,a,c");
	Ожидаем.Что(Итог.Режимы.Получить("p"), "сменённый режим").Равно("кроме");
	Ожидаем.Что(Итог.Режимы.Получить("q"), "несменённого режима нет").Равно(Неопределено);
	Ожидаем.Что(СтрСоединить(Итог.Показанные, ","), "показанные ключи").Равно("a,b,c,d,p,q,x,y");

	СоСкриптом = Набор.ДеревоГалок().РазобратьПравки("правки=1&" + Код("включить") + "=a&показано=" + Код("+a,-b"));
	Ожидаем.Что(СтрСоединить(СоСкриптом.Включить, ","), "с правками скрипта поле не считается").Равно("a");
	Ожидаем.Что(СоСкриптом.Снять.Количество(), "снятого нет").Равно(0);

	БезПоля = Набор.ДеревоГалок().РазобратьПравки("b=1&" + Код("режим:p") + "=" + Код("все"));
	Ожидаем.Что(БезПоля.Включить.Количество() + БезПоля.Снять.Количество(), "без поля — как прежде").Равно(0);
	Ожидаем.Что(БезПоля.Режимы.Получить("p"), "режимы без поля — все пришедшие").Равно("все");

КонецПроцедуры

&Тест
Процедура СкриптПересчитываетПолеПоказанного() Экспорт

	Скрипт = ТекстСкрипта();
	Ожидаем.Что(Скрипт, "значение собирается заново").Содержит("function ctShownValue(set)");
	Ожидаем.Что(Скрипт, "по прямому ребёнку обёртки").Содержит("'[data-checktree-set] > [data-checktree-shown]'");

КонецПроцедуры

#КонецОбласти

#Область ОтмеченноеВнеПоказанного

// П3: отмеченное дальше первой страницы ветки без скрипта не видно и не снимается — кит печатает
// над деревом ряд «Выбрано: …» плашками, крестик — галка формы «снять=<ключ>».
&Тест
Процедура ОтмеченныеПечатаютсяРядомНадДеревом() Экспорт

	Отмеченные = Новый Массив();
	Отмеченные.Добавить(Новый Структура("Имя, Подпись", "у52", "Участник 52"));
	Отмеченные.Добавить(Новый Структура("Имя, Значение, Подпись, Состояние", "у", "у61", "Участник <61>", "выкл"));
	HTML = Кит.ДеревоГалок(Ветка("кроме")).Поиск("/д/поиск").Режимы("все", "кроме")
		.Отмеченные(Отмеченные).Рендер();
	Ряд = МеждуМаркеров(HTML, "<div class=""checktree__picked"" data-checktree-picked>", "</div>");

	Ожидаем.Что(Ряд, "подпись ряда — словарь").Содержит("<span class=""checktree__picked-label"">Выбрано</span>"
		+ "<span class=""checktree__picked-list"" role=""list"">");
	Ожидаем.Что(Ряд, "плашка отмеченного — пункт списка с ключом").Содержит("<span class=""chips-in__chip checktree__pick"""
		+ " role=""listitem"" data-checktree-pick=""у52""><span class=""chips-in__text"">Участник 52</span>");
	Ожидаем.Что(Ряд, "крестик — галка «снять» с именем для скринридера")
		.Содержит("<label class=""checktree__unpick""><input type=""checkbox"" class=""checktree__unpick-box"""
			+ " name=""снять"" value=""у52"" aria-label=""Снять «Участник 52»"">");
	Ожидаем.Что(Ряд, "снятый узел — «включить», своим видом, подпись экранирована")
		.Содержит("checktree__pick checktree__pick--off"" role=""listitem"" data-checktree-pick=""у61"">"
			+ "<span class=""chips-in__text"">Участник &lt;61&gt;</span>");
	Ожидаем.Что(Ряд, "у снятого — «вернуть»").Содержит("name=""включить"" value=""у61"" aria-label=""Вернуть «Участник &lt;61&gt;»""");
	Ожидаем.Что(СтрНайти(HTML, "data-checktree-search") < СтрНайти(HTML, "data-checktree-picked")
		И СтрНайти(HTML, "data-checktree-picked") < СтрНайти(HTML, "<ul class=""checktree"" data-checktree"),
		"ряд — под поиском, над деревом").ЭтоИстина();

	Своя = Кит.ДеревоГалок(Ветка("все")).Отмеченные(Отмеченные[0], "Выбрано и исключено").Рендер();
	Ожидаем.Что(Своя, "одно слово — без других слов 0.13; своя подпись")
		.Содержит("<span class=""checktree__picked-label"">Выбрано и исключено</span>");
	Ожидаем.Что(Кит.ДеревоГалок(Новый Массив()).Отмеченные(Отмеченные).Рендер(), "дерево без показанных узлов")
		.Содержит("data-checktree-pick=""у61""");

	Итог = Набор.ДеревоГалок().РазобратьПравки(Код("снять") + "=у52&" + Код("включить") + "=у61");
	Ожидаем.Что(СтрСоединить(Итог.Снять, ","), "крестик без скрипта — «снять»").Равно("у52");
	Ожидаем.Что(СтрСоединить(Итог.Включить, ","), "у снятого — «включить»").Равно("у61");

	Ожидаем.Что(ОбъявлениеЛиста(".checktree__pick:has(.checktree__unpick-box:checked) > .chips-in__text",
		"text-decoration"), "отмеченное снятие зачёркивает плашку без скрипта").Равно("line-through");
	Ожидаем.Что(ТекстСкрипта(), "со скриптом — правка в общем ряду").Содержит("function ctPaintPicks(set, edits)");

КонецПроцедуры

#КонецОбласти

#Область ПоискЗначком

// П6: поиск дерева — разметкой строки поиска кита: значок-лупа внутри рамки поля отправляет
// форму на адрес поиска, подпись поля — скрытой меткой, видна подсказка-пример.
&Тест
Процедура ПоискДереваЗначкомВПоле() Экспорт

	HTML = Кит.ДеревоГалок(Ветка("все")).Поиск("/д/поиск").Рендер();
	Поиск = МеждуМаркеров(HTML, "<div class=""checktree__search"" role=""search"" data-checktree-search>", "</button>");

	Ожидаем.Что(Поиск, "обёртка строки поиска").Содержит("<div class=""search-bar""><label class=""field"">");
	Ожидаем.Что(Поиск, "метка — скринридеру").Содержит("<span class=""visually-hidden"">Найти в дереве</span>");
	Ожидаем.Что(Поиск, "подсказка-пример в поле").Содержит("placeholder=""Найти в дереве""");
	Ожидаем.Что(Поиск, "поле поиска").Содержит("type=""search"" name=""найти""");
	Ожидаем.Что(Поиск, "значок — кнопка отправки на адрес поиска без проверки полей")
		.Содержит("formaction=""/д/поиск"" formnovalidate");
	Ожидаем.Что(Поиск, "у значка имя").Содержит("aria-label=""Найти""");
	Ожидаем.Что(СтрНайти(Поиск, "<span>Найти</span>"), "подписи кнопки нет").Равно(0);

	// прежний вид — словом Кнопка: та же разметка, что печатал выпуск 0.13 до дев-сборки 8
	Прежний = Кит.ДеревоГалок(Ветка("все")).Поиск("/д/поиск").Кнопка("Найти").Рендер();
	Ожидаем.Что(Прежний, "поле с меткой").Содержит("<span class=""field__label"">Найти в дереве</span>");
	Ожидаем.Что(СтрНайти(Прежний, "search-bar"), "без обёртки строки поиска").Равно(0);
	Ожидаем.Что(Прежний, "своя подпись кнопки").Содержит("<span>Найти</span></button>");

	Ожидаем.Что(ОбъявлениеЛиста(".checktree__search > .search-bar", "position"), "значок встаёт в рамку поля")
		.Равно("relative");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ветка «Альфа» (ключ п1) с режимом и двумя детьми: у1 снят, у2 включён.
Функция Ветка(Знач Режим)

	Дети = Новый Массив();
	Дети.Добавить(Новый Структура("Имя, Подпись, Состояние", "у1", "Участник 1", "выкл"));
	Дети.Добавить(Новый Структура("Имя, Подпись, Состояние", "у2", "Участник 2", "вкл"));
	Узлы = Новый Массив();
	Узлы.Добавить(Новый Структура("Имя, Подпись, Режим, Дети, Открыт", "п1", "Альфа", Режим, Дети, Истина));
	Возврат Узлы;

КонецФункции

Функция Отказ(Знач Узлы, Знач Режимы)

	Попытка
		Набор.ДеревоГалок().Отрисовать(Новый Структура("Узлы, Режимы", Узлы, Режимы));
	Исключение
		Возврат ОписаниеОшибки();
	КонецПопытки;
	Возврат "";

КонецФункции

Функция Код(Знач Текст)
	Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция МеждуМаркеров(Знач Текст, Знач Начало, Знач Конец)

	Открытие = СтрНайти(Текст, Начало);
	Если Открытие = 0 Тогда
		Возврат "";
	КонецЕсли;

	Хвост = Сред(Текст, Открытие + СтрДлина(Начало));
	Закрытие = СтрНайти(Хвост, Конец);
	Возврат ?(Закрытие = 0, Хвост, Лев(Хвост, Закрытие - 1));

КонецФункции

Функция ТекстСкрипта()

	Корень = ОбъединитьПути(Новый Файл(ТекущийСценарий().Источник).Путь, "..");
	Текст = Новый ТекстовыйДокумент();
	Текст.Прочитать(ОбъединитьПути(Корень, "src", "статика", "oscript-ui.js"), КодировкаТекста.UTF8);
	Возврат Текст.ПолучитьТекст();

КонецФункции

Функция Правила()

	Если ПравилаЛиста = Неопределено Тогда
		ПравилаЛиста = Разбор.Правила(Разбор.ТекстБазовогоЛиста());
	КонецЕсли;
	Возврат ПравилаЛиста;

КонецФункции

// Значение свойства у правила базового листа с ровно этим селектором под ровно этими
// условиями; из нескольких побеждает последнее, как в каскаде. Нет — Неопределено.
Функция ОбъявлениеЛиста(Знач Селектор, Знач Свойство, Знач Условия = "")

	Результат = Неопределено;
	Для Каждого Правило Из Правила() Цикл
		Если Правило.Селектор = Селектор И Правило.Условия = Условия Тогда
			Значение = Правило.Объявления.Получить(Свойство);
			Если Значение <> Неопределено Тогда
				Результат = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти
