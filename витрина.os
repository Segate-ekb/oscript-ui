// Витрина UI-кита: собирает кит и печатает страницу со всеми компонентами, всеми родами
// узлов холста и исходником каждого образца. Страница кладётся файлом — открывается
// браузером, сервера не требует.
//
// Оформление у витрины СВОЁ, из коробки: базовый лист библиотеки вшивается в страницу
// без ключей. Ключом --стили можно доложить лист инсталляции — он встаёт вторым, ровно
// как в каскаде живой страницы, и видно, что именно проект перебивает.
//
//   oscript витрина.os
//   oscript витрина.os --стили ../oscript_openhub/src/статика/openhub.css
//   oscript витрина.os --вывод /tmp/кит.html

#Использовать "."

Функция СобратьНабор(Знач Экран, Знач Модели, Знач Значки)

	Кнопки = Новый Кнопка(Экран, Модели, Значки);
	Плашки = Новый Плашка(Экран, Модели, Значки);
	Поля = Новый ПолеФормы(Экран, Модели);
	ПоляСкрытые = Новый СкрытоеПоле(Экран, Модели);
	Заглавия = Новый ЗаголовокСтраницы(Экран, Модели);
	Команды = Новый БлокКоманды(Экран, Модели, Значки);
	РядыМеты = Новый РядМеты(Экран, Модели, Значки);

	Возврат Новый НаборКомпонентов(
		Новый Карточка(Экран, Модели, Значки),
		Поля,
		Новый ПолеИзКонфига(Экран, Модели, Поля, Значки),
		Новый Таблица(Экран, Модели),
		Новый Тост(Экран, Модели, Значки),
		Плашки,
		Новый ДеревоРазделов(Экран, Модели, Значки),
		Новый ПанельСохранения(Экран, Модели, Кнопки),
		Значки,
		Новый Тумблер(Экран, Модели),
		Новый Проводник(Экран, Модели, Значки),
		Кнопки,
		Новый Табы(Экран, Модели, Значки),
		Новый ПустоеСостояние(Экран, Модели, Значки, Кнопки),
		Новый ОпаснаяЗона(Экран, Модели, Значки, Поля, Кнопки),
		Команды,
		Новый ШапкаОбъекта(Экран, Модели, Значки, Плашки, Команды, РядыМеты),
		Новый Пагинация(Экран, Модели, Значки),
		Новый Плитка(Экран, Модели, Значки),
		Новый Сетка(Экран, Модели),
		ПоляСкрытые,
		Заглавия,
		Новый СтраницаОшибки(Модели, Заглавия),
		Новый ФормаОтбора(Экран, Модели, Поля, Кнопки, ПоляСкрытые),
		Новый ПолосаЗаполнения(Экран, Модели),
		Новый Меню(Экран, Модели, Кнопки),
		РядыМеты);

КонецФункции

Функция СобратьВитрину(Знач Место)

	Экран = Новый ЭкранированиеHTML();
	Модели = Новый ЧтениеМодели();
	Значки = Новый Иконка(Экран, Новый НаборИконок(Место, Новый ЧтениеГлифа()), Модели);
	Тексты = Новый ТекстыИнтерфейса(Новый СловарьИнтерфейсаПоУмолчанию());

	Набор = СобратьНабор(Экран, Модели, Значки);
	Печать = Новый РазметкаЭлементов(Экран);
	Настройки = Новый РендерерНастроек(Экран, Модели, Набор, Тексты);

	Холст = Новый Кит(Печать, Набор, Настройки);
	Заявки = Новый Формы(Модели, Новый ПроверкаПоля(Тексты), Новый ЗначенияФормы(),
		Новый ПечатьФормы(Экран, Набор, Модели, Печать), Настройки);

	Сборка = Новый СборкаОбразцов();
	Возврат Новый ВитринаКита(Набор, Холст, Заявки, Настройки, Печать,
		Новый ОбразцыСтраницы(Сборка), Новый ОбразцыВвода(Сборка),
		Новый ОбразцыПоказа(Сборка), Новый ОбразцыХолста(Сборка));

КонецФункции

// Порядок листов тот же, что на живой странице: токены темы, базовый лист библиотеки,
// лист инсталляции. Страница кладётся файлом, поэтому листы вшиваются, а не подключаются
// по адресу. Скрипт стоит последним и только оживляет кнопки копирования: без него код
// образца остаётся на странице видимым и выделяемым.
Функция Страница(Знач Тело, Знач Токены, Знач Базовый, Знач Стили, Знач Скрипт)

	Возврат "<!DOCTYPE html>"
		+ СтрШаблон("<html lang=""ru"" data-theme=""%1"">", Токены.АтрибутТемы())
		+ "<head><meta charset=""utf-8"">"
		+ "<meta name=""viewport"" content=""width=device-width, initial-scale=1"">"
		+ "<title>Витрина UI-кита</title>"
		+ Токены.БлокСтилей()
		+ Базовый
		+ Стили
		+ "</head><body><main class=""layout"">" + Тело + "</main>"
		+ "<script>" + Скрипт + "</script>"
		+ "</body></html>";

КонецФункции

Функция ЛистСтилей(Знач Путь)

	Если НЕ ЗначениеЗаполнено(Путь) Тогда
		Возврат "";
	КонецЕсли;

	Файл = Новый Файл(Путь);
	Если НЕ Файл.Существует() Тогда
		ВызватьИсключение СтрШаблон("Лист стилей ""%1"" не найден.", Файл.ПолноеИмя);
	КонецЕсли;

	Поток = Новый ЧтениеТекста(Файл.ПолноеИмя, КодировкаТекста.UTF8);
	Текст = Поток.Прочитать();
	Поток.Закрыть();

	Возврат "<style>" + ?(Текст = Неопределено, "", Текст) + "</style>";

КонецФункции

Функция Ключ(Знач Имя, Знач ПоУмолчанию)

	Аргументы = АргументыКоманднойСтроки;
	Для Индекс = 0 По Аргументы.Количество() - 2 Цикл
		Если НРег(Аргументы[Индекс]) = Имя Тогда
			Возврат Аргументы[Индекс + 1];
		КонецЕсли;
	КонецЦикла;
	Возврат ПоУмолчанию;

КонецФункции

Функция Записать(Знач Путь, Знач Текст)

	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
	Возврат Новый Файл(Путь).ПолноеИмя;

КонецФункции

КаталогСкрипта = Новый Файл(ТекущийСценарий().Источник).Путь;

// раскладка статики знает и где лежат глифы, и где лежит базовый лист: витрина
// спрашивает у неё оба пути и не держит своей копии ни одного из них
Место = Новый РаскладкаСтатики(Новый СтатикаИнсталляцииПоУмолчанию());

Витрина = СобратьВитрину(Место);

Файл = Записать(
	Ключ("--вывод", ОбъединитьПути(КаталогСкрипта, "витрина.html")),
	Страница(Витрина.Отрисовать(), Новый ТокеныТемы(),
		ЛистСтилей(Место.ПолныйПуть(Место.ФайлБазовогоЛиста())),
		ЛистСтилей(Ключ("--стили", "")),
		Витрина.Скрипт()));

Сообщить("Витрина: " + Файл);
